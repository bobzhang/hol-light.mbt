// Behaviour test for the translated OCaml 4.14 Map/Set code: replays
// tools/ocaml_ref/omap_ref.ml (keep in sync) with the same random numbers.

///|
fn dm(m : T[Int64, Int64]) -> String {
  match m {
    Empty => "."
    Node(l, k, v, r, h) => "(\{dm(l)} \{k}:\{v}/\{h} \{dm(r)})"
  }
}

///|
fn ds(s : @oset.T[Int64]) -> String {
  match s {
    Empty => "."
    Node(l, k, r, h) => "(\{ds(l)} \{k}/\{h} \{ds(r)})"
  }
}

///|
test "omap and oset match OCaml 4.14 Map and Set" {
  let ord : (Int64) -> ((Int64) -> Int64 raise) raise = x => {
    y => x.compare(y).to_int64()
  }
  let out = StringBuilder()
  let log = StringBuilder()
  let note = (k : Int64) => log.write_string("\{k} ")
  @lib.random_init(7L)
  let mut m : T[Int64, Int64] = empty()
  let mut s : @oset.T[Int64] = @oset.empty()
  for i in 1..<=600 {
    // OCaml evaluates `let k = ... in let v = ... in` in order
    let k = @lib.random_int(60L)
    let v = @lib.random_int(5L)
    match @lib.random_int(9L) {
      0 | 1 | 2 => {
        m = add(ord, k, v, m)
        s = @oset.add(ord, k, s)
      }
      3 => {
        m = remove(ord, k, m)
        s = @oset.remove(ord, k, s)
      }
      4 => {
        m = filter(
          k1 => {
            _ => {
              note(k1)
              k1 % 3 != 0
            }
          },
          m,
        )
        s = @oset.filter(x => x % 5 != 0, s)
      }
      5 =>
        m = merge(
          ord,
          k1 => {
            a => {
              b => {
                note(k1)
                match (a, b) {
                  (Some(x), _) => Some(x)
                  (None, y) => y
                }
              }
            }
          },
          m,
          singleton(k, v),
        )
      6 => {
        m = union(ord, _ => a => b => Some(a + b), m, singleton(k, v))
        s = @oset.union(ord, s, @oset.singleton(k))
      }
      7 => {
        s = @oset.diff(ord, s, @oset.add(ord, k + 1, @oset.singleton(k)))
        ignore(
          exists(
            k1 => {
              _ => {
                note(k1)
                k1 == v
              }
            },
            m,
          ),
        )
      }
      _ => {
        let mut t : @oset.T[Int64] = @oset.empty()
        for j in 0..<20 {
          t = @oset.add(ord, (j * 3).to_int64(), t)
        }
        s = @oset.inter(ord, s, t)
        ignore(
          fold(
            k1 => {
              d => {
                acc => {
                  note(k1)
                  acc + d
                }
              }
            },
            m,
            0,
          ),
        )
      }
    }
    if i % 100 == 0 {
      out.write_string(dm(m) + "\n" + ds(s) + "\n")
    }
  }
  out.write_string(log.to_string() + "\n")
  out.write_string(
    bindings(m).map(p => "\{p.0}:\{p.1}").to_array().join(" ") + "\n",
  )
  out.write_string(
    @oset.elements(s).map(x => x.to_string()).to_array().join(" ") + "\n",
  )
  out.write_string(
    "\{@oset.mem(ord, 3, s)} \{mem(ord, 3, m)} \{@oset.compare(ord, s, @oset.singleton(1))}\n",
  )
  inspect(
    out.to_string(),
    content=(
      #|(((((. 2:0/1 .) 5:1/2 .) 7:2/4 (((. 9:3/1 .) 10:0/2 .) 11:2/3 .)) 14:4/5 ((. 17:3/2 (. 19:2/1 .)) 20:0/3 (. 25:3/1 .))) 26:4/6 (((. 28:3/1 .) 29:1/2 (. 31:2/1 .)) 32:1/4 ((. 35:1/1 .) 37:4/3 ((. 41:0/1 .) 49:1/2 (. 58:1/1 .)))))
      #|(((. 3/2 (. 6/1 .)) 9/3 ((. 19/1 .) 21/2 .)) 27/5 (((. 29/2 (. 32/1 .)) 39/3 .) 42/4 ((. 51/1 .) 57/2 (. 58/1 .))))
      #|(((((. 2:0/1 .) 4:9/2 (. 5:1/1 .)) 7:4/4 ((. 8:4/1 .) 10:2/3 ((. 11:3/1 .) 13:4/2 .))) 14:8/5 ((. 17:3/2 (. 19:1/1 .)) 20:0/4 (((. 22:1/1 .) 23:3/2 .) 25:0/3 (. 28:2/1 .)))) 29:1/6 ((((. 30:2/2 (. 31:2/1 .)) 32:5/3 ((. 35:5/1 .) 37:4/2 (. 40:3/1 .))) 41:0/4 ((. 43:0/1 .) 44:4/3 (. 45:2/2 (. 47:2/1 .)))) 49:1/5 ((((. 50:4/1 .) 51:1/2 .) 52:2/3 (. 53:4/1 .)) 55:0/4 ((. 57:2/1 .) 58:1/2 (. 59:4/1 .)))))
      #|(((((. 2/1 .) 4/2 .) 6/3 .) 9/4 (. 24/1 .)) 27/5 ((((. 30/1 .) 35/2 .) 39/3 (. 40/1 .)) 42/4 ((. 45/2 (. 51/1 .)) 54/3 (. 57/1 .))))
      #|(((((. 1:4/2 (. 2:0/1 .)) 4:8/3 (. 5:1/2 (. 6:2/1 .))) 7:4/4 ((. 8:4/1 .) 10:4/2 (. 13:4/1 .))) 14:4/5 (((. 16:0/1 .) 17:3/2 .) 20:0/4 ((. 22:0/2 (. 23:1/1 .)) 25:0/3 (. 28:2/1 .)))) 29:1/6 ((((. 31:2/1 .) 32:1/3 ((. 34:0/1 .) 35:0/2 .)) 37:4/4 (. 38:4/2 (. 40:3/1 .))) 43:0/5 (((. 44:3/1 .) 46:0/2 (. 47:4/1 .)) 49:3/4 ((. 52:1/2 (. 53:0/1 .)) 55:0/3 ((. 56:2/1 .) 58:1/2 (. 59:5/1 .))))))
      #|((((. 1/1 .) 3/2 (. 6/1 .)) 27/3 (. 42/1 .)) 48/4 (. 57/1 .))
      #|(((((. 1:4/2 (. 2:1/1 .)) 4:3/3 (. 5:1/1 .)) 7:4/4 ((. 8:4/1 .) 10:4/3 (. 12:3/2 (. 13:4/1 .)))) 14:4/5 (((. 16:3/1 .) 17:3/2 .) 20:0/4 ((. 22:0/1 .) 25:0/3 (. 26:1/2 (. 28:2/1 .))))) 29:2/6 ((((. 31:6/1 .) 32:0/2 (. 34:0/1 .)) 35:0/3 ((. 40:2/1 .) 41:0/2 .)) 43:0/5 (((. 46:1/2 (. 47:4/1 .)) 48:0/3 (. 50:2/1 .)) 52:3/4 ((. 53:0/1 .) 55:4/3 ((. 58:1/1 .) 59:0/2 .)))))
      #|(((. 3/1 .) 9/3 ((. 12/1 .) 18/2 (. 24/1 .))) 27/4 (. 57/1 .))
      #|(((((. 1:4/2 (. 2:1/1 .)) 4:3/3 (. 5:1/1 .)) 7:4/4 ((. 8:8/1 .) 10:1/2 (. 13:6/1 .))) 14:4/5 (((. 17:4/1 .) 20:0/3 (. 22:3/2 (. 23:1/1 .))) 25:2/4 ((. 26:1/1 .) 28:2/2 .))) 29:2/7 (((. 31:0/2 (. 34:0/1 .)) 35:0/4 (. 37:3/3 ((. 38:0/1 .) 40:1/2 (. 41:2/1 .)))) 43:0/6 (((. 44:4/1 .) 46:5/4 ((. 47:4/1 .) 49:0/3 ((. 50:2/1 .) 52:0/2 .))) 55:2/5 (. 56:2/2 (. 59:0/1 .)))))
      #|((((. 3/1 .) 6/2 (. 9/1 .)) 12/4 ((. 18/2 (. 23/1 .)) 24/3 .)) 27/5 ((((. 29/1 .) 37/2 .) 38/3 (. 39/1 .)) 54/4 (. 57/1 .)))
      #|(((((. 1:4/2 (. 2:3/1 .)) 4:1/3 (. 5:1/1 .)) 7:4/4 ((. 8:8/1 .) 10:4/2 (. 13:6/1 .))) 14:1/5 ((((. 17:2/1 .) 19:3/2 .) 20:0/3 (. 22:3/1 .)) 23:4/4 ((. 26:1/1 .) 28:0/2 .))) 29:2/7 ((((. 31:4/1 .) 32:3/2 (. 34:0/1 .)) 35:0/4 ((. 37:3/2 (. 38:2/1 .)) 40:4/3 (. 41:1/1 .))) 43:1/6 ((((. 44:4/2 (. 45:0/1 .)) 46:5/3 (. 47:4/1 .)) 49:1/4 ((. 50:2/1 .) 52:0/2 (. 53:0/1 .))) 55:2/5 ((. 56:0/1 .) 58:2/2 (. 59:0/1 .)))))
      #|((((. 3/1 .) 9/2 .) 12/3 ((. 17/1 .) 18/2 (. 24/1 .))) 27/6 (((. 36/1 .) 39/4 ((. 43/2 (. 45/1 .)) 48/3 .)) 51/5 (((. 53/1 .) 54/2 .) 57/3 .)))
      #|42 42 42 17 42 32 17 32 17 42 32 17 42 32 17 42 51 47 42 32 17 51 47 42 32 31 17 51 47 42 32 31 26 20 17 6 3 6 17 20 26 31 32 42 47 51 59 17 20 25 26 31 32 37 47 59 32 26 20 17 18 25 31 29 47 37 49 59 14 17 18 20 25 26 29 31 32 37 47 49 59 7 14 17 20 25 26 29 31 32 35 37 47 49 59 7 14 17 20 25 26 29 31 32 35 37 47 49 59 7 9 14 17 20 25 26 29 31 32 35 37 39 47 49 59 32 26 14 11 9 7 20 17 25 31 29 47 37 35 39 49 49 47 39 37 35 32 31 29 28 26 25 24 20 17 14 11 9 7 49 47 39 37 35 32 31 29 28 26 25 24 20 17 14 11 9 7 5 5 7 9 11 14 17 20 24 25 26 28 29 31 32 35 37 39 47 49 5 7 9 11 14 17 20 24 25 26 28 29 31 32 35 37 39 47 49 5 7 9 11 14 17 20 24 25 26 28 29 31 32 35 37 39 47 49 5 7 9 11 14 17 20 24 25 26 28 29 31 32 35 37 39 42 47 49 49 47 37 35 32 31 29 28 26 25 20 17 14 11 7 5 49 48 37 35 32 31 29 28 26 25 24 20 17 14 11 7 5 49 48 37 36 35 32 31 29 28 26 25 24 20 17 14 11 7 5 49 48 37 36 35 32 31 29 28 26 25 24 20 17 14 11 7 5 2 49 48 37 36 35 32 31 29 28 26 25 24 20 17 14 11 7 5 2 32 26 14 7 5 2 11 20 17 25 24 28 29 31 37 36 35 49 48 2 5 7 11 14 17 20 24 25 26 28 29 31 32 35 36 37 48 49 49 48 41 37 36 35 32 31 29 28 26 25 24 20 17 14 11 7 5 2 2 4 5 7 11 14 17 20 24 25 26 28 29 31 32 35 36 37 41 48 49 2 4 5 7 11 14 17 20 25 26 28 29 31 32 35 37 41 49 26 14 7 2 5 4 49 41 37 35 32 31 29 28 27 26 25 20 17 15 14 11 7 5 4 2 2 4 5 7 10 11 14 15 17 20 21 25 26 27 28 29 31 32 35 37 41 49 57 2 4 5 7 10 11 14 17 20 25 26 28 29 31 32 35 37 41 49 26 14 7 4 2 5 11 10 20 17 25 32 29 28 31 37 35 49 41 2 5 7 10 11 14 17 20 25 26 27 28 29 31 32 35 37 41 49 58 2 5 7 9 10 11 14 16 17 19 20 25 26 28 29 31 32 35 37 41 49 57 58 2 5 7 9 10 11 14 16 17 19 20 25 26 28 29 31 32 35 37 41 49 57 58 2 5 7 9 10 11 14 16 17 19 20 25 26 28 29 31 32 35 37 41 49 57 58 2 5 7 10 11 14 16 17 19 20 25 26 28 29 30 31 32 35 37 41 43 49 51 58 2 5 7 10 11 14 16 17 19 20 25 26 28 29 30 31 32 35 37 41 43 44 49 51 58 58 51 49 44 43 41 37 35 32 31 30 29 28 26 25 23 20 19 17 16 14 11 10 7 5 2 2 5 7 10 11 14 