      #|  !e:A->bool. e IN E\n        ==> ?h:real^1->real^2.\n              polygonal_arc h /\\\n              path_image h SUBSET path_image(q e) /\\\n              pathstart h IN sphere(p(a e),r(a e)) /\\\n              pathfinish h IN sphere(p(b e),r(b e)) /\\\n              (path_image h DELETE pathstart h) SUBSET\n              ((:real^2) DIFF cball(p(a e),r(a e))) /\\\n              (path_image h DELETE pathfinish h) SUBSET\n              ((:real^2) DIFF cball(p(b e),r(b e))) /\\\n              DISJOINT (path_image h)\n               (edge_polygonal_obstacles V p r e)
      #|  c:(A->bool)->real^2->bool
      #|  p:A->real^2
      #|  E:(A->bool)->bool
      #|  V:A->bool
      #|  !V E p c.\n        finite_simple_graph (V:A->bool) E /\\\n        plane_graph_embedding V E p c\n        ==> ?r a b k.\n              (!v. v IN V\n                   ==> &0 < r v /\\\n                       cball(p v,r v) INTER\n                       embedding_vertex_obstacles V E p c v = {}) /\\\n              (!v w. v IN V /\\ w IN V /\\ ~(v = w)\n                     ==> DISJOINT\n                          (cball(p v,r v)) (cball(p w,r w))) /\\\n              (!e. e IN E\n                   ==> a e IN V /\\\n                       b e IN V /\\\n                       ~(a e = b e) /\\\n                       e = {a e,b e} /\\\n                       polygonal_arc(k e) /\\\n                       pathstart(k e) IN sphere(p(a e),r(a e)) /\\\n                       pathfinish(k e) IN sphere(p(b e),r(b e)) /\\\n                       (path_image(k e) DELETE pathstart(k e)) SUBSET\n                       ((:real^2) DIFF cball(p(a e),r(a e))) /\\\n                       (path_image(k e) DELETE pathfinish(k e)) SUBSET\n                       ((:real^2) DIFF cball(p(b e),r(b e))) /\\\n                       DISJOINT (path_image(k e))\n                        (edge_polygonal_obstacles V p r e)) /\\\n              (!e e'. e IN E /\\ e' IN E /\\ ~(e = e')\n                       ==> DISJOINT (path_image(k e))\n                                    (path_image(k e')))
      #|  (e:A->bool) IN E
      #|  e:A->bool
      #|  (a:(A->bool)->A) e IN V
      #|  (a:(A->bool)->A) e
      #|  (b:(A->bool)->A) e IN V
      #|  (b:(A->bool)->A) e
      #|  (b:(A->bool)->A) e
      #|  (a:(A->bool)->A) e
      #|  (e:A->bool) IN E
      #|  e:A->bool
      #|  (e:A->bool) IN E
      #|  e:A->bool
      #|  (e:A->bool) IN E
      #|  e:A->bool
      #|  (e':A->bool) IN E
      #|  e':A->bool
      #|  segment[a:real^N,x] SUBSET cball(a,r)
      #|  !a x:real^N. !r s.\n        &0 <= r /\\\n        x IN sphere(a,r) /\\\n        DISJOINT s (cball(a,r))\n        ==> DISJOINT (segment[a,x]) s
      #|  (y:real^N) IN {x}
      #|  (y:real^N) IN segment[a,x] INTER sphere(a,r)
      #|  (y:real^N) IN segment[a,x]
      #|  (z:real^N) IN {y}
      #|  (z:real^N) = y
      #|  (z:real^N) IN cball(a,r)
      #|  z:real^N
      #|  segment[a:real^N,x] INTER sphere(a,r) = {x}
      #|  segment[a:real^N,x] SUBSET cball(a,r)
      #|  x:real^N
      #|  a:real^N
      #|  &0 <= r
      #|  !a x y:real^N. !r s.\n        x IN sphere(a,r) /\\\n        y IN sphere(a,r) /\\\n        ~(x = y) /\\\n        s INTER cball(a,r) = {y}\n        ==> DISJOINT (segment[a,x]) s
      #|  z:real^N
      #|  z:real^N
      #|  {v:A} INTER {w} = {}
      #|  DISJOINT\n       (cball((p:A->real^N) v,r v)) (cball(p w,r w))
      #|  segment[(p:A->real^N) w,y] SUBSET cball(p w,r w)
      #|  segment[(p:A->real^N) v,x] SUBSET cball(p v,r v)
      #|  (v:A) = w
      #|  !V p r v w x y.\n        v IN (V:A->bool) /\\\n        w IN V /\\\n        &0 <= r v /\\\n        &0 <= r w /\\\n        x IN sphere((p:A->real^N) v,r v) /\\\n        y IN sphere(p w,r w) /\\\n        (v = w ==> ~(x = y)) /\\\n        (~(v = w)\n         ==> DISJOINT (cball(p v,r v)) (cball(p w,r w)))\n        ==> segment[p v,x] INTER segment[p w,y] =\n            IMAGE p ({v} INTER {w})
      #|  radialized_edge\n    (p:A->real^N) (a:(A->bool)->A) (b:(A->bool)->A)\n    (k:(A->bool)->real^1->real^N) e =\n      (linepath(p(a e),pathstart(k e)) ++ k e) ++\n      linepath(pathfinish(k e),p(b e))
      #|  !p a b k e.\n        path_image(radialized_edge p a b k e) =\n        segment[p(a e),pathstart(k e)] UNION path_image(k e) UNION\n        segment[pathfinish(k e),p(b e)]
      #|  !V p r e.\n        IMAGE (p:A->real^2) V SUBSET\n        edge_polygonal_obstacles V p r e
      #|  !V p r e v.\n        v IN (V:A->bool) /\\ ~(v IN e)\n        ==> cball((p:A->real^2) v,r v) SUBSET\n            edge_polygonal_obstacles V p r e
      #|  (z:real^N) IN cball((p:A->real^N) w,(r:A->real) w)
      #|  DISJOINT\n       (cball((p:A->real^N) v,r v)) (cball(p w,r w))
      #|  &0 <= (r:A->real) w
      #|  (v:A) = w
