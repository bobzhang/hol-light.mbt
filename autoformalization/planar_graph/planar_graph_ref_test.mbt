      #|  !V:A->bool. !E:(A->bool)->bool.\n   !q:num->A. !n i j k. !u v:A.\n        0 < i /\\ i < j /\\ j < k /\\ k < n /\\\n        INJ q (cyclic_indices n) (:A) /\\\n        cyclic_vertices q n SUBSET V /\\\n        cyclic_edges q n SUBSET E /\\\n        u IN V /\\ v IN V /\\ ~(u = v) /\\\n        ~(u IN cyclic_vertices q n) /\\\n        ~(v IN cyclic_vertices q n) /\\\n        {u,v} IN E /\\\n        {u,q 0} IN E /\\ {u,q j} IN E /\\\n        {v,q i} IN E /\\ {v,q k} IN E\n        ==> graph_kuratowski_obstruction V E
