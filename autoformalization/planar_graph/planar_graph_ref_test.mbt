      #|  !z:num->real^2. !n j i.\n        strictly_convex_cycle z n /\\ j + 2 < n /\\ i < n - j\n        ==> plane_orientation (z j) (z (n - 1))\n              (cyclic_split_right z j i) <= &0 /\\\n            (plane_orientation (z j) (z (n - 1))\n               (cyclic_split_right z j i) = &0\n             ==> cyclic_split_right z j i = z j \\/\n                 cyclic_split_right z j i = z (n - 1))
      #|  i:num
