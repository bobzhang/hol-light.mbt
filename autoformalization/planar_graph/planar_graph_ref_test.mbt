      #|  finite_simple_graph (V2:A->bool) E2
      #|  finite_simple_graph (V1:A->bool) E1
      #|  !V1 E1 V2 E2 p u v.\n        finite_simple_graph (V1:A->bool) E1 /\\\n        finite_simple_graph V2 E2 /\\\n        straight_line_embedding V1 E1 p /\\\n        straight_line_embedding V2 E2 p /\\\n        {u,v} IN E1 /\\ {u,v} IN E2 /\\\n        convex hull (IMAGE p V1) INTER convex hull (IMAGE p V2) =\n        segment[p u,p v]\n        ==> straight_line_embedding (V1 UNION V2) (E1 UNION E2)\n             (p:A->real^2)
      #|  e:A->bool
