      #|  graph_face_successor E1 r1 ((u:A),(v:A)) = r1(v,u)
      #|  graph_face_successor E2 r2 (d:A#A) = r2(reverse_dart d)
      #|  graph_face_successor\n      (E1 UNION E2:(A->bool)->bool)\n      (graph_split_rotation (V1:A->bool) E1 E2 r1 r2 u v) (d:A#A) =\n    graph_split_local_rotation (V1:A->bool) E1 E2 r1 r2 u v\n      (SND(d:A#A)) (reverse_dart d)
      #|  (FST(d:A#A),SND d)
      #|  finite_simple_graph (V2:A->bool) E2
