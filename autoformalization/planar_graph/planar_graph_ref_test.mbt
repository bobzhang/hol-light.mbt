      #|  !V E p c a b x y.\n        plane_graph_embedding (V:A->bool) E p c /\\\n        ~(a = b) /\\ ~(a = x) /\\ ~(a = y) /\\\n        ~(b = x) /\\ ~(b = y) /\\ ~(x = y) /\\\n        {a,b} IN E /\\ {a,x} IN E /\\ {x,b} IN E /\\\n        {a,y} IN E /\\ {y,b} IN E /\\ {x,y} IN E\n        ==>\n        c {a,b} INTER (c {a,x} UNION c {x,b}) = {p a,p b} /\\\n        (c {a,x} UNION c {x,b}) INTER\n        (c {a,y} UNION c {y,b}) = {p a,p b} /\\\n        (c {a,y} UNION c {y,b}) INTER c {a,b} = {p a,p b} /\\\n        c {x,y} INTER (c {x,a} UNION c {a,y}) = {p x,p y} /\\\n        (c {x,a} UNION c {a,y}) INTER\n        (c {x,b} UNION c {b,y}) = {p x,p y} /\\\n        (c {x,b} UNION c {b,y}) INTER c {x,y} = {p x,p y} /\\\n        c {a,b} INTER c {x,y} = {}
