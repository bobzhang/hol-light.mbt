      #|  E1:(A->bool)->bool
      #|  V1:A->bool
      #|  !V1 E1 V2 E2 p u v z n j.\n        finite_simple_graph (V1:A->bool) E1 /\\\n        finite_simple_graph V2 E2 /\\\n        straight_line_embedding V1 E1 p /\\\n        straight_line_embedding V2 E2 p /\\\n        {u,v} IN E1 /\\ {u,v} IN E2 /\\\n        strictly_convex_cycle z n /\\ j + 2 < n /\\\n        p u = z j /\\ p v = z (n - 1) /\\\n        convex hull (IMAGE p V1) =\n        convex hull\n         (cyclic_vertices (cyclic_split_left z n j) (j + 2)) /\\\n        convex hull (IMAGE p V2) =\n        convex hull\n         (cyclic_vertices (cyclic_split_right z j) (n - j))\n        ==> straight_line_embedding (V1 UNION V2) (E1 UNION E2)\n             (p:A->real^2)
      #|  quadratic_bezier (a:real^2) b c t =\n        (&1 - t) pow 2 % a +\n        (&2 * (&1 - t) * t) % b +\n        t pow 2 % c
      #|  !a b c:real^2. quadratic_bezier a b c (&0) = a
      #|  !a b c:real^2. quadratic_bezier a b c (&1) = c
      #|  !x y a b c:real^2. !t.\n        plane_orientation x y (quadratic_bezier a b c t) =\n        (&1 - t) pow 2 * plane_orientation x y a +\n        (&2 * (&1 - t) * t) * plane_orientation x y b +\n        t pow 2 * plane_orientation x y c
