      #|  E1:(A->bool)->bool
      #|  V2:A->bool
      #|  V1:A->bool
      #|  ~(reverse_dart(d:A#A) IN outgoing_darts E1 u)
      #|  SND(d:A#A) = u
      #|  reverse_dart(d:A#A)
      #|  v:A
      #|  u:A
      #|  r2:(A#A)->A#A
      #|  r1:(A#A)->A#A
      #|  E2:(A->bool)->bool
      #|  E1:(A->bool)->bool
      #|  V1:A->bool
      #|  reverse_dart(d:A#A) IN outgoing_darts E2 v
      #|  SND(d:A#A) = v
