      #|  indexed_path_edges (cyclic_offset_path (q:num->A) j) (k - j)\n    SUBSET cyclic_edges q n
      #|  indexed_path_edges (cyclic_offset_path (q:num->A) i) (j - i)\n    SUBSET cyclic_edges q n
