      #|  !V:A->bool. !E:(A->bool)->bool. !q w:num->A. !n k.\n   !r:(A#A)->A#A.\n        simple_graph_cycle E (cyclic_delete_last q w n) (n - 1 + k) /\\\n        cyclic_face_successors\n         E r (cyclic_delete_last q w n) (n - 1 + k) /\\\n        3 <= n /\\\n        w 0 = q (n - 2) /\\\n        w (k + 1) = q 0 /\\\n        fan_rotation_invariant\n         V E r (q (n - 1)) w (q (n - 3),q (n - 2))\n         (k + 1) (k + 1)\n        ==> boundary_euler_rotation\n             (q (n - 1) INSERT V)\n             (fan_edges (q (n - 1)) w E (k + 1)) q n\n             (fan_rotation (q (n - 1)) w\n               (q (n - 3),q (n - 2)) r (k + 1))
