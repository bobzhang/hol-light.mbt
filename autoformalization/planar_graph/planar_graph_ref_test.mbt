      #|  V2:A->bool
      #|  V1:A->bool
      #|  graph_rotation\n      (E1 UNION E2:(A->bool)->bool)\n      (graph_split_rotation (V1:A->bool) E1 E2 r1 r2 u v)
      #|  v:A
      #|  u:A
      #|  E2:(A->bool)->bool
      #|  E1:(A->bool)->bool
      #|  V2:A->bool
      #|  V1:A->bool
      #|  DISJOINT\n      (graph_darts E1 DELETE ((u:A),(v:A)))\n      (graph_darts E2 DELETE (v,u)) /\\\n    (graph_darts E1 DELETE (u,v)) UNION\n    (graph_darts E2 DELETE (v,u)) =\n      graph_darts (E1 UNION E2)
      #|  !V1 V2:A->bool. !E1 E2:(A->bool)->bool.\n   !r1 r2:(A#A)->A#A. !u v:A.\n        finite_simple_graph V1 E1 /\\\n        finite_simple_graph V2 E2 /\\\n        graph_rotation E1 r1 /\\\n        graph_rotation E2 r2 /\\\n        V1 INTER V2 = {u,v} /\\\n        {u,v} IN E1 /\\\n        {u,v} IN E2 /\\\n        ~(restricted_permutation r2 (outgoing_darts E2 u) (u,v) =\n          (u,v)) /\\\n        ~(restricted_permutation r1 (outgoing_darts E1 v) (v,u) =\n          (v,u))\n        ==> graph_face_successor\n             (E1 UNION E2)\n             (graph_split_rotation V1 E1 E2 r1 r2 u v) =\n            graph_split_face_permutation E1 E2 r1 r2 u v
      #|  (d:A#A) IN graph_darts (E1 UNION E2)
