      #|  i < j + 1
      #|  i < j \\/ (i:num) = j \\/ i = j + 1
      #|  !z:num->real^2. !n j i.\n        strictly_convex_cycle z n /\\ j + 2 < n /\\ i < j + 2\n        ==> &0 <= plane_orientation (z j) (z (n - 1))\n                    (cyclic_split_left z n j i) /\\\n            (plane_orientation (z j) (z (n - 1))\n               (cyclic_split_left z n j i) = &0\n             ==> cyclic_split_left z n j i = z j \\/\n                 cyclic_split_left z n j i = z (n - 1))
      #|  (z:num->real^2) (n - 1)
