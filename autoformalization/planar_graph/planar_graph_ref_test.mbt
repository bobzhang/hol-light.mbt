      #|  graph_face_successor E2 r2 ((v:A),(u:A)) = r2(u,v)
      #|  graph_face_successor E1 r1 (d:A#A) = r1(reverse_dart d)
      #|  graph_face_successor\n      (E1 UNION E2:(A->bool)->bool)\n      (graph_split_rotation (V1:A->bool) E1 E2 r1 r2 u v) (d:A#A) =\n    graph_split_local_rotation (V1:A->bool) E1 E2 r1 r2 u v\n      (SND(d:A#A)) (reverse_dart d)
      #|  (FST(d:A#A),SND d)
      #|  finite_simple_graph (V1:A->bool) E1
      #|  E1:(A->bool)->bool
      #|  V1:A->bool
      #|  (SND(d:A#A)) IN V1
      #|  reverse_dart(d:A#A) IN outgoing_darts E1 (SND d)
      #|  v:A
      #|  u:A
      #|  E2:(A->bool)->bool
      #|  E1:(A->bool)->bool
      #|  V2:A->bool
      #|  V1:A->bool
      #|  ~((u:A) = v)
      #|  !V1 V2:A->bool. !E1 E2:(A->bool)->bool.\n   !r1 r2:(A#A)->A#A. !u v:A. !d:A#A.\n        finite_simple_graph V1 E1 /\\\n        finite_simple_graph V2 E2 /\\\n        V1 INTER V2 = {u,v} /\\\n        {u,v} IN E1 /\\\n        {u,v} IN E2 /\\\n        d IN graph_darts E1 DELETE (u,v)\n        ==> graph_face_successor\n             (E1 UNION E2)\n             (graph_split_rotation V1 E1 E2 r1 r2 u v) d =\n            if SND d = u then\n              swap((u,v),graph_face_successor E2 r2 (v,u))\n                (graph_face_successor E1 r1 d)\n            else graph_face_successor E1 r1 d
      #|  SND(d:A#A) = u
      #|  SND(d:A#A) = v
      #|  reverse_dart(d:A#A)
      #|  SND(d:A#A)
      #|  v:A
      #|  u:A
      #|  r2:(A#A)->A#A
