      #|  CARD({u:A,v}) = 2
      #|  FINITE(V1:A->bool) /\\ FINITE(E1:(A->bool)->bool) /\\\n    FINITE(V2:A->bool) /\\ FINITE(E2:(A->bool)->bool)
      #|  {u:A,v} IN E1 UNION E2
