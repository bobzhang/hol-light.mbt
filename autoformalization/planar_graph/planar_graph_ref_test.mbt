      #|  !V:A->bool. !E:(A->bool)->bool. !u v:A.\n   !W:A->bool. !D:(A->bool)->bool.\n   !W':A->bool. !D':(A->bool)->bool.\n        finite_simple_graph V E /\\\n        {u,v} IN E /\\\n        graph_subdivision W D W' D' /\\\n        W' SUBSET V DELETE u /\\\n        D' SUBSET graph_contract_edges V E u v /\\\n        CARD(graph_neighbors D' v) <= 3\n        ==> (?W'':A->bool. ?D'':(A->bool)->bool.\n              graph_subdivision W D W'' D'' /\\\n              W'' SUBSET V /\\\n              D'' SUBSET induced_subgraph_edges E W'') \\/\n            (?W'':A->bool. ?D'':(A->bool)->bool.\n              graph_subdivision\n                (IMAGE (swap(u,v)) W)\n                (IMAGE (IMAGE (swap(u,v))) D) W'' D'' /\\\n              W'' SUBSET V /\\\n              D'' SUBSET induced_subgraph_edges E W'')
      #|  graph_branch_split_edges\n    (E:(A->bool)->bool) u v (S:A->bool) =\n      {{u,v}} UNION\n      IMAGE (\\w:A. {u,w}) S UNION\n      (E DIFF IMAGE (\\w:A. {v,w}) S)
      #|  !E:(A->bool)->bool. !u v:A. !S e.\n        e IN graph_branch_split_edges E u v S <=>\n        e = {u,v} \\/\n        (?w. w IN S /\\ e = {u,w}) \\/\n        e IN E /\\ ~(?w. w IN S /\\ e = {v,w})
