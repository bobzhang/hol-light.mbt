      #|  v:A
      #|  u:A
      #|  !u v w:A.\n        ~(u = v) /\\ ~(u = w) /\\ ~(v = w)\n        ==> subdivision_tail_swap u v w o\n            subdivision_tail_swap u v w = I
      #|  w:A
      #|  v:A
      #|  u:A
      #|  !u v w:A.\n        ~(u = v) /\\ ~(u = w) /\\ ~(v = w)\n        ==> !d. subdivision_tail_swap u v w\n                 (subdivision_tail_swap u v w d) = d
      #|  w:A
      #|  v:A
      #|  u:A
      #|  !u v w:A.\n        ~(u = v) /\\ ~(u = w) /\\ ~(v = w)\n        ==> subdivision_tail_swap u v w (u,v) = (u,w) /\\\n            subdivision_tail_swap u v w (u,w) = (u,v) /\\\n            subdivision_tail_swap u v w (v,u) = (v,w) /\\\n            subdivision_tail_swap u v w (v,w) = (v,u)
      #|  !u v w:A. !d:A#A.\n        ~(d = (u,v)) /\\ ~(d = (u,w)) /\\\n        ~(d = (v,u)) /\\ ~(d = (v,w))\n        ==> subdivision_tail_swap u v w d = d
      #|  !f:A->A. (!x. f(f x) = x)\n             ==> !s y. y IN IMAGE f s <=> f y IN s
      #|  {w:A,x} SUBSET V
      #|  x:A
