      #|  E2:(A->bool)->bool
      #|  E1:(A->bool)->bool
      #|  V1:A->bool
      #|  SND(d:A#A) IN V1 INTER V2
      #|  ~(SND(d:A#A) IN V1)
      #|  reverse_dart(d:A#A)
      #|  v:A
      #|  u:A
      #|  r2:(A#A)->A#A
      #|  r1:(A#A)->A#A
