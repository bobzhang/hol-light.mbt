      #|  !V E p u v e x.\n        straight_line_embedding (V:A->bool) E p /\\\n        {u,v} IN E /\\ e IN E /\\ ~(e = {u,v}) /\\\n        x IN straight_edge p e /\\ x IN segment[p u,p v]\n        ==> x IN IMAGE p {u,v}
