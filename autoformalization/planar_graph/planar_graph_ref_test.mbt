// Load-fidelity test for Autoformalization/planar_graph.ml: replays tools/ocaml_ref/Autoformalization_planar_graph_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "Autoformalization/planar_graph matches Autoformalization/planar_graph.ml" {
  @planar_graph.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "Library/wo", "Library/card", "Library/floor", "Multivariate/misc",
      "Library/products", "Library/iter", "Multivariate/metric", "Library/frag",
      "Library/prime", "Library/grouptheory", "Multivariate/homology", "Library/matroids",
      "Multivariate/vectors", "Library/permutations", "Multivariate/determinants",
      "Multivariate/topology", "Multivariate/convex", "Multivariate/paths", "Multivariate/polytope",
      "Multivariate/degree", "Multivariate/derivatives", "Multivariate/integration",
      "Multivariate/measure", "Multivariate/complexes", "Multivariate/canal", "Multivariate/transcendentals",
      "Library/binomial", "Multivariate/realanalysis", "Multivariate/moretop", "Library/rstc",
      "Autoformalization/planar_graph",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Autoformalization/planar_graph")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("finite_simple_graph", () => {
    sthm(@planar_graph.finite_simple_graph())
  })
  log.attempt("FINITE_SIMPLE_GRAPH_EDGE", () => {
    sthm(@planar_graph.finite_simple_graph_edge())
  })
  log.attempt("FINITE_SIMPLE_GRAPH_UNION", () => {
    sthm(@planar_graph.finite_simple_graph_union())
  })
  log.attempt("induced_subgraph_edges", () => {
    sthm(@planar_graph.induced_subgraph_edges())
  })
  log.attempt("IN_INDUCED_SUBGRAPH_EDGES", () => {
    sthm(@planar_graph.in_induced_subgraph_edges())
  })
