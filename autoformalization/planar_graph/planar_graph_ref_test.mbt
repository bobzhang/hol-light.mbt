      #|  (graph_split_face_permutation\n       (E1:(A->bool)->bool) E2 r1 r2 u v:(A#A)->A#A)\n      permutes graph_darts (E1 UNION E2:(A->bool)->bool)
      #|  graph_face_successor\n      (E1 UNION E2:(A->bool)->bool)\n      (graph_split_rotation (V1:A->bool) E1 E2 r1 r2 u v)\n      permutes graph_darts (E1 UNION E2:(A->bool)->bool)
      #|  v:A
