      #|  !V:A->bool. !E:(A->bool)->bool. !q w:num->A. !n k.\n   !r:(A#A)->A#A.\n        simple_graph_cycle E (cyclic_delete_last q w n) (n - 1 + k) /\\\n        boundary_euler_rotation\n         V E (cyclic_delete_last q w n) (n - 1 + k) r /\\\n        3 <= n /\\\n        ~(q (n - 1) IN V) /\\\n        INJ w (cyclic_indices (k + 2)) (:A) /\\\n        cyclic_vertices w (k + 2) SUBSET V /\\\n        w 0 = q (n - 2) /\\\n        w (k + 1) = q 0\n        ==> boundary_euler_rotation\n             (q (n - 1) INSERT V)\n             (IMAGE (\\u:A. {q (n - 1),u})\n               (cyclic_vertices w (k + 2)) UNION E)\n             q n\n             (fan_rotation (q (n - 1)) w\n               (q (n - 3),q (n - 2)) r (k + 1))
