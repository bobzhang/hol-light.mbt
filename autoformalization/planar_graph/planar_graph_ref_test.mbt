      #|  four_path_extension_edges (E:(A->bool)->bool)\n    (a:A) b c d\n    (p0:num->A) l0 (p1:num->A) l1\n    (p2:num->A) l2 (p3:num->A) l3 =\n    (((((((E DELETE {a,b}) UNION indexed_path_edges p0 l0)\n          DELETE {b,c}) UNION indexed_path_edges p1 l1)\n          DELETE {c,d}) UNION indexed_path_edges p2 l2)\n          DELETE {d,a}) UNION indexed_path_edges p3 l3
      #|  p3:num->A
      #|  l3:num
      #|  (((((E DELETE {a:A,b}) UNION indexed_path_edges (p0:num->A) l0)\n         DELETE {b,c}) UNION indexed_path_edges (p1:num->A) l1)\n         DELETE {c,d}) UNION indexed_path_edges (p2:num->A) l2
      #|  ((V UNION indexed_path_vertices (p0:num->A) l0) UNION\n       indexed_path_vertices (p1:num->A) l1) UNION\n       indexed_path_vertices (p2:num->A) l2
      #|  E:(A->bool)->bool
      #|  V:A->bool
      #|  (p3:num->A) l3 = a
      #|  (p3:num->A) 0 = d
      #|  {d:A,a} IN E2
      #|  p2:num->A
      #|  l2:num
      #|  E1:(A->bool)->bool
      #|  V1:A->bool
      #|  E:(A->bool)->bool
      #|  V:A->bool
      #|  (p2:num->A) l2 = d
      #|  (p2:num->A) 0 = c
      #|  graph_subdivision (V:A->bool) E (V2:A->bool) (E2:(A->bool)->bool)
      #|  E2:(A->bool)->bool =\n    (E1 DELETE {c:A,d}) UNION indexed_path_edges (p2:num->A) l2
      #|  V2:A->bool =\n    V1 UNION indexed_path_vertices (p2:num->A) l2
      #|  {c:A,d} IN E1
      #|  p1:num->A
      #|  l1:num
