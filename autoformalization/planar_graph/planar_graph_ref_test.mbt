      #|  (!a b:real^2. plane_orientation a a b = &0) /\\\n   (!a b:real^2. plane_orientation a b a = &0) /\\\n   (!a b:real^2. plane_orientation a b b = &0)
      #|  !a b:real^2. convex {x | &0 <= plane_orientation a b x}
