      #|  !V (p:A->real^2) (r:A->real)\n      (a:(A->bool)->A) (b:(A->bool)->A)\n      (k:(A->bool)->real^1->real^2) (e:A->bool) v x.\n        v IN V /\\\n        &0 <= r v /\\\n        x IN sphere(p v,r v) /\\\n        e = {a e,b e} /\\\n        pathstart(k e) IN sphere(p(a e),r(a e)) /\\\n        pathfinish(k e) IN sphere(p(b e),r(b e)) /\\\n        (path_image(k e) DELETE pathstart(k e)) SUBSET\n        ((:real^2) DIFF cball(p(a e),r(a e))) /\\\n        (path_image(k e) DELETE pathfinish(k e)) SUBSET\n        ((:real^2) DIFF cball(p(b e),r(b e))) /\\\n        DISJOINT (path_image(k e))\n         (edge_polygonal_obstacles V p r e) /\\\n        (v = a e ==> ~(x = pathstart(k e))) /\\\n        (v = b e ==> ~(x = pathfinish(k e)))\n        ==> DISJOINT (segment[p v,x]) (path_image(k e))
      #|  !s t u s' t' u':A->bool.\n        (s UNION t UNION u) INTER (s' UNION t' UNION u') =\n        (s INTER s') UNION (s INTER t') UNION (s INTER u') UNION\n        (t INTER s') UNION (t INTER t') UNION (t INTER u') UNION\n        (u INTER s') UNION (u INTER t') UNION (u INTER u')
      #|  !s t:A->bool. !x y.\n        DISJOINT s t /\\ x IN s /\\ y IN t ==> ~(x = y)
      #|  s:A->bool = {a,b} /\\ t = {c,d}\n        ==> s INTER t = {a,b} INTER {c,d}
      #|  (e:A->bool) INTER (e':A->bool) =\n    {a e,b e} INTER {a e',b e'}
      #|  pathfinish((k:(A->bool)->real^1->real^2) (e':A->bool))
