      #|  fan_rotation_invariant\n    (V:A->bool) (E:(A->bool)->bool) (r:(A#A)->A#A)\n    (x:A) (w:num->A) (p:A#A) h t <=>\n        euler_planar_rotation\n         (x INSERT V) (fan_edges x w E t) (fan_rotation x w p r t) /\\\n        graph_face_successor\n         (fan_edges x w E t) (fan_rotation x w p r t) p = (w 0,x) /\\\n        graph_face_successor\n         (fan_edges x w E t) (fan_rotation x w p r t) (w 0,x) =\n        (x,w t) /\\\n        graph_face_successor\n         (fan_edges x w E t) (fan_rotation x w p r t) (x,w t) =\n        graph_face_successor E r (fan_source_dart p w t) /\\\n        (!i. t <= i /\\ i < h\n             ==> graph_face_successor\n                  (fan_edges x w E t) (fan_rotation x w p r t)\n                  (w i,w (SUC i)) =\n                 graph_face_successor E r (w i,w (SUC i))) /\\\n        (!d. d IN graph_darts E /\\\n             ~(d = p) /\\\n             (!i. i < h ==> ~(d = (w i,w (SUC i))))\n             ==> graph_face_successor\n                  (fan_edges x w E t) (fan_rotation x w p r t) d =\n                 graph_face_successor E r d)
      #|  fan_rotation_induction_statement\n    (V:A->bool) (E:(A->bool)->bool) (r:(A#A)->A#A)\n    (x:A) (w:num->A) (p:A#A) h t <=>\n        euler_planar_rotation V E r /\\\n        ~(x IN V) /\\\n        INJ w (cyclic_indices (h + 1)) (:A) /\\\n        (!i. i <= h ==> w i IN V) /\\\n        p IN graph_darts E /\\\n        SND p = w 0 /\\\n        (!i. i < h ==> (w i,w (SUC i)) IN graph_darts E) /\\\n        (!i. i < h ==> ~(p = (w i,w (SUC i)))) /\\\n        (!i. i < h\n             ==> graph_face_successor E r (fan_source_dart p w i) =\n                 (w i,w (SUC i)))\n        ==> t <= h\n        ==> fan_rotation_invariant V E r x w p h t
