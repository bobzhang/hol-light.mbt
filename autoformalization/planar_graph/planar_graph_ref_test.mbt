      #|  E1:(A->bool)->bool
      #|  V2:A->bool
      #|  V1:A->bool
      #|  outgoing_darts E1 (v:A) INTER outgoing_darts E2 v = {(v,u)}
      #|  !V1 V2:A->bool. !E1 E2:(A->bool)->bool.\n   !u v:A. !d:A#A.\n        finite_simple_graph V1 E1 /\\\n        finite_simple_graph V2 E2 /\\\n        V1 INTER V2 = {u,v} /\\\n        {u,v} IN E1 /\\\n        {u,v} IN E2 /\\\n        d IN graph_darts E1 DELETE (u,v) /\\\n        SND d = v\n        ==> ~(reverse_dart d IN outgoing_darts E2 v)
      #|  (d:A#A) = (u,v)
      #|  reverse_dart(d:A#A) = (u,v)
