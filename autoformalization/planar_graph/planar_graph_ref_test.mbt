      #|  ~((q:num->A) (i + 1) = q j)
      #|  (i + 1) MOD (j + 2) = i + 1
      #|  SND(cyclic_dart (q:num->A) n i) = q j
      #|  i + 1 = j
      #|  cyclic_dart (q:num->A) n i = (q i,q (i + 1))
      #|  i:num
      #|  graph_face_successor E1 r1 (cyclic_dart (q:num->A) n i) =\n    cyclic_dart (cyclic_split_left q n j) (j + 2)\n      ((i + 1) MOD (j + 2))
      #|  cyclic_dart q n i:A#A
      #|  q (n - 1):A
      #|  (q:num->A) j
      #|  r2:(A#A)->A#A
      #|  r1:(A#A)->A#A
      #|  E2:(A->bool)->bool
      #|  E1:(A->bool)->bool
      #|  V2:A->bool
      #|  V1:A->bool
      #|  graph_face_successor\n      (E1 UNION E2:(A->bool)->bool)\n      (graph_split_rotation (V1:A->bool) E1 E2 r1 r2\n        (q j) (q (n - 1)))\n      (cyclic_dart q n i) =\n    if SND(cyclic_dart q n i) = q j then\n      swap((q j,q (n - 1)),\n           graph_face_successor E2 r2 (q (n - 1),q j))\n        (graph_face_successor E1 r1 (cyclic_dart q n i))\n    else graph_face_successor E1 r1 (cyclic_dart q n i)
      #|  cyclic_dart (q:num->A) n i IN\n    graph_darts E1 DELETE (q j,q (n - 1))
      #|  ~(cyclic_dart (cyclic_split_left (q:num->A) n j) (j + 2) i =\n      cyclic_dart (cyclic_split_left q n j) (j + 2) j)
      #|  cyclic_dart (cyclic_split_left (q:num->A) n j) (j + 2) j =\n    (q j,q (n - 1))
      #|  cyclic_dart (q:num->A) n i =\n    cyclic_dart (cyclic_split_left q n j) (j + 2) i
      #|  graph_face_successor E2 r2\n      ((q:num->A) (n - 1),q j) = cyclic_dart q n j
      #|  !V1 V2:A->bool. !E1 E2:(A->bool)->bool.\n   !r1 r2:(A#A)->A#A. !q:num->A. !n j i.\n        finite_simple_graph V1 E1 /\\\n        finite_simple_graph V2 E2 /\\\n        simple_graph_cycle\n          E1 (cyclic_split_left q n j) (j + 2) /\\\n        cyclic_face_successors\n          E1 r1 (cyclic_split_left q n j) (j + 2) /\\\n        cyclic_face_successors\n          E2 r2 (cyclic_split_right q j) (n - j) /\\\n        j + 2 < n /\\\n        INJ q (cyclic_indices n) (:A) /\\\n        V1 INTER V2 = {q j,q (n - 1)} /\\\n        {q j,q (n - 1)} IN E1 /\\\n        {q j,q (n - 1)} IN E2 /\\\n        i < j\n        ==> graph_face_successor\n             (E1 UNION E2)\n             (graph_split_rotation V1 E1 E2 r1 r2\n               (q j) (q (n - 1)))\n             (cyclic_dart q n i) =\n            cyclic_dart q n (i + 1)
      #|  ((i:num) - j) + 1
      #|  j:num
      #|  n:num
      #|  q:num->A
      #|  cyclic_dart (cyclic_split_right (q:num->A) j) (n - j)\n        ((i - j) + 1) = cyclic_dart q n (i + 1)
      #|  j + ((i - j) + 1) = i + 1
      #|  ((i - j) + 1) MOD (n - j) = (i - j) + 1
      #|  ~(SND(cyclic_dart (q:num->A) n i) = q (n - 1))
      #|  (n:num) - 1
      #|  (i:num) + 1
      #|  n:num
      #|  q:num->A
      #|  ~((q:num->A) (i + 1) = q (n - 1))
      #|  (i - j) + 1 = n - j - 1
      #|  ((i - j) + 1) MOD (n - j) = (i - j) + 1
      #|  SND(cyclic_dart (q:num->A) n i) = q (n - 1)
      #|  i + 1 = n - 1
      #|  cyclic_dart (q:num->A) n i = (q i,q (i + 1))
      #|  (i:num) - j
      #|  graph_face_successor E2 r2 (cyclic_dart (q:num->A) n i) =\n    cyclic_dart (cyclic_split_right q j) (n - j)\n      (((i - j) + 1) MOD (n - j))
      #|  cyclic_dart q n i:A#A
      #|  q (n - 1):A
      #|  (q:num->A) j
      #|  r2:(A#A)->A#A
      #|  r1:(A#A)->A#A
      #|  E2:(A->bool)->bool
      #|  E1:(A->bool)->bool
      #|  V2:A->bool
      #|  V1:A->bool
      #|  graph_face_successor\n      (E1 UNION E2:(A->bool)->bool)\n      (graph_split_rotation (V1:A->bool) E1 E2 r1 r2\n        (q j) (q (n - 1)))\n      (cyclic_dart q n i) =\n    if SND(cyclic_dart q n i) = q (n - 1) then\n      swap((q (n - 1),q j),\n           graph_face_successor E1 r1 (q j,q (n - 1)))\n        (graph_face_successor E2 r2 (cyclic_dart q n i))\n    else graph_face_successor E2 r2 (cyclic_dart q n i)
      #|  cyclic_dart (q:num->A) n i IN\n    graph_darts E2 DELETE (q (n - 1),q j)
      #|  ~(cyclic_dart (cyclic_split_right (q:num->A) j) (n - j)\n        (i - j) =\n      cyclic_dart (cyclic_split_right q j) (n - j)\n        (n - j - 1))
      #|  cyclic_dart (cyclic_split_right (q:num->A) j) (n - j)\n      (n - j - 1) = (q (n - 1),q j)
      #|  cyclic_dart (q:num->A) n i =\n    cyclic_dart (cyclic_split_right q j) (n - j) (i - j)
      #|  (i:num) - j
      #|  j:num
      #|  n:num
      #|  q:num->A
      #|  cyclic_dart (cyclic_split_right (q:num->A) j) (n - j) (i - j) =\n    cyclic_dart q n i
      #|  j <= (i:num) ==> j + (i - j) = i
      #|  j + ((i:num) - j) = i
      #|  graph_face_successor E1 r1\n      ((q:num->A) j,q (n - 1)) = cyclic_dart q n (n - 1)
      #|  !V1 V2:A->bool. !E1 E2:(A->bool)->bool.\n   !r1 r2:(A#A)->A#A. !q:num->A. !n j i.\n        finite_simple_graph V1 E1 /\\\n        finite_simple_graph V2 E2 /\\\n        simple_graph_cycle\n          E2 (cyclic_split_right q j) (n - j) /\\\n        cyclic_face_successors\n          E1 r1 (cyclic_split_left q n j) (j + 2) /\\\n        cyclic_face_successors\n          E2 r2 (cyclic_split_right q j) (n - j) /\\\n        j + 2 < n /\\\n        INJ q (cyclic_indices n) (:A) /\\\n        V1 INTER V2 = {q j,q (n - 1)} /\\\n        {q j,q (n - 1)} IN E1 /\\\n        {q j,q (n - 1)} IN E2 /\\\n        j <= i /\\ i < n - 1\n        ==> graph_face_successor\n             (E1 UNION E2)\n             (graph_split_rotation V1 E1 E2 r1 r2\n               (q j) (q (n - 1)))\n             (cyclic_dart q n i) =\n            cyclic_dart q n (i + 1)
