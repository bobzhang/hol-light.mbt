      #|  k:(A->bool)->real^1->real^2
      #|  b:(A->bool)->A
      #|  a:(A->bool)->A
      #|  r:A->real
      #|  p:A->real^2
      #|  V:A->bool
      #|  DISJOINT\n     (segment[pathfinish((k:(A->bool)->real^1->real^2) (e:A->bool)),\n              (p:A->real^2)((b:(A->bool)->A) e)])\n     (path_image(k (e':A->bool)))
      #|  pathstart((k:(A->bool)->real^1->real^2) (e:A->bool))
      #|  (a:(A->bool)->A) (e:A->bool)
      #|  e':A->bool
      #|  k:(A->bool)->real^1->real^2
      #|  b:(A->bool)->A
      #|  a:(A->bool)->A
      #|  r:A->real
      #|  p:A->real^2
      #|  V:A->bool
      #|  DISJOINT\n     (segment[(p:A->real^2)((a:(A->bool)->A) (e:A->bool)),\n              pathstart((k:(A->bool)->real^1->real^2) e)])\n     (path_image(k (e':A->bool)))
      #|  pathfinish((k:(A->bool)->real^1->real^2) (e':A->bool))
      #|  pathfinish((k:(A->bool)->real^1->real^2) (e:A->bool))
      #|  (b:(A->bool)->A) (e':A->bool)
      #|  (b:(A->bool)->A) (e:A->bool)
      #|  r:A->real
