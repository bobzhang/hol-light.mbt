      #|  k:num
      #|  i:num
      #|  !z:num->real^2. !n j.\n        strictly_convex_cycle z n /\\ j + 2 < n\n        ==> strictly_convex_cycle (cyclic_split_right z j) (n - j)
      #|  !s:A->bool. !u:A->real. !f:A->real^N. !a:real^N. !b.\n        FINITE s /\\ sum s u = &1\n        ==> a dot (vsum s (\\x. u x % f x)) - b =\n            sum s (\\x. u x * (a dot f x - b))
      #|  (u:real^N->real) y = &0
      #|  a dot (y:real^N) = b
