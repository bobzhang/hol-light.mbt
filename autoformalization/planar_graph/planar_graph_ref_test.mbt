      #|  u:A
      #|  E2:(A->bool)->bool
      #|  E1:(A->bool)->bool
      #|  V2:A->bool
      #|  V1:A->bool
      #|  DISJOINT (S1:(A#A)->bool) S2 /\\\n    S1 UNION S2 = graph_darts (E1 UNION E2)
      #|  S2:(A#A)->bool = graph_darts E2 DELETE y
      #|  S1:(A#A)->bool = graph_darts E1 DELETE x
      #|  f2:(A#A)->A#A =\n      graph_face_successor (E2:(A->bool)->bool) (r2:(A#A)->A#A)
      #|  f1:(A#A)->A#A =\n      graph_face_successor (E1:(A->bool)->bool) (r1:(A#A)->A#A)
      #|  y:A#A = (v:A,u:A)
      #|  x:A#A = (u:A,v:A)
      #|  !V1 V2:A->bool. !E1 E2:(A->bool)->bool.\n   !r1 r2:(A#A)->A#A. !u v:A.\n        finite_simple_graph V1 E1 /\\\n        finite_simple_graph V2 E2 /\\\n        graph_rotation E1 r1 /\\\n        graph_rotation E2 r2 /\\\n        V1 INTER V2 = {u,v} /\\\n        {u,v} IN E1 /\\\n        {u,v} IN E2\n        ==> graph_split_face_permutation E1 E2 r1 r2 u v\n            permutes graph_darts (E1 UNION E2)
      #|  CARD(permutation_orbits (g1:(A#A)->A#A) S1) =\n      CARD\n       (permutation_orbits\n         (f1:(A#A)->A#A)\n         (graph_darts (E1:(A->bool)->bool))) /\\\n    CARD(permutation_orbits (g2:(A#A)->A#A) S2) =\n      CARD\n       (permutation_orbits\n         (f2:(A#A)->A#A)\n         (graph_darts (E2:(A->bool)->bool)))
      #|  CARD(permutation_orbits (p:(A#A)->A#A) (S1 UNION S2)) =\n    CARD(permutation_orbits g1 S1) +\n    CARD(permutation_orbits g2 S2)
      #|  CARD(permutation_orbits (p:(A#A)->A#A) (S1 UNION S2)) =\n    CARD\n     (permutation_orbits\n       (swap((f1:(A#A)->A#A) x,(f2:(A#A)->A#A) y) o p)\n       (S1 UNION S2)) + 1
      #|  (f2:(A#A)->A#A) y
      #|  (f1:(A#A)->A#A) x
      #|  S2:(A#A)->bool
      #|  S1:(A#A)->bool
      #|  g2:(A#A)->A#A
      #|  g1:(A#A)->A#A
      #|  ~(permutation_orbit (p:(A#A)->A#A)\n       ((f1:(A#A)->A#A) x) =\n      permutation_orbit p ((f2:(A#A)->A#A) y))
      #|  (p:(A#A)->A#A) permutes (S1 UNION S2)
      #|  y:A#A
      #|  graph_darts E2:A#A->bool
      #|  f2:(A#A)->A#A
      #|  x:A#A
      #|  graph_darts E1:A#A->bool
      #|  f1:(A#A)->A#A
      #|  (f1:(A#A)->A#A) x IN S1 /\\\n    (f2:(A#A)->A#A) y IN S2
      #|  (g1:(A#A)->A#A) permutes S1 /\\ (g2:(A#A)->A#A) permutes S2
      #|  y:A#A
      #|  r2:(A#A)->A#A
      #|  E2:(A->bool)->bool
      #|  V2:A->bool
      #|  x:A#A
      #|  r1:(A#A)->A#A
      #|  E1:(A->bool)->bool
      #|  V1:A->bool
      #|  ~((f1:(A#A)->A#A) x = x) /\\\n    ~((f2:(A#A)->A#A) y = y)
      #|  {v:A,u} = {u,v}
      #|  (x:A#A) IN graph_darts E1 /\\ (y:A#A) IN graph_darts E2
      #|  (f1:(A#A)->A#A) permutes graph_darts E1 /\\\n    (f2:(A#A)->A#A) permutes graph_darts E2
      #|  FINITE(S1:(A#A)->bool) /\\ FINITE(S2:(A#A)->bool)
      #|  E2:(A->bool)->bool
      #|  V2:A->bool
      #|  E1:(A->bool)->bool
      #|  V1:A->bool
      #|  FINITE(graph_darts E1:A#A->bool) /\\\n    FINITE(graph_darts E2:A#A->bool)
      #|  v:A
      #|  u:A
      #|  E2:(A->bool)->bool
      #|  E1:(A->bool)->bool
      #|  V2:A->bool
      #|  V1:A->bool
      #|  DISJOINT (S1:(A#A)->bool) S2 /\\\n    S1 UNION S2 = graph_darts (E1 UNION E2)
      #|  p:(A#A)->A#A =\n      disjoint_permutation_union (g1:(A#A)->A#A) S1 g2
      #|  g2:(A#A)->A#A = permutation_delete (f2:(A#A)->A#A) y
      #|  g1:(A#A)->A#A = permutation_delete (f1:(A#A)->A#A) x
      #|  S2:(A#A)->bool = graph_darts E2 DELETE y
      #|  S1:(A#A)->bool = graph_darts E1 DELETE x
      #|  f2:(A#A)->A#A =\n      graph_face_successor (E2:(A->bool)->bool) (r2:(A#A)->A#A)
      #|  f1:(A#A)->A#A =\n      graph_face_successor (E1:(A->bool)->bool) (r1:(A#A)->A#A)
      #|  y:A#A = (v:A,u:A)
      #|  x:A#A = (u:A,v:A)
      #|  !V1 V2:A->bool. !E1 E2:(A->bool)->bool.\n   !r1 r2:(A#A)->A#A. !u v:A.\n        finite_simple_graph V1 E1 /\\\n        finite_simple_graph V2 E2 /\\\n        graph_rotation E1 r1 /\\\n        graph_rotation E2 r2 /\\\n        V1 INTER V2 = {u,v} /\\\n        {u,v} IN E1 /\\\n        {u,v} IN E2\n        ==> CARD(graph_faces E1 r1) + CARD(graph_faces E2 r2) =\n            CARD\n             (permutation_orbits\n               (graph_split_face_permutation E1 E2 r1 r2 u v)\n               (graph_darts (E1 UNION E2))) + 1
      #|  !f:A->A. !x z.\n        swap(x,f x) (permutation_delete f x z) = f z
      #|  !f g:A->A. !x y z.\n        ~(f z = f x) /\\\n        ~(f z = g y)\n        ==> swap(f x,g y) (permutation_delete f x z) =\n            swap(x,g y) (f z)
      #|  !V1 E1 E2 r1 r2 u v d:A#A.\n        {u,v} IN E2 /\\\n        d IN outgoing_darts E1 u\n        ==> graph_split_local_rotation V1 E1 E2 r1 r2 u v u d =\n            swap((u,v),r2(u,v)) (r1 d)
      #|  {v:A,u} = {u,v}
      #|  !V1 E1 E2 r1 r2 u v d:A#A.\n        ~(u = v) /\\\n        {u,v} IN E1 /\\\n        d IN outgoing_darts E2 v\n        ==> graph_split_local_rotation V1 E1 E2 r1 r2 u v v d =\n            swap((v,u),r1(v,u)) (r2 d)
      #|  !V1 E1 E2 r1 r2 u v d:A#A.\n        ~(u = v) /\\\n        {u,v} IN E1 /\\\n        d IN outgoing_darts E1 v /\\\n        ~(d IN outgoing_darts E2 v)\n        ==> graph_split_local_rotation V1 E1 E2 r1 r2 u v v d =\n            r1 d
      #|  !V1 E1 E2 r1 r2 u v d:A#A.\n        {u,v} IN E2 /\\\n        d IN outgoing_darts E2 u /\\\n        ~(d IN outgoing_darts E1 u)\n        ==> graph_split_local_rotation V1 E1 E2 r1 r2 u v u d =\n            r2 d
      #|  !V1 E1 E2 r1 r2 u v w d:A#A.\n        ~(w = u) /\\\n        ~(w = v) /\\\n        w IN V1 /\\\n        d IN outgoing_darts E1 w\n        ==> graph_split_local_rotation V1 E1 E2 r1 r2 u v w d =\n            r1 d
      #|  !V1 E1 E2 r1 r2 u v w d:A#A.\n        ~(w = u) /\\\n        ~(w = v) /\\\n        ~(w IN V1) /\\\n        d IN outgoing_darts E2 w\n        ==> graph_split_local_rotation V1 E1 E2 r1 r2 u v w d =\n            r2 d
      #|  d:A#A
      #|  x:A#A
      #|  graph_darts E1:A#A->bool
      #|  f1:(A#A)->A#A
      #|  FST:A#A->A
      #|  ~((f1:(A#A)->A#A) d = (f2:(A#A)->A#A) y)
      #|  x:A#A
      #|  d:A#A
      #|  (f1:(A#A)->A#A) permutes graph_darts E1
      #|  graph_darts E1:A#A->bool
      #|  f1:(A#A)->A#A
      #|  ~((f1:(A#A)->A#A) d = (f1:(A#A)->A#A) x)
      #|  FST:A#A->A
      #|  ~((f1:(A#A)->A#A) d = x)
      #|  (f1:(A#A)->A#A) d IN S2
      #|  (f1:(A#A)->A#A) d
      #|  ~((f1:(A#A)->A#A) d IN S2)
      #|  d:A#A
      #|  graph_darts E1:A#A->bool
      #|  f1:(A#A)->A#A
      #|  (f1:(A#A)->A#A) d IN S1
      #|  (f1:(A#A)->A#A) d = x
      #|  x:A#A
      #|  d:A#A
      #|  (f1:(A#A)->A#A) permutes graph_darts E1
      #|  graph_darts E1:A#A->bool
      #|  f1:(A#A)->A#A
      #|  SND(d:A#A) = u
      #|  y:A#A
      #|  r2:(A#A)->A#A
      #|  E2:(A->bool)->bool
      #|  FST((f2:(A#A)->A#A) y) = SND y
      #|  x:A#A
      #|  r1:(A#A)->A#A
      #|  E1:(A->bool)->bool
      #|  FST((f1:(A#A)->A#A) x) = SND x
      #|  d:A#A
      #|  r1:(A#A)->A#A
      #|  E1:(A->bool)->bool
      #|  FST((f1:(A#A)->A#A) d) = SND d
      #|  {v:A,u} = {u,v}
      #|  (f2:(A#A)->A#A) y =\n      (r2:(A#A)->A#A) (x:A#A)
      #|  ~((r2:(A#A)->A#A) (u,v) = (u,v))
      #|  restricted_permutation r2 (outgoing_darts E2 u) (u,v) =\n      (r2:(A#A)->A#A) (u,v)
      #|  ~((f2:(A#A)->A#A) y = x)
      #|  y:A#A
      #|  graph_darts E2:A#A->bool
      #|  f2:(A#A)->A#A
      #|  (y:A#A) IN graph_darts E2
      #|  graph_rotation E2 (r2:(A#A)->A#A)
      #|  finite_simple_graph (V2:A->bool) E2
      #|  y:A#A
      #|  r2:(A#A)->A#A
      #|  E2:(A->bool)->bool
      #|  V2:A->bool
      #|  ~((f2:(A#A)->A#A) y = y)
      #|  (f2:(A#A)->A#A) y IN S2
      #|  (d:A#A) IN S1
      #|  {v:A,u} = {u,v}
      #|  (x:A#A) IN graph_darts E1 /\\\n    (y:A#A) IN graph_darts E2
      #|  (f1:(A#A)->A#A) permutes graph_darts E1 /\\\n    (f2:(A#A)->A#A) permutes graph_darts E2
      #|  v:A
      #|  u:A
      #|  E2:(A->bool)->bool
      #|  E1:(A->bool)->bool
      #|  V2:A->bool
      #|  V1:A->bool
      #|  DISJOINT (S1:(A#A)->bool) S2
      #|  S2:(A#A)->bool = graph_darts E2 DELETE y
      #|  S1:(A#A)->bool = graph_darts E1 DELETE x
      #|  f2:(A#A)->A#A =\n      graph_face_successor (E2:(A->bool)->bool) (r2:(A#A)->A#A)
      #|  f1:(A#A)->A#A =\n      graph_face_successor (E1:(A->bool)->bool) (r1:(A#A)->A#A)
      #|  y:A#A = (v:A,u:A)
      #|  x:A#A = (u:A,v:A)
      #|  !V1 V2:A->bool. !E1 E2:(A->bool)->bool.\n   !r1 r2:(A#A)->A#A. !u v:A. !d:A#A.\n        finite_simple_graph V1 E1 /\\\n        finite_simple_graph V2 E2 /\\\n        graph_rotation E1 r1 /\\\n        graph_rotation E2 r2 /\\\n        V1 INTER V2 = {u,v} /\\\n        {u,v} IN E1 /\\\n        {u,v} IN E2 /\\\n        ~(restricted_permutation r2 (outgoing_darts E2 u) (u,v) =\n          (u,v)) /\\\n        d IN graph_darts E1 DELETE (u,v)\n        ==> graph_split_face_permutation E1 E2 r1 r2 u v d =\n            if SND d = u then\n              swap((u,v),graph_face_successor E2 r2 (v,u))\n                (graph_face_successor E1 r1 d)\n            else graph_face_successor E1 r1 d
      #|  (f1:(A#A)->A#A) d = x
      #|  (f1:(A#A)->A#A) d =\n                           (f2:(A#A)->A#A) y
      #|  (f1:(A#A)->A#A) d IN S2
      #|  d:A#A
      #|  ~((d:A#A) IN graph_darts E1 DELETE (u,v))
      #|  !E1 E2:(A->bool)->bool. !r1 r2:(A#A)->A#A.\n   !u v:A. !d:A#A.\n        DISJOINT\n          (graph_darts E1 DELETE (u,v))\n          (graph_darts E2 DELETE (v,u)) /\\\n        d IN graph_darts E2 DELETE (v,u)\n        ==> graph_split_face_permutation E1 E2 r1 r2 u v d =\n            graph_split_face_permutation E2 E1 r2 r1 v u d
      #|  {v:A,u} = {u,v}
      #|  d:A#A
      #|  u:A
      #|  v:A
      #|  r1:(A#A)->A#A
      #|  r2:(A#A)->A#A
      #|  E1:(A->bool)->bool
      #|  E2:(A->bool)->bool
      #|  V1:A->bool
      #|  V2:A->bool
      #|  graph_split_face_permutation\n      (E2:(A->bool)->bool) E1 r2 r1 v u d
      #|  (V2:A->bool) INTER V1 = {v,u}
      #|  v:A
      #|  u:A
      #|  E2:(A->bool)->bool
      #|  E1:(A->bool)->bool
      #|  V2:A->bool
      #|  V1:A->bool
      #|  DISJOINT\n      (graph_darts E1 DELETE ((u:A),(v:A)))\n      (graph_darts E2 DELETE (v,u))
      #|  !V1 V2:A->bool. !E1 E2:(A->bool)->bool.\n   !r1 r2:(A#A)->A#A. !u v:A. !d:A#A.\n        finite_simple_graph V1 E1 /\\\n        finite_simple_graph V2 E2 /\\\n        graph_rotation E1 r1 /\\\n        graph_rotation E2 r2 /\\\n        V1 INTER V2 = {u,v} /\\\n        {u,v} IN E1 /\\\n        {u,v} IN E2 /\\\n        ~(restricted_permutation r1 (outgoing_darts E1 v) (v,u) =\n          (v,u)) /\\\n        d IN graph_darts E2 DELETE (v,u)\n        ==> graph_split_face_permutation E1 E2 r1 r2 u v d =\n            if SND d = v then\n              swap((v,u),graph_face_successor E1 r1 (u,v))\n                (graph_face_successor E2 r2 d)\n            else graph_face_successor E2 r2 d
      #|  reverse_dart(d:A#A) = (v,u)
      #|  reverse_dart:A#A->A#A
      #|  (d:A#A) = (u,v)
      #|  reverse_dart(d:A#A) = (v,u)
      #|  reverse_dart(d:A#A) IN\n    outgoing_darts E1 v INTER outgoing_darts E2 v
      #|  reverse_dart(d:A#A) IN outgoing_darts E1 v
