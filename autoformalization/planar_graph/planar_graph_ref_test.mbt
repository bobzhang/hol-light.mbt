      #|  (c:(A->bool)->real^2->bool) {a,x} INTER c {a,y} = {p a} /\\\n      c {a,x} INTER c {y,b} = {} /\\\n      c {x,b} INTER c {a,y} = {} /\\\n      c {x,b} INTER c {y,b} = {p b}\n      ==> (c {a,x} UNION c {x,b}) INTER\n          (c {a,y} UNION c {y,b}) = {p a,p b}
      #|  (c:(A->bool)->real^2->bool) {a,b} INTER c {a,x} = {p a} /\\\n      c {a,b} INTER c {x,b} = {p b}\n      ==> c {a,b} INTER (c {a,x} UNION c {x,b}) =\n          {p a,p b}
