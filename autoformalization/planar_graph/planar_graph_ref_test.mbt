      #|  !V:A->bool. !E:(A->bool)->bool. !u v:A.\n   !W:A->bool. !D:(A->bool)->bool.\n        finite_simple_graph V E /\\\n        {u,v} IN E /\\\n        finite_simple_graph W D /\\\n        W SUBSET V DELETE u /\\\n        D SUBSET graph_contract_edges V E u v\n        ==> IMAGE (IMAGE (swap(u,v))) D SUBSET\n            graph_contract_edges V E v u
      #|  d:A->bool
