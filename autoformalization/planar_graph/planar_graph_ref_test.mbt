      #|  (\\z:real^(1,1)finite_sum. vector_derivative h (at (sndcart z))) =\n      (\\t. vector_derivative (h:real^1->complex) (at t)) o sndcart
      #|  (\\z:real^(1,1)finite_sum. vector_derivative g (at (fstcart z))) =\n      (\\t. vector_derivative (g:real^1->complex) (at t)) o fstcart
      #|  (\\t:real^1. (f:complex->complex->complex) (g t) (h y)) =\n      (\\z. f (fstcart z) (sndcart z)) o\n      (\\t. pastecart (g t) (h(y:real^1)))
      #|  y:real^1
