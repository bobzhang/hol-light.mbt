      #|  segment[pathfinish((k:(A->bool)->real^1->real^2) (e:A->bool)),\n            (p:A->real^2)((b:(A->bool)->A) e)] INTER\n    segment[pathfinish(k (e':A->bool)),p((b:(A->bool)->A) e')] =\n    IMAGE p ({b e} INTER {b e'})
      #|  pathstart((k:(A->bool)->real^1->real^2) (e':A->bool))
      #|  pathfinish((k:(A->bool)->real^1->real^2) (e:A->bool))
