      #|  !z:num->real^2. !n j.\n        strictly_convex_cycle z n /\\ j + 2 < n\n        ==> convex hull\n             (cyclic_vertices (cyclic_split_left z n j) (j + 2)) INTER\n            convex hull\n             (cyclic_vertices (cyclic_split_right z j) (n - j)) =\n            segment[z j,z (n - 1)]
