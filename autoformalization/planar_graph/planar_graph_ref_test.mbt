      #|  E1:(A->bool)->bool
      #|  V2:A->bool
      #|  V1:A->bool
      #|  CARD(graph_faces (E1:(A->bool)->bool) (r1:(A#A)->A#A)) +\n    CARD(graph_faces (E2:(A->bool)->bool) (r2:(A#A)->A#A)) =\n    CARD\n     (graph_faces\n       (E1 UNION E2:(A->bool)->bool)\n       (graph_split_rotation\n         (V1:A->bool) E1 E2 r1 r2 u v)) + 1
      #|  CARD(V2:A->bool) +\n    CARD(graph_faces (E2:(A->bool)->bool) (r2:(A#A)->A#A)) =\n    CARD(E2:(A->bool)->bool) + 2
      #|  CARD(V1:A->bool) +\n    CARD(graph_faces (E1:(A->bool)->bool) (r1:(A#A)->A#A)) =\n    CARD(E1:(A->bool)->bool) + 2
      #|  E2:(A->bool)->bool
      #|  E1:(A->bool)->bool
      #|  CARD(E1 UNION E2:(A->bool)->bool) + 1 = CARD E1 + CARD E2
      #|  V2:A->bool
      #|  V1:A->bool
      #|  CARD(V1 UNION V2:A->bool) + 2 = CARD V1 + CARD V2
      #|  CARD((E1:(A->bool)->bool) INTER E2) <= CARD E1
      #|  CARD(V1 INTER V2:A->bool) <= CARD V1
