      #|  !V1 V2:A->bool. !E1 E2:(A->bool)->bool.\n   !r1 r2:(A#A)->A#A. !u v:A. !d:A#A.\n        finite_simple_graph V1 E1 /\\\n        finite_simple_graph V2 E2 /\\\n        V1 INTER V2 = {u,v} /\\\n        {u,v} IN E1 /\\\n        {u,v} IN E2 /\\\n        d IN graph_darts E2 DELETE (v,u)\n        ==> graph_face_successor\n             (E1 UNION E2)\n             (graph_split_rotation V1 E1 E2 r1 r2 u v) d =\n            if SND d = v then\n              swap((v,u),graph_face_successor E1 r1 (u,v))\n                (graph_face_successor E2 r2 d)\n            else graph_face_successor E2 r2 d
      #|  SND(d:A#A) = v
