      #|  !B M R E:A->bool. !p q r s t:A.\n        ~(p = q) /\\ ~(p = r) /\\ ~(p = s) /\\ ~(p = t) /\\\n        ~(q = r) /\\ ~(q = s) /\\ ~(q = t) /\\\n        ~(r = s) /\\ ~(r = t) /\\ ~(s = t) /\\\n        s IN R /\\ ~(t IN R) /\\ ~(r IN R) /\\ ~(p IN R) /\\\n        q IN M /\\ ~(p IN M) /\\ ~(p IN B) /\\\n        ~(p IN E) /\\ ~(s IN E)\n        ==> B UNION M UNION (({s,t} UNION (E DELETE r)) DIFF R) =\n            {q,t} UNION\n            ((B UNION\n              (p INSERT (M DELETE q)) UNION\n              (E DIFF (r INSERT (R DELETE s)))) DELETE p)
