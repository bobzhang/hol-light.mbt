      #|  V0:A->bool
      #|  E:(A->bool)->bool
      #|  V:A->bool
      #|  (p1:num->A) l1 = c
      #|  (p1:num->A) 0 = b
      #|  graph_subdivision (V:A->bool) E (V1:A->bool) (E1:(A->bool)->bool)
      #|  E1:(A->bool)->bool =\n    (E0 DELETE {b:A,c}) UNION indexed_path_edges (p1:num->A) l1
      #|  V1:A->bool =\n    V0 UNION indexed_path_vertices (p1:num->A) l1
      #|  {b:A,c} IN E0
      #|  p0:num->A
      #|  E:(A->bool)->bool
      #|  V:A->bool
      #|  l0:num
      #|  (p0:num->A) l0 = b
      #|  (p0:num->A) 0 = a
      #|  graph_subdivision (V:A->bool) E (V0:A->bool) (E0:(A->bool)->bool)
      #|  E0:(A->bool)->bool =\n    (E DELETE {a:A,b}) UNION indexed_path_edges (p0:num->A) l0
      #|  V0:A->bool =\n    V UNION indexed_path_vertices (p0:num->A) l0
      #|  !V:A->bool. !E:(A->bool)->bool. !a b c d:A.\n   !l0 l1 l2 l3. !p0 p1 p2 p3:num->A.\n        finite_simple_graph V E /\\\n        {a,b} IN E /\\ {b,c} IN E /\\ {c,d} IN E /\\ {d,a} IN E /\\\n        (~(a = b) /\\ ~(a = c) /\\ ~(a = d) /\\\n         ~(b = c) /\\ ~(b = d) /\\ ~(c = d)) /\\\n        (0 < l0 /\\ 0 < l1 /\\ 0 < l2 /\\ 0 < l3) /\\\n        (p0 0 = a /\\ p0 l0 = b /\\\n         p1 0 = b /\\ p1 l1 = c /\\\n         p2 0 = c /\\ p2 l2 = d /\\\n         p3 0 = d /\\ p3 l3 = a) /\\\n        (INJ p0 (0..l0) (:A) /\\\n         INJ p1 (0..l1) (:A) /\\\n         INJ p2 (0..l2) (:A) /\\\n         INJ p3 (0..l3) (:A)) /\\\n        (!i. 0 < i /\\ i < l0 ==> ~(p0 i IN V)) /\\\n        (!i. 0 < i /\\ i < l1\n             ==> ~(p1 i IN V UNION indexed_path_vertices p0 l0)) /\\\n        (!i. 0 < i /\\ i < l2\n             ==> ~(p2 i IN\n                   (V UNION indexed_path_vertices p0 l0) UNION\n                   indexed_path_vertices p1 l1)) /\\\n        (!i. 0 < i /\\ i < l3\n             ==> ~(p3 i IN\n                   ((V UNION indexed_path_vertices p0 l0) UNION\n                    indexed_path_vertices p1 l1) UNION\n                   indexed_path_vertices p2 l2))\n        ==> graph_subdivision V E\n             (four_path_extension_vertices V\n               p0 l0 p1 l1 p2 l2 p3 l3)\n             (four_path_extension_edges E a b c d\n               p0 l0 p1 l1 p2 l2 p3 l3)
      #|  !B E C:(A->bool)->bool. !a b c d:A.\n   !l0 l1 l2 l3. !p0 p1 p2 p3:num->A.\n        B SUBSET {{a,b},{b,c},{c,d},{d,a}} UNION E /\\\n        indexed_path_edges p0 l0 SUBSET C /\\\n        indexed_path_edges p1 l1 SUBSET C /\\\n        indexed_path_edges p2 l2 SUBSET C /\\\n        indexed_path_edges p3 l3 SUBSET C /\\\n        C SUBSET E\n        ==> four_path_extension_edges B a b c d\n             p0 l0 p1 l1 p2 l2 p3 l3 SUBSET E
      #|  three_path_extension_vertices (V:A->bool)\n    (p0:num->A) l0 (p1:num->A) l1 (p2:num->A) l2 =\n      ((V UNION indexed_path_vertices p0 l0) UNION\n       indexed_path_vertices p1 l1) UNION\n      indexed_path_vertices p2 l2
      #|  three_path_extension_edges (E:(A->bool)->bool)\n    (a:A) b c\n    (p0:num->A) l0 (p1:num->A) l1 (p2:num->A) l2 =\n      (((((E DELETE {a,b}) UNION indexed_path_edges p0 l0)\n         DELETE {b,c}) UNION indexed_path_edges p1 l1)\n         DELETE {c,a}) UNION indexed_path_edges p2 l2
      #|  p2:num->A
      #|  l2:num
      #|  ((E DELETE {a:A,b}) UNION indexed_path_edges (p0:num->A) l0)\n       DELETE {b,c} UNION indexed_path_edges (p1:num->A) l1
      #|  (V UNION indexed_path_vertices (p0:num->A) l0) UNION\n       indexed_path_vertices (p1:num->A) l1
      #|  E:(A->bool)->bool
      #|  V:A->bool
      #|  (p2:num->A) l2 = a
      #|  (p2:num->A) 0 = c
      #|  {c:A,a} IN E1
      #|  p1:num->A
      #|  l1:num
      #|  E0:(A->bool)->bool
      #|  V0:A->bool
      #|  E:(A->bool)->bool
      #|  V:A->bool
      #|  (p1:num->A) l1 = c
      #|  (p1:num->A) 0 = b
      #|  graph_subdivision (V:A->bool) E (V1:A->bool) (E1:(A->bool)->bool)
      #|  E1:(A->bool)->bool =\n    (E0 DELETE {b:A,c}) UNION indexed_path_edges (p1:num->A) l1
      #|  V1:A->bool =\n    V0 UNION indexed_path_vertices (p1:num->A) l1
      #|  {b:A,c} IN E0
      #|  p0:num->A
      #|  E:(A->bool)->bool
      #|  V:A->bool
      #|  l0:num
      #|  (p0:num->A) l0 = b
