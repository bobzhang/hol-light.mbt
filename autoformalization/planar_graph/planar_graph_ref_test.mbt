      #|  !s:real^N->bool. !a x:real^N. !b.\n        FINITE s /\\\n        (!y. y IN s ==> b <= a dot y) /\\\n        x IN convex hull s /\\ a dot x = b\n        ==> x IN convex hull {y | y IN s /\\ a dot y = b}
      #|  (y:real^N) IN s
