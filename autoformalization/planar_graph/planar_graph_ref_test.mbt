      #|  (a:(A->bool)->A) (e':A->bool)
      #|  (a:(A->bool)->A) (e':A->bool)
      #|  (a:(A->bool)->A) (e:A->bool)
      #|  (a:(A->bool)->A) (e:A->bool)
      #|  (b:(A->bool)->A) (e':A->bool)
      #|  (b:(A->bool)->A) (e':A->bool)
      #|  (a:(A->bool)->A) (e:A->bool)
      #|  (b:(A->bool)->A) (e:A->bool)
      #|  (a:(A->bool)->A) (e':A->bool)
      #|  (a:(A->bool)->A) (e':A->bool)
      #|  (b:(A->bool)->A) (e:A->bool)
      #|  (b:(A->bool)->A) (e:A->bool)
      #|  (b:(A->bool)->A) (e':A->bool)
      #|  (b:(A->bool)->A) (e':A->bool)
