      #|  E0:(A->bool)->bool =\n    (E DELETE {a:A,b}) UNION indexed_path_edges (p0:num->A) l0
      #|  V0:A->bool =\n    V UNION indexed_path_vertices (p0:num->A) l0
      #|  !V:A->bool. !E:(A->bool)->bool. !a b c:A.\n   !l0 l1 l2. !p0 p1 p2:num->A.\n        finite_simple_graph V E /\\\n        {a,b} IN E /\\ {b,c} IN E /\\ {c,a} IN E /\\\n        ~(a = b) /\\ ~(a = c) /\\ ~(b = c) /\\\n        0 < l0 /\\ 0 < l1 /\\ 0 < l2 /\\\n        p0 0 = a /\\ p0 l0 = b /\\\n        p1 0 = b /\\ p1 l1 = c /\\\n        p2 0 = c /\\ p2 l2 = a /\\\n        INJ p0 (0..l0) (:A) /\\\n        INJ p1 (0..l1) (:A) /\\\n        INJ p2 (0..l2) (:A) /\\\n        (!i. 0 < i /\\ i < l0 ==> ~(p0 i IN V)) /\\\n        (!i. 0 < i /\\ i < l1\n             ==> ~(p1 i IN V UNION indexed_path_vertices p0 l0)) /\\\n        (!i. 0 < i /\\ i < l2\n             ==> ~(p2 i IN\n                   (V UNION indexed_path_vertices p0 l0) UNION\n                   indexed_path_vertices p1 l1))\n        ==> graph_subdivision V E\n             (three_path_extension_vertices V p0 l0 p1 l1 p2 l2)\n             (three_path_extension_edges E a b c\n               p0 l0 p1 l1 p2 l2)
      #|  !B E C:(A->bool)->bool. !a b c:A.\n   !l0 l1 l2. !p0 p1 p2:num->A.\n        B SUBSET {{a,b},{b,c},{c,a}} UNION E /\\\n        indexed_path_edges p0 l0 SUBSET C /\\\n        indexed_path_edges p1 l1 SUBSET C /\\\n        indexed_path_edges p2 l2 SUBSET C /\\\n        C SUBSET E\n        ==> three_path_extension_edges B a b c\n             p0 l0 p1 l1 p2 l2 SUBSET E
      #|  e:A->bool
      #|  !a b c d u v:A.\n        complete_bipartite_edges {a,c,v} {b,d,u} SUBSET\n        {{a,b},{b,c},{c,d},{d,a},{u,a},{u,c},{v,b},{v,d},{u,v}}
      #|  d:A
