      #|  !V:A->bool. !E:(A->bool)->bool. !r:(A#A)->A#A.\n   !u v:A. !a b d:A#A.\n        finite_simple_graph V E /\\\n        graph_rotation E r /\\\n        ~(u = v) /\\\n        ~({u,v} IN E) /\\\n        a IN outgoing_darts E u /\\\n        b IN outgoing_darts E v /\\\n        d IN graph_darts E /\\\n        ~(d = reverse_dart a) /\\\n        ~(d = reverse_dart b)\n        ==> graph_face_successor\n             ({u,v} INSERT E)\n             (permutation_insert\n               (permutation_insert r (u,v) a)\n               (v,u) b) d =\n            graph_face_successor E r d
