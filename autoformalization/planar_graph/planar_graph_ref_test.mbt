      #|  DISJOINT\n     (path_image((k:(A->bool)->real^1->real^2) (e:A->bool)))\n     (segment[pathfinish((k:(A->bool)->real^1->real^2) (e':A->bool)),\n              (p:A->real^2)((b:(A->bool)->A) e')])
      #|  pathstart((k:(A->bool)->real^1->real^2) (e':A->bool))
