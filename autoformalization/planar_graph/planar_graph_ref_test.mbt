      #|  !V1 V2:A->bool. !E1 E2:(A->bool)->bool.\n   !r1 r2:(A#A)->A#A. !u v:A.\n        euler_planar_rotation V1 E1 r1 /\\\n        euler_planar_rotation V2 E2 r2 /\\\n        V1 INTER V2 = {u,v} /\\\n        {u,v} IN E1 /\\\n        {u,v} IN E2 /\\\n        ~(restricted_permutation r2 (outgoing_darts E2 u) (u,v) =\n          (u,v)) /\\\n        ~(restricted_permutation r1 (outgoing_darts E1 v) (v,u) =\n          (v,u))\n        ==> euler_planar_rotation\n             (V1 UNION V2)\n             (E1 UNION E2)\n             (graph_split_rotation V1 E1 E2 r1 r2 u v)
      #|  E1:(A->bool)->bool = {}
      #|  E2:(A->bool)->bool = {}
      #|  E1 UNION E2:(A->bool)->bool = {}
      #|  !q:num->A. !n i k.\n        INJ q (cyclic_indices n) (:A) /\\ i < n /\\ k < n\n        ==> (q i = q k <=> i = k)
      #|  (i + 1) MOD n = i + 1
      #|  (i + 1) MOD (j + 2) = i + 1
      #|  !q:num->A. !n j i.\n        j + 2 < n /\\ i < j\n        ==> cyclic_dart (cyclic_split_left q n j) (j + 2) i =\n            cyclic_dart q n i
      #|  (j + 1) MOD (j + 2) = j + 1
      #|  !q:num->A. !n j.\n        j + 2 < n\n        ==> cyclic_dart (cyclic_split_left q n j) (j + 2) j =\n            (q j,q (n - 1))
      #|  n - 1 + 1 = n
      #|  (n - 1 + 1) MOD n = 0
      #|  (j + 1) + 1 = j + 2
      #|  ((j + 1) + 1) MOD (j + 2) = 0
      #|  !q:num->A. !n j.\n        j + 2 < n\n        ==> cyclic_dart (cyclic_split_left q n j) (j + 2) (j + 1) =\n            cyclic_dart q n (n - 1)
      #|  ((j + k) + 1) MOD n = (j + k) + 1
      #|  (k + 1) MOD (n - j) = k + 1
      #|  !q:num->A. !n j k.\n        j + 2 < n /\\ k < n - j - 1\n        ==> cyclic_dart (cyclic_split_right q j) (n - j) k =\n            cyclic_dart q n (j + k)
      #|  n - j - 1 + 1 = n - j
      #|  (n - j - 1 + 1) MOD (n - j) = 0
      #|  !q:num->A. !n j.\n        j + 2 < n\n        ==> cyclic_dart (cyclic_split_right q j) (n - j)\n             (n - j - 1) =\n            (q (n - 1),q j)
      #|  0
      #|  j:num
      #|  n:num
      #|  q:num->A
      #|  !q:num->A. !n j.\n        j + 2 < n\n        ==> cyclic_dart (cyclic_split_right q j) (n - j) 0 =\n            cyclic_dart q n j
      #|  cyclic_dart (cyclic_split_left (q:num->A) n j) (j + 2) (j + 1) =\n    cyclic_dart q n (n - 1)
      #|  cyclic_dart (cyclic_split_left (q:num->A) n j) (j + 2) j =\n    (q j,q (n - 1))
      #|  (j + 1) MOD (j + 2) = j + 1
      #|  j:num
      #|  !E:(A->bool)->bool. !r:(A#A)->A#A. !q:num->A. !n j.\n        j + 2 < n /\\\n        cyclic_face_successors E r (cyclic_split_left q n j) (j + 2)\n        ==> graph_face_successor E r (q j,q (n - 1)) =\n            cyclic_dart q n (n - 1)
      #|  cyclic_dart (cyclic_split_right (q:num->A) j) (n - j) 0 =\n    cyclic_dart q n j
      #|  cyclic_dart (cyclic_split_right (q:num->A) j) (n - j)\n      (n - j - 1) = (q (n - 1),q j)
      #|  (n - j - 1) + 1 = n - j
      #|  ((n - j - 1) + 1) MOD (n - j) = 0
      #|  n - j - 1
      #|  !E:(A->bool)->bool. !r:(A#A)->A#A. !q:num->A. !n j.\n        j + 2 < n /\\\n        cyclic_face_successors E r (cyclic_split_right q j) (n - j)\n        ==> graph_face_successor E r (q (n - 1),q j) =\n            cyclic_dart q n j
      #|  cyclic_dart (cyclic_split_left (q:num->A) n j) (j + 2)\n        (i + 1) = cyclic_dart q n (i + 1)
      #|  (i + 1) MOD (j + 2) = i + 1
      #|  ~(SND(cyclic_dart (q:num->A) n i) = q j)
      #|  j:num
      #|  i + 1
