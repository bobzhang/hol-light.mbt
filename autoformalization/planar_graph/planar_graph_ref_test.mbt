      #|  !q:num->A. !n i j.\n        0 < i /\\ i < j /\\ j < n /\\\n        INJ q (cyclic_indices n) (:A)\n        ==> (~(q 0 = q i) /\\ ~(q 0 = q j) /\\ ~(q i = q j)) /\\\n            (0 < i /\\ 0 < j - i /\\ 0 < n - j) /\\\n            (q 0 = q 0 /\\ q i = q i /\\\n             cyclic_offset_path q i 0 = q i /\\\n             cyclic_offset_path q i (j - i) = q j /\\\n             cyclic_closing_path q j n 0 = q j /\\\n             cyclic_closing_path q j n (n - j) = q 0) /\\\n            (INJ q (0..i) (:A) /\\\n             INJ (cyclic_offset_path q i) (0..j - i) (:A) /\\\n             INJ (cyclic_closing_path q j n) (0..n - j) (:A)) /\\\n            (!t. 0 < t /\\ t < i\n                 ==> ~(q t IN {q 0,q i,q j})) /\\\n            (!t. 0 < t /\\ t < j - i\n                 ==> ~(cyclic_offset_path q i t IN\n                       {q 0,q i,q j} UNION\n                       indexed_path_vertices q i)) /\\\n            (!t. 0 < t /\\ t < n - j\n                 ==> ~(cyclic_closing_path q j n t IN\n                       ({q 0,q i,q j} UNION\n                        indexed_path_vertices q i) UNION\n                       indexed_path_vertices\n                        (cyclic_offset_path q i) (j - i)))
