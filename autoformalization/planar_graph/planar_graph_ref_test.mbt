      #|  !f:A->A. !s x k:A->B.\n        f permutes s /\\\n        x IN s /\\\n        (!z. z IN s ==> k(f z) = k z) /\\\n        (!a b. a IN s /\\ b IN s /\\ k a = k b\n               ==> ?n. ITER n f a = b)\n        ==> !a b. a IN s DELETE x /\\\n                  b IN s DELETE x /\\\n                  k a = k b\n                  ==> ?n. ITER n (permutation_delete f x) a = b
      #|  !a b:A. a IN s DELETE x /\\ b IN s DELETE x /\\\n             (k:A->B) a = k b\n             ==> ?n. ITER n (permutation_delete f x) a = b
