      #|  q:num->A
      #|  !q:num->A. !n i j k. !u v:A.\n        0 < i /\\ i < j /\\ j < k /\\ k < n /\\\n        INJ q (cyclic_indices n) (:A) /\\\n        ~(u IN cyclic_vertices q n) /\\\n        ~(v IN cyclic_vertices q n)\n        ==> (!t. 0 < t /\\ t < i\n                  ==> ~(q t IN\n                        {q 0,q j,v} UNION {q i,q k,u})) /\\\n            (!t. 0 < t /\\ t < j - i\n                  ==> ~(cyclic_offset_path q i t IN\n                        ({q 0,q j,v} UNION {q i,q k,u}) UNION\n                        indexed_path_vertices q i)) /\\\n            (!t. 0 < t /\\ t < k - j\n                  ==> ~(cyclic_offset_path q j t IN\n                        (({q 0,q j,v} UNION {q i,q k,u}) UNION\n                         indexed_path_vertices q i) UNION\n                        indexed_path_vertices\n                         (cyclic_offset_path q i) (j - i))) /\\\n            (!t. 0 < t /\\ t < n - k\n                  ==> ~(cyclic_closing_path q k n t IN\n                        ((({q 0,q j,v} UNION {q i,q k,u}) UNION\n                          indexed_path_vertices q i) UNION\n                         indexed_path_vertices\n                          (cyclic_offset_path q i) (j - i)) UNION\n                        indexed_path_vertices\n                         (cyclic_offset_path q j) (k - j)))
      #|  kuratowski_alternating_vertices\n    (q:num->A) n i j k (u:A) v =\n      four_path_extension_vertices\n       ({q 0,q j,v} UNION {q i,q k,u})\n       q i\n       (cyclic_offset_path q i) (j - i)\n       (cyclic_offset_path q j) (k - j)\n       (cyclic_closing_path q k n) (n - k)
      #|  kuratowski_alternating_edges\n    (q:num->A) n i j k (u:A) v =\n      four_path_extension_edges\n       (complete_bipartite_edges {q 0,q j,v} {q i,q k,u})\n       (q 0) (q i) (q j) (q k)\n       q i\n       (cyclic_offset_path q i) (j - i)\n       (cyclic_offset_path q j) (k - j)\n       (cyclic_closing_path q k n) (n - k)
