      #|  segment[(p:A->real^2)((a:(A->bool)->A) (e:A->bool)),\n            pathstart((k:(A->bool)->real^1->real^2) e)] INTER\n    segment[pathfinish(k e'),p(b e')] =\n    IMAGE p ({a e} INTER {b e'})
      #|  pathstart((k:(A->bool)->real^1->real^2) (e':A->bool))
