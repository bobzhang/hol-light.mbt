      #|  !V:A->bool. !E:(A->bool)->bool. !u v:A.\n   !W:A->bool. !D:(A->bool)->bool.\n        finite_simple_graph W D /\\\n        ~(u = v) /\\\n        ~(u IN W) /\\\n        D SUBSET graph_contract_edges V E u v\n        ==> contract_split_side E\n             (IMAGE (IMAGE (swap(u,v))) D) u\n            SUBSET\n            graph_neighbors D v DIFF contract_split_side E D v
