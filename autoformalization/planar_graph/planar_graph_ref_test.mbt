      #|  segment[(p:A->real^N) v,x] SUBSET cball(p v,r v)
      #|  !V p r v x.\n        v IN (V:A->bool) /\\\n        &0 <= r v /\\\n        x IN sphere((p:A->real^N) v,r v) /\\\n        (!w. w IN V /\\ ~(v = w)\n             ==> &0 <= r w /\\\n                 DISJOINT (cball(p v,r v)) (cball(p w,r w)))\n        ==> segment[p v,x] INTER IMAGE p V = {p v}
      #|  ~((v:A) = w)
