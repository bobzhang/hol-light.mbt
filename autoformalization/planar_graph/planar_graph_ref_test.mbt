      #|  !q:num->A. !n.\n        IMAGE FST (cyclic_darts q n) = cyclic_vertices q n
      #|  subdivision_tail_swap (u:A) v w =\n    swap((u,v),(u,w)) o swap((v,u),(v,w))
      #|  !V:A->bool. !u v w.\n        {u,v} SUBSET V /\\ ({u,v}:A->bool) HAS_SIZE 2 /\\ ~(w IN V)\n        ==> ~(u = v) /\\ ~(u = w) /\\ ~(v = w)
      #|  !u v w:A.\n        ~(u = v) /\\ ~(u = w) /\\ ~(v = w)\n        ==> ~((u,v) = (u,w)) /\\\n            ~((u,v) = (v,u)) /\\\n            ~((u,v) = (v,w)) /\\\n            ~((u,w) = (v,u)) /\\\n            ~((u,w) = (v,w)) /\\\n            ~((v,u) = (v,w))
      #|  d:A#A = (v,w)
      #|  d:A#A = (v,u)
