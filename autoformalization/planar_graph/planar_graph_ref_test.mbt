      #|  segment[pathfinish((k:(A->bool)->real^1->real^2) (e:A->bool)),\n            (p:A->real^2)((b:(A->bool)->A) e)] INTER\n    segment[p((a:(A->bool)->A) (e':A->bool)),pathstart(k e')] =\n    IMAGE p ({b e} INTER {a e'})
      #|  pathfinish((k:(A->bool)->real^1->real^2) (e':A->bool))
