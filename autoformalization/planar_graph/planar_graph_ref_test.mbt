      #|  (q:num->A) 0 = q 0 /\\ q i = q i /\\\n    cyclic_offset_path q i 0 = q i /\\\n    cyclic_offset_path q i (j - i) = q j /\\\n    cyclic_closing_path q j n 0 = q j /\\\n    cyclic_closing_path q j n (n - j) = q 0
      #|  cyclic_closing_path (q:num->A) j n 0 = q j /\\\n    cyclic_closing_path q j n (n - j) = q 0
