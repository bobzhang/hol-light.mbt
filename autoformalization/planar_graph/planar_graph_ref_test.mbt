      #|  k:(A->bool)->real^1->real^2
      #|  b:(A->bool)->A
      #|  a:(A->bool)->A
      #|  r:A->real
      #|  p:A->real^2
      #|  V:A->bool
      #|  DISJOINT\n     (path_image((k:(A->bool)->real^1->real^2) (e:A->bool)))\n     (segment[(p:A->real^2)((a:(A->bool)->A) (e':A->bool)),\n              pathstart((k:(A->bool)->real^1->real^2) e')])
      #|  pathfinish((k:(A->bool)->real^1->real^2) (e:A->bool))
      #|  (b:(A->bool)->A) (e:A->bool)
