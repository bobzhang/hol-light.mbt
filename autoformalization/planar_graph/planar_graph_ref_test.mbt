      #|  E1:(A->bool)->bool
      #|  V2:A->bool
      #|  V1:A->bool
      #|  outgoing_darts E1 (u:A) INTER outgoing_darts E2 u = {(u,v)}
      #|  !V1 V2:A->bool. !E1 E2:(A->bool)->bool.\n   !u v:A. !d:A#A.\n        finite_simple_graph V1 E1 /\\\n        finite_simple_graph V2 E2 /\\\n        V1 INTER V2 = {u,v} /\\\n        {u,v} IN E1 /\\\n        {u,v} IN E2 /\\\n        d IN graph_darts E2 DELETE (v,u) /\\\n        SND d = u\n        ==> ~(reverse_dart d IN outgoing_darts E1 u)
      #|  (d:A#A) = (v,u)
      #|  reverse_dart(d:A#A)
