      #|  !f a b c.\n        f continuous_on segment[a,b] /\\ c IN segment[a,b]\n        ==> path_integral(linepath (a,b)) f =\n            path_integral(linepath (a,c)) f +\n            path_integral(linepath (c,b)) f
