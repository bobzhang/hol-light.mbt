      #|  !q:num->A. !n i j k.\n        0 < i /\\ i < j /\\ j < k /\\ k < n /\\\n        INJ q (cyclic_indices n) (:A)\n        ==> (~(q 0 = q i) /\\ ~(q 0 = q j) /\\ ~(q 0 = q k) /\\\n             ~(q i = q j) /\\ ~(q i = q k) /\\ ~(q j = q k)) /\\\n            (0 < i /\\ 0 < j - i /\\ 0 < k - j /\\ 0 < n - k) /\\\n            (q 0 = q 0 /\\ q i = q i /\\\n             cyclic_offset_path q i 0 = q i /\\\n             cyclic_offset_path q i (j - i) = q j /\\\n             cyclic_offset_path q j 0 = q j /\\\n             cyclic_offset_path q j (k - j) = q k /\\\n             cyclic_closing_path q k n 0 = q k /\\\n             cyclic_closing_path q k n (n - k) = q 0) /\\\n            (INJ q (0..i) (:A) /\\\n             INJ (cyclic_offset_path q i) (0..j - i) (:A) /\\\n             INJ (cyclic_offset_path q j) (0..k - j) (:A) /\\\n             INJ (cyclic_closing_path q k n) (0..n - k) (:A)) /\\\n            (!t. 0 < t /\\ t < i\n                 ==> ~(q t IN {q 0,q i,q j,q k})) /\\\n            (!t. 0 < t /\\ t < j - i\n                 ==> ~(cyclic_offset_path q i t IN\n                       {q 0,q i,q j,q k} UNION\n                       indexed_path_vertices q i)) /\\\n            (!t. 0 < t /\\ t < k - j\n                 ==> ~(cyclic_offset_path q j t IN\n                       ({q 0,q i,q j,q k} UNION\n                        indexed_path_vertices q i) UNION\n                       indexed_path_vertices\n                        (cyclic_offset_path q i) (j - i))) /\\\n            (!t. 0 < t /\\ t < n - k\n                 ==> ~(cyclic_closing_path q k n t IN\n                       (({q 0,q i,q j,q k} UNION\n                         indexed_path_vertices q i) UNION\n                        indexed_path_vertices\n                         (cyclic_offset_path q i) (j - i)) UNION\n                       indexed_path_vertices\n                        (cyclic_offset_path q j) (k - j)))
