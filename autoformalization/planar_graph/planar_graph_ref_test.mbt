      #|  (a:(A->bool)->A) (e':A->bool)
      #|  (b:(A->bool)->A) (e':A->bool)
      #|  !p:A->real^N. !a b k e.\n        pathstart(radialized_edge p a b k e) = p(a e) /\\\n        pathfinish(radialized_edge p a b k e) = p(b e)
      #|  !p:A->real^N. !r a b k e.\n        polygonal_arc(k e) /\\\n        &0 < r(a e) /\\\n        &0 < r(b e) /\\\n        DISJOINT (cball(p(a e),r(a e))) (cball(p(b e),r(b e))) /\\\n        pathstart(k e) IN sphere(p(a e),r(a e)) /\\\n        pathfinish(k e) IN sphere(p(b e),r(b e)) /\\\n        (path_image(k e) DELETE pathstart(k e)) SUBSET\n        ((:real^N) DIFF cball(p(a e),r(a e))) /\\\n        (path_image(k e) DELETE pathfinish(k e)) SUBSET\n        ((:real^N) DIFF cball(p(b e),r(b e)))\n        ==> polygonal_arc(radialized_edge p a b k e)
      #|  radialized_edge (p:A->real^2) a b k (d:A->bool)
      #|  d:A->bool
