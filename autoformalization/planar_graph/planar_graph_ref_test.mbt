      #|  plane_orientation (a:real^2) (b:real^2) (c:real^2) =\n        (b$1 - a$1) * (c$2 - a$2) -\n        (b$2 - a$2) * (c$1 - a$1)
      #|  strictly_convex_cycle (z:num->real^2) n <=>\n        !i j k. i < j /\\ j < k /\\ k < n\n                 ==> &0 < plane_orientation (z i) (z j) (z k)
      #|  !a b c:real^2.\n        plane_orientation a b c =\n        vector[a$2 - b$2;b$1 - a$1] dot (c - a)
