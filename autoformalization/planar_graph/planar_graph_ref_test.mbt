      #|  !V:A->bool. !E:(A->bool)->bool. !q:num->A. !n.\n   !r:(A#A)->A#A.\n        maximal_boundary_euler_rotation V E q n r /\\\n        simple_graph_cycle E q n /\\\n        connected_graph V E /\\\n        3 <= CARD V\n        ==> ?k w s.\n              CARD(graph_neighbors E (q(n - 1))) = k + 2 /\\\n              graph_neighbors E (q(n - 1)) =\n                cyclic_vertices w (k + 2) /\\\n              INJ w (cyclic_indices (k + 2)) (:A) /\\\n              w 0 = q(n - 2) /\\\n              w(k + 1) = q 0 /\\\n              (!i. i + 1 < k + 2\n                   ==> {w i,w(i + 1)} IN E) /\\\n              connected_graph\n               (V DELETE q(n - 1))\n               (induced_subgraph_edges E (V DELETE q(n - 1))) /\\\n              boundary_euler_rotation\n               (V DELETE q(n - 1))\n               (induced_subgraph_edges E (V DELETE q(n - 1)))\n               (cyclic_delete_last q w n) (n - 1 + k) s
