      #|  \\s:A->bool. IMAGE (p:A->real^2) s
      #|  pathfinish((k:(A->bool)->real^1->real^2) e)
      #|  (b:(A->bool)->A) (e:A->bool)
      #|  r:A->real
      #|  p:A->real^2
      #|  V:A->bool
      #|  segment[(p:A->real^2)((b:(A->bool)->A)(e:A->bool)),\n            pathfinish((k:(A->bool)->real^1->real^2) e)] INTER\n    IMAGE p V = {p(b e)}
      #|  pathstart((k:(A->bool)->real^1->real^2) e)
      #|  (a:(A->bool)->A) (e:A->bool)
      #|  r:A->real
      #|  p:A->real^2
      #|  V:A->bool
      #|  segment[(p:A->real^2)((a:(A->bool)->A)(e:A->bool)),\n            pathstart((k:(A->bool)->real^1->real^2) e)] INTER\n    IMAGE p V = {p(a e)}
      #|  !V (p:A->real^2) (r:A->real)\n      (a:(A->bool)->A) (b:(A->bool)->A)\n      (k:(A->bool)->real^1->real^2) (e:A->bool).\n        a e IN (V:A->bool) /\\\n        b e IN V /\\\n        e = {a e,b e} /\\\n        (!v. v IN V ==> &0 <= r v) /\\\n        pathstart(k e) IN sphere((p:A->real^2)(a e),r(a e)) /\\\n        pathfinish(k e) IN sphere(p(b e),r(b e)) /\\\n        (!v w. v IN V /\\ w IN V /\\ ~(v = w)\n               ==> DISJOINT (cball(p v,r v)) (cball(p w,r w))) /\\\n        DISJOINT (path_image(k e))\n         (edge_polygonal_obstacles V p r e)\n        ==> path_image(radialized_edge p a b k e) INTER IMAGE p V =\n            IMAGE p e
      #|  v:A
      #|  e:A->bool
      #|  r:A->real
      #|  p:A->real^2
      #|  V:A->bool
      #|  path_image((k:(A->bool)->real^1->real^2) (e:A->bool))
