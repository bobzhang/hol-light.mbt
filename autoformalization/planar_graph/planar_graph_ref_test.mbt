      #|  indexed_path_edges (q:num->A) i UNION\n    indexed_path_edges (cyclic_offset_path q i) (j - i) UNION\n    indexed_path_edges (cyclic_offset_path q j) (k - j) UNION\n    indexed_path_edges (cyclic_closing_path q k n) (n - k)
