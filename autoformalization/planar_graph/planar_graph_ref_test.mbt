      #|  DISJOINT\n     (path_image((k:(A->bool)->real^1->real^2) (e:A->bool)))\n     (path_image(k (e':A->bool)))
      #|  !V E (p:A->real^2) (r:A->real)\n      (a:(A->bool)->A) (b:(A->bool)->A)\n      (k:(A->bool)->real^1->real^2) e e'.\n        (!v. v IN V ==> &0 <= r v) /\\\n        (!v w. v IN V /\\ w IN V /\\ ~(v = w)\n               ==> DISJOINT (cball(p v,r v)) (cball(p w,r w))) /\\\n        (!d. d IN E\n             ==> a d IN V /\\\n                 b d IN V /\\\n                 d = {a d,b d} /\\\n                 pathstart(k d) IN sphere(p(a d),r(a d)) /\\\n                 pathfinish(k d) IN sphere(p(b d),r(b d)) /\\\n                 (path_image(k d) DELETE pathstart(k d)) SUBSET\n                 ((:real^2) DIFF cball(p(a d),r(a d))) /\\\n                 (path_image(k d) DELETE pathfinish(k d)) SUBSET\n                 ((:real^2) DIFF cball(p(b d),r(b d))) /\\\n                 DISJOINT (path_image(k d))\n                  (edge_polygonal_obstacles V p r d)) /\\\n        (!d d'. d IN E /\\ d' IN E /\\ ~(d = d')\n                 ==> DISJOINT (path_image(k d)) (path_image(k d'))) /\\\n        e IN E /\\ e' IN E /\\ ~(e = e')\n        ==> path_image(radialized_edge p a b k e) INTER\n            path_image(radialized_edge p a b k e') =\n            IMAGE p (e INTER e')
      #|  (e:A->bool) IN E
      #|  e:A->bool
      #|  (e':A->bool) IN E
      #|  e':A->bool
