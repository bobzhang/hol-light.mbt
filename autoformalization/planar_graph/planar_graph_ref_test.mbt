      #|  !V:A->bool. !E:(A->bool)->bool. !u v w.\n   !r:(A#A)->A#A. !z:A#A.\n        finite_simple_graph V E /\\\n        {u,v} IN E /\\\n        ~(w IN V) /\\\n        z IN graph_darts\n              ({{u,w},{w,v}} UNION (E DELETE {u,v}))\n             DELETE (w,u) DELETE (w,v)\n        ==> (subdivision_tail_swap u v w o\n             graph_face_successor E\n              (graph_suppress_subdivision_rotation E u v w r) o\n             subdivision_tail_swap u v w) z =\n            restricted_permutation r\n             (graph_darts\n               ({{u,w},{w,v}} UNION (E DELETE {u,v}))\n              DELETE (w,u) DELETE (w,v))\n             (subdivision_tail_swap u v w\n               (reverse_dart(subdivision_tail_swap u v w z)))
