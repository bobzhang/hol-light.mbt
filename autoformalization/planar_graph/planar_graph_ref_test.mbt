      #|  !E:(A->bool)->bool. !a b c d u v:A.\n        {u,a} IN E /\\ {u,c} IN E /\\\n        {v,b} IN E /\\ {v,d} IN E /\\ {u,v} IN E\n        ==> complete_bipartite_edges {a,c,v} {b,d,u} SUBSET\n            {{a,b},{b,c},{c,d},{d,a}} UNION E
      #|  t:num
