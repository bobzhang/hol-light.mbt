      #|  !V:A->bool. !E:(A->bool)->bool. !q w:num->A. !n k.\n   !r:(A#A)->A#A.\n        w 0 = q (n - 2) /\\\n        fan_rotation_invariant V E r (q (n - 1)) w\n          (q (n - 3),q (n - 2)) (k + 1) (k + 1)\n        ==> graph_face_successor\n             (fan_edges (q (n - 1)) w E (k + 1))\n             (fan_rotation (q (n - 1)) w\n               (q (n - 3),q (n - 2)) r (k + 1))\n             (q (n - 3),q (n - 2)) = (q (n - 2),q (n - 1))
