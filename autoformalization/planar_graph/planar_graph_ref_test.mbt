      #|  !E q:num->A n j.\n        simple_graph_cycle E q n /\\\n        0 < j /\\ j + 2 < n /\\ {q j,q (n - 1)} IN E\n        ==> simple_graph_cycle E (cyclic_split_left q n j) (j + 2)
      #|  e:A->bool
