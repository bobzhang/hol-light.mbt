      #|  !E:(A->bool)->bool. !u v a b w:A. !S:A->bool.\n        ~(u = v) /\\\n        ~(u = a) /\\ ~(u = b) /\\ ~(u = w) /\\\n        ~(v = a) /\\ ~(v = b) /\\ ~(v = w) /\\\n        ~(a = b) /\\ ~(a = w) /\\ ~(b = w) /\\\n        ~(w IN S)\n        ==> graph_branch_split_edges\n             ({{a,w},{w,b}} UNION (E DELETE {a,b})) u v S =\n            {{a,w},{w,b}} UNION\n            (graph_branch_split_edges E u v S DELETE {a,b})
      #|  !u v b w:A.\n        ~(u = v) /\\ ~(u = b) /\\ ~(u = w) /\\\n        ~(v = b) /\\ ~(v = w) /\\ ~(b = w)\n        ==> ~({u,b} = {u,w}) /\\\n            ~({u,b} = {v,b}) /\\\n            ~({u,b} = {v,w}) /\\\n            ~({u,b} = {w,b}) /\\\n            ~({u,w} = {v,b}) /\\\n            ~({u,w} = {v,w}) /\\\n            ~({u,w} = {w,b}) /\\\n            ~({v,b} = {v,w}) /\\\n            ~({v,b} = {w,b}) /\\\n            ~({v,w} = {w,b})
