///|
/// `int125_num_of_int`
pub fn int125_num_of_int(x14639 : Int64) -> @num.Num raise {
  let i = x14639
  if (i < 0L) {
    @num.minus_num(@num.num_of_string(Int64::to_string(@lib.neg63(i))))
  } else {
    @num.num_of_string(Int64::to_string(i))
  }
}

