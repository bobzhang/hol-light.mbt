// Load-fidelity test for Autoformalization/hilbert_waring.ml: replays tools/ocaml_ref/Autoformalization_hilbert_waring_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "Autoformalization/hilbert_waring matches Autoformalization/hilbert_waring.ml" {
  @hilbert_waring.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "Library/isum", "Library/permutations", "Library/wo", "Library/card",
      "Library/floor", "Multivariate/misc", "Library/products", "Examples/schnirelmann",
      "Autoformalization/hilbert_waring",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Autoformalization/hilbert_waring")
  log.capture_stdout()
  // BEGIN generated theorem list
