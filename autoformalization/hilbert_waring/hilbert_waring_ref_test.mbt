      #|  !(W:num->int->int) t (w:num->int).\n     isum(1..t)(\\i. mvf t W i (w i)) = isum(1..t)(\\i. W i (w i)) /\\\n     isum(t+1..2*t)(\\i. mvf t W i (w i)) = isum(1..t)(\\i. W i\n      (w(i+t)))
      #|  (i+t)-t = i
