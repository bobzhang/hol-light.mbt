      #|  !(phi:num->num->int) neg j d y:int.\n     ipoly (sgnf phi neg j) d y = (if neg j then --(ipoly (phi j) d y) else\n      ipoly (phi j) d y)
      #|  !(phi:num->num->int) neg j d. ~(phi j d = &0) ==> ~(sgnf phi neg j d = &0)
