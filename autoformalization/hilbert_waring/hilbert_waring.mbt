///|
/// HILBERT_WARING
fn step_417() -> Unit raise {
  let t10750 = @simp.asm_rewrite_tac(@list.empty())
  let t10749 = @tactics.match_mp_tac(@iterate.nsum_eq())
  let t10748 = @simp.rewrite_tac(@list.List([@equal.gsym(@iterate.numseg())]))
  let t10746 = @int.arith_rule(@parser.parse_term("m <= k ==> ((1 <= i /\\ i <= k) /\\ i <= m <=> 1 <= i /\\ i <= m)"))
  let t10747 = @simp.asm_simp_tac(@list.List([@equal.gsym(@iterate.nsum_restrict_set()), @iterate.in_numseg(), t10746]))
  let t10745 = @simp.asm_simp_tac(@list.List([@class.cond_rand(), @class.cond_rator(), @arith.exp_zero(), @arith.le_1()]))
  let t10744 = @tactics.exists_tac(@parser.parse_term("\\i. if i <= m then (g:num->num) i else 0"))
  let t10741 = @parser.parse_term("g:num->num")
  let t10742 = @parser.parse_term("f:num->num")
  let t10743 = @tactics.map_every(@tactics.x_gen_tac, @list.List([@parser.parse_term("m:num"), t10742, t10741]))
  let t10740 = @simp.rewrite_tac(@list.List([@theorems.left_imp_exists_thm()]))
  let t10739 = @simp.rewrite_tac(@list.List([@class.skolem_thm(), @theorems.left_and_exists_thm(), @theorems.right_and_exists_thm()]))
  let t10738 = @simp.rewrite_tac(@list.List([@simp.rewrite_rule(@list.List([@class.right_imp_exists_thm()]))(waring_repr())]))
  let t10737 = @tactics.x_gen_tac(@parser.parse_term("n:num"))
  let t10736 = @tactics.match_mp_tac(@theorems.mono_forall())
  let t10735 = @tactics.x_gen_tac(@parser.parse_term("k:num"))
  let t10734 = @tactics.match_mp_tac(@theorems.mono_exists())
  let t10731 = @drule.match_mp(hilbert_waring_repr())
  let t10733 = @tactics.first_assum(fn(x10732 : @kernel.Thm) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise) raise {
    (fn(x10728 : @kernel.Thm) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise) raise {
      let s10729 = @tactics.mp_tac(x10728)
      fn(x10730 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise {
        s10729(x10730)
      }
    })(t10731(x10732))
  })
  let t10751 = @tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t10733), t10734), t10735), t10736), t10737), t10738), t10739), t10740), t10743), @tactics.strip_tac), t10744), t10745), t10747), t10748), t10749), t10750)
  hilbert_waring_c.set(@tactics.prove(@parser.parse_term("!e. 1 <= e ==> ?k. !n. ?f. n = nsum(1..k) (\\i. f i EXP e)"), t10751))
}

