  let t10720 = @tactics.exists_tac(@parser.parse_term("m * s:num"))
  let t10719 = @tactics.match_mp_tac(waring_mono())
  let t10717 = @tactics.x_choose_then(@parser.parse_term("f:num->num"))(@tactics.strip_assume_tac)
  let t10718 = @tactics.disch_then(@tactics.x_choose_then(@parser.parse_term("m:num"))(t10717))
  let t10713 = @parser.parse_term("n:num")
  let t10716 = @tactics.first_x_assum(fn(x10715 : @kernel.Thm) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise) raise {
    (fn(x10710 : @kernel.Thm) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise) raise {
      let s10711 = @tactics.mp_tac(x10710)
      fn(x10712 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise {
        s10711(x10712)
      }
    })(((x10714 : @kernel.Thm) => @bool.spec(t10713, x10714))(x10715))
  })
  let t10709 = @tactics.x_gen_tac(@parser.parse_term("n:num"))
  let t10708 = @tactics.exists_tac(@parser.parse_term("k * s:num"))
  let t10705 = @parser.parse_term("k:num")
  let t10707 = @tactics.disch_then(@tactics.x_choose_then(@parser.parse_term("s:num"))((x10706 : @kernel.Thm) => @tactics.x_choose_tac(t10705, x10706)))
  let t10704 = @simp.asm_rewrite_tac(@list.empty())
  let t10703 = @tactics.mp_tac(@bool.spec(@parser.parse_term("e:num"), sumpow_basis()))
  let t10727 = @tactics.thenl(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t10703), t10704), t10707), t10708), t10709), t10716), t10718), t10719), t10720), @tactics.conj_tac), t10726)
