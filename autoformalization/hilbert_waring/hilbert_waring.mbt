///|
/// `WARING_FOLD`
pub fn waring_fold() -> @kernel.Thm {
  waring_fold_c.get()
}

///|
/// HILBERT_WARING_REPR
fn step_416() -> Unit raise {
  let t10725 = @simp.asm_simp_tac(@list.List([@arith.le_mult_rcancel()]))
  let t10724 = @simp.asm_simp_tac(@list.empty())
