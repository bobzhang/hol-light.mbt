      #|  cw_tile sigma real_integrable_on\n          ((:real) DIFF tile_I (carleson_rootseq f gam0 (carleson_Rtilde P) P\n            j))
      #|  C3:real
      #|  tile_k (carleson_rootseq f gam0 (carleson_Rtilde P) P j)
      #|  &1:real
      #|  gam:real
      #|  \\sigma:int#int#int. (:real) DIFF tile_I (carleson_rootseq f gam0\n      (carleson_Rtilde P) P j)
      #|  \\sigma:int#int#int. {t | t IN carleson_Pextract f gam0 P /\\ tile_J sigma\n      SUBSET tile_Jl t}
      #|  carleson_piece f gam0 (carleson_Rtilde P) P j
      #|  f:real->complex
      #|  C3:real
      #|  C3:real
      #|  ?C3. &0 <= C3 /\\\n    !f gam0 P j gam.\n       &0 < gam0 /\\ FINITE P /\\ j < carleson_stopN f gam0 P /\\\n       &0 <= gam /\\ energy_f f (carleson_Pextract f gam0 P) <= gam\n       ==> sum (carleson_piece f gam0 (carleson_Rtilde P) P j)\n             (\\sigma. (sum {t | t IN carleson_Pextract f gam0 P /\\\n                               tile_J sigma SUBSET tile_Jl t}\n                  (\\t. norm(integral (:real^1)\n                        (\\z. phi_sigma sigma carleson_phi (drop z) *\n                             cnj(phi_sigma t carleson_phi (drop z)))) *\n                       norm(carleson_ip f t))) pow 2)\n           <= (C3 * gam) pow 2 *\n              (&2 * &1 * inv(&2 zpow (tile_k (carleson_rootseq f gam0\n                (carleson_Rtilde P) P j))))
      #|  sigma:int#int#int
      #|  gam:real
      #|  j:num
      #|  P:(int#int#int)->bool
      #|  gam0:real
      #|  f:real->complex
      #|  b:num
      #|  b:num
      #|  a:num
      #|  p <=> ~ ~p
      #|  b:num
      #|  a:num
      #|  II:num->bool
      #|  \\A:A->bool. sum A (h:A->real)
      #|  g:num->A->bool
      #|  x:A IN t2
      #|  x:A IN t1
      #|  x:A
      #|  x'':num
      #|  x':num
      #|  ~(t1:A->bool = t2)
      #|  ~(x':num = x'')
      #|  x:A
      #|  t2:A->bool
      #|  t1:A->bool
      #|  IMAGE (g:num->A->bool) II
      #|  h:A->real
      #|  !(h:A->real) (g:num->A->bool) II.\n     FINITE II /\\ (!i. i IN II ==> FINITE (g i)) /\\ (!i. i IN II ==> ~(g i =\n       {})) /\\\n     (!i j. i IN II /\\ j IN II /\\ ~(i = j) ==> DISJOINT (g i) (g j))\n     ==> sum (UNIONS (IMAGE g II)) h = sum II (\\i. sum (g i) h)
      #|  j:num
      #|  P:(int#int#int)->bool
      #|  gam:real
      #|  f:real->complex
      #|  j:num
      #|  !f gam P. &0 < gam /\\ FINITE P\n     ==> gam pow 2 * sum {j | j < carleson_stopN f gam P}\n             (\\j. &2 zpow (--(tile_k (carleson_rootseq f gam (carleson_Rtilde\n               P) P j))))\n         <= &4 * delta_f f (carleson_Pextract f gam P)
      #|  (&2*C3sq)*(&4*d) = &8*C3sq*d
      #|  (&2 * C3 pow 2) * (&4 * d)
      #|  (&2 * (C3 * gam) pow 2) * S = (&2 * C3 pow 2) * (gam pow 2 * S)
      #|  !C3 gam S d:real. &0 <= C3 /\\ &0 <= gam /\\\n     gam pow 2 * S <= &4 * d /\\ &0 <= S /\\ &0 <= d\n     ==> (&2 * (C3 * gam) pow 2) * S <= &8 * C3 pow 2 * d
      #|  d:real
      #|  sum {j | j < N} (\\j. &2 zpow (--((kf:num->int) j)))
      #|  gam:real
      #|  C3:real
      #|  (&2 * (C3 * gam) pow 2) * &1 * S = (&2 * (C3 * gam)\n    pow 2) * S
      #|  (C3 * gam) pow 2 * &2 * z = (&2 * (C3*gam) pow 2) *\n    z
      #|  !C3 gam (kf:num->int) N d.\n     &0 <= C3 /\\ &0 <= gam /\\ &0 <= d /\\\n     gam pow 2 * sum {j | j < N} (\\j. &2 zpow (--(kf j))) <= &4 * d\n     ==> sum {j | j < N} (\\j. (C3 * gam) pow 2 * (&2 * &1 * inv(&2 zpow (kf\n       j))))\n         <= &8 * C3 pow 2 * d
      #|  P:(int#int#int)->bool
      #|  gam:real
      #|  f:real->complex
