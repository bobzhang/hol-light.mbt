      #|  nI:int
      #|  nJ:int
      #|  nI:int
      #|  k:int
      #|  (!k nI nJ. P ((k,nI,nJ):int#int#int)) ==> (!s. P s)
      #|  !tau:int#int#int. ?nt. tile_I tau = dyho (--(tile_k tau)) nt
      #|  &0 <= mass_Eh E h (Tt:(int#int#int)->bool)
      #|  &0 <= energy_f f (Tt:(int#int#int)->bool)
      #|  mass_Eh E h (Tt:(int#int#int)->bool) <= mass_Eh E h P
      #|  energy_f f (Tt:(int#int#int)->bool) <= energy_f f P
      #|  tile_le (s:int#int#int) tau
      #|  tile_I(tau:int#int#int)
      #|  s:int#int#int
      #|  tau:int#int#int
      #|  nt:int
      #|  tile_k(tau:int#int#int)
      #|  Tt:(int#int#int)->bool
      #|  h:real->real
      #|  E:real->bool
      #|  f:real->complex
      #|  C7 * energy_f f (Tt:(int#int#int)->bool) * mass_Eh E h Tt *\n    &2 zpow (--(tile_k tau))
      #|  tau:int#int#int
      #|  nt:int
      #|  Tt:(int#int#int)->bool = {}
      #|  (Tt:(int#int#int)->bool) SUBSET P
      #|  FINITE(Tt:(int#int#int)->bool)
      #|  Tt = {s:int#int#int | s IN P /\\ tile_le s tau}
      #|  tau:int#int#int
      #|  P:(int#int#int)->bool
      #|  h:real->real
      #|  E:real->bool
      #|  f:real->complex
      #|  C7:real
      #|  C7:real
      #|  ?C7. &0 <= C7 /\\\n   !(f:real->complex) E h (P:(int#int#int)->bool) (tau:int#int#int).\n      FINITE P /\\ ~(P = {}) /\\\n      real_lebesgue_measurable E /\\ h real_measurable_on (:real) /\\\n      (!t. cw_tile t real_integrable_on {x | x IN E /\\ h x IN tile_J t})\n      ==> sum {s | s IN P /\\ tile_le s tau}\n            (\\s. norm(carleson_ip f s *\n                integral (IMAGE lift {x | x IN E /\\ h x IN tile_Jr s})\n                     (\\z. phi_sigma s carleson_phi (drop z))))\n          <= C7 * energy_f f P * mass_Eh E h P * &2 zpow (--(tile_k tau))
      #|  tau:int#int#int
      #|  sum R (\\tau. sum {s:int#int#int | s IN P /\\ tile_le s tau}\n                       (phi:(int#int#int)->real))
      #|  x:int#int#int
      #|  x:int#int#int
      #|  sum (UNIONS (IMAGE (\\tau. {s:int#int#int | s IN P /\\ tile_le s tau}) R))\n        (phi:(int#int#int)->real)
      #|  FINITE(UNIONS (IMAGE (\\tau. {s:int#int#int | s IN P /\\ tile_le s tau}) R))
      #|  t:int#int#int
      #|  {s:int#int#int | s IN P /\\ tile_le s t}
      #|  P INTER tile_upset R SUBSET\n    UNIONS (IMAGE (\\tau. {s:int#int#int | s IN P /\\ tile_le s tau}) R)
      #|  !s:int#int#int. &0 <= phi s
      #|  phi = \\s. norm(carleson_ip (f:real->complex) s *\n                integral (IMAGE lift {x | x IN E /\\ h x IN tile_Jr s})\n                     (\\z. phi_sigma s carleson_phi (drop z)))
      #|  R:(int#int#int)->bool
      #|  P:(int#int#int)->bool
      #|  h:real->real
      #|  E:real->bool
      #|  f:real->complex
      #|  C7:real
      #|  C7:real
      #|  ?C7. &0 <= C7 /\\\n   !(f:real->complex) E h (P:(int#int#int)->bool) R.\n      FINITE P /\\ ~(P = {}) /\\ FINITE R /\\\n      real_lebesgue_measurable E /\\ h real_measurable_on (:real) /\\\n      (!t. cw_tile t real_integrable_on {x | x IN E /\\ h x IN tile_J t})\n      ==> sum (P INTER tile_upset R)\n            (\\s. norm(carleson_ip f s *\n                integral (IMAGE lift {x | x IN E /\\ h x IN tile_Jr s})\n                     (\\z. phi_sigma s carleson_phi (drop z))))\n          <= sum R (\\tau. C7 * energy_f f P * mass_Eh E h P *\n                          &2 zpow (--(tile_k tau)))
      #|  min (inv (&2 pow k * inv (&2) pow M)) (&2 pow k * inv (&2) pow M) =\n        min (&2 pow k * inv (&2) pow M) (inv (&2 pow k) * &2 pow M)
      #|  mass_Eh E h P1 = sqrt(mass_Eh E h P1) pow 2
      #|  C7 * ((C5 + C6) * min (inv(&2 pow k * inv(&2) pow M))\n                                      (&2 pow k * inv(&2) pow M))
      #|  R:(int#int#int)->bool
      #|  P1:(int#int#int)->bool
      #|  h:real->real
      #|  E:real->bool
      #|  f:real->complex
      #|  sum R (\\tau. C7 * energy_f f P1 * mass_Eh E h P1 *\n                          &2 zpow (--(tile_k tau)))
      #|  P DIFF (P1 DIFF tile_upset R) =\n    (P DIFF P1) UNION (P1 INTER tile_upset R)
      #|  P:(int#int#int)->bool
      #|  FINITE(P1 DIFF tile_upset R:(int#int#int)->bool)
      #|  P1:(int#int#int)->bool
      #|  (P1 DIFF tile_upset R:(int#int#int)->bool) SUBSET P
      #|  P1 DIFF tile_upset R:(int#int#int)->bool
      #|  R:(int#int#int)->bool
      #|  C6:real
      #|  C5:real
      #|  &2 pow k * inv(&2) pow M
      #|  P1:(int#int#int)->bool
      #|  h:real->real
      #|  E:real->bool
      #|  f:real->complex
      #|  &0 < &2 pow k * inv(&2) pow M
      #|  sqrt(mass_Eh E h P1) <= &2 pow k * inv(&2) pow M
      #|  &0 <= e ==> x <= x + e
      #|  sum (P DIFF P1)\n          (\\s. norm(carleson_ip f s *\n              integral (IMAGE lift {x | x IN E /\\ h x IN tile_Jr s})\n                   (\\z. phi_sigma s carleson_phi (drop z))))\n          <= C7 * (C5 + C6) *\n             sum {n | n < M} (\\n. min (&2 pow k * inv(&2) pow n) (inv(&2 pow k)\n               * &2 pow n))
      #|  C7 * (C5 + C6) *\n        sum {n | n < M} (\\n. min (&2 pow k * inv(&2) pow n) (inv(&2 pow k) * &2\n          pow n))
      #|  P1:(int#int#int)->bool
      #|  P1:(int#int#int)->bool = {}
      #|  &2 pow k * inv(&2) pow (SUC M) = (&2 pow k * inv(&2) pow M) / &2
      #|  &0 <= min (&2 pow k * inv(&2) pow M) (inv(&2 pow k) * &2 pow M)
      #|  &0 <= inv(&2 pow k) * &2 pow M
      #|  &0 <= &2 pow k * inv(&2) pow M
      #|  {n | n < SUC M} = M INSERT {n | n < M}
      #|  sum {n | n < SUC M} (\\n. min (&2 pow k * inv(&2) pow n) (inv(&2 pow k) * &2\n     pow n))\n    = sum {n | n < M} (\\n. min (&2 pow k * inv(&2) pow n) (inv(&2 pow k) * &2\n      pow n))\n      + min (&2 pow k * inv(&2) pow M) (inv(&2 pow k) * &2 pow M)
      #|  P1:(int#int#int)->bool
      #|  k:num
      #|  C6:real
      #|  C5:real
      #|  P:(int#int#int)->bool
      #|  h:real->real
      #|  E:real->bool
      #|  f:real->complex
      #|  P:(int#int#int)->bool
      #|  C7:real
      #|  C7:real
      #|  ?C7. &0 <= C7 /\\\n   !M (f:real->complex) E h (P:(int#int#int)->bool) C5 C6 k.\n      carleson_mass_budget f E h C5 /\\ carleson_energy_budget f C6 /\\\n      &0 <= C5 /\\ &0 <= C6 /\\ FINITE P /\\\n      (!t. cw_tile t real_integrable_on {x | x IN E /\\ h x IN tile_J t}) /\\\n      real_lebesgue_measurable E /\\ h real_measurable_on (:real) /\\\n      energy_f f P <= &2 pow k /\\ sqrt(mass_Eh E h P) <= &2 pow k\n      ==> ?P'. P' SUBSET P /\\ FINITE P' /\\\n               energy_f f P' <= &2 pow k * inv(&2) pow M /\\\n               (~(P' = {}) ==> sqrt(mass_Eh E h P') <= &2 pow k * inv(&2) pow\n                 M) /\\\n               sum (P DIFF P')\n                 (\\s. norm(carleson_ip f s *\n                     integral (IMAGE lift {x | x IN E /\\ h x IN tile_Jr s})\n                          (\\z. phi_sigma s carleson_phi (drop z))))\n               <= C7 * (C5 + C6) *\n                  sum {n | n < M} (\\n. min (&2 pow k * inv(&2) pow n)\n                                           (inv(&2 pow k) * &2 pow n))
