// Load-fidelity test for Autoformalization/carleson.ml: replays tools/ocaml_ref/Autoformalization_carleson_ref.ml
// (keep in sync; refresh with tools/ocaml_ref/refresh_ref.py).

///|
using @testkit {stm, sthm}

///|
test "Autoformalization/carleson matches Autoformalization/carleson.ml" {
  @carleson.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "Library/wo", "Library/card", "Library/floor", "Multivariate/misc",
      "Library/products", "Library/iter", "Multivariate/metric", "Library/frag",
      "Library/prime", "Library/grouptheory", "Multivariate/homology", "Library/matroids",
      "Multivariate/vectors", "Library/permutations", "Multivariate/determinants",
      "Multivariate/topology", "Multivariate/convex", "Multivariate/paths", "Multivariate/polytope",
      "Multivariate/degree", "Multivariate/derivatives", "Library/binary", "Multivariate/clifford",
      "Multivariate/integration", "Multivariate/measure", "Multivariate/complexes",
      "Multivariate/canal", "Multivariate/transcendentals", "Library/binomial", "Multivariate/realanalysis",
      "Multivariate/lpspaces", "100/fourier", "Autoformalization/fourier_transform",
      "Autoformalization/carleson",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Autoformalization/carleson")
