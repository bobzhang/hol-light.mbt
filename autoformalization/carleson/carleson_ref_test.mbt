      #|  !(h:real->complex) z K. schwartz h\n     ==> (\\x:real^1. Cx(&2 * pi) *\n                     fourier (\\y. fourier h y * Cx(sum {k:int | abs k <= &K}\n                       (\\k. carleson_psi z k y))) (--drop x))\n         continuous_on (:real^1)
