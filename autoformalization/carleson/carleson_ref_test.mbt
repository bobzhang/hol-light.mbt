      #|  (\\u. sin(c * u) / u * f(x + u)) real_integrable_on real_interval[&0,pi] /\\\n                (\\u. sin(c * u) / u * f(x - u)) real_integrable_on\n                  real_interval[&0,pi] /\\\n                (\\u. sin(c * u) / u) real_integrable_on real_interval[&0,pi]
