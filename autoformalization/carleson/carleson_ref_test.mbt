      #|  !(h:real->complex) g x.\n     schwartz h /\\ (!y. abs(g y) <= &1) /\\\n     (\\z. fourier h (drop z) * Cx(g(drop z))) absolutely_integrable_on\n       (:real^1)\n     ==> norm(Cx(&2 * pi) * fourier (\\y. fourier h y * Cx(g y)) (--x))\n         <= sqrt(&2 * pi) *\n            drop(integral (:real^1) (\\y. lift(norm(fourier (h:real->complex)\n              (drop y)))))
      #|  K:num
      #|  z:real
