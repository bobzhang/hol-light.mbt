      #|  !(gg:num->int->int->real^2) (Q:num->int->bool) n K N.\n    vsum {j:num | j <= n}\n      (\\j. vsum {k:int | abs k <= &K}\n        (\\k. if Q j k then vsum {nI:int | abs nI <= &N} (\\nI. gg j k nI) else\n          vec 0))\n    = vsum {(j:num,k:int,nI:int) | j <= n /\\ abs k <= &K /\\ abs nI <= &N}\n        (\\(j,k,nI). if Q j k then gg j k nI else vec 0)
      #|  abs(dist(x:real^N,y)) = dist(x,y)
