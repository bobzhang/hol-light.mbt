      #|  &2 * sum (carleson_Pextract f gam P)\n        (\\s. norm(carleson_ip f s) *\n             sum {t | t IN carleson_Pextract f gam P /\\ tile_J s SUBSET tile_Jl\n               t}\n                 (\\t. norm(integral (:real^1)\n                       (\\z. phi_sigma s carleson_phi (drop z) *\n                            cnj(phi_sigma t carleson_phi (drop z)))) *\n                      norm(carleson_ip f t)))
