      #|  !(h:real->complex) z k R.\n     schwartz h /\\ real_measurable R\n     ==> (\\x:real^1. fourier (\\y. fourier h y * Cx(carleson_psi z k y)) (--drop\n       x))\n         integrable_on (IMAGE lift R)
      #|  k:int
