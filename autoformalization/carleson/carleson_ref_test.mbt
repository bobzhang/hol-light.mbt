      #|  carleson_rootseq f gam0 (carleson_Rtilde P) P j
      #|  {sigma | sigma IN carleson_piece f gam0 (carleson_Rtilde P) P j /\\\n                  tile_k sigma = kk}
      #|  {sigma | sigma IN carleson_piece f gam0 (carleson_Rtilde\n        P) P j /\\\n                              tile_k sigma = kk} = {}
      #|  kk:int
      #|  sigma:int#int#int
