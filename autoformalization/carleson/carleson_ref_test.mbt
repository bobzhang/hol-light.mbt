      #|  !Pk u k.\n     FINITE Pk /\\ tile_k u <= k /\\\n     (!s. s IN Pk ==> tile_le s u /\\ tile_k s = k)\n     ==> sum Pk (\\sigma. real_integral ((:real) DIFF tile_I u) (cw_tile sigma))\n       <= &1
      #|  (ks,nIs,nJs):int#int#int
