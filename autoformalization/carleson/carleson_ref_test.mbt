      #|  !(u:num->real) n K N ks nIs nJs.\n     abs ks <= &K /\\ abs nIs <= &N\n     ==> {t | t IN {(j:num,k:int,nI:int) | j <= n /\\ abs k <= &K /\\ abs nI <=\n       &N /\\\n                                        (?nJ:int. u j IN tile_Jr(k,&0,nJ))} /\\\n          (\\(j,k,nI). (k,nI,(@nJ:int. u j IN tile_Jr(k,&0,nJ)))) t =\n            (ks,nIs,nJs)} =\n         IMAGE (\\j:num. (j,ks,nIs)) {j:num | j <= n /\\ u j IN\n           tile_Jr(ks,&0,nJs)}
      #|  !P s (f:A->real^N). FINITE s\n     ==> (if P then vsum s f else vec 0) = vsum s (\\i. if P then f i else vec\n       0)
      #|  F':real^1->bool
