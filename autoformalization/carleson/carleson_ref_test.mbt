      #|  gg = \\z:real^1. lift(norm((ff:real^1->complex) z) pow 2)
      #|  !(ff:real^1->complex) c. &0 < c /\\\n     (\\z. lift(norm(ff z) pow 2)) integrable_on (:real^1)\n     ==> integral (:real^1)\n           (\\z. lift(norm(Cx(sqrt c) * ff(c % z)) pow 2)) =\n         integral (:real^1) (\\z. lift(norm(ff z) pow 2))
      #|  abs(sqrt c) pow 2 = c
