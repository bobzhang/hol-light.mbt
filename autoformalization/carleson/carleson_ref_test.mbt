      #|  carleson_piece f gam (carleson_Rtilde P) P
      #|  \\sigma. (sum {t | t IN carleson_Pextract f gam P /\\ tile_J sigma SUBSET\n     tile_Jl t}\n                  (\\t. norm(integral (:real^1)\n                        (\\z. phi_sigma sigma carleson_phi (drop z) *\n                             cnj(phi_sigma t carleson_phi (drop z)))) *\n                       norm(carleson_ip f t))) pow 2
      #|  energy_f f (P:(int#int#int)->bool)
