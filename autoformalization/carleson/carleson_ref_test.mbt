      #|  carleson_stopN f gam P
      #|  \\j. tile_k (carleson_rootseq f gam (carleson_Rtilde P) P j)
      #|  gam:real
      #|  C3:real
      #|  j:num
      #|  sum {j | j < carleson_stopN f gam P}\n    (\\j. (C3 * gam) pow 2 * &2 * &1 *\n         inv(&2 zpow (tile_k (carleson_rootseq f gam (carleson_Rtilde P) P\n           j))))
      #|  a:num < b \\/ b < a
      #|  b:num
      #|  a:num
      #|  i:num
