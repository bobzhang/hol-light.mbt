      #|  (\\n. real_integral (real_interval[a,b]) (\\u. sin((&n + &1 / &2) * u) / u *\n     f(x - u))) =\n    (\\n. real_integral (real_interval[a,b])\n           (\\u. sin((&n + &1 / &2) * u) * (\\v. f(x - v) / v) u))
