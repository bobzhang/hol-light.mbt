      #|  &2 * real_measure FF
      #|  &2 zpow k
      #|  (C * sqrt(&2)) * sqrt(real_measure FF) =\n                  (sqrt(&2) * sqrt(real_measure FF)) * C
      #|  &2 zpow k
      #|  FF:real->bool
      #|  t:int#int#int = (FST t, FST(SND t), SND(SND t))
      #|  &2 zpow k
      #|  FF:real->bool
      #|  {x | x IN {y | &2 zpow k * y IN FF} /\\ &2 zpow k * g (&2 zpow k * x)\n           IN tile_J t} =\n          {y | &2 zpow k * y IN FF} INTER\n          {x | (\\w. &2 zpow k * g(&2 zpow k * w)) x IN tile_J t}
      #|  {y | &2 zpow k * y IN FF}
      #|  t:int#int#int
      #|  &2 zpow k * inv(&2 zpow k) = &1
      #|  &2 zpow k
      #|  &2 zpow k
      #|  FF:real->bool
      #|  &2 zpow k
      #|  FF:real->bool
      #|  &2 zpow k
      #|  FF:real->bool
      #|  &2 zpow k
      #|  \\w. (f:real->complex)(drop w)
      #|  &2 zpow k
      #|  f:real->complex
      #|  (\\z. Cx (sqrt (&2 zpow k)) * f (&2 zpow k * drop z)) =\n                    (\\z. Cx(sqrt(&2 zpow k)) * (\\w. f(drop w))(&2 zpow k % z))
      #|  &2 zpow k
      #|  f:real->complex
      #|  (\\z. Cx (sqrt (&2 zpow k)) * f (&2 zpow k * drop z)) =\n                    (\\z. Cx(sqrt(&2 zpow k)) * (\\w. f(drop w))(&2 zpow k % z))
      #|  x:real
      #|  !u:int#int#int. {x | &2 zpow k * x IN FF /\\ &2 zpow k * g (&2 zpow k * x)\n       IN tile_Jr u} =\n          {x | x IN {y | &2 zpow k * y IN FF} /\\ &2 zpow k * g (&2 zpow k * x)\n            IN tile_Jr u}
      #|  sqrt(&2 zpow k) * C
      #|  sum P (\\s. norm(carleson_ip (\\x. Cx (sqrt (&2 zpow k)) * f (&2 zpow k * x))\n       (FST s + k,FST (SND s),SND (SND s)) *\n       integral (IMAGE lift\n         {x | &2 zpow k * x IN FF /\\ &2 zpow k * g (&2 zpow k * x) IN tile_Jr\n           (FST s + k,FST (SND s),SND (SND s))})\n       (\\z. phi_sigma (FST s + k,FST (SND s),SND (SND s)) carleson_phi (drop\n         z)))) =\n    sum (IMAGE (\\u:int#int#int. FST u + k,FST (SND u),SND (SND u)) P)\n     (\\u. norm(carleson_ip (\\x. Cx (sqrt (&2 zpow k)) * f (&2 zpow k * x)) u *\n       integral (IMAGE lift\n         {x | &2 zpow k * x IN FF /\\ &2 zpow k * g (&2 zpow k * x) IN tile_Jr\n           u})\n       (\\z. phi_sigma u carleson_phi (drop z))))
      #|  (FST s + k, SND s):int#int#int =\n                    (FST s + k, FST(SND s), SND(SND s))
      #|  &2 zpow k
      #|  FF:real->bool
      #|  {x | &2 zpow k * x IN FF /\\\n           &2 zpow k * g (&2 zpow k * x) IN tile_Jr (FST s + k,SND s)} =\n      {x | &2 zpow k * x IN FF} INTER\n      {x | (\\y. &2 zpow k * g(&2 zpow k * y)) x IN tile_Jr (FST s + k,SND s)}
      #|  s:int#int#int
