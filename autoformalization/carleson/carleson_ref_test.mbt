      #|  \\K u. cexp(--(ii * Cx(--x) * Cx(drop u))) *\n           (fourier (h:real->complex) (drop u) * Cx(sum {k:int | abs k <= &K}\n             (\\k. carleson_psi z k (drop u))))
      #|  !(h:real->complex) z x.\n     schwartz h\n     ==> ((\\K. integral (:real^1)\n                (\\u. cexp(--(ii * Cx(--x) * Cx(drop u))) *\n                     (fourier h (drop u) * Cx(sum {k:int | abs k <= &K} (\\k.\n                       carleson_psi z k (drop u))))))\n          --> integral (:real^1)\n                (\\u. cexp(--(ii * Cx(--x) * Cx(drop u))) *\n                     (fourier h (drop u) * Cx(carleson_theta z (drop u)))))\n         sequentially
      #|  !(ff:num->real->complex) gg x.\n     ((\\K. integral (:real^1) (\\u. cexp(--(ii * Cx(--x) * Cx(drop u))) * ff K\n       (drop u)))\n      --> integral (:real^1) (\\u. cexp(--(ii * Cx(--x) * Cx(drop u))) * gg(drop\n        u))) sequentially\n     ==> ((\\K. fourier (ff K) (--x)) --> fourier gg (--x)) sequentially
      #|  x:real
