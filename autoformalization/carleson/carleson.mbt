  carleson_286u_sinc_c.set(@tactics.prove(@parser.parse_term("!f. f square_integrable_on real_interval[--pi,pi] /\\\n       (!x. f(x + &2 * pi) = f x)\n       ==> ?s. real_negligible s /\\\n               !x. --pi < x /\\ x < pi /\\ ~(x IN s)\n                   ==> ((\\a. inv(pi) *\n                             real_integral (real_interval[--pi,pi])\n                                (\\t. sin(a * (x - t)) / (x - t) * f t))\n                        ---> f x) at_posinfinity"), t45301))
}

///|
let carleson_286u_sinc_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("CARLESON_286U_SINC")

///|
/// `CARLESON_286U_SINC`
pub fn carleson_286u_sinc() -> @kernel.Thm {
  carleson_286u_sinc_c.get()
}

///|
/// CARLESON_THEOREM
fn step_1874() -> Unit raise {
  let t45305 = @simp.asm_rewrite_tac(@list.empty())
  let t45304 = @tactics.match_mp_tac(carleson_286u_sinc())
  let t45303 = @simp.asm_rewrite_tac(@list.empty())
  let t45302 = @tactics.match_mp_tac(carleson_286v_from_continuous_sinc())
  let t45306 = @tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.gen_tac, @tactics.disch_tac), t45302), t45303), t45304), t45305)
  carleson_theorem_c.set(@tactics.prove(@parser.parse_term("!f. f square_integrable_on real_interval[--pi,pi] /\\\n       (!x. f(x + &2 * pi) = f x)\n       ==> ?s. real_negligible s /\\\n               !x. ~(x IN s)\n                   ==> ((\\n. sum(0..n) (\\k. fourier_coefficient f k *\n                                            trigonometric_set k x))\n                        ---> f x) sequentially"), t45306))
}

///|
let carleson_theorem_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("CARLESON_THEOREM")

///|
/// `CARLESON_THEOREM`
pub fn carleson_theorem() -> @kernel.Thm {
  carleson_theorem_c.get()
}

