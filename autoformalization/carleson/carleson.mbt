  let t45156 = @tactics.disch_then(@tactics.x_choose_then(@parser.parse_term("f2:real^1->complex"))(t45155))
  let t45154 = @simp.asm_rewrite_tac(@list.empty())
  let t45152 = @parser.parse_term("C10:real")
  let t45153 = @tactics.mp_tac(@bool.ispecl(@list.List([@parser.parse_term("g:real^1->complex"), t45152]), carleson_286u_c_full()))
  let t45151 = @tactics.x_choose_then(@parser.parse_term("C10:real"))(@tactics.strip_assume_tac)(carleson_286t_schwartz())
  let t45147 = @drule.match_mp(fourier_l2_rep_inv())
  let t45148 = @tactics.x_choose_then(@parser.parse_term("g:real^1->complex"))(@tactics.strip_assume_tac)
  let t45150 = @tactics.first_assum(fn(x45149 : @kernel.Thm) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise) raise {
