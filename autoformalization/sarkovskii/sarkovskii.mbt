///|
/// SARKOVSKII_THEOREM_ON_REALINTERVAL
fn step_163() -> Unit raise {
  let t9673 = @simp.asm_rewrite_tac(@list.empty())
  let t9666 = @parser.parse_term("n:num")
  let t9667 = @parser.parse_term("m:num")
