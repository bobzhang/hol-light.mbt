        }, x2, x3))(x4, x5)
      }
    })(x6)(@kernel.bool_ty)
  }, @list.List(["carryin", "anda", "andb", "exora", "exorb", "a_0_", "b_0_", "a_1_", "b_1_", "a_2_", "b_2_", "a_3_", "b_3_", "a_4_", "b_4_", "a_5_", "b_5_", "a_6_", "b_6_", "a_7_", "b_7_", "a_8_", "b_8_", "a_9_", "b_9_", "a_10_", "b_10_", "a_11_", "b_11_"]))
  ignore(@bdd.bdd_deftaut(vars)(add4_be))
}

///|
fn load_steps() -> Unit raise {
  step_1()
  step_2()
  step_3()
  step_4()
  step_5()
  step_6()
  step_7()
}
