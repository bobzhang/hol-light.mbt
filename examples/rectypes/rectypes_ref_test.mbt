// Load-fidelity test for Examples/rectypes.ml: replays tools/ocaml_ref/Examples_rectypes_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "Examples/rectypes matches Examples/rectypes.ml" {
  @rectypes.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "Examples/rectypes",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Examples/rectypes")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("term_INDUCTION", () => sthm(@rectypes.term_induction()))
  log.attempt("term_RECURSION", () => sthm(@rectypes.term_recursion()))
  log.attempt("bintree_INDUCTION", () => sthm(@rectypes.bintree_induction()))
  log.attempt("bintree_RECURSION", () => sthm(@rectypes.bintree_recursion()))
  log.attempt("etree_INDUCTION", () => sthm(@rectypes.etree_induction()))
  log.attempt("etree_RECURSION", () => sthm(@rectypes.etree_recursion()))
  log.attempt("ptree_INDUCTION", () => sthm(@rectypes.ptree_induction()))
  log.attempt("ptree_RECURSION", () => sthm(@rectypes.ptree_recursion()))
  log.attempt("mut_INDUCTION", () => sthm(@rectypes.mut_induction()))
  log.attempt("mut_RECURSION", () => sthm(@rectypes.mut_recursion()))
  log.attempt("groof_INDUCTION", () => sthm(@rectypes.groof_induction()))
  log.attempt("groof_RECURSION", () => sthm(@rectypes.groof_recursion()))
  log.attempt("biterm_INDUCTION", () => sthm(@rectypes.biterm_induction()))
  log.attempt("biterm_RECURSION", () => sthm(@rectypes.biterm_recursion()))
  log.attempt("triterm_INDUCTION", () => sthm(@rectypes.triterm_induction()))
  log.attempt("triterm_RECURSION", () => sthm(@rectypes.triterm_recursion()))
  log.attempt("xtree_INDUCTION", () => sthm(@rectypes.xtree_induction()))
  log.attempt("xtree_RECURSION", () => sthm(@rectypes.xtree_recursion()))
  log.attempt("simper_INDUCTION", () => sthm(@rectypes.simper_induction()))
  log.attempt("simper_RECURSION", () => sthm(@rectypes.simper_recursion()))
  log.attempt("array_INDUCTION", () => sthm(@rectypes.array_induction()))
  log.attempt("array_RECURSION", () => sthm(@rectypes.array_recursion()))
  log.attempt("value_INDUCTION", () => sthm(@rectypes.value_induction()))
  log.attempt("value_RECURSION", () => sthm(@rectypes.value_recursion()))
  log.attempt("example_INDUCTION", () => sthm(@rectypes.example_induction()))
  log.attempt("example_RECURSION", () => sthm(@rectypes.example_recursion()))
  log.attempt("zonk_INDUCTION", () => sthm(@rectypes.zonk_induction()))
  log.attempt("zonk_RECURSION", () => sthm(@rectypes.zonk_recursion()))
  log.attempt("string_INDUCTION", () => sthm(@rectypes.string_induction()))
  log.attempt("string_RECURSION", () => sthm(@rectypes.string_recursion()))
  log.attempt("strid_INDUCTION", () => sthm(@rectypes.strid_induction()))
  log.attempt("strid_RECURSION", () => sthm(@rectypes.strid_recursion()))
  log.attempt("nonemptylist_INDUCTION", () => {
    sthm(@rectypes.nonemptylist_induction())
  })
  log.attempt("nonemptylist_RECURSION", () => {
    sthm(@rectypes.nonemptylist_recursion())
  })
  log.attempt("long_INDUCTION", () => sthm(@rectypes.long_induction()))
  log.attempt("long_RECURSION", () => sthm(@rectypes.long_recursion()))
  log.attempt("myra_INDUCTION", () => sthm(@rectypes.myra_induction()))
  log.attempt("myra_RECURSION", () => sthm(@rectypes.myra_recursion()))
  log.attempt("daryl_INDUCTION", () => sthm(@rectypes.daryl_induction()))
  log.attempt("daryl_RECURSION", () => sthm(@rectypes.daryl_recursion()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  @testkit.check_axioms()
  inspect(
    @testkit.normalize_times(log.contents()),
    content=(
      #|Searching with limit 0
      #|Searching with limit 1
