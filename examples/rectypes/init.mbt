// Examples/rectypes.ml: the load steps are generated (rectypes.mbt).

///|
let loaded : Ref[Bool] = Ref::{ val: false, }

///|
/// Load Examples/rectypes.ml (once), after the files it needs.
pub fn load() -> Unit {
  if loaded.val {
    return
  }
  loaded.val = true
  @parser.begin_theory("Examples/rectypes")
  load_steps() catch {
    e =>
      abort("HOL Light: loading Examples/rectypes.ml failed: " + e.to_string())
  }
  @parser.end_theory()
}
