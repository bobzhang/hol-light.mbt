  schnirelmann_direct_c.set(@tactics.prove(@parser.parse_term("!s. schnirelmann s > &0\n       ==> ?k. !n. ?m f. m <= k /\\ (!i. i IN 1..m ==> f(i) IN s) /\\\n                         n = nsum (1..m) f"), t594))
