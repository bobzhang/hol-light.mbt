// Load-fidelity test for Examples/inverse_bug_puzzle_tac.ml: replays tools/ocaml_ref/Examples_inverse_bug_puzzle_tac_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "Examples/inverse_bug_puzzle_tac matches Examples/inverse_bug_puzzle_tac.ml" {
  @inverse_bug_puzzle_tac.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "Library/wo", "Library/card", "Library/floor", "Multivariate/misc",
      "Library/products", "Library/iter", "Multivariate/metric", "Library/frag",
      "Library/prime", "Library/grouptheory", "Multivariate/homology", "Library/matroids",
      "Multivariate/vectors", "Library/permutations", "Multivariate/determinants",
      "Examples/inverse_bug_puzzle_tac",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Examples/inverse_bug_puzzle_tac")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("COLLINEAR_3_2Dzero", () => {
    sthm(@inverse_bug_puzzle_tac.collinear_3_2dzero())
  })
  log.attempt("Noncollinear_3ImpliesDistinct", () => {
    sthm(@inverse_bug_puzzle_tac.noncollinear_3impliesdistinct())
  })
  log.attempt("collinearSymmetry", () => {
    sthm(@inverse_bug_puzzle_tac.collinearsymmetry())
  })
  log.attempt("Noncollinear_2Span", () => {
    sthm(@inverse_bug_puzzle_tac.noncollinear_2span())
  })
  log.attempt("oriented_area", () => {
    sthm(@inverse_bug_puzzle_tac.oriented_area())
  })
  log.attempt("oriented_areaSymmetry", () => {
    sthm(@inverse_bug_puzzle_tac.oriented_areasymmetry())
  })
  log.attempt("move", () => sthm(@inverse_bug_puzzle_tac.move_()))
  log.attempt("moveInvariant", () => {
    sthm(@inverse_bug_puzzle_tac.moveinvariant())
  })
  log.attempt("reachable", () => sthm(@inverse_bug_puzzle_tac.reachable()))
  log.attempt("reachableN", () => sthm(@inverse_bug_puzzle_tac.reachablen()))
  log.attempt("ReachLemma", () => sthm(@inverse_bug_puzzle_tac.reachlemma()))
  log.attempt("reachableN_CLAUSES", () => {
    sthm(@inverse_bug_puzzle_tac.reachablen_clauses())
  })
  log.attempt("reachableInvariant", () => {
    sthm(@inverse_bug_puzzle_tac.reachableinvariant())
  })
  log.attempt("move2Cond", () => sthm(@inverse_bug_puzzle_tac.move2cond()))
  log.attempt("reachableN_One", () => {
    sthm(@inverse_bug_puzzle_tac.reachablen_one())
  })
  log.attempt("reachableN_Two", () => {
    sthm(@inverse_bug_puzzle_tac.reachablen_two())
  })
  log.attempt("reachableN_Three", () => {
    sthm(@inverse_bug_puzzle_tac.reachablen_three())
  })
  log.attempt("reachableN_Four", () => {
    sthm(@inverse_bug_puzzle_tac.reachablen_four())
  })
  log.attempt("reachableN_Five", () => {
    sthm(@inverse_bug_puzzle_tac.reachablen_five())
  })
  log.attempt("moveSymmetry", () => sthm(@inverse_bug_puzzle_tac.movesymmetry()))
  log.attempt("reachableNSymmetry", () => {
    sthm(@inverse_bug_puzzle_tac.reachablensymmetry())
  })
  log.attempt("ORIENTED_AREA_COLLINEAR_CONG", () => {
    sthm(@inverse_bug_puzzle_tac.oriented_area_collinear_cong())
  })
  log.attempt("Basic2move_THM", () => {
    sthm(@inverse_bug_puzzle_tac.basic2move_thm())
  })
  log.attempt("FourStepMoveAB", () => {
    sthm(@inverse_bug_puzzle_tac.fourstepmoveab())
  })
  log.attempt("FourStepMoveABBAreach", () => {
    sthm(@inverse_bug_puzzle_tac.fourstepmoveabbareach())
  })
  log.attempt("NotMove2ImpliesCollinear", () => {
    sthm(@inverse_bug_puzzle_tac.notmove2impliescollinear())
  })
  log.attempt("DistinctImplies2moveable", () => {
    sthm(@inverse_bug_puzzle_tac.distinctimplies2moveable())
  })
  log.attempt("SameCdiffAB", () => sthm(@inverse_bug_puzzle_tac.samecdiffab()))
  log.attempt("FourMovesToCorrectTwo", () => {
    sthm(@inverse_bug_puzzle_tac.fourmovestocorrecttwo())
  })
  log.attempt("CorrectFinalPoint", () => {
    sthm(@inverse_bug_puzzle_tac.correctfinalpoint())
  })
  log.attempt("FiveMovesOrLess", () => {
    sthm(@inverse_bug_puzzle_tac.fivemovesorless())
  })
  log.attempt("NOTENOUGH_4", () => sthm(@inverse_bug_puzzle_tac.notenough_4()))
  log.attempt("FiveMovesOrLess_STRONG", () => {
    sthm(@inverse_bug_puzzle_tac.fivemovesorless_strong())
  })
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  @testkit.check_axioms()
  inspect(
    @testkit.normalize_times(log.contents()),
    content=(
