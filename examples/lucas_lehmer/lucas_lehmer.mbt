  let t406 = @tactics.conv_tac(@calc_num.num_reduce_conv)
  let t405 = @simp.rewrite_tac(@list.List([@arith.le_mult_lcancel(), @arith.le_exp(), @arith.exp_eq_0(), @int.arith_rule(@parser.parse_term("1 <= n <=> ~(n = 0)"))]))
  let t404 = @tactics.match_mp_tac(@int.arith_rule(@parser.parse_term("x + y - 1 + w = u + v + z + r + 2 /\\ 2 EXP 2 <= y /\\ w * 1 <= v\n      ==> x + y - 1 - 2 = u + (v - w + z) + r")))
  let t403 = @simp.asm_rewrite_tac(@list.List([@arith.right_add_distrib(), @arith.left_sub_distrib(), @arith.mult_clauses()]))
  let t402 = @tactics.exists_tac(@parser.parse_term("q:num"))
  let t401 = @tactics.match_mp_tac(@int.arith_rule(@parser.parse_term("!p:num. (x + p) + y = p + z ==> x + y = z")))
  let t400 = @simp.asm_rewrite_tac(@list.List([@arith.exp_2()]))
  let t399 = @tactics.exists_tac(@parser.parse_term("q + 1"))
  let t398 = @tactics.match_mp_tac(@arith.mod_uniq())
  let t397 = @tactics.repeat_tac(@tactics.strip_tac)
  let t396 = @simp.simp_tac(@list.List([@arith.mod_1(), @int.arith_rule(@parser.parse_term("r < 1 <=> r = 0"))]))
  let t395 = @tactics.conv_tac(@calc_num.num_reduce_conv)
  let t394 = @simp.asm_rewrite_tac(@list.empty())
  let t393 = @class.asm_cases_tac(@parser.parse_term("p = 1"))
  let t392 = @simp.rewrite_tac(@list.List([@arith.lt()]))
  let t391 = @tactics.conv_tac(@calc_num.num_reduce_conv)
  let t390 = @simp.asm_rewrite_tac(@list.empty())
  let t389 = @class.asm_cases_tac(@parser.parse_term("p = 0"))
  let t407 = @tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@simp.rewrite_tac(@list.List([llseq()])), t389), t390), t391), t392), t393), t394), t395), t396), t397), t398), t399), t400), t401), t402), t403), t404), t405), t406), @int.asm_arith_tac)
  let pth_step = @tactics.prove(@parser.parse_term("llseq (2 EXP p - 1) n = m\n     ==> m * m + q = 2 EXP p * q + 2 + r /\\ r < 2 EXP p - 1\n         ==> llseq (2 EXP p - 1) (SUC n) = r"), t407)
  let pconv_tt : (@kernel.Term) -> @kernel.Thm raise = @simp.gen_rewrite_conv(fn(x408 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    x408
  }, @list.List([@class.taut(@parser.parse_term("T /\\ T <=> T"))]))
  let p_tm = @parser.parse_term("p:num")
  let n_tm = @parser.parse_term("n:num")
  let m_tm = @parser.parse_term("m:num")
  let q_tm = @parser.parse_term("q:num")
  let r_tm = @parser.parse_term("r:num")
  let binop2_conv : ((@kernel.Term) -> @kernel.Thm raise) -> (((@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise) raise = fn(x409 : (@kernel.Term) -> @kernel.Thm raise) -> (((@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise) raise {
    let conv1 = x409
    fn(x410 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
      let conv2 = x410
      @equal.comb2_conv(@equal.rand_conv(conv1), conv2)
    }
  }
  let t412 = @equal.thenc(binop2_conv(@calc_num.num_mult_conv)(@calc_num.num_add_conv), @calc_num.num_add_conv)
  let ariconv : (@kernel.Term) -> @kernel.Thm raise = @equal.thenc(binop2_conv(@equal.thenc(binop2_conv(@equal.thenc(@equal.land_conv(@calc_num.num_mult_conv), @calc_num.num_add_conv))(t412), @calc_num.num_eq_conv))(@calc_num.num_lt_conv), pconv_tt)
  lucas_lehmer_rule_c.set(fn(x413 : Int64) -> @kernel.Thm raise {
    let p = x413
    let t414 = @kernel.inst_rule(@list.List([(@nums.mk_small_numeral(p), p_tm)]), pth_base)
    let th_base = @equal.conv_rule(@equal.rand_conv(@calc_num.num_reduce_conv), t414)
    let t415 = @kernel.inst_rule(@list.List([(@nums.mk_small_numeral(p), p_tm)]), pth_step)
    let th_step = @equal.conv_rule(@equal.rand_conv(@equal.land_conv(@calc_num.num_reduce_conv)), t415)
    let t416 = @num.num_of_int64(1L)
    let pp1 = @num.sub_num(@num.pow2(@lib.int63_to_int(p)), t416)
    fn lucas_lehmer_1(x417 : Int64) -> ((@kernel.Thm, @num.Num)) raise {
      let k = x417
      if (k == 0L) {
        (th_base, @basics.dest_numeral(@kernel.rand(@kernel.concl(th_base))))
      } else {
        let (th1, mval) = lucas_lehmer_1(@lib.sub63(k, 1L))
        let gofer : (Unit) -> (@kernel.Thm, @num.Num) raise = fn(x418 : Unit) -> (@kernel.Thm, @num.Num) raise {
          let _ = x418
          let mtm = @kernel.rand(@kernel.concl(th1))
          let yval = @num.power_num(mval, @num.num_of_int64(2L))
          let qval = @num.quo_num(yval, pp1)
          let t419 = @num.num_of_int64(2L)
          let rval = @num.sub_num(@num.mod_num(yval, pp1), t419)
          let t420 = (@nums.mk_numeral(rval), r_tm)
          let t421 = (@nums.mk_numeral(qval), q_tm)
          let th3 = @kernel.inst_rule(@list.List([(@nums.mk_small_numeral(@lib.sub63(k, 1L)), n_tm), (mtm, m_tm), t421, t420]), th_step)
          let th4 = @bool.mp(th3, th1)
          let th5 = @bool.mp(th4, @bool.eqt_elim(ariconv(@equal.lhand(@kernel.concl(th4)))))
          (@equal.conv_rule(@equal.land_conv(@equal.rand_conv(@calc_num.num_suc_conv)), th5), rval)
        }
        if ll_verbose().val {
          let t422 = (" of " + Int64::to_string(@lib.sub63(p, 2L)))
          @pp.std_formatter.print_string(("Iteration " + (Int64::to_string(k) + t422)))
          {
            @pp.std_formatter.print_newline()
          }
          @lib.time(gofer, ())
        } else {
          gofer(())
        }
      }
    }
    let (th1_1, y) = lucas_lehmer_1(@lib.sub63(p, 2L))
    if @num.neq_num(y, @num.num_of_int64(0L)) {
      raise Failure("LUCAS_LEHMER_RULE: not a prime")
    } else {
      let th2 = @bool.spec(@nums.mk_small_numeral(p), lucas_lehmer())
      let th3_1 = @equal.conv_rule(@equal.land_conv(@equal.rand_conv(@equal.land_conv(@equal.thenc(@equal.rand_conv(@calc_num.num_sub_conv), fn(x423 : @kernel.Term) -> @kernel.Thm raise {
        th1_1
      })))), th2)
      @bool.mp(th3_1, @bool.eqt_elim(@calc_num.num_reduce_conv(@equal.lhand(@kernel.concl(th3_1)))))
    }
  })
}

///|
let lucas_lehmer_rule_c : @lib.Cell[(Int64) -> @kernel.Thm raise] = @lib.Cell::new("LUCAS_LEHMER_RULE")

///|
/// `LUCAS_LEHMER_RULE`
pub fn lucas_lehmer_rule(x : Int64) -> @kernel.Thm raise {
  (lucas_lehmer_rule_c.get())(x)
}

