  let overall_fn : (@kernel.Term) -> @kernel.Thm raise = fn(x610 : @kernel.Term) -> @kernel.Thm raise {
    (fn(x609 : @kernel.Thm) -> @kernel.Thm raise {
      (fn(x606 : @kernel.Thm) -> @kernel.Thm raise {
        (fn(x604 : @kernel.Thm) -> ((@kernel.Thm) -> @kernel.Thm raise) raise {
