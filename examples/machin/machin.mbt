///|
/// atn_approx_conv, ATN_APPROX_CONV
fn step_37() -> Unit raise {
  let atn_tm = @parser.parse_term("atn")
  let num_0 = @num.num_of_int64(0L)
  let num_1 = @num.num_of_int64(1L)
  let num_2 = @num.num_of_int64(2L)
  fn log_2(x630 : @num.Num) -> @num.Num raise {
    let x = x630
    if @num.le_num(x, num_1) {
      @num.sub_num(log_2(@num.mult_num(num_2, x)), num_1)
    } else {
      if @num.gt_num(x, num_2) {
        @num.add_num(log_2(@num.div_num(x, num_2)), num_1)
      } else {
        num_1
      }
    }
  }
  let t631 = @simp.simp_tac(@list.List([@transc.atn_0(), @analysis.real_sub_refl(), @calc_int.real_abs_num(), @real.real_le_inv_eq(), @real.real_pow_le(), @analysis.real_pos()]))
  let pth = @tactics.prove(@parser.parse_term("!p. abs(atn(&0) - &0) <= inv(&2 pow p)"), t631)
  let atn_approx_conv : (Int64) -> ((@num.Num) -> @num.Num raise) raise = fn(x632 : Int64) -> ((@num.Num) -> @num.Num raise) raise {
    let p = x632
    fn(x633 : @num.Num) -> @num.Num raise {
      let r = x633
      if @num.eq_num(r, num_0) {
        num_0
      } else {
        let k = @num.int63_of_num(@num.minus_num(log_2(@num.abs_num(r))))
        if (k < 1L) {
          raise Failure("atn_approx_conv: argument too big")
        } else {
          let rats = mclaurin_atn_rule(k)(p)
          poly(rats, r)
        }
      }
    }
  }
  let atn_approx_conv_1 : (Int64) -> ((@kernel.Term) -> @kernel.Thm raise) raise = fn(x634 : Int64) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    let p_1 = x634
    fn(x635 : @kernel.Term) -> @kernel.Thm raise {
      let tm = x635
      let (atm, rtm) = @kernel.dest_comb(tm)
      if (atm != atn_tm) {
        raise Failure("ATN_APPROX_CONV")
      } else {
        let r_1 = @calc_int.rat_of_term(rtm)
        if @num.eq_num(r_1, num_0) {
          @bool.spec(@nums.mk_small_numeral(p_1), pth)
        } else {
          let k_1 = @num.int63_of_num(@num.minus_num(log_2(@num.abs_num(r_1))))
          if (k_1 < 1L) {
