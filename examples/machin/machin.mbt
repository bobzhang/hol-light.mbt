///|
/// mclaurin_atn_rule, MCLAURIN_ATN_RULE
fn step_15() -> Unit raise {
  let x_tm = @parser.parse_term("x:real")
  let n_tm = @parser.parse_term("n:num")
  let k_tm = @parser.parse_term("k:num")
  let inv_tm = @parser.parse_term("inv")
  let le_tm = @parser.parse_term("(<=):real->real->bool")
  let pow2_tm = @parser.parse_term("(pow) (&2)")
  let pth = @bool.specl(@list.List([x_tm, n_tm, k_tm]), mclaurin_atn_approx())
  let clean_rule : (@kernel.Thm) -> @kernel.Thm raise = @simp.rewrite_rule(@list.List([@realax.real_pow()]))
  let match_real_le_trans : (@kernel.Thm) -> @kernel.Thm raise = @drule.match_mp(@analysis.real_le_trans())
  let num_0 = @num.num_of_int64(0L)
  let num_1 = @num.num_of_int64(1L)
  let mclaurin_atn_rule : (Int64) -> ((Int64) -> @list.List[@num.Num] raise) raise = fn(x507 : Int64) -> ((Int64) -> @list.List[@num.Num] raise) raise {
    let k0 = x507
    fn(x508 : Int64) -> @list.List[@num.Num] raise {
      let p0 = x508
      if (k0 == 0L) {
        raise Failure("mclaurin_atn_rule: must have |x| <= 1/2")
      } else {
        let k = @num.num_of_int64(k0)
        let p = @num.num_of_int64(p0)
        let n = @num.int63_of_num(@num.ceiling_num(@num.div_num(@num.add_num(p, k), k)))
        let ns = if (@lib.mod63(n, 2L) == 0L) {
          @lib.range(0L, @lib.sub63(n, 1L))
        } else {
          @lib.range(0L, @lib.sub63(n, 2L))
        }
        @lib.map(fn(x509 : Int64) -> @num.Num raise {
          let m = x509
          if (@lib.mod63(m, 2L) == 0L) {
            num_0
          } else {
            let t512 = @num.div_num(num_1, @num.num_of_int64(m))
            (if (@lib.mod63(@lib.sub63(m, 1L), 4L) == 0L) {
              fn(x510 : @num.Num) -> @num.Num raise {
                x510
              }
            } else {
              fn(x511 : @num.Num) -> @num.Num raise {
                @num.minus_num(x511)
              }
            })(t512)
          }
        }, ns)
      }
    }
  }
  let mclaurin_atn_rule_1 : (Int64) -> ((Int64) -> @kernel.Thm raise) raise = fn(x513 : Int64) -> ((Int64) -> @kernel.Thm raise) raise {
    let k0_1 = x513
    fn(x514 : Int64) -> @kernel.Thm raise {
      let p0_1 = x514
      if (k0_1 == 0L) {
        raise Failure("MCLAURIN_ATN_RULE: must have |x| <= 1/2")
      } else {
        let k_1 = @num.num_of_int64(k0_1)
        let p_1 = @num.num_of_int64(p0_1)
        let n_1 = @num.ceiling_num(@num.div_num(@num.add_num(p_1, k_1), k_1))
        let t515 = (@nums.mk_numeral(n_1), n_tm)
        let th1 = @kernel.inst_rule(@list.List([(@nums.mk_numeral(k_1), k_tm), t515]), pth)
        let th2 = @kernel.assume_rule(@equal.lhand(@equal.lhand(@kernel.concl(th1))))
        let th3 = @bool.eqf_elim(@calc_num.num_reduce_conv(@kernel.rand(@kernel.rand(@equal.lhand(@kernel.concl(th1))))))
        let th4 = @bool.mp(th1, @bool.conj(th2, th3))
        let th5 = @equal.conv_rule(@equal.once_depth_conv(@analysis.real_horner_sum_conv), th4)
        let th6 = clean_rule(th5)
        let t516 = @equal.beta_rule(th6)
        let th7 = @equal.conv_rule(@equal.thenc(@calc_num.num_reduce_conv, @equal.land_conv(@calc_rat.real_rat_reduce_conv)), t516)
        let tm1 = @kernel.mk_comb(inv_tm, @kernel.mk_comb(pow2_tm, @nums.mk_numeral(p_1)))
        let tm2 = @kernel.mk_comb(@kernel.mk_comb(le_tm, @kernel.rand(@kernel.concl(th7))), tm1)
        let th8 = @bool.eqt_elim(@equal.thenc(@calc_num.num_reduce_conv, @calc_rat.real_rat_reduce_conv)(tm2))
        let th9 = match_real_le_trans(@bool.conj(th7, th8))
        @bool.gen(x_tm, @bool.disch_all(th9))
      }
    }
  }
  let (mclaurin_atn_rule_2, mclaurin_atn_rule_3) = (mclaurin_atn_rule, mclaurin_atn_rule_1)
  mclaurin_atn_rule_c.set(mclaurin_atn_rule_2)
  mclaurin_atn_rule_v1_c.set(mclaurin_atn_rule_3)
}

