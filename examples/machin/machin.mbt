///|
/// `POLY`
pub fn poly(x627 : @list.List[@num.Num], x628 : @num.Num) -> @num.Num raise {
  let l = x627
  let x = x628
  if @list.List::is_empty(l) {
    @num.num_0
  } else {
    let t629 = @num.mult_num(x, poly(@lib.tl(l), x))
    @num.add_num(@lib.hd(l), t629)
  }
}

