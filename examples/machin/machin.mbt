    let tm = x736
    let (ltm, rtm) = @kernel.dest_comb(tm)
    if (ltm != atn_tm) {
      raise Failure("ATN_EXPAND_CONV")
    } else {
      let r = @calc_int.rat_of_term(rtm)
      let (x_1, n_1) = home_in(r)
      let t738 = @kernel.mk_comb(atn_tm, @calc_int.term_of_rat(x_1))
      let t737 = @kernel.mk_comb(atn_tm, eighth_tm)
      let xtm = mk_add(mk_mul(@kernel.mk_comb(amp_tm, @nums.mk_small_numeral(n_1)))(t737))(t738)
      @equal.sym(machin_conv(xtm))
    }
  })
}

///|
let atn_expand_conv_c : @lib.Cell[(@kernel.Term) -> @kernel.Thm raise] = @lib.Cell::new("ATN_EXPAND_CONV")

///|
/// `ATN_EXPAND_CONV`
pub fn atn_expand_conv(x : @kernel.Term) -> @kernel.Thm raise {
  (atn_expand_conv_c.get())(x)
}

