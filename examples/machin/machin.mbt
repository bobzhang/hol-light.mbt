///|
/// ATN_CMUL_CONV
fn step_22() -> Unit raise {
  let t612 = @simp.rewrite_tac(@list.List([@analysis.real_mul_lzero(), @realax.real_mul_lid()]))
  let pth_base = @tactics.prove(@parser.parse_term("(&0 * atn(x) = &0) /\\\n     (&1 * atn(x) = atn(x))"), t612)
  let t615 = @equal.gsym(@real.real_of_num_suc())
  let t616 = @simp.rewrite_tac(@list.List([@equal.gsym(@realax.real_of_num_add()), t615]))
  let t614 = @simp.rewrite_tac(@list.List([@nums.numeral(), @arith.bit0(), @arith.bit1()]))
  let t617 = @tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@simp.rewrite_tac(@list.List([@analysis.real_mul_lzero(), @realax.real_mul_lid()])), t614), t616), @calc_rat.real_arith_tac)
  let t618 = (@parser.parse_term("(&(NUMERAL(BIT0 n)) * atn(x) =\n      &(NUMERAL n) * atn(x) + &(NUMERAL n) * atn(x)) /\\\n     (&(NUMERAL(BIT1 n)) * atn(x) =\n      atn(x) + &(NUMERAL n) * atn(x) + &(NUMERAL n) * atn(x))"), t617)
  let (pth_0, pth_1) = @bool.conj_pair((fn(x613 : (@kernel.Term, ((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise)) -> @kernel.Thm raise {
    @tactics.prove(x613.0, x613.1)
  })(t618))
  let rewr_base : (@kernel.Term) -> @kernel.Thm raise = @simp.gen_rewrite_conv(fn(x619 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    x619
  }, @list.List([pth_base]))
  let rewr_0 : (@kernel.Term) -> @kernel.Thm raise = @simp.gen_rewrite_conv(fn(x620 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    x620
  }, @list.List([pth_0]))
  let rewr_1 : (@kernel.Term) -> @kernel.Thm raise = @simp.gen_rewrite_conv(fn(x621 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    x621
  }, @list.List([pth_1]))
  fn atn_cmul_conv_1(x622 : @kernel.Term) -> @kernel.Thm raise {
    let tm = x622
    if !@calc_int.is_ratconst(@kernel.rand(@kernel.rand(tm))) {
      raise Failure("ATN_CMUL_CONV")
    } else {
      try {
        rewr_base(tm)
      } catch {
        Failure(_) => {
          try {
            let th1 = rewr_0(tm)
            let tm1 = @kernel.rand(@kernel.concl(th1))
            let th2 = atn_cmul_conv_1(@kernel.rand(tm1))
            let th3 = @kernel.mk_comb_rule(@equal.ap_term(@kernel.rator(@kernel.rator(tm1)), th2), th2)
            let th4 = @kernel.trans(th3, atn_add_conv(@kernel.rand(@kernel.concl(th3))))
            @kernel.trans(th1, th4)
          } catch {
            Failure(_) => {
              let th1_1 = rewr_1(tm)
              let tm1_1 = @kernel.rand(@kernel.rand(@kernel.concl(th1_1)))
              let th2_1 = atn_cmul_conv_1(@kernel.rand(tm1_1))
              let th3_1 = @kernel.mk_comb_rule(@equal.ap_term(@kernel.rator(@kernel.rator(tm1_1)), th2_1), th2_1)
              let th4_1 = @kernel.trans(th3_1, atn_add_conv(@kernel.rand(@kernel.concl(th3_1))))
              let th5 = @equal.ap_term(@kernel.rator(@kernel.rand(@kernel.concl(th1_1))), th4_1)
              let th6 = @kernel.trans(th5, atn_add_conv(@kernel.rand(@kernel.concl(th5))))
              @kernel.trans(th1_1, th6)
            }
            e => raise e
          }
        }
        e => raise e
      }
    }
  }
