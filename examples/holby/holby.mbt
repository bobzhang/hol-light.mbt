}

///|
/// `REFUTE_LEAVES`
pub fn refute_leaves(x334 : Termequivalence, x335 : @list.List[@kernel.Thm], x336 : @kernel.Thm) -> @kernel.Thm raise {
  let eqv = x334
  let cths = x335
  let th = x336
  let tm = @kernel.concl(th)
  if @basics.is_conj(tm) {
    try {
      refute_leaves(eqv, cths, @bool.conjunct1(th))
    } catch {
      Failure(_) => refute_leaves(eqv, cths, @bool.conjunct2(th))
      e => raise e
    }
  } else {
    if @basics.is_disj(tm) {
      let th1 = refute_leaves(eqv, cths, @kernel.assume_rule(@equal.lhand(tm)))
      let th2 = refute_leaves(eqv, cths, @kernel.assume_rule(@kernel.rand(tm)))
      @bool.disj_cases(th, th1, th2)
    } else {
      @lib.tryfind((x337 : @kernel.Thm) => prove_complementary(eqv, th, x337), cths)
    }
  }
}

///|
/// `negate`
pub fn negate(x338 : @kernel.Term) -> @kernel.Term raise {
  let tm = x338
  if @basics.is_neg(tm) {
    @kernel.rand(tm)
  } else {
    @bool.mk_neg(tm)
  }
}

///|
/// `MIZAR_UNIFIER`
pub fn mizar_unifier(x339 : Termequivalence, x340 : @list.List[@kernel.Thm], x341 : @kernel.Thm) -> @kernel.Thm raise {
  let eqv = x339
  let ths = x340
  let th = x341
  let gth = genspec(th)
  let vtm = @kernel.concl(gth)
  let t342 = @kernel.frees(@kernel.concl(th))
  let vars = @lib.subtract(@kernel.frees(vtm), t342)
  let ctms = @lib.map(fn(x344 : @kernel.Thm) -> @kernel.Term raise {
    negate((fn(x343 : @kernel.Thm) -> @kernel.Term raise {
      @kernel.concl(x343)
    })(x344))
  }, ths)
  let allctms = @lib.itlist(fn(x348 : @kernel.Term, x349 : @list.List[@kernel.Term]) -> @list.List[@kernel.Term] raise {
    (fn(x345 : @list.List[@kernel.Term]) -> ((@list.List[@kernel.Term]) -> @list.List[@kernel.Term] raise) raise {
      fn(x346 : @list.List[@kernel.Term]) -> @list.List[@kernel.Term] raise {
        @lib.union(x345, x346)
      }
    })(((x347 : @kernel.Term) => term_equivs(eqv, x347))(x348))(x349)
  }, ctms, @list.empty())
  let env = matchleaves(vars)(vtm)(allctms)(@list.empty())
  let (tmin, tyin) = separate_insts(env)
  refute_leaves(eqv, ths, @bool.pinst(tyin, tmin, gth))
}

///|
/// `DISEQUALITIES`
pub fn disequalities(x350 : @list.List[@kernel.Thm]) -> @list.List[@kernel.Thm] raise {
  let ths = x350
  match ths {
    Empty => @list.empty()
    More(th, tail=oths) => {
      let (t1, t2) = @kernel.dest_eq(@kernel.rand(@kernel.concl(th)))
      let (f1, args1) = @basics.strip_comb(t1)
      let (f2, args2) = @basics.strip_comb(t2)
      if (if (f1 != f2) {
        true
      } else {
        let t351 = Int::to_int64(@lib.length(args2))
        (Int::to_int64(@lib.length(args1)) != t351)
      }) {
        let t352 = disequalities(oths)
        (t352.prepend(@equal.gsym(th))).prepend(th)
      } else {
        let zargs = @lib.zip(args1, args2)
        let diffs = @lib.filter(fn(x353 : (@kernel.Term, @kernel.Term)) -> Bool raise {
          let (a1, a2) = x353
          (a1 != a2)
        }, zargs)
        if (Int::to_int64(@lib.length(diffs)) != 1L) {
          let t354 = disequalities(oths)
          (t354.prepend(@equal.gsym(th))).prepend(th)
        } else {
          let eths = @lib.map(fn(x355 : (@kernel.Term, @kernel.Term)) -> @kernel.Thm raise {
            let (a1_1, a2_1) = x355
            if (a1_1 == a2_1) {
              @kernel.refl(a1_1)
            } else {
              @kernel.assume_rule(@basics.mk_eq(a1_1, a2_1))
            }
          }, zargs)
          let th1 = @lib.rev_itlist(fn(x356 : @kernel.Thm, x357 : @kernel.Thm) -> @kernel.Thm raise {
            let x = x356
            let y = x357
            @kernel.mk_comb_rule(y, x)
          }, eths, @kernel.refl(f1))
          let t359 = @bool.disch_all(th1)
          let th2 = @bool.mp(@simp.gen_rewrite_rule(fn(x358 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
            x358
          }, @list.List([@equal.gsym(@class.contrapos_thm())]))(t359), th)
          let t360 = disequalities(oths.prepend(th2))
          (t360.prepend(@equal.gsym(th))).prepend(th)
        }
      }
    }
  }
}

///|
/// `ATOMINEQUALITIES`
pub fn atominequalities(x361 : @kernel.Thm, x362 : @kernel.Thm) -> @list.List[@kernel.Thm] raise {
  let th1 = x361
  let th2 = x362
  let t1 = @kernel.concl(th1)
  let t2_p = @kernel.concl(th2)
  let t2 = @basics.dest_neg(t2_p)
  let (f1, args1) = @basics.strip_comb(t1)
  let (f2, args2) = @basics.strip_comb(t2)
  if (if (f1 != f2) {
    true
  } else {
    let t363 = Int::to_int64(@lib.length(args2))
    (Int::to_int64(@lib.length(args1)) != t363)
  }) {
    @list.empty()
  } else {
    let zargs = @lib.zip(args1, args2)
    let diffs = @lib.filter(fn(x364 : (@kernel.Term, @kernel.Term)) -> Bool raise {
      let (a1, a2) = x364
      (a1 != a2)
    }, zargs)
    if (Int::to_int64(@lib.length(diffs)) != 1L) {
      @list.empty()
    } else {
      let eths = @lib.map(fn(x365 : (@kernel.Term, @kernel.Term)) -> @kernel.Thm raise {
        let (a1_1, a2_1) = x365
        if (a1_1 == a2_1) {
          @kernel.refl(a1_1)
        } else {
          @kernel.assume_rule(@basics.mk_eq(a1_1, a2_1))
        }
      }, zargs)
      let th3 = @lib.rev_itlist(fn(x366 : @kernel.Thm, x367 : @kernel.Thm) -> @kernel.Thm raise {
        let x = x366
        let y = x367
        @kernel.mk_comb_rule(y, x)
      }, eths, @kernel.refl(f1))
      let th4 = @kernel.eq_mp(@kernel.trans(th3, @bool.eqf_intro(th2)), th1)
      let th5 = @bool.not_intro(@lib.itlist(fn(x371 : (@kernel.Term, @kernel.Term), x372 : @kernel.Thm) -> @kernel.Thm raise {
        (fn(x368 : @kernel.Term) -> ((@kernel.Thm) -> @kernel.Thm raise) raise {
          fn(x369 : @kernel.Thm) -> @kernel.Thm raise {
            @bool.disch(x368, x369)
          }
        })((fn(x370 : (@kernel.Term, @kernel.Term)) -> @kernel.Term raise {
          @basics.mk_eq(x370.0, x370.1)
        })(x371))(x372)
      }, diffs, th4))
      @list.List([@lib.itlist(@bool.prove_hyp, @list.List([th1, th2]), th5)])
    }
  }
}

///|
/// `BASIC_MIZARBY`
pub fn basic_mizarby(x373 : @list.List[@kernel.Thm]) -> @kernel.Thm raise {
  let ths = x373
  try {
    let (nths, pths) = @lib.partition(fn(x376 : @kernel.Thm) -> Bool raise {
      (fn(x374 : @kernel.Term) -> Bool raise {
        @basics.is_neg(x374)
      })((fn(x375 : @kernel.Thm) -> @kernel.Term raise {
        @kernel.concl(x375)
      })(x376))
    }, ths)
    let (peqs, pneqs) = @lib.partition(fn(x379 : @kernel.Thm) -> Bool raise {
      (fn(x377 : @kernel.Term) -> Bool raise {
        @basics.is_eq(x377)
      })((fn(x378 : @kernel.Thm) -> @kernel.Term raise {
        @kernel.concl(x378)
      })(x379))
    }, pths)
    let (neqs, nneqs) = @lib.partition(fn(x383 : @kernel.Thm) -> Bool raise {
      (fn(x381 : @kernel.Term) -> Bool raise {
        (fn(x380 : @kernel.Term) -> Bool raise {
          @basics.is_eq(x380)
        })(@kernel.rand(x381))
      })((fn(x382 : @kernel.Thm) -> @kernel.Term raise {
        @kernel.concl(x382)
      })(x383))
    }, nths)
    let t389 = @lib.map(fn(x388 : @kernel.Thm) -> (@kernel.Term, @kernel.Term) raise {
      (fn(x386 : @kernel.Term) -> (@kernel.Term, @kernel.Term) raise {
        @kernel.dest_eq(@kernel.rand(x386))
      })((fn(x387 : @kernel.Thm) -> @kernel.Term raise {
        @kernel.concl(x387)
      })(x388))
    }, neqs)
    let tps = @lib.map(fn(x385 : @kernel.Thm) -> (@kernel.Term, @kernel.Term) raise {
      @kernel.dest_eq((fn(x384 : @kernel.Thm) -> @kernel.Term raise {
        @kernel.concl(x384)
      })(x385))
    }, peqs).concat(t389)
    let otms = @lib.itlist(fn(x390 : (@kernel.Term, @kernel.Term), x391 : @list.List[@kernel.Term]) -> @list.List[@kernel.Term] raise {
      let (x, y) = x390
      let l = x391
      (l.prepend(y)).prepend(x)
    }, tps, @list.empty())
    let tms = term_universe(@lib.setify(otms))
    let eqv = congruence_closure(tms, @lib.map(lazy_eq, peqs))
    let eqprover : (@kernel.Thm) -> @kernel.Thm raise = fn(x392 : @kernel.Thm) -> @kernel.Thm raise {
      let th = x392
      let (s, t) = @kernel.dest_eq(@kernel.rand(@kernel.concl(th)))
      let th_p = prove_equivalent(eqv, s, t)
      @kernel.eq_mp(@bool.eqf_intro(th), th_p)
    }
    let contrprover : (@kernel.Thm) -> ((@kernel.Thm) -> @kernel.Thm raise) raise = fn(x393 : @kernel.Thm) -> ((@kernel.Thm) -> @kernel.Thm raise) raise {
      let thp = x393
      fn(x394 : @kernel.Thm) -> @kernel.Thm raise {
        let thn = x394
        let t395 = @kernel.rand(@kernel.concl(thn))
        let th_1 = prove_equivalent(eqv, @kernel.concl(thp), t395)
        @kernel.eq_mp(@kernel.trans(th_1, @bool.eqf_intro(thn)), thp)
      }
    }
    try {
      @lib.tryfind(eqprover, neqs)
    } catch {
      Failure(_) => {
        try {
          @lib.tryfind(fn(x396 : @kernel.Thm) -> @kernel.Thm raise {
            let thp_1 = x396
            @lib.tryfind(contrprover(thp_1), nneqs)
          }, pneqs)
        } catch {
          Failure(_) => {
            let new_neqs = @lib.unions(@lib.allpairs(atominequalities, pneqs, nneqs))
            let allths = pneqs.concat(nneqs.concat(peqs.concat(disequalities(neqs.concat(new_neqs)))))
            @lib.tryfind((x397 : @kernel.Thm) => mizar_unifier(eqv, allths, x397), @lib.filter(fn(x400 : @kernel.Thm) -> Bool raise {
              (fn(x398 : @kernel.Term) -> Bool raise {
                @basics.is_forall(x398)
              })((fn(x399 : @kernel.Thm) -> @kernel.Term raise {
                @kernel.concl(x399)
              })(x400))
            }, allths))
          }
          e => raise e
        }
      }
      e => raise e
    }
  } catch {
    Failure(_) => raise Failure("BASIC_MIZARBY")
    e => raise e
  }
}

///|
/// `MIZAR_REFUTER`
pub fn mizar_refuter(x401 : @list.List[@kernel.Thm]) -> @kernel.Thm raise {
  let ths = x401
  prechecker_then(basic_mizarby)(ths)
}

///|
/// MIZAR_BY
fn step_7() -> Unit raise {
  let pth = @class.taut(@parser.parse_term("(~p ==> F) <=> p"))
  let p_tm = @parser.parse_term("p:bool")
  mizar_by_c.set(fn(x402 : @list.List[@kernel.Thm]) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    let ths = x402
    fn(x403 : @kernel.Term) -> @kernel.Thm raise {
      let tm = x403
      let tm_p = @bool.mk_neg(tm)
      let th0 = @kernel.assume_rule(tm_p)
      let th1 = mizar_refuter(ths.prepend(th0))
      let t404 = @bool.disch(tm_p, th1)
      @kernel.eq_mp(@kernel.inst_rule(@list.List([(tm, p_tm)]), pth), t404)
    }
  })
}

///|
let mizar_by_c : @lib.Cell[(@list.List[@kernel.Thm]) -> ((@kernel.Term) -> @kernel.Thm raise) raise] = @lib.Cell::new("MIZAR_BY")

///|
/// `MIZAR_BY`
pub fn mizar_by(x : @list.List[@kernel.Thm]) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
  (mizar_by_c.get())(x)
}

///|
/// `MIZAR_RULE`
pub fn mizar_rule(x405 : @kernel.Term) -> @kernel.Thm raise {
  let tm = x405
  mizar_by(@list.empty())(tm)
}

///|
/// HOL_BY
fn step_8() -> Unit raise {
  let t406 = @simp.rewrite_conv(@list.List([@sets.in_elim_thm()]))
  let betaset_conv : (@kernel.Term) -> @kernel.Thm raise = @equal.thenc(@equal.top_depth_conv(@pair.gen_beta_conv), t406)
  let builtin_conv : (@kernel.Term) -> @kernel.Thm raise = fn(x407 : @kernel.Term) -> @kernel.Thm raise {
    let tm = x407
    try {
      @bool.eqt_elim(@calc_num.num_reduce_conv(tm))
    } catch {
      Failure(_) => {
        try {
          @bool.eqt_elim(@calc_rat.real_rat_reduce_conv(tm))
        } catch {
          Failure(_) => {
            try {
              @int.arith_rule(tm)
            } catch {
              Failure(_) => {
                try {
                  @calc_rat.real_arith(tm)
                } catch {
                  Failure(_) => raise Failure("BUILTIN_CONV")
                  e => raise e
                }
              }
              e => raise e
            }
          }
          e => raise e
        }
      }
      e => raise e
    }
  }
  hol_by_c.set(fn(x408 : @list.List[@kernel.Thm]) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    let ths = x408
    fn(x409 : @kernel.Term) -> @kernel.Thm raise {
      let tm_1 = x409
      try {
        mizar_by(ths)(tm_1)
      } catch {
        Failure(_) => {
          try {
            @lib.tryfind(fn(x410 : @kernel.Thm) -> @kernel.Thm raise {
              let th = x410
              @drule.part_match(fn(x411 : @kernel.Term) -> @kernel.Term raise {
                x411
              }, th)(tm_1)
            }, ths)
          } catch {
            Failure(_) => {
              try {
                let (avs, bod) = @basics.strip_forall(tm_1)
                let gvs = @lib.map(fn(x414 : @kernel.Term) -> @kernel.Term raise {
                  (fn(x412 : @kernel.HolType) -> @kernel.Term raise {
                    @basics.genvar(x412)
                  })((fn(x413 : @kernel.Term) -> @kernel.HolType raise {
                    @kernel.type_of(x413)
                  })(x414))
                }, avs)
                let gtm = @kernel.vsubst(@lib.zip(gvs, avs), bod)
                let th_2 = @lib.tryfind(fn(x415 : @kernel.Thm) -> @kernel.Thm raise {
                  let th_1 = x415
                  @drule.part_match(fn(x416 : @kernel.Term) -> @kernel.Term raise {
                    x416
                  }, th_1)(gtm)
                }, ths)
                let gth = @bool.genl(gvs, th_2)
                @kernel.eq_mp(@equal.alpha_rule(@kernel.concl(gth), tm_1), gth)
              } catch {
                Failure(_) => {
                  try {
                    let ths_p = @lib.map(@equal.beta_rule, ths)
                    let th_p = @equal.top_depth_conv(@equal.beta_conv)(tm_1)
                    let tm_p = @kernel.rand(@kernel.concl(th_p))
                    try {
                      let t419 = @lib.tryfind(fn(x417 : @kernel.Thm) -> @kernel.Thm raise {
                        let th_3 = x417
                        @drule.part_match(fn(x418 : @kernel.Term) -> @kernel.Term raise {
                          x418
                        }, th_3)(tm_p)
                      }, ths)
                      @kernel.eq_mp(@equal.sym(th_p), t419)
                    } catch {
                      Failure(_) => {
                        try {
                          let t420 = builtin_conv(tm_p)
                          @kernel.eq_mp(@equal.sym(th_p), t420)
                        } catch {
                          Failure(_) => {
                            let ths_p_p = @lib.map((x421 : @kernel.Thm) => @equal.conv_rule(betaset_conv, x421), ths_p)
                            let th_p_p = @kernel.trans(th_p, betaset_conv(tm_p))
                            let t422 = @meson.meson(ths_p_p, @kernel.rand(@kernel.concl(th_p_p)))
                            @kernel.eq_mp(@equal.sym(th_p_p), t422)
                          }
                          e => raise e
                        }
                      }
                      e => raise e
                    }
                  } catch {
                    Failure(_) => raise Failure("HOL_BY")
                    e => raise e
                  }
                }
                e => raise e
              }
            }
            e => raise e
          }
        }
        e => raise e
      }
    }
  })
}

///|
let hol_by_c : @lib.Cell[(@list.List[@kernel.Thm]) -> ((@kernel.Term) -> @kernel.Thm raise) raise] = @lib.Cell::new("HOL_BY")

///|
/// `HOL_BY`
pub fn hol_by(x : @list.List[@kernel.Thm]) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
  (hol_by_c.get())(x)
}

///|
/// `HOL_RULE`
pub fn hol_rule(x423 : @kernel.Term) -> @kernel.Thm raise {
  let tm = x423
  try {
    let (l, r) = @basics.dest_imp(tm)
    @bool.disch(l, hol_by(@bool.conjuncts_rule(@kernel.assume_rule(l)))(r))
  } catch {
    Failure(_) => hol_by(@list.empty())(tm)
    e => raise e
  }
}

