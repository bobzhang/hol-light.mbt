/// `CORRELATE_RULE`
pub fn correlate_rule(x : @kernel.Thm) -> @kernel.Thm raise {
  (correlate_rule_c.get())(x)
}

///|
/// THMLIST_CONTR_RULE
fn step_4() -> Unit raise {
  let contr_pair_thm = @bool.undisch_all(@class.taut(@parser.parse_term("p ==> ~p ==> F")))
  let p_tm = @parser.parse_term("p:bool")
  thmlist_contr_rule_c.set(fn(x154 : @list.List[@kernel.Thm]) -> @kernel.Thm raise {
    let ths = x154
    let (ths_n, ths_p) = @lib.partition(fn(x157 : @kernel.Thm) -> Bool raise {
      (fn(x155 : @kernel.Term) -> Bool raise {
        @basics.is_neg(x155)
      })((fn(x156 : @kernel.Thm) -> @kernel.Term raise {
        @kernel.concl(x156)
      })(x157))
    }, ths)
    let th_n = @lib.find(fn(x158 : @kernel.Thm) -> Bool raise {
      let thn = x158
      let tm = @kernel.rand(@kernel.concl(thn))
      @lib.exists(fn(x162 : @kernel.Thm) -> Bool raise {
        (fn(x160 : @kernel.Term) -> Bool raise {
          ((x159 : @kernel.Term) => @basics.aconv(tm, x159))(x160)
        })((fn(x161 : @kernel.Thm) -> @kernel.Term raise {
          @kernel.concl(x161)
        })(x162))
      }, ths_p)
    }, ths_n)
    let tm_1 = @kernel.rand(@kernel.concl(th_n))
    let th_p = @lib.find(fn(x166 : @kernel.Thm) -> Bool raise {
      (fn(x164 : @kernel.Term) -> Bool raise {
        ((x163 : @kernel.Term) => @basics.aconv(tm_1, x163))(x164)
      })((fn(x165 : @kernel.Thm) -> @kernel.Term raise {
        @kernel.concl(x165)
      })(x166))
    }, ths_p)
    @lib.itlist(@bool.prove_hyp, @list.List([th_p, th_n]), @kernel.inst_rule(@list.List([(tm_1, p_tm)]), contr_pair_thm))
  })
}

///|
let thmlist_contr_rule_c : @lib.Cell[(@list.List[@kernel.Thm]) -> @kernel.Thm raise] = @lib.Cell::new("THMLIST_CONTR_RULE")

///|
/// `THMLIST_CONTR_RULE`
pub fn thmlist_contr_rule(x : @list.List[@kernel.Thm]) -> @kernel.Thm raise {
  (thmlist_contr_rule_c.get())(x)
}

///|
/// `PRECHECKER_THEN`
pub fn prechecker_then(x167 : (@list.List[@kernel.Thm]) -> @kernel.Thm raise) -> ((@list.List[@kernel.Thm]) -> @kernel.Thm raise) raise {
  let prover = x167
  split_then(fn(x169 : @list.List[@kernel.Thm]) -> @kernel.Thm raise {
    let ths = x169
    try {
      thmlist_contr_rule(ths)
    } catch {
      Failure(_) => {
        let t170 = @lib.map(correlate_rule, ths)
        split_fol_then(prover)(t170)
      }
      e => raise e
    }
  })
}

///|
/// `lazyeq`
pub(all) enum Lazyeq {
  Lazy((@kernel.Term, @kernel.Term), (Unit) -> @kernel.Thm raise)
}

///|
/// `cache`
pub fn cache(x171 : (Unit) -> @kernel.Thm raise) -> ((Unit) -> @kernel.Thm raise) raise {
  let f = x171
  let store = Ref::{ val: @bool.truth() }
  fn(x173 : Unit) -> @kernel.Thm raise {
    let _ = x173
    let th = store.val
    if @basics.is_eq(@kernel.concl(th)) {
      th
    } else {
      let th_p = f(())
      {
        store.val = th_p
        ()
      }
      th_p
    }
  }
}

///|
/// `lazy_eq`
pub fn lazy_eq(x174 : @kernel.Thm) -> Lazyeq raise {
  let th = x174
  Lazyeq::Lazy(@kernel.dest_eq(@kernel.concl(th)), fn(x175 : Unit) -> @kernel.Thm raise {
    let _ = x175
    th
  })
}

///|
/// `lazy_eval`
pub fn lazy_eval(x176 : Lazyeq) -> @kernel.Thm raise {
  match x176 {
    Lazyeq::Lazy(_, f) => f(())
  }
}

///|
/// `REFL'`
pub fn refl_p(x177 : @kernel.Term) -> Lazyeq raise {
  let t = x177
  Lazyeq::Lazy((t, t), cache(fn(x178 : Unit) -> @kernel.Thm raise {
    let _ = x178
    @kernel.refl(t)
  }))
}

///|
/// `SYM'`
pub fn sym_p(x179 : Lazyeq) -> Lazyeq raise {
  match x179 {
    Lazyeq::Lazy((t, t_p), f) => Lazyeq::Lazy((t_p, t), cache(fn(x180 : Unit) -> @kernel.Thm raise {
      let _ = x180
      @equal.sym(f(()))
    }))
  }
}

///|
/// `TRANS'`
pub fn trans_p(x181 : Lazyeq) -> ((Lazyeq) -> Lazyeq raise) raise {
  match x181 {
    Lazyeq::Lazy((s, s_p), f) => fn(x182 : Lazyeq) -> Lazyeq raise {
      match x182 {
        Lazyeq::Lazy((t, t_p), g) => {
          if !@basics.aconv(s_p, t) {
            raise Failure("TRANS'")
          } else {
            Lazyeq::Lazy((s, t_p), cache(fn(x183 : Unit) -> @kernel.Thm raise {
              let _ = x183
              let t184 = g(())
              @kernel.trans(f(()), t184)
            }))
          }
        }
      }
    }
  }
}

///|
/// `MK_COMB'`
pub fn mk_comb_p(x185 : Lazyeq, x186 : Lazyeq) -> Lazyeq raise {
  match (x185, x186) {
    (Lazyeq::Lazy((s, s_p), f), Lazyeq::Lazy((t, t_p), g)) => {
      let t190 = cache(fn(x188 : Unit) -> @kernel.Thm raise {
        let _ = x188
        let t189 = g(())
        @kernel.mk_comb_rule(f(()), t189)
      })
      let t187 = @kernel.mk_comb(s_p, t_p)
      Lazyeq::Lazy((@kernel.mk_comb(s, t), t187), t190)
    }
  }
}

///|
/// `concl'`
pub fn concl_p(x191 : Lazyeq) -> ((@kernel.Term, @kernel.Term)) raise {
  match x191 {
    Lazyeq::Lazy(tmp, g) => tmp
  }
}

///|
/// `successors`
pub fn successors(x192 : @kernel.Term) -> @list.List[@kernel.Term] raise {
  let tm = x192
  try {
    let (f, x) = @kernel.dest_comb(tm)
    @list.List([f, x])
  } catch {
    Failure(_) => @list.empty()
    e => raise e
  }
}

///|
/// `predecessor_function`
pub fn predecessor_function(x193 : @list.List[@kernel.Term]) -> @lib.Func[@kernel.Term, @list.List[@kernel.Term]] raise {
  let tms = x193
  @lib.itlist(fn(x194 : @kernel.Term, x195 : @lib.Func[@kernel.Term, @list.List[@kernel.Term]]) -> @lib.Func[@kernel.Term, @list.List[@kernel.Term]] raise {
    let x = x194
    let t198 = successors(x)
    ((x199 : @lib.Func[@kernel.Term, @list.List[@kernel.Term]]) => @lib.itlist(fn(x196 : @kernel.Term, x197 : @lib.Func[@kernel.Term, @list.List[@kernel.Term]]) -> @lib.Func[@kernel.Term, @list.List[@kernel.Term]] raise {
      let y = x196
      let f = x197
      @lib.update(y, @lib.insert(x, @lib.tryapplyd(f, y, @list.empty())), f)
    }, t198, x199))(x195)
  }, tms, @lib.undefined())
}

///|
/// `termnode`
pub(all) enum Termnode {
  Nonterminal(Lazyeq)
  Terminal(@kernel.Term, @list.List[@kernel.Term])
}

///|
/// `termequivalence`
pub(all) enum Termequivalence {
  Equivalence(@lib.Func[@kernel.Term, Termnode])
}

///|
/// `terminus`
pub fn terminus(x200 : Termequivalence) -> ((@kernel.Term) -> (Lazyeq, @list.List[@kernel.Term]) raise) raise {
  match x200 {
    Termequivalence::Equivalence(f) as eqv => fn(x201 : @kernel.Term) -> (Lazyeq, @list.List[@kernel.Term]) raise {
      let a = x201
      match @lib.apply(f, a) {
        Termnode::Nonterminal(th) => {
          let b = concl_p(th).1
          let (th_p, n) = terminus(eqv)(b)
          (trans_p(th)(th_p), n)
        }
        Termnode::Terminal(t, n_1) => (refl_p(t), n_1)
      }
    }
  }
}

///|
/// `tryterminus`
pub fn tryterminus(x202 : Termequivalence, x203 : @kernel.Term) -> ((Lazyeq, @list.List[@kernel.Term])) raise {
  let eqv = x202
  let a = x203
  try {
    terminus(eqv)(a)
  } catch {
    Failure(_) => (refl_p(a), @list.List([a]))
    e => raise e
  }
}

///|
/// `canonize`
pub fn canonize(x204 : Termequivalence, x205 : @kernel.Term) -> Lazyeq raise {
  let eqv = x204
  let a = x205
  tryterminus(eqv, a).0
}

///|
/// `equate`
pub fn equate(x206 : Lazyeq, x207 : Termequivalence) -> Termequivalence raise {
  let th = x206
  match x207 {
    Termequivalence::Equivalence(f) as eqv => {
      let (a, b) = concl_p(th)
      let (ath, na) = tryterminus(eqv, a)
      let (bth, nb) = tryterminus(eqv, b)
      let a_p = concl_p(ath).1
      let b_p = concl_p(bth).1
      Termequivalence::Equivalence(if (a_p == b_p) {
        f
      } else {
        let t208 = Int::to_int64(@lib.length(nb))
        if (Int::to_int64(@lib.length(na)) <= t208) {
          let th_p = trans_p(trans_p(sym_p(ath))(th))(bth)
          let t209 = @lib.update(b_p, Termnode::Terminal(b_p, na.concat(nb)), f)
          @lib.update(a_p, Termnode::Nonterminal(th_p), t209)
        } else {
          let th_p_1 = trans_p(sym_p(trans_p(th)(bth)))(ath)
          let t210 = @lib.update(a_p, Termnode::Terminal(a_p, na.concat(nb)), f)
          @lib.update(b_p, Termnode::Nonterminal(th_p_1), t210)
        }
      })
    }
  }
}

///|
/// unequal
fn step_5() -> Unit raise {
  unequal_c.set(Termequivalence::Equivalence(@lib.undefined()))
}

///|
let unequal_c : @lib.Cell[Termequivalence] = @lib.Cell::new("unequal")

///|
/// `unequal`
pub fn unequal() -> Termequivalence {
  unequal_c.get()
}

///|
/// `equated`
pub fn equated(x211 : Termequivalence) -> @list.List[@kernel.Term] raise {
  match x211 {
    Termequivalence::Equivalence(f) => @lib.dom(f)
  }
}

///|
/// `prove_equal`
pub fn prove_equal(x212 : Termequivalence, x213 : (@kernel.Term, @kernel.Term)) -> Lazyeq raise {
  let eqv = x212
  let (s, t) = x213
  let sth = canonize(eqv, s)
  let tth = canonize(eqv, t)
  let t214 = sym_p(canonize(eqv, t))
  trans_p(canonize(eqv, s))(t214)
}

///|
/// `equivalence_class`
pub fn equivalence_class(x215 : Termequivalence, x216 : @kernel.Term) -> @list.List[@kernel.Term] raise {
  let eqv = x215
  let a = x216
  tryterminus(eqv, a).1
}

///|
/// `provecongruent`
pub fn provecongruent(x217 : Termequivalence, x218 : (@kernel.Term, @kernel.Term)) -> Lazyeq raise {
  let eqv = x217
  let (tm1, tm2) = x218
  let (f1, x1) = @kernel.dest_comb(tm1)
  let (f2, x2) = @kernel.dest_comb(tm2)
  let t219 = prove_equal(eqv, (x1, x2))
  mk_comb_p(prove_equal(eqv, (f1, f2)), t219)
}

///|
/// `emerge`
pub fn emerge(x220 : Lazyeq, x221 : (Termequivalence, @lib.Func[@kernel.Term, @list.List[@kernel.Term]])) -> ((Termequivalence, @lib.Func[@kernel.Term, @list.List[@kernel.Term]])) raise {
  let th = x220
  let (eqv, pfn) = x221
  let (s, t) = concl_p(th)
  let sth = canonize(eqv, s)
  let tth = canonize(eqv, t)
  let s_p = concl_p(sth).1
  let t_p = concl_p(tth).1
  if (s_p == t_p) {
    (eqv, pfn)
  } else {
    let sp = @lib.tryapplyd(pfn, s_p, @list.empty())
    let tp = @lib.tryapplyd(pfn, t_p, @list.empty())
    let eqv_p = equate(th, eqv)
    let stth = canonize(eqv_p, s_p)
    let sttm = concl_p(stth).1
    let pfn_p = @lib.update(sttm, @lib.union(sp, tp), pfn)
    @lib.itlist(fn(x222 : (@kernel.Term, @kernel.Term), x223 : (Termequivalence, @lib.Func[@kernel.Term, @list.List[@kernel.Term]])) -> (Termequivalence, @lib.Func[@kernel.Term, @list.List[@kernel.Term]]) raise {
      let (u, v) = x222
      let (eqv_1, pfn_1) as eqp = x223
      try {
        let thuv = provecongruent(eqv_1, (u, v))
        emerge(thuv, eqp)
      } catch {
        Failure(_) => eqp
        e => raise e
      }
    }, @lib.allpairs(fn(x224 : @kernel.Term, x225 : @kernel.Term) -> (@kernel.Term, @kernel.Term) raise {
      let u_1 = x224
      let v_1 = x225
      (u_1, v_1)
    }, sp, tp), (eqv_p, pfn_p))
  }
}

///|
/// `supersubterms`
pub fn supersubterms(x226 : @list.List[@kernel.Term], x227 : @kernel.Term) -> @list.List[@kernel.Term] raise {
  let tms = x226
  let tm = x227
  let (ltms, tms_p) = if @lib.mem(tm, tms) {
    (@list.List([tm]), @lib.filter(fn(x228 : @kernel.Term) -> Bool raise {
      let t = x228
      (t != tm)
    }, tms))
  } else {
    (@list.empty(), tms)
  }
  if @list.List::is_empty(tms_p) {
    ltms
  } else {
    let stms = try {
      let (l, r) = @kernel.dest_comb(tm)
      let t229 = supersubterms(tms_p, r)
      @lib.union(supersubterms(tms_p, l), t229)
    } catch {
      Failure(_) => @list.empty()
      e => raise e
    }
    if @list.List::is_empty(stms) {
      ltms
    } else {
      stms.prepend(tm)
    }
  }
}

///|
/// `term_universe`
pub fn term_universe(x230 : @list.List[@kernel.Term]) -> @list.List[@kernel.Term] raise {
  let tms = x230
  @lib.setify(@lib.itlist(fn(x234 : @kernel.Term, x235 : @list.List[@kernel.Term]) -> @list.List[@kernel.Term] raise {
    (fn(x231 : @list.List[@kernel.Term]) -> ((@list.List[@kernel.Term]) -> @list.List[@kernel.Term] raise) raise {
      fn(x232 : @list.List[@kernel.Term]) -> @list.List[@kernel.Term] raise {
        x231.concat(x232)
      }
    })(((x233 : @kernel.Term) => supersubterms(tms, x233))(x234))(x235)
  }, tms, @list.empty()))
}

///|
/// `congruence_closure`
pub fn congruence_closure(x236 : @list.List[@kernel.Term], x237 : @list.List[Lazyeq]) -> Termequivalence raise {
  let tms = x236
  let eqs = x237
  let pfn = predecessor_function(tms)
  let (eqv, _) = @lib.itlist(emerge, eqs, (unequal(), pfn))
  eqv
}

///|
/// `CCPROVE`
pub fn ccprove(x238 : @list.List[Lazyeq], x239 : @kernel.Term) -> Lazyeq raise {
  let eqs = x238
  let eq = x239
  let t240 = @lib.map(concl_p, eqs)
  let tps = t240.prepend(@kernel.dest_eq(eq))
  let otms = @lib.itlist(fn(x241 : (@kernel.Term, @kernel.Term), x242 : @list.List[@kernel.Term]) -> @list.List[@kernel.Term] raise {
    let (x, y) = x241
    let l = x242
    (l.prepend(y)).prepend(x)
  }, tps, @list.empty())
  let tms = term_universe(@lib.setify(otms))
  let eqv = congruence_closure(tms, eqs)
  prove_equal(eqv, @kernel.dest_eq(eq))
}

///|
/// `CONGRUENCE_CLOSURE`
pub fn congruence_closure_v1(x243 : @kernel.Term) -> @kernel.Thm raise {
  let tm = x243
  if @basics.is_imp(tm) {
    let (eqs, eq) = @basics.dest_imp(tm)
    @bool.disch(eqs, lazy_eval(ccprove(@lib.map(lazy_eq, @bool.conjuncts_rule(@kernel.assume_rule(eqs))), eq)))
  } else {
    lazy_eval(ccprove(@list.empty(), tm))
  }
}

///|
/// `CONGRUENCE_CLOSURE_CONTR`
pub fn congruence_closure_contr(x244 : @list.List[@kernel.Thm]) -> @kernel.Thm raise {
  let ths = x244
  let (nths, pths) = @lib.partition(fn(x247 : @kernel.Thm) -> Bool raise {
    (fn(x245 : @kernel.Term) -> Bool raise {
      @basics.is_neg(x245)
    })((fn(x246 : @kernel.Thm) -> @kernel.Term raise {
      @kernel.concl(x246)
    })(x247))
  }, ths)
  let peqs = @lib.filter(fn(x250 : @kernel.Thm) -> Bool raise {
    (fn(x248 : @kernel.Term) -> Bool raise {
      @basics.is_eq(x248)
    })((fn(x249 : @kernel.Thm) -> @kernel.Term raise {
      @kernel.concl(x249)
    })(x250))
  }, pths)
  let neqs = @lib.filter(fn(x254 : @kernel.Thm) -> Bool raise {
    (fn(x252 : @kernel.Term) -> Bool raise {
      (fn(x251 : @kernel.Term) -> Bool raise {
        @basics.is_eq(x251)
      })(@kernel.rand(x252))
    })((fn(x253 : @kernel.Thm) -> @kernel.Term raise {
      @kernel.concl(x253)
    })(x254))
  }, nths)
  let t260 = @lib.map(fn(x259 : @kernel.Thm) -> (@kernel.Term, @kernel.Term) raise {
    (fn(x257 : @kernel.Term) -> (@kernel.Term, @kernel.Term) raise {
      @kernel.dest_eq(@kernel.rand(x257))
    })((fn(x258 : @kernel.Thm) -> @kernel.Term raise {
      @kernel.concl(x258)
    })(x259))
  }, neqs)
  let tps = @lib.map(fn(x256 : @kernel.Thm) -> (@kernel.Term, @kernel.Term) raise {
    @kernel.dest_eq((fn(x255 : @kernel.Thm) -> @kernel.Term raise {
      @kernel.concl(x255)
    })(x256))
  }, peqs).concat(t260)
  let otms = @lib.itlist(fn(x261 : (@kernel.Term, @kernel.Term), x262 : @list.List[@kernel.Term]) -> @list.List[@kernel.Term] raise {
    let (x, y) = x261
    let l = x262
    (l.prepend(y)).prepend(x)
  }, tps, @list.empty())
  let tms = term_universe(@lib.setify(otms))
  let eqv = congruence_closure(tms, @lib.map(lazy_eq, peqs))
  let prover : (@kernel.Thm) -> @kernel.Thm raise = fn(x263 : @kernel.Thm) -> @kernel.Thm raise {
    let th = x263
    let eq = @kernel.dest_eq(@kernel.rand(@kernel.concl(th)))
    let lth = prove_equal(eqv, eq)
    let t264 = lazy_eval(lth)
    @kernel.eq_mp(@bool.eqf_intro(th), t264)
  }
  @lib.tryfind(prover, neqs)
}

///|
/// `ABS'`
pub fn abs_p(x265 : @kernel.Term, x266 : Lazyeq) -> Lazyeq raise {
  let v = x265
  match x266 {
    Lazyeq::Lazy((s, t), f) => {
      let t269 = cache(fn(x268 : Unit) -> @kernel.Thm raise {
        let _ = x268
        @kernel.abs_rule(v, f(()))
      })
      let t267 = @kernel.mk_abs(v, t)
      Lazyeq::Lazy((@kernel.mk_abs(v, s), t267), t269)
    }
  }
}

///|
/// `ALPHA_EQ'`
pub fn alpha_eq_p(x270 : @kernel.Term, x271 : @kernel.Term, x272 : Lazyeq) -> Lazyeq raise {
  let s_p = x270
  let t_p = x271
  match x272 {
    Lazyeq::Lazy((s, t), f) as inp => {
      if ((s_p == s) && (t_p == t)) {
        inp
      } else {
        Lazyeq::Lazy((s_p, t_p), cache(fn(x273 : Unit) -> @kernel.Thm raise {
          let _ = x273
          let t275 = f(())
          let t274 = @basics.mk_eq(s_p, t_p)
          @kernel.eq_mp(@equal.alpha_rule(@basics.mk_eq(s, t), t274), t275)
        }))
      }
    }
  }
}

///|
/// `PROVE_EQUAL`
pub fn prove_equal_v1(x276 : Termequivalence, x277 : (@kernel.Term, @kernel.Term)) -> Lazyeq raise {
  let eqv = x276
  let (tm1, tm2) as tmp = x277
  if (tm1 == tm2) {
    refl_p(tm1)
  } else {
    try {
      prove_equal(eqv, tmp)
    } catch {
      Failure(_) => {
        if (@kernel.is_comb(tm1) && @kernel.is_comb(tm2)) {
          let (f1, x1) = @kernel.dest_comb(tm1)
          let (f2, x2) = @kernel.dest_comb(tm2)
          let t278 = prove_equal_v1(eqv, (x1, x2))
          mk_comb_p(prove_equal_v1(eqv, (f1, f2)), t278)
        } else {
          if (@kernel.is_abs(tm1) && @kernel.is_abs(tm2)) {
            let (x1_1, bod1) = @kernel.dest_abs(tm1)
            let (x2_1, bod2) = @kernel.dest_abs(tm2)
            let gv = @basics.genvar(@kernel.type_of(x1_1))
            let t279 = @kernel.vsubst(@list.List([(gv, x2_1)]), bod2)
            alpha_eq_p(tm1, tm2, abs_p(x1_1, prove_equal_v1(eqv, (@kernel.vsubst(@list.List([(gv, x1_1)]), bod1), t279))))
          } else {
            raise Failure("PROVE_EQUAL")
          }
        }
      }
      e => raise e
    }
  }
}

///|
/// `PROVE_EQUIVALENT`
pub fn prove_equivalent(x280 : Termequivalence, x281 : @kernel.Term, x282 : @kernel.Term) -> @kernel.Thm raise {
  let eqv = x280
  let tm1 = x281
  let tm2 = x282
  lazy_eval(prove_equal_v1(eqv, (tm1, tm2)))
}

///|
/// `PROVE_COMPLEMENTARY`
pub fn prove_complementary(x283 : Termequivalence, x284 : @kernel.Thm, x285 : @kernel.Thm) -> @kernel.Thm raise {
  let eqv = x283
  let th1 = x284
  let th2 = x285
  let tm1 = @kernel.concl(th1)
  let tm2 = @kernel.concl(th2)
  if @basics.is_neg(tm1) {
    let th = prove_equivalent(eqv, @kernel.rand(tm1), tm2)
    let t286 = @kernel.eq_mp(@equal.sym(th), th2)
    @kernel.eq_mp(@bool.eqf_intro(th1), t286)
  } else {
    if @basics.is_neg(tm2) {
      let th_1 = prove_equivalent(eqv, @kernel.rand(tm2), tm1)
      let t287 = @kernel.eq_mp(@equal.sym(th_1), th1)
      @kernel.eq_mp(@bool.eqf_intro(th2), t287)
    } else {
      raise Failure("PROVE_COMPLEMENTARY")
    }
  }
}

///|
/// `test_eq`
pub fn test_eq(x288 : Termequivalence, x289 : (@kernel.Term, @kernel.Term), x290 : @list.List[(@kernel.Term, @kernel.Term)]) -> Bool raise {
  let eqv = x288
  let (tm1, tm2) = x289
  let env = x290
  if (@kernel.is_comb(tm1) && @kernel.is_comb(tm2)) {
    let (f1, x1) = @kernel.dest_comb(tm1)
    let (f2, x2) = @kernel.dest_comb(tm2)
    (test_eq(eqv, (f1, f2), env) && test_eq(eqv, (x1, x2), env))
  } else {
    if (@kernel.is_abs(tm1) && @kernel.is_abs(tm2)) {
      let (x1_1, bod1) = @kernel.dest_abs(tm1)
      let (x2_1, bod2) = @kernel.dest_abs(tm2)
      let gv = @basics.genvar(@kernel.type_of(x1_1))
      let t291 = @kernel.vsubst(@list.List([(gv, x2_1)]), bod2)
      test_eq(eqv, (@kernel.vsubst(@list.List([(gv, x1_1)]), bod1), t291), env)
    } else {
      if (@kernel.is_var(tm1) && @lib.can((x292 : @list.List[(@kernel.Term, @kernel.Term)]) => @lib.rev_assoc(tm1, x292), env)) {
        test_eq(eqv, (@lib.rev_assoc(tm1, env), tm2), @list.empty())
      } else {
        @lib.can((x293 : (@kernel.Term, @kernel.Term)) => prove_equal(eqv, x293), (tm1, tm2))
      }
    }
  }
}

///|
/// `term_equivs`
pub fn term_equivs(x294 : Termequivalence, x295 : @kernel.Term) -> @list.List[@kernel.Term] raise {
  let eqv = x294
  let tm = x295
  let l = equivalence_class(eqv, tm)
  if (l != @list.List([tm])) {
    l
  } else {
    if @kernel.is_comb(tm) {
      let (f, x) = @kernel.dest_comb(tm)
      let t299 = term_equivs(eqv, x)
      @lib.allpairs((x297 : @kernel.Term, x298 : @kernel.Term) => @lib.curry(fn(x296 : (@kernel.Term, @kernel.Term)) -> @kernel.Term raise {
        @kernel.mk_comb(x296.0, x296.1)
      }, x297, x298), term_equivs(eqv, f), t299)
    } else {
      if @kernel.is_abs(tm) {
        let (v, bod) = @kernel.dest_abs(tm)
        let gv = @basics.genvar(@kernel.type_of(v))
        @lib.map(fn(x300 : @kernel.Term) -> @kernel.Term raise {
          let t = x300
          @basics.alpha(v, @kernel.mk_abs(gv, t))
        }, term_equivs(eqv, @kernel.vsubst(@list.List([(gv, v)]), bod)))
      } else {
        @list.List([tm])
      }
    }
  }
}

///|
/// `GENSPEC`
pub fn genspec(x301 : @kernel.Thm) -> @kernel.Thm raise {
  let th = x301
  let tm = @kernel.concl(th)
  if @basics.is_forall(tm) {
    let v = @basics.bndvar(@kernel.rand(tm))
    let gv = @basics.genvar(@kernel.type_of(v))
    genspec(@bool.spec(gv, th))
  } else {
    if @basics.is_conj(tm) {
      let (th1, th2) = @bool.conj_pair(th)
      let t302 = genspec(th2)
      @bool.conj(genspec(th1), t302)
    } else {
      if @basics.is_disj(tm) {
        let th1_1 = genspec(@kernel.assume_rule(@equal.lhand(tm)))
        let th2_1 = genspec(@kernel.assume_rule(@kernel.rand(tm)))
        let th3 = @bool.disj1(th1_1, @kernel.concl(th2_1))
        let th4 = @bool.disj2(@kernel.concl(th1_1), th2_1)
        @bool.disj_cases(th, th3, th4)
      } else {
        th
      }
    }
  }
}

///|
/// `term_fmatch`
pub fn term_fmatch(x303 : @list.List[@kernel.Term], x304 : @kernel.Term, x305 : @kernel.Term, x306 : @list.List[(@kernel.Term, @kernel.Term)]) -> @list.List[(@kernel.Term, @kernel.Term)] raise {
  let vars = x303
  let vtm = x304
  let ctm = x305
  let env = x306
  if @lib.mem(vtm, vars) {
    if @lib.can((x307 : @list.List[(@kernel.Term, @kernel.Term)]) => @lib.rev_assoc(vtm, x307), env) {
      term_fmatch(vars, @lib.rev_assoc(vtm, env), ctm, env)
    } else {
      if @basics.aconv(vtm, ctm) {
        env
      } else {
        env.prepend((ctm, vtm))
      }
    }
  } else {
    if (@kernel.is_comb(vtm) && @kernel.is_comb(ctm)) {
      let (fv, xv) = @kernel.dest_comb(vtm)
      let (fc, xc) = @kernel.dest_comb(ctm)
      term_fmatch(vars, fv, fc, term_fmatch(vars, xv, xc, env))
    } else {
      if (@kernel.is_abs(vtm) && @kernel.is_abs(ctm)) {
        let (xv_1, bodv) = @kernel.dest_abs(vtm)
        let (xc_1, bodc) = @kernel.dest_abs(ctm)
        let gv = @basics.genvar(@kernel.type_of(xv_1))
        let gc = @basics.genvar(@kernel.type_of(xc_1))
        let gbodv = @kernel.vsubst(@list.List([(gv, xv_1)]), bodv)
        let gbodc = @kernel.vsubst(@list.List([(gc, xc_1)]), bodc)
        term_fmatch(vars.prepend(gv), gbodv, gbodc, env.prepend((gc, gv)))
      } else {
        if (vtm == ctm) {
          env
        } else {
          raise Failure("term_fmatch")
        }
      }
    }
  }
}

///|
/// `check_consistency`
pub fn[TA : Eq + @lib.OCompare + @lib.OHash, TB : Eq + @lib.OCompare + @lib.OHash] check_consistency(x308 : @list.List[(TA, TB)]) -> Bool raise {
  let env = x308
  match env {
    Empty => true
    More((c, v), tail=es) => @lib.forall(fn(x309 : (TA, TB)) -> Bool raise {
      let (c_p, v_p) = x309
      ((v_p != v) || (c_p == c))
    }, es)
  }
}

///|
/// `separate_insts`
pub fn separate_insts(x310 : @list.List[(@kernel.Term, @kernel.Term)]) -> ((@list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])) raise {
  let env = x310
  let tyin = @lib.itlist(fn(x311 : (@kernel.Term, @kernel.Term), x312 : @list.List[(@kernel.HolType, @kernel.HolType)]) -> @list.List[(@kernel.HolType, @kernel.HolType)] raise {
    let (c, v) = x311
    let t313 = @kernel.type_of(c)
    let t314 = @kernel.type_of(v)
    ((x315 : @list.List[(@kernel.HolType, @kernel.HolType)]) => @basics.type_match(t314, t313, x315))(x312)
  }, env, @list.empty())
  let ifn : ((@kernel.Term, @kernel.Term)) -> (@kernel.Term, @kernel.Term) raise = fn(x316 : (@kernel.Term, @kernel.Term)) -> (@kernel.Term, @kernel.Term) raise {
    let (c_1, v_1) = x316
    let t317 = @kernel.inst(tyin, v_1)
    (@kernel.inst(tyin, c_1), t317)
  }
  let tmin = @lib.setify(@lib.map(ifn, env))
  if check_consistency(tmin) {
    (tmin, tyin)
  } else {
    raise Failure("separate_insts")
  }
}

///|
/// `first_order_match`
pub fn first_order_match(x318 : @list.List[@kernel.Term], x319 : @kernel.Term, x320 : @kernel.Term, x321 : @list.List[(@kernel.Term, @kernel.Term)]) -> @list.List[(@kernel.Term, @kernel.Term)] raise {
  let vars = x318
  let vtm = x319
  let ctm = x320
  let env = x321
  let env_p = term_fmatch(vars, vtm, ctm, env)
  if @lib.can(separate_insts, env_p) {
    env_p
  } else {
    raise Failure("first_order_match")
  }
}

///|
/// matchleaves
fn step_6() -> Unit raise {
