///|
let matchleaves_c : @lib.Cell[(@list.List[@kernel.Term]) -> ((@kernel.Term) -> ((@list.List[@kernel.Term]) -> ((@list.List[(@kernel.Term, @kernel.Term)]) -> @list.List[(@kernel.Term, @kernel.Term)] raise) raise) raise) raise] = @lib.Cell::new("matchleaves")

///|
/// `matchleaves`
pub fn matchleaves(x : @list.List[@kernel.Term]) -> ((@kernel.Term) -> ((@list.List[@kernel.Term]) -> ((@list.List[(@kernel.Term, @kernel.Term)]) -> @list.List[(@kernel.Term, @kernel.Term)] raise) raise) raise) raise {
  (matchleaves_c.get())(x)
}

///|
fn[TA] matchleaves_l(x322 : @list.List[@kernel.Term], x323 : @kernel.Term, x324 : @list.List[@kernel.Term], x325 : @list.List[(@kernel.Term, @kernel.Term)], x326 : (@list.List[(@kernel.Term, @kernel.Term)]) -> TA raise) -> TA raise {
  let vars = x322
  let vtm = x323
  let ctms = x324
  let env = x325
  let cont = x326
  if @basics.is_conj(vtm) {
    try {
      matchleaves_l(vars, @kernel.rand(vtm), ctms, env, cont)
    } catch {
      Failure(_) => matchleaves_l(vars, @equal.lhand(vtm), ctms, env, cont)
      e => raise e
