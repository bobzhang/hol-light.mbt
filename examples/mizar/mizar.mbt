///|
/// `parse_lform`
pub fn parse_lform(x290 : String, x291 : @list.List[@parser.Lexcode]) -> (((String, @preterm.Preterm), @list.List[@parser.Lexcode])) raise {
  let oldlab = x290
  let l_1 = x291
  match l_1 {
