///|
/// MIZAR_CONCLUSION_TAC
fn step_14() -> Unit raise {
  let t_tm = @parser.parse_term("T")
  let t112 = @simp.pure_rewrite_conv(@list.List([@equal.gsym(@theorems.conj_assoc())]))
  let t110 = @simp.gen_rewrite_rule(fn(x107 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    let s108 = @equal.rand_conv(x107)
