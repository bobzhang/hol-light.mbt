  let conj_assoc_rule : (@kernel.Term) -> @kernel.Thm raise = fn(x113 : @kernel.Term) -> @kernel.Thm raise {
    (fn(x111 : @kernel.Thm) -> @kernel.Thm raise {
      @bool.eqt_elim(t110(x111))
