    let th = x114
    fn(x115 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise {
      let (asl, w) as gl = x115
      let cjs = @basics.conjuncts(@kernel.concl(th))
      let t116 = @basics.conjuncts(w)
      let (cjs1, cjs2) = @lib.chop_list(@lib.length(cjs), t116)
      if @list.List::is_empty(cjs2) {
        let th_p = @kernel.eq_mp(conj_assoc_rule(@basics.mk_eq(@kernel.concl(th), w)), th)
        (@tactics.null_meta, @list.List([(asl, t_tm)]), fn(x117 : (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), x118 : @list.List[@kernel.Thm]) -> @kernel.Thm raise {
          let i = x117
          @drule.instantiate_rule(i, th_p)
        })
      } else {
        let w1 = @bool.list_mk_conj(cjs1)
        let w2 = @bool.list_mk_conj(cjs2)
        let w12 = @bool.mk_conj(w1, w2)
        let th_p_1 = @kernel.eq_mp(conj_assoc_rule(@basics.mk_eq(@kernel.concl(th), w1)), th)
        let wth = conj_assoc_rule(@basics.mk_eq(w, w12))
        let t119 = @list.List([@tactics.accept_tac(th_p_1), @tactics.all_tac])
        @tactics.thenl(@tactics.then_tac(@tactics.subst1_tac(wth), @tactics.conj_tac), t119)(gl)
