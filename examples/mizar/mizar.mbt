      (("", @list.empty()), l_1)
    }
  } else {
    match @lib.hd(l_1) {
      @parser.Lexcode::Resword("by") => {
        let (pot, rem) = parse_string(@lib.tl(l_1))
        if (if @list.List::is_empty(rem) {
