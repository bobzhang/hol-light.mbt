///|
/// `parse_just`
pub fn parse_just(x295 : Bool, x296 : @list.List[@parser.Lexcode]) -> (((String, @list.List[(@list.List[(String, @kernel.Thm)]) -> @kernel.Thm raise]), @list.List[@parser.Lexcode])) raise {
