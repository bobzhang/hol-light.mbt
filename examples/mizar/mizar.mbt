///|
/// `add_mizar_transitivity_theorem`
pub fn add_mizar_transitivity_theorem(x120 : @kernel.Thm) -> Unit raise {
  let th = x120
  let pat = @basics.dest_imp(@basics.strip_forall(@kernel.concl(th)).1).0
  let t121 = mizar_transitivity_net().val
  {
    mizar_transitivity_net().val = @nets.enter_fn(@list.empty(), pat, @drule.match_mp(th), t121)
    ()
  }
}

///|
/// `TRANSITIVITY_CHAIN`
pub fn[TA] transitivity_chain(x122 : @kernel.Thm, x123 : @kernel.Thm, x124 : (@kernel.Thm) -> TA raise) -> TA raise {
  let th1 = x122
  let th2 = x123
  let ttac = x124
  let tm1 = @kernel.concl(th1)
  let tm2 = @kernel.concl(th2)
  let th = if @basics.is_eq(tm1) {
    let t125 = @kernel.rand(tm2)
    @kernel.eq_mp(@equal.sym(@equal.ap_thm(@equal.ap_term(@kernel.rator(@kernel.rator(tm2)), th1), t125)), th2)
  } else {
    if @basics.is_eq(tm2) {
      @kernel.eq_mp(@equal.ap_term(@kernel.rator(tm1), th2), th1)
    } else {
      let th12 = @bool.conj(th1, th2)
      let t127 = mizar_transitivity_net().val
      @lib.tryfind(fn(x126 : (@kernel.Thm) -> @kernel.Thm raise) -> @kernel.Thm raise {
        let rule = x126
        rule(th12)
      }, @nets.lookup(@kernel.concl(th12), t127))
    }
  }
  ttac(th)
}

