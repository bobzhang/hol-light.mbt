        (@tactics.null_meta, @list.List([(augments(@lib.map(fn(x168 : (String, @preterm.Preterm)) -> String raise {
          x168.0
        }, lfs))(t169)(asl), f_tm)]), fn(x170 : (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), x171 : @list.List[@kernel.Thm]) -> @kernel.Thm raise {
