pub fn mizar_step_tac(x149 : Bool, x150 : @list.List[(String, @preterm.Preterm)], x151 : (String, @list.List[(@list.List[(String, @kernel.Thm)]) -> @kernel.Thm raise]), x152 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) -> @tactics.Goalstate raise {
