            }
            ((pot, @lib.map(fn(x310 : String) -> ((@list.List[(String, @kernel.Thm)]) -> @kernel.Thm raise) raise {
              fn(x311 : @list.List[(String, @kernel.Thm)]) -> @kernel.Thm raise {
