            }, ths)), rst)
          } else {
            let t309 = @lib.tl(rem)
            let (oths_1, rst_1) = @parser.listof(parse_string, @parser.a(@parser.Lexcode::Ident(",")), "theorem name")(t309)
            let ths_1 = if tlink {
              oths_1.prepend("")
            } else {
