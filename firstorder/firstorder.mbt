///|
fn[TA : Eq + @lib.OCompare + @lib.OHash, TB : Eq + @lib.OCompare + @lib.OHash] eqt_l(
  x106 : (TA, (TB, @kernel.Thm)),
  x107 : (TA, (TB, @kernel.Thm)),
) -> Bool raise {
  let (a1, (b1, c1)) = x106
  let (a2, (b2, c2)) = x107
  a1 == a2 && b1 == b2 && @basics.equals_thm(c1, c2)
}

///|
fn[TC, TD] mk_contraposes_l(
  x108 : Int64,
  x109 : TD,
  x110 : @list.List[(Int64, TC)],
  x111 : @list.List[(Int64, TC)],
  x112 : @list.List[((@list.List[(Int64, TC)], (Int64, TC)), (Int64, TD))],
) -> @list.List[((@list.List[(Int64, TC)], (Int64, TC)), (Int64, TD))] raise {
  let n = x108
  let th = x109
  let used = x110
  let unused = x111
  let sofar = x112
  match unused {
    Empty => sofar
    More(h, tail=t) => {
      let nw = (
        (
          @lib.map(
            fn(x113 : (Int64, TC)) -> (Int64, TC) raise {
              @meson.mk_negated(x113.0, x113.1)
            },
            used.concat(t),
          ),
          h,
        ),
        (n, th),
      )
      mk_contraposes_l(
        @lib.add63(n, 1L),
        th,
        used.concat(@list.List([h])),
        t,
        sofar.prepend(nw),
      )
    }
  }
}

