        ),
      ],
    ),
  ] raise,
] = @lib.Cell::new("fol_of_hol_clauses")

///|
/// `fol_of_hol_clauses`
pub fn fol_of_hol_clauses(
  x : @list.List[@kernel.Thm],
) -> @list.List[
  (
    Int64,
    @list.List[
      (
        (
          @list.List[(Int64, @list.List[@meson.FolTerm])],
          (Int64, @list.List[@meson.FolTerm]),
        ),
        (Int64, @kernel.Thm),
      ),
    ],
  ),
] raise {
  fol_of_hol_clauses_c.get()(x)
