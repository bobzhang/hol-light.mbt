/// FORSTER_PUZZLE_5
fn step_37() -> Unit raise {
  forster_puzzle_5_c.set(@miz3.thm(@miz3.parse_qproof(";\n  let f be num->num;\n  assume !n. f(f(n)) < f(SUC(n));\n  !n m. n <= m ==> n <= f(m)\n  proof\n    now let n be num; assume !m. n <= m ==> n <= f(m);\n      !m. SUC n <= m ==> ?k. m = SUC k by num_CASES,LT,LE_SUC_LT;\n      thus !m. SUC n <= m ==> SUC n <= f(m) by LE_SUC,LET_TRANS,LE_SUC_LT;\n    end;\n    !m. 0 <= m ==> 0 <= f(m);\n  qed by INDUCT_TAC;\n  !n. f(n) < f(SUC n) by LE_REFL,LET_TRANS;\n  thus !n. f(n) = n by num_MONO_LT_SUC,LT_SUC_LE,LE_ANTISYM")))
}

///|
let forster_puzzle_5_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("FORSTER_PUZZLE_5")

///|
/// `FORSTER_PUZZLE_5`
pub fn forster_puzzle_5() -> @kernel.Thm {
  forster_puzzle_5_c.get()
}

