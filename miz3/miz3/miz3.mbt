///|
/// `string_of_substep`
pub fn string_of_substep(x312 : String, x313 : Substep) -> String raise {
  let prefix = x312
  let substep = x313
  let string_of_vars : (@list.List[@kernel.Term]) -> String raise = fn(x314 : @list.List[@kernel.Term]) -> String raise {
    let tl = x314
    @lib.implode(@lib.map(fn(x315 : @kernel.Term) -> String raise {
      let v = x315
      (" " + @kernel.dest_var(v).0)
    }, tl))
  }
  let string_of_labs : (@list.List[String]) -> String raise = fn(x316 : @list.List[String]) -> String raise {
    let l = x316
    @lib.implode(@lib.map(fn(x317 : String) -> String raise {
      let s = x317
      (" [" + (s + "]"))
    }, l))
  }
  fn string_of_by_items(x318 : String, x319 : @list.List[ByItem]) -> String raise {
    let x = x318
    let l_1 = x319
    match l_1 {
      Empty => ""
      More(i, tail=l_p) => {
        let t320 = string_of_by_items(",", l_p)
        (x + ((match i {
          ByItem::Label(s_1) | ByItem::Thm(s_1, _) | ByItem::Tactic(s_1, _) | ByItem::Grow(s_1, _) => s_1
          ByItem::Hole => "#"
        }) + t320))
      }
    }
  }
  let string_of_just : (Just) -> String raise = fn(x321 : Just) -> String raise {
    let just = x321
    match just {
      Just::By(l_2, l_p_1, _) => {
        let t322 = ((if @list.List::is_empty(l_p_1) {
          ""
        } else {
          (" from" + string_of_by_items(" ", l_p_1))
        }) + ";")
        ((if @list.List::is_empty(l_2) {
          ""
        } else {
          (" by" + string_of_by_items(" ", l_2))
        }) + t322)
      }
      _ => ""
    }
  }
  (prefix + ((match substep {
    Substep::Have(tm, l_3, just_1) => {
      let t324 = string_of_just(just_1)
      let t325 = (string_of_labs(l_3) + t324)
      let t323 = if indent_continued().val {
        Int::to_int64(@lib.string_length(proof_indent().val))
      } else {
        0L
      }
      (string_of_term1(prefix)(t323)(tm) + t325)
    }
    Substep::Now(l_4, just_2) => ("now" + string_of_labs(l_4))
    Substep::Let(tl_1) => {
      let s_2 = ("let" + (string_of_vars(tl_1) + " be "))
      let t326 = @kernel.type_of(@lib.hd(tl_1))
      let t327 = Int::to_int64(@lib.string_length(s_2))
      (s_2 + (string_of_type1(prefix)(t327)(t326) + ";"))
    }
    Substep::Assume(tm_1, l_5) => {
      let s_3 = "assume "
      let t329 = (string_of_labs(l_5) + ";")
      let t328 = Int::to_int64(@lib.string_length(s_3))
      (s_3 + (string_of_term1(prefix)(t328)(tm_1) + t329))
    }
    Substep::Thus(tm_2, l_6, just_3) => {
      let s_4 = "thus "
      let t331 = string_of_just(just_3)
      let t332 = (string_of_labs(l_6) + t331)
      let t330 = Int::to_int64(@lib.string_length(s_4))
      (s_4 + (string_of_term1(prefix)(t330)(tm_2) + t332))
    }
    Substep::Qed(just_4) => ("qed" + string_of_just(just_4))
    Substep::Bracket_proof => "proof"
    Substep::Bracket_end => "end;"
    Substep::Take(tm_3) => {
      let s_5 = "take "
      let t333 = Int::to_int64(@lib.string_length(s_5))
      (s_5 + (string_of_term1(prefix)(t333)(tm_3) + ";"))
    }
    Substep::Consider(tl_2, tm_4, l_7, just_5) => {
      let s_6 = ("consider" + (string_of_vars(tl_2) + " such that "))
      let t335 = string_of_just(just_5)
      let t336 = (string_of_labs(l_7) + t335)
      let t334 = Int::to_int64(@lib.string_length(s_6))
      (s_6 + (string_of_term1(prefix)(t334)(tm_4) + t336))
    }
    Substep::Set(tm_5, l_8) => {
      let s_7 = "set "
      let t338 = (string_of_labs(l_8) + ";")
      let t337 = Int::to_int64(@lib.string_length(s_7))
      (s_7 + (string_of_term1(prefix)(t337)(tm_5) + t338))
    }
    Substep::Cases(just_6, _) => ("cases" + string_of_just(just_6))
    Substep::Bracket_case => "case;"
    Substep::Suppose(tm_6, l_9) => {
      let s_8 = "suppose "
      let t340 = (string_of_labs(l_9) + ";")
      let t339 = Int::to_int64(@lib.string_length(s_8))
      (s_8 + (string_of_term1(prefix)(t339)(tm_6) + t340))
    }
    Substep::Exec(s_9, _) => ("exec " + (s_9 + ";"))
    Substep::Error(s_10, _) => s_10
    Substep::Empty_step => ""
    Substep::Error_point => ""
  }) + "\n"))
}

///|
