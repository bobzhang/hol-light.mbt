///|
/// `connect_step`
pub fn connect_step(x383 : (Int64, @list.List[@list.List[(String, @parser.Lexcode, String)]], Substep), x384 : @list.List[String]) -> Step raise {
  let _ as step = x383
  let labs = x384
  let comma = ("", @parser.Lexcode::Ident(","), "")
  let from_key = (" ", @parser.Lexcode::Resword("from"), " ")
  fn extra_from(x387 : (String, @parser.Lexcode, String), x388 : @list.List[String]) -> @list.List[(String, @parser.Lexcode, String)] raise {
    let sep = x387
    let labs_1 = x388
    match labs_1 {
      Empty => @list.empty()
      More(lab, tail=labs_p) => {
        let t389 = extra_from(comma, labs_p)
        (t389.prepend(("", @parser.Lexcode::Ident(lab), ""))).prepend(sep)
      }
    }
  }
  let connect_just : (@list.List[(String, @parser.Lexcode, String)]) -> ((Just) -> (@list.List[(String, @parser.Lexcode, String)], Just) raise) raise = fn(x390 : @list.List[(String, @parser.Lexcode, String)]) -> ((Just) -> (@list.List[(String, @parser.Lexcode, String)], Just) raise) raise {
    let src4 = x390
    fn(x391 : Just) -> (@list.List[(String, @parser.Lexcode, String)], Just) raise {
      let just = x391
      match just {
        Just::By(l_1, l_p_2, b) => {
          let (src4_p, l_p_p_2) = ungrow_by_l(src4, l_1)
          let (src4_p_p, l_p_p_p) = ungrow_by_l(src4_p, l_p_2)
          let t393 = Just::By(l_p_p_2, l_p_p_p.concat(@lib.map(fn(x392 : String) -> ByItem raise {
            let s = x392
            ByItem::Label(s)
          }, labs)), b)
          (src4_p_p.concat(if @list.List::is_empty(labs) {
            @list.empty()
          } else {
            extra_from(if @list.List::is_empty(l_p_2) {
              from_key
            } else {
              comma
            }, labs)
          }), t393)
        }
        _ => (src4, just)
      }
    }
  }
  match step {
    (e, More(src1, tail=More(src2, tail=More(src3, tail=More(src4_1, tail=More(src5, tail=Empty))))), substep) => {
      match substep {
        Substep::Have(x_1, y, just_1) => {
          let (src4_p_1, just_p) = connect_just(src4_1)(just_1)
          (e, @list.List([src1, src2, src3, src4_p_1, src5]), Substep::Have(x_1, y, just_p))
        }
        Substep::Thus(x_2, y_1, just_2) => {
          let (src4_p_2, just_p_1) = connect_just(src4_1)(just_2)
          (e, @list.List([src1, src2, src3, src4_p_2, src5]), Substep::Thus(x_2, y_1, just_p_1))
        }
        Substep::Qed(just_3) => {
          let (src4_p_3, just_p_2) = connect_just(src4_1)(just_3)
          (e, @list.List([src1, src2, src3, src4_p_3, src5]), Substep::Qed(just_p_2))
        }
        Substep::Consider(x_3, y_2, z, just_4) => {
          let (src4_p_4, just_p_3) = connect_just(src4_1)(just_4)
          (e, @list.List([src1, src2, src3, src4_p_4, src5]), Substep::Consider(x_3, y_2, z, just_p_3))
        }
        Substep::Cases(just_5, x_4) => {
          let (src4_p_5, just_p_4) = connect_just(src4_1)(just_5)
          (e, @list.List([src1, src2, src3, src4_p_5, src5]), Substep::Cases(just_p_4, x_4))
        }
        _ => raise Failure("connect_step")
      }
    }
    _ => raise Failure("connect_step")
  }
}

///|
fn[TA, TB] ungrow_by_l(x385 : @list.List[(TA, @parser.Lexcode, TB)], x386 : @list.List[ByItem]) -> ((@list.List[(TA, @parser.Lexcode, TB)], @list.List[ByItem])) raise {
  let src = x385
  let l = x386
  match l {
    Empty => (src, @list.empty())
    More(ByItem::Grow(name, tac), tail=l_p) => {
      match src {
        More(tok1, tail=More((_, @parser.Lexcode::Ident("#"), _), tail=More(tok2, tail=src_p))) => {
          let (src_p_p, l_p_p) = ungrow_by_l(src_p, l_p)
          ((src_p_p.prepend(tok2)).prepend(tok1), l_p.prepend(ByItem::Tactic(name, tac)))
        }
        _ => raise Failure("ungrow_by")
      }
    }
    More(x, tail=l_p_1) => {
      let (toks, src_p_1) = @lib.chop_list(2, src)
      let (src_p_p_1, l_p_p_1) = ungrow_by_l(src_p_1, l_p_1)
      (toks.concat(src_p_p_1), l_p_p_1.prepend(x))
    }
  }
}

///|
/// `add_width`
pub fn add_width(x394 : Int64, x395 : String) -> Int64 raise {
  let n = x394
  let s = x395
  fn add_width1(x396 : Int64, x397 : @list.List[String]) -> Int64 raise {
    let n_1 = x396
    let s_1 = x397
    match s_1 {
      Empty => n_1
      More("\t", tail=s_p) => add_width1(@lib.mul63(@lib.add63(@lib.div63(n_1, 8L), 1L), 8L), s_p)
      More("\n", tail=s_p_1) => add_width1(0L, s_p_1)
      More(_, tail=s_p_2) => add_width1(@lib.add63(n_1, 1L), s_p_2)
    }
  }
  add_width1(n, @lib.explode(s))
}

///|
/// `rewrap_step`
pub fn rewrap_step(x398 : (Int64, @list.List[@list.List[(String, @parser.Lexcode, String)]], Substep)) -> Step raise {
  let (e, src, substep) as step = x398
  match src {
    More(src1, tail=More(src2, tail=More(src3, tail=More(src4, tail=More(src5, tail=Empty))))) => {
      if @list.List::is_empty(src4) {
        step
      } else {
        let src123 = src1.concat(src2.concat(src3))
        let (x_1, y_1, z_1) = strings_of_toks(src123)
        let (x_p_1, y_p_1, _) = strings_of_toks(src4)
        let t402 = proof_width().val
        if (add_width(0L, (x_1 + (y_1 + (z_1 + (x_p_1 + y_p_1))))) > t402) {
          let (a, b, _) = @lib.last(src123)
          let src123_p = @lib.butlast(src123).concat(@list.List([(a, b, "\n")]))
          let (src1_p, src23_p) = @lib.chop_list(@lib.length(src1), src123_p)
          let (src2_p, src3_p) = @lib.chop_list(@lib.length(src2), src23_p)
          let (_, b_p, c_p) = @lib.hd(src4)
          let x1_1 = (x_1 + proof_indent().val)
          let src4_p = @lib.tl(src4).prepend((x1_1, b_p, c_p))
          let t403 = proof_width().val
          let src4_p_p = if (add_width(0L, (x1_1 + y_p_1)) > t403) {
            rewrap_from_l(x1_1, @list.empty(), src4_p)
          } else {
            src4_p
          }
          (e, @list.List([src1_p, src2_p, src3_p, src4_p_p, src5]), substep)
        } else {
          step
        }
      }
    }
    _ => raise Failure("rewrap_step")
  }
}

///|
fn[TA] rewrap_from_l(x399 : TA, x400 : @list.List[(TA, @parser.Lexcode, String)], x401 : @list.List[(TA, @parser.Lexcode, String)]) -> @list.List[(TA, @parser.Lexcode, String)] raise {
  let x1 = x399
  let src4a = x400
  let src4b = x401
  match src4b {
    Empty => @lib.rev(src4a)
    More((x, y, z), tail=More((x_p, @parser.Lexcode::Resword("from") as y_p, z_p), tail=rst)) => @lib.rev(src4a).concat((rst.prepend((x1, y_p, z_p))).prepend((x, y, "\n")))
    More(tok, tail=rst_1) => rewrap_from_l(x1, src4a.prepend(tok), rst_1)
  }
}

///|
/// `pp_step`
pub fn pp_step(x404 : String, x405 : (Int64, @list.List[@list.List[(String, @parser.Lexcode, String)]], Substep)) -> Step raise {
  let prefix = x404
  let step = x405
  let (e, _, substep) = step
  let (_, src, substep_p) = rewrap_step(step_of_substep(prefix, substep))
  let substep_p_p = match substep_p {
    Substep::Have(x, y, just) => Substep::Have(x, y, pp_just(prefix, just))
    Substep::Now(x_1, just_1) => Substep::Now(x_1, pp_just(prefix, just_1))
    Substep::Thus(x_2, y_1, just_2) => Substep::Thus(x_2, y_1, pp_just(prefix, just_2))
    Substep::Qed(just_3) => Substep::Qed(pp_just(prefix, just_3))
    Substep::Consider(x_3, y_2, z, just_4) => Substep::Consider(x_3, y_2, z, pp_just(prefix, just_4))
    Substep::Cases(just_5, justl) => {
      let t407 = @lib.map((x406 : Just) => pp_just(prefix, x406), justl)
      Substep::Cases(pp_just(prefix, just_5), t407)
    }
    Substep::Error(x_4, just_6) => Substep::Error(x_4, pp_just(prefix, just_6))
    _ => substep_p
  }
  (e, src, substep_p_p)
}

///|
/// `pp_just`
pub fn pp_just(x408 : String, x409 : Just) -> Just raise {
  let prefix_1 = x408
  let just_7 = x409
  let pp_step_p : ((Int64, @list.List[@list.List[(String, @parser.Lexcode, String)]], Substep)?) -> (Int64, @list.List[@list.List[(String, @parser.Lexcode, String)]], Substep)? raise = fn(x410 : (Int64, @list.List[@list.List[(String, @parser.Lexcode, String)]], Substep)?) -> (Int64, @list.List[@list.List[(String, @parser.Lexcode, String)]], Substep)? raise {
    let step_p = x410
    match step_p {
      Some(step_50) => Some(pp_step(prefix_1, step_50))
      None => None
    }
  }
  let prefix_p = (proof_indent().val + prefix_1)
  let pp_step_p_p : ((Int64, @list.List[@list.List[(String, @parser.Lexcode, String)]], Substep)) -> (Int64, @list.List[@list.List[(String, @parser.Lexcode, String)]], Substep) raise = fn(x411 : (Int64, @list.List[@list.List[(String, @parser.Lexcode, String)]], Substep)) -> (Int64, @list.List[@list.List[(String, @parser.Lexcode, String)]], Substep) raise {
    let step_51 = x411
    match step_51 {
      (_, _, Substep::Qed(_)) => pp_step(prefix_1, step_51)
      (_, _, Substep::Suppose(_, _)) => pp_step(prefix_1, step_51)
      _ => pp_step(prefix_p, step_51)
    }
  }
  match just_7 {
    Just::Proof(step_p_1, stepl, step_p_p) => {
      let t412 = pp_step_p(step_p_p)
      let t413 = @lib.map(pp_step_p_p, stepl)
      Just::Proof(pp_step_p(step_p_1), t413, t412)
    }
    _ => just_7
  }
}

///|
/// `outdent`
pub fn outdent(x414 : Int64, x415 : (Int64, @list.List[@list.List[(String, @parser.Lexcode, String)]], Substep)) -> Step raise {
  let n = x414
  let step = x415
  let (_, src, _) = step
  match @lib.flat(src) {
    More((x, _, _), tail=_) => {
      let x_p = @lib.explode(x)
      if (Int::to_int64(@lib.length(x_p)) < n) {
        step
      } else {
        let (_, x_p_p) = @lib.chop_list(@lib.int63_to_int(n), x_p)
        pp_step(@lib.implode(x_p_p), step)
      }
    }
    _ => step
  }
}

///|
/// `replacement_steps`
pub fn replacement_steps(x416 : (@list.List[(String, @kernel.Thm)], @kernel.Term), x417 : (String) -> ((Int64) -> (@list.List[(Int64, @list.List[@list.List[(String, @parser.Lexcode, String)]], Substep)], @list.List[String], Int64) raise) raise, x418 : (Int64, @list.List[@list.List[(String, @parser.Lexcode, String)]], Substep)) -> @list.List[Step] raise {
  let (asl, w) = x416
  let f = x417
  let step = x418
  let n = Int::to_int64(@lib.string_length(proof_indent().val))
  let t425 = next_growth_label().val
  let (steps, labs, n_1) = f(indent_of_l(step.0, step.1, step.2))(t425)
  {
    next_growth_label().val = n_1
    ()
  }
  if (grow_duplicates().val > 1L) {
    steps.concat(@list.List([rewrap_step(connect_step(step, labs))]))
  } else {
    match (steps, step) {
      (More((e, More(src1_p, tail=More(src2_p, tail=More(src3_p, tail=More(src4_p, tail=More(src5_p, tail=Empty))))), Substep::Have(tm_p, _, just_p)), tail=Empty), (_, More(src1, tail=More(src2_1, tail=More(src3_1, tail=More(src4, tail=More(src5, tail=Empty))))), Substep::Have(tm, labs_1, _))) if (tm_p == tm) => {
        let (src2_p_p, src3_p_p) = shift_l(src2_1, src3_1, just_p)
        @list.List([(e, @list.List([src1, src2_p_p, src3_p_p, src4_p, src5_p]), Substep::Have(tm, labs_1, just_p))])
      }
      (More((e_1, More(src1_p_1, tail=More(src2_p_1, tail=More(src3_p_1, tail=More(src4_p_1, tail=More(src5_p_1, tail=Empty))))), Substep::Have(tm_p_1, _, just_p_1)), tail=Empty), (_, More(src1_1, tail=More(src2_2, tail=More(src3_2, tail=More(src4_1, tail=More(src5_1, tail=Empty))))), Substep::Thus(tm_1, labs_2, _))) if (tm_p_1 == tm_1) => {
        let (src2_p_p_1, src3_p_p_1) = shift_l(src2_2, src3_2, just_p_1)
        @list.List([(e_1, @list.List([src1_1, src2_p_p_1, src3_p_p_1, src4_p_1, src5_p_1]), Substep::Thus(tm_1, labs_2, just_p_1))])
      }
      (More((e_2, _, Substep::Have(tm_p_2, _, Just::Proof(_, y_2, _))), tail=Empty), (_, _, Substep::Qed(_))) if (tm_p_2 == w) => @lib.map((x426 : (Int64, @list.List[@list.List[(String, @parser.Lexcode, String)]], Substep)) => outdent(n_1, x426), y_2)
      (More((e_3, More(src1_p_2, tail=More(src2_p_2, tail=More(src3_p_2, tail=More(src4_p_2, tail=More(src5_p_2, tail=Empty))))), Substep::Have(tm_p_3, _, Just::By(_, _, _) as just_p_2)), tail=Empty), (_, More(src1_2, tail=More(src2_3, tail=More(src3_3, tail=More(src4_2, tail=More(src5_2, tail=Empty))))), Substep::Qed(_))) if (tm_p_3 == w) => @list.List([(e_3, @list.List([src1_2, src2_3, src3_3, src4_p_2, src5_p_2]), Substep::Qed(just_p_2))])
      _ => {
        if (grow_duplicates().val > 0L) {
          steps.concat(@list.List([rewrap_step(connect_step(step, labs))]))
        } else {
          let al = @lib.map(fn(x427 : (String, @kernel.Thm)) -> (@kernel.Term, String) raise {
            let (x_3, y_3) = x427
            (@kernel.concl(y_3), x_3)
          }, asl)
          let (steps_p_1, labs_p_1) = ((x428, x429, x430, x431) => filter_growth_l(al, x428, x429, x430, x431))(steps, labs, @list.empty(), @list.empty())
          steps_p_1.concat(@list.List([rewrap_step(connect_step(step, labs_p_1))]))
        }
      }
    }
  }
}

///|
fn[TA, TB, TC] indent_of_l(x419 : TA, x420 : @list.List[@list.List[(String, TB, TC)]], x421 : Substep) -> String raise {
  let (_, src, substep) = (x419, x420, x421)
  let (x, _, _) = @lib.hd(@lib.flat(src))
  match substep {
    Substep::Qed(_) => (x + proof_indent().val)
    _ => x
  }
}

///|
fn[TF, TG, TH, TI] shift_l(x422 : @list.List[(TF, TG, String)], x423 : @list.List[(TH, TI, String)], x424 : Just) -> ((@list.List[(TF, TG, String)], @list.List[(TH, TI, String)])) raise {
  let src2 = x422
  let src3 = x423
  let just = x424
  match just {
    Just::Proof(_, _, _) => {
      if !@list.List::is_empty(src3) {
        let (x_1, y, z) = @lib.last(src3)
        (src2, @lib.butlast(src3).concat(@list.List([(x_1, y, "\n")])))
      } else {
        if !@list.List::is_empty(src2) {
          let (x_2, y_1, z_1) = @lib.last(src2)
          (@lib.butlast(src2).concat(@list.List([(x_2, y_1, "\n")])), src3)
        } else {
          (src2, src3)
        }
      }
    }
    _ => (src2, src3)
  }
}

///|
fn[TN, TO] filter_growth_l(al : @list.List[(@kernel.Term, String)], x428 : @list.List[(TN, TO, Substep)], x429 : @list.List[String], x430 : @list.List[(TN, TO, Substep)], x431 : @list.List[String]) -> ((@list.List[(TN, TO, Substep)], @list.List[String])) raise {
  let filter_growth = (x428 : @list.List[(TN, TO, Substep)], x429 : @list.List[String], x430 : @list.List[(TN, TO, Substep)], x431 : @list.List[String]) => filter_growth_l(al, x428, x429, x430, x431)
  let steps_1 = x428
  let labs_3 = x429
  let steps_p = x430
  let labs_p = x431
  match steps_1 {
    Empty => {
      let t432 = @lib.rev(labs_p)
      (@lib.rev(steps_p), t432)
    }
    More((_, _, Substep::Have(tm_2, _, _)) as step_p, tail=rst) => {
      try {
        let lab_p = @lib.assoc(tm_2, al)
        if (lab_p != "") {
          filter_growth(rst, @lib.tl(labs_3), steps_p, labs_p.prepend(lab_p))
        } else {
          let t433 = labs_p.prepend(@lib.hd(labs_3))
          filter_growth(rst, @lib.tl(labs_3), steps_p.prepend(step_p), t433)
        }
      } catch {
        _ => {
          let t434 = labs_p.prepend(@lib.hd(labs_3))
          filter_growth(rst, @lib.tl(labs_3), steps_p.prepend(step_p), t434)
        }
      }
    }
    More(step_p_1, tail=rst_1) => {
      let t435 = labs_p.prepend(@lib.hd(labs_3))
      filter_growth(rst_1, @lib.tl(labs_3), steps_p.prepend(step_p_1), t435)
    }
  }
}

///|
/// `exception Grown`
pub(all) suberror Grown {
  Grown((String) -> ((Int64) -> (@list.List[Step], @list.List[String], Int64) raise) raise)
}

