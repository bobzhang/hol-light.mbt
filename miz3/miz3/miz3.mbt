///|
/// `cut_to`
pub fn[TA, TB] cut_to(x77 : Bool, x78 : Int64, x79 : @list.List[String], x80 : @list.List[String], x81 : @list.List[(TA, @parser.Lexcode, TB)]) -> ((@list.List[(TA, @parser.Lexcode, TB)], @list.List[(TA, @parser.Lexcode, TB)])) raise {
  let b = x77
  let n = x78
  let c = x79
  let l = x80
  let toks = x81
  match toks {
    Empty => {
      if b {
