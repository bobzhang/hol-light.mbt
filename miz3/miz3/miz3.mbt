                    ByItem::Tactic(s_1, fn(x127 : @list.List[@kernel.Thm]) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise) raise {
                      t126(@lib.hd(x127))
                    })
                  } catch {
                    _ => {
                      try {
                        let t128 = exec_tactic(s_1)
                        ByItem::Tactic(s_1, (x129 : @list.List[@kernel.Thm]) => use_thms(t128, x129))
                      } catch {
                        _ => {
                          try {
                            let t130 = @tactics.conv_tac(exec_conv(s_1))
                            ByItem::Tactic(s_1, (x131 : @list.List[@kernel.Thm]) => use_thms(t130, x131))
                          } catch {
                            _ => {
