/// `insert_errors`
pub fn insert_errors(x749 : Int64, x750 : String, x751 : @list.List[(Int64, Int64)], x752 : @list.List[Int64]) -> ((String, Int64, @list.List[(Int64, Int64)], @list.List[Int64])) raise {
