          } else {
            if (b && (@lib.mem(s, l) && x)) {
              (@list.empty(), toks)
            } else {
              let (stp1, rst1) = match s {
                "(" | "[" => cut_to(true, @lib.add63(n, 1L), c, l, rst)
                ")" | "]" => cut_to(true, if (n > 0L) {
                  @lib.sub63(n, 1L)
