                    let xy = t232.prepend(("", @parser.Lexcode::Ident("?"), ""))
                    let (n_7, tm) = term_of_hol(true)(env)(xy)
                    if (n_7 != 0L) {
                      (n_7, src, Substep::Error(string_of_toks(toks), just))
                    } else {
                      let (vars_1, tm_p_1) = @lib.nsplit(@basics.dest_exists, x_2, tm)
                      ((-1L), src, Substep::Consider(vars_1, tm_p_1, labs, just))
                    }
                  }
                  e => raise e
                }
              }
              ("set", Empty, ";") => {
                if !@list.List::is_empty(by_part) {
                  raise @parser.Noparse
                } else {
                  let ((w, _), rst_5) = @parser.seq(ident_p, (x233 : @list.List[(String, @parser.Lexcode, String)]) => a_p("=", x233))(hol_part)
                  let (n_8, t_6) = term_of_hol(false)(env)(rst_5)
                  if (n_8 != 0L) {
                    (n_8, src, Substep::Error(string_of_toks(toks), Just::No_steps))
                  } else {
                    ((-1L), src, Substep::Set(@basics.mk_eq(@kernel.mk_var(w, @kernel.type_of(t_6)), t_6), labs))
                  }
                }
              }
              ("cases", Empty, _) => {
                if (!@list.List::is_empty(hol_part) || !@list.List::is_empty(labs_part)) {
                  raise @parser.Noparse
                } else {
                  ((-1L), src, Substep::Cases(just, @list.empty()))
                }
              }
              ("case", Empty, ";") => {
                if (!@list.List::is_empty(hol_part) || (!@list.List::is_empty(labs_part) || !@list.List::is_empty(by_part))) {
                  raise @parser.Noparse
                } else {
                  ((-1L), src, Substep::Bracket_case)
                }
              }
              ("suppose", Empty, ";") => {
                if !@list.List::is_empty(by_part) {
                  raise @parser.Noparse
                } else {
                  let (n_9, t_7) = term_of_hol(true)(env)(hol_part)
                  if (n_9 != 0L) {
                    let t234 = Just::Proof_expected(false)
                    (n_9, src, Substep::Error(string_of_toks(toks), t234))
                  } else {
                    ((-1L), src, Substep::Suppose(t_7, labs))
                  }
                }
              }
              ("exec", Empty, ";") => {
                let s_2 = string_of_toks(hol_part)
                ((-1L), src, Substep::Exec(s_2, exec_tactic(s_2)))
              }
              _ => raise @parser.Noparse
            }
          }
          _ => raise @parser.Noparse
        }
      }
      _ => raise @parser.Noparse
    }
  } catch {
    Failure("by_item_of_toks") => (5L, src, Substep::Error(string_of_toks(toks), Just::No_steps))
    _ => (9L, src, Substep::Error(string_of_toks(toks), Just::No_steps))
  }
}

///|
fn[TO, TP] cut_suchthat_l(x208 : @list.List[(TO, @parser.Lexcode, TP)]) -> @list.List[(TO, @parser.Lexcode, TP)] raise {
  let toks_1 = x208
  match toks_1 {
    More((_, @parser.Lexcode::Resword("that"), _), tail=More((_, @parser.Lexcode::Resword("such"), _), tail=rst_2)) => rst_2
    _ => raise @lib.NotFound
  }
}

///|
fn[TQ, TR] cut_being_l(x209 : @list.List[(TQ, @parser.Lexcode, TR)], x210 : @list.List[(TQ, @parser.Lexcode, TR)]) -> ((@list.List[(TQ, @parser.Lexcode, TR)], @list.List[(TQ, @parser.Lexcode, TR)])) raise {
