///|
fn[TA, TB] terms_of_cases_1_l(f : @kernel.Term, x304 : @list.List[@list.List[(TA, TB, Substep)]]) -> ((@list.List[Unit], @kernel.Term)) raise {
  let terms_of_cases_1 = (x304 : @list.List[@list.List[(TA, TB, Substep)]]) => terms_of_cases_1_l(f, x304)
  let cases = x304
  match cases {
    Empty => (@list.empty(), f)
    More(case, tail=rst) => {
      let (l_p, tm_p) = terms_of_cases_1(rst)
      match case {
        More((_, _, Substep::Suppose(tm, _)), tail=_) => (l_p.prepend(()), @bool.mk_disj(tm, tm_p))
        _ => raise Failure("terms_of_cases")
