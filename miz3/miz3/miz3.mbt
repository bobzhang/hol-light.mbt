///|
fn[TH] steps_of_goals1_l(prefix : String, fv : @list.List[@kernel.Term], extra_ass : (@list.List[@kernel.Term], @list.List[@kernel.Term]) -> @list.List[@kernel.Term] raise, x375 : Int64, x376 : @list.List[(@list.List[(TH, @kernel.Thm)], @kernel.Term)]) -> ((@list.List[Step], @list.List[String], Int64)) raise {
