///|
/// `terms_of_step`
pub fn terms_of_step(x295 : @list.List[@kernel.Term], x296 : (Int64, @list.List[@list.List[(String, @parser.Lexcode, String)]], Substep)) -> @list.List[@kernel.Term] raise {
  let prevs = x295
  let (_, _, substep) = x296
  match substep {
    Substep::Have(tm, _, _) => @list.List([fix_dots(prevs, tm)])
    Substep::Now(_, just) => @list.List([term_of_now(just)])
    Substep::Assume(tm_1, _) => @list.List([fix_dots(prevs, tm_1)])
    Substep::Thus(tm_2, _, _) => @list.List([fix_dots(prevs, tm_2)])
    Substep::Consider(_, tm_3, _, _) => @list.List([fix_dots(prevs, tm_3)])
    Substep::Set(tm_4, _) => @list.List([fix_dots(prevs, tm_4)])
    Substep::Suppose(tm_5, _) => @list.List([fix_dots(prevs, tm_5)])
    _ => @list.empty()
  }
}

///|
/// `term_of_now`
pub fn term_of_now(x297 : Just) -> @kernel.Term raise {
  let just_1 = x297
  match just_1 {
    Just::Proof(_, steps, _) => {
      let t300 = term_of_steps(@list.empty(), steps)
      let t301 = @simp.pure_rewrite_conv(@list.List([@theorems.and_clauses()]))
      (fn(x299 : @kernel.Thm) -> @kernel.Term raise {
        @kernel.rand((fn(x298 : @kernel.Thm) -> @kernel.Term raise {
          @kernel.concl(x298)
        })(x299))
      })(t301(t300))
    }
    _ => raise Failure("term_of_now")
  }
}

///|
/// `term_of_steps`
pub fn term_of_steps(x302 : @list.List[@kernel.Term], x303 : @list.List[(Int64, @list.List[@list.List[(String, @parser.Lexcode, String)]], Substep)]) -> @kernel.Term raise {
  let prevs_1 = x302
  let steps_1 = x303
  match steps_1 {
    Empty => t_pterm_of_now()
    More((_, _, substep_1) as step, tail=rst) => {
      let tm_p = term_of_steps(terms_of_step(prevs_1, step).concat(prevs_1), rst)
      match substep_1 {
        Substep::Let(vars) => @bool.list_mk_forall(vars, tm_p)
        Substep::Assume(tm_6, _) => @bool.mk_imp(fix_dots(prevs_1, tm_6), tm_p)
        Substep::Thus(tm_7, _, _) => @bool.mk_conj(fix_dots(prevs_1, tm_7), tm_p)
        Substep::Take(tm_8) => {
          let var_ = @basics.genvar(@kernel.type_of(tm_8))
          @bool.mk_exists(var_, @basics.subst(@list.List([(var_, tm_8)]), tm_p))
        }
        Substep::Consider(vars_1, _, _, _) => {
          if !@list.List::is_empty(@lib.intersect(@kernel.frees(tm_p), vars_1)) {
            raise Failure("term_of_now")
          } else {
            tm_p
          }
        }
        Substep::Cases(_, _) => raise Failure("term_of_now")
        _ => tm_p
      }
    }
  }
}

