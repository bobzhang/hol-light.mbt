                                More((_, @parser.Lexcode::Ident(s_2), _), tail=Empty) => ByItem::Label(s_2)
                                _ => raise Failure("by_item_of_toks")
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
          {
            by_item_cache().val = @lib.update(s_1, i, by_item_cache().val)
            ()
          }
          i
        }
      }
    }
  }
}

