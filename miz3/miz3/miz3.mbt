        let s92 = (fn(x88 : @list.List[(TA, @parser.Lexcode, TB)]) -> ((@list.List[(TA, @parser.Lexcode, TB)]) -> @list.List[(TA, @parser.Lexcode, TB)] raise) raise {
          fn(x89 : @list.List[(TA, @parser.Lexcode, TB)]) -> @list.List[(TA, @parser.Lexcode, TB)] raise {
