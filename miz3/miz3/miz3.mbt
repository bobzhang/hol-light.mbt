    More((_, @parser.Lexcode::Resword("being"), _), tail=rst_3) => {
      let t211 = @lib.rev(tail)
      (@lib.rev(rst_3), t211)
    }
    More(tok, tail=rst_4) => cut_being_l(rst_4, tail.prepend(tok))
  }
}

///|
/// `steps_of_toks1`
pub fn steps_of_toks1(x235 : Bool, x236 : Bool, x237 : @list.List[@kernel.Term], x238 : @list.List[(String, @parser.Lexcode, String)]) -> ((@list.List[Step], Step?, @list.List[(String, @parser.Lexcode, String)])) raise {
  let q = x235
  let e = x236
  let env = x237
  let toks = x238
  if @list.List::is_empty(toks) {
    if e {
      (@list.List([(9L, @list.empty(), Substep::Error_point)]), None, @list.empty())
    } else {
      (@list.empty(), None, @list.empty())
    }
  } else {
    let (stoks, rst) = cut_step(toks)
    let (status, src, substep) as step = parse_step(env, stoks)
    match substep {
      Substep::Have(tm, labs, Just::Proof_expected(_)) => {
        let (just, rst1) = just_of_toks(env, rst)
        let (step_42, rst2) = match just {
          Just::Proof(_, _, _) => ((status, src, Substep::Have(tm, labs, just)), rst1)
          _ => ((9L, src, Substep::Error(string_of_toks(stoks), Just::No_steps)), rst)
        }
        prefix_l(@list.List([step_42]), steps_of_toks1(q, e, env, rst2))
      }
      Substep::Thus(tm_1, labs_1, Just::Proof_expected(_)) => {
        let (just_1, rst1_1) = just_of_toks(env, rst)
        let (step_43, rst2_1) = match just_1 {
          Just::Proof(_, _, _) => ((status, src, Substep::Thus(tm_1, labs_1, just_1)), rst1_1)
          _ => ((9L, src, Substep::Error(string_of_toks(stoks), Just::No_steps)), rst)
        }
        prefix_l(@list.List([step_43]), steps_of_toks1(q, e, env, rst2_1))
      }
      Substep::Let(vars) => prefix_l(@list.List([step]), steps_of_toks1(q, e, @lib.rev(vars).concat(env), rst))
      Substep::Now(labs_2, Just::Proof_expected(_)) => {
        let (just_2, rst1_2) = now_of_toks(env, rst)
        let t241 = steps_of_toks1(q, e, env, rst1_2)
        prefix_l(@list.List([(status, src, Substep::Now(labs_2, just_2))]), t241)
      }
      Substep::Consider(vars_1, _, _, Just::By(_, _, _)) => prefix_l(@list.List([step]), steps_of_toks1(q, e, @lib.rev(vars_1).concat(env), rst))
      Substep::Consider(vars_2, tm_2, labs_3, Just::Proof_expected(_)) => {
        let (just_3, rst1_3) = just_of_toks(env, rst)
        let (step_44, rst2_2) = match just_3 {
          Just::Proof(_, _, _) => ((status, src, Substep::Consider(vars_2, tm_2, labs_3, just_3)), rst1_3)
          _ => ((9L, src, Substep::Error(string_of_toks(stoks), Just::No_steps)), rst)
        }
        prefix_l(@list.List([step_44]), steps_of_toks1(q, e, @lib.rev(vars_2).concat(env), rst2_2))
      }
      Substep::Set(tm_3, _) => prefix_l(@list.List([step]), steps_of_toks1(q, e, env.prepend(@kernel.dest_eq(tm_3).0), rst))
      Substep::Cases(Just::By(_, _, _) as just_4, Empty) => {
        try {
          let (justs, rst1_4) = @parser.many((x242 : @list.List[(String, @parser.Lexcode, String)]) => case_of_toks(env, q, x242))(rst)
          let (final_, step1, rst2_3) = steps_of_toks1(false, e, env, rst1_4)
          let cases = (status, src, Substep::Cases(just_4, justs))
          if !@list.List::is_empty(final_) {
            prefix_l(@list.List([cases, (9L, @list.empty(), Substep::Error_point)]), steps_of_toks1(q, e, env, rst1_4))
          } else {
            (@list.List([cases]), step1, rst2_3)
          }
        } catch {
          @parser.Noparse => {
            let t243 = steps_of_toks1(q, e, env, rst)
            prefix_l(@list.List([(9L, src, Substep::Error(string_of_toks(stoks), Just::No_steps))]), t243)
          }
          e => raise e
        }
      }
      Substep::Qed(just_5) => {
        if q {
          (@list.List([step]), None, rst)
        } else {
          let t245 = steps_of_toks1(q, e, env, rst)
          let t244 = Substep::Error(string_of_toks(stoks), Just::No_steps)
          prefix_l(@list.List([(if e {
            3L
          } else {
            9L
          }, src, t244)]), t245)
        }
      }
      Substep::Bracket_end => {
        if e {
          (@list.empty(), Some(step), rst)
        } else {
          let t246 = steps_of_toks1(q, e, env, rst)
          prefix_l(@list.List([(9L, src, Substep::Error(string_of_toks(stoks), Just::No_steps))]), t246)
        }
      }
      Substep::Bracket_proof | Substep::Cases(_, _) | Substep::Bracket_case | Substep::Suppose(_, _) => {
        let t247 = steps_of_toks1(q, e, env, rst)
        prefix_l(@list.List([(9L, src, Substep::Error(string_of_toks(stoks), Just::No_steps))]), t247)
      }
      Substep::Error(s, Just::Proof_expected(true)) => {
        let (just_6, rst1_5) = just_of_toks(env, rst)
        match just_6 {
          Just::Proof(_, _, _) => {
            let t248 = steps_of_toks1(q, e, env, rst1_5)
            prefix_l(@list.List([(status, src, Substep::Error(s, just_6))]), t248)
          }
          _ => {
            let t249 = steps_of_toks1(q, e, env, rst)
            prefix_l(@list.List([(status, src, Substep::Error(string_of_toks(stoks), Just::No_steps))]), t249)
          }
        }
      }
      Substep::Error(s_1, Just::Proof_expected(false)) => {
        let (steps, step1_1, rst1_6) = steps_of_toks1(true, true, env, rst)
        let t250 = steps_of_toks1(q, e, env, rst)
        prefix_l(@list.List([(status, src, Substep::Error(s_1, Just::Proof(None, steps, step1_1)))]), t250)
      }
      Substep::Error(_, Just::By(_, _, _)) => {
        let t251 = steps_of_toks1(q, e, env, rst)
        prefix_l(@list.List([(status, src, Substep::Error(string_of_toks(stoks), Just::No_steps))]), t251)
      }
      _ => prefix_l(@list.List([step]), steps_of_toks1(q, e, env, rst))
    }
  }
}

///|
/// `just_of_toks`
pub fn just_of_toks(x252 : @list.List[@kernel.Term], x253 : @list.List[(String, @parser.Lexcode, String)]) -> ((Just, @list.List[(String, @parser.Lexcode, String)])) raise {
  let env_1 = x252
  let toks_1 = x253
  try {
    let (stoks_1, rst_1) = cut_step(toks_1)
    let (_, _, substep_1) as step_45 = parse_step(env_1, stoks_1)
    if (substep_1 is Substep::Bracket_proof) {
      let (steps_1, step1_2, rst1_7) = steps_of_toks1(true, true, env_1, rst_1)
      (Just::Proof(Some(step_45), steps_1, step1_2), rst1_7)
    } else {
      (Just::No_steps, toks_1)
    }
  } catch {
    @parser.Noparse => (Just::No_steps, toks_1)
    e => raise e
  }
}

///|
/// `now_of_toks`
pub fn now_of_toks(x254 : @list.List[@kernel.Term], x255 : @list.List[(String, @parser.Lexcode, String)]) -> ((Just, @list.List[(String, @parser.Lexcode, String)])) raise {
  let env_2 = x254
  let toks_2 = x255
  let (steps_2, step1_3, rst_2) = steps_of_toks1(false, true, env_2, toks_2)
  (Just::Proof(None, steps_2, step1_3), rst_2)
}

///|
/// `case_of_toks`
pub fn case_of_toks(x256 : @list.List[@kernel.Term], x257 : Bool, x258 : @list.List[(String, @parser.Lexcode, String)]) -> ((Just, @list.List[(String, @parser.Lexcode, String)])) raise {
  let env_3 = x256
  let q_1 = x257
  let toks_3 = x258
  let (stoks_2, rst_3) = cut_step(toks_3)
  let (_, _, substep_2) as step_46 = parse_step(env_3, stoks_2)
  match substep_2 {
    Substep::Bracket_case => {
      let (steps_3, step1_4, rst1_8) = steps_of_toks1(q_1, true, env_3, rst_3)
      (Just::Proof(Some(step_46), steps_3, step1_4), rst1_8)
    }
    Substep::Suppose(_, _) => {
      let (steps_4, step1_5, rst1_9) = steps_of_toks1(q_1, true, env_3, rst_3)
      (Just::Proof(None, steps_4.prepend(step_46), step1_5), rst1_9)
    }
    _ => raise @parser.Noparse
  }
}

///|
fn[TA, TB, TC] prefix_l(x239 : @list.List[TA], x240 : (@list.List[TA], TB, TC)) -> ((@list.List[TA], TB, TC)) raise {
  let x = x239
  let (y, w, z) = x240
  (x.concat(y), w, z)
