///|
/// `fix_dots'`
pub fn[TA] fix_dots_p(x291 : @list.List[(TA, @kernel.Thm)], x292 : @kernel.Term) -> @kernel.Thm raise {
  let asl = x291
  let tm = x292
  try {
    let th = @lib.hd(asl).1
    let (lhs, _) = @kernel.dest_eq(@kernel.concl(th))
    let dots = @kernel.mk_var("...", @kernel.type_of(lhs))
    fn fix_dots1(x293 : @kernel.Term) -> @kernel.Thm raise {
      let tm_1 = x293
      match tm_1 {
        @kernel.Term::Var(_, _) if (tm_1 == dots) => th
        @kernel.Term::Comb(t1, t2) => {
          let t294 = fix_dots1(t2)
          @kernel.mk_comb_rule(fix_dots1(t1), t294)
        }
        @kernel.Term::Abs(x, t) => @kernel.abs_rule(x, fix_dots1(t))
        _ => @kernel.refl(tm_1)
      }
    }
    if @kernel.vfree_in(dots, tm) {
      fix_dots1(tm)
    } else {
      @kernel.refl(tm)
    }
  } catch {
    _ => @kernel.refl(tm)
  }
}

