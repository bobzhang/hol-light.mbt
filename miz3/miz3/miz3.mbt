///|
/// `labels_of_steps`
pub fn labels_of_steps(x804 : @list.List[(@list.List[String], Ref[Int64])], x805 : @list.List[(@list.List[String], Ref[Int64])], x806 : @list.List[(Int64, @list.List[@list.List[(String, @parser.Lexcode, String)]], Substep)]) -> @list.List[(@list.List[String], Ref[Int64])] raise {
  let labels = x804
  let context = x805
  let steps = x806
  match steps {
    Empty => labels
    More((_, _, substep), tail=rst) => {
      match substep {
        Substep::Assume(_, labs) | Substep::Suppose(_, labs) | (Substep::Set(_, More(_, tail=_) as labs)) => {
          let label = (labs, Ref::{ val: 0L })
          labels_of_steps(labels.prepend(label), context.prepend(label), rst)
        }
        Substep::Have(_, labs_1, just) | Substep::Thus(_, labs_1, just) | Substep::Consider(_, _, labs_1, just) | Substep::Now(labs_1, just) => {
          let label_1 = (labs_1, Ref::{ val: 0L })
          let labels1 = labels_of_just(labels.prepend(label_1), context, just)
          labels_of_steps(labels1, context.prepend(label_1), rst)
        }
        Substep::Qed(just_1) => {
          let labels1_1 = labels_of_just(labels, context, just_1)
          labels_of_steps(labels1_1, context, rst)
        }
        Substep::Cases(just_2, justl) => {
          let t809 = labels_of_just(labels, context, just_2)
          @lib.itlist(fn(x807 : Just, x808 : @list.List[(@list.List[String], Ref[Int64])]) -> @list.List[(@list.List[String], Ref[Int64])] raise {
            let just_p = x807
            let labels_p = x808
            labels_of_just(labels_p, context, just_p)
          }, @lib.rev(justl), t809)
        }
        Substep::Error(_, _) => raise @parser.Noparse
        _ => labels_of_steps(labels, context, rst)
      }
    }
  }
}

