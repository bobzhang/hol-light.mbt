        raise @parser.Noparse
      }
    }
    More(tok, tail=rst) => {
      match tok {
        (_, @parser.Lexcode::Resword(s), _) | (_, @parser.Lexcode::Ident(s), _) => {
          let x = !(((n > 0L) && @lib.mem(s, mizar_skip_bracketed())))
          if (@lib.mem(s, c) && x) {
