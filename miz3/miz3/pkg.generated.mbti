// Types and methods
pub(all) enum ByItem {
  Label(String)
  Thm(String, @kernel.Thm)
  Tactic(String, (@list.List[@kernel.Thm]) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise) raise)
  Grow(String, (@list.List[@kernel.Thm]) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise) raise)
  Hole
}

pub(all) enum Just {
  By(@list.List[ByItem], @list.List[ByItem], Bool)
  Proof((Int64, @list.List[@list.List[(String, @parser.Lexcode, String)]], Substep)?, @list.List[(Int64, @list.List[@list.List[(String, @parser.Lexcode, String)]], Substep)], (Int64, @list.List[@list.List[(String, @parser.Lexcode, String)]], Substep)?)
  Proof_expected(Bool)
  No_steps
}

pub(all) enum Substep {
  Have(@kernel.Term, @list.List[String], Just)
  Now(@list.List[String], Just)
  Let(@list.List[@kernel.Term])
  Assume(@kernel.Term, @list.List[String])
  Thus(@kernel.Term, @list.List[String], Just)
  Qed(Just)
  Bracket_proof
  Bracket_end
  Take(@kernel.Term)
  Consider(@list.List[@kernel.Term], @kernel.Term, @list.List[String], Just)
  Set(@kernel.Term, @list.List[String])
  Cases(Just, @list.List[Just])
  Bracket_case
  Suppose(@kernel.Term, @list.List[String])
  Exec(String, ((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise)
  Error(String, Just)
  Error_point
  Empty_step
}

