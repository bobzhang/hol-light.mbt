///|
/// NNF_CONV
fn step_5() -> Unit raise {
  nnf_conv_c.set(
    gen_nnf_conv(false)(
      (
        @equal.all_conv,
        (x100 : @kernel.Term) => {
          let t = x100
          let t101 = @kernel.refl(@bool.mk_neg(t))
          (@kernel.refl(t), t101)
        },
      ),
    ),
  )
}

