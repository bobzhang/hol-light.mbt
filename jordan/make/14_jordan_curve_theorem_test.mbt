      #|  (x*a + (&1 - x)*b) + (x*(b - a)) = b
      #|  (&.0 < x ==> &.0 <= x) /\\ (&.0 + x = x) /\\\n          (a <= b ==> &.0 <= b - a) /\\\n          (a < b ==> &.0 <= b - a) /\\\n          (~(b < a) ==> &.0 <= b - a) /\\\n          (~(b <= a) ==> &.0 <= b - a) /\\\n          (a < b ==> &.0 < b - a) /\\\n          (~(b <= a) ==> &.0 < b - a)
