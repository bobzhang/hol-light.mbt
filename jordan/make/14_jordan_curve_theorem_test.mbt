      #|  (&.0 < x ==> &.0 <= x) /\\ (&.0 + x = x) /\\\n          (a <= b ==> &.0 <= b - a) /\\\n          (a < b ==> &.0 <= b - a) /\\\n          (~(b < a) ==> &.0 <= b - a) /\\\n          (~(b <= a) ==> &.0 <= b - a) /\\\n          (a < b ==> &.0 < b - a) /\\\n          (~(b <= a) ==> &.0 < b - a)
      #|  (A ==> B==>C) ==> (A /\\ B ==> C)
      #|  a * r + (&1 - a) *s
      #|  &1 * b = b
      #|  a + &1 - a = &1
      #|  !r s b x. (r <= s) ==> (mk_segment (point(b,r)) (point(b,s)) x <=>\n      (?t. (r <= t /\\ t <= s /\\ (x = point(b,t)))))
