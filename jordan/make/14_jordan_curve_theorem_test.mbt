      #|  \226\136\128 X : (A) -> Bool, \226\136\128 A : (A) -> Bool, \226\136\128 B : (A) -> Bool, X == UNION(A, B) && INTER(A, B) == {} \226\134\146 DIFF(X, B) == A
      #|  SUBSET((C : (_) -> Bool), UNIONS((V : ((_) -> Bool) -> Bool)))
      #|  \226\136\128 P : (_) -> Bool, SUBSET((C : (_) -> Bool), P) \226\134\146 UNION(DIFF(P, C), C) == P
