      #|  ( *. )
      #|  !x y. ( segpath x y (&0) = y) /\\ (segpath x y (&1) = x)
      #|  (x' * x + (&1 - x') * y) - (y' * x + (&1 - y') * y) = (x' - y')*(x - y) 
      #|  ( x = y) <=> (x - y = &0)
      #|  !x y. ~(x = y) ==> INJ (segpath x y) {t | &0 <= t /\\ t <= &1} UNIV
