      #|  (b-a)*inv(b-a) = &1
      #|  (A /\\ B) /\\ C ==> A /\\ B /\\ C
      #|  {x | c <= x /\\ x <= d}
      #|  (IMAGE f {x | c <= x /\\ x <= d} = IMAGE g {x | a <= x /\\ x <= b})
      #|  {x | c <= x /\\ x <= d} = IMAGE f2 {x | a <= x /\\ x <= b}
      #|  (inv x)*y = y*(inv x)
