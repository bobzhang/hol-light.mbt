///|
/// JORDAN_CURVE_DEFS
fn step_1541() -> Unit raise {
  let t56505 = @simp.rewrite_tac(@list.List([@misc_defs_and_lemmas.euclid(), top2(), @metric_spaces.top_of_metric(), @metric_spaces.open_balls(), @metric_spaces.open_ball(), @metric_spaces.connected()]))
  let t56506 = @simp.rewrite_tac(@list.List([@metric_spaces.d_euclid_n()]))
  let t56507 = @list.List([@simp.rewrite_tac(@list.List([simple_closed_curve(), @metric_spaces.continuous(), @misc_defs_and_lemmas.preimage(), @metric_spaces.d_real()])), t56506, t56505])
  jordan_curve_defs_c.set(@tactics_refine.prove_by_refinement(@parser.parse_term("(!x. euclid 2 x = (!n. 2 <=| n ==> (x n = &0))) /\\\n   (top2 = top_of_metric (euclid 2,d_euclid)) /\\\n   (!(X:A->bool) d. top_of_metric (X,d) =\n         {A | ?F. F SUBSET open_balls (X,d) /\\ (A = UNIONS F) }) /\\\n   (!(X:A->bool) d. open_balls(X,d) =\n         {B | ?x r. (B = open_ball (X,d) x r) }) /\\\n   (!X d (x:A) r. open_ball (X,d) x r =\n         {y | X x /\\ X y /\\ d x y < r}) /\\\n   (!U (Z:A->bool). connected U Z <=>\n         Z SUBSET UNIONS U /\\\n         (!A B.\n              U A /\\ U B /\\ (A INTER B = {}) /\\ Z SUBSET A UNION B\n              ==> Z SUBSET A \\/ Z SUBSET B)) /\\\n   (!(C:A->bool) U. simple_closed_curve U C =\n             (?f. (C = IMAGE f {x | &0 <= x /\\ x <= &1}) /\\\n              continuous f (top_of_metric (UNIV,d_real)) U /\\\n              INJ f {x | &0 <= x /\\ x < &1} (UNIONS U) /\\\n              (f (&0) = f (&1)))) /\\\n   (!(f:A->B) U V. continuous f U V =\n         (!v. V v ==> U  { x | (UNIONS U) x /\\ v (f x) })) /\\\n   (!x y. d_real x y = abs  (x - y)) /\\\n   (!x y. euclid 2 x /\\ euclid 2 y\n         ==> (d_euclid x y =\n              sqrt (sum (0,2) (\\i. (x i - y i) * (x i - y i)))))"), t56507))
}

///|
let jordan_curve_defs_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("JORDAN_CURVE_DEFS")

///|
/// `JORDAN_CURVE_DEFS`
pub fn jordan_curve_defs() -> @kernel.Thm {
  jordan_curve_defs_c.get()
}

