.type_then(t56411, subagoal_tac, x56412), t56462, t56461, (x56416 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) => @tactics_ext2.type_then(t56415, @class.asm_cases_tac, x56416), t56460, t56459, (x56419 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) => @tactics_ext2.type_then(t56418, subagoal_tac, x56419), t56458, t56457, @tactics_ext2.subconj_tac, t56456, t56455, (x56427 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) => @tactics_ext2.type_then(t56426, subagoal_tac, x56427), t56454, (x56429 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) => @tactics_ext2.type_then(t56428, subagoal_tac, x56429), t56453, (x56431 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) => @tactics_ext2.type_then(t56430, subagoal_tac, x56431), t56452, t56451, t56450, t56449, (x56437 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) => @tactics_ext2.type_then(t56436, subagoal_tac, x56437), t56448, t56447, t56446, t56445])
