///|
let pi_ser_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("PI_SER")

///|
/// `PI_SER`
pub fn pi_ser() -> @kernel.Thm {
  pi_ser_c.get()
}

///|
/// `SUC_EXPAND_CONV`
pub fn suc_expand_conv(x1239 : @kernel.Term) -> @kernel.Thm raise {
  let tm = x1239
  let count = @basics.dest_numeral(tm)
  fn add_suc(x1240 : @num.Num, x1241 : @kernel.Term) -> @kernel.Term raise {
    let i = x1240
    let r = x1241
    if @num.le_num(i, @num.num_of_int64(0L)) {
      r
    } else {
      let t1242 = @kernel.mk_comb(@parser.parse_term("SUC"), r)
      add_suc(@num.sub_num(i, @num.num_of_int64(1L)), t1242)
    }
  }
  let tm_p = add_suc(count, @parser.parse_term("0"))
  let t1243 = @basics.mk_eq(tm, tm_p)
  let t1244 = @num_calc_simp.arith_rewrite_conv(@list.empty())(t1243)
  @simp.rewrite_rule(@list.empty())(t1244)
}

///|
/// inv_twopow
fn step_203() -> Unit raise {
  let t1245 = @simp.rewrite_tac(@list.List([@float.twopow_neg(), @equal.gsym(@calc_num.num_red_conv(@parser.parse_term("2 EXP 4"))), @calc_int.real_of_num_pow(), @arith.exp_mult()]))
  inv_twopow_c.set(@tactics_refine.prove(@parser.parse_term("!n. inv (&.16 **. n) = (twopow (--: (&:(4*n)))) "), t1245))
}

///|
let inv_twopow_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("inv_twopow")

///|
/// `inv_twopow`
pub fn inv_twopow() -> @kernel.Thm {
  inv_twopow_c.get()
}

///|
/// `PI_SERn`
pub fn pi_sern(x1246 : @kernel.Term) -> @kernel.Thm raise {
  let n = x1246
  let t1249 = @num_calc_simp.arith_rewrite_conv(@list.List([@realax.real_add_lid(), @equal.gsym(@realax.real_add_assoc())]))
  let t1248 = @simp.rewrite_conv(@list.List([@analysis.sum()]))
  let t1247 = @equal.top_depth_conv(suc_expand_conv)
  let sum_expand_conv : (@kernel.Term) -> @kernel.Thm raise = @equal.thenc(@equal.thenc(@equal.thenc(@num_calc_simp.arith_rewrite_conv(@list.empty()), t1247), t1248), t1249)
  let t1250 = @parser.parse_term("sum(0,i) f")
  let sum_thm = sum_expand_conv(@kernel.vsubst(@list.List([(n, @parser.parse_term("i:num"))]), t1250))
  let t1251 = @parser.parse_term("0 <| i")
  let gt_thm = @int.arith_rule(@kernel.vsubst(@list.List([(n, @parser.parse_term("i:num"))]), t1251))
  let t1252 = @drule.match_mp(pi_ser())(gt_thm)
  let t1253 = @equal.beta_rule(@simp.rewrite_rule(@list.List([sum_thm, pi_fun(), inv_twopow()]))(t1252))
  @equal.conv_rule(@num_calc_simp.arith_rewrite_conv(@list.empty()), t1253)
}

///|
/// `recompute_pi`
pub fn recompute_pi(x1254 : Int64) -> @kernel.Thm raise {
  let bprec = x1254
  let n = @lib.div63(bprec, 4L)
  let pi_ser_1 = pi_sern(@nums.mk_numeral(@num.num_of_int64(n)))
  let _ = @float.remove_real_constant(@parser.parse_term("pi"))
  @float.add_real_constant(pi_ser_1)
  @float.interval_of_term(bprec, @parser.parse_term("pi"))
}

