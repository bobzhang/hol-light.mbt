      #|  !(l1:A list) (l2:B list).\n    LENGTH l1 = LENGTH l2 ==> MAP SND (ZIP l1 l2) = l2
      #|  !(l1:A list) (l2:B list).\n    LENGTH l1 = LENGTH l2 ==> LENGTH(ZIP l1 l2) = LENGTH l2
