// Load-fidelity test for lists.ml: replays tools/ocaml_ref/lists_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "lists matches lists.ml" {
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("lists")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("HD", () => sthm(@lists.hd()))
  log.attempt("TL", () => sthm(@lists.tl()))
  log.attempt("APPEND", () => sthm(@lists.append()))
  log.attempt("REVERSE", () => sthm(@lists.reverse()))
  log.attempt("LENGTH", () => sthm(@lists.length()))
  log.attempt("MAP", () => sthm(@lists.map()))
  log.attempt("LAST", () => sthm(@lists.last()))
  log.attempt("BUTLAST", () => sthm(@lists.butlast()))
  log.attempt("REPLICATE", () => sthm(@lists.replicate()))
  log.attempt("NULL", () => sthm(@lists.null()))
  log.attempt("ALL", () => sthm(@lists.all()))
  log.attempt("EX", () => sthm(@lists.ex()))
  log.attempt("ITLIST", () => sthm(@lists.itlist()))
  log.attempt("MEM", () => sthm(@lists.mem()))
  log.attempt("ALL2_DEF", () => sthm(@lists.all2_def()))
  log.attempt("ALL2", () => sthm(@lists.all2()))
  log.attempt("MAP2_DEF", () => sthm(@lists.map2_def()))
  log.attempt("MAP2", () => sthm(@lists.map2()))
  log.attempt("EL", () => sthm(@lists.el()))
  log.attempt("FILTER", () => sthm(@lists.filter()))
  log.attempt("ASSOC", () => sthm(@lists.assoc()))
  log.attempt("ITLIST2_DEF", () => sthm(@lists.itlist2_def()))
  log.attempt("ITLIST2", () => sthm(@lists.itlist2()))
  log.attempt("ZIP_DEF", () => sthm(@lists.zip_def()))
  log.attempt("ZIP", () => sthm(@lists.zip()))
  log.attempt("ALLPAIRS", () => sthm(@lists.allpairs()))
  log.attempt("PAIRWISE", () => sthm(@lists.pairwise()))
  log.attempt("list_of_seq", () => sthm(@lists.list_of_seq()))
  log.attempt("NOT_CONS_NIL", () => sthm(@lists.not_cons_nil()))
  log.attempt("LAST_CLAUSES", () => sthm(@lists.last_clauses()))
  log.attempt("APPEND_NIL", () => sthm(@lists.append_nil()))
  log.attempt("APPEND_ASSOC", () => sthm(@lists.append_assoc()))
  log.attempt("REVERSE_APPEND", () => sthm(@lists.reverse_append()))
  log.attempt("REVERSE_REVERSE", () => sthm(@lists.reverse_reverse()))
  log.attempt("REVERSE_EQ_EMPTY", () => sthm(@lists.reverse_eq_empty()))
  log.attempt("CONS_11", () => sthm(@lists.cons_11()))
  log.attempt("list_CASES", () => sthm(@lists.list_cases()))
  log.attempt("LIST_EQ", () => sthm(@lists.list_eq()))
  log.attempt("LENGTH_APPEND", () => sthm(@lists.length_append()))
  log.attempt("MAP_APPEND", () => sthm(@lists.map_append()))
  log.attempt("LENGTH_MAP", () => sthm(@lists.length_map()))
  log.attempt("LENGTH_EQ_NIL", () => sthm(@lists.length_eq_nil()))
  log.attempt("LENGTH_EQ_CONS", () => sthm(@lists.length_eq_cons()))
  log.attempt("LENGTH_REVERSE", () => sthm(@lists.length_reverse()))
  log.attempt("MAP_o", () => sthm(@lists.map_o()))
  log.attempt("MAP_EQ", () => sthm(@lists.map_eq()))
  log.attempt("ALL_IMP", () => sthm(@lists.all_imp()))
  log.attempt("NOT_EX", () => sthm(@lists.not_ex()))
  log.attempt("NOT_ALL", () => sthm(@lists.not_all()))
  log.attempt("ALL_MAP", () => sthm(@lists.all_map()))
  log.attempt("ALL_EQ", () => sthm(@lists.all_eq()))
  log.attempt("ALL_T", () => sthm(@lists.all_t()))
  log.attempt("MAP_EQ_ALL2", () => sthm(@lists.map_eq_all2()))
  log.attempt("ALL2_MAP", () => sthm(@lists.all2_map()))
  log.attempt("MAP_EQ_DEGEN", () => sthm(@lists.map_eq_degen()))
  log.attempt("ALL2_AND_RIGHT", () => sthm(@lists.all2_and_right()))
  log.attempt("ITLIST_APPEND", () => sthm(@lists.itlist_append()))
  log.attempt("ITLIST_EXTRA", () => sthm(@lists.itlist_extra()))
  log.attempt("ALL_MP", () => sthm(@lists.all_mp()))
  log.attempt("AND_ALL", () => sthm(@lists.and_all()))
  log.attempt("EX_IMP", () => sthm(@lists.ex_imp()))
  log.attempt("ALL_MEM", () => sthm(@lists.all_mem()))
  log.attempt("LENGTH_REPLICATE", () => sthm(@lists.length_replicate()))
  log.attempt("MEM_REPLICATE", () => sthm(@lists.mem_replicate()))
  log.attempt("EX_MAP", () => sthm(@lists.ex_map()))
  log.attempt("EXISTS_EX", () => sthm(@lists.exists_ex()))
  log.attempt("FORALL_ALL", () => sthm(@lists.forall_all()))
  log.attempt("MEM_APPEND", () => sthm(@lists.mem_append()))
  log.attempt("MEM_MAP", () => sthm(@lists.mem_map()))
  log.attempt("FILTER_APPEND", () => sthm(@lists.filter_append()))
  log.attempt("FILTER_MAP", () => sthm(@lists.filter_map()))
  log.attempt("MEM_FILTER", () => sthm(@lists.mem_filter()))
  log.attempt("LENGTH_FILTER", () => sthm(@lists.length_filter()))
  log.attempt("EX_MEM", () => sthm(@lists.ex_mem()))
  log.attempt("MAP_FST_ZIP", () => sthm(@lists.map_fst_zip()))
  log.attempt("MAP_SND_ZIP", () => sthm(@lists.map_snd_zip()))
  log.attempt("LENGTH_ZIP", () => sthm(@lists.length_zip()))
  log.attempt("MEM_ASSOC", () => sthm(@lists.mem_assoc()))
  log.attempt("ALL_APPEND", () => sthm(@lists.all_append()))
  log.attempt("MEM_EL", () => sthm(@lists.mem_el()))
  log.attempt("MEM_EXISTS_EL", () => sthm(@lists.mem_exists_el()))
  log.attempt("ALL_EL", () => sthm(@lists.all_el()))
  log.attempt("ALL2_MAP2", () => sthm(@lists.all2_map2()))
  log.attempt("AND_ALL2", () => sthm(@lists.and_all2()))
  log.attempt("ALLPAIRS_SYM", () => sthm(@lists.allpairs_sym()))
  log.attempt("ALLPAIRS_MEM", () => sthm(@lists.allpairs_mem()))
  log.attempt("ALLPAIRS_MAP", () => sthm(@lists.allpairs_map()))
  log.attempt("ALLPAIRS_EQ", () => sthm(@lists.allpairs_eq()))
  log.attempt("ALL2_ALL", () => sthm(@lists.all2_all()))
  log.attempt("APPEND_EQ_NIL", () => sthm(@lists.append_eq_nil()))
  log.attempt("APPEND_LCANCEL", () => sthm(@lists.append_lcancel()))
  log.attempt("APPEND_RCANCEL", () => sthm(@lists.append_rcancel()))
  log.attempt("LENGTH_MAP2", () => sthm(@lists.length_map2()))
  log.attempt("EL_MAP2", () => sthm(@lists.el_map2()))
  log.attempt("MAP_EQ_NIL", () => sthm(@lists.map_eq_nil()))
  log.attempt("INJECTIVE_MAP", () => sthm(@lists.injective_map()))
  log.attempt("SURJECTIVE_MAP", () => sthm(@lists.surjective_map()))
  log.attempt("MAP_ID", () => sthm(@lists.map_id()))
  log.attempt("MAP_I", () => sthm(@lists.map_i()))
  log.attempt("BUTLAST_CLAUSES", () => sthm(@lists.butlast_clauses()))
  log.attempt("BUTLAST_APPEND", () => sthm(@lists.butlast_append()))
  log.attempt("APPEND_BUTLAST_LAST", () => sthm(@lists.append_butlast_last()))
  log.attempt("LAST_APPEND", () => sthm(@lists.last_append()))
  log.attempt("LENGTH_TL", () => sthm(@lists.length_tl()))
  log.attempt("LAST_REVERSE", () => sthm(@lists.last_reverse()))
  log.attempt("HD_REVERSE", () => sthm(@lists.hd_reverse()))
  log.attempt("EL_APPEND", () => sthm(@lists.el_append()))
  log.attempt("EL_TL", () => sthm(@lists.el_tl()))
  log.attempt("EL_CONS", () => sthm(@lists.el_cons()))
  log.attempt("LAST_EL", () => sthm(@lists.last_el()))
  log.attempt("HD_APPEND", () => sthm(@lists.hd_append()))
  log.attempt("CONS_HD_TL", () => sthm(@lists.cons_hd_tl()))
  log.attempt("EL_MAP", () => sthm(@lists.el_map()))
  log.attempt("MAP_REVERSE", () => sthm(@lists.map_reverse()))
  log.attempt("ALL_FILTER", () => sthm(@lists.all_filter()))
  log.attempt("APPEND_SING", () => sthm(@lists.append_sing()))
  log.attempt("MEM_APPEND_DECOMPOSE_LEFT", () => {
    sthm(@lists.mem_append_decompose_left())
  })
  log.attempt("MEM_APPEND_DECOMPOSE", () => sthm(@lists.mem_append_decompose()))
  log.attempt("PAIRWISE_APPEND", () => sthm(@lists.pairwise_append()))
  log.attempt("PAIRWISE_MAP", () => sthm(@lists.pairwise_map()))
  log.attempt("PAIRWISE_IMPLIES", () => sthm(@lists.pairwise_implies()))
  log.attempt("PAIRWISE_TRANSITIVE", () => sthm(@lists.pairwise_transitive()))
  log.attempt("LENGTH_LIST_OF_SEQ", () => sthm(@lists.length_list_of_seq()))
  log.attempt("EL_LIST_OF_SEQ", () => sthm(@lists.el_list_of_seq()))
  log.attempt("LIST_OF_SEQ_EQ_NIL", () => sthm(@lists.list_of_seq_eq_nil()))
  log.attempt("LIST_OF_SEQ_EQ_SELF", () => sthm(@lists.list_of_seq_eq_self()))
  log.attempt("LENGTH_EQ_LIST_OF_SEQ", () => {
    sthm(@lists.length_eq_list_of_seq())
  })
  log.attempt("MAP_LIST_OF_SEQ", () => sthm(@lists.map_list_of_seq()))
  log.attempt("LIST_OF_SEQ", () => sthm(@lists.list_of_seq_v1()))
  log.attempt("MONO_ALL", () => sthm(@lists.mono_all()))
  log.attempt("MONO_ALL2", () => sthm(@lists.mono_all2()))
  log.attempt("char_INDUCT", () => sthm(@lists.char_induct()))
  log.attempt("char_RECURSION", () => sthm(@lists.char_recursion()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  @testkit.check_axioms()
  inspect(
    log.contents(),
    content=(
