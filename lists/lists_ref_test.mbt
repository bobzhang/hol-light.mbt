      #|  !l:A list.\n        ALL R l /\\ (!x. R x ==> (P x <=> Q x)) ==> (ALL P l <=> ALL Q l)
      #|  !l:A list. ALL (\\x. T) l
      #|  !(f:A->B) l m. ALL2 (\\x y. f x = f y) l m ==> MAP f l = MAP f m
