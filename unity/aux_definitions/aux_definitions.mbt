/// CONTRAPOS
fn step_4() -> Unit raise {
  let a = @parser.parse_term("a:bool")
  let b = @parser.parse_term("b:bool")
  let pth = @itab.itaut(@parser.parse_term("(a ==> b) ==> (~b ==> ~a)"))
  contrapos_c.set(fn(x27 : @kernel.Thm) -> @kernel.Thm raise {
    let th = x27
    try {
      let (p, q) = @basics.dest_imp(@kernel.concl(th))
      @bool.mp(@kernel.inst_rule(@list.List([(p, a), (q, b)]), pth), th)
    } catch {
      Failure(_) => raise Failure("CONTRAPOS")
      e => raise e
    }
  })
}

