        let (r, _) = x63
        !@kernel.is_var(r)
      }, defg)
      let eqs = @lib.map(fn(x64 : (@kernel.Term, @kernel.Term)) -> @kernel.Term raise {
        let (r_1, l_1) = x64
        @bool.mk_iff(l_1, r_1)
      }, mdefs)
      let clausify : (@kernel.Term) -> ((@list.List[(@kernel.Term, @kernel.Thm)]) -> @list.List[(@kernel.Term, @kernel.Thm)] raise) raise = fn(x65 : @kernel.Term) -> ((@list.List[(@kernel.Term, @kernel.Thm)]) -> @list.List[(@kernel.Term, @kernel.Thm)] raise) raise {
        let eq = x65
        fn(x66 : @list.List[(@kernel.Term, @kernel.Thm)]) -> @list.List[(@kernel.Term, @kernel.Thm)] raise {
          let cls = x66
          let fvs = @kernel.frees(eq)
          let eth = @equal.thenc(@canon.nnfc_conv, @canon.cnf_conv)(eq)
          let tth = @kernel.inst_rule(@lib.map(fn(x67 : @kernel.Term) -> (@kernel.Term, @kernel.Term) raise {
            let v = x67
            (@lib.apply(lfn_1, v), v)
          }, fvs), eth)
          let xth = @bool.add_assum(stm_1, @kernel.eq_mp(tth, @kernel.refl(@lib.apply(lfn_1, @equal.lhand(eq)))))
          let t68 = @bool.conjuncts_rule(xth)
          @lib.zip(@basics.conjuncts(@kernel.rand(@kernel.concl(eth))), t68).concat(cls)
        }
      }
      let all_clauses = @lib.itlist(fn(x69 : @kernel.Term, x70 : @list.List[(@kernel.Term, @kernel.Thm)]) -> @list.List[(@kernel.Term, @kernel.Thm)] raise {
        let s71 = clausify(x69)
        s71(x70)
      }, eqs, tops)
      let mcth_1 = @lib.itlist(fn(x72 : (@kernel.Term, @kernel.Thm), x73 : @omap.T[@kernel.Term, @kernel.Thm]) -> @omap.T[@kernel.Term, @kernel.Thm] raise {
        let (c, th_3) = x72
        let m = x73
        @sat_common_tools.add(c, th_3, m)
      }, all_clauses, @sat_common_tools.empty())
      let vc_1 = @lib.add63(n, 1L)
      let rcv_1 = @lib.array_of_list(@lib.map(fn(x74 : (@kernel.Term, @kernel.Thm)) -> @kernel.Term raise {
        x74.0
      }, all_clauses))
      let ntdcnf = @bool.list_mk_conj(@lib.map(fn(x75 : (@kernel.Term, @kernel.Thm)) -> @kernel.Term raise {
        x75.0
      }, all_clauses))
      let th_4 = invoke_minisat(lfn_1)(mcth_1)(stm_1)(ntdcnf)(rcv_1)(vc_1)
      if !(sat_debugging().val) {
        cleanup(@dimacs_tools.tmp_name().val, solvername)
      } else {
        ()
      }
      if @basics.is_imp(@kernel.concl(th_4)) {
        let t76 = @equal.sym(sth_1)
        raise Sat_counterexample::Sat_counterexample(@kernel.eq_mp(@equal.ap_term(@kernel.rator(@kernel.concl(th_4)), t76), th_4))
      } else {
        main_rule(tm)(stm_1)(sth_1)(th_4)
      }
    }
  }
  fn(x77 : @kernel.Term) -> @kernel.Thm raise {
    let tm_1 = x77
    if (@kernel.type_of(tm_1) != @kernel.bool_ty) {
      raise Failure("GEN_SAT_PROVE")
    } else {
      let pats = @lib.filter(fn(x80 : @kernel.Term) -> Bool raise {
        (fn(x78 : Bool) -> Bool raise {
          !x78
        })((fn(x79 : @kernel.Term) -> Bool raise {
          @kernel.is_var(x79)
        })(x80))
      }, @basics.atoms(tm_1))
      let bvs = @lib.map(fn(x83 : @kernel.Term) -> @kernel.Term raise {
        (fn(x81 : @kernel.HolType) -> @kernel.Term raise {
          @basics.genvar(x81)
        })((fn(x82 : @kernel.Term) -> @kernel.HolType raise {
          @kernel.type_of(x82)
        })(x83))
      }, pats)
      let tm_p = @basics.subst(@lib.zip(bvs, pats), tm_1)
      try {
        let th_p = prop_prove(tm_p)
        let th_5 = @kernel.inst_rule(@lib.zip(pats, bvs), th_p)
        if (@kernel.concl(th_5) == tm_1) {
          th_5
        } else {
          raise Failure("GEN_ZSAT_PROVE")
        }
      } catch {
        Sat_counterexample::Sat_counterexample(cth) => raise Sat_counterexample::Sat_counterexample(@kernel.inst_rule(@lib.zip(pats, bvs), cth))
        e => raise e
      }
    }
  }
}

///|
/// SAT_PROVE
fn step_5() -> Unit raise {
  sat_prove_c.set(gen_sat_prove(@sat_solvers.minisatp(), "minisatp"))
}

///|
let sat_prove_c : @lib.Cell[(@kernel.Term) -> @kernel.Thm raise] = @lib.Cell::new("SAT_PROVE")

///|
/// `SAT_PROVE`
pub fn sat_prove(x : @kernel.Term) -> @kernel.Thm raise {
  (sat_prove_c.get())(x)
}

///|
/// ZSAT_PROVE
fn step_6() -> Unit raise {
  zsat_prove_c.set(gen_sat_prove(@sat_solvers.zchaff(), "zchaff"))
}

///|
let zsat_prove_c : @lib.Cell[(@kernel.Term) -> @kernel.Thm raise] = @lib.Cell::new("ZSAT_PROVE")

///|
/// `ZSAT_PROVE`
pub fn zsat_prove(x : @kernel.Term) -> @kernel.Thm raise {
  (zsat_prove_c.get())(x)
}

///|
fn load_steps() -> Unit raise {
  step_1()
  step_2()
  step_3()
  step_4()
  step_5()
  step_6()
}
