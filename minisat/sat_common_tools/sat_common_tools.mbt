///|
/// `input_all`
pub fn input_all(x141 : @lib.InChannel) -> String raise {
  let in_ch = x141
  fn loop_(x142 : StringBuilder) -> Unit raise {
    let b = x142
    match (try {
      Some(@lib.input_char(in_ch))
    } catch {
      @lib.EndOfFile => None
      e => raise e
    }) {
      Some(c) => {
        StringBuilder::write_char(b, c)
        loop_(b)
      }
      None => ()
    }
  }
  let b_1 = {
    StringBuilder::new()
  }
  let _ = loop_(b_1)
  StringBuilder::to_string(b_1)
}

