///|
/// `FORALL_IMP_CONV`
pub fn forall_imp_conv(x151 : @kernel.Term) -> @kernel.Thm raise {
  let tm = x151
  let (bvar, bbody) = @basics.dest_forall(tm)
  let (ant, conseq) = @basics.dest_imp(bbody)
  let fant = @basics.free_in(bvar, ant)
  let fconseq = @basics.free_in(bvar, conseq)
  let ant_thm = @kernel.assume_rule(ant)
  let tm_thm = @kernel.assume_rule(tm)
  if (fant && fconseq) {
    raise Failure(("FORALL_IMP_CONV" + ("`" + (@kernel.dest_var(bvar).0 + "` free on both sides of `==>`"))))
  } else {
    if fant {
      let asm_ = @bool.mk_exists(bvar, ant)
      let t152 = @bool.undisch(@bool.spec(bvar, tm_thm))
      let th1 = @bool.choose_rule(bvar, @kernel.assume_rule(asm_), t152)
      let imp1 = @bool.disch(tm, @bool.disch(asm_, th1))
      let cncl = @kernel.rand(@kernel.concl(imp1))
      let t153 = @bool.exists_rule(asm_, bvar, ant_thm)
      let th2 = @bool.mp(@kernel.assume_rule(cncl), t153)
      let imp2 = @bool.disch(cncl, @bool.gen(bvar, @bool.disch(ant, th2)))
      @bool.imp_antisym_rule(imp1, imp2)
    } else {
      if fconseq {
        let imp1_1 = @bool.disch(ant, @bool.gen(bvar, @bool.undisch(@bool.spec(bvar, tm_thm))))
        let cncl_1 = @kernel.concl(imp1_1)
        let imp2_1 = @bool.gen(bvar, @bool.disch(ant, @bool.spec(bvar, @bool.undisch(@kernel.assume_rule(cncl_1)))))
        let t154 = @bool.disch(cncl_1, imp2_1)
        @bool.imp_antisym_rule(@bool.disch(tm, imp1_1), t154)
      } else {
        let asm__1 = @bool.mk_exists(bvar, ant)
        let tmp = @bool.undisch(@bool.spec(bvar, tm_thm))
        let th1_1 = @bool.gen(bvar, @bool.choose_rule(bvar, @kernel.assume_rule(asm__1), tmp))
        let imp1_2 = @bool.disch(tm, @bool.disch(asm__1, th1_1))
        let cncl_2 = @kernel.rand(@kernel.concl(imp1_2))
        let t155 = @bool.exists_rule(asm__1, bvar, ant_thm)
        let th2_1 = @bool.spec(bvar, @bool.mp(@kernel.assume_rule(cncl_2), t155))
        let imp2_2 = @bool.disch(cncl_2, @bool.gen(bvar, @bool.disch(ant, th2_1)))
        @bool.imp_antisym_rule(imp1_2, imp2_2)
      }
    }
  }
}

///|
/// `LEFT_IMP_EXISTS_CONV`
pub fn left_imp_exists_conv(x156 : @kernel.Term) -> @kernel.Thm raise {
  let tm = x156
  let (ant, _) = @basics.dest_imp(tm)
  let (bvar, bdy) = @basics.dest_exists(ant)
  let x_p = @kernel.variant(@kernel.frees(tm), bvar)
  let t_p = @basics.subst(@list.List([(x_p, bvar)]), bdy)
  let t157 = @bool.exists_rule(ant, x_p, @kernel.assume_rule(t_p))
  let th1 = @bool.gen(x_p, @bool.disch(t_p, @bool.mp(@kernel.assume_rule(tm), t157)))
  let rtm = @kernel.concl(th1)
  let t158 = @bool.undisch(@bool.spec(x_p, @kernel.assume_rule(rtm)))
  let th2 = @bool.choose_rule(x_p, @kernel.assume_rule(ant), t158)
  let t159 = @bool.disch(rtm, @bool.disch(ant, th2))
  @bool.imp_antisym_rule(@bool.disch(tm, th1), t159)
}

///|
/// `lrand`
pub fn lrand(x160 : @kernel.Term) -> @kernel.Term raise {
  let x = x160
  @kernel.rand(@kernel.rator(x))
}

///|
/// t_tm
fn step_1() -> Unit raise {
  t_tm_c.set(@parser.parse_term("T"))
}

///|
let t_tm_c : @lib.Cell[@kernel.Term] = @lib.Cell::new("t_tm")

///|
/// `t_tm`
pub fn t_tm() -> @kernel.Term {
  t_tm_c.get()
}

///|
/// f_tm
fn step_2() -> Unit raise {
  f_tm_c.set(@parser.parse_term("F"))
}

///|
let f_tm_c : @lib.Cell[@kernel.Term] = @lib.Cell::new("f_tm")

///|
/// `f_tm`
pub fn f_tm() -> @kernel.Term {
  f_tm_c.get()
}

///|
/// `is_T`
pub fn is_t(x161 : @kernel.Term) -> Bool raise {
  let tm = x161
  (tm == t_tm())
}

///|
/// `is_F`
pub fn is_f(x162 : @kernel.Term) -> Bool raise {
  let tm = x162
  (tm == f_tm())
}

///|
/// `ERC`
pub fn erc(x163 : @kernel.Term, x164 : @kernel.Term) -> @list.List[(@kernel.Term, @kernel.Term)] raise {
  let lt = x163
  let tm = x164
  if @kernel.is_comb(lt) {
    let ((ltl, ltr), (tml, tmr)) = pair_map(@kernel.dest_comb, (lt, tm))
    let t165 = erc(ltr, tmr)
    erc(ltl, tml).concat(t165)
  } else {
    if @kernel.is_var(lt) {
      @list.List([(tm, lt)])
    } else {
      @list.empty()
    }
  }
}

///|
/// `EREWR_CONV`
pub fn erewr_conv(x166 : @kernel.Thm, x167 : @kernel.Term) -> @kernel.Thm raise {
  let th = x166
  let tm = x167
  let lt = @equal.lhs(@kernel.concl(th))
  let il = erc(lt, tm)
  @kernel.inst_rule(il, th)
}

///|
fn load_steps() -> Unit raise {
  step_1()
  step_2()
}
