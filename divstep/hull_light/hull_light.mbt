  let t8389 = note(@term_syntax.parse_term("(real_of_num(1) - (t : Real)) * ((a : Real) * (x0 : Real) + (b : Real) * (y0 : Real)) <= (real_of_num(1) - t) * (c : Real)"), @list.List([@real.real_le_lmul()]))
