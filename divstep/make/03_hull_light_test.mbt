// Divstep/hull_light.ml in its directory's load order: the test block of
// divstep/hull_light/hull_light_ref_test.mbt (tools/ocaml_ref/chain_test.py), with the same golden
// (tools/ocaml_ref/Divstep_hull_light_ref.expected).

///|
test "Divstep/hull_light matches Divstep/hull_light.ml" {
  @testkit.release_output()
  @hull_light.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "Library/iter", "Library/integer", "Library/floor", "Divstep/divstep",
      "Divstep/idivstep", "Divstep/hull_light",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Divstep/hull_light")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("int_neg_as_minusnum1", () => {
    sthm(@hull_light.int_neg_as_minusnum1())
  })
  log.attempt("real_lt_ldiv", () => sthm(@hull_light.real_lt_ldiv()))
  log.attempt("real_lt_rdiv_one_extra", () => {
    sthm(@hull_light.real_lt_rdiv_one_extra())
  })
  log.attempt("real_lt_extra2", () => sthm(@hull_light.real_lt_extra2()))
  log.attempt("generic_1_Ppos", () => sthm(@hull_light.generic_1_ppos()))
  log.attempt("generic_1_P0", () => sthm(@hull_light.generic_1_p0()))
  log.attempt("generic_2", () => sthm(@hull_light.generic_2()))
  log.attempt("divsteps_s_definition", () => {
    sthm(@hull_light.divsteps_s_definition())
  })
  log.attempt("divsteps_s", () => sthm(@hull_light.divsteps_s()))
  log.attempt("REAL_LE_RDIV", () => sthm(@hull_light.real_le_rdiv()))
  log.attempt("divsteps_hinit_0_1", () => sthm(@hull_light.divsteps_hinit_0_1()))
  log.attempt("divsteps_H0", () => sthm(@hull_light.divsteps_h0()))
  log.attempt("divsteps_H1", () => sthm(@hull_light.divsteps_h1()))
  log.attempt("init2stable", () => sthm(@hull_light.init2stable()))
  log.attempt("init2stable_simple", () => sthm(@hull_light.init2stable_simple()))
  log.attempt("h1_contains0", () => sthm(@hull_light.h1_contains0()))
  log.attempt("theorem0", () => sthm(@hull_light.theorem0()))
  log.attempt("theorem1", () => sthm(@hull_light.theorem1()))
  log.attempt("theorem3", () => sthm(@hull_light.theorem3()))
  log.attempt("theorem5", () => sthm(@hull_light.theorem5()))
  log.attempt("theorem_2", () => sthm(@hull_light.theorem_2()))
  log.attempt("theorem_1", () => sthm(@hull_light.theorem_1()))
  log.attempt("theorem_4scale", () => sthm(@hull_light.theorem_4scale()))
  log.attempt("theorem_3scale", () => sthm(@hull_light.theorem_3scale()))
  log.attempt("ineq_convex", () => sthm(@hull_light.ineq_convex()))
  log.attempt("h1_convex", () => sthm(@hull_light.h1_convex()))
  log.attempt("h1_convex_horizontal", () => {
    sthm(@hull_light.h1_convex_horizontal())
  })
  log.attempt("h1_shrink", () => sthm(@hull_light.h1_shrink()))
  log.attempt("h1_shrink32", () => sthm(@hull_light.h1_shrink32()))
  log.attempt("unscale_4", () => sthm(@hull_light.unscale_4()))
  log.attempt("unscale_3", () => sthm(@hull_light.unscale_3()))
  log.attempt("h1_16_lemma1", () => sthm(@hull_light.h1_16_lemma1()))
  log.attempt("h1_16_lemma1neg", () => sthm(@hull_light.h1_16_lemma1neg()))
  log.attempt("h1_16_lemma2", () => sthm(@hull_light.h1_16_lemma2()))
  log.attempt("h1_16_lemma2neg", () => sthm(@hull_light.h1_16_lemma2neg()))
  log.attempt("h1_16_lemma3", () => sthm(@hull_light.h1_16_lemma3()))
  log.attempt("h1_16_lemma3neg", () => sthm(@hull_light.h1_16_lemma3neg()))
  log.attempt("divsteps_W", () => sthm(@hull_light.divsteps_w()))
  log.attempt("w_transition0", () => sthm(@hull_light.w_transition0()))
  log.attempt("w_transition1", () => sthm(@hull_light.w_transition1()))
  log.attempt("divsteps_Houter", () => sthm(@hull_light.divsteps_houter()))
  log.attempt("theoremouter", () => sthm(@hull_light.theoremouter()))
  log.attempt("theoremouter_simple", () => {
    sthm(@hull_light.theoremouter_simple())
  })
  log.attempt("latticetheorem", () => sthm(@hull_light.latticetheorem()))
  log.attempt("iteration_stability", () => {
    sthm(@hull_light.iteration_stability())
  })
  log.attempt("iteration_sizebound", () => {
    sthm(@hull_light.iteration_sizebound())
  })
  log.attempt("iteration_sizebound_simple", () => {
    sthm(@hull_light.iteration_sizebound_simple())
  })
  log.attempt("upow_bound", () => sthm(@hull_light.upow_bound()))
  log.attempt("spow_bound", () => sthm(@hull_light.spow_bound()))
  log.attempt("endtoend", () => sthm(@hull_light.endtoend()))
  log.attempt("endtoend_simple", () => sthm(@hull_light.endtoend_simple()))
  log.attempt("endtoend_bits_simple", () => {
    sthm(@hull_light.endtoend_bits_simple())
  })
  log.attempt("endtoend_255_simple", () => {
    sthm(@hull_light.endtoend_255_simple())
  })
  log.attempt("endtoend_256_simple", () => {
    sthm(@hull_light.endtoend_256_simple())
  })
  log.attempt("endtoend_512_simple", () => {
    sthm(@hull_light.endtoend_512_simple())
  })
  log.attempt("endtoend_16384_simple", () => {
    sthm(@hull_light.endtoend_16384_simple())
  })
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.probe_counters()
  @testkit.check_axioms()
  inspect(
    @testkit.normalize_times(log.contents()),
    content=(
