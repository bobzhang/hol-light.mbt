///|
/// `expInt`
pub fn expint(x3313 : Int, x3314 : Int) -> Int? raise {
  let x = x3313
  let y = x3314
  if y <= 1 {
    if y == 0 {
      Some(1)
    } else if y == 1 {
      Some(x)
    } else {
      raise Bug::Bug("expInt: negative exponent")
    }
  } else if x <= 1 {
    if 0 <= x {
      Some(x)
    } else {
      raise Bug::Bug("expInt: negative exponand")
    }
  } else {
    iexp(x, y, 1)
  }
}

