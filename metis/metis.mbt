  let (n1, q1_1) = x4001
  let (n2, q2_1) = x4002
  let qs_1 = x4003
  let c = compare_v15(n1, n2)
  if c != 0 {
    c
  } else {
    cmp(@lib.zip(q1_1, q2_1).concat(qs_1))
  }
}

