      Term::Fn((f, tms)) => {
        let (tms_1, xs) = @lib.unzip(@lib.map(modeltm, tms))
        let t3952 = interpretfunction(vm, (f, xs))
        (ModelTerm::Model_fn(f, tms_1, xs), t3952)
      }
    }
  }
  modeltm
}

///|
