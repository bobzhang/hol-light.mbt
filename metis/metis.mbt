  let lit = x3007
  let path = x3008
  let t = x3009
  let s = subterm_v2(lit, path)
  let lit_p = replace_v2(lit, (path, t))
  let eqlit = mkneq_v1((s, t))
  let cl = fromlist_v15(@list.List([eqlit, negate(lit.0, lit.1), lit_p]))
  Thm::Thm(cl, (InferenceType::Equality, @list.empty()))
