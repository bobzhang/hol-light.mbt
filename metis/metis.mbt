}

///|
/// `readIterator`
pub fn[TA, TB] readiterator(x281 : Iterator[TA, TB]) -> (TA, TB) raise {
  let iter = x281
  match iter {
    Iterator::Left_to_right_iterator(key_value, _, _) => key_value
    Iterator::Right_to_left_iterator(key_value_1, _, _) => key_value_1
  }
}

///|
/// `advanceIterator`
pub fn[TA, TB] advanceiterator(
  x282 : Iterator[TA, TB],
) -> Iterator[TA, TB]? raise {
  let iter = x282
  match iter {
    Iterator::Left_to_right_iterator(_, tree, nodes) =>
      addlefttorightiterator(nodes, tree)
    Iterator::Right_to_left_iterator(_, tree_1, nodes_1) =>
      addrighttoleftiterator(nodes_1, tree_1)
  }
}

///|
/// `foldIterator`
pub fn[TA, TB, TC] folditerator(
  x283 : ((TB, TC, TA)) -> TA raise,
  x284 : TA,
  x285 : Iterator[TB, TC]?,
) -> TA raise {
  let f = x283
  let acc = x284
  let io = x285
  match io {
    None => acc
    Some(iter) => {
      let (key, value_1) = readiterator(iter)
      let t286 = advanceiterator(iter)
      folditerator(f, f((key, value_1, acc)), t286)
    }
  }
}

///|
/// `findIterator`
pub fn[TA, TB] finditerator(
  x287 : ((TA, TB)) -> Bool raise,
  x288 : Iterator[TA, TB]?,
) -> (TA, TB)? raise {
  let pred = x287
  let io = x288
  match io {
    None => None
    Some(iter) => {
      let key_value = readiterator(iter)
      if pred(key_value) {
        Some(key_value)
      } else {
        finditerator(pred, advanceiterator(iter))
      }
    }
  }
}

///|
/// `firstIterator`
pub fn[TA, TB, TC] firstiterator(
  x289 : ((TB, TC)) -> TA? raise,
  x290 : Iterator[TB, TC]?,
) -> TA? raise {
  let f = x289
  let io = x290
  match io {
    None => None
    Some(iter) => {
      let key_value = readiterator(iter)
      match f(key_value) {
        None => firstiterator(f, advanceiterator(iter))
        s => s
      }
    }
  }
}

///|
/// `compareIterator`
pub fn[TA, TB, TC, TD] compareiterator(
  x291 : (TB) -> ((TA) -> Int raise) raise,
  x292 : (TD) -> ((TC) -> Int raise) raise,
  x293 : Iterator[TB, TD]?,
  x294 : Iterator[TA, TC]?,
) -> Int raise {
  let comparekey = x291
  let comparevalue = x292
  let io1 = x293
  let io2 = x294
  match (io1, io2) {
    (None, None) => 0
    (None, Some(_)) => -1
    (Some(_), None) => 1
    (Some(i1), Some(i2)) => {
      let (k1, v1) = readiterator(i1)
      let (k2, v2) = readiterator(i2)
      let c = comparekey(k1)(k2)
      if c != 0 {
        c
      } else {
        let c_1 = comparevalue(v1)(v2)
        if c_1 != 0 {
          c_1
        } else {
          let io1_1 = advanceiterator(i1)
          let io2_1 = advanceiterator(i2)
          compareiterator(comparekey, comparevalue, io1_1, io2_1)
        }
      }
    }
  }
}

///|
/// `equalIterator`
pub fn[TA, TB, TC, TD] equaliterator(
  x295 : (TB) -> ((TA) -> Bool raise) raise,
  x296 : (TD) -> ((TC) -> Bool raise) raise,
  x297 : Iterator[TB, TD]?,
  x298 : Iterator[TA, TC]?,
) -> Bool raise {
  let equalkey_1 = x295
  let equalvalue = x296
  let io1 = x297
  let io2 = x298
  match (io1, io2) {
    (None, None) => true
    (None, Some(_)) => false
    (Some(_), None) => false
    (Some(i1), Some(i2)) => {
      let (k1, v1) = readiterator(i1)
      let (k2, v2) = readiterator(i2)
      equalkey_1(k1)(k2) &&
      (if equalvalue(v1)(v2) {
        let io1_1 = advanceiterator(i1)
        let io2_1 = advanceiterator(i2)
        equaliterator(equalkey_1, equalvalue, io1_1, io2_1)
      } else {
        false
      })
    }
  }
}

