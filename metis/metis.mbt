///|
/// `demote`
pub fn demote(x2169 : Formula) -> Term raise {
  match x2169 {
    Formula::True => Term::Fn((truthname(), @list.empty()))
    Formula::False => Term::Fn((falsityname(), @list.empty()))
    Formula::Atom((p, tms)) => Term::Fn((p, tms))
    Formula::Not(p_1) => {
      let s = "~"
      let t2170 = @list.List([demote(p_1)])
      Term::Fn((fromstring(s), t2170))
    }
    Formula::And(p_2, q) => {
      let t2171 = demote(q)
      Term::Fn((conjunctionname(), @list.List([demote(p_2), t2171])))
    }
    Formula::Or(p_3, q_1) => {
      let t2172 = demote(q_1)
      Term::Fn((disjunctionname(), @list.List([demote(p_3), t2172])))
    }
    Formula::Imp(p_4, q_2) => {
      let t2173 = demote(q_2)
      Term::Fn((implicationname(), @list.List([demote(p_4), t2173])))
    }
    Formula::Iff(p_5, q_3) => {
      let t2174 = demote(q_3)
      Term::Fn((equivalencename(), @list.List([demote(p_5), t2174])))
    }
    Formula::Forall(v, b) => {
      let t2175 = demote(b)
      Term::Fn((universalname(), @list.List([Term::Var(v), t2175])))
    }
    Formula::Exists(v_1, b_1) => {
      let t2176 = demote(b_1)
      Term::Fn((existentialname(), @list.List([Term::Var(v_1), t2176])))
    }
  }
}

