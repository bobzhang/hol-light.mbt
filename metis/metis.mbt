pub fn rewrite_v1(x4698 : Rewrite, x4699 : Clause1) -> Clause1 raise {
  let rewr = x4698
  match x4699 {
    Clause1::Clause({ parameters, id: id_1, thm: thm_1, .. }) => {
      let simp : (Thm) -> Thm raise = fn(x4700 : Thm) -> Thm raise {
        let th = x4700
        match parameters {
          { ordering, .. } => {
            let cmp_1 : (Term) -> ((Term) -> Int? raise) raise = compare_v44(
              ordering,
            )
            rewriteidrule(rewr)(cmp_1)(id_1)(th)
          }
          _ => raise @lib.MatchFailure("tscript.ml:8066")
        }
      }
      let thm_3 = match peek_v11(rewr)(id_1) {
        None => simp(thm_1)
        Some(((_, thm_2), _)) =>
          if isreduced(rewr) {
            thm_2
          } else {
            simp(thm_2)
          }
      }
      let result = Clause1::Clause(ClauseInfo::{
        parameters,
        id: id_1,
        thm: thm_3,
