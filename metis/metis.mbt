          Thm::Thm(cl2, _) as th2 => {
            let cl1_p = delete_v14(cl1, lit)
            let cl2_p = delete_v14(cl2, negate(lit.0, lit.1))
            Thm::Thm(
              union_v30(cl1_p)(cl2_p),
              (InferenceType::Resolve, @list.List([th1, th2])),
            )
          }
        }
      }
  }
}

