  let interpret = (x3900 : Valuation, x3901 : Formula) => {
    interpret_l(vm, vn, x3900, x3901)
  }
  let interpret_p = (
    x3903 : Valuation,
    x3904 : Formula,
    x3905 : String,
    x3906 : Int,
  ) => interpret_p_l(vm, vn, x3903, x3904, x3905, x3906)
  let vv = x3900
  let fm = x3901
  match fm {
    Formula::True => true
    Formula::False => false
    Formula::Atom(atm) => interpretatom(vm, vv, atm)
    Formula::Not(p) => !interpret(vv, p)
    Formula::Or(p_1, q) => interpret(vv, p_1) || interpret(vv, q)
    Formula::And(p_2, q_1) => interpret(vv, p_2) && interpret(vv, q_1)
    Formula::Imp(p_3, q_2) => interpret(vv, Formula::Or(Formula::Not(p_3), q_2))
    Formula::Iff(p_4, q_3) => {
      let t3902 = interpret(vv, q_3)
      interpret(vv, p_4) == t3902
    }
    Formula::Forall(v, p_5) => interpret_p(vv, p_5, v, vn)
    Formula::Exists(v_1, p_6) =>
      interpret(vv, Formula::Not(Formula::Forall(v_1, Formula::Not(p_6))))
  }
}

///|
fn interpret_p_l(
  vm : Model,
  vn : Int,
  x3903 : Valuation,
  x3904 : Formula,
  x3905 : String,
  x3906 : Int,
) -> Bool raise {
