}

///|
/// `split`
pub fn split_v11(
  x2183 : @list.List[Formula],
  x2184 : Bool,
  x2185 : Formula,
) -> @list.List[Formula] raise {
  let asms = x2183
  let pol = x2184
  let fm = x2185
  match (pol, fm) {
    (true, Formula::True) => @list.empty()
    (true, Formula::Not(f)) => split_v11(asms, false, f)
    (true, Formula::And(f1, f2)) => {
      let t2186 = split_v11(asms.prepend(f1), true, f2)
      split_v11(asms, true, f1).concat(t2186)
    }
    (true, Formula::Or(f1_1, f2_1)) =>
      split_v11(asms.prepend(Formula::Not(f1_1)), true, f2_1)
    (true, Formula::Imp(f1_2, f2_2)) =>
      split_v11(asms.prepend(f1_2), true, f2_2)
    (true, Formula::Iff(f1_3, f2_3)) => {
      let t2187 = split_v11(asms.prepend(f2_3), true, f1_3)
      split_v11(asms.prepend(f1_3), true, f2_3).concat(t2187)
    }
    (true, Formula::Forall(v, f_1)) =>
      @lib.map(
        (x2188 : Formula) => add_var_asms(asms, v, x2188),
        split_v11(@list.empty(), true, f_1),
      )
    (false, Formula::False) => @list.empty()
    (false, Formula::Not(f_2)) => split_v11(asms, true, f_2)
    (false, Formula::And(f1_4, f2_4)) =>
      split_v11(asms.prepend(f1_4), false, f2_4)
    (false, Formula::Or(f1_5, f2_5)) => {
      let t2189 = split_v11(asms.prepend(Formula::Not(f1_5)), false, f2_5)
      split_v11(asms, false, f1_5).concat(t2189)
    }
    (false, Formula::Imp(f1_6, f2_6)) => {
      let t2190 = split_v11(asms.prepend(f1_6), false, f2_6)
      split_v11(asms, true, f1_6).concat(t2190)
    }
    (false, Formula::Iff(f1_7, f2_7)) => {
      let t2191 = split_v11(asms.prepend(Formula::Not(f2_7)), true, f1_7)
      split_v11(asms.prepend(f1_7), false, f2_7).concat(t2191)
    }
    (false, Formula::Exists(v_1, f_3)) =>
      @lib.map(
        (x2192 : Formula) => add_var_asms(asms, v_1, x2192),
        split_v11(@list.empty(), false, f_3),
      )
    _ => @list.List([add_asms(asms, if pol { fm } else { Formula::Not(fm) })])
  }
}

