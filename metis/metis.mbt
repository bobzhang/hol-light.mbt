///|
/// `compare`
pub fn compare_v20(x1453 : Term, x1454 : Term) -> Int raise {
  let tm1 = x1453
  let tm2 = x1454
  fn cmp(x1455 : (@list.List[Term], @list.List[Term])) -> Int raise {
    match x1455 {
      (Empty, Empty) => 0
      (More(tm1_1, tail=tms1), More(tm2_1, tail=tms2)) =>
        if physical_equal(tm1_1, tm2_1) {
          cmp((tms1, tms2))
        } else {
          match (tm1_1, tm2_1) {
            (Term::Var(v1), Term::Var(v2)) => {
              let c = compare_v10(v1)(v2)
              if c != 0 {
                c
              } else {
                cmp((tms1, tms2))
              }
            }
            (Term::Var(_), Term::Fn(_)) => -1
            (Term::Fn(_), Term::Var(_)) => 1
            (Term::Fn((f1, a1)), Term::Fn((f2, a2))) => {
              let c_1 = compare_v10(f1)(f2)
              if c_1 != 0 {
                c_1
              } else {
                let t1456 = @lib.length(a2)
                let c_2 = intcompare(@lib.length(a1), t1456)
                if c_2 != 0 {
                  c_2
                } else {
                  cmp((a1.concat(tms1), a2.concat(tms2)))
                }
              }
            }
          }
        }
      _ => raise Bug::Bug("Term.compare")
    }
  }
  cmp((@list.List([tm1]), @list.List([tm2])))
}

///|
/// `equal`
pub fn equal_v14(x1457 : Term, x1458 : Term) -> Bool raise {
  let tm1 = x1457
  let tm2 = x1458
  compare_v20(tm1, tm2) == 0
}

