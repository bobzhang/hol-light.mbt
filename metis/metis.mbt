      match ort {
        None => {
          let known_1 = delete_v2(known, id)
          let rw_1 = Rewrite::Rewrite(RewriteT::{
            order,
            known: known_1,
            redexes: redexes_1,
            subterms: subterms_1,
            waiting,
          })
          (rpl_1, spl_1, todo, rw_1, changed_1)
        }
        Some(ort_1) => {
          let todo_1 = if !newx && same_redexes {
            todo
          } else {
            let t4564 = redexresidues(ort_1, eq)
            findreducibles(order, known, subterms_1, id)(todo)(t4564)
