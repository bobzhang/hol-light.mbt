///|
/// `check`
pub fn[TA] check(
  x3916 : (Model) -> ((Valuation) -> ((TA) -> Bool raise) raise) raise,
  x3917 : Int?,
  x3918 : Model,
  x3919 : @oset.T[String],
  x3920 : TA,
) -> (Int, Int) raise {
  let interpret = x3916
  let maxchecks = x3917
  let vm = x3918
  let fv = x3919
  let x = x3920
  let vn = msize(vm)
  let score : ((Valuation, (Int, Int))) -> (Int, Int) raise = fn(
    x3921 : (Valuation, (Int, Int)),
  ) -> (Int, Int) raise {
    let (vv, (vt, vf)) = x3921
    if interpret(vm)(vv)(x) {
      (vt + 1, vf)
    } else {
      (vt, vf + 1)
    }
  }
  let randomcheck : ((Int, Int)) -> (Int, Int) raise = fn(
    x3922 : (Int, Int),
  ) -> (Int, Int) raise {
    let acc = x3922
    score((randomvaluation(Size::{ size: vn, })(fv), acc))
  }
  let maxchecks_1 = match maxchecks {
    None => maxchecks
    Some(m) =>
      match expint(vn, size_v7(fv)) {
        Some(n) => if n <= m { None } else { maxchecks }
        None => maxchecks
      }
  }
  match maxchecks_1 {
    Some(m_1) => @lib.funpow(m_1, randomcheck, (0, 0))
    None => foldvaluation(Size::{ size: vn, }, fv, score)((0, 0))
  }
}

