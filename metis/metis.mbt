        parameters,
        clauses: clauses_2,
        units,
        rewrite: rewrite_1,
        subsume: subsume_1,
        literals: literals_2,
        equations: equations_2,
        subterms: subterms_2,
        allsubterms: allsubterms_2,
      })
    }
  }
}

