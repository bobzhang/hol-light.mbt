    x3903 : Valuation,
    x3904 : Formula,
    x3905 : String,
    x3906 : Int,
  ) => interpret_p_l(vm, vn, x3903, x3904, x3905, x3906)
  let vv_1 = x3903
  let fm_1 = x3904
  let v_2 = x3905
  let i = x3906
  if i == 0 {
    true
  } else {
    let i_1 = i - 1
    let vv_p = insertvaluation(vv_1)((v_2, i_1))
    interpret(vv_p, fm_1) && interpret_p(vv_1, fm_1, v_2, i_1)
  }
}

