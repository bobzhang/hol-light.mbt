///|
/// `substFm`
pub fn substfm(x2133 : Subst, x2134 : Formula) -> Formula raise {
  let sub_1 = x2133
  let fm_1 = x2134
  match fm_1 {
    Formula::True => fm_1
    Formula::False => fm_1
    Formula::Atom((p, tms)) => {
      let tms_p = @lib.map(subst(sub_1), tms)
      if physical_equal(tms, tms_p) {
        fm_1
      } else {
        Formula::Atom((p, tms_p))
      }
    }
    Formula::Not(p_1) => {
      let p_p = substfm(sub_1, p_1)
      if physical_equal(p_1, p_p) {
        fm_1
      } else {
        Formula::Not(p_p)
      }
    }
    Formula::And(p_2, q) =>
      substconn(
        sub_1,
        fm_1,
