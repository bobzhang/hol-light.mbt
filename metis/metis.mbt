    let path = x3024
    let (f, a) = x3025
    let (f_p, a_p) = x3026
    if !(if equal_v6(f, f_p) {
        let t3027 = @lib.length(a_p)
        @lib.length(a) == t3027
      } else {
        false
      }) {
      None
    } else {
      let itms = enumerate(@lib.zip(a, a_p))
      match
        @lib.list_filter(
          fn(x3028 : (Int, (Term, Term))) -> Bool raise {
            let x = x3028
            !@lib.uncurry(equal_v14, x.1)
          },
          itms,
