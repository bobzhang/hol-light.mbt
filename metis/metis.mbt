///|
/// `GEN_METIS_TAC`
pub fn gen_metis_tac(x5238 : @list.List[@kernel.Thm]) -> @tactics.Tactic raise {
  let ths = x5238
  @tactics.then_tac(fol_prepare_tac(ths), pure_metis_tac)
}

///|
/// ASM_METIS_TAC
fn step_238() -> Unit raise {
  asm_metis_tac_c.set(gen_metis_tac)
}

///|
let asm_metis_tac_c : @lib.Cell[
  (@list.List[@kernel.Thm]) -> @tactics.Tactic raise,
] = @lib.Cell::new("ASM_METIS_TAC")

///|
/// `ASM_METIS_TAC`
pub fn asm_metis_tac(x : @list.List[@kernel.Thm]) -> @tactics.Tactic raise {
  asm_metis_tac_c.get()(x)
}

///|
/// `METIS_TAC`
pub fn metis_tac(x5240 : @list.List[@kernel.Thm]) -> @tactics.Tactic raise {
  let ths = x5240
  let t5243 = asm_metis_tac(ths)
  @tactics.then_tac(
    @tactics.pop_assum_list((x5242 : @list.List[@kernel.Thm]) => {
      @tactics.all_tac
    }),
    t5243,
  )
}

///|
/// `METIS`
pub fn metis(
  x5244 : @list.List[@kernel.Thm],
  x5245 : @kernel.Term,
) -> @kernel.Thm raise {
  let ths = x5244
  let tm = x5245
  @tactics.prove(tm, metis_tac(ths))
}

