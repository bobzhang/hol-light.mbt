///|
/// `FRONT`
pub fn front(
  x5043 : @kernel.Term,
  x5044 : @kernel.Thm,
) -> (@kernel.Thm, @list.List[@kernel.Term]) raise {
  let lit = x5043
  let thm_1 = x5044
  let conc = @kernel.concl(thm_1)
  let disj = @basics.disjuncts(@kernel.concl(thm_1))
  let rest = match
    @lib.partition(
      fn(x5045 : @kernel.Term) -> Bool raise {
        let l = x5045
        l == lit
      },
      disj,
    ) {
    (Empty, _) => raise Failure("FRONT: literal not in disjunction")
    (_, r) => r
  }
  let disj_p = rest.prepend(lit)
  let conc_p = @bool.list_mk_disj(disj_p)
  let eq = @canon.disj_aci_rule(@basics.mk_eq(conc, conc_p))
  (@simp.pure_once_rewrite_rule(@list.List([eq]))(thm_1), rest)
}

///|
/// RESOLVE_N
fn step_231() -> Unit raise {
  let resolve_1 = @class.taut(@parser.parse_term("!a. a ==> ~a ==> F"))
  let resolve_2l = @class.taut(@parser.parse_term("!a b. a \\/ b ==> ~a ==> b"))
  let resolve_2r = @class.taut(@parser.parse_term("!a c. a ==> ~a \\/ c ==> c"))
  let resolve_3 = @class.taut(
    @parser.parse_term("!a b c. a \\/ b ==> ~a \\/ c ==> b \\/ c"),
  )
  resolve_n_c.set(fn(
    x5046 : @kernel.Term,
  ) -> (((@list.List[@kernel.Term], @list.List[@kernel.Term])) -> @kernel.Thm raise) raise {
    let atom_1 = x5046
    fn(
      x5047 : (@list.List[@kernel.Term], @list.List[@kernel.Term]),
    ) -> @kernel.Thm raise {
      match x5047 {
        (Empty, Empty) => @bool.spec(atom_1, resolve_1)
        (r1, Empty) =>
          @bool.specl(@list.List([atom_1, @bool.list_mk_disj(r1)]), resolve_2l)
        (Empty, r2) =>
          @bool.specl(@list.List([atom_1, @bool.list_mk_disj(r2)]), resolve_2r)
        (r1_1, r2_1) => {
          let t5048 = @bool.list_mk_disj(r2_1)
          @bool.specl(
            @list.List([atom_1, @bool.list_mk_disj(r1_1), t5048]),
            resolve_3,
          )
        }
      }
    }
  })
}

