    let t397 = size(m2)
    size(m1) == t397 &&
    (match m1 {
      Map::Map(comparekey, _) => {
        let io1 = mkiterator(m1)
        let io2 = mkiterator(m2)
        equaliterator(
          fn(x400 : TB) -> ((TB) -> Bool raise) raise {
            fn(x401 : TB) -> Bool raise {
              ((x398 : TB, x399 : TB) => equalkey(comparekey, x398, x399))(
                x400, x401,
              )
            }
          },
          equalvalue,
          io1,
          io2,
        )
      }
    })
  }
}

