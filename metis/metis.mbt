///|
/// `subterm'`
pub fn subterm_p(x1459 : (Term, @list.List[Int])) -> Term raise {
  match x1459 {
    (tm, Empty) => tm
    (Term::Var(_), More(_, tail=_)) => raise Failure("Term.subterm: Var")
    (Term::Fn((_, tms)), More(h, tail=t)) =>
      if h >= @lib.length(tms) {
        raise Failure("Term.replace: Fn")
      } else {
        subterm_p((@lib.list_nth(tms, h), t))
      }
  }
}

