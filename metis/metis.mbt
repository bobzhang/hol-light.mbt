}

///|
/// `subterms`
pub fn subterms(x1462 : Term) -> @list.List[(@list.List[Int], Term)] raise {
  let tm = x1462
  fn subtms(
    x1463 : (
      @list.List[(@list.List[Int], Term)],
      @list.List[(@list.List[Int], Term)],
    ),
  ) -> @list.List[(@list.List[Int], Term)] raise {
    match x1463 {
      (Empty, acc) => acc
      (More((path, tm_1), tail=rest), acc_1) => {
        let acc_2 = acc_1.prepend((@lib.rev(path), tm_1))
        match tm_1 {
          Term::Var(_) => subtms((rest, acc_2))
          Term::Fn((_, args)) =>
            subtms(
              (
                @lib.map(
                  fn(x1466 : (Int, Term)) -> (@list.List[Int], Term) raise {
                    ((x1464, x1465) => f_l(path, x1464, x1465))(
                      x1466.0,
                      x1466.1,
                    )
                  },
                  enumerate(args),
                ).concat(rest),
                acc_2,
              ),
            )
        }
      }
    }
  }
  subtms((@list.List([(@list.empty(), tm)]), @list.empty()))
}

///|
fn[TA] f_l(
  path : @list.List[Int],
  x1464 : Int,
  x1465 : TA,
) -> (@list.List[Int], TA) raise {
  let (n, arg) = (x1464, x1465)
  (path.prepend(n), arg)
}

///|
/// `replace`
pub fn replace(x1467 : Term, x1468 : (@list.List[Int], Term)) -> Term raise {
  let tm = x1467
  match x1468 {
    (Empty, res) => if equal_v14(res, tm) { tm } else { res }
    (More(h, tail=t), res_1) =>
      match tm {
        Term::Var(_) => raise Failure("Term.replace: Var")
        Term::Fn((letc, tms)) =>
          if h >= @lib.length(tms) {
            raise Failure("Term.replace: Fn")
          } else {
            let arg = @lib.list_nth(tms, h)
            let arg_p = replace(arg, (t, res_1))
            if physical_equal(arg_p, arg) {
              tm
            } else {
              Term::Fn((letc, updatenth((h, arg_p), tms)))
            }
          }
      }
  }
}

///|
/// `find`
pub fn find_v8(
  x1469 : (Term) -> Bool raise,
) -> ((Term) -> @list.List[Int]? raise) raise {
  let pred = x1469
  fn search(
    x1471 : @list.List[(@list.List[Int], Term)],
  ) -> @list.List[Int]? raise {
    match x1471 {
      Empty => None
      More((path, tm), tail=rest) =>
        if pred(tm) {
          Some(@lib.rev(path))
        } else {
          match tm {
            Term::Var(_) => search(rest)
            Term::Fn((_, a)) => {
              let subtms = @lib.map(
                fn(x1472 : (Int, Term)) -> (@list.List[Int], Term) raise {
                  let (i, t) = x1472
                  (path.prepend(i), t)
                },
                enumerate(a),
              )
              search(subtms.concat(rest))
            }
          }
        }
    }
  }
  fn(x1473 : Term) -> @list.List[Int]? raise {
    let tm_1 = x1473
    search(@list.List([(@list.empty(), tm_1)]))
  }
}

