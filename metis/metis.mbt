///|
/// `eltN`
pub fn eltn(x3695 : Size) -> Int raise {
  match x3695 {
    { size: n, .. } => {
      fn f(x3696 : Int, x3697 : Int) -> Int raise {
        let acc = x3696
        match x3697 {
          0 => acc
          x => {
            let t3698 = x / 2
            f(acc + 1, t3698)
          }
        }
      }
      f(-1, n)
    }
  }
}

///|
/// `posN`
pub fn posn(x3699 : Int) -> Int raise {
  let i = x3699
  shiftleft(1, fromint(i))
}

///|
/// `univN`
pub fn univn(x3700 : Size) -> Int raise {
  let sz = x3700
  minus(posn(eltn(sz)), 1)
}

///|
/// `setN`
pub fn setn(x3701 : Size, x3702 : Int) -> Int raise {
  let sz = x3701
  let x = x3702
  let t3703 = univn(sz)
  andb(fromint(x), t3703)
}

///|
/// `cardFn`
pub fn cardfn(x3704 : Size, x3705 : Int) -> Int? raise {
  let sz = x3704
  let x = x3705
  fn f(x3706 : Int, x3707 : Int) -> Int raise {
    let acc = x3706
    match x3707 {
      0 => acc
      s => {
        let acc_1 = if andb(s, 1) == 0 { acc } else { acc + 1 }
        f(acc_1, shiftright(s, 1))
      }
    }
  }
  Some(f(setn(sz, x), 0))
}

///|
/// `complementFn`
pub fn complementfn(x3708 : Size, x3709 : Int) -> Int? raise {
  let sz = x3708
  let x = x3709
  let t3710 = setn(sz, x)
  Some(toint(xorb(univn(sz), t3710)))
}

///|
/// `differenceFn`
pub fn differencefn(x3711 : Size, x3712 : Int, x3713 : Int) -> Int? raise {
  let sz = x3711
  let x = x3712
  let y = x3713
  let x_1 = setn(sz, x)
  let y_1 = setn(sz, y)
  Some(toint(andb(x_1, notb(y_1))))
}

///|
/// `emptyFn`
pub fn[TA] emptyfn(x3714 : TA) -> Int? raise {
  Some(0)
}

///|
/// `insertFn`
pub fn insertfn(x3715 : Size, x3716 : Int, x3717 : Int) -> Int? raise {
  let sz = x3715
  let x = x3716
  let y = x3717
  let x_1 = x % eltn(sz)
  let y_1 = setn(sz, y)
  Some(toint(orb(posn(x_1), y_1)))
}

///|
/// `intersectFn`
pub fn intersectfn(x3718 : Size, x3719 : Int, x3720 : Int) -> Int? raise {
  let sz = x3718
  let x = x3719
  let y = x3720
  let t3721 = setn(sz, y)
  Some(toint(andb(setn(sz, x), t3721)))
}

///|
