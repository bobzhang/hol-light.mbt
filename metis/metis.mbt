pub fn[TA, TB] compare_v1(
  x390 : (TA) -> ((TA) -> Int raise) raise,
  x391 : Map[TB, TA],
  x392 : Map[TB, TA],
) -> Int raise {
  let comparevalue = x390
  let m1 = x391
  let m2 = x392
  if physical_equal(m1, m2) {
    0
  } else {
    let t393 = size(m2)
    let c = intcompare(size(m1), t393)
    if c != 0 {
      c
    } else {
      match m1 {
        Map::Map(comparekey, _) => {
          let io1 = mkiterator(m1)
          let io2 = mkiterator(m2)
          compareiterator(comparekey, comparevalue, io1, io2)
        }
      }
    }
  }
}

