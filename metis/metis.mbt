///|
/// `subst`
pub fn subst_v5(x3001 : Subst, x3002 : Thm) -> Thm raise {
  let sub = x3001
  match x3002 {
    Thm::Thm(cl, inf) as th => {
      let cl_p = subst_v4(sub, cl)
      if physical_equal(cl, cl_p) {
        th
      } else {
        match inf {
          (InferenceType::Subst, _) => Thm::Thm(cl_p, inf)
          _ => Thm::Thm(cl_p, (InferenceType::Subst, @list.List([th])))
        }
      }
    }
  }
}

///|
/// `resolve`
pub fn resolve(
  x3003 : (Bool, (String, @list.List[Term])),
  x3004 : Thm,
) -> ((Thm) -> Thm raise) raise {
  let lit = x3003
  match x3004 {
    Thm::Thm(cl1, _) as th1 =>
      fn(x3005 : Thm) -> Thm raise {
