        raise Failure("Atom.replace: bad path")
      } else {
        let tm = @lib.list_nth(tms, h)
        let tm_p = replace(tm, (t, res))
        if physical_equal(tm, tm_p) {
          atm
        } else {
          (rel, updatenth((h, tm_p), tms))
        }
      }
  }
}

