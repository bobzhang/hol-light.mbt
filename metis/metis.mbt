///|
/// `matchTerms`
pub fn matchterms(x1725 : Subst, x1726 : Term, x1727 : Term) -> Subst raise {
  let sub = x1725
  let tm1 = x1726
  let tm2 = x1727
  fn matchlist(x1728 : Subst, x1729 : @list.List[(Term, Term)]) -> Subst raise {
    let sub_1 = x1728
    match x1729 {
      Empty => sub_1
      More((Term::Var(v), tm), tail=rest) => {
        let sub_2 = match peek_v6(sub_1)(v) {
          None => insert_v5(sub_1)((v, tm))
          Some(tm_p) =>
            if equal_v14(tm, tm_p) {
              sub_1
            } else {
              raise Failure("Substitute.match: incompatible matches")
            }
        }
        matchlist(sub_2, rest)
      }
      More((Term::Fn((f1, args1)), Term::Fn((f2, args2))), tail=rest_1) =>
        if (if equal_v6(f1, f2) {
            let t1730 = @lib.length(args2)
            @lib.length(args1) == t1730
          } else {
            false
          }) {
          matchlist(sub_1, @lib.zip(args1, args2).concat(rest_1))
        } else {
          raise Failure("Substitute.match: different structure")
        }
      _ => raise Failure("Substitute.match: functions can't match vars")
    }
  }
  matchlist(sub, @list.List([(tm1, tm2)]))
}

///|
/// `unify`
pub fn unify(x1731 : Subst, x1732 : Term, x1733 : Term) -> Subst raise {
  let sub = x1731
  let tm1 = x1732
  let tm2 = x1733
  let solve = (x1734 : Subst, x1735 : @list.List[(Term, Term)]) => {
    solve_l(x1734, x1735)
  }
  let solve_p = (x1737 : Subst, x1738 : (Term, Term, @list.List[(Term, Term)])) => {
    solve_p_l(x1737, x1738)
  }
  solve(sub, @list.List([(tm1, tm2)]))
}

///|
fn solve_l(x1734 : Subst, x1735 : @list.List[(Term, Term)]) -> Subst raise {
  let solve = (x1734 : Subst, x1735 : @list.List[(Term, Term)]) => {
    solve_l(x1734, x1735)
  }
  let solve_p = (x1737 : Subst, x1738 : (Term, Term, @list.List[(Term, Term)])) => {
    solve_p_l(x1737, x1738)
  }
  let sub_1 = x1734
  match x1735 {
    Empty => sub_1
    More((tm1_1, tm2_1), tail=rest) =>
      if physical_equal(tm1_1, tm2_1) {
        solve(sub_1, rest)
      } else {
        let t1736 = subst(sub_1)(tm2_1)
        solve_p(sub_1, (subst(sub_1)(tm1_1), t1736, rest))
      }
  }
}

///|
fn solve_p_l(
  x1737 : Subst,
  x1738 : (Term, Term, @list.List[(Term, Term)]),
) -> Subst raise {
  let solve = (x1734 : Subst, x1735 : @list.List[(Term, Term)]) => {
    solve_l(x1734, x1735)
  }
  let solve_p = (x1737 : Subst, x1738 : (Term, Term, @list.List[(Term, Term)])) => {
    solve_p_l(x1737, x1738)
  }
  let sub_2 = x1737
  match x1738 {
    (Term::Var(v), tm, rest_1) =>
      if equalvar(v, tm) {
        solve(sub_2, rest_1)
      } else if freein(v, tm) {
        raise Failure("Substitute.unify: occurs check")
      } else {
        match peek_v6(sub_2)(v) {
          None => {
            let t1739 = singleton_v18((v, tm))
            solve(compose_v1(sub_2)(t1739), rest_1)
          }
          Some(tm_p) => solve_p(sub_2, (tm_p, tm, rest_1))
        }
      }
    (tm1_2, Term::Var(_) as tm2_2, rest_2) =>
      solve_p(sub_2, (tm2_2, tm1_2, rest_2))
    (Term::Fn((f1, args1)), Term::Fn((f2, args2)), rest_3) =>
      if (if equal_v6(f1, f2) {
          let t1740 = @lib.length(args2)
          @lib.length(args1) == t1740
        } else {
          false
        }) {
        solve(sub_2, @lib.zip(args1, args2).concat(rest_3))
      } else {
        raise Failure("Substitute.unify: different structure")
      }
  }
}

