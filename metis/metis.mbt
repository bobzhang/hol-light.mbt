          x5037 : @kernel.Term,
          x5038 : @list.List[(String, @kernel.Term)],
        ) => unify_fo_ho_term(vars, x5036, x5037, x5038),
        args,
        @list.List([hl, hr]),
        m,
      )
    } catch {
      Failure(_) => raise Unify::Unify
      e => raise e
    }
  } else {
    unify_fo_ho_term(vars, Term::Fn((p, args)), htm, m)
  }
}

///|
