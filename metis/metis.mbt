        Some(net_3) =>
          rest_3.prepend((pats_2, stackaddqterm(pat_1)(stack_3), net_3))
      }
      let rest_5 = match peek_v5(fns, f) {
        None => rest_4
        Some(net_4) =>
          rest_4.prepend((a.concat(pats_2), stackaddfn(f)(stack_3), net_4))
