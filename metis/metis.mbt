    Formula::Iff(p_5, q_3) =>
      substconn(
        sub_1,
        fm_1,
        fn(x2138 : (Formula, Formula)) -> Formula raise {
          let (x_3, y_3) = x2138
          Formula::Iff(x_3, y_3)
        },
        p_5,
        q_3,
      )
    Formula::Forall(v, p_6) =>
      substquant(
        sub_1,
        fm_1,
        fn(x2139 : (String, Formula)) -> Formula raise {
          let (x_4, y_4) = x2139
          Formula::Forall(x_4, y_4)
        },
        v,
        p_6,
      )
    Formula::Exists(v_1, p_7) =>
      substquant(
        sub_1,
        fm_1,
        fn(x2140 : (String, Formula)) -> Formula raise {
          let (x_5, y_5) = x2140
          Formula::Exists(x_5, y_5)
        },
        v_1,
        p_7,
      )
  }
}

///|
/// `substConn`
pub fn substconn(
  x2141 : Subst,
  x2142 : Formula,
