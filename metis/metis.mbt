        More((i, (tm, tm_p)), tail=Empty) => {
          let path_1 = path.prepend(i)
          if equal_v14(tm, s) && equal_v14(tm_p, t) {
            Some(@lib.rev(path_1))
          } else {
            match (tm, tm_p) {
              (Term::Fn(f_a), Term::Fn(f_a_p)) => sync(s, t, path_1, f_a, f_a_p)
              _ => None
