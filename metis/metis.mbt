///|
/// `normalize`
pub fn normalize(x1671 : Subst) -> Subst raise {
  match x1671 {
    Subst::Subst(m) as sub => {
      let isnotid : ((String, Term)) -> Bool raise = fn(
        x1672 : (String, Term),
      ) -> Bool raise {
        let (v, tm) = x1672
        !equalvar(v, tm)
      }
      let m_p = filter_v8(isnotid)(m)
      let t1673 = size_v6(m_p)
      if size_v6(m) == t1673 {
        sub
      } else {
        Subst::Subst(m_p)
      }
    }
  }
}

///|
/// `subst`
pub fn subst(x1674 : Subst) -> ((Term) -> Term raise) raise {
  let sub = x1674
  fn tmsub(x1676 : Term) -> Term raise {
    match x1676 {
      Term::Var(v) as tm =>
        match peek_v6(sub)(v) {
          Some(tm_p) => if physical_equal(tm, tm_p) { tm } else { tm_p }
          None => tm
        }
      Term::Fn((f, args)) as tm_1 => {
        let args_p = @lib.map(tmsub, args)
        if physical_equal(args, args_p) {
          tm_1
        } else {
          Term::Fn((f, args_p))
        }
      }
    }
  }
  fn(x1677 : Term) -> Term raise {
    let tm_2 = x1677
    if null_v11(sub) {
      tm_2
    } else {
      tmsub(tm_2)
    }
  }
}

