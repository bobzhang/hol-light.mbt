      More(Formula::False, tail=fms_1) => sz(n + 1, fms_1)
      More(Formula::Atom(atm), tail=fms_2) => sz(n + symbols_v1(atm), fms_2)
      More(Formula::Not(p), tail=fms_3) => sz(n + 1, fms_3.prepend(p))
      More(Formula::And(p_1, q), tail=fms_4) =>
        sz(n + 1, fms_4.prepend(q).prepend(p_1))
      More(Formula::Or(p_2, q_1), tail=fms_5) =>
        sz(n + 1, fms_5.prepend(q_1).prepend(p_2))
      More(Formula::Imp(p_3, q_2), tail=fms_6) =>
        sz(n + 1, fms_6.prepend(q_2).prepend(p_3))
      More(Formula::Iff(p_4, q_3), tail=fms_7) =>
        sz(n + 1, fms_7.prepend(q_3).prepend(p_4))
      More(Formula::Forall(_, p_5), tail=fms_8) => sz(n + 1, fms_8.prepend(p_5))
      More(Formula::Exists(_, p_6), tail=fms_9) => sz(n + 1, fms_9.prepend(p_6))
    }
  }
  sz(0, @list.List([fm]))
}

///|
/// `compare`
pub fn compare_v29(x2112 : Formula, x2113 : Formula) -> Int raise {
  let fm1 = x2112
  let fm2 = x2113
  fn cmp(x2114 : @list.List[(Formula, Formula)]) -> Int raise {
    match x2114 {
      Empty => 0
      More((f1, f2) as f1_f2, tail=fs) =>
        if physical_equal(f1, f2) {
          cmp(fs)
        } else {
          match f1_f2 {
            (Formula::True, Formula::True) => cmp(fs)
            (Formula::True, _) => -1
            (_, Formula::True) => 1
            (Formula::False, Formula::False) => cmp(fs)
            (Formula::False, _) => -1
            (_, Formula::False) => 1
            (Formula::Atom(atm1), Formula::Atom(atm2)) => {
              let c = compare_v24(atm1, atm2)
              if c != 0 {
                c
              } else {
                cmp(fs)
              }
            }
            (Formula::Atom(_), _) => -1
            (_, Formula::Atom(_)) => 1
            (Formula::Not(p1), Formula::Not(p2)) => cmp(fs.prepend((p1, p2)))
            (Formula::Not(_), _) => -1
            (_, Formula::Not(_)) => 1
            (Formula::And(p1_1, q1), Formula::And(p2_1, q2)) =>
              cmp(fs.prepend((q1, q2)).prepend((p1_1, p2_1)))
            (Formula::And(_, _), _) => -1
            (_, Formula::And(_, _)) => 1
            (Formula::Or(p1_2, q1_1), Formula::Or(p2_2, q2_1)) =>
              cmp(fs.prepend((q1_1, q2_1)).prepend((p1_2, p2_2)))
            (Formula::Or(_, _), _) => -1
            (_, Formula::Or(_, _)) => 1
            (Formula::Imp(p1_3, q1_2), Formula::Imp(p2_3, q2_2)) =>
              cmp(fs.prepend((q1_2, q2_2)).prepend((p1_3, p2_3)))
            (Formula::Imp(_, _), _) => -1
            (_, Formula::Imp(_, _)) => 1
            (Formula::Iff(p1_4, q1_3), Formula::Iff(p2_4, q2_3)) =>
              cmp(fs.prepend((q1_3, q2_3)).prepend((p1_4, p2_4)))
            (Formula::Iff(_, _), _) => -1
            (_, Formula::Iff(_, _)) => 1
            (Formula::Forall(v1, p1_5), Formula::Forall(v2, p2_5)) => {
              let c_1 = compare_v10(v1)(v2)
              if c_1 != 0 {
                c_1
              } else {
                cmp(fs.prepend((p1_5, p2_5)))
              }
            }
            (Formula::Forall(_, _), Formula::Exists(_, _)) => -1
            (Formula::Exists(_, _), Formula::Forall(_, _)) => 1
            (Formula::Exists(v1_1, p1_6), Formula::Exists(v2_1, p2_6)) => {
              let c_2 = compare_v10(v1_1)(v2_1)
              if c_2 != 0 {
                c_2
              } else {
                cmp(fs.prepend((p1_6, p2_6)))
              }
            }
          }
        }
    }
  }
  cmp(@list.List([(fm1, fm2)]))
}

