) -> ((TA, TB), Tree[TA, TB]) raise {
  let node = x263
  match node {
    { left, key, value: value_1, right, .. } =>
      ((key, value_1), treeappend(left, right))
    _ => raise @lib.MatchFailure("tscript.ml:927")
  }
}

///|
/// `treeDeletePick`
pub fn[TA, TB] treedeletepick(
  x264 : Tree[TA, TB],
) -> ((TA, TB), Tree[TA, TB]) raise {
