///|
/// `cmp`
pub fn cmp(x4000 : @list.List[(Qterm, Qterm)]) -> Int raise {
  match x4000 {
    Empty => 0
    More((q1, q2) as q1_q2, tail=qs) =>
      if physical_equal(q1, q2) {
        cmp(qs)
      } else {
        match q1_q2 {
          (Qterm::Var, Qterm::Var) => 0
          (Qterm::Var, Qterm::Fn(_, _)) => -1
          (Qterm::Fn(_, _), Qterm::Var) => 1
          (Qterm::Fn(f1, f1_p), Qterm::Fn(f2, f2_p)) =>
            fncmp((f1, f1_p), (f2, f2_p), qs)
        }
      }
  }
}

