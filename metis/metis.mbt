) -> Iterator[TA, TB]? raise {
  let nodes = x277
  let tree = x278
  fromspinerighttoleftiterator(treerightspine(nodes, tree))
}

///|
/// `treeMkIterator`
pub fn[TA, TB] treemkiterator(x279 : Tree[TA, TB]) -> Iterator[TA, TB]? raise {
