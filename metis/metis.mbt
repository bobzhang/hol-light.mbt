  let cls = sort_utilitywise(factor_v1(cl_1).prepend(cl_1))
  foldl(
    fn(
      x4849 : (Clause1, (Active, Subsume[Clause1], @list.List[Clause1])),
    ) -> (Active, Subsume[Clause1], @list.List[Clause1]) raise {
      post_factor(x4849.0, x4849.1)
    },
    active_subsume_acc_1,
    cls,
  )
}

