///|
/// `symEqn`
pub fn symeqn(x3069 : ((Term, Term), Thm)) -> ((Term, Term), Thm) raise {
  let ((t, u), th) as eqn = x3069
  if equal_v14(t, u) {
    eqn
  } else {
    (
      (u, t),
      match equationliteral(eqn.0, eqn.1) {
        Some(t_u) => symeq(t_u, th)
        None => th
      },
    )
  }
}

///|
/// `transEqn`
pub fn transeqn(
  x3070 : ((Term, Term), Thm),
  x3071 : ((Term, Term), Thm),
) -> ((Term, Term), Thm) raise {
  let ((x, y), th1) as eqn1 = x3070
  let ((_, z), th2) as eqn2 = x3071
  if equal_v14(x, y) {
    eqn2
  } else if equal_v14(y, z) {
    eqn1
  } else if equal_v14(x, z) {
    refleqn(x)
  } else {
    (
      (x, z),
      match equationliteral(eqn1.0, eqn1.1) {
        None => th1
        Some(x_y) =>
          match equationliteral(eqn2.0, eqn2.1) {
            None => th2
            Some(y_z) => {
              let sub = fromlist_v9(
                @list.List([(xvarname(), x), (yvarname(), y), (zvarname(), z)]),
              )
              let th = subst_v5(sub, transitivity())
              let th_1 = resolve(x_y, th1)(th)
              let th_2 = resolve(y_z, th2)(th_1)
              th_2
            }
          }
      },
    )
  }
}

