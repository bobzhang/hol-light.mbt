///|
/// `node`
pub(all) enum Node1[TA] {
  Em
  Tr(Int, TA, Node1[TA], Node1[TA])
} derive(Eq, Debug)

///|
fn[TA] ocaml_rank_Node1(x : Node1[TA]) -> Int {
  match x {
    Em => 0
    Tr(_, _, _, _) => 1000000
  }
}

///|
pub impl[TA : @lib.OCompare] @lib.OCompare for Node1[TA] with fn ocompare(
  self,
  other,
) {
  match (self, other) {
    (Tr(a0, a1, a2, a3), Tr(b0, b1, b2, b3)) => {
      let c = @lib.compare(a0, b0)
      if c != 0 {
        return c
      }
      let c = @lib.compare(a1, b1)
      if c != 0 {
        return c
      }
      let c = @lib.compare(a2, b2)
      if c != 0 {
        return c
      }
      @lib.compare(a3, b3)
    }
    _ => ocaml_rank_Node1(self).compare(ocaml_rank_Node1(other))
  }
}

///|
pub impl[TA : @lib.OHash] @lib.OHash for Node1[TA] with fn ohash_visit(self, h) {
  match self {
    Em => h.int(0L)
    Tr(a0, a1, a2, a3) => {
      h.block(0, 4)
      h.field(a0)
      h.field(a1)
      h.field(a2)
      h.field(a3)
    }
  }
}

///|
/// `heap`
pub(all) enum Heap[TA] {
  Heap((TA) -> ((TA) -> Int raise) raise, Int, Node1[TA])
}

///|
/// `rank`
pub fn[TA] rank(x911 : Node1[TA]) -> Int raise {
  match x911 {
    Node1::Em => 0
    Node1::Tr(r, _, _, _) => r
  }
}

///|
/// `makeT`
pub fn[TA] maket(
  x912 : TA,
  x913 : Node1[TA],
  x914 : Node1[TA],
) -> Node1[TA] raise {
  let (x, a, b) = (x912, x913, x914)
  let t915 = rank(b)
  if rank(a) >= t915 {
    Node1::Tr(rank(b) + 1, x, a, b)
  } else {
    Node1::Tr(rank(a) + 1, x, b, a)
  }
}

///|
/// `merge`
pub fn[TA] merge_v3(
  x916 : (TA) -> ((TA) -> Int raise) raise,
) -> (((Node1[TA], Node1[TA])) -> Node1[TA] raise) raise {
  let cmp = x916
  fn mrg(x918 : (Node1[TA], Node1[TA])) -> Node1[TA] raise {
    match x918 {
      (h, Node1::Em) => h
      (Node1::Em, h_1) => h_1
      (Node1::Tr(_, x, a1, b1) as h1, Node1::Tr(_, y, a2, b2) as h2) =>
        if cmp(x)(y) > 0 {
          maket(y, a2, mrg((h1, b2)))
        } else {
          maket(x, a1, mrg((b1, h2)))
        }
    }
  }
  mrg
}

///|
/// `newHeap`
pub fn[TA] newheap(x919 : (TA) -> ((TA) -> Int raise) raise) -> Heap[TA] raise {
  let cmp = x919
  Heap::Heap(cmp, 0, Node1::Em)
}

///|
/// `add`
pub fn[TA] add_v5(x920 : Heap[TA]) -> ((TA) -> Heap[TA] raise) raise {
  match x920 {
    Heap::Heap(f, n, a) =>
      fn(x921 : TA) -> Heap[TA] raise {
        let x = x921
        let t922 = (Node1::Tr(1, x, Node1::Em, Node1::Em), a)
        let t923 = merge_v3(f)(t922)
        Heap::Heap(f, n + 1, t923)
