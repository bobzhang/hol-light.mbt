///|
/// `unify_fo_ho_term`
pub fn unify_fo_ho_term(
  x5024 : @list.List[@kernel.Term],
  x5025 : Term,
  x5026 : @kernel.Term,
  x5027 : @list.List[(String, @kernel.Term)],
) -> @list.List[(Name, @kernel.Term)] raise {
  let vars = x5024
  let fat = x5025
  let tm = x5026
  let m = x5027
  if verb().val {
    let t5028 = @printer.string_of_term(tm)
    @pp.std_formatter.print_string(
      "unify_fo_ho_term: fat = " + tostring_v4(fat) + ", tm = " + t5028 + "\n",
    )
    @pp.std_formatter.print_flush()
    ()
  } else {
    ()
  }
  match fat {
    Term::Var(v) if @lib.list_mem_assoc(v, m) => {
      if verb().val {
        @pp.std_formatter.print_string("var_assoc\n")
        @pp.std_formatter.print_flush()
        ()
      } else {
        ()
      }
      let tm_p = @lib.list_assoc(v, m)
      if tm == tm_p {
        m
      } else {
        raise Unify::Unify
      }
    }
    Term::Var(v_1) => {
      if verb().val {
        @pp.std_formatter.print_string("var\n")
        @pp.std_formatter.print_flush()
        ()
      } else {
        ()
      }
      if @kernel.is_var(tm) && !@lib.mem(tm, vars) {
        m.prepend((v_1, tm))
      } else {
        if verb().val {
          @pp.std_formatter.print_string("Unify!\n")
          @pp.std_formatter.print_flush()
          ()
        } else {
          ()
        }
        raise Unify::Unify
      }
    }
    Term::Fn((f, args)) => {
      if verb().val {
        @pp.std_formatter.print_string("fn\n")
        @pp.std_formatter.print_flush()
        ()
      } else {
        ()
      }
      let (hf, hargs) = @basics.strip_comb(tm) catch {
        Failure(_) => raise Unify::Unify
        e => raise e
      }
      if verb().val {
        {
          @pp.std_formatter.print_string(
            "hf = " + @printer.string_of_term(hf) + "\n",
          )
          @pp.std_formatter.print_flush()
          ()
        }
        @pp.std_formatter.print_string(
          "is_var: " +
          (if @kernel.is_var(hf) { "true" } else { "false" }) +
          "\n",
        )
        @pp.std_formatter.print_flush()
        ()
      } else {
        ()
      }
      if @kernel.is_const(hf) || @kernel.is_var(hf) {
        ()
      } else {
        raise @lib.AssertFailure("tscript.ml:9670:6")
      }
      if hf == hol_of_const(@lib.int_of_string(f)) {
        @lib.itlist2(
          (
            x5029 : Term,
            x5030 : @kernel.Term,
            x5031 : @list.List[(String, @kernel.Term)],
          ) => unify_fo_ho_term(vars, x5029, x5030, x5031),
          args,
          hargs,
          m,
        )
      } else {
        raise Unify::Unify
      }
    }
  }
}

///|
