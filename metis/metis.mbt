        p_2,
        q,
      )
    Formula::Or(p_3, q_1) =>
      substconn(
        sub_1,
        fm_1,
        fn(x2136 : (Formula, Formula)) -> Formula raise {
          let (x_1, y_1) = x2136
          Formula::Or(x_1, y_1)
        },
        p_3,
        q_1,
      )
    Formula::Imp(p_4, q_2) =>
      substconn(
        sub_1,
        fm_1,
        fn(x2137 : (Formula, Formula)) -> Formula raise {
