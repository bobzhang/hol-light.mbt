///|
/// INVARIANCE_OF_DOMAIN_EUCLIDEAN_SPACE_EMBEDDING_MAP_GEN
fn step_351() -> Unit raise {
  let t13072 = @meson.asm_meson_tac(
    @list.List([
      @metric.subtopology_subtopology(),
      @metric.continuous_map_from_subtopology(),
    ]),
  )
  let t13071 = @simp.asm_simp_tac(
    @list.List([@sets.in_inter(), @metric.open_in_inter()]),
  )
  let t13070 = @simp.rewrite_tac(@list.List([@sets.injective_on_alt()]))
  let t13069 = @tactics.exists_tac(@parser.parse_term("m:num"))
  let t13068 = @tactics.match_mp_tac(invariance_of_domain_euclidean_space_gen())
  let t13067 = @tactics.x_gen_tac(@parser.parse_term("v:(num->real)->bool"))
  let t13066 = @simp.rewrite_tac(
    @list.List([
      @metric.open_map(),
      @metric.open_in_subtopology_alt(),
      @sets.forall_in_gspec(),
    ]),
  )
  let t13065 = @simp.asm_simp_tac(
    @list.List([@metric.topspace_subtopology(), @sets.in_inter()]),
  )
  let t13064 = @tactics.match_mp_tac(@metric.injective_open_imp_embedding_map())
  let t13063 = @tactics.repeat_tac(@tactics.strip_tac)
  let t13073 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(
                @tactics.then_tac(
                  @tactics.then_tac(
                    @tactics.then_tac(
                      @tactics.then_tac(
                        @simp.rewrite_tac(
                          @list.List([@sets.injective_on_alt()]),
                        ),
                        t13063,
                      ),
                      t13064,
                    ),
                    t13065,
                  ),
                  t13066,
                ),
                t13067,
              ),
              @tactics.disch_tac,
            ),
            t13068,
          ),
          t13069,
        ),
        t13070,
      ),
      t13071,
    ),
    t13072,
  )
  invariance_of_domain_euclidean_space_embedding_map_gen_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!m n u f.\n      n <= m /\\\n      open_in (euclidean_space m) u /\\\n      continuous_map(subtopology (euclidean_space m) u,euclidean_space n) f /\\\n      (!x y. x IN u /\\ y IN u /\\ f x = f y ==> x = y)\n      ==> embedding_map(subtopology (euclidean_space m) u,euclidean_space n) f",
      ),
      t13073,
    ),
  )
}

