      hom_boundary_chain_boundary_c.set(hom_boundary_chain_boundary)
      hom_boundary_restrict_c.set(hom_boundary_restrict)
      hom_boundary_c.set(hom_boundary)
      hom_boundary_trivial_c.set(hom_boundary_trivial)
      ()
    }
    _ => raise @lib.MatchFailure("tscript.ml:4141:4")
