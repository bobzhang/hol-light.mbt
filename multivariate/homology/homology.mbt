///|
/// HOM_INDUCED_CHAIN_MAP
fn step_197() -> Unit raise {
  let t4954 = @tactics.asm_tac(@sets.set_tac)(@list.empty())
  let t4953 = @tactics.match_mp_tac(hom_induced_chain_map_gen())
  let t4955 = @tactics.then_tac(
    @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t4953),
    t4954,
  )
  hom_induced_chain_map_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!p top s top' t (f:A->B) c.\n        continuous_map (top,top') f /\\\n        IMAGE f s SUBSET t /\\\n        singular_relcycle (p,top,s) c\n        ==> hom_induced (&p) (top,s) (top',t) f (homologous_rel (p,top,s) c) =\n            homologous_rel (p,top',t) (chain_map p f c)",
      ),
      t4955,
    ),
  )
}

