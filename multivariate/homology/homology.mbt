///|
let sufficient_iterated_singular_subdivision_exists_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new(
  "SUFFICIENT_ITERATED_SINGULAR_SUBDIVISION_EXISTS",
)

///|
/// `SUFFICIENT_ITERATED_SINGULAR_SUBDIVISION_EXISTS`
pub fn sufficient_iterated_singular_subdivision_exists() -> @kernel.Thm {
  sufficient_iterated_singular_subdivision_exists_c.get()
}

