  simplicial_subdivision_shrinks_c.get()
}

///|
/// singular_subdivision
fn step_152() -> Unit raise {
  singular_subdivision_c.set(
    @pair.new_definition(
      @parser.parse_term(
        "singular_subdivision p =\n        frag_extend\n           (\\f. chain_map p f\n                  (simplicial_subdivision p\n                         (frag_of(RESTRICTION (standard_simplex p) I))))",
      ),
    ),
  )
}

///|
let singular_subdivision_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new(
  "singular_subdivision",
)

///|
/// `singular_subdivision`
pub fn singular_subdivision() -> @kernel.Thm {
  singular_subdivision_c.get()
}

///|
/// SINGULAR_SUBDIVISION_0
fn step_153() -> Unit raise {
  let t1877 = @simp.rewrite_tac(
    @list.List([singular_subdivision(), @frag.frag_extend_0()]),
  )
  singular_subdivision_0_c.set(
    @tactics.prove(
      @parser.parse_term("!p. singular_subdivision p frag_0 = frag_0"),
      t1877,
    ),
  )
}

