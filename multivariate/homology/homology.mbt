  let t7497 = @tactics.exists_tac(@parser.parse_term("(\\x. a):1->A"))
  let t7496 = @simp.rewrite_tac(@list.List([@metric.homeomorphic_map_maps()]))
  let t7495 = @tactics.match_mp_tac(
    homeomorphic_map_homology_group_isomorphism(),
  )
  let t7494 = @tactics.match_mp_tac(
    @meson.meson(
      @list.List([
        @grouptheory.group_isomorphism_group_kernel_group_image(),
        @sets.subset_refl(),
      ]),
      @parser.parse_term(
        "group_isomorphism (G,G') f\n     ==> group_kernel(G,G') f SUBSET {group_id G}",
      ),
    ),
  )
  let t7493 = @tactics.match_mp_tac(
    @grouptheory.trivial_group_subgroup_generated_trivial(),
  )
  let t7492 = @simp.rewrite_tac(@list.List([reduced_homology_group()]))
  let t7500 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(
                @tactics.then_tac(
                  @tactics.repeat_tac(@tactics.strip_tac),
                  t7492,
                ),
                t7493,
              ),
              t7494,
            ),
            t7495,
          ),
          t7496,
        ),
        t7497,
      ),
      t7498,
    ),
    t7499,
  )
  homology_dimension_reduced_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!p top a:A.\n        topspace top = {a} ==> trivial_group (reduced_homology_group (p,top))",
      ),
      t7500,
    ),
  )
}

