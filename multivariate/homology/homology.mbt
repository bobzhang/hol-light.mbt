      t9329,
    ),
    t9330,
  )
  brouwer_degree2_nonsurjective_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!p f. continuous_map(nsphere p,nsphere p) f /\\\n         ~(IMAGE f (topspace(nsphere p)) = topspace(nsphere p))\n         ==> brouwer_degree2 p f = &0",
      ),
      t9331,
    ),
  )
}

