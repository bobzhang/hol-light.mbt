// Load-fidelity test for Multivariate/homology.ml: replays tools/ocaml_ref/Multivariate_homology_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "Multivariate/homology matches Multivariate/homology.ml" {
  @homology.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "Library/wo", "Library/card", "Library/floor", "Multivariate/misc",
      "Library/products", "Library/iter", "Multivariate/metric", "Library/frag",
      "Library/prime", "Library/grouptheory", "Multivariate/homology",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Multivariate/homology")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("standard_simplex", () => sthm(@homology.standard_simplex()))
  log.attempt("TOPSPACE_STANDARD_SIMPLEX", () => {
    sthm(@homology.topspace_standard_simplex())
  })
  log.attempt("BASIS_IN_STANDARD_SIMPLEX", () => {
    sthm(@homology.basis_in_standard_simplex())
