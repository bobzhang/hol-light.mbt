///|
/// setdist
fn step_1994() -> Unit raise {
  setdist_c.set(@pair.new_definition(@parser.parse_term("setdist(s,t) =\n        if s = {} \\/ t = {} then &0\n        else inf {dist(x,y) | x IN s /\\ y IN t}")))
}

///|
let setdist_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("setdist")

///|
/// `setdist`
pub fn setdist() -> @kernel.Thm {
  setdist_c.get()
}

///|
/// SETDIST_EMPTY
fn step_1995() -> Unit raise {
  let t22880 = @simp.rewrite_tac(@list.List([setdist()]))
  setdist_empty_c.set(@tactics.prove(@parser.parse_term("(!t. setdist({},t) = &0) /\\ (!s. setdist(s,{}) = &0)"), t22880))
}

