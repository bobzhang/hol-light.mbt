      #|  !s. (\\x. x) uniformly_continuous_on s
      #|  e:real
      #|  !f g x s. f continuous (at x within s) /\\\n             g continuous (at (f x) within IMAGE f s)\n             ==> (g o f) continuous (at x within s)
      #|  !f g x. f continuous (at x) /\\ g continuous (at (f x))\n           ==> (g o f) continuous (at x)
      #|  !f g s. f continuous_on s /\\ g continuous_on (IMAGE f s)\n           ==> (g o f) continuous_on s
