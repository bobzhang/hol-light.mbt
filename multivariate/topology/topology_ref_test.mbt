      #|  !f:real^M->real^N s.\n        (?g. homeomorphism (s,{pastecart x (f x) | x IN s})\n                           ((\\x. pastecart x (f x)),g)) <=>\n        f continuous_on s
      #|  !f:real^M->real^N s.\n        f continuous_on s ==> {pastecart x (f x) | x IN s} homeomorphic s
