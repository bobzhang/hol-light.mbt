      #|  (!y. ((?x. (y = f x) /\\ P x) /\\ Q y ==> R y)) <=>\n     (!x. P x /\\ Q (f x) ==> R (f x))
      #|  &0 < e
      #|  e:real
      #|  a /\\ b /\\ c <=> b /\\ a /\\ c
      #|  !f g s. f uniformly_continuous_on s /\\\n           g uniformly_continuous_on (IMAGE f s)\n           ==> (g o f) uniformly_continuous_on s
      #|  norm(x) <= a /\\ norm(y) <= b ==> norm(x + y:real^N) <= a + b
      #|  :real
      #|  :real
      #|  B * e / &2 / &2 / B / B2 * B2 + B * B1 * e / &2 / &2 / B / B1
      #|  y:real^M
      #|  x:real^M
      #|  y:real^M
      #|  x:real^M
      #|  min d1 d2
      #|  d2:real
      #|  e / &2 / &2 / B / B1
      #|  d1:real
      #|  e / &2 / &2 / B / B2
      #|  (f:real^M->real^N) uniformly_continuous_on s
      #|  (g:real^M->real^P) uniformly_continuous_on s
      #|  B2:real
      #|  B1:real
      #|  bounded(IMAGE (g:real^M->real^P) s)
      #|  B:real
      #|  !a b c d. (h:real^N->real^P->real^Q) a b - h c d =\n              h (a - c) b + h c (b - d)
      #|  e:real
      #|  !f:real^M->real^N g (h:real^N->real^P->real^Q) s.\n           f uniformly_continuous_on s /\\ g uniformly_continuous_on s /\\\n           bilinear h /\\ bounded(IMAGE f s) /\\ bounded(IMAGE g s)\n           ==> (\\x. h (f x) (g x)) uniformly_continuous_on s
      #|  s:real^M->bool
      #|  \\c (v:real^N). drop c % v
      #|  g:real^M->real^N
      #|  lift o (f:real^M->real)
      #|  !f g:real^M->real^N s.\n        (lift o f) uniformly_continuous_on s /\\ g uniformly_continuous_on s /\\\n        bounded(IMAGE (lift o f) s) /\\ bounded(IMAGE g s)\n        ==>  (\\x. f x % g x) uniformly_continuous_on s
      #|  !f c s. f uniformly_continuous_on s\n           ==> (\\x. c % f(x)) uniformly_continuous_on s
      #|  \\x. (drop x % v:real^N)
      #|  !s:real^M->bool c v:real^N.\n      (lift o c) uniformly_continuous_on s\n      ==> (\\x. c x % v) uniformly_continuous_on s
      #|  !f s. f uniformly_continuous_on s\n         ==> (\\x. --(f x)) uniformly_continuous_on s
      #|  !f g s. f uniformly_continuous_on s /\\ g uniformly_continuous_on s\n           ==> (\\x. f(x) + g(x)) uniformly_continuous_on s
      #|  !f g s. f uniformly_continuous_on s /\\ g uniformly_continuous_on s\n           ==> (\\x. f(x) - g(x)) uniformly_continuous_on s
      #|  !t f s. FINITE s /\\ (!a. a IN s ==> (f a) uniformly_continuous_on t)\n             ==> (\\x. vsum s (\\a. f a x)) uniformly_continuous_on t
      #|  !f:real^N->real s.\n        (lift o f) uniformly_continuous_on s\n        ==> (\\x. lift(sqrt(f x))) uniformly_continuous_on s
      #|  !a s. (\\x. x) continuous (at a within s)
      #|  !a. (\\x. x) continuous (at a)
