      #|  :real
      #|  :real
      #|  !f:real^M->real^N s.\n        (\\x. f(--x)) continuous_on (IMAGE (--) s) <=>\n        f continuous_on s
      #|  !s c. (\\x. c) uniformly_continuous_on s
