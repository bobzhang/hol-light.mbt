      #|  !f:real^N->real^N s.\n        f continuous_on s /\\ IMAGE f s SUBSET s /\\ (!x. x IN s ==> f(f x) = x)\n        ==> homeomorphism(s,s) (f,f)
      #|  g:real^N->real^M
      #|  !f:real^M->real^N g s t.\n    homeomorphism (s,t) (f,g)\n    ==> !u. u SUBSET t\n            ==> (open_in (subtopology euclidean s) {x | x IN s /\\ f x IN u} <=>\n                 open_in (subtopology euclidean t) u)
      #|  (\\z. pastecart (f'(fstcart z)) (g'(sndcart z)))\n     :real^(P,Q)finite_sum->real^(M,N)finite_sum
      #|  (\\z. pastecart (f(fstcart z)) (g(sndcart z)))\n     :real^(M,N)finite_sum->real^(P,Q)finite_sum
      #|  g':real^Q->real^N
      #|  g:real^N->real^Q
      #|  f':real^P->real^M
      #|  f:real^M->real^P
      #|  !s:real^M->bool t:real^N->bool s':real^P->bool t':real^Q->bool.\n        s homeomorphic s' /\\ t homeomorphic t'\n        ==> (s PCROSS t) homeomorphic (s' PCROSS t')
      #|  (\\z. pastecart (sndcart z) (fstcart z))\n              :real^(N,M)finite_sum->real^(M,N)finite_sum
      #|  (\\z. pastecart (sndcart z) (fstcart z))\n              :real^(M,N)finite_sum->real^(N,M)finite_sum
      #|  !s:real^M->bool t:real^N->bool. (s PCROSS t) homeomorphic (t PCROSS s)
      #|  \\z:real^((M,N)finite_sum,P)finite_sum.\n        pastecart (fstcart(fstcart z))\n                  (pastecart (sndcart(fstcart z)) (sndcart z))
      #|  \\z:real^(M,(N,P)finite_sum)finite_sum.\n        pastecart (pastecart (fstcart z) (fstcart(sndcart z)))\n                  (sndcart(sndcart z))
      #|  !s:real^M->bool t:real^N->bool u:real^P->bool.\n        (s PCROSS (t PCROSS u)) homeomorphic ((s PCROSS t) PCROSS u)
      #|  !c. &0 < c\n       ==> !s t. (IMAGE (\\x. c % x) s) homeomorphic t <=> s homeomorphic t
      #|  !c. &0 < c\n       ==> !s t. s homeomorphic (IMAGE (\\x. c % x) t) <=> s homeomorphic t
      #|  g:real^N->real^M
      #|  f:real^M->real^N
      #|  !s:real^M->bool t:real^N->bool.\n        subspace s /\\ subspace t /\\ dim s = dim t ==> s homeomorphic t
      #|  t:real^N->bool
      #|  s:real^M->bool
      #|  !s:real^M->bool t:real^N->bool.\n        FINITE s /\\ FINITE t ==> (s homeomorphic t <=> CARD s = CARD t)
      #|  !s:real^M->bool t:real^N->bool.\n        FINITE s \\/ FINITE t\n        ==> (s homeomorphic t <=> FINITE s /\\ FINITE t /\\ CARD s = CARD t)
      #|  FINITE(t:real^N->bool)
