      #|  min (inv(&(SUC n) + &1)) (dist(x:real^M,a))
      #|  x:real^M
      #|  n:num
      #|  &1
      #|  ?x. (!n. x n IN s /\\ ~(x n = a) /\\ dist(x n,a) < inv(&n + &1) /\\\n             e <= dist((f:real^M->real^N) (x n),f a)) /\\\n        (!n. dist(x(SUC n),a) < dist(x n,a))
      #|  e:real
      #|  ~(p /\\ q) <=> p ==> ~q
      #|  e:real
      #|  x:num->real^M
      #|  (p ==> q) /\\ (q ==> r) /\\ (~p ==> ~r)\n    ==> (p <=> q) /\\ (p <=> r)
      #|  (!f:real^M->real^N s a.\n        f continuous at a within s <=>\n        !x. (!n. x n IN s DELETE a) /\\\n            (!m n. x m = x n <=> m = n) /\\\n            (x --> a) sequentially\n            ==> (f o x --> f a) sequentially) /\\\n   (!f:real^M->real^N s a.\n        (f continuous at a within s) <=>\n        !e x. &0 < e /\\\n              (!n. x n IN s DELETE a) /\\\n              (x --> a) sequentially /\\\n              (!m n. x m = x n <=> m = n)\n              ==> ?n. dist(f(x n),f a) < e)
      #|  !f:real^M->real^N a.\n        (f continuous at a) <=>\n        !e x. &0 < e /\\\n              (!n. ~(x n = a)) /\\\n              (x --> a) sequentially /\\\n              (!m n. x m = x n <=> m = n)\n              ==> ?n. dist(f(x n),f a) < e
      #|  !f:real^M->real^N a.\n        f continuous at a <=>\n        !x. (!n. ~(x n = a)) /\\\n            (!m n. x m = x n <=> m = n) /\\\n            (x --> a) sequentially\n            ==> (f o x --> f a) sequentially
      #|  !net f:A->real^N l.\n        f continuous net /\\ f(netlimit net) = l ==> (f --> l) net
      #|  !f net g l.\n        f continuous (at l) /\\ (g --> l) net ==> ((\\x. f(g x)) --> f l) net
      #|  (!x. P x ==> Q x) /\\ R ==> !x. P x ==> Q x /\\ R
      #|  !net f:real^M->real^N g:A->real^M l s.\n       f continuous (at l within s) /\\\n       (g --> l) net /\\ eventually (\\a. g a IN s) net\n       ==> ((\\x. f (g x)) --> f l) net
      #|  (f:real^M->real^N) o p o (r:num->num)
      #|  r:num->num
