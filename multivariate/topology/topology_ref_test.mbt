      #|  !m n. m <= n ==> (s:num->real^M->bool) n SUBSET s m
      #|  x:num->real^M
      #|  compact(s 0:real^M->bool)
      #|  x:num->real^M
      #|  y:real^N
      #|  !f:real^M->real^N s.\n        f continuous_on s 0 /\\\n        (!n. compact(s n)) /\\\n        (!n. s(SUC n) SUBSET s n)\n        ==> IMAGE f (INTERS {s n | n IN (:num)}) =\n            INTERS {IMAGE f (s n) | n IN (:num)}
      #|  !n. m <= n <=> n IN IMAGE (\\i. m + i) (:num)
      #|  (s:num->real^M->bool) o (\\i. m + i)
