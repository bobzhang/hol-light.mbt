      #|  e:real
      #|  (f:real^M->real^N) x
      #|  t:real^N->bool
      #|  !f:real^M->real^N x u.\n     f continuous (at x within u) <=>\n        !t. open t /\\ f(x) IN t\n            ==> ?s. open s /\\ x IN s /\\\n                    !x'. x' IN s /\\ x' IN u ==> f(x') IN t
      #|  ball((f:real^M->real^N) x,e)
      #|  e:real
      #|  (f:real^M->real^N) x
      #|  t:real^N->bool
      #|  !f:real^M->real^N x.\n     f continuous (at x) <=>\n        !t. open t /\\ f(x) IN t\n            ==> ?s. open s /\\ x IN s /\\\n                    !x'. x' IN s ==> f(x') IN t
      #|  x:real^M
      #|  ball((f:real^M->real^N) x,e) INTER t
      #|  e:real
      #|  x:real^M
      #|  (f:real^M->real^N) x
      #|  x:real^M
      #|  u:real^N->bool
      #|  !f:real^M->real^N s t.\n    IMAGE f s SUBSET t\n    ==> (f continuous_on s <=>\n         !u. open_in (subtopology euclidean t) u\n             ==> open_in (subtopology euclidean s) {x | x IN s /\\ f x IN u})
