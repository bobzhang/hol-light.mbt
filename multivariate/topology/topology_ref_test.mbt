      #|  !f:real^M->real^N g s t x.\n        homeomorphism (s,t) (f,g) /\\ x IN s\n        ==> connected_component (IMAGE f s) (f x) =\n            IMAGE f (connected_component s x)
      #|  (!x. x IN s ==> f x = g x) ==> {f x | x IN s} = {g x | x IN s}
