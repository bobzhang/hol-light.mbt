      #|  !f:real^M->real^N g s t.\n        f continuous_on s /\\ IMAGE f s = t /\\ (!x. x IN s ==> g(f x) = x) /\\\n        (!u. open_in (subtopology euclidean s) u\n             ==> open_in (subtopology euclidean t) (IMAGE f u))\n        ==> g continuous_on t
