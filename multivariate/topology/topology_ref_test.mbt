      #|  !f:real^M->real^N g s t u v.\n        homeomorphism (s,t) (f,g) /\\ u SUBSET s /\\ v SUBSET s\n        ==> (closed_in (subtopology euclidean (IMAGE f u)) (IMAGE f v) <=>\n             closed_in  (subtopology euclidean u) v)
      #|  t:real^N->bool
