      #|  u:real^M->bool
      #|  {x | P x} = UNIV DIFF {x | ~P x}
      #|  {x | P x /\\ ~Q x} = {x | P x} DIFF {x | P x /\\ Q x}
      #|  {n:num | p n IN u /\\ ~((f:real^M->real^N)(p n) = f x)}
      #|  p:num->real^M
      #|  !f:real^M->real^N s u x.\n      x limit_point_of s /\\\n      f continuous (at x within s) /\\ open u /\\ x IN u /\\\n      FINITE {z | z IN s INTER u /\\ f z =  f x}\n      ==> (f x) limit_point_of (IMAGE f s)
      #|  (?a. s SUBSET {a}) ==> FINITE s
      #|  (:real^M)
      #|  !f:real^M->real^N s x.\n      x limit_point_of s /\\\n      f continuous (at x within s) /\\\n      (!x y. x IN s /\\ y IN s /\\ f x = f y ==> x = y)\n      ==> (f x) limit_point_of (IMAGE f s)
      #|  n + m:num <= r(n + m) ==> n <= r(n + m)
      #|  (s:num->real^M->bool)(r(n + m:num))
