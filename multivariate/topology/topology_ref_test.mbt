      #|  !f:real^N->real^M s.\n     uniformly_continuous_map\n      (submetric euclidean_metric s,euclidean_metric) f <=>\n     f uniformly_continuous_on s
      #|  uniformly_continuous_map (real_euclidean_metric,euclidean_metric) lift
      #|  uniformly_continuous_map (euclidean_metric,real_euclidean_metric) drop
      #|  f:A->real = drop o lift o f
      #|  !m f:A->real.\n        uniformly_continuous_map(m,real_euclidean_metric) f <=>\n        uniformly_continuous_map(m,euclidean_metric) (lift o f)
      #|  !m f:A->real^1.\n        uniformly_continuous_map(m,euclidean_metric) f <=>\n        uniformly_continuous_map(m,real_euclidean_metric) (drop o f)
      #|  f:real^1->A = (f o lift) o drop
      #|  !m f:real^1->A.\n        uniformly_continuous_map(euclidean_metric,m) f <=>\n        uniformly_continuous_map(real_euclidean_metric,m) (f o lift)
      #|  !m f:real->A.\n        uniformly_continuous_map(real_euclidean_metric,m) f <=>\n        uniformly_continuous_map(euclidean_metric,m) (f o drop)
      #|  !f:real^M->real^N g:real^M->real^P s.\n        g continuous_on s /\\\n        (!x y. x IN s /\\ y IN s ==> dist(f x,f y) <= dist(g x,g y))\n        ==> f continuous_on s
      #|  !f s. f uniformly_continuous_on s ==> f continuous_on s
      #|  !f s. (!x. x IN s ==> f continuous (at x)) ==> f continuous_on s
      #|  !f s. f continuous_on s <=> !x. x IN s ==> f continuous (at x within s)
      #|  !f (s:real^N->bool).\n        f continuous_on s <=> !x. x IN s ==> (f --> f(x)) (at x within s)
      #|  !f:real^M->real^N s.\n      open s ==> (f continuous_on s <=> (!x. x IN s ==> f continuous (at x)))
      #|  !f:real^M->real^N a s t.\n        a IN t /\\ open_in (subtopology euclidean s) t\n        ==> (f continuous (at a within t) <=> f continuous (at a within s))
      #|  !f s t x. f continuous (at x within s) /\\ t SUBSET s\n             ==> f continuous (at x within t)
      #|  !f s t. f continuous_on s /\\ t SUBSET s ==> f continuous_on t
      #|  !f s t. f uniformly_continuous_on s /\\ t SUBSET s\n           ==> f uniformly_continuous_on t
      #|  !f:real^M->real^N s x.\n        f continuous_on s /\\ x IN interior(s) ==> f continuous at x
      #|  !f g s. (!x. x IN s ==> f(x) = g(x)) /\\ f continuous_on s\n           ==> g continuous_on s
      #|  !f g s.\n        (!x. x IN s ==> f x = g x) /\\ f uniformly_continuous_on s\n        ==> g uniformly_continuous_on s
      #|  !P f g:real^M->real^N s.\n        (!x. x IN s ==> P x)\n        ==> ((\\x. if P x then f x else g x) continuous_on s <=>\n             f continuous_on s)
      #|  !P f g:real^M->real^N s.\n        (!x. x IN s ==> P x)\n        ==> ((\\x. if P x then f x else g x) uniformly_continuous_on s <=>\n             f uniformly_continuous_on s)
      #|  !f:real^M->real^N a. f continuous_on {a}
      #|  !f:real^M->real^N. f continuous_on {}
      #|  !f:real^M->real^N s.\n     ~(?x. x limit_point_of s) ==> f continuous_on s
      #|  !f:real^M->real^N s. FINITE s ==> f continuous_on s
      #|  !f:real^M->real^N.\n        (!x y. x IN s /\\ y IN s ==> dist(f x,f y) <= dist(x,y))\n        ==> f continuous_on s
      #|  !f:real^M->real^N.\n        (!x y. x IN s /\\ y IN s ==> dist(f x,f y) = dist(x,y))\n        ==> f continuous_on s
      #|  &0 <= x ==> &0 < x + &1
      #|  &1 / (&m + &1)
      #|  m:num
      #|  n:num
      #|  n:num
      #|  y:num->real^N
      #|  &0 <= n ==> &0 < n + &1
      #|  &1 / (&n + &1)
      #|  n:num
      #|  e:real
      #|  !f s a:real^N.\n        f continuous (at a within s) <=>\n                !x. (!n. x(n) IN s) /\\ (x --> a) sequentially\n                     ==> ((f o x) --> f(a)) sequentially
      #|  !f a:real^N.\n        f continuous (at a) <=>\n              !x. (x --> a) sequentially\n                  ==> ((f o x) --> f(a)) sequentially
      #|  !f s:real^N->bool.\n        f continuous_on s <=>\n              !x a. a IN s /\\ (!n. x(n) IN s) /\\ (x --> a) sequentially\n                    ==> ((f o x) --> f(a)) sequentially
      #|  inv(&m + &1)
      #|  dist(x - y:real^N,vec 0) = dist(y,x)
      #|  :real
      #|  :real
