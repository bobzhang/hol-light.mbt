  let t4268 = @tactics.x_gen_tac(@parser.parse_term("y:real^N"))
  let t4267 = @simp.asm_rewrite_tac(@list.List([@sets.surjective_image()]))
  let t4266 = @simp.rewrite_tac(
    @list.List([
      @sets.set_rule(
        @parser.parse_term("UNIV = IMAGE f UNIV <=> !y. ?x. f x = y"),
      ),
    ]),
  )
  let t4265 = @simp.simp_tac(
    @list.List([
      @vectors.norm_eq_0(),
      @real.real_mul_rinv(),
      @vectors.vector_mul_lid(),
    ]),
  )
  let t4271 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(
                @tactics.then_tac(
                  @simp.rewrite_tac(
                    @list.List([
                      @sets.image_clauses(),
                      @vectors.vector_mul_assoc(),
                      @vectors.vector_mul_rzero(),
                      @lists.map(),
                    ]),
                  ),
                  t4265,
                ),
                @tactics.gen_tac,
              ),
              @tactics.disch_tac,
            ),
            t4266,
          ),
          t4267,
        ),
        t4268,
      ),
      t4269,
    ),
    t4270,
  )
  let pth = @tactics.prove(
    @parser.parse_term(
      "!a:real^N. ~(a = vec 0)\n                ==> vec 0 = norm(a) % vec 0 /\\\n                    a = norm(a) % inv(norm a) % a /\\\n                    {} = IMAGE (\\x. norm(a) % x) {} /\\\n                    {} = IMAGE (IMAGE (\\x. norm(a) % x)) {} /\\\n                    (:real^N) = IMAGE (\\x. norm(a) % x) (:real^N) /\\\n                    (:real^N->bool) =\n                    IMAGE (IMAGE (\\x. norm(a) % x)) (:real^N->bool) /\\\n                    [] = MAP (\\x. norm(a) % x) []",
    ),
    t4271,
  )
  let t4277 = @simp.asm_simp_tac(
    @list.List([@vectors.surjective_scaling(), @vectors.norm_eq_0()]),
  )
  let t4276 = @tactics.disch_then(@tactics.match_mp_tac)
  let t4275 = @simp.asm_rewrite_tac(@list.empty())
  let t4273 = @parser.parse_type("C")
  let t4274 = @kernel.inst_type(
    @list.List([(@parser.parse_type("real^1"), t4273)]),
    @vectors.quantify_surjection_higher_thm(),
  )
  let t4278 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.mp_tac(
          @bool.ispec(
            @parser.parse_term("\\x:real^N. norm(a:real^N) % x"),
            t4274,
          ),
        ),
        t4275,
      ),
      t4276,
    ),
    t4277,
  )
  let t4279 = @list.List([
    @meson.asm_meson_tac(
      @list.List([
        @vectors.norm_eq_0(),
        @calc_rat.real_field(
          @parser.parse_term("~(x = &0) ==> x * inv x * a = a"),
        ),
      ]),
    ),
    t4278,
  ])
  let t4272 = @tactics.match_mp_tac(
    @class.taut(
      @parser.parse_term("(a /\\ b) /\\ c /\\ d ==> (a /\\ b /\\ c) /\\ d"),
    ),
  )
  let t4280 = @tactics.thenl(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(@tactics.gen_tac, @tactics.disch_tac),
        t4272,
      ),
      @tactics.conj_tac,
    ),
    t4279,
  )
  let qth = @tactics.prove(
    @parser.parse_term(
      "!a:real^N.\n        ~(a = vec 0)\n        ==> ((!P. (!r:real. P r) <=> (!r. P(norm a * r))) /\\\n             (!P. (?r:real. P r) <=> (?r. P(norm a * r))) /\\\n             (!P. (!x:real^N. P x) <=> (!x. P (norm(a) % x))) /\\\n             (!P. (?x:real^N. P x) <=> (?x. P (norm(a) % x))) /\\\n             (!Q. (!s:real^N->bool. Q s) <=>\n                  (!s. Q(IMAGE (\\x. norm(a) % x) s))) /\\\n             (!Q. (?s:real^N->bool. Q s) <=>\n                  (?s. Q(IMAGE (\\x. norm(a) % x) s))) /\\\n             (!Q. (!s:(real^N->bool)->bool. Q s) <=>\n                  (!s. Q(IMAGE (IMAGE (\\x. norm(a) % x)) s))) /\\\n             (!Q. (?s:(real^N->bool)->bool. Q s) <=>\n                  (?s. Q(IMAGE (IMAGE (\\x. norm(a) % x)) s))) /\\\n             (!P. (!g:real^1->real^N. P g) <=>\n                  (!g. P ((\\x. norm(a) % x) o g))) /\\\n             (!P. (?g:real^1->real^N. P g) <=>\n                  (?g. P ((\\x. norm(a) % x) o g))) /\\\n             (!P. (!g:num->real^N. P g) <=>\n                  (!g. P ((\\x. norm(a) % x) o g))) /\\\n             (!P. (?g:num->real^N. P g) <=>\n                  (?g. P ((\\x. norm(a) % x) o g))) /\\\n             (!Q. (!l. Q l) <=> (!l. Q(MAP (\\x:real^N. norm(a) % x) l))) /\\\n             (!Q. (?l. Q l) <=> (?l. Q(MAP (\\x:real^N. norm(a) % x) l)))) /\\\n            ((!P. {x:real^N | P x} =\n                  IMAGE (\\x. norm(a) % x) {x | P(norm(a) % x)}) /\\\n             (!Q. {s:real^N->bool | Q s} =\n                  IMAGE (IMAGE (\\x. norm(a) % x))\n                       {s | Q(IMAGE (\\x. norm(a) % x) s)}) /\\\n             (!R. {l:(real^N)list | R l} =\n                  IMAGE (MAP (\\x:real^N. norm(a) % x))\n                        {l | R(MAP (\\x:real^N. norm(a) % x) l)}))",
    ),
    t4280,
  )
  let t4284 = @simp.asm_simp_tac(
    @list.List([
      @vectors.norm_mul(),
      @real.real_abs_inv(),
      @vectors.real_abs_norm(),
      @realax.real_mul_linv(),
      @vectors.norm_eq_0(),
    ]),
  )
  let t4283 = @tactics.first_x_assum(@tactics.match_mp_tac)
  let t4282 = @simp.asm_simp_tac(@list.empty())
  let t4281 = @class.asm_cases_tac(@parser.parse_term("b:real^N = vec 0"))
  let t4285 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t4281),
        t4282,
      ),
      t4283,
    ),
    t4284,
