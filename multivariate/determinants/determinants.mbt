        "!A:real^2^2. rotation_matrix A <=>\n                A$1$1 pow 2 + A$2$1 pow 2 = &1 /\\\n                A$1$1 = A$2$2 /\\ A$1$2 = --(A$2$1)",
      ),
      t3309,
    ),
  )
}

