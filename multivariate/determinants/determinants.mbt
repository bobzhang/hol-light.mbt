///|
/// INVERTIBLE_NEARBY
fn step_65() -> Unit raise {
  let t678 = @meson.asm_meson_tac(@list.List([@vectors.invertible_mat()]))
  let t677 = @simp.rewrite_tac(
    @list.List([@equal.gsym(@vectors.matrix_eq_0()), @vectors.matrix_inv_eq_0()]),
  )
  let t676 = @simp.simp_tac(
    @list.List([
      @real.real_lt_inv_eq(),
      @vectors.onorm_pos_lt(),
      @vectors.matrix_vector_mul_linear(),
    ]),
  )
  let t675 = @list.List([
    @tactics.all_tac,
    @meson.asm_meson_tac(@list.List([invertible_nearby_onorm()])),
  ])
  let t674 = @tactics.exists_tac(
    @parser.parse_term("inv(onorm(\\x. matrix_inv(A:real^N^N) ** x))"),
  )
  let t679 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.thenl(
          @tactics.then_tac(
            @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t674),
            @tactics.conj_tac,
          ),
          t675,
        ),
        t676,
      ),
      t677,
    ),
    t678,
  )
  invertible_nearby_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!A:real^N^N.\n        invertible A\n        ==> ?e. &0 < e /\\ !B. onorm(\\x. (B - A) ** x) < e ==> invertible B",
      ),
      t679,
    ),
  )
}

