    @list.List([
      @arith.le(),
      @int.arith_rule(
        @parser.parse_term("~(1 <= i /\\ i <= SUC k) ==> ~(i = SUC k)"),
      ),
    ]),
  )
  let t306 = @list.List([
    @meson.asm_meson_tac(@list.List([@arith.le()])),
    t305,
    t304,
  ])
  let t302 = @tactics.repeat_tac(@tactics.strip_tac)
  let t300 = @parser.parse_term("h:num->num")
  let t301 = @tactics.map_every(
    @tactics.x_gen_tac,
    @list.List([@parser.parse_term("y:num"), t300]),
  )
  let t299 = @simp.rewrite_tac(@list.List([@sets.in_elim_thm()]))
  let t298 = @tactics.conv_tac(@equal.redepth_conv(@pair.gen_beta_conv))
  let t307 = @tactics.thenl(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @simp.rewrite_tac(
              @list.List([@pair.forall_pair_thm(), @sets.in_elim_pair_thm()]),
            ),
            t298,
          ),
          t299,
        ),
        t301,
      ),
      t302,
    ),
    t306,
  )
  bounded_functions_bijections_1_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!p. p IN {(y,g) | y IN s /\\\n                     g IN {f | (!i. 1 <= i /\\ i <= k ==> f i IN s) /\\\n                               (!i. ~(1 <= i /\\ i <= k) ==> f i = i)}}\n       ==> (\\(y,g) i. if i = SUC k then y else g(i)) p IN\n             {f | (!i. 1 <= i /\\ i <= SUC k ==> f i IN s) /\\\n                  (!i. ~(1 <= i /\\ i <= SUC k) ==> f i = i)} /\\\n           (\\h. h(SUC k),(\\i. if i = SUC k then i else h(i)))\n            ((\\(y,g) i. if i = SUC k then y else g(i)) p) = p",
      ),
      t307,
    ),
  )
}

