///|
/// DET_LINEAR_ROWS_VSUM
fn step_44() -> Unit raise {
  let t403 = @simp.simp_tac(@list.List([@cart.cart_eq(), @cart.lambda_beta()]))
  let lemma = @tactics.prove(
    @parser.parse_term(
      "(lambda i. if i <= dimindex(:N) then x(i) else y(i)):real^N^N =\n     (lambda i. x(i))",
    ),
    t403,
  )
  let t407 = @simp.simp_tac(@list.empty())
  let t406 = @simp.asm_rewrite_tac(@list.List([@arith.le_refl(), lemma]))
  let t404 = @parser.parse_term("dimindex(:N)")
  let t405 = @tactics.mp_tac(
    @bool.specl(
      @list.List([@parser.parse_term("s:num->bool"), t404]),
      det_linear_rows_vsum_lemma(),
    ),
  )
  let t408 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t405),
      t406,
    ),
    t407,
  )
  det_linear_rows_vsum_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!s a.\n         FINITE s\n         ==> det((lambda i. vsum s (a i)):real^N^N) =\n             sum {f | (!i. 1 <= i /\\ i <= dimindex(:N) ==> f(i) IN s) /\\\n                      !i. ~(1 <= i /\\ i <= dimindex(:N)) ==> f(i) = i}\n                 (\\f. det((lambda i. a i (f i)):real^N^N))",
      ),
      t408,
    ),
  )
}

