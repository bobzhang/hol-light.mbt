  let t293 = @tactics.repeat_tac(@tactics.strip_tac)
  let t292 = @simp.simp_tac(
    @list.List([@vectors.vsum_clauses(), @iterate.sum_clauses(), det_row_add()]),
  )
  let t291 = @tactics.match_mp_tac(@sets.finite_induct_strong())
  let t290 = @simp.rewrite_tac(@list.List([@theorems.right_forall_imp_thm()]))
  let t289 = @simp.once_rewrite_tac(@list.List([@theorems.imp_conj()]))
  let t297 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(
                @tactics.then_tac(
                  @tactics.then_tac(@tactics.gen_tac, @tactics.gen_tac),
                  t289,
                ),
                t290,
              ),
              t291,
            ),
            t292,
          ),
          t293,
        ),
        t294,
      ),
      t295,
    ),
    t296,
  )
  det_linear_row_vsum_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!a c s k.\n         FINITE s /\\ 1 <= k /\\ k <= dimindex(:N)\n         ==> det((lambda i. if i = k then vsum s a else c i):real^N^N) =\n             sum s\n               (\\j. det((lambda i. if i = k then a(j) else c i):real^N^N))",
      ),
      t297,
    ),
  )
}

