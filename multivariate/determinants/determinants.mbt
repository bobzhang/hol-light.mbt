/// reflect_along
fn step_286() -> Unit raise {
  reflect_along_c.set(
    @pair.new_definition(
      @parser.parse_term(
        "reflect_along v (x:real^N) = x - (&2 * (x dot v) / (v dot v)) % v",
      ),
    ),
  )
}

