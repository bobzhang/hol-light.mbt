      @tactics.then_tac(
        @simp.once_rewrite_tac(
          @list.List([@equal.gsym(@vectors.matrix_neg_sub())]),
        ),
        t1209,
      ),
      t1210,
    ),
    t1211,
  )
  eigenvalues_characteristic_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!A:real^N^N c.\n        (?v. ~(v = vec 0) /\\ A ** v = c % v) <=> det(c %% mat 1 - A) = &0",
      ),
