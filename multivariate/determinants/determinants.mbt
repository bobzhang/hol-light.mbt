      "!f:real^M->real^N.\n        linear f /\\ (!y. ?x. f x = y)\n         ==> (vec 0 = f(vec 0) /\\\n              {} = IMAGE f {} /\\\n              {} = IMAGE (IMAGE f) {} /\\\n              (:real^N) = IMAGE f (:real^M) /\\\n              (:real^N->bool) = IMAGE (IMAGE f) (:real^M->bool) /\\\n              [] = MAP f []) /\\\n             ((!P. (!x. P x) <=> (!x. P (f x))) /\\\n              (!P. (?x. P x) <=> (?x. P (f x))) /\\\n              (!Q. (!s. Q s) <=> (!s. Q (IMAGE f s))) /\\\n              (!Q. (?s. Q s) <=> (?s. Q (IMAGE f s))) /\\\n              (!Q. (!s. Q s) <=> (!s. Q (IMAGE (IMAGE f) s))) /\\\n              (!Q. (?s. Q s) <=> (?s. Q (IMAGE (IMAGE f) s))) /\\\n              (!P. (!g:real^1->real^N. P g) <=> (!g. P (f o g))) /\\\n              (!P. (?g:real^1->real^N. P g) <=> (?g. P (f o g))) /\\\n              (!P. (!g:num->real^N. P g) <=> (!g. P (f o g))) /\\\n              (!P. (?g:num->real^N. P g) <=> (?g. P (f o g))) /\\\n              (!Q. (!l. Q l) <=> (!l. Q(MAP f l))) /\\\n              (!Q. (?l. Q l) <=> (?l. Q(MAP f l)))) /\\\n             ((!P. {x | P x} = IMAGE f {x | P(f x)}) /\\\n              (!Q. {s | Q s} = IMAGE (IMAGE f) {s | Q(IMAGE f s)}) /\\\n              (!R. {l | R l} = IMAGE (MAP f) {l | R(MAP f l)}))",
    ),
    t4358,
  )
  geom_equal_dimension_rule_c.set(fn(
    x4359 : @kernel.Thm,
  ) -> ((@kernel.Thm) -> @kernel.Thm raise) raise {
    let dth = x4359
    fn(x4360 : @kernel.Thm) -> @kernel.Thm raise {
      let th = x4360
      let eth = exists_genvar_rule(@drule.match_mp(bth)(dth))
      let (f, bod) = @basics.dest_exists(@kernel.concl(eth))
      let (lsth, neth) = @bool.conj_pair(@kernel.assume_rule(bod))
      let (cth, qth) = @bool.conj_pair(@drule.match_mp(pth)(lsth))
      let t4361 = @equal.subs_conv(@bool.conjuncts_rule(cth))
      let th1 = @equal.conv_rule(
        @equal.thenc(@vectors.expand_quants_conv(qth), t4361),
        th,
      )
      let t4362 = @bool.conjuncts_rule(lsth).prepend(neth)
      let ith = linear_invariants(f)(t4362)
      let th2 = @simp.gen_rewrite_rule(
        fn(
          x4369 : (@kernel.Term) -> @kernel.Thm raise,
        ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
          (fn(
            x4363 : (@kernel.Term) -> @kernel.Thm raise,
          ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
            let s4364 = @equal.rand_conv(x4363)
            fn(x4365 : @kernel.Term) -> @kernel.Thm raise { s4364(x4365) }
          })(
            (fn(
              x4366 : (@kernel.Term) -> @kernel.Thm raise,
            ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
              let s4367 = @equal.redepth_conv(x4366)
              fn(x4368 : @kernel.Term) -> @kernel.Thm raise { s4367(x4368) }
            })(x4369),
          )
        },
        @list.List([@theorems.beta_thm(), ith]),
      )(th1)
      let th3 = @bool.gen(f, @bool.disch(bod, th2))
      @bool.mp(
        @equal.conv_rule(@simp.rewr_conv(@theorems.left_forall_imp_thm()), th3),
        eth,
      )
    }
  })
}

///|
let geom_equal_dimension_rule_c : @lib.Cell[
  (@kernel.Thm) -> ((@kernel.Thm) -> @kernel.Thm raise) raise,
] = @lib.Cell::new("GEOM_EQUAL_DIMENSION_RULE")

///|
/// `GEOM_EQUAL_DIMENSION_RULE`
pub fn geom_equal_dimension_rule(
  x : @kernel.Thm,
) -> ((@kernel.Thm) -> @kernel.Thm raise) raise {
  geom_equal_dimension_rule_c.get()(x)
}

