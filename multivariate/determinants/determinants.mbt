  let lth = @tactics.prove(
    @parser.parse_term(
      "(!b:real^N. ~(b = vec 0) ==> (P(b) <=> Q(inv(norm b) % b)))\n     ==> P(vec 0) /\\ (!b. norm(b) = &1 ==> Q b) ==> (!b. P b)",
    ),
    t4285,
  )
  geom_normalize_rule_c.set(fn(
    x4286 : @list.List[String],
  ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    let avoid = x4286
    fn(x4287 : @kernel.Term) -> @kernel.Thm raise {
      let tm = x4287
      let (x, tm0) = @basics.dest_forall(tm)
      let cth = @bool.undisch(@bool.ispec(x, pth))
      let vth = @bool.undisch(@bool.ispec(x, qth))
      let th1 = @simp.once_rewrite_conv(@list.List([cth]))(tm0)
      let th2 = @equal.conv_rule(
        @equal.rand_conv(@vectors.partial_expand_quants_conv(avoid, vth)),
        th1,
      )
      let th3 = scaling_theorems(x)
      let th3_p = @lib.end_itlist(
        @bool.conj,
        @lib.map(
          fn(x4288 : @kernel.Thm) -> @kernel.Thm raise {
            let th = x4288
            let (avs, _) = @basics.strip_forall(@kernel.concl(th))
            let gvs = @lib.map(
              fn(x4291 : @kernel.Term) -> @kernel.Term raise {
                (fn(x4289 : @kernel.HolType) -> @kernel.Term raise {
                  @basics.genvar(x4289)
                })(
                  (fn(x4290 : @kernel.Term) -> @kernel.HolType raise {
                    @kernel.type_of(x4290)
                  })(x4291),
                )
              },
              avs,
            )
            @bool.genl(gvs, @bool.specl(gvs, th))
          },
          @bool.conjuncts_rule(th3),
        ),
      )
      let th4 = @simp.gen_rewrite_rule(
        fn(
          x4298 : (@kernel.Term) -> @kernel.Thm raise,
        ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
          (fn(
            x4292 : (@kernel.Term) -> @kernel.Thm raise,
          ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
            let s4293 = @equal.rand_conv(x4292)
            fn(x4294 : @kernel.Term) -> @kernel.Thm raise { s4293(x4294) }
          })(
            (fn(
              x4295 : (@kernel.Term) -> @kernel.Thm raise,
            ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
              let s4296 = @equal.redepth_conv(x4295)
              fn(x4297 : @kernel.Term) -> @kernel.Thm raise { s4296(x4297) }
            })(x4298),
          )
        },
        @list.List([@theorems.beta_thm(), th3_p]),
      )(th2)
      let t4299 = @bool.gen(x, @bool.disch_all(th4))
      @drule.match_mp(lth)(t4299)
    }
  })
}

