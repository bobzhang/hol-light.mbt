/// GEOM_DROP_DIMENSION_RULE
fn step_330() -> Unit raise {
  let t4333 = @meson.meson_tac(
    @list.List([@vectors.preserves_norm_injective()]),
  )
  let oth = @tactics.prove(
    @parser.parse_term(
      "!f:real^M->real^N.\n          linear f /\\ (!x. norm(f x) = norm x)\n          ==> linear f /\\\n              (!x y. f x = f y ==> x = y) /\\\n              (!x. norm(f x) = norm x)",
    ),
    t4333,
  )
  let t4334 = @simp.rewrite_tac(
    @list.List([
      @sets.image_clauses(),
      @lists.map(),
      @equal.gsym(@vectors.linear_0()),
    ]),
  )
  let cth = @tactics.prove(
    @parser.parse_term(
      "linear(f:real^M->real^N)\n     ==> vec 0 = f(vec 0) /\\\n         {} = IMAGE f {} /\\\n         {} = IMAGE (IMAGE f) {} /\\\n         [] = MAP f []",
    ),
    t4334,
  )
  geom_drop_dimension_rule_c.set(fn(
    x4335 : @kernel.Thm,
  ) -> ((@kernel.Thm) -> @kernel.Thm raise) raise {
    let dth = x4335
    fn(x4336 : @kernel.Thm) -> @kernel.Thm raise {
      let th = x4336
      let ath = @bool.gen_all(th)
      let eth = @drule.match_mp(@vectors.isometry_univ_univ())(dth)
      let avoid = @basics.variables(@kernel.concl(th))
      let (f, bod) = @basics.dest_exists(@kernel.concl(eth))
      let fimage = @basics.list_mk_icomb("IMAGE", @list.List([f]))
      let fmap = @basics.list_mk_icomb("MAP", @list.List([f]))
      let fcompose = @basics.list_mk_icomb("o", @list.List([f]))
      let fimage2 = @basics.list_mk_icomb("IMAGE", @list.List([fimage]))
      let (lin, iso) = @bool.conj_pair(@kernel.assume_rule(bod))
      let olduniv = @kernel.rand(@kernel.rand(@kernel.concl(dth)))
      let newuniv = @kernel.rand(@equal.lhand(@kernel.concl(dth)))
      let oldty = @basics.dest_fun_ty(@kernel.type_of(olduniv)).0
      let newty = @basics.dest_fun_ty(@kernel.type_of(newuniv)).0
      let newvar : (@kernel.Term) -> @kernel.Term raise = fn(
        x4337 : @kernel.Term,
      ) -> @kernel.Term raise {
        let v = x4337
        let (n, t) = @kernel.dest_var(v)
        @kernel.variant(
          avoid,
          @kernel.mk_var(n, @basics.tysubst(@list.List([(newty, oldty)]), t)),
        )
      }
      let newterm : (@kernel.Term) -> @kernel.Term raise = fn(
        x4338 : @kernel.Term,
      ) -> @kernel.Term raise {
        let v_1 = x4338
        try {
          let v_p = newvar(v_1)
          @lib.tryfind(
            fn(x4339 : @kernel.Term) -> @kernel.Term raise {
              let f_1 = x4339
              @kernel.mk_comb(f_1, v_p)
            },
            @list.List([f, fimage, fmap, fcompose, fimage2]),
          )
        } catch {
          Failure(_) => v_1
          e => raise e
        }
      }
      let specrule : (@kernel.Thm) -> @kernel.Thm raise = fn(
        x4340 : @kernel.Thm,
      ) -> @kernel.Thm raise {
        let th_1 = x4340
        let v_2 = @basics.dest_forall(@kernel.concl(th_1)).0
        @bool.spec(newterm(v_2), th_1)
      }
      let sth = @equal.subs(
        @bool.conjuncts_rule(@drule.match_mp(cth)(lin)),
        ath,
      )
      let t4341 = @lib.repeat(specrule, sth)
      let fth = @equal.subs(
        @list.List([@equal.sym(@drule.match_mp(@vectors.linear_0())(lin))]),
        t4341,
      )
      let t4342 = @kernel.assume_rule(bod)
      let thps = @bool.conjuncts_rule(@drule.match_mp(oth)(t4342))
      let th5 = linear_invariants(f)(thps)
      let th6 = @simp.gen_rewrite_rule(
        fn(
          x4343 : (@kernel.Term) -> @kernel.Thm raise,
        ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
          let s4344 = @equal.redepth_conv(x4343)
          fn(x4345 : @kernel.Term) -> @kernel.Thm raise { s4344(x4345) }
        },
        @list.List([th5]),
      )(fth)
      let th7 = @bool.prove_hyp(eth, @bool.simple_choose(f, th6))
      @bool.genl(
        @lib.map(newvar, @basics.strip_forall(@kernel.concl(ath)).0),
        th7,
      )
    }
  })
}

