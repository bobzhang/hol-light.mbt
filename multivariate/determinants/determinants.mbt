///|
/// REFLECT_ALONG_ADD
fn step_287() -> Unit raise {
  let t3761 = @simp.rewrite_tac(@list.List([@vectors.dot_ladd()]))
  let t3760 = @simp.rewrite_tac(
    @list.List([
      reflect_along(),
      @vectors.vector_arith(
        @parser.parse_term(
          "x - a % v + y - b % v:real^N = (x + y) - (a + b) % v",
        ),
      ),
    ]),
  )
  let t3762 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), t3760),
            @tactics.ap_term_tac,
          ),
          @tactics.ap_thm_tac,
        ),
        @tactics.ap_term_tac,
      ),
      t3761,
    ),
    @calc_rat.real_arith_tac,
  )
  reflect_along_add_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!v x y:real^N.\n      reflect_along v (x + y) = reflect_along v x + reflect_along v y",
      ),
      t3762,
    ),
  )
}

