///|
/// GEOM_NORMALIZE_RULE
fn step_323() -> Unit raise {
  let t4270 = @simp.asm_simp_tac(
    @list.List([
      @vectors.vector_mul_assoc(),
      @vectors.norm_eq_0(),
      @real.real_mul_rinv(),
      @vectors.vector_mul_lid(),
