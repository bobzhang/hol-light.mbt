      #|  !s. is_realinterval s <=>\n        s = {} \\/\n        s = (:real) \\/\n        (?a. s = {x | a < x}) \\/\n        (?a. s = {x | a <= x}) \\/\n        (?b. s = {x | x <= b}) \\/\n        (?b. s = {x | x < b}) \\/\n        (?a b. s = {x | a < x /\\ x < b}) \\/\n        (?a b. s = {x | a < x /\\ x <= b}) \\/\n        (?a b. s = {x | a <= x /\\ x < b}) \\/\n        (?a b. s = {x | a <= x /\\ x <= b})
      #|  is_realinterval {} /\\\n   is_realinterval (:real) /\\\n   (!a. is_realinterval {x | a < x}) /\\\n   (!a. is_realinterval {x | a <= x}) /\\\n   (!b. is_realinterval {x | x < b}) /\\\n   (!b. is_realinterval {x | x <= b}) /\\\n   (!a b. is_realinterval {x | a < x /\\ x < b}) /\\\n   (!a b. is_realinterval {x | a < x /\\ x <= b}) /\\\n   (!a b. is_realinterval {x | a <= x /\\ x < b}) /\\\n   (!a b. is_realinterval {x | a <= x /\\ x <= b})
