  }, t6616), @tactics.ants_tac), t6623), t6624), t6625), t6629), t6630), t6631), @tactics.conj_tac), t6635), t6639), t6643), t6644), @tactics.conj_tac), t6652), t6653), t6654), t6655), @tactics.conj_tac), t6674), @tactics.all_tac])
  let t6606 = @tactics.mp_tac(@bool.ispec(@parser.parse_term("(g:complex->real^N) o (h:real^(1,1)finite_sum->complex)"), @measure.fubini_tonelli()))
  let t6605 = @list.List([@tactics.asm_tac(@sets.set_tac)(@list.empty()), @tactics.all_tac])
  let t6604 = @tactics.subgoal_then(@parser.parse_term("IMAGE (h:real^(1,1)finite_sum->complex) UNIV = UNIV /\\\n                IMAGE (k:complex->real^(1,1)finite_sum) UNIV = UNIV"), @tactics.strip_assume_tac)
  let t6602 = @simp.simp_tac(@list.List([@cart.cart_eq(), @cart.lambda_beta(), @cart.dimindex_finite_sum(), @cart.dimindex_2(), @calc_num.arith(), @cart.dimindex_1()]))
  let t6603 = @list.List([@tactics.then_tac(@tactics.map_every(fn(x6599 : String) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise) raise {
    let s6600 = @simp.expand_tac(x6599)
    fn(x6601 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise {
      s6600(x6601)
    }
  }, @list.List(["h", "k"])), t6602), @tactics.all_tac])
  let t6598 = @tactics.subgoal_then(@parser.parse_term("(!x:complex. h(k x) = x) /\\ (!y:real^(1,1)finite_sum. k(h y) = y)"), @tactics.strip_assume_tac)
  let t6597 = @simp.abbrev_tac(@parser.parse_term("k:complex->real^(1,1)finite_sum = \\x. lambda i. x$i"))
  let t6596 = @simp.abbrev_tac(@parser.parse_term("h:real^(1,1)finite_sum->complex = \\x. lambda i. x$i"))
  let t6595 = @simp.abbrev_tac(@parser.parse_term("g = \\x. if &0 <= Re x /\\ &0 <= Im x /\\ Im x <= &2 * pi\n            then Re x % (f:complex->real^N) (Cx(Re x) * cexp(ii * Cx(Im x)))\n            else vec 0"))
  let t6748 = @tactics.thenl(@tactics.then_tac(@tactics.then_tac(@tactics.thenl(@tactics.then_tac(@tactics.then_tac(@tactics.thenl(@tactics.then_tac(@tactics.thenl(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), @tactics.disch_tac), t6595), t6596), t6597), t6598), t6603), t6604), t6605), t6606), @tactics.ants_tac), t6675), t6676), @tactics.binop_tac), t6747)
  fubini_tonelli_polar_c.set(@tactics.prove(@parser.parse_term("!f:complex->real^N.\n       f measurable_on (:complex)\n       ==> (f absolutely_integrable_on (:complex) <=>\n            negligible\n             {r | &0 <= drop r /\\\n                  ~((\\t. drop r % f(Cx(drop r) * cexp(ii * Cx(drop t))))\n                    absolutely_integrable_on interval[vec 0,lift(&2 * pi)])} /\\\n            (\\r. integral (interval[vec 0,lift(&2 * pi)])\n                  (\\t. drop r %\n                       lift(norm(f(Cx(drop r) * cexp(ii * Cx(drop t)))))))\n            integrable_on {r | &0 <= drop r})"), t6748))
}

