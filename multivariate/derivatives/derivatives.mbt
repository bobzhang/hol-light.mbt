  let t235 = @simp.asm_simp_tac(@list.List([@real.real_lt_mul2(), @vectors.norm_pos_le()]))
  let t234 = @simp.gen_rewrite_tac(fn(x231 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    let s232 = @equal.rand_conv(x231)
    fn(x233 : @kernel.Term) -> @kernel.Thm raise {
      s232(x233)
    }
  }, @list.List([@equal.gsym(@realax.real_mul_lid())]))
  let t230 = @simp.rewrite_tac(@list.List([@vectors.norm_mul(), @vectors.real_abs_norm()]))
  let t229 = @tactics.repeat_tac(@tactics.strip_tac)
  let t228 = @simp.asm_rewrite_tac(@list.List([@real.real_lt_min(), @real.real_lt_01()]))
  let t227 = @tactics.exists_tac(@parser.parse_term("min d (&1)"))
  let t226 = @tactics.disch_then(@tactics.x_choose_then(@parser.parse_term("d:real"))(@tactics.strip_assume_tac))
  let t225 = @simp.asm_rewrite_tac(@list.List([@vectors.dist(), @vectors.vector_sub_rzero()]))
  let t224 = @class.asm_cases_tac(@parser.parse_term("&0 < e"))
  let t223 = @tactics.x_gen_tac(@parser.parse_term("e:real"))
  let t222 = @tactics.match_mp_tac(@theorems.mono_forall())
  let t221 = @simp.rewrite_tac(@list.List([@topology.lim_within()]))
  let t236 = @tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), t221), t222), t223), t224), t225), t226), t227), t228), t229), t230), t234), t235)
  lim_mul_norm_within_c.set(@tactics.prove(@parser.parse_term("!f a s. (f --> vec 0) (at a within s)\n           ==> ((\\x. norm(x - a) % f(x)) --> vec 0) (at a within s)"), t236))
}

