pub fn path_connected_annulus() -> @kernel.Thm {
  path_connected_annulus_c.get()
}

///|
/// CONNECTED_ANNULUS
fn step_596() -> Unit raise {
  let t15438 = @simp.asm_simp_tac(@list.List([path_connected_annulus()]))
  let t15437 = @tactics.match_mp_tac(path_connected_imp_connected())
  let t15439 = @tactics.then_tac(
