        @tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), t7989),
        t7990,
      ),
      t7991,
    ),
    t7992,
  )
  separation_by_closed_intermediates_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!u s:real^N->bool.\n        ~connected(u DIFF s)\n        ==> ?t. closed_in (subtopology euclidean u) t /\\ t SUBSET s /\\\n                !c. closed_in (subtopology euclidean u) c /\\\n                    t SUBSET c /\\ c SUBSET s\n                    ==> ~connected(u DIFF c)",
      ),
      t7993,
    ),
  )
}

