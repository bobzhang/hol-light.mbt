      @list.List([
        @vectors.vector_arith(
          @parser.parse_term(
            "(&1 - x) % a + x % b:real^N = (&1 - y) % a + y % b <=>\n      (x - y) % (a - b) = vec 0",
          ),
        ),
      ]),
    ),
    t3453,
  )
  let t3452 = @simp.simp_tac(
    @list.List([
      @trivia.o_def(),
      @topology.continuous_on_const(),
      @vectors.lift_drop(),
      @topology.continuous_on_id(),
      @vectors.lift_sub(),
      @topology.continuous_on_sub(),
    ]),
  )
  let t3451 = @tactics.match_mp_tac(@topology.continuous_on_mul())
  let t3455 = @list.List([
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.match_mp_tac(@topology.continuous_on_add()),
          @tactics.conj_tac,
        ),
        t3451,
      ),
      t3452,
    ),
    t3454,
  ])
  let t3450 = @simp.rewrite_tac(
    @list.List([
      @topology.compact_interval(),
      @equal.gsym(@convex.segment_image_interval()),
    ]),
  )
  let t3449 = @tactics.match_mp_tac(@topology.homeomorphism_compact())
  let t3456 = @tactics.thenl(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t3449),
        t3450,
      ),
      @tactics.conj_tac,
    ),
    t3455,
  )
  homeomorphism_segment_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!a b:real^N.\n        ~(a = b)\n        ==> ?h. homeomorphism (interval[vec 0:real^1,vec 1],segment[a,b])\n                              ((\\t. (&1 - drop t) % a + drop t % b),h)",
      ),
      t3456,
    ),
  )
}

