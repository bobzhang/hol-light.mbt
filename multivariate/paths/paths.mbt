          t8182,
        ),
        t8183,
      ),
      t8184,
    ),
    t8185,
  )
  locally_connected_closed_unions_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!f:(real^N->bool)->bool.\n        FINITE f /\\ (!s. s IN f ==> closed s /\\ locally connected s)\n        ==> locally connected (UNIONS f)",
