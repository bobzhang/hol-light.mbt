///|
let homeomorphic_monotone_image_interval_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new(
  "HOMEOMORPHIC_MONOTONE_IMAGE_INTERVAL",
)

///|
/// `HOMEOMORPHIC_MONOTONE_IMAGE_INTERVAL`
pub fn homeomorphic_monotone_image_interval() -> @kernel.Thm {
  homeomorphic_monotone_image_interval_c.get()
}

