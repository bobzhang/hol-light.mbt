    @tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), t25497),
    t25498,
  )
  dimension_translation_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!a:real^N s. dimension(IMAGE (\\x. a + x) s) = dimension s",
      ),
      t25499,
    ),
  )
}

