  let t8178 = @tactics.match_mp_tac(locally_connected_closed_union_gen())
  let t8181 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t8178),
      t8179,
    ),
    t8180,
  )
  locally_connected_closed_union_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!s t:real^N->bool.\n        locally connected s /\\ locally connected t /\\ closed s /\\ closed t\n        ==> locally connected (s UNION t)",
      ),
      t8181,
    ),
  )
}

