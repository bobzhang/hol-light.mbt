    @tactics.exists_tac(@parser.parse_term("p:real^1->real^N")),
  )
  let t20635 = @simp.rewrite_tac(
    @list.List([@topology.topspace_euclidean_subtopology()]),
  )
  let t20634 = @tactics.match_mp_tac(@metric.homotopic_with_eq())
  let t20633 = @simp.rewrite_tac(@list.List([homotopic_paths()]))
  let t20642 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(
                @tactics.then_tac(
                  @tactics.repeat_tac(@tactics.strip_tac),
                  t20633,
                ),
                t20634,
              ),
              t20635,
            ),
            t20636,
          ),
          t20637,
        ),
        t20639,
      ),
      t20640,
    ),
    t20641,
  )
  homotopic_paths_eq_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!p:real^1->real^N q s.\n        path p /\\ path_image p SUBSET s /\\\n        (!t. t IN interval[vec 0,vec 1] ==> p(t) = q(t))\n        ==> homotopic_paths s p q",
      ),
      t20642,
    ),
  )
