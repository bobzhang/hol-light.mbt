///|
let covering_space_locally_homeomorphic_eq_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new(
  "COVERING_SPACE_LOCALLY_HOMEOMORPHIC_EQ",
)

///|
/// `COVERING_SPACE_LOCALLY_HOMEOMORPHIC_EQ`
pub fn covering_space_locally_homeomorphic_eq() -> @kernel.Thm {
  covering_space_locally_homeomorphic_eq_c.get()
}

///|
/// COVERING_SPACE_LOCALLY
fn step_989() -> Unit raise {
  let t27970 = @meson.meson_tac(@list.empty())
  let t27969 = @simp.rewrite_tac(@list.List([@topology.homeomorphism()]))
  let t27968 = @tactics.repeat_tac(
    @tactics.then_tac(
      @tactics.match_mp_tac(@theorems.mono_forall()),
      @tactics.gen_tac,
    ),
  )
  let t27971 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.mp_tac(covering_space_locally_homeomorphic()),
        t27968,
      ),
      t27969,
    ),
    t27970,
  )
  covering_space_locally_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!P Q p:real^M->real^N c s.\n        covering_space (c,p) s /\\ (!t. t SUBSET c /\\ P t ==> Q(IMAGE p t)) /\\\n        locally P c\n        ==> locally Q s",
      ),
      t27971,
    ),
  )
