    t15438,
  )
  connected_annulus_c.set(
    @tactics.prove(
      @parser.parse_term(
        "(!a:real^N r1 r2.\n        2 <= dimindex(:N)\n        ==> connected {x | r1 < norm(x - a) /\\ norm(x - a) < r2}) /\\\n   (!a:real^N r1 r2.\n        2 <= dimindex(:N)\n        ==> connected {x | r1 < norm(x - a) /\\ norm(x - a) <= r2}) /\\\n   (!a:real^N r1 r2.\n        2 <= dimindex(:N)\n        ==> connected {x | r1 <= norm(x - a) /\\ norm(x - a) < r2}) /\\\n   (!a:real^N r1 r2.\n        2 <= dimindex(:N)\n        ==> connected {x | r1 <= norm(x - a) /\\ norm(x - a) < r2})",
      ),
      t15439,
    ),
  )
}

