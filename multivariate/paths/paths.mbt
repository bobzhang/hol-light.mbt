  let t30074 = @list.List([
    @meson.asm_meson_tac(@list.List([covering_space_imp_continuous()])),
    t30073,
    t30072,
    t30071,
  ])
  let t30070 = @tactics.repeat_tac(@tactics.conj_tac)
  let t30069 = @tactics.match_mp_tac(
    @topology.homeomorphism_injective_open_map(),
  )
  let t30075 = @tactics.thenl(
    @tactics.then_tac(
      @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t30069),
      t30070,
    ),
    t30074,
  )
  covering_space_homeomorphism_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!p:real^M->real^N c s.\n        covering_space (c,p) s /\\ path_connected c /\\ simply_connected s\n        ==> ?q. homeomorphism (c,s) (p,q)",
      ),
      t30075,
    ),
  )
}

