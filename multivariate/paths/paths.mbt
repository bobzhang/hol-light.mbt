///|
let countable_path_components_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new(
  "COUNTABLE_PATH_COMPONENTS",
)

///|
/// `COUNTABLE_PATH_COMPONENTS`
pub fn countable_path_components() -> @kernel.Thm {
  countable_path_components_c.get()
}

///|
/// COUNTABLE_COMPONENTS
fn step_517() -> Unit raise {
  let t12611 = @simp.simp_tac(
    @list.List([@topology.components(), countable_connected_components()]),
  )
  countable_components_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!s:real^N->bool. locally connected s ==> COUNTABLE(components s)",
      ),
      t12611,
    ),
  )
}

