    @tactics.prove(
      @parser.parse_term(
        "!f f':real^M->real^N g g':real^N->real^P s t u.\n        homotopic_with (\\x. T)\n          (subtopology euclidean s,subtopology euclidean t) f f' /\\\n        homotopic_with (\\x. T)\n          (subtopology euclidean t,subtopology euclidean u) g g'\n        ==> homotopic_with (\\x. T)\n             (subtopology euclidean s,subtopology euclidean u)\n             (g o f) (g' o f')",
