  let t7411 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.gen_tac,
        @tactics.match_mp_tac(
          @simp.rewrite_rule(@list.List([@theorems.imp_conj()]))(
            @topology.locally_open_subset(),
          ),
        ),
      ),
      t7409,
    ),
    t7410,
  )
  open_in_imp_locally_path_connected_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!s:real^N->bool.\n        open_in (subtopology euclidean (affine hull s)) s\n        ==> locally path_connected s",
      ),
      t7411,
    ),
  )
}

