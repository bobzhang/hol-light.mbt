///|
/// COVERING_SPACE_COUNTABLE_SHEETS
fn step_1021() -> Unit raise {
  let t30150 = @meson.asm_meson_tac(
    @list.List([covering_space_fibre_no_limpt()]),
  )
  let t30149 = @simp.rewrite_tac(@list.List([@sets.in_elim_thm()]))
  let t30147 = @simp.once_rewrite_rule(
    @list.List([@equal.gsym(@class.contrapos_thm())]),
  )(@topology.uncountable_contains_limit_point())
  let t30148 = @tactics.match_mp_tac(@simp.rewrite_rule(@list.empty())(t30147))
  let t30151 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t30148),
      t30149,
    ),
    t30150,
  )
  covering_space_countable_sheets_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!p:real^M->real^N c s b.\n        covering_space (c,p) s ==> COUNTABLE {x | x IN c /\\ p x = b}",
      ),
      t30151,
    ),
  )
}

