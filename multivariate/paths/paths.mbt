    @tactics.prove(
      @parser.parse_term(
        "!f:real^M->real^N s.\n        (!x y. x IN s /\\ y IN s /\\ f x = f y ==> x = y)\n        ==> (f continuous_on s <=>\n             !t. compact t /\\ t SUBSET s ==> compact(IMAGE f t))",
      ),
      t10893,
    ),
  )
