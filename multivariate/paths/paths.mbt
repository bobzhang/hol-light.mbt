///|
/// dimension
fn step_920() -> Unit raise {
  dimension_c.set(
    @pair.new_definition(
      @parser.parse_term(
        "(dimension:(real^N->bool)->int) s =\n        if s = {} then --(&1)\n        else &(minimal n. (subtopology euclidean s) dimension_le &n)",
      ),
    ),
  )
}

