///|
/// OPEN_IN_IMP_LOCALLY_PATH_CONNECTED
fn step_366() -> Unit raise {
  let t7410 = @simp.simp_tac(
    @list.List([@convex.affine_imp_convex(), @convex.affine_affine_hull()]),
  )
