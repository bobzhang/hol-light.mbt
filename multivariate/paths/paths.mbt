      @parser.parse_term(
        "!s:real^N->bool a b e.\n        (?p n. p 0 = a /\\ p n = b /\\\n               (!i. i <= n ==> p i IN s) /\\\n               (!i. i < n ==> dist(p i,p(SUC i)) < e)) <=>\n        a IN s /\\ b IN s /\\\n        (!c. c SUBSET s /\\ a IN c /\\\n             (!x y. x IN c /\\ y IN s /\\ dist(x,y) < e ==> y IN c)\n             ==> b IN c)",
      ),
      t13160,
    ),
  )
}

