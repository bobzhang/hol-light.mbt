      @topology.in_interval_1(),
      @vectors.drop_vec(),
      @realarith.real_pos(),
      @realax.real_le_refl(),
    ]),
  )
  let t3529 = @simp.asm_rewrite_tac(@list.empty())
  let t3528 = @tactics.match_mp_tac(
    @sets.set_rule(
      @parser.parse_term(
        "(!x y. x IN s /\\ y IN s /\\ c x = c y\n           ==> x = y \\/ x = a /\\ y = b \\/ x = b /\\ y = a) /\\\n    a IN s /\\ b IN s\n    ==>  IMAGE c s DIFF {c a,c b} = IMAGE c (s DIFF {a,b})",
      ),
    ),
  )
  let t3527 = @tactics.repeat_tac(@tactics.strip_tac)
  let t3526 = @simp.rewrite_tac(
    @list.List([@topology.open_closed_interval_1(), path()]),
  )
  let t3531 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @simp.rewrite_tac(
              @list.List([
                simple_path(),
                path_image(),
                pathstart(),
                pathfinish(),
              ]),
            ),
            t3526,
          ),
          t3527,
        ),
        t3528,
      ),
      t3529,
    ),
    t3530,
  )
  simple_path_endless_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!c:real^1->real^N.\n        simple_path c\n        ==> path_image c DIFF {pathstart c,pathfinish c} =\n            IMAGE c (interval(vec 0,vec 1))",
      ),
      t3531,
    ),
  )
}

