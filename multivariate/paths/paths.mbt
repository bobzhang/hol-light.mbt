                                                    t34049,
                                                  ),
                                                  t34052,
                                                ),
                                                t34056,
                                              ),
                                              t34059,
                                            ),
                                            t34061,
                                          ),
                                          @tactics.strip_tac,
                                        ),
                                        t34066,
                                      ),
                                      t34067,
                                    ),
                                    t34070,
                                  ),
                                  @tactics.ants_tac,
                                ),
                                t34083,
                              ),
                              t34089,
                            ),
                            t34093,
                          ),
                          t34104,
                        ),
                        t34105,
                      ),
                      t34106,
                    ),
                    t34111,
                  ),
                  t34112,
                ),
                t34114,
              ),
              t34117,
            ),
            t34122,
          ),
          t34125,
        ),
        t34126,
      ),
      t34127,
    ),
    t34128,
  )
  has_size_eq_components_complements_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!s (t:real^N->bool) n.\n        (closed s /\\ closed t \\/ bounded s /\\ bounded t) /\\\n        s homeomorphic t\n        ==> (components((:real^N) DIFF s) HAS_SIZE n <=>\n             components((:real^N) DIFF t) HAS_SIZE n)",
      ),
      t34129,
    ),
  )
}

///|
let has_size_eq_components_complements_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new(
  "HAS_SIZE_EQ_COMPONENTS_COMPLEMENTS",
)

///|
/// `HAS_SIZE_EQ_COMPONENTS_COMPLEMENTS`
pub fn has_size_eq_components_complements() -> @kernel.Thm {
  has_size_eq_components_complements_c.get()
}

///|
/// HOMEOMORPHIC_SEPARATION
fn step_1097() -> Unit raise {
  let t34134 = @simp.asm_rewrite_tac(@list.empty())
  let t34133 = @tactics.match_mp_tac(has_size_eq_components_complements())
  let t34132 = @simp.rewrite_tac(@list.List([@equal.gsym(@sets.has_size())]))
  let t34131 = @simp.rewrite_tac(
    @list.List([
      @int.arith_rule(@parser.parse_term("c <= 1 <=> c = 0 \\/ c = 1")),
      @theorems.left_or_distrib(),
    ]),
  )
  let t34130 = @simp.rewrite_tac(
    @list.List([@topology.connected_eq_card_components()]),
  )
  let t34135 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t34130),
            t34131,
          ),
          t34132,
        ),
        @tactics.binop_tac,
      ),
      t34133,
    ),
    t34134,
  )
  homeomorphic_separation_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!s t. bounded s /\\ bounded t /\\ s homeomorphic t\n         ==> (connected((:real^N) DIFF s) <=> connected((:real^N) DIFF t))",
      ),
      t34135,
    ),
  )
}

///|
let homeomorphic_separation_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new(
  "HOMEOMORPHIC_SEPARATION",
)

///|
/// `HOMEOMORPHIC_SEPARATION`
pub fn homeomorphic_separation() -> @kernel.Thm {
  homeomorphic_separation_c.get()
}

