      @simp.rewrite_tac(@list.List([@topology.closed_in()])),
      t8653,
    ),
    t8654,
  )
  path_connected_from_closed_union_and_inter_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!s t:real^N->bool.\n        closed s /\\\n        closed t /\\\n        path_connected (s UNION t) /\\\n        path_connected (s INTER t)\n        ==> path_connected s /\\ path_connected t",
      ),
      t8655,
    ),
  )
}

