fn step_695() -> Unit raise {
  let t18796 = @sets.set_tac(@list.empty())
  let t18795 = @simp.asm_simp_tac(
    @list.List([
      @topology.closed(),
      @equal.gsym(inside_outside()),
      open_inside(),
    ]),
  )
  let t18794 = @tactics.match_mp_tac(@topology.closure_minimal())
  let t18797 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t18794),
      t18795,
    ),
    t18796,
  )
  closure_outside_subset_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!s:real^N->bool. closed s ==> closure(outside s) SUBSET s UNION outside s",
      ),
      t18797,
    ),
  )
}

