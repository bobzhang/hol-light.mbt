///|
/// HOMEOMORPHIC_PUNCTURED_SPHERE_AFFINE
fn step_904() -> Unit raise {
  let t23989 = @simp.asm_simp_tac(
    @list.List([
      @convex.relative_frontier_cball(),
      @real.real_lt_imp_nz(),
      @convex.aff_dim_cball(),
      @convex.convex_cball(),
      @topology.bounded_cball(),
    ]),
  )
  let t23986 = @parser.parse_term("b:real^N")
  let t23987 = @parser.parse_term("t:real^M->bool")
  let t23988 = @tactics.mp_tac(
    @bool.ispecl(
      @list.List([@parser.parse_term("cball(a:real^N,r)"), t23987, t23986]),
      homeomorphic_punctured_sphere_affine_gen(),
    ),
  )
  let t23990 = @tactics.then_tac(
    @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t23988),
    t23989,
  )
  homeomorphic_punctured_sphere_affine_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!a r b:real^N t:real^M->bool.\n    &0 < r /\\ b IN sphere(a,r) /\\ affine t /\\ aff_dim(t) + &1 = &(dimindex(:N))\n    ==> (sphere(a:real^N,r) DELETE b) homeomorphic t",
      ),
      t23990,
    ),
  )
}

