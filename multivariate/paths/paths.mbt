///|
let connected_component_limit_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new(
  "CONNECTED_COMPONENT_LIMIT",
)

///|
/// `CONNECTED_COMPONENT_LIMIT`
pub fn connected_component_limit() -> @kernel.Thm {
  connected_component_limit_c.get()
}

