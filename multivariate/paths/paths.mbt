///|
/// LOCALLY_CONNECTED_CLOSED_UNION
fn step_405() -> Unit raise {
  let t8180 = @simp.asm_rewrite_tac(
    @list.List([@metric.subtopology_univ(), @equal.gsym(@topology.closed_in())]),
