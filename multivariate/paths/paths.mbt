    @list.List([@topology.connected_in_euclidean(), @sets.subset_diff()]),
  )
  let t7990 = @simp.rewrite_tac(
    @list.List([
      @metric.connected_in_subtopology(),
      @topology.topspace_euclidean_subtopology(),
    ]),
  )
  let t7988 = @parser.parse_term("s:real^N->bool")
  let t7989 = @tactics.mp_tac(
    @bool.ispecl(
      @list.List([
        @parser.parse_term("subtopology euclidean (u:real^N->bool)"),
        t7988,
      ]),
      @metric.separation_by_closed_intermediates_gen(),
    ),
  )
  let t7993 = @tactics.then_tac(
    @tactics.then_tac(
