      t23992,
    ),
    @int.int_arith_tac,
  )
  homeomorphic_punctured_sphere_hyperplane_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!a r b c d.\n        &0 < r /\\ b IN sphere(a,r) /\\ ~(c = vec 0)\n        ==> (sphere(a:real^N,r) DELETE b) homeomorphic\n             {x:real^N | c dot x = d}",
      ),
      t23993,
    ),
  )
}

