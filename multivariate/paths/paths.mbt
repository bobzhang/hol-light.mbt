///|
/// HOMEOMORPHIC_PUNCTURED_SPHERE_HYPERPLANE
fn step_905() -> Unit raise {
  let t23992 = @simp.asm_simp_tac(
    @list.List([@convex.affine_hyperplane(), @convex.aff_dim_hyperplane()]),
