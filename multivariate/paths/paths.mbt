    @list.List([@topology.frontier_union_subset(), @sets.union_subset()]),
  )
  let t18807 = @parser.parse_term(
    "frontier s UNION frontier(outside s):real^N->bool",
  )
  let t18808 = @tactics.trans_tac(@sets.subset_trans())(t18807)
  let t18811 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t18808),
      t18809,
    ),
    t18810,
  )
  frontier_with_outside_subset_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!s:real^N->bool. closed s ==> frontier(s UNION outside s) SUBSET s",
      ),
      t18811,
    ),
