      #|  h':real^N->real^N->real^N
      #|  IMAGE (g:real^N->real^N) s = t /\\ IMAGE h t = s
      #|  !f:real^N->real^1 g:real^N->real^N h g' h' s t b.\n          (!x. x IN s ==> g(x) IN t /\\ h(g x) = x) /\\\n          (!y. y IN t ==> h(y) IN s /\\ g(h y) = y) /\\\n          (!y. y IN t ==> &0 <= drop(f y)) /\\\n          (!x. x IN s ==> (g has_derivative g' x) (at x within s)) /\\\n          (!y. y IN t ==> (h has_derivative h' y) (at y within t)) /\\\n          (!y. y IN t ==> h' y o g'(h y) = I)\n          ==> (f integrable_on t /\\\n               drop(integral t f) <= b <=>\n               (\\x. abs(det(matrix(g' x))) % f(g x)) integrable_on s /\\\n               drop (integral s (\\x. abs(det(matrix (g' x))) % f(g x))) <= b)
      #|  h':real^N->real^N->real^N
      #|  h:real^N->real^N
      #|  (!b. P x /\\ f x = b <=> Q x /\\ g x = b) <=>\n      (!b. P x /\\ f x <= b <=> Q x /\\ g x <= b)
      #|  b:real^1
      #|  b:real^1
      #|  !f:real^N->real^1 g:real^N->real^N h g' h' s t b.\n          (!x. x IN s ==> g(x) IN t /\\ h(g x) = x) /\\\n          (!y. y IN t ==> h(y) IN s /\\ g(h y) = y) /\\\n          (!y. y IN t ==> &0 <= drop(f y)) /\\\n          (!x. x IN s ==> (g has_derivative g' x) (at x within s)) /\\\n          (!y. y IN t ==> (h has_derivative h' y) (at y within t)) /\\\n          (!y. y IN t ==> h' y o g'(h y) = I)\n          ==> (((\\x. abs(det(matrix(g' x))) % f(g x)) has_integral b) s <=>\n               (f has_integral b) t)
      #|  &0 < x \\/ x < &0 <=> ~(x = &0)
      #|  {x | x IN s /\\ P x} UNION {x | x IN s /\\ Q x} =\n          {x | x IN s /\\ (P x \\/ Q x)}
      #|  {x | x IN s /\\ P x} INTER {x | x IN s /\\ Q x} =\n             {x | x IN s /\\ P x /\\ Q x}
      #|  {x | x IN s /\\ P x} INTER {x | x IN s /\\ Q x} =\n             {x | x IN s /\\ P x /\\ Q x}
      #|  &0 < x \\/ x < &0 <=> ~(x = &0)
