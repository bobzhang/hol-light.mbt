  log.attempt("MEASURE_UNIQUE", () => sthm(@measure.measure_unique()))
  log.attempt("HAS_MEASURE_MEASURABLE_MEASURE", () => {
    sthm(@measure.has_measure_measurable_measure())
  })
  log.attempt("HAS_MEASURE_IMP_MEASURABLE", () => {
    sthm(@measure.has_measure_imp_measurable())
  })
  log.attempt("HAS_MEASURE", () => sthm(@measure.has_measure_v1()))
  log.attempt("MEASURABLE", () => sthm(@measure.measurable_v1()))
  log.attempt("MEASURABLE_INTEGRABLE", () => {
    sthm(@measure.measurable_integrable())
  })
  log.attempt("MEASURE_INTEGRAL", () => sthm(@measure.measure_integral()))
