      #|  !f:real^N->real^1 g:real^N->real^N g' s.\n          (!x. x IN s ==> (g has_derivative g' x) (at x within s)) /\\\n          (\\x. abs(det(matrix(g' x))) % f(g x)) absolutely_integrable_on s\n          ==> f absolutely_integrable_on (IMAGE g s)
      #|  1 <= i /\\ i <= dimindex(:N)
