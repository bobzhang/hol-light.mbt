      #|  x:real^N
      #|  s INTER {x | P x} = {x | x IN s /\\ P x}
      #|  g:real^N->real^N
      #|  \\x:real^N. inv(abs(det(matrix(g' x):real^N^N))) %\n                     abs(det(matrix(g' x):real^N^N)) %\n                     (f:real^N->real^1)(g x)
      #|  (\\x:real^N. (f:real^N->real^1)(g x)) measurable_on s'
      #|  s:real^N->bool
      #|  (g':real^N->real^N->real^N) x
      #|  x:real^N
      #|  {x | x IN IMAGE g s /\\ f x IN t} =\n                            IMAGE g {x | x IN s /\\ f(g x) IN t}
      #|  t:real^1->bool
      #|  (f:real^N->real^1) measurable_on\n                  (IMAGE (g:real^N->real^N) s')
      #|  s:real^N->bool
