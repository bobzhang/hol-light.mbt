      #|  !f:real^M->real^N g:real^M->real^M g' s.\n          (!x. x IN s ==> (g has_derivative g' x) (at x within s)) /\\\n          (\\x. abs(det(matrix(g' x))) % f(g x)) absolutely_integrable_on s\n          ==> f absolutely_integrable_on (IMAGE g s)
      #|  !f:real^N->real^1 g:real^N->real^N g' s b.\n          (!x. x IN s ==> &0 <= drop(f(g x))) /\\\n          (!x. x IN s ==> (g has_derivative g' x) (at x within s)) /\\\n          (\\x. abs(det(matrix(g' x))) % f(g x)) integrable_on s /\\\n          drop(integral s (\\x. abs(det(matrix (g' x))) % f(g x))) <= b\n          ==> drop(integral (IMAGE g s) f) <= b
      #|  x:real^N
      #|  g':real^N->real^N->real^N
