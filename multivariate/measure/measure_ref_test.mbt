      #|  lebesgue_measurable(s':real^N->bool)
      #|  s' = {x:real^N | x IN s /\\ ~(abs(det(matrix(g' x):real^N^N)) %\n                                 (f:real^N->real^1)(g x) = vec 0)}
      #|  !f:real^N->real^1 g:real^N->real^N g' s b.\n          (!x. x IN s ==> &0 <= drop(f(g x))) /\\\n          (!x. x IN s ==> (g has_derivative g' x) (at x within s)) /\\\n          (\\x. abs(det(matrix(g' x))) % f(g x)) integrable_on s /\\\n          drop(integral s (\\x. abs(det(matrix (g' x))) % f(g x))) <= b\n          ==> f integrable_on (IMAGE g s) /\\\n              drop(integral (IMAGE g s) f) <= b
      #|  ~(x = &0) <=> x < &0 \\/ &0 < x
      #|  (f:real^N->real^1) x = vec 0
      #|  x:real^N
