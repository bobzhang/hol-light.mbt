      #|  g:real^M->real^M
      #|  f:real^M->real^N
      #|  !f:real^M->real^N g:real^M->real^M h g' s b.\n      (!x. x IN s ==> (g has_derivative g' x) (at x within s)) /\\\n      (!x. x IN s ==> h(g x) = x) /\\ h continuous_on IMAGE g s\n      ==> ((\\x. abs(det(matrix(g' x))) % f(g x))\n           absolutely_integrable_on s /\\\n           integral s (\\x. abs(det(matrix(g' x))) % f(g x)) = b <=>\n           f absolutely_integrable_on (IMAGE g s) /\\\n           integral (IMAGE g s) f = b)
      #|  UNIONS {IMAGE f (g x) | P x} = IMAGE f (UNIONS {g x | P x})
      #|  h:real^M->real^M
      #|  h:real^M->real^M
      #|  !f:real^M->real^N g:real^M->real^M g' s b.\n        compact s /\\\n        (!x. x IN s ==> (g has_derivative g' x) (at x within s)) /\\\n        (!x y. x IN s /\\ y IN s /\\ g x = g y ==> x = y)\n        ==> ((\\x. abs(det(matrix(g' x))) % f(g x))\n             absolutely_integrable_on s /\\\n             integral s (\\x. abs(det(matrix(g' x))) % f(g x)) = b <=>\n             f absolutely_integrable_on (IMAGE g s) /\\\n             integral (IMAGE g s) f = b)
      #|  m:num
      #|  drop(integral (IMAGE (g:real^M->real^M) (UNIONS {s m | m IN (:num)}))\n                        (\\x. lift(norm((f:real^M->real^N) x))))
      #|  UNIONS (IMAGE s (:num)):real^M->bool
