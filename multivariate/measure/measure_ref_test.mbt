      #|  drop(integral {x | x IN s /\\ &0 < drop(f((g:real^N->real^N) x))}\n                     (\\x. abs(det(matrix(g' x):real^N^N)) % f(g x)))
      #|  {x | x IN s /\\ &0 < drop(f((g:real^N->real^N) x))}
