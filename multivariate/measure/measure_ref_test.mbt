      #|  UNIONS (IMAGE s (:num)):real^M->bool
      #|  x:real^M
      #|  integral (UNIONS {s m | m IN 0..n})\n                  (\\x:real^M. abs(det(matrix(g' x):real^M^M)) %\n                              lift(norm((f:real^M->real^N) (g x))))
