      #|  f absolutely_integrable_on s /\\ (f has_integral b) s <=>\n           f absolutely_integrable_on s /\\ integral s f = b
      #|  1 <= i /\\ i <= dimindex(:N)
      #|  i:num
      #|  f absolutely_integrable_on s /\\ integral s f = b <=>\n                   f absolutely_integrable_on s /\\ (f has_integral b) s
      #|  !f:real^M->real^N g:real^M->real^M h g' h' s t b.\n        (!x. x IN s ==> g(x) IN t /\\ h(g x) = x) /\\\n        (!y. y IN t ==> h(y) IN s /\\ g(h y) = y) /\\\n        (!x. x IN s ==> (g has_derivative g' x) (at x within s)) /\\\n        (!y. y IN t ==> (h has_derivative h' y) (at y within t)) /\\\n        (!y. y IN t ==> h' y o g'(h y) = I)\n        ==> ((\\x. abs(det(matrix(g' x))) % f(g x))\n             absolutely_integrable_on s /\\\n             integral s (\\x. abs(det(matrix(g' x))) % f(g x)) = b <=>\n             f absolutely_integrable_on t /\\ integral t f = b)
      #|  (g':real^M->real^M->real^M) x
