      #|  &0 < x \\/ x < &0 <=> ~(x = &0)
      #|  (p /\\ q ==> p' ==> q' ==> r) <=> p /\\ p' ==> q /\\ q' ==> r
      #|  p /\\ q /\\ r ==> s <=> r ==> p /\\ q ==> s
      #|  (\\x. vec 0):real^N->real^1
      #|  integral {x | x IN s /\\ &0 < drop (f((g:real^N->real^N) x))}\n                 (\\x:real^N. abs(det(matrix(g' x):real^N^N)) % f(g x))
      #|  p /\\ q /\\ r ==> s <=> q ==> p /\\ r ==> s
      #|  (\\x. vec 0):real^N->real^1
      #|  integral {x | x IN s /\\ drop(f((g:real^N->real^N) x)) < &0}\n                 (\\x:real^N. abs(det(matrix(g' x):real^N^N)) % --f(g x))
      #|  (det o matrix):(real^N->real^N)->real
      #|  (g:real^N->real^N) x IN t
      #|  (g:real^N->real^N) x
      #|  (a * b < &0 <=> b < &0) <=> (&0 < a * --b <=> &0 < --b)
      #|  (x:real^N) IN s
