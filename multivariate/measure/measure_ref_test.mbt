      #|  \\x. if x IN IMAGE (g:real^N->real^N) s then (f:real^N->real^1) x\n             else vec 0
      #|  ?h:num->real^N->real^1.\n        (!n x. &0 <= drop(h n x)) /\\\n        (!n x. x IN IMAGE (g:real^N->real^N) s ==> drop(h n x) <= drop(f x)) /\\\n        (!n x. drop(h n x) <= drop(h (SUC n) x)) /\\\n        (!n. (h n) measurable_on (:real^N)) /\\\n        (!n. FINITE(IMAGE (h n) (:real^N))) /\\\n        (!x. x IN IMAGE g s ==> ((\\n. h n x) --> f x) sequentially)
      #|  !f:real^N->real^1 g:real^N->real^N g' s b.\n          lebesgue_measurable s /\\\n          f measurable_on (IMAGE g s) /\\\n          (!x. x IN s ==> &0 <= drop(f(g x))) /\\\n          (!x. x IN s ==> (g has_derivative g' x) (at x within s)) /\\\n          (!t. t SUBSET IMAGE g s /\\ lebesgue_measurable t\n               ==> lebesgue_measurable {x | x IN s /\\ g x IN t}) /\\\n          (\\x. abs(det(matrix(g' x))) % f(g x)) integrable_on s /\\\n          drop (integral s (\\x. abs(det(matrix (g' x))) % f(g x))) <= b\n          ==> f integrable_on (IMAGE g s) /\\\n              drop(integral (IMAGE g s) f) <= b
      #|  s:real^N->bool
      #|  x:real^N
      #|  g':real^N->real^N->real^N
      #|  IMAGE (g:real^N->real^N)\n              {x | x IN s /\\ det(matrix(g' x):real^N^N) = &0}
      #|  (if ~(x = a) then x else a) = x
      #|  IMAGE g {x | x IN s /\\ ~(P x) /\\ ~(Q(g x))} =\n        IMAGE g {x | x IN s /\\ ~P x} INTER {y | ~Q y}
      #|  s:real^N->bool
      #|  x:real^N
      #|  g':real^N->real^N->real^N
