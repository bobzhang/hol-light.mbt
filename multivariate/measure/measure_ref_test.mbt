      #|  s:real^N->bool
      #|  (\\x. abs(det(matrix(g' x):real^N^N)) % f(g x)) absolutely_integrable_on\n        {x | x IN s /\\ &0 < drop((f:real^N->real^1)(g x))} /\\\n        (\\x. abs(det(matrix(g' x))) % f(g x)) absolutely_integrable_on\n        {x:real^N | x IN s /\\ drop(f(g x)) < &0}
      #|  t:real^N->bool
