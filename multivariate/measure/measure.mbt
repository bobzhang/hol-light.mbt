  has_integral_negligible_eq_ae_c.set(@tactics.prove(@parser.parse_term("!f:real^M->real^N s t.\n        negligible t /\\\n        (!x i. x IN s DIFF t /\\ 1 <= i /\\ i <= dimindex (:N) ==> &0 <= f x$i)\n        ==> ((f has_integral vec 0) s <=>\n             negligible {x | x IN s /\\ ~(f x = vec 0)})"), t818))
