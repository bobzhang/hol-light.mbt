  msum_swap_numseg_c.set(@tactics.prove(@parser.parse_term("!a b c d f.\n         msum (a..b) (\\i. msum (c..d) (f i)) =\n         msum (c..d) (\\j. msum (a..b) (\\i. f i j)):real^M^N"), t284))
}

