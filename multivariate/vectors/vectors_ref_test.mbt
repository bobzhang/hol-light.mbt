      #|  !x s.\n        dimindex(:M) + 1 = dimindex(:N) /\\ 1 <= k /\\ k <= dimindex(:N)\n        ==> (x IN IMAGE (dropout k:real^N->real^M) s <=>\n             ?t. (pushin k t x) IN s)
