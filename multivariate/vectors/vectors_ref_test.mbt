// Load-fidelity test for Multivariate/vectors.ml: replays tools/ocaml_ref/Multivariate_vectors_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "Multivariate/vectors matches Multivariate/vectors.ml" {
  @vectors.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "Library/wo", "Library/card", "Library/matroids", "Library/floor",
      "Multivariate/misc", "Multivariate/vectors",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Multivariate/vectors")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("FORALL_1", () => sthm(@vectors.forall_1()))
  log.attempt("FORALL_2", () => sthm(@vectors.forall_2()))
  log.attempt("FORALL_3", () => sthm(@vectors.forall_3()))
  log.attempt("FORALL_4", () => sthm(@vectors.forall_4()))
  log.attempt("SUM_1", () => sthm(@vectors.sum_1()))
