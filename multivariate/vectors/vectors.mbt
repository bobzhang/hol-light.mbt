/// `QUANTIFY_SURJECTION_THM`
pub fn quantify_surjection_thm() -> @kernel.Thm {
  quantify_surjection_thm_c.get()
}

///|
/// QUANTIFY_SURJECTION_HIGHER_THM
fn step_1248() -> Unit raise {
  let t8406 = @meson.asm_meson_tac(@list.empty())
  let t8405 = @simp.rewrite_tac(@list.List([@class.fun_eq_thm(), @trivia.o_thm(), @equal.gsym(@class.skolem_thm())]))
  let t8402 = @equal.gsym(@sets.surjective_image_thm())
  let t8403 = @equal.gsym(@sets.surjective_exists_thm())
  let t8404 = @simp.asm_rewrite_tac(@list.List([@equal.gsym(@sets.surjective_forall_thm()), t8403, t8402, @sets.surjective_image(), @lists.surjective_map()]))
  let t8401 = @tactics.conv_tac(@equal.once_depth_conv(@equal.sym_conv))
  let t8407 = @tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.gen_tac, @tactics.disch_tac), t8401), t8404), t8405), t8406)
  quantify_surjection_higher_thm_c.set(@tactics.prove(@parser.parse_term("!f:A->B.\n        (!y. ?x. f x = y)\n        ==> ((!P. (!x. P x) <=> (!x. P (f x))) /\\\n             (!P. (?x. P x) <=> (?x. P (f x))) /\\\n             (!Q. (!s. Q s) <=> (!s. Q(IMAGE f s))) /\\\n             (!Q. (?s. Q s) <=> (?s. Q(IMAGE f s))) /\\\n             (!Q. (!s. Q s) <=> (!s. Q(IMAGE (IMAGE f) s))) /\\\n             (!Q. (?s. Q s) <=> (?s. Q(IMAGE (IMAGE f) s))) /\\\n             (!P. (!g:real^1->B. P g) <=> (!g. P(f o g))) /\\\n             (!P. (?g:real^1->B. P g) <=> (?g. P(f o g))) /\\\n             (!P. (!g:num->B. P g) <=> (!g. P(f o g))) /\\\n             (!P. (?g:num->B. P g) <=> (?g. P(f o g))) /\\\n             (!Q. (!l. Q l) <=> (!l. Q(MAP f l))) /\\\n             (!Q. (?l. Q l) <=> (?l. Q(MAP f l)))) /\\\n            ((!P. {x | P x} = IMAGE f {x | P(f x)}) /\\\n             (!Q. {s | Q s} = IMAGE (IMAGE f) {s | Q(IMAGE f s)}) /\\\n             (!R. {l | R l} = IMAGE (MAP f) {l | R(MAP f l)}))"), t8407))
}

///|
let quantify_surjection_higher_thm_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("QUANTIFY_SURJECTION_HIGHER_THM")

///|
/// `QUANTIFY_SURJECTION_HIGHER_THM`
pub fn quantify_surjection_higher_thm() -> @kernel.Thm {
  quantify_surjection_higher_thm_c.get()
}

///|
/// `PARTIAL_EXPAND_QUANTS_CONV`
pub fn partial_expand_quants_conv(x8408 : @list.List[String], x8409 : @kernel.Thm) -> @equal.Conv raise {
  let avoid = x8408
  let th = x8409
  let (ath, sth) = @bool.conj_pair(th)
  let conv1 : (@kernel.Term) -> @kernel.Thm raise = @simp.gen_rewrite_conv(fn(x8411 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    x8411
  }, @list.List([ath]))
  let conv2 : (@kernel.Term) -> @kernel.Thm raise = @simp.gen_rewrite_conv(fn(x8412 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    x8412
  }, @list.List([sth]))
  let conv1_p : (@kernel.Term) -> @kernel.Thm raise = fn(x8413 : @kernel.Term) -> @kernel.Thm raise {
    let tm = x8413
    let th_1 = conv1(tm)
    if @lib.mem(@kernel.dest_var(@kernel.dest_abs(@kernel.rand(tm)).0).0, avoid) {
      raise Failure("Not going to expand this variable")
    } else {
      th_1
    }
  }
  fn conv(x8414 : @kernel.Term) -> @kernel.Thm raise {
    let tm_1 = x8414
    let t8416 = @equal.sub_conv(conv)
    let t8415 = @equal.thenc(conv2, @equal.rand_conv(@equal.rand_conv(@equal.abs_conv(@equal.binder_conv(@equal.land_conv(conv))))))
    @equal.orelsec(@equal.orelsec(@equal.thenc(conv1_p, @equal.binder_conv(conv)), t8415), t8416)(tm_1)
  }
  conv
}

///|
/// EXPAND_QUANTS_CONV
fn step_1249() -> Unit raise {
  expand_quants_conv_c.set((x8417 : @kernel.Thm) => partial_expand_quants_conv(@list.empty(), x8417))
}

///|
let expand_quants_conv_c : @lib.Cell[(@kernel.Thm) -> @equal.Conv raise] = @lib.Cell::new("EXPAND_QUANTS_CONV")

///|
/// `EXPAND_QUANTS_CONV`
pub fn expand_quants_conv(x : @kernel.Thm) -> @equal.Conv raise {
  (expand_quants_conv_c.get())(x)
}

