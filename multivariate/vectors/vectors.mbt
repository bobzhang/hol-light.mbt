  let t692 = @simp.rewrite_tac(@list.List([@real.real_pow2_abs(), @realax.real_mul_assoc(), @equal.gsym(@real.real_sub_rdistrib())]))
  let t691 = @simp.rewrite_tac(@list.List([dot_rmul()]))
  let t690 = @simp.rewrite_tac(@list.List([dot_lmul()]))
  let t688 = @calc_rat.real_arith(@parser.parse_term("a pow 2 * ((y pow 2 + y pow 2) - &2 * d) <=\n    ((a * y) pow 2 + (b * y) pow 2) - &2 * e <=>\n    &2 * (e - a pow 2 * d) <= (b pow 2 - a pow 2) * y pow 2"))
  let t689 = @simp.asm_rewrite_tac(@list.List([@equal.gsym(norm_pow_2()), norm_mul(), @realax.real_abs(), t688]))
  let t687 = @simp.rewrite_tac(@list.List([vector_arith(@parser.parse_term("(x - y:real^N) dot (x - y) = (x dot x + y dot y) - &2 * x dot y"))]))
