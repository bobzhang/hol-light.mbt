///|
/// BERNOULLI_CONV
fn step_1229() -> Unit raise {
  let btm = @parser.parse_term("bernoulli")
  fn bernoullis(x12611 : Int64) -> @list.List[@kernel.Thm] raise {
    let n = x12611
    if (n < 0L) {
      @list.empty()
    } else {
      if (n == 0L) {
        @list.List([@bool.conjunct1(bernoulli())])
      } else {
        let ths = bernoullis(@lib.sub63(n, 1L))
        let t12612 = @bool.conjunct2(bernoulli())
        let th1 = @bool.spec(@nums.mk_small_numeral(@lib.sub63(n, 1L)), t12612)
        let t12614 = @simp.rewrite_conv(ths)
        let t12613 = @equal.once_depth_conv(@binomial.num_binom_conv)
        let t12615 = @equal.thenc(@equal.thenc(@equal.thenc(@equal.thenc(@equal.rand_conv(@equal.land_conv(@iterate.expand_sum_conv)), @calc_num.num_reduce_conv), t12613), t12614), @calc_rat.real_poly_conv)
        let th2 = @equal.conv_rule(@equal.binder_conv(@equal.comb2_conv(@equal.rand_conv(@equal.land_conv(@calc_num.num_add_conv)), t12615)), th1)
        ths.prepend(th2)
      }
    }
  }
  bernoulli_conv_c.set(fn(x12616 : @kernel.Term) -> @kernel.Thm raise {
    let tm = x12616
    match tm {
      @kernel.Term::Comb(@kernel.Term::Comb(b, n_1), x) if (b == btm) => {
        let th = @lib.hd(bernoullis(@nums.dest_small_numeral(n_1)))
        @equal.thenc(@simp.rewr_conv(th), @calc_rat.real_poly_conv)(tm)
      }
      _ => raise Failure("BERNOULLI_CONV")
    }
  })
}

