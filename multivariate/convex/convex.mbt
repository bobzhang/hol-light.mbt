  aff_dim_eq_full_gen_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!s t:real^N->bool.\n        s SUBSET t\n        ==> (aff_dim s = aff_dim t <=> affine hull s = affine hull t)",
