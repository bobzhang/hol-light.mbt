      conic_convex_hull(),
      conic_conic_hull(),
    ]),
  )
  let t8919 = @tactics.match_mp_tac(@misc.hull_minimal())
  let t8921 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.gen_tac,
          @tactics.match_mp_tac(@sets.subset_antisym()),
        ),
        @tactics.conj_tac,
