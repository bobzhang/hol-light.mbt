    t16701,
  )
  homeomorphic_convex_compact_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!s:real^N->bool t:real^N->bool.\n        convex s /\\ compact s /\\ ~(interior s = {}) /\\\n        convex t /\\ compact t /\\ ~(interior t = {})\n        ==> s homeomorphic t",
      ),
      t16702,
    ),
  )
}

