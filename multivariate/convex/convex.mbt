///|
/// TIETZE_CLOSED_INTERVAL
fn step_572() -> Unit raise {
  let t10777 = @meson.meson_tac(@list.empty())
  let t10776 = @simp.asm_rewrite_tac(
    @list.List([convex_interval(), @sets.subset(), @sets.forall_in_image()]),
  )
  let t10772 = @parser.parse_term("s:real^M->bool")
  let t10773 = @parser.parse_term("u:real^M->bool")
  let t10774 = @parser.parse_term("interval[a:real^N,b]")
  let t10775 = @tactics.mp_tac(
    @bool.ispecl(
      @list.List([
        @parser.parse_term("f:real^M->real^N"),
        t10774,
        t10773,
        t10772,
      ]),
      dugundji(),
    ),
  )
  let t10778 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t10775),
      t10776,
    ),
    t10777,
  )
  tietze_closed_interval_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!f:real^M->real^N u s a b.\n        ~(interval[a,b] = {}) /\\\n        closed_in (subtopology euclidean u) s /\\\n        f continuous_on s /\\\n        (!x. x IN s ==> f x IN interval[a,b])\n        ==> ?g. g continuous_on u /\\\n                (!x. x IN s ==> g x = f x) /\\\n                (!x. x IN u ==> g(x) IN interval[a,b])",
      ),
      t10778,
    ),
  )
}

