/// `DIAMETER_CONVEX_HULL`
pub fn diameter_convex_hull() -> @kernel.Thm {
  diameter_convex_hull_c.get()
}

///|
/// DIAMETER_SIMPLEX
fn step_635() -> Unit raise {
  let t11169 = @simp.simp_tac(
    @list.List([@topology.diameter(), @vectors.dist()]),
  )
  let t11170 = @tactics.then_tac(
    @simp.rewrite_tac(@list.List([diameter_convex_hull()])),
    t11169,
  )
  diameter_simplex_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!s:real^N->bool.\n        ~(s = {})\n        ==> diameter(convex hull s) = sup { dist(x,y) | x IN s /\\ y IN s}",
      ),
      t11170,
    ),
  )
}

