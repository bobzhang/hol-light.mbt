  let t1417 = @tactics.then_tac(
    @simp.rewrite_tac(@list.List([affine_dependent()])),
    t1416,
  )
  affine_dependent_linear_image_eq_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!f:real^M->real^N s.\n        linear f /\\ (!x y. f x = f y ==> x = y)\n        ==> (affine_dependent(IMAGE f s) <=> affine_dependent s)",
      ),
      t1417,
    ),
  )
}

