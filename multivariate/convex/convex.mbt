///|
/// TIETZE
fn step_571() -> Unit raise {
  let t10770 = @meson.meson_tac(@list.empty())
  let t10769 = @simp.asm_rewrite_tac(
    @list.List([@sets.subset(), @sets.forall_in_image(), @topology.in_cball_0()]),
  )
  let t10768 = @simp.asm_rewrite_tac(
    @list.List([
      convex_cball(),
      @topology.cball_eq_empty(),
      @realarith.real_not_lt(),
    ]),
  )
  let t10764 = @parser.parse_term("s:real^M->bool")
  let t10765 = @parser.parse_term("u:real^M->bool")
  let t10766 = @parser.parse_term("cball(vec 0:real^N,B)")
  let t10767 = @tactics.mp_tac(
    @bool.ispecl(
      @list.List([
        @parser.parse_term("f:real^M->real^N"),
        t10766,
        t10765,
        t10764,
      ]),
      dugundji(),
    ),
  )
  let t10771 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t10767),
        t10768,
      ),
      t10769,
    ),
    t10770,
  )
  tietze_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!f:real^M->real^N u s B.\n        &0 <= B /\\\n        closed_in (subtopology euclidean u) s /\\\n        f continuous_on s /\\\n        (!x. x IN s ==> norm(f x) <= B)\n        ==> ?g. g continuous_on u /\\\n                (!x. x IN s ==> g x = f x) /\\\n                (!x. x IN u ==> norm(g x) <= B)",
      ),
      t10771,
    ),
  )
}

