///|
/// IS_INTERVAL_INTERIOR
fn step_781() -> Unit raise {
  let t14037 = @simp.rewrite_tac(@list.List([is_interval_relative_interior()]))
  let t14036 = @simp.asm_simp_tac(
    @list.List([@equal.gsym(relative_interior_nonempty_interior())]),
  )
  let t14035 = @simp.asm_rewrite_tac(
    @list.List([@topology.is_interval_empty()]),
  )
  let t14038 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.gen_tac,
          @class.asm_cases_tac(
            @parser.parse_term("interior s:real^N->bool = {}"),
          ),
        ),
        t14035,
      ),
      t14036,
    ),
    t14037,
  )
  is_interval_interior_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!s:real^N->bool. is_interval s ==> is_interval(interior s)",
      ),
      t14038,
    ),
  )
}

