      @parser.parse_term(
        "!f:real^1->real^N a b y k.\n        drop a <= drop b /\\ 1 <= k /\\ k <= dimindex(:N) /\\\n        f continuous_on interval[a,b] /\\\n        f(a)$k <= y /\\ y <= f(b)$k\n        ==> ?x. x IN interval[a,b] /\\ f(x)$k = y",
