///|
let continuous_on_compact_surface_projection_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new(
  "CONTINUOUS_ON_COMPACT_SURFACE_PROJECTION",
)

///|
/// `CONTINUOUS_ON_COMPACT_SURFACE_PROJECTION`
pub fn continuous_on_compact_surface_projection() -> @kernel.Thm {
  continuous_on_compact_surface_projection_c.get()
}

///|
/// affine_dependent
fn step_155() -> Unit raise {
  affine_dependent_c.set(
    @pair.new_definition(
      @parser.parse_term(
        "affine_dependent (s:real^N -> bool) <=>\n        ?x. x IN s /\\ x IN (affine hull (s DELETE x))",
      ),
    ),
  )
}

