    @meson.meson_tac(@list.List([aff_dim_affine_hull()])),
  ])
  let t4608 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.thenl(
          @tactics.then_tac(
            @tactics.repeat_tac(@tactics.strip_tac),
            @tactics.eq_tac,
          ),
          t4604,
        ),
        t4605,
      ),
      t4606,
    ),
    t4607,
