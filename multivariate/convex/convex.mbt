    @vectors.vector_arith_tac,
  )
  convex_hull_translation_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!a:real^N s.\n       convex hull (IMAGE (\\x. a + x) s) = IMAGE (\\x. a + x) (convex hull s)",
      ),
      t8259,
