    @tactics.all_tac,
  ])
  let t20314 = @tactics.subgoal_then(
    @parser.parse_term("interval[u:real^1,v] SUBSET interior s"),
    fn(
      x20311 : @kernel.Thm,
    ) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> (
      (
        @list.List[@kernel.Term],
        (
          @list.List[(Int64, @kernel.Term)],
          @list.List[(@kernel.Term, @kernel.Term)],
          @list.List[(@kernel.HolType, @kernel.HolType)],
        ),
      ),
      @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)],
      (
        (
          @list.List[(Int64, @kernel.Term)],
          @list.List[(@kernel.Term, @kernel.Term)],
          @list.List[(@kernel.HolType, @kernel.HolType)],
        ),
        @list.List[@kernel.Thm],
      ) -> @kernel.Thm raise,
    ) raise) raise {
      let s20312 = @tactics.assume_tac(x20311)
      fn(
        x20313 : (@list.List[(String, @kernel.Thm)], @kernel.Term),
      ) -> (
        (
          @list.List[@kernel.Term],
          (
            @list.List[(Int64, @kernel.Term)],
            @list.List[(@kernel.Term, @kernel.Term)],
            @list.List[(@kernel.HolType, @kernel.HolType)],
          ),
        ),
        @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)],
        (
          (
            @list.List[(Int64, @kernel.Term)],
            @list.List[(@kernel.Term, @kernel.Term)],
            @list.List[(@kernel.HolType, @kernel.HolType)],
          ),
          @list.List[@kernel.Thm],
        ) -> @kernel.Thm raise,
      ) raise {
        s20312(x20313)
      }
    },
  )
  let t20309 = @simp.asm_rewrite_tac(@list.List([@topology.in_interval_1()]))
  let t20308 = @simp.rewrite_tac(@list.List([@topology.segment_1()]))
  let t20307 = @simp.asm_simp_tac(
    @list.List([
      @class.not_imp(),
      @simp.rewrite_rule(@list.List([@sets.subset()]))(
        @topology.interior_subset(),
      ),
    ]),
  )
  let t20302 = @parser.parse_term("b:real^1")
  let t20303 = @parser.parse_term("v:real^1")
  let t20304 = @parser.parse_term("u:real^1")
  let t20305 = @parser.parse_term("s:real^1->bool")
  let t20306 = @tactics.mp_tac(
    @bool.ispecl(
      @list.List([
        @parser.parse_term("f:real^1->real"),
        t20305,
        t20304,
        t20303,
        t20302,
      ]),
      convex_lower_segment(),
    ),
  )
  let t20310 = @list.List([
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(
                @tactics.match_mp_tac(
                  @class.taut(@parser.parse_term("F ==> p")),
                ),
                t20306,
              ),
              t20307,
            ),
            t20308,
          ),
          @class.cond_cases_tac,
        ),
        t20309,
      ),
      @calc_rat.asm_real_arith_tac,
    ),
    @tactics.all_tac,
  ])
  let t20299 = @parser.parse_term("v:real^1")
  let t20300 = @parser.parse_term("b:real^1")
  let t20301 = @tactics.map_every(
    @tactics.x_gen_tac,
    @list.List([@parser.parse_term("u:real^1"), t20300, t20299]),
  )
  let t20298 = @simp.rewrite_tac(
    @list.List([@vectors.forall_drop(), @vectors.lift_drop()]),
  )
  let t20297 = @simp.rewrite_tac(
    @list.List([
      @class.taut(@parser.parse_term("~p \\/ q <=> p ==> q")),
      @theorems.left_imp_exists_thm(),
    ]),
  )
  let t20296 = @simp.rewrite_tac(@list.List([@misc.real_non_monotone()]))
  let t20295 = @simp.rewrite_tac(
    @list.List([
      @vectors.forall_lift(),
      @vectors.lift_drop(),
      @theorems.disj_assoc(),
    ]),
  )
  let t20356 = @tactics.thenl(
    @tactics.then_tac(
      @tactics.thenl(
        @tactics.then_tac(
          @tactics.thenl(
            @tactics.then_tac(
              @tactics.then_tac(
                @tactics.then_tac(
                  @tactics.thenl(
                    @tactics.then_tac(
                      @tactics.then_tac(
                        @tactics.then_tac(
                          @tactics.thenl(
                            @tactics.then_tac(
                              @tactics.thenl(
                                @tactics.then_tac(
                                  @tactics.then_tac(
                                    @tactics.then_tac(
                                      @tactics.then_tac(
                                        @tactics.then_tac(
                                          @tactics.then_tac(
                                            @tactics.repeat_tac(
                                              @tactics.strip_tac,
                                            ),
                                            t20295,
                                          ),
                                          t20296,
                                        ),
                                        t20297,
                                      ),
                                      t20298,
                                    ),
                                    t20301,
                                  ),
                                  @tactics.strip_tac,
                                ),
                                t20310,
                              ),
                              t20314,
                            ),
                            t20315,
                          ),
                          t20317,
                        ),
                        t20318,
                      ),
                      @tactics.ants_tac,
                    ),
                    t20326,
                  ),
                  @tactics.strip_tac,
                ),
                t20327,
              ),
              @tactics.conj_tac,
            ),
            t20328,
          ),
          t20332,
        ),
        t20339,
      ),
      t20343,
    ),
    t20355,
  )
  convex_imp_piecewise_monotone_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!f s. f convex_on s /\\ is_interval s\n         ==> (!x y. x IN interior s /\\ y IN interior s /\\ drop x <= drop y\n                    ==> f x <= f y) \\/\n             (!x y. x IN interior s /\\ y IN interior s /\\ drop x <= drop y\n                    ==> f y <= f x) \\/\n             ?a. a IN interior s /\\\n                 (!x y. x IN s /\\ y IN s /\\\n                        drop x <= drop y /\\ drop y <= drop a\n                        ==> f y <= f x) /\\\n                 (!x y. x IN s /\\ y IN s /\\\n                        drop a <= drop x /\\ drop x <= drop y\n                        ==> f x <= f y)",
      ),
      t20356,
    ),
  )
}

///|
let convex_imp_piecewise_monotone_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new(
  "CONVEX_IMP_PIECEWISE_MONOTONE",
)

///|
/// `CONVEX_IMP_PIECEWISE_MONOTONE`
pub fn convex_imp_piecewise_monotone() -> @kernel.Thm {
  convex_imp_piecewise_monotone_c.get()
}

