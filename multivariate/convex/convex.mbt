///|
/// CONVEX_HULL_INSERT_ALT
fn step_265() -> Unit raise {
  let t2868 = @sets.set_tac(@list.empty())
  let t2867 = @simp.rewrite_tac(
    @list.List([
      @theorems.right_exists_and_thm(),
      @theorems.unwind_thm2(),
      @realarith.real_sub_le(),
      @calc_rat.real_arith(@parser.parse_term("u + v = &1 <=> u = &1 - v")),
    ]),
  )
  let t2866 = @simp.once_rewrite_tac(@list.List([@theorems.swap_exists_thm()]))
  let t2865 = @simp.once_rewrite_tac(
    @list.List([
      @class.taut(
        @parser.parse_term("a /\\ b /\\ c /\\ d <=> b /\\ c /\\ a /\\ d"),
      ),
    ]),
  )
  let t2864 = @simp.asm_simp_tac(@list.List([convex_hull_insert()]))
  let t2863 = @simp.asm_rewrite_tac(@list.List([convex_hull_sing()]))
  let t2869 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(
                @tactics.repeat_tac(@tactics.strip_tac),
                @class.cond_cases_tac,
              ),
              t2863,
            ),
            t2864,
          ),
          t2865,
        ),
        t2866,
      ),
      t2867,
    ),
    t2868,
  )
  convex_hull_insert_alt_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!s a:real^N.\n      convex hull (a INSERT s) =\n      if s = {} then {a}\n      else {(&1 - u) % a + u % x | &0 <= u /\\ u <= &1 /\\ x IN convex hull s}",
      ),
      t2869,
    ),
  )
}

