    ),
  )
  let t11127 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(
                @tactics.then_tac(
                  @tactics.then_tac(
                    @tactics.repeat_tac(@tactics.strip_tac),
                    t11118,
                  ),
                  t11119,
                ),
                t11120,
              ),
              t11121,
            ),
            t11122,
          ),
          t11123,
        ),
        t11124,
      ),
      t11125,
    ),
    t11126,
  )
  ivt_increasing_component_on_1_c.set(
