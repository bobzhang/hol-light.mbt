///|
/// LIPSCHITZ_EXTENSION_EXISTS
fn step_569() -> Unit raise {
  let t10468 = @meson.asm_meson_tac(
    @list.List([
      @real.real_le_rmul(),
      @realax.real_le_trans(),
      @vectors.norm_pos_le(),
      @calc_rat.real_arith(
        @parser.parse_term("&0 <= abs B + &1 /\\ B <= abs B + &1"),
      ),
    ]),
  )
  let t10467 = @list.List([@tactics.all_tac, @meson.meson_tac(@list.empty())])
  let t10466 = @simp.rewrite_tac(@list.empty())
  let t10463 = @parser.parse_term("abs B + &1")
  let t10464 = @parser.parse_term("s:real^M->bool")
  let t10465 = @tactics.mp_tac(
    @bool.ispecl(
      @list.List([@parser.parse_term("f:real^M->real^N"), t10464, t10463]),
      kirszbraun(),
    ),
  )
  let t10469 = @tactics.then_tac(
    @tactics.thenl(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t10465),
          t10466,
        ),
        @tactics.ants_tac,
      ),
      t10467,
    ),
    t10468,
  )
  lipschitz_extension_exists_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!f:real^M->real^N s.\n        (?B. !x y. x IN s /\\ y IN s ==> norm(f x - f y) <= B * norm(x - y))\n        ==> ?g. (?B. !x y. norm(g x - g y) <= B * norm(x - y)) /\\\n                (!x. x IN s ==> g x = f x)",
      ),
      t10469,
    ),
  )
}

