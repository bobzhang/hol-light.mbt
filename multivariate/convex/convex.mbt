fn step_425() -> Unit raise {
  let t5497 = @meson.asm_meson_tac(
    @list.List([@vectors.dist_refl(), @vectors.dist_sym()]),
  )
  let t5496 = @tactics.disch_then(@tactics.match_mp_tac)
