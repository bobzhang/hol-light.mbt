///|
/// CONVEX_HULL_FINITE_STEP
fn step_276() -> Unit raise {
  let t3426 = @simp.rewrite_tac(@list.List([@theorems.right_and_exists_thm()]))
  let t3425 = @simp.simp_tac(
    @list.List([
      @calc_rat.real_arith(@parser.parse_term("&0 <= x / &2 <=> &0 <= x")),
      @realarith.real_le_add(),
    ]),
  )
  let t3427 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.mp_tac(
        @bool.ispec(
          @parser.parse_term("\\x:real^N y:real. &0 <= y"),
          affine_hull_finite_step_gen(),
        ),
      ),
      t3425,
    ),
    t3426,
  )
  convex_hull_finite_step_c.set(
    @tactics.prove(
      @parser.parse_term(
        "((?u. (!x. x IN {} ==> &0 <= u x) /\\\n         sum {} u = w /\\\n         vsum {} (\\x. u(x) % x) = y) <=> w = &0 /\\ y = vec 0) /\\\n   (FINITE(s:real^N->bool)\n    ==> ((?u. (!x. x IN (a INSERT s) ==> &0 <= u x) /\\\n              sum (a INSERT s) u = w /\\\n              vsum (a INSERT s) (\\x. u(x) % x) = y) <=>\n         ?v. &0 <= v /\\\n             ?u. (!x. x IN s ==> &0 <= u x) /\\\n              sum s u = w - v /\\\n              vsum s (\\x. u(x) % x) = y - v % a))",
      ),
      t3427,
    ),
  )
}

