  )
  let t11120 = @tactics.disch_then(@tactics.match_mp_tac)
  let t11119 = @simp.rewrite_tac(@list.List([@sets.exists_in_image()]))
  let t11118 = @tactics.mp_tac(
    @bool.ispecl(
      @list.List([
