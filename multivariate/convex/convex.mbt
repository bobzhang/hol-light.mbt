    @list.List([@sets.not_in_empty(), @theorems.imp_imp()]),
  )
  let t5494 = @simp.rewrite_tac(
    @list.List([
      @theorems.imp_conj(),
      @theorems.right_forall_imp_thm(),
      @sets.forall_in_insert(),
    ]),
  )
  let t5491 = @parser.parse_term("{(a:real^N,a':real^N), (b,b'), (c,c')}")
  let t5492 = @parser.parse_term("SND:real^N#real^N->real^N")
  let t5493 = @tactics.mp_tac(
    @bool.ispecl(
      @list.List([@parser.parse_term("FST:real^N#real^N->real^N"), t5492, t5491]),
      rigid_transformation_between_congruent_sets(),
    ),
  )
  let t5498 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t5493),
          t5494,
        ),
        t5495,
      ),
      t5496,
    ),
    t5497,
  )
  rigid_transformation_between_3_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!a b c a' b' c':real^N.\n        dist(a,b) = dist(a',b') /\\\n        dist(b,c) = dist(b',c') /\\\n        dist(c,a) = dist(c',a')\n        ==> ?k f. orthogonal_transformation f /\\\n                  a' = k + f a /\\ b' = k + f b /\\ c' = k + f c",
      ),
      t5498,
    ),
  )
}

