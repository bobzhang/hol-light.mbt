  let t508 = @simp.gen_rewrite_tac(
    fn(
      x505 : (@kernel.Term) -> @kernel.Thm raise,
    ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
      let s506 = @equal.rand_conv(x505)
      fn(x507 : @kernel.Term) -> @kernel.Thm raise { s506(x507) }
    },
    @list.List([@equal.gsym(@sets.arbitrary_union_of_idempot())]),
  )
  let t504 = @tactics.match_mp_tac(@sets.subset_antisym())
  let t513 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(
                @tactics.then_tac(
