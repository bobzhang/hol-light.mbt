///|
/// METRIZABLE_SPACE_RETRACTION_MAP_IMAGE
fn step_1100() -> Unit raise {
  let t11397 = @simp.rewrite_tac(
    @list.List([metrizable_space_subtopology(), homeomorphic_metrizable_space()]),
