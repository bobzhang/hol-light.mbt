  )
  let t27774 = @tactics.match_mp_tac(boundary_bumping_theorem_gen())
  let t27777 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.repeat_tac(@tactics.gen_tac),
          @tactics.strip_tac,
        ),
        t27774,
      ),
      t27775,
    ),
    t27776,
  )
  boundary_bumping_theorem_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!top s c:A->bool.\n        connected_space top /\\\n        compact_space top /\\\n        hausdorff_space top /\\\n        s PSUBSET topspace top /\\\n        c IN connected_components_of(subtopology top s)\n        ==> ~(top frontier_of c INTER top frontier_of s = {})",
      ),
      t27777,
    ),
  )
}

