/// connected_space
fn step_1111() -> Unit raise {
  connected_space_c.set(
    @pair.new_definition(
      @parser.parse_term(
        "connected_space(top:A topology) <=>\n        ~(?e1 e2. open_in top e1 /\\ open_in top e2 /\\\n                  topspace top SUBSET e1 UNION e2 /\\ e1 INTER e2 = {} /\\\n                  ~(e1 = {}) /\\ ~(e2 = {}))",
      ),
    ),
  )
}

