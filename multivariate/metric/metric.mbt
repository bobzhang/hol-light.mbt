    @tactics.then_tac(
      @tactics.thenl(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t27527),
            t27528,
          ),
          @tactics.ants_tac,
        ),
        t27530,
      ),
      t27531,
    ),
    t27532,
  )
  wilder_locally_compact_component_thm_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!top c w:A->bool.\n        locally_compact_space top /\\ hausdorff_space top /\\\n        c IN connected_components_of top /\\ compact_in top c /\\\n        open_in top w /\\ c SUBSET w\n        ==> ?u v. open_in top u /\\ open_in top v /\\\n                  DISJOINT u v /\\ u UNION v = topspace top /\\\n                  c SUBSET u /\\ u SUBSET w",
      ),
      t27533,
    ),
  )
