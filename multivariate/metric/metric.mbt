  let metric_axioms = (
    @parser.parse_term(
      "!m. (!x y:A. x IN mspace m /\\ y IN mspace m\n                  ==> &0 <= mdist m (x,y)) /\\\n         (!x y. x IN mspace m /\\ y IN mspace m\n                ==> (mdist m (x,y) = &0 <=> x = y)) /\\\n         (!x y. x IN mspace m /\\ y IN mspace m\n                ==> mdist m (x,y) = mdist m (y,x)) /\\\n         (!x y z. x IN mspace m /\\ y IN mspace m /\\ z IN mspace m\n                  ==> mdist m (x,z) <= mdist m (x,y) + mdist m (y,z))",
    ),
    t10514,
  )
  let t10515 = @simp.rewrite_rule(@list.List([@theorems.forall_and_thm()]))
  match
    (fn(x10516 : @kernel.Thm) -> @list.List[@kernel.Thm] raise {
      @bool.conjuncts_rule(t10515(x10516))
    })(
      (fn(
        x10517 : (
          @kernel.Term,
          ((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> (
            (
              @list.List[@kernel.Term],
              (
                @list.List[(Int64, @kernel.Term)],
                @list.List[(@kernel.Term, @kernel.Term)],
                @list.List[(@kernel.HolType, @kernel.HolType)],
              ),
            ),
            @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)],
            (
              (
                @list.List[(Int64, @kernel.Term)],
                @list.List[(@kernel.Term, @kernel.Term)],
                @list.List[(@kernel.HolType, @kernel.HolType)],
              ),
              @list.List[@kernel.Thm],
            ) -> @kernel.Thm raise,
          ) raise,
        ),
      ) -> @kernel.Thm raise {
        @tactics.prove(x10517.0, x10517.1)
      })(metric_axioms),
    ) {
    More(
      mdist_pos_le,
      tail=More(
        mdist_0,
        tail=More(mdist_sym, tail=More(mdist_triangle, tail=Empty))
      )
    ) => {
      mdist_pos_le_c.set(mdist_pos_le)
      mdist_0_c.set(mdist_0)
      mdist_sym_c.set(mdist_sym)
      mdist_triangle_c.set(mdist_triangle)
      ()
    }
    _ => raise @lib.MatchFailure("tscript.ml:11632:4")
  }
}

