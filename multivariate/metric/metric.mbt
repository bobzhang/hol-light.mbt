///|
/// HAUSDORFF_SPACE_SING_INTERS_OPENS
fn step_702() -> Unit raise {
  let t7197 = @simp.rewrite_tac(@list.List([hausdorff_imp_t1_space()]))
  let t7196 = @simp.rewrite_tac(
    @list.List([@equal.gsym(t1_space_sing_inters_open())]),
  )
  let t7198 = @tactics.then_tac(
    @tactics.then_tac(
      @simp.rewrite_tac(
        @list.List([@theorems.imp_conj(), @theorems.right_forall_imp_thm()]),
      ),
      t7196,
    ),
    t7197,
  )
  hausdorff_space_sing_inters_opens_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!top a:A.\n        hausdorff_space top /\\ a IN topspace top\n        ==> INTERS {u | open_in top u /\\ a IN u} =  {a}",
      ),
      t7198,
    ),
  )
}

