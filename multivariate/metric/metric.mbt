    t14607,
  )
  kolmogorov_quotient_eq_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!top x y:A.\n        kolmogorov_quotient top x = kolmogorov_quotient top y <=>\n        !u. open_in top u ==> (x IN u <=> y IN u)",
      ),
      t14608,
    ),
  )
}

