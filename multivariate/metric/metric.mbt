///|
/// DIMENSION_LE_RULES, DIMENSION_LE_INDUCT, DIMENSION_LE_CASES
fn step_2509() -> Unit raise {
  let (dimension_le_rules, dimension_le_induct, dimension_le_cases) = @ind_defs.new_inductive_definition(
    @parser.parse_term(
      "!top n. -- &1 <= n /\\\n           (!v a. open_in top v /\\ a IN v\n                  ==> ?u. a IN u /\\ u SUBSET v /\\ open_in top u /\\\n                          subtopology top (top frontier_of u)\n                          dimension_le (n - &1))\n            ==> (top:A topology) dimension_le (n:int)",
    ),
  )
  dimension_le_rules_c.set(dimension_le_rules)
  dimension_le_induct_c.set(dimension_le_induct)
  dimension_le_cases_c.set(dimension_le_cases)
}

