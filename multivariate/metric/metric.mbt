///|
let metric_arith_c : @lib.Cell[(@kernel.Term) -> @kernel.Thm raise] = @lib.Cell::new(
  "METRIC_ARITH",
)

///|
/// `METRIC_ARITH`
pub fn metric_arith(x : @kernel.Term) -> @kernel.Thm raise {
  metric_arith_c.get()(x)
}

///|
fn try_points_l(
  points_2 : @list.List[@kernel.Term],
  simple_metric_arith : (@kernel.Term) -> @kernel.Thm raise,
  x11195 : @kernel.Term,
  x11196 : @kernel.Term,
  x11197 : @list.List[@kernel.Term],
) -> @kernel.Thm raise {
  let try_points = (
    x11195 : @kernel.Term,
    x11196 : @kernel.Term,
    x11197 : @list.List[@kernel.Term],
  ) => try_points_l(points_2, simple_metric_arith, x11195, x11196, x11197)
  let elim_exists = (x11199 : @kernel.Term) => {
    elim_exists_l(points_2, simple_metric_arith, x11199)
  }
  let v_3 = x11195
  let tm_17 = x11196
  let ptl = x11197
  if ptl == @list.empty() {
    @lib.failure()
  } else {
    let xtm_2 = @lib.hd(ptl)
    try {
      let t11198 = elim_exists(
        @kernel.vsubst(@list.List([(xtm_2, v_3)]), tm_17),
      )
      @bool.exists_rule(@bool.mk_exists(v_3, tm_17), xtm_2, t11198)
    } catch {
      Failure(_) => try_points(v_3, tm_17, @lib.tl(ptl))
      e => raise e
    }
  }
}

///|
