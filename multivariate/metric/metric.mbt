      @simp.rewrite_tac(@list.List([k_space()])),
    ),
    t27778,
  )
  k_space_v1_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!top:A topology.\n        k_space top <=>\n        !s. s SUBSET topspace top /\\\n            (!k. compact_in top k\n                 ==> closed_in (subtopology top k) (k INTER s))\n            ==> closed_in top s",
      ),
      t27779,
    ),
  )
}

