///|
/// regular_space
fn step_1319() -> Unit raise {
  regular_space_c.set(
    @pair.new_definition(
      @parser.parse_term(
        "regular_space top <=>\n        !c a:A. closed_in top c /\\ a IN topspace top DIFF c\n                ==> ?u v. open_in top u /\\ open_in top v /\\\n                          a IN u /\\ c SUBSET v /\\ DISJOINT u v",
      ),
    ),
  )
}

