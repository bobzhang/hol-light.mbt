///|
/// MDIST_TRIANGLE_LT
fn step_2331() -> Unit raise {
  let t34412 = @simp.asm_simp_tac(@list.List([mdist_triangle()]))
  let t34411 = @tactics.exists_tac(
    @parser.parse_term("mdist (m:A metric) (x:A,y) + mdist m (y:A,z:A)"),
  )
  let t34410 = @tactics.match_mp_tac(@realarith.real_let_trans())
  let t34413 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.repeat_tac(@tactics.gen_tac),
            @tactics.strip_tac,
          ),
          t34410,
        ),
        t34411,
      ),
      t34412,
    ),
    @calc_rat.asm_real_arith_tac,
  )
  mdist_triangle_lt_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!m x y z:A a b.\n     x IN mspace m /\\ y IN mspace m /\\ z IN mspace m /\\\n     mdist m (x,y) < a /\\ mdist m (y,z) < b\n     ==> mdist m (x,z) < a + b",
      ),
      t34413,
    ),
  )
}

