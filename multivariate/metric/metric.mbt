///|
/// BOUNDARY_BUMPING_THEOREM
fn step_1999() -> Unit raise {
  let t27776 = @simp.asm_simp_tac(
    @list.List([closed_in_compact_space(), closed_in_closure_of()]),
  )
  let t27775 = @simp.asm_simp_tac(
