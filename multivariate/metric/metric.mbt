        "!top1 top2 f:A->B s t.\n        regular_space top2 /\\ s SUBSET t /\\ t SUBSET top1 closure_of s /\\\n        (!x. x IN t\n             ==> ?g. continuous_map (subtopology top1 (x INSERT s),top2) g /\\\n                     !x. x IN s ==> g x = f x)\n        ==> ?g. continuous_map (subtopology top1 t,top2) g /\\\n                (!x. x IN s ==> g x = f x)",
      ),
      t32361,
    ),
  )
}

