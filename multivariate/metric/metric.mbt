        "!m:A metric.\n        compact_space(mtopology m) <=>\n        !x. (!n:num. x n IN mspace m)\n            ==> ?l r. l IN mspace m /\\\n                      (!m n. m < n ==> r m < r n) /\\\n                      limit (mtopology m) (x o r) l sequentially",
      ),
      t20948,
    ),
  )
}

