    "(?s. s HAS_SIZE 2 /\\ P s) <=> (?a b. ~(a = b) /\\ P{a,b})",
  )
  let t55862 = @simp.rewrite_tac(
    @list.List([
      @meson.meson(
        @list.List([@sets.has_size_conv(@parser.parse_term("s HAS_SIZE 2"))]),
