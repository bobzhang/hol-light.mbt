    @simp.rewrite_tac(
      @list.List([open_in_product_topology(), @sets.arbitrary_union_of_alt()]),
    ),
    t3591,
  )
  open_in_product_topology_alt_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!k (tops:K->A topology) s.\n         open_in (product_topology k tops) s <=>\n         !x. x IN s\n             ==> ?u. FINITE {i | i IN k /\\ ~(u i = topspace(tops i))} /\\\n                     (!i. i IN k ==> open_in (tops i) (u i)) /\\\n                     x IN cartesian_product k u /\\\n                     cartesian_product k u SUBSET s",
      ),
      t3592,
    ),
  )
}

