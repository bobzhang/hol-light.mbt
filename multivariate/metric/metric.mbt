  metrizable_space_retraction_map_image_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!top top' (r:A->B).\n        retraction_map(top,top') r /\\ metrizable_space top\n        ==> metrizable_space top'",
      ),
      t11398,
    ),
  )
}

