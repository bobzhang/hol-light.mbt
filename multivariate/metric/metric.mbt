///|
/// product_topology
fn step_419() -> Unit raise {
  product_topology_c.set(
    @pair.new_definition(
      @parser.parse_term(
        "product_topology t (tops:K->A topology) =\n        topology\n          (ARBITRARY UNION_OF\n             ((FINITE INTERSECTION_OF\n              { {x:K->A | x k IN u} | k,u | k IN t /\\ open_in (tops k) u})\n              relative_to {x | EXTENSIONAL t x /\\\n                               !k. k IN t ==> x k IN topspace(tops k)}))",
      ),
    ),
  )
}

