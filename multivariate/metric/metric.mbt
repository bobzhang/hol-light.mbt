///|
/// sum_topology
fn step_449() -> Unit raise {
  sum_topology_c.set(
    @pair.new_definition(
      @parser.parse_term(
        "sum_topology (k:K->bool) (top:K->A topology) =\n        topology { u | u SUBSET disjoint_union k (topspace o top) /\\\n                       !i. i IN k ==> open_in (top i) {x | (i,x) IN u}}",
      ),
    ),
  )
}

