///|
/// topcontinuous_at
fn step_1626() -> Unit raise {
  topcontinuous_at_c.set(
    @pair.new_definition(
      @parser.parse_term(
        "!top top' f:A->B x.\n     topcontinuous_at top top' f x <=>\n     x IN topspace top /\\\n     (!x. x IN topspace top ==> f x IN topspace top') /\\\n     (!v. open_in top' v /\\ f x IN v\n          ==> (?u. open_in top u /\\ x IN u /\\ (!y. y IN u ==> f y IN v)))",
      ),
    ),
  )
}

