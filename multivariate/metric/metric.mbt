  )
  locally_connected_space_v1_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!top:A topology.\n        locally_connected_space top <=>\n        !v x. open_in top v /\\ x IN v\n              ==> ?u. open_in top u /\\\n                      connected_in top u /\\\n                      x IN u /\\ u SUBSET v",
      ),
      t26176,
    ),
  )
}

