///|
/// ulc_space
fn step_2334() -> Unit raise {
  ulc_space_c.set(
    @pair.new_definition(
      @parser.parse_term(
        "ulc_space (m:A metric) <=>\n   !e. &0 < e\n       ==> ?d. &0 < d /\\\n               !x y. x IN mspace m /\\ y IN mspace m /\\ mdist m (x,y) < d\n                     ==> ?c. x IN c /\\ y IN c /\\\n                             c SUBSET mspace m /\\\n                             connected_in (mtopology m) c /\\\n                             mbounded m c /\\\n                             mdiameter m c <= e",
      ),
    ),
  )
}

