        "!top s:A->bool.\n        k_space top /\\ kc_space top /\\\n        (open_in top s \\/ closed_in top s)\n        ==> k_space(subtopology top s) /\\ kc_space(subtopology top s)",
      ),
      t28203,
    ),
  )
}

