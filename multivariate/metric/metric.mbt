  homeomorphic_eq_everything_map_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!top top' f:A->B.\n        homeomorphic_map (top,top') f <=>\n        continuous_map (top,top') f /\\\n        open_map (top,top') f /\\\n        closed_map (top,top') f /\\\n        IMAGE f (topspace top) = topspace top' /\\\n        !x y. x IN topspace top /\\ y IN topspace top\n              ==> (f x = f y <=> x = y)",
      ),
      t4553,
    ),
  )
}

