  let t6501 = @simp.rewrite_tac(
    @list.List([@sets.subset_cartesian_product(), topspace_product_topology()]),
  )
  let t6500 = @simp.rewrite_tac(@list.List([compact_space_product_topology()]))
  let t6504 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @simp.rewrite_tac(
            @list.List([compact_in_subspace(), subtopology_cartesian_product()]),
          ),
          t6500,
        ),
        t6501,
      ),
      t6502,
    ),
    t6503,
  )
  compact_in_cartesian_product_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!tops:K->A topology s k.\n        compact_in (product_topology k tops) (cartesian_product k s) <=>\n        cartesian_product k s = {} \\/\n        !i. i IN k ==> compact_in (tops i) (s i)",
      ),
      t6504,
    ),
  )
}

