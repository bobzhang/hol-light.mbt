///|
/// T0_SPACE_RETRACTION_MAP_IMAGE
fn step_1293() -> Unit raise {
  let t14451 = @simp.rewrite_tac(
    @list.List([t0_space_subtopology(), homeomorphic_t0_space()]),
  )
  let t14452 = @tactics.then_tac(
    @tactics.match_mp_tac(hereditary_imp_retractive_property()),
    t14451,
  )
  t0_space_retraction_map_image_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!top top' (r:A->B).\n        retraction_map(top,top') r /\\ t0_space top ==> t0_space top'",
      ),
      t14452,
    ),
  )
}

