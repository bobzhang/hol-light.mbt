///|
/// k_space
fn step_2000() -> Unit raise {
  k_space_c.set(
    @pair.new_definition(
      @parser.parse_term(
        "k_space (top:A topology) <=>\n        !s. s SUBSET topspace top\n            ==> (closed_in top s <=>\n                 !k. compact_in top k\n                     ==> closed_in (subtopology top k) (k INTER s))",
      ),
    ),
  )
}

///|
