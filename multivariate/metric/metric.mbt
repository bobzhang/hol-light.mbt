  let t42873 = @tactics.mp_tac(
    @bool.ispec(@parser.parse_term("m:A metric"), metric_completion()),
  )
  let t42872 = @simp.rewrite_tac(
    @list.List([
      exists_completely_metrizable_space(),
      @theorems.right_and_exists_thm(),
    ]),
  )
  let t42871 = @tactics.x_gen_tac(@parser.parse_term("m:A metric"))
  let t42876 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @simp.rewrite_tac(
              @list.List([
                forall_metrizable_space(),
                @theorems.right_exists_and_thm(),
              ]),
            ),
            t42871,
          ),
          t42872,
        ),
        t42873,
      ),
      t42874,
    ),
    t42875,
  )
  metrizable_space_completion_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!top:A topology.\n        metrizable_space top\n        ==> ?top' (f:A->A->real).\n                completely_metrizable_space top' /\\\n                embedding_map(top,top') f /\\\n                top' closure_of (IMAGE f (topspace top)) = topspace top'",
      ),
      t42876,
    ),
  )
}

