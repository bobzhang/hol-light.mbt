///|
/// fccoverable_space
fn step_2333() -> Unit raise {
  fccoverable_space_c.set(
    @pair.new_definition(
      @parser.parse_term(
        "fccoverable_space (m:A metric) <=>\n   !e. &0 < e\n       ==> ?c. FINITE c /\\\n               UNIONS c = mspace m /\\\n               (!t. t IN c\n                    ==> connected_in (mtopology m) t /\\\n                        mbounded m t /\\\n                        mdiameter m t <= e)",
      ),
    ),
  )
}

