        @simp.rewrite_tac(@list.List([@equal.gsym(@sets.unions_2()), t11965])),
        t11966,
      ),
      t11967,
    ),
    t11968,
  )
  connected_in_union_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!top s t:A->bool.\n        connected_in top s /\\ connected_in top t /\\ ~(s INTER t = {})\n        ==> connected_in top (s UNION t)",
      ),
      t11969,
    ),
  )
}

