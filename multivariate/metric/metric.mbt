///|
/// funspace
fn step_2414() -> Unit raise {
  funspace_c.set(
    @pair.new_definition(
      @parser.parse_term(
        "funspace s m =\n   metric ({f:A->B | (!x. x IN s ==> f x IN mspace m) /\\\n                     f IN EXTENSIONAL s /\\\n                     mbounded m (IMAGE f s)},\n           (\\(f,g). if s = {} then &0 else\n                    sup {mdist m (f x,g x) | x | x IN s}))",
      ),
    ),
  )
}

