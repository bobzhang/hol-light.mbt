      @parser.parse_term(
        "!P Q.\n        (!u x. P u /\\ x IN u ==> ?v. Q v /\\ x IN v /\\ v SUBSET u) /\\\n        (!v x. Q v /\\ x IN v ==> ?u. P u /\\ x IN u /\\ u SUBSET v)\n        ==> topology (ARBITRARY UNION_OF P) =\n            topology (ARBITRARY UNION_OF Q)",
      ),
      t513,
