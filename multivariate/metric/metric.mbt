  points_2 : @list.List[@kernel.Term],
  simple_metric_arith : (@kernel.Term) -> @kernel.Thm raise,
  x11199 : @kernel.Term,
) -> @kernel.Thm raise {
  let try_points = (
    x11195 : @kernel.Term,
    x11196 : @kernel.Term,
    x11197 : @list.List[@kernel.Term],
  ) => try_points_l(points_2, simple_metric_arith, x11195, x11196, x11197)
  let tm_18 = x11199
  try {
    let (v_4, bd_4) = @basics.dest_exists(tm_18)
    try_points(v_4, bd_4, points_2)
  } catch {
    Failure(_) => simple_metric_arith(tm_18)
    e => raise e
  }
}

