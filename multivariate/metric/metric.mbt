    @list.List([closed_in_diff(), closed_in_topspace()]),
  )
  let t27525 = @parser.parse_term("topspace top DIFF w:A->bool")
  let t27526 = @parser.parse_term("c:A->bool")
  let t27527 = @tactics.mp_tac(
    @bool.ispecl(
      @list.List([@parser.parse_term("top:A topology"), t27526, t27525]),
      separated_between_compact_connected_component(),
