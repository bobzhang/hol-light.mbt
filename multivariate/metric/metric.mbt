        @parser.parse_term(
          "~(a = b) /\\ separated_in top a b /\\\n    (~(a = {}) /\\ ~(b = {})) /\\ a UNION b = s <=>\n    a UNION b = s /\\ ~(a = {}) /\\ ~(b = {}) /\\ separated_in top a b",
        ),
