fn step_2057() -> Unit raise {
  alexandroff_compactification_c.set(
    @pair.new_definition(
      @parser.parse_term(
        "alexandroff_compactification (top:A topology) =\n        topology ({ IMAGE INL u | open_in top u} UNION\n                  { INR one INSERT IMAGE INL (topspace top DIFF c) | c |\n                    compact_in top c /\\ closed_in top c})",
      ),
    ),
  )
}

