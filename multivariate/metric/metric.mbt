fn step_2436() -> Unit raise {
  let t42875 = @meson.meson_tac(@list.List([isometry_imp_embedding_map()]))
  let t42874 = @tactics.repeat_tac(
    @tactics.then_tac(
      @tactics.match_mp_tac(@theorems.mono_exists()),
      @tactics.gen_tac,
    ),
