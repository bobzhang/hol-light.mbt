///|
/// METRIC_COMPLETION
fn step_2435() -> Unit raise {
  let t42869 = @sets.set_tac(@list.empty())
  let t42868 = @simp.simp_tac(
    @list.List([
      @sets.set_rule(@parser.parse_term("t SUBSET s ==> s INTER t = t")),
    ]),
  )
  let t42867 = @simp.rewrite_tac(
    @list.List([mtopology_submetric(), closure_of_subtopology()]),
  )
  let t42866 = @simp.rewrite_tac(
    @list.List([submetric_v1(), @sets.subset_inter()]),
  )
  let t42865 = @tactics.repeat_tac(
    @tactics.then_tac(
      @tactics.match_mp_tac(@theorems.mono_exists()),
      @tactics.gen_tac,
    ),
  )
  let t42864 = @tactics.mp_tac(
    @bool.spec(@parser.parse_term("m:A metric"), metric_completion_explicit()),
  )
  let t42870 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(
                @tactics.gen_tac,
                @tactics.match_mp_tac(
                  @meson.meson(
                    @list.empty(),
                    @parser.parse_term(
                      "(?s f. P (submetric (funspace (mspace m) real_euclidean_metric) s) f)\n    ==> ?n f. P n f",
                    ),
                  ),
                ),
              ),
              t42864,
            ),
            t42865,
          ),
          t42866,
        ),
        t42867,
      ),
      t42868,
    ),
    t42869,
  )
  metric_completion_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!m:A metric.\n        ?m' f:A->A->real.\n                mcomplete m' /\\\n                IMAGE f (mspace m) SUBSET mspace m' /\\\n                (mtopology m') closure_of (IMAGE f (mspace m)) = mspace m' /\\\n                !x y. x IN mspace m /\\ y IN mspace m\n                      ==> mdist m' (f x,f y) = mdist m (x,y)",
      ),
      t42870,
    ),
  )
}

