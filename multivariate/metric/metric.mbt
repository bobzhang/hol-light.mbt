    @list.List([
      @meson.meson(
        @list.List([separated_in_sym()]),
        @parser.parse_term(
          "~(a = b) /\\\n    (~(b = a) ==> separated_in top a b /\\ separated_in top b a) /\\ Q <=>\n    ~(a = b) /\\ separated_in top a b /\\ Q",
        ),
      ),
    ]),
  )
