      #|  !(top:A topology) u v.\n        locally_finite_in top u /\\ v SUBSET u ==> locally_finite_in top v
      #|  {y | y IN {f x | P x} /\\ Q y} = IMAGE f {x | P x /\\ Q(f x)}
      #|  x:A
      #|  x:A
      #|  !top u (f:(A->bool)->(A->bool)).\n        locally_finite_in top u /\\ (!s. s IN u ==> f s SUBSET s)\n        ==> locally_finite_in top {f s | s IN u}
      #|  u:A->bool
      #|  x:A
      #|  x:A
      #|  !top s (u:(A->bool)->bool).\n        locally_finite_in top u /\\ (!t. t IN u ==> t SUBSET s)\n        ==> locally_finite_in (subtopology top s) u
      #|  s = {} ==> FINITE s
      #|  topspace top DIFF s:A->bool
      #|  x:A
      #|  (x:A) IN s
      #|  x:A
      #|  !top s (u:(A->bool)->bool).\n        closed_in top s\n        ==> (locally_finite_in (subtopology top s) u <=>\n             locally_finite_in top u /\\ (!t. t IN u ==> t SUBSET s))
      #|  v DIFF UNIONS {s | s IN f /\\ ~(s INTER v = {})}:A->bool
      #|  v:A->bool
      #|  x:A
      #|  x:A
      #|  !top f:(A->bool)->bool.\n        (!s. s IN f ==> closed_in top s) /\\ locally_finite_in top f\n        ==> closed_in top (UNIONS f)
      #|  {y | y IN {f x | P x} /\\ Q y} = IMAGE f {x | P x /\\ Q(f x)}
      #|  x:A
      #|  x:A
      #|  !top f:(A->bool)->bool.\n        locally_finite_in top f\n        ==> locally_finite_in top {top closure_of s | s IN f}
      #|  !top f:(A->bool)->bool.\n        locally_finite_in top f\n        ==> closed_in top (UNIONS {top closure_of s | s IN f})
      #|  s:A->bool
      #|  !top (f:(A->bool)->bool).\n        UNIONS {top closure_of s | s IN f} SUBSET top closure_of (UNIONS f)
      #|  top:A topology
      #|  !top (f:(A->bool)->bool).\n        locally_finite_in top f\n        ==> top closure_of (UNIONS f) = UNIONS {top closure_of s | s IN f}
      #|  !top top' f:A->B.\n     continuous_map (top,top')  f <=>\n     (!x. x IN topspace top ==> f x IN topspace top') /\\\n     (!u. open_in top' u\n          ==> open_in top {x | x IN topspace top /\\ f x IN u})
      #|  !top top' f.\n        continuous_map (top,top') f <=>\n        IMAGE f (topspace top) SUBSET topspace top' /\\\n        !u. open_in top' u\n            ==> open_in top {x | x IN topspace top /\\ f x IN u}
      #|  !top top' f:A->B. continuous_map (top,top')  f\n                     ==> IMAGE f (topspace top) SUBSET topspace top'
      #|  !top top' (f:A->B). topspace top = {} ==> continuous_map(top,top') f
      #|  !top top' (f:A->B).\n        topspace top' = {}\n        ==> (continuous_map(top,top') f <=> topspace top = {})
      #|  topspace top' DIFF t:B->bool
      #|  t:B->bool
      #|  (p ==> (q <=> r)) ==> (p /\\ q <=> p /\\ r)
      #|  !top top' f:A->B.\n         continuous_map (top,top') f <=>\n         (!x. x IN topspace top ==> f x IN topspace top') /\\\n         (!c. closed_in top' c\n              ==> closed_in top {x | x IN topspace top /\\ f x IN c})
      #|  !f:A->B top top' u.\n        continuous_map (top,top') f /\\ open_in top' u\n        ==> open_in top {x | x IN topspace top /\\ f x IN u}
      #|  !f:A->B top top' c.\n        continuous_map (top,top') f /\\ closed_in top' c\n        ==> closed_in top {x | x IN topspace top /\\ f x IN c}
      #|  {x | x IN u /\\ (f:A->B) x IN v} =\n                u INTER {x | x IN topspace top /\\ f x IN v}
      #|  !f:A->B top top' u v.\n        continuous_map (top,top') f /\\ open_in top u /\\ open_in top' v\n        ==> open_in top {x | x IN u /\\ f x IN v}
      #|  {x | x IN u /\\ (f:A->B) x IN v} =\n                u INTER {x | x IN topspace top /\\ f x IN v}
      #|  !f:A->B top top' u v.\n        continuous_map (top,top') f /\\ closed_in top u /\\ closed_in top' v\n        ==> closed_in top {x | x IN u /\\ f x IN v}
      #|  top':B topology
      #|  s SUBSET s' /\\ IMAGE f s SUBSET t'\n      ==> s SUBSET {x | x IN s' /\\ f x IN t'}
      #|  IMAGE f s SUBSET t <=> s SUBSET {x | x IN s /\\ f x IN t}
      #|  s:A->bool
      #|  topspace top INTER s:A->bool
      #|  (topspace top INTER s:A->bool) SUBSET topspace top
      #|  top' closure_of (IMAGE (f:A->B) (topspace top INTER s))
      #|  !top top' (f:A->B) s.\n        continuous_map (top,top') f\n        ==> IMAGE f (top closure_of s) SUBSET top' closure_of IMAGE f s
      #|  s SUBSET {x | x IN t /\\ f x IN u} <=>\n      s SUBSET t /\\ IMAGE f s SUBSET u
      #|  c:B->bool
      #|  v' SUBSET v ==> IMAGE f u SUBSET v' ==> !x. x IN u ==> f x IN v
      #|  topspace top:A->bool
      #|  (p ==> q) /\\ (q ==> q') /\\ (p ==> r) /\\ (q' ==> p)\n    ==> (p <=> q) /\\ (p <=> q') /\\ (p <=> r /\\ q)
      #|  (!top top' f:A->B.\n        continuous_map (top,top') f <=>\n        !s. IMAGE f (top closure_of s) SUBSET top' closure_of IMAGE f s) /\\\n   (!top top' f:A->B.\n        continuous_map (top,top') f <=>\n        !s. s SUBSET topspace top\n            ==> IMAGE f (top closure_of s) SUBSET top' closure_of IMAGE f s) /\\\n   (!top top' f:A->B.\n        continuous_map (top,top') f <=>\n        IMAGE f (topspace top) SUBSET topspace top' /\\\n        !s. IMAGE f (top closure_of s) SUBSET top' closure_of IMAGE f s)
      #|  topspace top' INTER t:B->bool
      #|  top':B topology
      #|  !top top' (f:A->B) t.\n        continuous_map (top,top') f\n        ==> top closure_of {x | x IN topspace top /\\ f x IN t}\n            SUBSET {x | x IN topspace top /\\ f x IN top' closure_of t}
      #|  t:B->bool
      #|  t:B->bool
      #|  (!top top' f:A->B.\n        continuous_map (top,top') f <=>\n        IMAGE f (topspace top) SUBSET topspace top' /\\\n        !t. top closure_of {x | x IN topspace top /\\ f x IN t}\n            SUBSET {x | x IN topspace top /\\ f x IN top' closure_of t}) /\\\n   (!top top' f:A->B.\n        continuous_map (top,top') f <=>\n        IMAGE f (topspace top) SUBSET topspace top' /\\\n        !t. t SUBSET topspace top'\n            ==> top closure_of {x | x IN topspace top /\\ f x IN t}\n                SUBSET {x | x IN topspace top /\\ f x IN top' closure_of t})
      #|  IMAGE f t SUBSET u\n        ==> {x | x IN t /\\ f x IN u DIFF v} =\n            t DIFF {x | x IN t /\\ f x IN v}
      #|  topspace top' DIFF (t:B->bool)
      #|  !top top' (f:A->B) t.\n        continuous_map (top,top') f\n        ==> {x | x IN topspace top /\\ f x IN top' interior_of t} SUBSET\n            top interior_of {x | x IN topspace top /\\ f x IN t}
      #|  IMAGE f t SUBSET u\n        ==> {x | x IN t /\\ f x IN u DIFF v} =\n            t DIFF {x | x IN t /\\ f x IN v}
      #|  topspace top' DIFF (t:B->bool)
      #|  t:B->bool
      #|  (p ==> q) /\\ (q ==> r) /\\ (r ==> p) ==> (p <=> q) /\\ (p <=> r)
      #|  (!top top' f:A->B.\n        continuous_map (top,top') f <=>\n        IMAGE f (topspace top) SUBSET topspace top' /\\\n        !t. {x | x IN topspace top /\\ f x IN top' interior_of t} SUBSET\n            top interior_of {x | x IN topspace top /\\ f x IN t}) /\\\n   (!top top' f:A->B.\n        continuous_map (top,top') f <=>\n        IMAGE f (topspace top) SUBSET topspace top' /\\\n        !t. t SUBSET topspace top'\n            ==> {x | x IN topspace top /\\ f x IN top' interior_of t} SUBSET\n                top interior_of {x | x IN topspace top /\\ f x IN t})
      #|  topspace top DIFF {x | x IN topspace top /\\ (f:A->B) x IN t} =\n    {x | x IN topspace top /\\ f x IN topspace top' DIFF t}
      #|  s SUBSET {x | x IN t /\\ f x IN u} /\\ s' SUBSET {x | x IN t /\\ f x IN u'}\n    ==> s INTER s' SUBSET {x | x IN t /\\ f x IN u INTER u'}
      #|  !top top' (f:A->B) t.\n        continuous_map (top,top') f\n        ==> top frontier_of {x | x IN topspace top /\\ f x IN t}\n            SUBSET {x | x IN topspace top /\\ f x IN top' frontier_of t}
      #|  u = {x | x IN s /\\ x IN u} <=> u SUBSET s
      #|  (P x ==> x = y) ==> P x ==> P y
      #|  !top:A topology. continuous_map (top,top) (\\x. x)
      #|  u SUBSET s ==> {x | x IN s /\\ x IN u} = u
      #|  !top top':A topology.\n        topspace top' = topspace top\n        ==> ((!s. open_in top s ==> open_in top' s) <=>\n             continuous_map (top',top) (\\x. x))
      #|  {x | x IN s} = s
      #|  (c:B) IN u
      #|  u:B->bool
      #|  (c:B) IN topspace top2
      #|  topspace top1:A->bool = {}
      #|  !top1:A topology top2:B topology c.\n       continuous_map (top1,top2) (\\x. c) <=>\n       topspace top1 = {} \\/ c IN topspace top2
      #|  {x:A | x IN topspace top /\\ (g:B->C) (f x) IN u} =\n    {x:A | x IN  topspace top /\\ f x IN {y | y IN topspace top' /\\ g y IN u}}
      #|  u:C->bool
      #|  !top top' top'' f:A->B g:B->C.\n        continuous_map (top,top') f /\\ continuous_map (top',top'') g\n        ==> continuous_map (top,top'') (g o f)
      #|  !top top' f g:A->B.\n        (!x. x IN topspace top ==> f x = g x) /\\ continuous_map (top,top') f\n        ==> continuous_map (top,top') g
      #|  !top top' f:A->B s.\n        topspace top SUBSET s\n        ==> (continuous_map (top,top') (RESTRICTION s f) <=>\n             continuous_map (top,top') f)
      #|  {x:A | x IN topspace top /\\ f x:B IN t INTER s} =\n      {x | x IN topspace top /\\ f x IN t}
      #|  u:B->bool
      #|  {x:A | x IN topspace top /\\ f x:B IN u} =\n      {x | x IN topspace top /\\ f x IN u INTER s}
      #|  !top top' s f:A->B.\n     continuous_map (top,subtopology top' s) f <=>\n     continuous_map (top,top')  f /\\ IMAGE f (topspace top) SUBSET s
      #|  {x | x IN topspace top /\\ (f:A->B) x IN u}
      #|  u:B->bool
      #|  !top top' f:A->B s.\n        continuous_map (top,top') f\n        ==> continuous_map (subtopology top s,top') f
      #|  !top top' f:A->B t.\n        continuous_map (top,subtopology top' t) f\n        ==> continuous_map (top,top') f
      #|  !top top' f:A->B t.\n        continuous_map (top,top') f /\\\n        IMAGE f (topspace top) SUBSET t\n        ==> continuous_map (top,subtopology top' t) f
      #|  s SUBSET t ==> t INTER s = s
      #|  !top top' f s t.\n           continuous_map (subtopology top t,top') f /\\ s SUBSET t\n           ==> continuous_map (subtopology top s,top') f
      #|  !(f:A->B) top u.\n        continuous_map (discrete_topology u,top) f <=>\n        IMAGE f u SUBSET topspace top
      #|  {x | x IN topspace top /\\ g x IN u} =\n    UNIONS {{x | x IN (t i) /\\ ((f:K->A->B) i x) IN u} |\n            i IN k}
      #|  u:B->bool
      #|  s SUBSET t ==> t INTER s = s
      #|  !i. i IN k ==> (t:K->A->bool) i SUBSET topspace top
      #|  !top top' (f:K->A->B) g t k.\n        (!i. i IN k\n             ==> open_in top (t i) /\\\n                 continuous_map(subtopology top (t i),top') (f i)) /\\\n        (!i j x. i IN k /\\ j IN k /\\ x IN topspace top INTER t i INTER t j\n                 ==> f i x = f j x) /\\\n        (!x. x IN topspace top ==> ?j. j IN k /\\ x IN t j /\\ g x = f j x)\n        ==> continuous_map(top,top') g
      #|  k:K->bool
      #|  t:K->A->bool
      #|  f:K->A->B
      #|  \\x. (f:K->A->B)(@i. i IN k /\\ x IN t i) x
      #|  !top top' (f:K->A->B) t k.\n        topspace top SUBSET UNIONS {t i | i IN k} /\\\n        (!i. i IN k\n             ==> open_in top (t i) /\\\n                 continuous_map(subtopology top (t i),top') (f i)) /\\\n        (!i j x. i IN k /\\ j IN k /\\ x IN topspace top INTER t i INTER t j\n                 ==> f i x = f j x)\n        ==> ?g. continuous_map(top,top') g /\\\n                !x i. i IN k /\\ x IN topspace top INTER t i ==> g x = f i x
      #|  v:A->bool
      #|  x:A
      #|  {y | y IN {f x | x IN s} /\\ P y} = IMAGE f {x | x IN s /\\ P(f x)}
      #|  {x | x IN topspace top /\\ g x IN u} =\n    UNIONS {{x | x IN (t i) /\\ ((f:K->A->B) i x) IN u} |\n            i IN k}
      #|  u:B->bool
      #|  s SUBSET t ==> t INTER s = s
      #|  !i. i IN k ==> (t:K->A->bool) i SUBSET topspace top
      #|  !top top' (f:K->A->B) g t k.\n        (!x. x IN topspace top\n             ==> ?v. open_in top v /\\ x IN v /\\\n                     FINITE {i | i IN k /\\ ~(t i INTER v = {})}) /\\\n        (!i. i IN k\n             ==> closed_in top (t i) /\\\n                 continuous_map(subtopology top (t i),top') (f i)) /\\\n        (!i j x. i IN k /\\ j IN k /\\ x IN topspace top INTER t i INTER t j\n                 ==> f i x = f j x) /\\\n        (!x. x IN topspace top ==> ?j. j IN k /\\ x IN t j /\\ g x = f j x)\n        ==> continuous_map(top,top') g
      #|  x:A
      #|  x:A
      #|  x:A
      #|  x:A
      #|  x:A
      #|  x:A
      #|  k:K->bool
      #|  t:K->A->bool
      #|  f:K->A->B
      #|  \\x. (f:K->A->B)(@i. i IN k /\\ x IN t i) x
      #|  !top top' (f:K->A->B) t k.\n        (!x. x IN topspace top\n             ==> ?v. open_in top v /\\ x IN v /\\\n                     FINITE {i | i IN k /\\ ~(t i INTER v = {})}) /\\\n        topspace top SUBSET UNIONS {t i | i IN k} /\\\n        (!i. i IN k\n             ==> closed_in top (t i) /\\\n                 continuous_map(subtopology top (t i),top') (f i)) /\\\n        (!i j x. i IN k /\\ j IN k /\\ x IN topspace top INTER t i INTER t j\n                 ==> f i x = f j x)\n        ==> ?g. continuous_map(top,top') g /\\\n                !x i. i IN k /\\ x IN topspace top INTER t i ==> g x = f i x
      #|  !top top' (f:K->A->B) g t k.\n        FINITE k /\\\n        (!i. i IN k\n             ==> closed_in top (t i) /\\\n                 continuous_map(subtopology top (t i),top') (f i)) /\\\n        (!i j x. i IN k /\\ j IN k /\\ x IN topspace top INTER t i INTER t j\n                 ==> f i x = f j x) /\\\n        (!x. x IN topspace top ==> ?j. j IN k /\\ x IN t j /\\ g x = f j x)\n        ==> continuous_map(top,top') g
      #|  !top top' (f:K->A->B) t k.\n        FINITE k /\\\n        topspace top SUBSET UNIONS {t i | i IN k} /\\\n        (!i. i IN k\n             ==> closed_in top (t i) /\\\n                 continuous_map(subtopology top (t i),top') (f i)) /\\\n        (!i j x. i IN k /\\ j IN k /\\ x IN topspace top INTER t i INTER t j\n                 ==> f i x = f j x)\n        ==> ?g. continuous_map(top,top') g /\\\n                !x i. i IN k /\\ x IN topspace top INTER t i ==> g x = f i x
      #|  topspace top INTER {x:A | ~P x}
      #|  top:A topology
      #|  topspace top INTER {x:A | P x}
      #|  top:A topology
      #|  {T,F}
      #|  \\p. if p then top closure_of {x:A | P x}\n              else top closure_of {x | ~P x}
      #|  \\x. if P x then (f:A->B) x else g x
      #|  \\p. if p then (f:A->B) else g
      #|  top':B topology
      #|  top:A topology
      #|  u DIFF {x | P x} = u INTER {x | ~P x}
      #|  !top top' P f g:A->B.\n        continuous_map (subtopology top (top closure_of {x | P x}),top') f /\\\n        continuous_map (subtopology top (top closure_of {x | ~P x}),top') g /\\\n        (!x. x IN top frontier_of {x | P x} ==> f x = g x)\n        ==> continuous_map (top,top') (\\x. if P x then f x else g x)
      #|  {x | x IN s /\\ P x} = s INTER {x | P x}
      #|  !top top' P f g:A->B.\n        continuous_map (subtopology top\n         (top closure_of {x | x IN topspace top /\\ P x}),top') f /\\\n        continuous_map (subtopology top\n         (top closure_of {x | x IN topspace top /\\ ~P x}),top') g /\\\n        (!x. x IN top frontier_of {x | x IN topspace top /\\ P x} ==> f x = g x)\n        ==> continuous_map (top,top') (\\x. if P x then f x else g x)
      #|  u:C->bool
      #|  {x | x IN topspace top /\\\n           (p:A->C) x IN top'' closure_of (topspace top'' DIFF u)}
      #|  {x | x IN topspace top /\\ (p:A->C) x IN top'' closure_of u}
      #|  !top top' top'' (p:A->C) f (g:A->B) u.\n        continuous_map (top,top'') p /\\\n        continuous_map (subtopology top\n         {x | x IN topspace top /\\ p x IN top'' closure_of u},top') f /\\\n        continuous_map (subtopology top\n         {x | x IN topspace top /\\\n              p x IN top'' closure_of (topspace top'' DIFF u)},top') g /\\\n        (!x. x IN topspace top /\\ p x IN top'' frontier_of u ==> f x = g x)\n        ==> continuous_map (top,top') (\\x. if p x IN u then f x else g x)
      #|  t SUBSET u ==> (s INTER t) SUBSET (s INTER u)
      #|  (s UNION t) INTER top closure_of t:A->bool
      #|  (s UNION t) INTER t = t
      #|  (s UNION t) INTER s = s
      #|  t:A->bool
      #|  s:A->bool
      #|  f:A->B
      #|  f:A->B
      #|  \\x:A. x IN s
      #|  top':B topology
      #|  subtopology top (s UNION t:A->bool)
      #|  !top top' (f:A->B) s t.\n        continuous_map (subtopology top s,top') f /\\\n        continuous_map (subtopology top t,top') f /\\\n        DISJOINT s (top closure_of t) /\\\n        DISJOINT t (top closure_of s)\n        ==> continuous_map (subtopology top (s UNION t),top') f
      #|  open_map (top1,top2) (f:A->B) <=>\n  !u. open_in top1 u ==> open_in top2 (IMAGE f u)
      #|  closed_map (top1,top2) (f:A->B) <=>\n  !u. closed_in top1 u ==> closed_in top2 (IMAGE f u)
      #|  !top1 top2 f:A->B.\n        open_map (top1,top2) f\n        ==> IMAGE f (topspace top1) SUBSET topspace top2
      #|  !top1 top2 f:A->B s.\n        open_map (top1,top2) f /\\ s SUBSET topspace top1\n        ==> IMAGE f s SUBSET topspace top2
      #|  !top top':A topology.\n        (!s. open_in top s ==> open_in top' s) <=>\n        open_map (top,top') (\\x. x)
      #|  !top:A topology. open_map(top,top) (\\x. x)
      #|  u:A->bool
      #|  u:A->bool
      #|  !top top' f g:A->B.\n        (!x. x IN topspace top ==> f x = g x) /\\ open_map (top,top') f\n        ==> open_map (top,top') g
      #|  s INTER t:A->bool = (s INTER topspace top) INTER t
      #|  t:A->bool
      #|  !top s:A->bool.\n        open_map (subtopology top s,top) (\\x. x) <=>\n        open_in top (topspace top INTER s)
      #|  s SUBSET u ==> u INTER s = s
      #|  !top s:A->bool.\n        open_in top s ==> open_map (subtopology top s,top) (\\x. x)
      #|  !top top' top'' (f:A->B) (g:B->C).\n        open_map(top,top') f /\\ open_map(top',top'') g\n        ==> open_map(top,top'') (g o f)
      #|  !top1 top2 f:A->B.\n        closed_map (top1,top2) f\n        ==> IMAGE f (topspace top1) SUBSET topspace top2
      #|  !top1 top2 f:A->B s.\n        closed_map (top1,top2) f /\\ s SUBSET topspace top1\n        ==> IMAGE f s SUBSET topspace top2
      #|  !top top':A topology.\n        (!s. closed_in top s ==> closed_in top' s) <=>\n        closed_map (top,top') (\\x. x)
      #|  !top:A topology. closed_map(top,top) (\\x. x)
      #|  u:A->bool
      #|  u:A->bool
      #|  !top top' f g:A->B.\n        (!x. x IN topspace top ==> f x = g x) /\\ closed_map (top,top') f\n        ==> closed_map (top,top') g
      #|  !top top' top'' (f:A->B) (g:B->C).\n        closed_map(top,top') f /\\ closed_map(top',top'') g\n        ==> closed_map(top,top'') (g o f)
      #|  s INTER t:A->bool = (s INTER topspace top) INTER t
      #|  t:A->bool
      #|  !top s:A->bool.\n        closed_map (subtopology top s,top) (\\x. x) <=>\n        closed_in top (topspace top INTER s)
      #|  s SUBSET u ==> u INTER s = s
      #|  !top s:A->bool.\n        closed_in top s ==> closed_map (subtopology top s,top) (\\x. x)
      #|  IMAGE (f:A->B) u
      #|  u:A->bool
      #|  !top top' (f:A->B) s.\n        open_map (top,top') f /\\ IMAGE f (topspace top) SUBSET s\n        ==> open_map (top,subtopology top' s) f
      #|  IMAGE (f:A->B) u
      #|  u:A->bool
      #|  !top top' (f:A->B) s.\n        closed_map (top,top') f /\\ IMAGE f (topspace top) SUBSET s\n        ==> closed_map (top,subtopology top' s) f
      #|  !(f:A->B) top u.\n        open_map (top,discrete_topology u) f <=>\n        IMAGE f (topspace top) SUBSET u
      #|  !(f:A->B) top u.\n        closed_map (top,discrete_topology u) f <=>\n        IMAGE f (topspace top) SUBSET u
      #|  u:A->bool
      #|  u:A->bool
      #|  !top top' f:A->B.\n        open_map (top,top') f /\\ IMAGE f (topspace top) = topspace top' /\\\n        (!x y. x IN topspace top /\\ y IN topspace top /\\ f x = f y ==> x = y)\n        ==> closed_map (top,top') f
      #|  u:A->bool
      #|  u:A->bool
      #|  !top top' f:A->B.\n        closed_map (top,top') f /\\ IMAGE f (topspace top) = topspace top' /\\\n        (!x y. x IN topspace top /\\ y IN topspace top /\\ f x = f y ==> x = y)\n        ==> open_map (top,top') f
      #|  !top top' (f:A->B). topspace top = {} ==> open_map(top,top') f
      #|  !top top' (f:A->B). topspace top = {} ==> closed_map(top,top') f
      #|  t:A->bool
      #|  !top top' (f:A->B) u.\n        open_map(top,top') f /\\ open_in top u\n        ==> open_map (subtopology top u,top') f
      #|  t:A->bool
      #|  !top top' (f:A->B) u.\n        closed_map(top,top') f /\\ closed_in top u\n        ==> closed_map (subtopology top u,top') f
      #|  IMAGE (f:A->B) t
      #|  t:A->bool
      #|  !top top' (f:A->B) u v.\n        open_map(top,top') f /\\ {x | x IN topspace top /\\ f x IN v} = u\n        ==> open_map (subtopology top u,subtopology top' v) f
      #|  IMAGE (f:A->B) t
      #|  t:A->bool
      #|  !top top' (f:A->B) u v.\n        closed_map(top,top') f /\\ {x | x IN topspace top /\\ f x IN v} = u\n        ==> closed_map (subtopology top u,subtopology top' v) f
      #|  s:A->bool
      #|  s:A->bool
      #|  IMAGE (f:A->B) (topspace top) SUBSET topspace top'
      #|  !top top' f:A->B.\n        closed_map (top,top') f <=>\n        IMAGE f (topspace top) SUBSET topspace top' /\\\n        !s. s SUBSET topspace top\n            ==> top' closure_of (IMAGE f s) SUBSET IMAGE f (top closure_of s)
      #|  s:A->bool
      #|  s:A->bool
      #|  s:A->bool
      #|  (q ==> q') /\\ (p ==> r) /\\ (p ==> q) /\\ (q' ==> p)\n    ==> (p <=> q) /\\ (p <=> q') /\\ (p <=> r /\\ q)
      #|  (!top top' f:A->B.\n        open_map (top,top') f <=>\n        !s. IMAGE f (top interior_of s) SUBSET\n            top' interior_of (IMAGE f s)) /\\\n   (!top top' f:A->B.\n      open_map (top,top') f <=>\n      !s. s SUBSET topspace top\n          ==> IMAGE f (top interior_of s) SUBSET\n              top' interior_of (IMAGE f s)) /\\\n   (!top top' f:A->B.\n      open_map (top,top') f <=>\n      IMAGE f (topspace top) SUBSET topspace top' /\\\n      !s. IMAGE f (top interior_of s) SUBSET top' interior_of (IMAGE f s))
      #|  IMAGE (f:A->B) c = topspace top' DIFF v
      #|  v:B->bool
      #|  topspace top' DIFF IMAGE (f:A->B) c
      #|  topspace top DIFF c:A->bool
      #|  c:A->bool
      #|  topspace top' DIFF IMAGE (f:A->B) (topspace top DIFF u)
      #|  t:B->bool
      #|  u:A->bool
      #|  !top top' (f:A->B).\n        open_map(top,top') f <=>\n        IMAGE f (topspace top) SUBSET topspace top' /\\\n        !u t. closed_in top u /\\ t SUBSET topspace top' /\\\n              {x | x IN topspace top /\\ f x IN t} SUBSET u\n              ==> ?v. closed_in top' v /\\ t SUBSET v /\\\n                      {x | x IN topspace top /\\ f x IN v} SUBSET u
      #|  IMAGE (f:A->B) c = topspace top' DIFF v
      #|  v:B->bool
      #|  topspace top' DIFF IMAGE (f:A->B) c
      #|  topspace top DIFF c:A->bool
      #|  c:A->bool
      #|  topspace top' DIFF IMAGE (f:A->B) (topspace top DIFF u)
      #|  t:B->bool
      #|  u:A->bool
      #|  !top top' (f:A->B).\n        closed_map(top,top') f <=>\n        IMAGE f (topspace top) SUBSET topspace top' /\\\n        !u t. open_in top u /\\ t SUBSET topspace top' /\\\n              {x | x IN topspace top /\\ f x IN t} SUBSET u\n              ==> ?v. open_in top' v /\\ t SUBSET v /\\\n                      {x | x IN topspace top /\\ f x IN v} SUBSET u
      #|  UNIONS { (vv:B->B->bool) y | y IN t}
      #|  t:B->bool
      #|  vv:B->B->bool
      #|  open_in top (u:A->bool)
      #|  u:A->bool
      #|  (p /\\ q <=> p /\\ r) <=> p ==> (q <=> r)
      #|  !top top' (f:A->B).\n        closed_map(top,top') f <=>\n        IMAGE f (topspace top) SUBSET topspace top' /\\\n        !u y. open_in top u /\\ y IN topspace top' /\\\n              {x | x IN topspace top /\\ f x = y} SUBSET u\n              ==> ?v. open_in top' v /\\ y IN v /\\\n                      {x | x IN topspace top /\\ f x IN v} SUBSET u
      #|  !top top' s (f:A->B).\n        open_in top' s\n        ==> (open_map(top,subtopology top' s) f <=>\n             open_map(top,top') f /\\ IMAGE f (topspace top) SUBSET s)
      #|  !top top' s (f:A->B).\n        open_in top' s /\\ open_map(top,subtopology top' s) f\n        ==> open_map(top,top') f
      #|  !top top' s (f:A->B).\n        closed_in top' s\n        ==> (closed_map(top,subtopology top' s) f <=>\n             closed_map(top,top') f /\\ IMAGE f (topspace top) SUBSET s)
      #|  !top top' s (f:A->B).\n        closed_in top' s /\\ closed_map(top,subtopology top' s) f\n        ==> closed_map(top,top') f
      #|  {x | x IN topspace top /\\ (f:A->B) x IN c}
      #|  c:B->bool
      #|  !top top' top'' (f:A->B) (g:B->C).\n        closed_map(top,top'') (g o f) /\\\n        continuous_map(top,top') f /\\\n        IMAGE f (topspace top) = topspace top'\n        ==> closed_map(top',top'') g
      #|  IMAGE f c =\n    {x | x IN topspace top' /\\ g x IN IMAGE ((g:B->C) o (f:A->B)) c}
      #|  c:A->bool
      #|  !top top' top'' (f:A->B) (g:B->C).\n        closed_map(top,top'') (g o f) /\\\n        IMAGE f (topspace top) SUBSET topspace top' /\\\n        continuous_map(top',top'') g /\\\n        (!x y. x IN topspace top' /\\ y IN topspace top' /\\ g x = g y\n               ==> x = y)\n        ==> closed_map(top,top') f
      #|  {x | x IN topspace top /\\ (f:A->B) x IN u}
      #|  u:B->bool
      #|  !top top' top'' (f:A->B) (g:B->C).\n        open_map(top,top'') (g o f) /\\\n        continuous_map(top,top') f /\\\n        IMAGE f (topspace top) = topspace top'\n        ==> open_map(top',top'') g
      #|  IMAGE f u =\n    {x | x IN topspace top' /\\ g x IN IMAGE ((g:B->C) o (f:A->B)) u}
      #|  u:A->bool
      #|  !top top' top'' (f:A->B) (g:B->C).\n        open_map(top,top'') (g o f) /\\\n        IMAGE f (topspace top) SUBSET topspace top' /\\\n        continuous_map(top',top'') g /\\\n        (!x y. x IN topspace top' /\\ y IN topspace top' /\\ g x = g y\n               ==> x = y)\n        ==> open_map(top,top') f
      #|  (if p then T else q) <=> p \\/ q
      #|  topspace top:A->bool = {}
      #|  !(top:A topology) top' (c:B).\n        closed_map(top,top') (\\x. c) <=>\n        topspace top = {} \\/ closed_in top' {c}
      #|  !top top' (f:A->B).\n        open_map (top,top') f /\\\n        IMAGE f (topspace top) = topspace top' /\\\n        discrete_space top\n        ==> discrete_space top'
      #|  !top top' (f:A->B).\n        closed_map (top,top') f /\\\n        IMAGE f (topspace top) = topspace top' /\\\n        discrete_space top\n        ==> discrete_space top'
      #|  quotient_map (top,top') (f:A->B) <=>\n        IMAGE f (topspace top) = topspace top' /\\\n        !u. u SUBSET topspace top'\n            ==> (open_in top {x | x IN topspace top /\\ f x IN u} <=>\n                 open_in top' u)
      #|  !top top' f g:A->B.\n        (!x. x IN topspace top ==> f x = g x) /\\ quotient_map (top,top') f\n        ==> quotient_map (top,top') g
      #|  {y | y IN topspace top' /\\ (g:B->C) y IN w}
      #|  w:C->bool
      #|  !top top' top'' (f:A->B) (g:B->C).\n        quotient_map(top,top') f /\\ quotient_map(top',top'') g\n        ==> quotient_map(top,top'') (g o f)
      #|  top':B topology
      #|  {x:A | x IN topspace top /\\ (g:B->C) (f x) IN w} =\n    {x | x IN topspace top /\\\n         f x IN {y | y IN topspace top' /\\ g y IN w}}
      #|  w:C->bool
      #|  !top top' top'' (f:A->B) (g:B->C).\n        continuous_map(top,top') f /\\ continuous_map(top',top'') g /\\\n        quotient_map(top,top'') (g o f)\n        ==> quotient_map(top',top'') g
      #|  !top top' f:A->B.\n        quotient_map (top,top') f ==> continuous_map (top,top') f
      #|  !top top' f:A->B.\n        quotient_map (top,top') f ==> IMAGE f (topspace top) = topspace top'
      #|  s SUBSET u ==> u DIFF (u DIFF s) = s
      #|  topspace top' DIFF s:B->bool
      #|  s:B->bool
      #|  (p ==> (q <=> r)) ==> (p /\\ q <=> p /\\ r)
      #|  !top top' f:A->B.\n        quotient_map (top,top') f <=>\n        IMAGE f (topspace top) = topspace top' /\\\n        !u. u SUBSET topspace top'\n            ==> (closed_in top {x | x IN topspace top /\\ f x IN u} <=>\n                 closed_in top' u)
      #|  v:B->bool
      #|  !top top' f:A->B.\n        continuous_map (top,top') f /\\ open_map (top,top') f /\\\n        IMAGE f (topspace top) = topspace top'\n        ==> quotient_map (top,top') f
      #|  v:B->bool
      #|  !top top' f:A->B.\n        continuous_map (top,top') f /\\ closed_map (top,top') f /\\\n        IMAGE f (topspace top) = topspace top'\n        ==> quotient_map (top,top') f
      #|  !top top' f:A->B.\n        continuous_map (top,top') f /\\\n        open_map (top,top') f\n        ==> (quotient_map (top,top') f <=>\n             IMAGE f (topspace top) = topspace top')
      #|  !top top' f:A->B.\n        continuous_map (top,top') f /\\\n        closed_map (top,top') f\n        ==> (quotient_map (top,top') f <=>\n             IMAGE f (topspace top) = topspace top')
      #|  {x | x IN topspace top /\\ (f:A->B) x IN IMAGE f u} = u
      #|  IMAGE (f:A->B) u
      #|  u:A->bool
      #|  !top top' f:A->B.\n        (!x y. x IN topspace top /\\ y IN topspace top\n               ==> (f x = f y <=> x = y))\n        ==> (quotient_map (top,top') f <=>\n             continuous_map (top,top') f /\\\n             open_map (top,top') f /\\\n             closed_map (top,top') f /\\\n             IMAGE f (topspace top) = topspace top')
      #|  v:C->bool
      #|  v:C->bool
      #|  !top top' top'' (f:A->B) (g:B->C).\n        quotient_map (top,top') f /\\\n        continuous_map (top,top'') (g o f)\n        ==> continuous_map (top',top'') g
      #|  !top top' top'' (f:A->B) (g:B->C).\n        quotient_map (top,top') f\n        ==> (continuous_map (top,top'') (g o f) <=>\n             continuous_map (top',top'') g)
      #|  !top top' top'' (f:A->B) (g:B->C).\n        quotient_map(top,top') f\n        ==> (quotient_map(top,top'') (g o f) <=> quotient_map(top',top'') g)
      #|  u SUBSET v\n     ==> (x IN t INTER {x | x IN t /\\ f x IN v} /\\ f x IN u <=>\n          x IN t /\\ f x IN u)
      #|  !top top' (f:A->B) u v.\n        quotient_map(top,top') f /\\\n        (open_in top' v \\/ closed_in top' v) /\\\n        {x | x IN topspace top /\\ f x IN v} = u\n        ==> quotient_map (subtopology top u,subtopology top' v) f
      #|  {x | x IN topspace top /\\ (f:A->B) x IN v}
      #|  v:B->bool
      #|  open_in top (u:A->bool)
      #|  u:A->bool
      #|  (i ==> j) /\\ (i /\\ c ==> (p <=> q))\n    ==> (i /\\ p /\\ c <=> j /\\ c /\\ i /\\ q)
      #|  (p ==> (q <=> r)) <=> (p /\\ q ==> r) /\\ (r ==> p ==> q)
      #|  !top top' f:A->B.\n        quotient_map (top,top') f <=>\n        continuous_map (top,top') f /\\\n        IMAGE f (topspace top) = topspace top' /\\\n        !u. open_in top u /\\\n            {x | x IN topspace top /\\ f x IN IMAGE f u} SUBSET u\n            ==> open_in top' (IMAGE f u)
      #|  {x | x IN topspace top /\\ (f:A->B) x IN v}
      #|  v:B->bool
      #|  closed_in top (u:A->bool)
      #|  u:A->bool
      #|  (i ==> j) /\\ (i /\\ c ==> (p <=> q))\n    ==> (i /\\ p /\\ c <=> j /\\ c /\\ i /\\ q)
      #|  (p ==> (q <=> r)) <=> (p /\\ q ==> r) /\\ (r ==> p ==> q)
      #|  !top top' f:A->B.\n        quotient_map (top,top') f <=>\n        continuous_map (top,top') f /\\\n        IMAGE f (topspace top) = topspace top' /\\\n        !u. closed_in top u /\\\n            {x | x IN topspace top /\\ f x IN IMAGE f u} SUBSET u\n            ==> closed_in top' (IMAGE f u)
      #|  u:B->bool
      #|  u:B->bool
      #|  (p ==> (q <=> r)) <=> (p /\\ q ==> r) /\\ (r ==> p ==> q)
      #|  s = t INTER s <=> s SUBSET t
      #|  !top top' (f:A->B).\n        IMAGE f (topspace top) SUBSET topspace top' /\\\n        (!u. u SUBSET topspace top'\n             ==> (open_in top {x | x IN topspace top /\\ f x IN u} <=>\n                  open_in top' u))\n        ==> quotient_map(top,subtopology top' (IMAGE f (topspace top))) f
      #|  h:A->C
      #|  g:B->C
      #|  !top top' top'' (f:A->B) (h:A->C).\n        quotient_map (top,top') f /\\\n        continuous_map (top,top'') h /\\\n        (!x y. x IN topspace top /\\ y IN topspace top /\\ f x = f y\n               ==> h x = h y)\n        ==> ?g. continuous_map (top',top'') g /\\\n                IMAGE g (topspace top') = IMAGE h (topspace top) /\\\n                !x. x IN topspace top ==> g(f x) = h x
      #|  !top top' (q:A->B).\n        quotient_map (top,top') q /\\ discrete_space top\n        ==> discrete_space top'
      #|  prod_topology (top1:A topology) (top2:B topology) =\n    topology (ARBITRARY UNION_OF\n               {s CROSS t | open_in top1 s /\\ open_in top2 t})
      #|  t1 INTER t2:B->bool
      #|  s1 INTER s2:A->bool
      #|  t2:B->bool
      #|  s2:A->bool
      #|  t1:B->bool
      #|  s1:A->bool
      #|  GSPEC p x <=> x IN GSPEC p
      #|  !top1:A topology top2:B topology.\n     open_in (prod_topology top1 top2) =\n     (ARBITRARY UNION_OF {s CROSS t | open_in top1 s /\\ open_in top2 t})
      #|  topspace top2:B->bool
      #|  topspace top1:A->bool
      #|  x IN s ==> x SUBSET UNIONS s
      #|  (!x. x IN P ==> Q x) ==> (!x. R x ==> P x) ==> (!x. R x ==> Q x)
      #|  s:A#B->bool
      #|  !top1:A topology top2:B topology.\n        topspace(prod_topology top1 top2) =\n        topspace top1 CROSS topspace top2
      #|  s:A#B->bool
      #|  t:A#B->bool
      #|  !top1:A topology top2:B topology s t.\n        subtopology (prod_topology top1 top2) (s CROSS t) =\n        prod_topology (subtopology top1 s) (subtopology top2 t)
      #|  (!(top:A topology) (top':B topology) s.\n        prod_topology (subtopology top s) top' =\n        subtopology (prod_topology top top') (s CROSS topspace top')) /\\\n   (!(top:A topology) (top':B topology) t.\n        prod_topology top (subtopology top' t) =\n        subtopology (prod_topology top top') (topspace top CROSS t))
      #|  {y:B}
      #|  {x:A}
      #|  y:B
      #|  x:A
      #|  !s:A->bool t:B->bool.\n        prod_topology (discrete_topology s) (discrete_topology t) =\n        discrete_topology (s CROSS t)
      #|  !top1:A topology top2:B topology s.\n        open_in (prod_topology top1 top2) s <=>\n        !x y. (x,y) IN s\n              ==> ?u v. open_in top1 u /\\ open_in top2 v /\\\n                        x IN u /\\ y IN v /\\ u CROSS v SUBSET s
      #|  y:B
      #|  x:A
      #|  y:B
      #|  x:A
      #|  t:B->bool = {}
      #|  s:A->bool = {}
      #|  !top1:A topology top2:B topology s t.\n        open_in (prod_topology top1 top2) (s CROSS t) <=>\n        s = {} \\/ t = {} \\/ open_in top1 s /\\ open_in top2 t
      #|  ~(u INTER s = {}) ==> s SUBSET t ==> ~(u INTER t = {})
      #|  v:B->bool
      #|  u:A->bool
      #|  y:B
      #|  x:A
      #|  w:A#B->bool
      #|  (topspace top1 CROSS v):A#B->bool
      #|  v:B->bool
      #|  (u CROSS topspace top2):A#B->bool
      #|  u:A->bool
      #|  (y:B) IN topspace top2
      #|  (x:A) IN topspace top1
      #|  y:B
      #|  x:A
      #|  (?y. y IN s /\\ y IN t) <=> ~(s INTER t = {})
      #|  !top1:A topology top2:B topology s t.\n        (prod_topology top1 top2) closure_of (s CROSS t) =\n        (top1 closure_of s) CROSS (top2 closure_of t)
      #|  t:B->bool = {}
      #|  s:A->bool = {}
      #|  !top1:A topology top2:B topology s t.\n        closed_in (prod_topology top1 top2) (s CROSS t) <=>\n        s = {} \\/ t = {} \\/ closed_in top1 s /\\ closed_in top2 t
      #|  v:B->bool = {}
      #|  u:A->bool = {}
      #|  ((u CROSS v):A#B->bool) SUBSET s CROSS t
      #|  v:B->bool
      #|  u:A->bool
      #|  y:B
      #|  x:A
      #|  y:B
      #|  x:A
      #|  w:A#B->bool
      #|  !top1:A topology top2:B topology s t.\n        (prod_topology top1 top2) interior_of (s CROSS t) =\n        (top1 interior_of s) CROSS (top2 interior_of t)
      #|  !(top1:A topology) (top2:B topology).\n        discrete_space(prod_topology top1 top2) <=>\n        topspace(prod_topology top1 top2) = {} \\/\n        discrete_space top1 /\\ discrete_space top2
      #|  P(s INTER t)\n      ==> open_in top s /\\ open_in top t ==> ?u. open_in top u /\\ P u
      #|  v:C->bool
      #|  u:B->bool
      #|  v:C->bool
      #|  u:B->bool
      #|  (h:A->C) x
      #|  (g:A->B) x
      #|  x:A
      #|  w:B#C->bool
      #|  (topspace top1:B->bool) CROSS (v:C->bool)
      #|  v:C->bool
      #|  (u:B->bool) CROSS (topspace top2:C->bool)
      #|  u:B->bool
      #|  !x. x IN topspace top ==> (h:A->C) x IN topspace top2
      #|  !x. x IN topspace top ==> (g:A->B) x IN topspace top1
      #|  !x. (f:A->B#C) x = g x,h x
      #|  h = SND o (f:A->B#C)
      #|  g = FST o (f:A->B#C)
      #|  !top top1 top2 f:A->B#C.\n        continuous_map (top,prod_topology top1 top2) f <=>\n        continuous_map (top,top1) (FST o f) /\\\n        continuous_map (top,top2) (SND o f)
      #|  !top top1 top2 (f:A->B) (g:A->C).\n        continuous_map (top,prod_topology top1 top2) (\\x. f x,g x) <=>\n        continuous_map(top,top1) f /\\ continuous_map(top,top2) g
      #|  \\x:A#B. x
      #|  top2:B topology
      #|  top1:A topology
      #|  prod_topology top1 top2 :(A#B)topology
      #|  (!top1:A topology top2:B topology.\n        continuous_map (prod_topology top1 top2,top1) FST) /\\\n   (!top1:A topology top2:B topology.\n        continuous_map (prod_topology top1 top2,top2) SND)
      #|  !top top1 top2 f:A->B#C.\n         continuous_map (top,prod_topology top1 top2) f\n         ==> continuous_map (top,top1) (\\x. FST(f x))
      #|  !top top1 top2 f:A->B#C.\n         continuous_map (top,prod_topology top1 top2) f\n         ==> continuous_map (top,top2) (\\x. SND(f x))
      #|  IMAGE SND ((u:A->bool) CROSS (v:B->bool))
      #|  v:B->bool
      #|  IMAGE FST ((u:A->bool) CROSS (v:B->bool))
      #|  u:A->bool
      #|  v:B->bool
      #|  u:A->bool
      #|  y:B
      #|  x:A
      #|  y:B
      #|  x:A
      #|  w:A#B->bool
      #|  (!top1:A topology top2:B topology.\n      open_map (prod_topology top1 top2,top1) FST) /\\\n   (!top1:A topology top2:B topology.\n      open_map (prod_topology top1 top2,top2) SND)
      #|  !top:A topology top':B topology.\n        quotient_map(prod_topology top top',top) FST <=>\n        (topspace top' = {} ==> topspace top = {})
      #|  !top:A topology top':B topology.\n        quotient_map(prod_topology top top',top') SND <=>\n        (topspace top = {} ==> topspace top' = {})
      #|  topspace top2:B->bool = {}
      #|  !top:C topology top1:A topology top2:B topology f.\n        continuous_map (prod_topology top1 top2,top) (\\x. f(FST x)) <=>\n        topspace top2 = {} \\/ continuous_map (top1,top) f
      #|  topspace top1:A->bool = {}
