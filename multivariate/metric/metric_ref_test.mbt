      #|  y:B
      #|  x:A
      #|  !top top' (f:A->B).\n        continuous_map(top,top') f /\\ hausdorff_space top'\n        ==> closed_in (prod_topology top top') {x,f x | x IN topspace top}
      #|  !top top' (f:A->B).\n        continuous_map(top,top') f /\\ hausdorff_space top'\n        ==> closed_map(top,prod_topology top top') (\\x. x,f x)
      #|  prod_topology top top':(A#B)topology
      #|  (\\x. (f:A->B) x,x) = (\\(a,b). b,a) o (\\x. x,f x)
      #|  !top top' (f:A->B).\n        continuous_map(top,top') f /\\ hausdorff_space top'\n        ==> closed_map(top,prod_topology top' top) (\\x. f x,x)
      #|  subtopology top' (IMAGE (f:A->B) s)
