      #|  !tops:K->A topology k.\n        hausdorff_space (product_topology k tops) <=>\n        topspace(product_topology k tops) = {} \\/\n        !i. i IN k ==> hausdorff_space (tops i)
      #|  topspace top DIFF c:A->bool
      #|  u:A->bool
