      #|  !top top' f g:A->B.\n        (!x. x IN topspace top ==> f x = g x) /\\ embedding_map (top,top') f\n        ==> embedding_map (top,top') g
      #|  IMAGE (g:B->C) (IMAGE (f:A->B) (topspace top))
      #|  IMAGE (f:A->B) (topspace top)
