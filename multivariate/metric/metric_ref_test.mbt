      #|  topspace top' DIFF IMAGE (f:A->B) s =\n    IMAGE f (topspace top DIFF s)
      #|  (IMAGE f t = v /\\ (!x y. x IN t /\\ y IN t /\\ f x = f y ==> x = y)) /\\\n    IMAGE f s = u /\\ s SUBSET t\n    ==> v DIFF u = IMAGE f (t DIFF s)
      #|  !(f:A->B) top top' s.\n        homeomorphic_map (top,top') f /\\ s SUBSET topspace top\n        ==> top' interior_of (IMAGE f s) = IMAGE f (top interior_of s)
      #|  topspace top:A->bool
