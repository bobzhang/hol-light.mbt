      #|  !top s:A->bool.\n        hausdorff_space top /\\ compact_in top s ==> closed_in top s
      #|  !top x:A. hausdorff_space top /\\ x IN topspace top ==> closed_in top {x}
      #|  !top x:A. hausdorff_space top\n             ==> (closed_in top {x} <=> x IN topspace top)
      #|  {y:A}
      #|  {x:A}
      #|  y:A
      #|  x:A
      #|  !u:A->bool. hausdorff_space(discrete_topology u)
      #|  !top s t:A->bool.\n        hausdorff_space top /\\ compact_in top s /\\ compact_in top t\n        ==> compact_in top (s INTER t)
      #|  !top:A topology.\n        topspace top = u /\\ FINITE u /\\ hausdorff_space top\n        ==> top = discrete_topology u
      #|  !top s:A->bool.\n        hausdorff_space top /\\ FINITE s ==> top derived_set_of s = {}
      #|  !top x:A. hausdorff_space top ==> top derived_set_of {x} = {}
      #|  !top s:A->bool.\n        hausdorff_space top /\\ s SUBSET topspace top /\\ FINITE s\n        ==> closed_in top s
      #|  !top s x:A.\n        hausdorff_space top /\\ open_in top s ==> open_in top (s DELETE x)
      #|  !top s:A->bool.\n        hausdorff_space top /\\ FINITE s\n        ==> (closed_in top s <=> s SUBSET topspace top)
      #|  !top s:A->bool.\n        hausdorff_space top\n        ==> top derived_set_of s =\n            {x | x IN topspace top /\\\n                 !u. x IN u /\\ open_in top u ==> INFINITE(s INTER u)}
      #|  s:A->bool
      #|  top:A topology
      #|  !top s:A->bool.\n        hausdorff_space top\n        ==> (s INTER top derived_set_of s = {} /\\ compact_in top s <=>\n             s SUBSET topspace top /\\ FINITE s)
      #|  topspace top:A->bool
      #|  !top:A topology.\n        hausdorff_space top\n        ==> (top derived_set_of (topspace top) = {} /\\ compact_space top <=>\n             FINITE(topspace top))
      #|  !top s:A->bool.\n        hausdorff_space top\n        ==> top derived_set_of (top derived_set_of s) SUBSET\n            top derived_set_of s
      #|  {x | x IN topspace top /\\ (f:A->B) x IN v}
      #|  {x | x IN topspace top /\\ (f:A->B) x IN u}
      #|  v:B->bool
      #|  u:B->bool
      #|  (f:A->B) y
      #|  (f:A->B) x
      #|  y:A
      #|  x:A
      #|  !top top' f:A->B.\n       continuous_map (top,top') f /\\\n       (!x y. x IN topspace top /\\ y IN topspace top /\\ f x = f y ==> x = y) /\\\n       hausdorff_space top'\n       ==> hausdorff_space top
      #|  g:B->A
      #|  f:A->B
      #|  !(top:A topology) (top':B topology).\n        top homeomorphic_space top'\n        ==> (hausdorff_space top <=> hausdorff_space top')
      #|  !top top' (r:A->B).\n        retraction_map(top,top') r /\\ hausdorff_space top\n        ==> hausdorff_space top'
      #|  top':A topology
      #|  c:A->bool
      #|  (p <=> q) <=> (p ==> q) /\\ (q ==> p)
      #|  !top top':A topology.\n        topspace top' = topspace top /\\\n        (!u. open_in top u ==> open_in top' u) /\\\n        hausdorff_space top /\\ compact_space top'\n        ==> top' = top
      #|  !top top' f:A->B.\n        compact_space top /\\ hausdorff_space top' /\\\n        continuous_map (top,top') f\n        ==> closed_map (top,top') f
      #|  !top top' f:A->B.\n        compact_space top /\\ hausdorff_space top' /\\\n        continuous_map (top,top') f /\\\n        IMAGE f (topspace top) = topspace top'\n        ==> quotient_map (top,top') f
      #|  !top top' f:A->B.\n        compact_space top /\\ hausdorff_space top' /\\\n        continuous_map (top,top') f /\\\n        IMAGE f (topspace top) = topspace top' /\\\n        (!x y. x IN topspace top /\\ y IN topspace top\n               ==> (f x = f y <=> x = y))\n        ==> homeomorphic_map(top,top') f
      #|  !top top' f:A->B.\n        compact_space top /\\ hausdorff_space top' /\\\n        continuous_map (top,top') f /\\\n        (!x y. x IN topspace top /\\ y IN topspace top\n               ==> (f x = f y <=> x = y))\n        ==> embedding_map(top,top') f
      #|  c:A->bool
