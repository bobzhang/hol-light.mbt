      #|  !top:A topology top':B topology.\n        top homeomorphic_space top'\n        ==> (INFINITE(topspace top) <=> INFINITE(topspace top'))
      #|  !top:A topology top':B topology.\n        top homeomorphic_space top'\n        ==> (COUNTABLE(topspace top) <=> COUNTABLE(topspace top'))
