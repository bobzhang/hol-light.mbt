      #|  (f:A->B) = SND o (\\x. x,f x)
      #|  !top top' (f:A->B).\n        embedding_map(top,prod_topology top top') (\\x. x,f x) <=>\n        continuous_map (top,top') f
      #|  v:B->bool
      #|  {x | x IN topspace top /\\ (f:A->B) x IN u}
      #|  v:B->bool
      #|  u:B->bool
      #|  (f:A->B) x IN topspace top'
      #|  y:B
