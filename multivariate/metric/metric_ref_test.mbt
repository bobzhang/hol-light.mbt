      #|  !(f:A->B) g top top'.\n        hausdorff_space top' /\\\n        continuous_map (top,top') f /\\\n        continuous_map (top,top') g\n        ==> closed_in top {x | x IN topspace top /\\ f x = g x}
      #|  prod_topology (top':B topology) top'
      #|  {x | x IN topspace top /\\ (f:A->B) x = g x} =\n    {x | x IN topspace top /\\ (f x,g x) IN {(z,z) | z IN topspace top'}}
      #|  !top top' f g:A->B.\n        hausdorff_space top' /\\\n        continuous_map (top,top') f /\\ continuous_map (top,top') g /\\\n        (!x. x IN s ==> f x = g x)\n        ==> !x. x IN top closure_of s ==> f x = g x
      #|  top:A topology
      #|  s = {x | x IN topspace top /\\ (r:A->A) x = x}
      #|  !top s:A->bool.\n        hausdorff_space top /\\ s retract_of_space top ==> closed_in top s
      #|  top':B topology
      #|  subtopology top (IMAGE (s:B->A) (topspace top'))
      #|  s:B->A
      #|  !(P:A topology->bool) (Q:B topology->bool).\n        (!top. P top ==> hausdorff_space top) /\\\n        (!top s. P top /\\ closed_in top s ==> P(subtopology top s)) /\\\n        (!top top'. top homeomorphic_space top' ==> (P top <=> Q top'))\n        ==> !top top' r. retraction_map(top,top') r /\\ P top ==> Q top'
      #|  (f:A->B) = SND o (\\x. x,f x)
