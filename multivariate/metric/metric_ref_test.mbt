      #|  !k (top:K->A topology) u.\n        closed_in (sum_topology k top) (disjoint_union k u) <=>\n        !i. i IN k ==> closed_in (top i) (u i)
      #|  !k (top:K->A topology) u.\n        closed_in (sum_topology k top) u <=>\n        ?t. u = disjoint_union k t /\\\n            !i. i IN k ==> closed_in (top i) (t i)
      #|  !k (top:K->A topology).\n        (!u. closed_in (sum_topology k top) u ==> P u) <=>\n        (!t. (!i. i IN k ==> closed_in (top i) (t i))\n             ==> P(disjoint_union k t))
      #|  !k (top:K->A topology).\n        (?u. closed_in (sum_topology k top) u /\\ P u) <=>\n        (?t. (!i. i IN k ==> closed_in (top i) (t i)) /\\\n             P(disjoint_union k t))
      #|  j:K = i
      #|  j:K
      #|  x:A
      #|  u:A->bool
      #|  !k (top:K->A topology) i.\n        i IN k ==> open_map(top i,sum_topology k top) (\\x. (i,x))
      #|  j:K = i
      #|  j:K
      #|  x:A
      #|  u:A->bool
      #|  !k (top:K->A topology) i.\n        i IN k ==> closed_map(top i,sum_topology k top) (\\x. (i,x))
      #|  {x | x IN s /\\ P x} = s INTER {x | P x}
      #|  !k (top:K->A topology) i.\n        i IN k ==> continuous_map(top i,sum_topology k top) (\\x. (i,x))
      #|  disjoint_union k (t:K->A->bool)
      #|  t:K->A->bool
      #|  u:K->A->bool
      #|  (p <=> q) <=> (p ==> q) /\\ (q ==> p)
      #|  !k top s:K->A->bool.\n        subtopology (sum_topology k top) (disjoint_union k s) =\n        sum_topology k (\\i. subtopology (top i) (s i))
      #|  homeomorphic_map (top,top') (f:A->B) <=>\n      quotient_map (top,top') f /\\\n      !x y. x IN topspace top /\\ y IN topspace top\n            ==> (f x = f y <=> x = y)
      #|  homeomorphic_maps(top,top') (f:A->B,g) <=>\n        continuous_map(top,top') f /\\\n        continuous_map(top',top) g /\\\n        (!x. x IN topspace top ==> g(f x) = x) /\\\n        (!y. y IN topspace top' ==> f(g y) = y)
      #|  !top top' f g:A->B.\n        (!x. x IN topspace top ==> f x = g x) /\\ homeomorphic_map (top,top') f\n        ==> homeomorphic_map (top,top') g
      #|  !top top' f (f':A->B) g g'.\n        (!x. x IN topspace top ==> f x = f' x) /\\\n        (!x. x IN topspace top' ==> g x = g' x) /\\\n        homeomorphic_maps (top,top') (f,g)\n        ==> homeomorphic_maps (top,top') (f',g')
      #|  !(f:A->B) g top top'.\n        homeomorphic_maps(top,top') (f,g) <=>\n        homeomorphic_maps(top',top) (g,f)
      #|  s SUBSET u ==> {x | x IN u /\\ x IN s} = s
      #|  s SUBSET u ==> {x | x IN u /\\ x IN s} = s
      #|  topspace top':A->bool = topspace top
      #|  !top top':A topology.\n        homeomorphic_maps(top,top') ((\\x. x),(\\x. x)) <=> top' = top
      #|  s SUBSET u ==> {x | x IN u /\\ x IN s} = s
      #|  !top top':A topology.\n        homeomorphic_map(top,top') (\\x. x) <=> top' = top
      #|  !top top':A topology.\n        homeomorphic_maps(top,top') (I,I) <=> top' = top
      #|  !top top':A topology. homeomorphic_map(top,top') I <=> top' = top
      #|  !top top' top'' (f:A->B) (g:B->C).\n        homeomorphic_map(top,top') f /\\ homeomorphic_map(top',top'') g\n        ==> homeomorphic_map(top,top'') (g o f)
      #|  !top top' top'' (f:A->B) (g:B->C) h k.\n        homeomorphic_maps(top,top') (f,h) /\\\n        homeomorphic_maps(top',top'') (g,k)\n        ==> homeomorphic_maps(top,top'') (g o f,h o k)
      #|  !x y. x IN topspace top /\\ y IN topspace top\n          ==> ((f:A->B) x = f y <=> x = y)
      #|  !top top' f:A->B.\n        homeomorphic_map (top,top') f <=>\n        continuous_map (top,top') f /\\\n        open_map (top,top') f /\\\n        closed_map (top,top') f /\\\n        IMAGE f (topspace top) = topspace top' /\\\n        !x y. x IN topspace top /\\ y IN topspace top\n              ==> (f x = f y <=> x = y)
      #|  !top top' (f:A->B).\n        homeomorphic_map(top,top') f ==> quotient_map(top,top') f
      #|  !top top' f:A->B.\n        homeomorphic_map (top,top') f ==> continuous_map (top,top') f
