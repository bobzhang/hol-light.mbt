      #|  !m m1 m2 (f:A->B) (g:A->C).\n        uniformly_continuous_map (m,prod_metric m1 m2) (\\x. f x,g x) <=>\n        uniformly_continuous_map(m,m1) f /\\ uniformly_continuous_map(m,m2) g
