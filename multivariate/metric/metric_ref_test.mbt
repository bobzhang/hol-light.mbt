      #|  y:B
      #|  x:A
      #|  (topspace top1 CROSS topspace top2):A#B->bool = {}
      #|  !top1:A topology top2:B topology.\n        hausdorff_space(prod_topology top1 top2) <=>\n        topspace(prod_topology top1 top2) = {} \\/\n        hausdorff_space top1 /\\ hausdorff_space top2
      #|  v:A->bool
      #|  u:A->bool
      #|  m:K
      #|  topspace(product_topology k tops) INTER {x:K->A | x m IN v}
      #|  topspace(product_topology k tops) INTER {x:K->A | x m IN u}
      #|  v:A->bool
      #|  u:A->bool
      #|  (g:K->A) m
      #|  (f:K->A) m
      #|  m:K
      #|  (m:K) IN k
      #|  m:K
      #|  p /\\ q /\\ r ==> s <=> r ==> p /\\ q ==> s
      #|  g:K->A
      #|  f:K->A
