      #|  (k:A->bool) CROSS k
      #|  k:A->bool
      #|  (p ==> q) /\\ (p ==> r) <=> p ==> q /\\ r
      #|  !top:A topology.\n        kc_space(prod_topology top top) <=>\n        !k. compact_in top k ==> hausdorff_space(subtopology top k)
      #|  !top:A topology.\n        kc_space(prod_topology top top) <=>\n        kc_space top /\\\n        !k. compact_in top k ==> hausdorff_space(subtopology top k)
      #|  (topspace top DIFF c:A->bool) CROSS (v:B->bool)
