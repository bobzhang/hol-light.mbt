      #|  !top top' (f:A->B) s.\n        hausdorff_space top /\\\n        s SUBSET topspace top /\\\n        top closure_of s = topspace top /\\\n        continuous_map (top,top') f /\\\n        embedding_map (subtopology top s,top') f\n        ==> DISJOINT (IMAGE f s) (IMAGE f (topspace top DIFF s))
      #|  kc_space (top:A topology) <=> !s. compact_in top s ==> closed_in top s
      #|  !top top':A topology.\n         topspace top' = topspace top /\\ (!u. open_in top u ==> open_in top' u)\n         ==> kc_space top ==> kc_space top'
      #|  !top s:A->bool. kc_space top /\\ compact_in top s ==> closed_in top s
