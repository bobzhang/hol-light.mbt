      #|  !top top' top'' (f:A->B) (g:B->C).\n        embedding_map(top,top') f /\\ embedding_map(top',top'') g\n        ==> embedding_map(top,top'') (g o f)
      #|  !top top' f:A->B.\n      embedding_map (top,top') f /\\ IMAGE f (topspace top) = topspace top' <=>\n      homeomorphic_map (top,top') f
