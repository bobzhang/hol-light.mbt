      #|  closed_in top (u:A->bool)
      #|  u:A->bool
      #|  !top top' (f:A->B) g.\n        (!x. x IN topspace top ==> f x IN topspace top' /\\ g(f x) = x) /\\\n        (!y. y IN topspace top' ==> g y IN topspace top /\\ f(g y) = y)\n        ==> (closed_map (top,top') f <=> continuous_map (top',top) g)
      #|  f:A->B
      #|  g:B->A
