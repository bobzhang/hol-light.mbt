      #|  !m m1 m2 (f:A->B#C).\n        cauchy_continuous_map(m,prod_metric m1 m2) f <=>\n        cauchy_continuous_map(m,m1) (FST o f) /\\\n        cauchy_continuous_map(m,m2) (SND o f)
