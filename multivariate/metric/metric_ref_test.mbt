      #|  (!(top:A topology) (top':B topology).\n        topspace top = {}\n        ==> (top homeomorphic_space top' <=> topspace top' = {})) /\\\n   (!(top:A topology) (top':B topology).\n        topspace top' = {}\n        ==> (top homeomorphic_space top' <=> topspace top = {}))
