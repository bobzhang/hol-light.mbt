      #|  lindelof_space (top:A topology) <=>\n        !U. (!u. u IN U ==> open_in top u) /\\ UNIONS U = topspace top\n            ==> ?V. COUNTABLE V /\\ V SUBSET U /\\ UNIONS V = topspace top
