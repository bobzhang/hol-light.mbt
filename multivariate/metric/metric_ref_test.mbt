  log.attempt("OPEN_IN_UNIONS", () => sthm(@metric.open_in_unions()))
  log.attempt("OPEN_IN_UNION", () => sthm(@metric.open_in_union()))
  log.attempt("OPEN_IN_TOPSPACE", () => sthm(@metric.open_in_topspace()))
  log.attempt("OPEN_IN_INTERS", () => sthm(@metric.open_in_inters()))
