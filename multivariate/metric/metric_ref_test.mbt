      #|  (topspace top1 CROSS v):A#B->bool
      #|  (topspace top1 CROSS u):A#B->bool
      #|  v:B->bool
      #|  u:B->bool
      #|  y':B
      #|  y:B
      #|  (v CROSS topspace top2):A#B->bool
      #|  (u CROSS topspace top2):A#B->bool
