      #|  !top top' (f:A->B).\n        continuous_map(top,top') f /\\ hausdorff_space top'\n        ==> proper_map(top,prod_topology top top') (\\x. x,f x)
      #|  !top top' (f:A->B).\n        continuous_map(top,top') f /\\ hausdorff_space top'\n        ==> proper_map(top,prod_topology top' top) (\\x. f x,x)
      #|  c SUBSET k\n      ==> {x | x IN u INTER {x | x IN u /\\ f x IN k} /\\ f x IN c} =\n          {x | x IN u /\\ f x IN c}
      #|  t:B->bool
