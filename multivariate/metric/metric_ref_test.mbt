      #|  topspace top = {x | x IN topspace top /\\ (f:A->B) x IN topspace top'}
      #|  !top top' (f:A->B).\n        proper_map(top,top') f /\\\n        IMAGE f (topspace top) = topspace top' /\\\n        compact_space top'\n        ==> compact_space top
