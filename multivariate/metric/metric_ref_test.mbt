      #|  homotopic_with P (X,Y) p q <=>\n   ?h. continuous_map\n       (prod_topology (subtopology euclideanreal (real_interval[&0,&1])) X,\n        Y) h /\\\n       (!x. h(&0,x) = p x) /\\ (!x. h(&1,x) = q x) /\\\n       (!t. t IN real_interval[&0,&1] ==> P(\\x. h(t,x)))
