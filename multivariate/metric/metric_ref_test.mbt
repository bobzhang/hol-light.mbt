      #|  !top top' top'' (f:A->B) (g:B->C).\n        hausdorff_space top' /\\\n        proper_map(top,top'') (g o f) /\\\n        continuous_map(top,top') f /\\\n        continuous_map(top',top'') g\n        ==> proper_map(top,top') f
