// Load-fidelity test for Multivariate/metric.ml: replays tools/ocaml_ref/Multivariate_metric_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "Multivariate/metric matches Multivariate/metric.ml" {
  @metric.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "Library/wo", "Library/card", "Library/floor", "Multivariate/misc",
      "Library/products", "Library/iter", "Multivariate/metric",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Multivariate/metric")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("istopology", () => sthm(@metric.istopology()))
  log.attempt("topology_tybij_th", () => sthm(@metric.topology_tybij_th()))
  log.attempt("topology_tybij", () => sthm(@metric.topology_tybij()))
  log.attempt("ISTOPOLOGY_OPEN_IN", () => sthm(@metric.istopology_open_in()))
