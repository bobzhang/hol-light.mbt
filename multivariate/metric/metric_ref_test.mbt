      #|  !top:A topology.\n        hausdorff_space top <=>\n        !x. x IN topspace top\n            ==> ?u c. open_in top u /\\\n                      closed_in top c /\\\n                      hausdorff_space(subtopology top c) /\\\n                      x IN u /\\\n                      u SUBSET c
      #|  !top s:A->bool.\n        hausdorff_space top /\\ s SUBSET top derived_set_of s /\\ ~(s = {})\n        ==> INFINITE s
      #|  (p /\\ q) /\\ ~(p /\\ r) <=> p /\\ q /\\ ~r
