      #|  !top (f:A->A).\n        continuous_map(top,top) f /\\ (!x. x IN topspace top ==> f(f x) = x)\n        ==> homeomorphic_maps (top,top) (f,f)
      #|  !top (f:A->A).\n        continuous_map(top,top) f /\\ (!x. x IN topspace top ==> f(f x) = x)\n        ==> homeomorphic_map (top,top) f
