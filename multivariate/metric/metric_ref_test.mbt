      #|  first_countable (top:A topology) <=>\n        !x. x IN topspace top\n            ==> ?b. COUNTABLE b /\\\n                    (!v. v IN b ==> open_in top v) /\\\n                    (!u. open_in top u /\\ x IN u\n                         ==> ?v. v IN b /\\ x IN v /\\ v SUBSET u)
