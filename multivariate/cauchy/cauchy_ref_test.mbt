      #|  !f1 i1 f2 i2 g.\n        (f1 has_path_integral i1) g /\\ (f2 has_path_integral i2) g\n        ==> ((\\x. f1(x) + f2(x)) has_path_integral (i1 + i2)) g
      #|  !f1 i1 f2 i2 g.\n        (f1 has_path_integral i1) g /\\ (f2 has_path_integral i2) g\n         ==> ((\\x. f1(x) - f2(x)) has_path_integral (i1 - i2)) g
