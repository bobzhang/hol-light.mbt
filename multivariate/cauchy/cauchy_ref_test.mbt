      #|  !f i a b B.\n        (f has_path_integral i) (linepath(a,b)) /\\\n        &0 <= B /\\ (!x. x IN segment[a,b] ==> norm(f x) <= B)\n        ==> norm(i) <= B * norm(b - a)
