      #|  !f g c.  f path_integrable_on g\n           ==> path_integral g (\\x. c * f x) = c * path_integral g f
      #|  !f g c.  f path_integrable_on g\n           ==> path_integral g (\\x. f x * c) = path_integral g f * c
      #|  !f g c.  f path_integrable_on g\n           ==> path_integral g (\\x. f x / c) = path_integral g f / c
