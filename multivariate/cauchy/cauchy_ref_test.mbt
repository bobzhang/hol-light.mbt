      #|  !f p s. FINITE s /\\ (!a. a IN s ==> (f a has_path_integral i a) p)\n           ==> ((\\x. vsum s (\\a. f a x)) has_path_integral vsum s i) p
      #|  !a b c. path_integral (linepath(a,b)) (\\x. c) = c * (b - a)
