      x429 : @list.List[@kernel.Thm],
    ) -> @list.List[@kernel.Thm] raise {
      let ths = x428
      let sofar_1 = x429
      let dunnit = @lib.setify(
        @lib.map(
          fn(x434 : @kernel.Thm) -> @kernel.Term raise {
            (fn(x432 : @kernel.Term) -> @kernel.Term raise {
              (fn(
                x430 : (@kernel.Term, @list.List[@kernel.Term]),
              ) -> @kernel.Term raise {
                x430.0
