        @simp.rewrite_tac(@list.List([@class.fun_eq_thm()])),
      ),
      @nums.induct_tac,
    ),
    t354,
  )
  fcons_undo_c.set(
    @tactics.prove(
      @parser.parse_term("!f:num->A. f = FCONS (f 0) (f o SUC)"),
      t355,
    ),
  )
}

