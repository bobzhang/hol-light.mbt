}

///|
/// EXISTS_OPTION_THM
fn step_42() -> Unit raise {
  let t799 = @meson.meson_tac(@list.empty())
  let t798 = @simp.rewrite_tac(@list.List([forall_option_thm()]))
  let t800 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.gen_tac,
        @simp.rewrite_tac(
          @list.List([
            @meson.meson(
              @list.empty(),
              @parser.parse_term("(?x. P x) <=> ~(!x. ~P x)"),
            ),
          ]),
        ),
      ),
      t798,
    ),
    t799,
  )
  exists_option_thm_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!P:A option->bool. (?x. P x) <=> P NONE \\/ ?a. P(SOME a)",
      ),
      t800,
    ),
  )
}

