///|
fn[TA, TB, TC : Eq + @lib.OCompare + @lib.OHash] allopairs_l(
  x825 : (TC) -> ((TB) -> TA raise) raise,
  x826 : @list.List[TC],
  x827 : @list.List[TB],
) -> @list.List[TA] raise {
  let f = x825
  let l = x826
  let m = x827
  if l == @list.empty() {
    @list.empty()
  } else {
    let t829 = @lib.tl(m)
    let t830 = allopairs_l(f, @lib.tl(l), t829)
    let t828 = @lib.tl(m)
    @lib.map(f(@lib.hd(l)), t828).concat(t830)
  }
}

