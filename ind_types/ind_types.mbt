///|
/// FORALL_OPTION_THM
fn step_41() -> Unit raise {
  let t796 = @simp.simp_tac(@list.empty())
  let t795 = @simp.rewrite_tac(@list.List([option_induct()]))
  let t797 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(@tactics.gen_tac, @tactics.eq_tac),
      t795,
    ),
    t796,
  )
  forall_option_thm_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!P:A option->bool. (!x. P x) <=> P NONE /\\ !a. P(SOME a)",
      ),
      t797,
    ),
  )
}

