  let prove_triv : (@kernel.Term) -> @kernel.Thm raise = fn(
    x881 : @kernel.Term,
  ) -> @kernel.Thm raise {
    let tm = x881
    let (evs, bod) = @basics.strip_exists(tm)
    let (l, r) = @kernel.dest_eq(bod)
    if l == r {
      @kernel.refl(l)
    } else {
      let (lf, largs) = @basics.strip_comb(l)
      let (rf, rargs) = @basics.strip_comb(r)
