          let fethm = @bool.choose_rule(fn__1, eth, rethm)
          let pcons = @lib.map(
            fn(x719 : @kernel.Term) -> @kernel.Term raise {
              (fn(x715 : @kernel.Term) -> @kernel.Term raise {
