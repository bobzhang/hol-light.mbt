        args,
        @kernel.assume_rule(@basics.dest_exists(@kernel.concl(eth)).1),
      )
      let cth2 = @kernel.inst_rule(@lib.zip(args_p, args), cth1)
      let pth = @kernel.trans(@kernel.trans(@equal.sym(cth1), bth), cth2)
      let qth = depair(pth)
