fn step_58() -> Unit raise {
  the_inductive_types_c.set(Ref::{
    val: @list.List([
      ("list = NIL | CONS A list", (list_induct(), list_recursion())),
      ("option = NONE | SOME A", (option_induct(), option_recursion())),
      ("sum = INL A | INR B", (sum_induct(), sum_recursion())),
