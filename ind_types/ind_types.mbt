                (fn(
                  x431 : @kernel.Term,
                ) -> (@kernel.Term, @list.List[@kernel.Term]) raise {
                  @basics.strip_comb(x431)
                })(x432),
              )
            })(
              (fn(x433 : @kernel.Thm) -> @kernel.Term raise {
                @kernel.concl(x433)
