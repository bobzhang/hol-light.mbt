pub fn[TA, TB] bm_induct_tac(x155 : (@list.List[(TB, @kernel.Thm)], @kernel.Term)) -> (((@list.List[@kernel.Term], @drule.Instantiation), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], (TA) -> ((@list.List[@kernel.Thm]) -> @kernel.Thm raise) raise)) raise {
