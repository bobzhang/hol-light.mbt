    (@list.empty(), (x155 : @list.List[@kernel.Thm]) => apply_fproof("meson_heuristic", fn(x154 : @list.List[@kernel.Thm]) -> @kernel.Thm raise {
      let ths = x154
      meth
    }, @list.empty(), x155))
  } catch {
    Failure(_) => raise Failure("meson_heuristic")
    e => raise e
  }
}

///|
/// `taut_heuristic`
pub fn taut_heuristic(x156 : @kernel.Term, x157 : Bool) -> ((@list.List[(@kernel.Term, Bool)], (@list.List[@kernel.Thm]) -> @kernel.Thm raise)) raise {
  let (tm, _ as i) = (x156, x157)
