  let (tm_1, n_1, f_4) = x80
  let insts_1 = x81
  let (not_instl_1, instl_1) = instances_l((tm_1, n_1), insts_1)
  if @list.List::is_empty(instl_1) {
    try {
      let t91 = @lib.list_split(insts_1)
      (fn(x88 : (@list.List[InstTree], @list.List[(@kernel.Thm) -> @kernel.Thm raise])) -> @list.List[(InstTree, (@kernel.Thm) -> @kernel.Thm raise)] raise {
        @support.lcombinep(x88.0, x88.1)
      })(((x90 : (@list.List[InstTree], @list.List[(@kernel.Thm) -> @kernel.Thm raise])) => @support.hashi((x89 : @list.List[InstTree]) => insert_into_inst_trees_p_l((tm_1, n_1), x89), x90))(t91))
    } catch {
      Failure(_) => insts_1.prepend((InstTree::No_insts((tm_1, n_1)), f_4))
      e => raise e
    }
  } else {
    not_instl_1.prepend((InstTree::Insts((tm_1, n_1, instl_1)), f_4))
  }
}

///|
fn[TA, TB] instances_l(x82 : (@kernel.Term, TB), x83 : @list.List[(InstTree, TA)]) -> ((@list.List[(InstTree, TA)], @list.List[(InstTree, (@kernel.Thm) -> @kernel.Thm raise)])) raise {
  let (tm_2, n_2) = x82
  let insts_2 = x83
  if @list.List::is_empty(insts_2) {
    (@list.empty(), @list.empty())
  } else {
    let (not_instl, instl) = instances_l((tm_2, n_2), @lib.tl(insts_2))
    let (h, f_5) = @lib.hd(insts_2)
    let (tm_p_4, n_p_4) = match h {
      InstTree::No_insts((tm_p_2, n_p_2)) => (tm_p_2, n_p_2)
      InstTree::Insts((tm_p_3, n_p_3, _)) => (tm_p_3, n_p_3)
    }
    try {
      let f_p : (@kernel.Thm) -> @kernel.Thm raise = inst_of(tm_p_4, tm_2)
      (not_instl, instl.prepend((h, f_p)))
    } catch {
      Failure(_) => (not_instl.prepend((h, f_5)), instl)
      e => raise e
    }
  }
}

///|
fn insert_into_inst_trees_p_l(x84 : (@kernel.Term, Int64), x85 : @list.List[InstTree]) -> @list.List[InstTree] raise {
  let (tm_3, n_3) = x84
  let trees = x85
  if @list.List::is_empty(trees) {
    raise Failure("insert_into_inst_trees'")
  } else {
    try {
      let t86 = @lib.tl(trees)
      t86.prepend(insert_into_inst_tree((tm_3, n_3), @lib.hd(trees)))
    } catch {
      Failure(_) => {
        let t87 = insert_into_inst_trees_p_l((tm_3, n_3), @lib.tl(trees))
        t87.prepend(@lib.hd(trees))
      }
      e => raise e
    }
  }
}

///|
/// `mk_inst_trees`
pub fn mk_inst_trees(x92 : @list.List[(@kernel.Term, Int64)]) -> @list.List[InstTree] raise {
  let tmnl = x92
  fn mk_inst_trees_p(x93 : @list.List[(InstTree, (@kernel.Thm) -> @kernel.Thm raise)], x94 : @list.List[(@kernel.Term, Int64)]) -> @list.List[(InstTree, (@kernel.Thm) -> @kernel.Thm raise)] raise {
    let insts = x93
    let tmnl_1 = x94
    if @list.List::is_empty(tmnl_1) {
      insts
    } else {
      let (tm, n) = @lib.hd(tmnl_1)
      let t96 = @lib.tl(tmnl_1)
      mk_inst_trees_p(insert_into_inst_trees((tm, n, fn(x95 : @kernel.Thm) -> @kernel.Thm raise {
        x95
      }), insts), t96)
    }
  }
  @lib.map(fn(x97 : (InstTree, (@kernel.Thm) -> @kernel.Thm raise)) -> InstTree raise {
    x97.0
  }, mk_inst_trees_p(@list.empty(), tmnl))
}

///|
/// `roots_of_inst_trees`
pub fn roots_of_inst_trees(x98 : @list.List[InstTree]) -> @list.List[@kernel.Term] raise {
  let trees = x98
  if @list.List::is_empty(trees) {
    @list.empty()
  } else {
    let tm_2 = match @lib.hd(trees) {
      InstTree::No_insts((tm, _)) => tm
      InstTree::Insts((tm_1, _, _)) => tm_1
    }
    roots_of_inst_trees(@lib.tl(trees)).prepend(tm_2)
  }
}

///|
/// `prove_inst_tree`
pub fn prove_inst_tree(x99 : InstTree, x100 : @kernel.Thm) -> @list.List[(@kernel.Thm, Int64)] raise {
  let tree = x99
  let th = x100
  match tree {
    InstTree::No_insts((tm, n)) => {
      if fproves(th, tm) {
        @list.List([(th, n)])
      } else {
        raise Failure("prove_inst_tree")
      }
    }
    InstTree::Insts((tm_1, n_1, insts)) => {
      if fproves(th, tm_1) {
        @lib.flat(@lib.map(fn(x101 : (InstTree, (@kernel.Thm) -> @kernel.Thm raise)) -> @list.List[(@kernel.Thm, Int64)] raise {
          let (tr, f) = x101
          prove_inst_tree(tr, f(th))
        }, insts)).prepend((th, n_1))
      } else {
        raise Failure("prove_inst_tree")
      }
    }
  }
}

///|
/// `prove_inst_trees`
pub fn prove_inst_trees(x102 : @list.List[InstTree], x103 : @list.List[@kernel.Thm]) -> @list.List[@kernel.Thm] raise {
  let trees = x102
  let ths = x103
  try {
    @lib.map(fn(x104 : (@kernel.Thm, Int64)) -> @kernel.Thm raise {
      x104.0
    }, @support.sort_on_snd(@lib.flat(@lib.map((x105 : (InstTree, @kernel.Thm)) => @lib.uncurry(prove_inst_tree, x105), @support.lcombinep(trees, ths)))))
  } catch {
    Failure(_) => raise Failure("prove_inst_trees")
    e => raise e
  }
}

///|
/// `prove_pool`
pub fn prove_pool(x106 : (@kernel.Term) -> @kernel.Thm raise, x107 : @list.List[@kernel.Term]) -> @list.List[@kernel.Thm] raise {
  let conv = x106
  let tml = x107
  let tmnl = @support.number_list(tml)
  let trees = mk_inst_trees(tmnl)
  let most_gen_terms = roots_of_inst_trees(trees)
  let ths = @lib.map(conv, most_gen_terms)
  prove_inst_trees(trees, ths)
}

///|
/// `WATERFALL`
pub fn waterfall_v1(x108 : @list.List[((@kernel.Term, Bool)) -> (@list.List[(@kernel.Term, Bool)], (@list.List[@kernel.Thm]) -> @kernel.Thm raise) raise], x109 : ((@kernel.Term, Bool)) -> (@list.List[(@kernel.Term, Bool)], (@list.List[@kernel.Thm]) -> @kernel.Thm raise) raise, x110 : (@kernel.Term, Bool)) -> @kernel.Thm raise {
  let heuristics = x108
  let induction = x109
  let (tm, _ as ind) = x110
  let conv : (@kernel.Term) -> @kernel.Thm raise = fn(x111 : @kernel.Term) -> @kernel.Thm raise {
    let tm_1 = x111
    proof_print_string("Doing induction on:", ())
    {
      @environment.bm_steps().val = @support.hash(fn(x112 : Int64) -> Int64 raise {
        @lib.add63(1L, x112)
      }, fn(x113 : Int64) -> Int64 raise {
        @lib.add63(1L, x113)
      }, @environment.bm_steps().val)
      ()
    }
    ignore(proof_print_term(tm_1))
    let void = proof_print_newline(())
    let (tmil, proof) = induction((tm_1, false))
    dec_print_depth(proof(@lib.map((x114 : (@kernel.Term, Bool)) => waterfall_v1(heuristics, induction, x114), inc_print_depth(tmil))))
  }
  let void_1 = proof_print_newline(())
  let tree = waterfall(heuristics, (tm, ind))
  let tmil_1 = fringe_of_clause_tree(tree)
  let thl = prove_pool(conv, @lib.map(fn(x115 : (@kernel.Term, Bool)) -> @kernel.Term raise {
    x115.0
  }, tmil_1))
  prove_clause_tree(tree, thl)
}

///|
/// `FILTERED_WATERFALL`
pub fn filtered_waterfall_v1(x116 : @list.List[((@kernel.Term, Bool)) -> (@list.List[(@kernel.Term, Bool)], (@list.List[@kernel.Thm]) -> @kernel.Thm raise) raise], x117 : ((@kernel.Term, Bool)) -> (@list.List[(@kernel.Term, Bool)], (@list.List[@kernel.Thm]) -> @kernel.Thm raise) raise, x118 : @list.List[(@kernel.Term, Int64)], x119 : (@kernel.Term, Bool)) -> @kernel.Thm raise {
  let heuristics = x116
  let induction = x117
  let warehouse = x118
  let (tm, _ as ind) = x119
  let conv : (@kernel.Term) -> @kernel.Thm raise = fn(x120 : @kernel.Term) -> @kernel.Thm raise {
    let tm_1 = x120
    let constr_check = (@environment.max_var_depth(tm_1) > 12L)
    if constr_check {
      let void = @lib.warn(true, "Reached maximum depth!")
      raise Failure("cannot prove")
    } else {
      let heurn = try {
        @lib.assoc(tm_1, warehouse)
      } catch {
        Failure(_) => 0L
        e => raise e
      }
      let warehouse_1 = if (heurn > 0L) {
        @lib.list_remove_assoc(tm_1, warehouse)
      } else {
        warehouse
      }
      if (heurn > Int::to_int64(@lib.length(heuristics))) {
        @lib.warn(true, "Induction loop detected.")
        raise Failure("cannot prove")
      } else {
        proof_print_string("Doing induction on:", ())
      }
      {
        @environment.bm_steps().val = @support.hash(fn(x121 : Int64) -> Int64 raise {
          @lib.add63(1L, x121)
        }, fn(x122 : Int64) -> Int64 raise {
          @lib.add63(1L, x122)
        }, @environment.bm_steps().val)
        ()
      }
      ignore(proof_print_term(tm_1))
      let void_1 = proof_print_newline(())
      let (tmil, proof) = induction((tm_1, false))
      let t125 = inc_print_depth(tmil)
      let t123 = warehouse_1.prepend((tm_1, @lib.add63(Int::to_int64(@lib.length(heuristics)), 1L)))
      dec_print_depth(proof(@lib.map((x124 : (@kernel.Term, Bool)) => filtered_waterfall_v1(heuristics, induction, t123, x124), t125)))
    }
  }
  let void_2 = proof_print_newline(())
  let tree = filtered_waterfall(heuristics, @list.empty(), (tm, ind))
  let tmil_1 = fringe_of_clause_tree(tree)
  let thl = prove_pool(conv, @lib.map(fn(x126 : (@kernel.Term, Bool)) -> @kernel.Term raise {
    x126.0
  }, tmil_1))
  prove_clause_tree(tree, thl)
}

///|
/// `conjuncts_heuristic`
pub fn conjuncts_heuristic(x127 : @kernel.Term, x128 : Bool) -> ((@list.List[(@kernel.Term, Bool)], (@list.List[@kernel.Thm]) -> @kernel.Thm raise)) raise {
  let (tm, _ as i) = (x127, x128)
  let tms = @support.conj_list(tm)
  if (Int::to_int64(@lib.length(tms)) == 1L) {
    raise Failure("conjuncts_heuristic")
  } else {
    (@lib.map(fn(x129 : @kernel.Term) -> (@kernel.Term, Bool) raise {
      let tm_1 = x129
      (tm_1, i)
    }, tms), (x130 : @list.List[@kernel.Thm]) => apply_fproof("conjuncts_heuristic", @environment.list_conj, tms, x130))
  }
}

///|
/// `refl_heuristic`
pub fn refl_heuristic(x131 : @kernel.Term, x132 : Bool) -> ((@list.List[(@kernel.Term, Bool)], (@list.List[@kernel.Thm]) -> @kernel.Thm raise)) raise {
  let (tm, _ as i) = (x131, x132)
  try {
    let t133 = @equal.rhs(tm)
    if (@equal.lhs(tm) == t133) {
      (@list.empty(), (x135 : @list.List[@kernel.Thm]) => apply_fproof("refl_heuristic", fn(x134 : @list.List[@kernel.Thm]) -> @kernel.Thm raise {
        let ths = x134
        @kernel.refl(@equal.lhs(tm))
      }, @list.empty(), x135))
    } else {
      raise Failure("")
    }
  } catch {
    Failure(_) => raise Failure("refl_heuristic")
    e => raise e
  }
}

///|
/// `clausal_form_heuristic`
pub fn clausal_form_heuristic(x136 : @kernel.Term, x137 : Bool) -> ((@list.List[(@kernel.Term, Bool)], (@list.List[@kernel.Thm]) -> @kernel.Thm raise)) raise {
  let (tm, _ as i) = (x136, x137)
  try {
    let is_atom : (@kernel.Term) -> Bool raise = fn(x138 : @kernel.Term) -> Bool raise {
      let tm_1 = x138
      (!@clausal_form.has_boolean_args_and_result(tm_1) || (@kernel.is_var(tm_1) || @kernel.is_const(tm_1)))
    }
    let is_literal : (@kernel.Term) -> Bool raise = fn(x139 : @kernel.Term) -> Bool raise {
      let tm_2 = x139
      (is_atom(tm_2) || (@basics.is_neg(tm_2) && (try {
        is_atom(@kernel.rand(tm_2))
      } catch {
        Failure(_) => false
        e => raise e
      })))
    }
    let is_clause : (@kernel.Term) -> Bool raise = fn(x140 : @kernel.Term) -> Bool raise {
      let tm_3 = x140
      @lib.forall(is_literal, @support.disj_list(tm_3))
    }
    if (@lib.forall(is_clause, @support.conj_list(tm)) && (!@basics.free_in(@parser.parse_term("T"), tm) && !@basics.free_in(@parser.parse_term("F"), tm))) {
      if @basics.is_conj(tm) {
        let tms_1 = @support.conj_list(tm)
        proof_print_string_l(result_string_l(tms_1), ())
        (@lib.map(fn(x143 : @kernel.Term) -> (@kernel.Term, Bool) raise {
          let tm_4 = x143
          (tm_4, i)
        }, tms_1), (x144 : @list.List[@kernel.Thm]) => apply_fproof("clausal_form_heuristic", @environment.list_conj, tms_1, x144))
      } else {
        raise Failure("")
      }
    } else {
      let th = @clausal_form.clausal_form_conv(tm)
      let tm_p = @equal.rhs(@kernel.concl(th))
      if @support.is_t(tm_p) {
        proof_print_string_l("-> Clausal Form Heuristic", ())
        (@list.empty(), (x146 : @list.List[@kernel.Thm]) => apply_fproof("clausal_form_heuristic", fn(x145 : @list.List[@kernel.Thm]) -> @kernel.Thm raise {
          @bool.eqt_elim(th)
        }, @list.empty(), x146))
      } else {
        let tms_2 = @support.conj_list(tm_p)
        proof_print_string_l(result_string_l(tms_2), ())
        let t148 = @equal.sym(th)
        (@lib.map(fn(x147 : @kernel.Term) -> (@kernel.Term, Bool) raise {
          let tm_5 = x147
          (tm_5, i)
        }, tms_2), (x151 : @list.List[@kernel.Thm]) => apply_fproof("clausal_form_heuristic", fn(x150 : @list.List[@kernel.Thm]) -> @kernel.Thm raise {
          ((x149 : @kernel.Thm) => @kernel.eq_mp(t148, x149))(@environment.list_conj(x150))
        }, tms_2, x151))
      }
    }
  } catch {
    Failure(_) => raise Failure("clausal_form_heuristic")
    e => raise e
  }
}

///|
fn[TA] result_string_l(x141 : @list.List[TA]) -> String raise {
  let tms = x141
  let s = Int::to_int64(@lib.length(tms))
  let plural = if (s == 1L) {
    ""
  } else {
    "s"
  }
  let t142 = (" clause" + (plural + ")"))
  ("-> Clausal Form Heuristic (" + (Int64::to_string(s) + t142))
}

///|
/// `meson_heuristic`
pub fn meson_heuristic(x152 : @list.List[@kernel.Thm], x153 : (@kernel.Term, Bool)) -> ((@list.List[(@kernel.Term, Bool)], (@list.List[@kernel.Thm]) -> @kernel.Thm raise)) raise {
  let l = x152
