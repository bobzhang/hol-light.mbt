///|
/// `setify_heuristic`
pub fn setify_heuristic(x160 : @kernel.Term, x161 : Bool) -> ((@list.List[(@kernel.Term, Bool)], (@list.List[@kernel.Thm]) -> @kernel.Thm raise)) raise {
  let (tm, _ as i) = (x160, x161)
  try {
    if !@basics.is_disj(tm) {
      raise Failure("")
    } else {
      let tms = @support.disj_list(tm)
      let tms_p = @lib.setify(tms)
      let tm_p = @bool.list_mk_disj(tms_p)
      let t162 = Int::to_int64(@lib.length(tms_p))
      if (Int::to_int64(@lib.length(tms)) == t162) {
        raise Failure("")
      } else {
        let th = @class.taut(@bool.mk_imp(tm_p, tm))
        proof_print_string_l("-> Setify Heuristic", ())
        (@list.List([(tm_p, i)]), (x165 : @list.List[@kernel.Thm]) => apply_fproof("setify_heuristic", fn(x164 : @list.List[@kernel.Thm]) -> @kernel.Thm raise {
          ((x163 : @kernel.Thm) => @bool.mp(th, x163))(@lib.hd(x164))
        }, @list.List([tm_p]), x165))
      }
    }
  } catch {
    Failure(_) => raise Failure("setify_heuristic")
    e => raise e
  }
}

///|
fn load_steps() -> Unit raise {
  step_1()
  step_2()
}
