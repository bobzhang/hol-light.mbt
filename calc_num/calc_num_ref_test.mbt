// Load-fidelity test for calc_num.ml: replays tools/ocaml_ref/calc_num_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "calc_num matches calc_num.ml" {
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("calc_num")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("ARITH_ZERO", () => sthm(@calc_num.arith_zero()))
  log.attempt("BIT0_0", () => sthm(@calc_num.bit0_0()))
  log.attempt("BIT1_0", () => sthm(@calc_num.bit1_0()))
  log.attempt("ARITH_SUC", () => sthm(@calc_num.arith_suc()))
  log.attempt("ARITH_PRE", () => sthm(@calc_num.arith_pre()))
  log.attempt("ARITH_ADD", () => sthm(@calc_num.arith_add()))
  log.attempt("ARITH_MULT", () => sthm(@calc_num.arith_mult()))
  log.attempt("ARITH_EXP", () => sthm(@calc_num.arith_exp()))
  log.attempt("ARITH_EVEN", () => sthm(@calc_num.arith_even()))
  log.attempt("ARITH_ODD", () => sthm(@calc_num.arith_odd()))
  log.attempt("ARITH_LE", () => sthm(@calc_num.arith_le()))
  log.attempt("ARITH_LT", () => sthm(@calc_num.arith_lt()))
  log.attempt("ARITH_GE", () => sthm(@calc_num.arith_ge()))
  log.attempt("ARITH_GT", () => sthm(@calc_num.arith_gt()))
  log.attempt("ARITH_EQ", () => sthm(@calc_num.arith_eq()))
  log.attempt("ARITH_SUB", () => sthm(@calc_num.arith_sub()))
  log.attempt("ARITH", () => sthm(@calc_num.arith()))
  log.attempt("EXP_2_NE_0", () => sthm(@calc_num.exp_2_ne_0()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  log.attempt("reduce_add", () => {
    sthm(@calc_num.num_reduce_conv(tm("2 + 3 * 4 EXP 2")))
  })
  log.attempt("reduce_div", () => {
    sthm(@calc_num.num_reduce_conv(tm("17 DIV 5")))
  })
  log.attempt("reduce_mod", () => {
    sthm(@calc_num.num_reduce_conv(tm("100 MOD 7")))
  })
  log.attempt("reduce_big", () => {
    sthm(@calc_num.num_reduce_conv(tm("2 EXP 100")))
  })
  log.attempt("reduce_sub", () => sthm(@calc_num.num_reduce_conv(tm("10 - 13"))))
  log.attempt("reduce_le", () => {
    sthm(@calc_num.num_reduce_conv(tm("123456789 <= 987654321")))
  })
  log.attempt("reduce_fact", () => {
    sthm(@calc_num.num_reduce_conv(tm("FACT 10")))
  })
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  @testkit.check_axioms()
  inspect(
    log.contents(),
    content=(
      #|Searching with limit 0
