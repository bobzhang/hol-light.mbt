// Cadical/cadical.ml: the load steps are generated (cadical.mbt).

///|
let loaded : Ref[Bool] = Ref::{ val: false, }

///|
/// Load Cadical/cadical.ml (once), after the files it needs.
pub fn load() -> Unit {
  if loaded.val {
    return
  }
  loaded.val = true
  @ldrup.load()
  @parser.begin_theory("Cadical/cadical")
  load_steps() catch {
    e => abort("HOL Light: loading Cadical/cadical.ml failed: " + e.to_string())
  }
  @parser.end_theory()
}

///|
/// Load Cadical/cadical.ml (once) as `needs` does: after what it needs itself, not
/// after the files its directory's make.ml loads before it.
pub fn load_alone() -> Unit {
  if loaded.val {
    return
  }
  loaded.val = true
  @parser.begin_theory("Cadical/cadical")
  load_steps() catch {
    e => abort("HOL Light: loading Cadical/cadical.ml failed: " + e.to_string())
  }
  @parser.end_theory()
}
