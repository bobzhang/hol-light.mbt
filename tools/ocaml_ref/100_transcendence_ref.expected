100/transcendence quotations (8541):
  \n  !S U:X->bool.\n  S SUBSET U <=>\n  (!y. y IN S ==> y IN U)\n
  \n  !S:X->bool T.\n  S = T <=>\n  (!z. z IN S <=> z IN T)\n
  \n  !(x:X) S.\n  ~(x IN S) ==>\n  (x INSERT S) DELETE x = S\n
  {t:T | p t} SUBSET {t | ?s:S. s IN {x | p(f(x))} /\\ t = f s}
  {s:S | p(f(s):T)}
  f:S->T
  \n  !f p:T->bool.\n  (!t:T. ?s:S. f(s) = t) ==>\n  FINITE {s | p(f(s))} ==>\n  FINITE {t | p(t)}\n
  \n  !(x:X->bool) u.\n  x IN u /\\\n  (!s. s IN u ==> x SUBSET s) ==>\n  x = INTERS u\n
  \n  CARD ({}:X->bool) = 0\n
  \n  !x:X S.\n  FINITE S ==>\n  CARD(x INSERT S)\n  = (if x IN S then CARD S else CARD S + 1)\n
  \n  !S:X->bool U.\n  FINITE S ==>\n  ( (U SUBSET S /\\ CARD U = CARD S)\n    <=> U = S\n  )\n
  {U:X->bool | U SUBSET S /\\ CARD U = n} SUBSET {U:X->bool | U SUBSET S}
