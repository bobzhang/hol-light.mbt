// Migrate one package's quotations to the MoonBit term syntax (issue #140),
// test it, and leave only the package's own changes in the working tree.
//
//   ulimit -s 65520
//   moon run tools/migrate.mbtx -- <package dir>      e.g. 100/gcd
//
// A .mbtx script, so it runs where only moon, moonrun and git may start
// (openseek's mbtx). It needs a clean working tree. Steps (tools/MIGRATING.md):
// 1. Number the package's quotation sites: each @parser.parse_term("...")
//    outside comments and multiline strings temporarily becomes
//    @parser.parse_term_at(k, "..."). Load the package once with
//    @parser.quotation_hook set: each run of site k is printed with
//    @term_syntax.spell_quotation in that environment (which checks that
//    the text reads back as the quotation does, bound variable names
//    included, since theorems show them), together with its place in the
//    theory's quotation trace.
// 2. Replace @parser.parse_term("old") by @term_syntax.parse_term("new") at
//    each site that ran and read the same printable way every time. A site
//    that did not run, is unprintable, or read differently on different
//    runs (overload priorities) is left (listed at the end).
// 3. Rewrite the trace in the package's reference test and its
//    tools/ocaml_ref .expected file: the trace there must be this run's, and
//    exactly the migrated sites' runs change.
// 4. Run the reference test with a large stack (as tools/test.py does).
// 5. Restore the files a newer local toolchain rewrites (pkg.generated.mbti
//    elsewhere, */make/pkg.generated.mbti).
// It exits non-zero if anything fails, in particular the test: the golden
// then differs in more than the trace lines, which needs a look, not an
// update.
//
// The stack: moonrun's wasm stack is its main thread's, so run this under a
// raised `ulimit -s` (65520) for packages whose load recurses deeply.

import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
}

///|
let unprintable : String = "\u{0}unprintable"

///|
let gen_test : String = "migrate_gen_test.mbt"

///|
let call_prefix : String = "@parser.parse_term(\""

///|
/// The package that installs the hook while a package is recorded.
let hook_pkg : String = "migrate_hook"

///|
/// The string the body of a MoonBit string literal denotes.
fn unquote(body : String) -> String raise {
  let cs = body.to_array()
  let out = StringBuilder()
  let mut i = 0
  while i < cs.length() {
    let c = cs[i]
    if c != '\\' {
      out.write_char(c)
      i += 1
      continue
    }
    let e = cs[i + 1]
    match e {
      'n' => out.write_char('\n')
      't' => out.write_char('\t')
      'r' => out.write_char('\r')
      'b' => out.write_char('\b')
      '\\' | '"' | '\'' => out.write_char(e)
      'u' if cs[i + 2] == '{' => {
        let mut j = i + 3
        while cs[j] != '}' {
          j += 1
        }
        let mut code = 0
        for h in cs[i + 3:j] {
          code = code * 16 +
            (match h {
              '0'..='9' => h.to_int() - '0'.to_int()
              'a'..='f' => h.to_int() - 'a'.to_int() + 10
              'A'..='F' => h.to_int() - 'A'.to_int() + 10
              _ => fail("bad \\u escape in a quotation")
            })
        }
        out.write_char(code.unsafe_to_char())
        i = j + 1
        continue
      }
      _ => fail("escape \\\{e} in a quotation")
    }
    i += 2
  }
  out.to_string()
}

///|
/// The body of a MoonBit string literal for `s`.
fn quote(s : String) -> String {
  let out = StringBuilder()
  for c in s {
    match c {
      '\\' => out.write_string("\\\\")
      '"' => out.write_string("\\\"")
      '\n' => out.write_string("\\n")
      '\t' => out.write_string("\\t")
      '\r' => out.write_string("\\r")
      c => out.write_char(c)
    }
  }
  out.to_string()
}

///|
/// testkit's ocaml_escaped: OCaml's String.escaped of the UTF-8 bytes, as
/// the quotation traces print quotations.
fn ocaml_escaped(s : String) -> String {
  let out = StringBuilder()
  for b in @utf8.encode(s) {
    let c = b.to_int()
    match c {
      0x22 => out.write_string("\\\"")
      0x5C => out.write_string("\\\\")
      0x0A => out.write_string("\\n")
      0x09 => out.write_string("\\t")
      0x0D => out.write_string("\\r")
      0x08 => out.write_string("\\b")
      _ =>
        if c >= 32 && c <= 126 {
          out.write_char(c.unsafe_to_char())
        } else {
          out.write_string("\\")
          out.write_string((c / 100).to_string())
          out.write_string((c / 10 % 10).to_string())
          out.write_string((c % 10).to_string())
        }
    }
  }
  out.to_string()
}

///|
/// The quotation calls of `cs` outside comments, string literals and
/// multiline strings: (start of the call, end after its `)`, the literal's
/// body). A literal with interpolation is not a quotation the tool rewrites.
fn calls(cs : Array[Char]) -> Array[(Int, Int, String)] {
  calls_of(cs, call_prefix)
}

///|
fn ident_char(c : Char) -> Bool {
  c is ('a'..='z' | 'A'..='Z' | '0'..='9' | '_') || c.to_int() > 127
}

///|
/// How often each identifier step_N occurs in `all` (a load step is named
/// twice: its definition and the call that runs it).
fn step_counts(all : String) -> Map[String, Int] {
  let out : Map[String, Int] = Map::new()
  let cs = all.to_array()
  let mut k = 0
  while k < cs.length() {
    if ident_char(cs[k]) {
      let mut e = k
      while e < cs.length() && ident_char(cs[e]) {
        e += 1
      }
      if e - k > 5 && cs[k] == 's' {
        let w = String::from_array(cs[k:e])
        if w.has_prefix("step_") && w[5:].iter().all(c => c is ('0'..='9')) {
          out[w] = out.get(w).unwrap_or(0) + 1
        }
      }
      k = e
    } else {
      k += 1
    }
  }
  out
}

///|
/// For each position in `positions` (calls in `cs`), whether the call runs
/// once, while its package loads: directly in a load step, not in another
/// function or in a lambda or local function in one. Those can run later,
/// under another environment (overload priorities, interface, type
/// abbreviations) than the one the tool checks the spelling in. A load step
/// is `init`, `load`, `load_steps`, or a private `step_N` that the package
/// names exactly once besides its definition (the call that runs it). One
/// scan of the source: strings, multiline strings, comments and character
/// literals are skipped, functions are top-level at brace depth 0, and in a
/// function any `fn` or `=>` (a lambda, a local function, a match arm or a
/// catch handler) marks its group, so that everything after it in the group
/// counts as possibly later.
fn load_step_calls(
  cs : Array[Char],
  positions : Array[Int],
  steps : Map[String, Int],
) -> Map[Int, Bool] {
  let out : Map[Int, Bool] = Map::new()
  let n = cs.length()
  let groups : Array[Bool] = []
  let mut top = ""
  let mut top_pub = false
  let mut prev_ident = ""
  let mut next = 0
  let mut i = 0
  let mut line_start = true
  fn is_step(name : String, is_pub : Bool) -> Bool {
    name is ("init" | "load" | "load_steps") ||
    (!is_pub && steps.get(name) == Some(2))
  }
  while i < n {
    // the calls up to here
    while next < positions.length() && positions[next] <= i {
      if positions[next] == i {
        out[i] = groups.length() > 0 && is_step(top, top_pub) && !groups.iter().any(g => g)
      }
      next += 1
    }
    let c = cs[i]
    if c == '\n' {
      line_start = true
      i += 1
      continue
    }
    if line_start && (c == ' ' || c == '\t') {
      i += 1
      continue
    }
    if line_start && i + 1 < n && c is ('#' | '$') && cs[i + 1] == '|' {
      while i < n && cs[i] != '\n' {
        i += 1
      }
      continue
    }
    line_start = false
    if c == '/' && i + 1 < n && cs[i + 1] == '/' {
      while i < n && cs[i] != '\n' {
        i += 1
      }
      continue
    }
    if c == '"' {
      // a call starts with its @: positions inside strings are not calls
      i += 1
      while i < n && cs[i] != '"' && cs[i] != '\n' {
        i += if cs[i] == '\\' { 2 } else { 1 }
      }
      i += 1
      continue
    }
    if c == '\'' {
      // a character literal: 'x', or an escape up to the closing '
      if i + 2 < n && cs[i + 1] != '\\' && cs[i + 2] == '\'' {
        i += 3
        continue
      }
      if i + 1 < n && cs[i + 1] == '\\' {
        let mut j = i + 2
        while j < n && cs[j] != '\'' && cs[j] != '\n' {
          j += 1
        }
        i = j + 1
        continue
      }
      i += 1
      continue
    }
    if c is ('(' | '[' | '{') {
      groups.push(false)
      i += 1
      continue
    }
    if c is (')' | ']' | '}') {
      ignore(groups.pop())
      i += 1
      continue
    }
    if c == '=' && i + 1 < n && cs[i + 1] == '>' {
      if !groups.is_empty() {
        groups[groups.length() - 1] = true
      }
      i += 2
      continue
    }
    if ident_char(c) && !(c is ('0'..='9')) {
      let mut j = i
      while j < n && ident_char(cs[j]) {
        j += 1
      }
      let word = String::from_array(cs[i:j])
      if word == "fn" {
        if groups.is_empty() {
          // a top-level function: its name after optional [..] generics
          let mut k = j
          while k < n && cs[k] is (' ' | '\t' | '\n') {
            k += 1
          }
          if k < n && cs[k] == '[' {
            let mut d = 0
            while k < n {
              if cs[k] == '[' {
                d += 1
              } else if cs[k] == ']' {
                d -= 1
                if d == 0 {
                  k += 1
                  break
                }
              }
              k += 1
            }
          }
          while k < n && cs[k] is (' ' | '\t' | '\n') {
            k += 1
          }
          let mut e = k
          while e < n && ident_char(cs[e]) {
            e += 1
          }
          top = String::from_array(cs[k:e])
          top_pub = prev_ident == "pub"
        } else {
          groups[groups.length() - 1] = true
        }
      }
      prev_ident = word
      i = j
      continue
    }
    i += 1
  }
  out
}

///|
/// The calls `prefix"...")` of `cs`, as `calls` finds them.
fn calls_of(cs : Array[Char], prefix : String) -> Array[(Int, Int, String)] {
  let out = []
  let pre = prefix.to_array()
  let n = cs.length()
  let mut i = 0
  let mut line_start = true
  fn skip_line(i : Int) -> Int {
    let mut i = i
    while i < n && cs[i] != '\n' {
      i += 1
    }
    i
  }
  while i < n {
    let c = cs[i]
    if c == '\n' {
      line_start = true
      i += 1
      continue
    }
    if line_start && (c == ' ' || c == '\t') {
      i += 1
      continue
    }
    if line_start && i + 1 < n && (c is ('#' | '$') && cs[i + 1] == '|') {
      i = skip_line(i)
      continue
    }
    line_start = false
    if c == '/' && i + 1 < n && cs[i + 1] == '/' {
      i = skip_line(i)
      continue
    }
    if i + pre.length() <= n && cs[i:i + pre.length()] == pre[:] {
      let mut j = i + pre.length()
      while j < n && cs[j] != '"' && cs[j] != '\n' {
        j += if cs[j] == '\\' { 2 } else { 1 }
      }
      if j + 1 < n && cs[j] == '"' && cs[j + 1] == ')' {
        let body = String::from_array(cs[i + pre.length():j])
        if !interpolates(body) {
          out.push((i, j + 2, body))
        }
        i = j + 2
        continue
      }
    }
    if c == '\'' && i + 2 < n && cs[i + 1] != '\\' && cs[i + 2] == '\'' {
      i += 3
      continue
    }
    if c == '\'' && i + 3 < n && cs[i + 1] == '\\' && cs[i + 3] == '\'' {
      i += 4
      continue
    }
    if c == '"' {
      let mut j = i + 1
      while j < n && cs[j] != '"' && cs[j] != '\n' {
        j += if cs[j] == '\\' { 2 } else { 1 }
      }
      i = j + 1
      continue
    }
    i += 1
  }
  out
}

///|
/// Whether the body of a string literal has an interpolation \{...} (a
/// backslash that is not itself escaped, then {).
fn interpolates(body : String) -> Bool {
  let cs = body.to_array()
  let mut i = 0
  while i < cs.length() {
    if cs[i] == '\\' {
      if i + 1 < cs.length() && cs[i + 1] == '{' {
        return true
      }
      i += 2
    } else {
      i += 1
    }
  }
  false
}

///|
/// `cs` with call `k` of `calls(cs)` replaced by `by(k, body)`.
fn rewrite_calls(
  cs : Array[Char],
  by : (Int, String) -> String?,
) -> (String, Int) {
  let out = StringBuilder()
  let mut last = 0
  let mut k = 0
  let mut changed = 0
  for c in calls(cs) {
    let (start, end, body) = c
    match by(k, body) {
      Some(call) => {
        out.write_string(String::from_array(cs[last:start]))
        out.write_string(call)
        last = end
        changed += 1
      }
      None => ()
    }
    k += 1
  }
  out.write_string(String::from_array(cs[last:]))
  (out.to_string(), changed)
}

///|
fn between(s : String, before : String, after : String) -> String? {
  match s.find(before) {
    Some(i) => {
      let rest = s[i + before.length():].to_owned()
      match rest.find(after) {
        Some(j) => Some(rest[:j].to_owned())
        None => None
      }
    }
    None => None
  }
}

///|
fn min(a : Int, b : Int) -> Int {
  if a < b {
    a
  } else {
    b
  }
}

///|
fn tail_of(s : String) -> String {
  s[s.length() - min(s.length(), 2000):].to_owned()
}

///|
async fn read(path : String) -> String {
  @fs.read_file(path).text()
}

///|
async fn sh(prog : String, args : Array[String]) -> (Int, String) {
  let out = @shell.Cmd(prog, args).output(max_output_bytes=1 << 30)
  (out.exit_code(), out.stdout() + out.stderr())
}

///|
async fn mbt_files(dir : String) -> Array[String] {
  @fs.readdir(dir, sort=true).filter(f => f.has_suffix(".mbt")).map(f => dir + "/" + f)
}

///|
/// The theory the package's load begins (its init.mbt).
async fn theory_of(pkg : String) -> String {
  for f in mbt_files(pkg) {
    match between(read(f), "@parser.begin_theory(\"", "\"") {
      Some(t) => return t
      None => ()
    }
  }
  fail("no begin_theory in " + pkg)
}

///|
/// The package's reference test, or its member of its directory's chain
/// (<dir>/make/NN_<name>_test.mbt).
async fn golden_tests(pkg : String) -> Array[String] {
  let own = mbt_files(pkg).filter(f => f.has_suffix("_ref_test.mbt"))
  if !own.is_empty() {
    return own
  }
  let parts = pkg.split("/").map(p => p.to_owned()).to_array()
  let make = parts[0] + "/make"
  let name = parts[parts.length() - 1]
  if !@fs.exists(make) {
    return []
  }
  mbt_files(make).filter(f => f.has_suffix("_" + name + "_test.mbt"))
}

///|
/// Build the tests of `tpkg` and the blackbox test executable's directory
/// and name.
async fn build_tests(tpkg : String) -> (String, String) {
  let (code, log) = sh("moon", [
    "test", "--target", "wasm-gc", "--build-only", "-j", "4", "-p", "bobzhang/hol_light/" +
    tpkg,
  ])
  if code != 0 {
    fail("build failed:\n" + log)
  }
  let dir = "_build/wasm-gc/debug/test/" + tpkg
  let exe = @fs.readdir(dir).filter(f => f.has_suffix(".blackbox_test.wasm"))
  if exe.is_empty() {
    fail("no blackbox test executable in " + dir)
  }
  (dir, exe[0])
}

///|
/// Run the tests `ranges` (file, count) of `tpkg` with a large stack, as
/// tools/test.py does: (exit code, output, results).
async fn run_wasm(
  tpkg : String,
  dir : String,
  exe : String,
  ranges : Array[(String, Int)],
) -> (Int, String, Array[Json]) {
  let args = {
    "package": ("bobzhang/hol_light/" + tpkg).to_json(),
    "file_and_index": ranges
      .map(r => [r.0.to_json(), [{ "start": 0, "end": r.1 }.to_json()].to_json()].to_json())
      .to_json(),
  }.to_json()
  let (code, out) = sh("moonrun", [
    "--stack-size", "60000", "--test-args", args.stringify(), dir + "/" + exe, "--",
  ])
  let results = []
  for line in out.split("\n") {
    if line.has_prefix("{\"type\":\"result\"") {
      results.push(@json.parse(line.to_owned()))
    }
  }
  (code, out, results)
}

///|
/// Run `files` of the test package `tpkg` (all its files for None): the
/// failures' messages; a test that did not report is a failure too.
async fn run_tests(tpkg : String, only : Array[String]?) -> Array[String] {
  let (dir, exe) = build_tests(tpkg)
  let info = @json.parse(read(dir + "/__blackbox_test_info.json"))
  let ranges = []
  if info is { "tests": Object(files), .. } {
    for f, tests in files {
      let n = if tests is Array(a) { a.length() } else { 0 }
      if n > 0 && (only is None || only.unwrap().any(o => o.has_suffix("/" + f))) {
        ranges.push((f, n))
      }
    }
  }
  if ranges.is_empty() {
    fail("no test files to run in " + dir)
  }
  let expected = ranges.fold(init=0, (acc, r) => acc + r.1)
  let (code, out, results) = run_wasm(tpkg, dir, exe, ranges)
  let failures = []
  for r in results {
    if r is { "message": String(m), .. } && m != "" {
      failures.push(m)
    }
  }
  if code != 0 || results.length() != expected {
    failures.push(
      "the test executable exited with \{code} after \{results.length()} of \{expected} results (stack?):\n" +
      tail_of(out),
    )
  }
  failures
}

///|
/// What loading the package showed: the theory's quotation trace, and the
/// runs of each quotation site: (its index in the trace or -1, its new
/// spelling or `unprintable`).
struct Recording {
  trace : Array[String]
  runs : Map[Int, Array[(Int, String)]]
}

///|
/// Load the package with its quotation sites numbered (parse_term_at) and
/// the hook set.
async fn record(
  pkg : String,
  theory : String,
  sources : Array[(String, String)],
  given? : Map[Int, String] = Map::new(),
) -> Recording {
  let pkg_alias = pkg.split("/").last().unwrap().to_owned()
  let pkg_file = pkg + "/moon.pkg"
  let pkg_src = read(pkg_file)
  let test_file = pkg + "/" + gen_test
  let t = theory.to_json().stringify()
  let u = unprintable.to_json().stringify()
  // with spellings given (written by hand), each is checked where its site
  // runs instead of one printed
  let given_src = "Map::from_array([" +
    given.to_array().map(p => "(\{p.0}, \"" + quote(p.1) + "\")").join(", ") +
    "])"
  let spell = if given.is_empty() {
    "Some(@term_syntax.spell_quotation(old, tm))"
  } else {
    "(match given.get(site) { Some(s) => { @term_syntax.check_spelling(old, s); Some(s) }; None => None })"
  }
  let hook_dir = pkg + "/" + hook_pkg
  let hook_path = "bobzhang/hol_light/" + pkg + "/" + hook_pkg
  // restore everything, each step whatever the others do, before any change
  defer {
    for f in [test_file, hook_dir + "/hook.mbt", hook_dir + "/moon.pkg"] {
      @fs.remove(f) catch {
        _ => ()
      }
    }
    @fs.rmdir(hook_dir) catch {
      _ => ()
    }
    @fs.write_file(pkg_file, pkg_src) catch {
      _ => ()
    }
    for p in sources {
      @fs.write_file(p.0, p.1) catch {
        _ => ()
      }
    }
  }
  // The hook is installed by the init of a package the target package
  // imports while it is recorded: package inits run in dependency order, so
  // it is in place before the target's own init, which loads the core
  // packages (sets, arith, ...); the others load in load(). Wasm cannot
  // print during init, so the records are kept and the test prints them.
  @fs.mkdir(hook_dir) catch {
    _ => ()
  }
  @fs.write_file(
    hook_dir + "/moon.pkg",
    "import {\n  \"bobzhang/hol_light/parser\",\n  \"bobzhang/hol_light/term_syntax\",\n}\n",
  )
  @fs.write_file(
    hook_dir + "/hook.mbt",
    (
      $|///|
      $|pub let records : Array[(Int, Int, String)] = []
      $|
      $|///|
      $|fn init {
      $|  let given : Map[Int, String] = \{given_src}
      $|  @parser.quotation_hook.val = Some(fn(site, old, tm) {
      $|    if site >= 0 {
      $|      let at = if @parser.is_loading(\{t}) { @parser.theory_trace(\{t}).length() - 1 } else { -1 }
      $|      let new = try \{spell} catch {
      $|        @term_syntax.Unprintable(m) => Some(\{u} + ": " + m)
      $|        _ => Some(\{u})
      $|      }
      $|      if new is Some(new) {
      $|        records.push((site, at, new))
      $|      }
      $|    }
      $|  })
      $|}
      $|
    ),
  )
  let has_load = sources.iter().any(p => declares_load(p.1))
  let load_call = if has_load { "  @" + pkg_alias + ".load()\n" } else { "" }
  @fs.write_file(
    test_file,
    (
      $|///|
      $|test "migrate quotations" {
      $|\{load_call}  @parser.quotation_hook.val = None
      $|  for r in @\{hook_pkg}.records {
      $|    println("@@Q " + [r.0.to_json(), r.1.to_json(), r.2.to_json()].to_json().stringify())
      $|  }
      $|  println("@@T " + @parser.theory_trace(\{t}).to_json().stringify())
      $|}
      $|
    ),
  )
  @fs.write_file(pkg_file, with_hook_imports(pkg_src, hook_path))
  let mut site = 0
  for p in sources {
    let (text, n) = rewrite_calls(p.1.to_array(), (k, body) => Some(
      "@parser.parse_term_at(\{site + k}, \"" + body + "\")",
    ))
    if n > 0 {
      @fs.write_file(p.0, text)
    }
    site += n
  }
  let (dir, exe) = build_tests(pkg)
  let (code, out, results) = run_wasm(pkg, dir, exe, [(gen_test, 1)])
  let runs : Map[Int, Array[(Int, String)]] = Map::new()
  let mut trace = None
  for line in out.split("\n") {
    if line.has_prefix("@@Q ") &&
      @json.parse(line[4:].to_owned()) is Array([Number(s, ..), Number(at, ..), String(new)]) {
      let s = s.to_int()
      match runs.get(s) {
        Some(a) => a.push((at.to_int(), new))
        None => runs[s] = [(at.to_int(), new)]
      }
    } else if line.has_prefix("@@T ") &&
      @json.parse(line[4:].to_owned()) is Array(a) {
      trace = Some(a.map(j => if j is String(s) { s } else { "" }))
    }
  }
  let passed = results is [{ "message": String(""), .. }]
  guard code == 0 && passed && trace is Some(trace) else {
    fail("loading the package did not finish (exit \{code}):\n" + tail_of(out))
  }
  // a package with quotations that recorded no trace did not load
  if trace.is_empty() && sources.iter().any(p => !calls(p.1.to_array()).is_empty()) {
    fail("the theory \{theory} recorded no quotation: the package did not load (no load() found?)")
  }
  { trace, runs }
}

///|
/// The lines testkit's show_theory_trace prints for `t` (a quotation parsed
/// 10000 times or more in a row is shown once, with the count).
fn render(t : Array[String]) -> Array[String] {
  let out = []
  let mut i = 0
  while i < t.length() {
    let mut j = i + 1
    while j < t.length() && t[j] == t[i] {
      j += 1
    }
    let n = j - i
    if n >= 10000 {
      out.push("  " + ocaml_escaped(t[i]))
      out.push("  (" + (n - 1).to_string() + " more times)")
    } else {
      for _ in 0..<n {
        out.push("  " + ocaml_escaped(t[i]))
      }
    }
    i = j
  }
  out
}

///|
/// Replace the theory's trace in `path` (`old` as it is now, `new` after
/// the migration): the trace there must be this run's.
async fn rewrite_trace(
  path : String,
  theory : String,
  old : Array[String],
  new : Array[String],
) -> Unit {
  let prefix = if path.has_suffix(".mbt") { "      #|" } else { "" }
  let header = prefix + theory + " quotations (\{old.length()}):"
  let old_lines = render(old).map(l => prefix + l)
  let new_lines = render(new).map(l => prefix + l)
  let lines = read(path).split("\n").map(l => l.to_owned()).to_array()
  // the whole block is replaced: runs of 10000 or more collapse to two
  // lines, so the old and new blocks can differ in length
  let out = []
  let mut found = 0
  let mut i = 0
  while i < lines.length() {
    out.push(lines[i])
    if lines[i] == header && i + old_lines.length() < lines.length() &&
      lines[i + 1:i + 1 + old_lines.length()] == old_lines[:] {
      out.append(new_lines)
      i += 1 + old_lines.length()
      found += 1
    } else {
      i += 1
    }
  }
  if found == 0 {
    fail(
      "\{path} has no trace of \{theory} as this run parses it (header `\{header}`); the golden differs from the package before the migration",
    )
  }
  @fs.write_file(path, out.join("\n"))
}

///|
/// The tools/ocaml_ref/<name>_ref.expected file the test `src` compares
/// with: its header names that file, or the <name>_ref.ml it comes from.
fn expected_file(src : String) -> String? {
  let cs = src.to_array()
  let pre = "tools/ocaml_ref/".to_array()
  for i in 0..<(cs.length() - pre.length()) {
    if cs[i:i + pre.length()] == pre[:] {
      let mut j = i + pre.length()
      while j < cs.length() && cs[j] is ('a'..='z' | 'A'..='Z' | '0'..='9' | '_' | '.' | '-') {
        j += 1
      }
      let path = String::from_array(cs[i:j])
      for suffix in ["_ref.expected", "_ref.ml"] {
        if path.has_suffix(suffix) {
          return Some(path[:path.length() - suffix.length()].to_owned() + "_ref.expected")
        }
      }
    }
  }
  None
}

///|
/// Whether `src` declares `pub fn load` (spaces allowed before the
/// parameters).
fn declares_load(src : String) -> Bool {
  let cs = src.to_array()
  let pre = "pub fn load".to_array()
  for i in 0..<(cs.length() - pre.length()) {
    if cs[i:i + pre.length()] == pre[:] {
      let mut j = i + pre.length()
      while j < cs.length() && cs[j] is (' ' | '\t') {
        j += 1
      }
      if j < cs.length() && cs[j] == '(' {
        return true
      }
    }
  }
  false
}

///|
/// `pkg_src` (a moon.pkg) with `hook` in its own import block, wherever
/// that is (a new one if it has none), and with the parser and `hook` in
/// its test imports.
fn with_hook_imports(pkg_src : String, hook : String) -> String {
  let lines = pkg_src.split("\n").map(l => l.to_owned()).to_array()
  let entry = "  \"" + hook + "\","
  let mut main = -1
  let mut test_block = -1
  let mut i = 0
  while i < lines.length() {
    if lines[i] == "import {" {
      let mut j = i + 1
      while j < lines.length() && !lines[j].has_prefix("}") {
        j += 1
      }
      if j < lines.length() && lines[j] == "}" && main < 0 {
        main = i
      } else if j < lines.length() && lines[j] == "} for \"test\"" && test_block < 0 {
        test_block = i
      }
      i = j
    }
    i += 1
  }
  let out = []
  for k, l in lines {
    out.push(l)
    if k == main {
      out.push(entry)
    }
    if k == test_block {
      out.push("  \"bobzhang/hol_light/parser\",")
      out.push(entry)
    }
  }
  let mut text = out.join("\n")
  if main < 0 {
    text = "import {\n" + entry + "\n}\n\n" + text
  }
  if test_block < 0 {
    text = text + "\nimport {\n  \"bobzhang/hol_light/parser\",\n" + entry + "\n} for \"test\"\n"
  }
  text
}

///|
/// Add `term_syntax` to the package's own imports (not its test imports).
async fn import_term_syntax(pkg : String) -> Unit {
  let pkg_file = pkg + "/moon.pkg"
  let lines = read(pkg_file).split("\n").map(l => l.to_owned()).to_array()
  let entry = "  \"bobzhang/hol_light/term_syntax\","
  let mut i = 0
  while i < lines.length() {
    if lines[i] == "import {" {
      let mut j = i + 1
      while j < lines.length() && !lines[j].has_prefix("}") {
        j += 1
      }
      if j < lines.length() && lines[j] == "}" {
        if !lines[i + 1:j].contains(entry) {
          lines.insert(i + 1, entry)
          @fs.write_file(pkg_file, lines.join("\n"))
        }
        return
      }
      i = j
    }
    i += 1
  }
  @fs.write_file(pkg_file, "import {\n" + entry + "\n}\n\n" + lines.join("\n"))
}

///|
/// Undo what a newer local toolchain rewrites outside `keep` (the tree was
/// clean when the script started).
async fn restore_others(keep : Array[String]) -> Unit {
  let (_, status) = sh("git", ["status", "--porcelain", "--untracked-files=all"])
  for line in status.split("\n") {
    if line.length() < 4 {
      continue
    }
    let path = line[3:].to_owned()
    if keep.any(k => path.has_prefix(k)) {
      continue
    }
    if line.has_prefix("??") && path.has_suffix("/make/pkg.generated.mbti") {
      @fs.remove(path)
    } else if line.has_prefix(" M") && path.has_suffix("pkg.generated.mbti") {
      ignore(sh("git", ["checkout", "--", path]))
    }
  }
}

///|
/// The quotation calls of `cs`, of either front end, in order: (start,
/// end, body, whether it is @parser's).
fn quotations(cs : Array[Char]) -> Array[(Int, Int, String, Bool)] {
  let out = calls_of(cs, call_prefix).map(c => (c.0, c.1, c.2, true))
  out.append(calls_of(cs, "@term_syntax.parse_term(\"").map(c => (c.0, c.1, c.2, false)))
  out.sort_by_key(c => c.0)
  out
}

///|
/// `cs` with its quotation calls left out, for comparing the rest.
fn without_quotations(cs : Array[Char]) -> String {
  let out = StringBuilder()
  let mut last = 0
  for q in quotations(cs) {
    out.write_string(String::from_array(cs[last:q.0]))
    out.write_string("\u{0}")
    last = q.1
  }
  out.write_string(String::from_array(cs[last:]))
  out.to_string()
}

///|
/// `--retrace <package dir>`: after quotations of the package were
/// converted by hand (@parser.parse_term("old") replaced by
/// @term_syntax.parse_term("new") and nothing else), check each where it
/// runs while the package loads, exactly as the tool checks its own
/// spellings (@term_syntax.check_spelling); rewrite the trace in the golden
/// and .expected; run the reference test.
async fn retrace(pkg : String) -> Unit {
  let (_, status) = sh("git", ["status", "--porcelain", "--untracked-files=all"])
  for line in status.split("\n") {
    if line.length() < 4 {
      continue
    }
    let path = line[3:].to_owned()
    if !line.has_prefix(" M") ||
      !path.has_prefix(pkg + "/") ||
      path[pkg.length() + 1:].contains("/") ||
      !path.has_suffix(".mbt") ||
      path.has_suffix("_test.mbt") {
      fail(
        "--retrace: only the package's own .mbt source files may be modified (not added, renamed or staged; the tool adds the import itself); also changed:\n" +
        line.to_owned(),
      )
    }
  }
  let theory = theory_of(pkg)
  // each hand-converted call: the site of its @parser call in HEAD
  let heads = []
  let works = []
  let given : Map[Int, String] = Map::new()
  let mut site = 0
  for f in mbt_files(pkg).filter(f => !f.has_suffix("_test.mbt")) {
    let (code, head) = sh("git", ["show", "HEAD:" + f])
    if code != 0 {
      fail("--retrace: \{f} is not in HEAD")
    }
    let work = read(f)
    let hcs = head.to_array()
    let wcs = work.to_array()
    if without_quotations(hcs) != without_quotations(wcs) {
      fail("--retrace: \{f} changed outside quotation calls")
    }
    let hq = quotations(hcs)
    let wq = quotations(wcs)
    for k in 0..<hq.length() {
      let (_, _, hbody, hparser) = hq[k]
      let (_, _, wbody, wparser) = wq[k]
      if hparser && !wparser {
        given[site] = unquote(wbody)
      } else if hparser != wparser || hbody != wbody {
        fail("--retrace: \{f}: a quotation changed other than from @parser to @term_syntax: " + unquote(wbody))
      }
      if hparser {
        site += 1
      }
    }
    heads.push((f, head))
    works.push((f, work))
  }
  if given.is_empty() {
    fail("--retrace: no quotation was converted by hand")
  }
  // record with HEAD's sources, checking the given spellings where they run
  for p in heads {
    @fs.write_file(p.0, p.1)
  }
  let rec = record(pkg, theory, heads, given~) catch {
    e => {
      for p in works {
        @fs.write_file(p.0, p.1)
      }
      raise e
    }
  }
  for p in works {
    @fs.write_file(p.0, p.1)
  }
  let new_trace = rec.trace.copy()
  for s, new in given {
    guard rec.runs.get(s) is Some(runs) else {
      fail("--retrace: `\{new}` does not run while the package loads, so it cannot be checked")
    }
    for r in runs {
      if r.1.has_prefix(unprintable) {
        fail("--retrace: `\{new}` does not read as the quotation it replaces" + r.1[unprintable.length():].to_owned())
      }
      if r.0 >= 0 {
        new_trace[r.0] = new
      }
    }
  }
  import_term_syntax(pkg)
  let keep = [pkg + "/"]
  let tests = golden_tests(pkg)
  for t in tests {
    keep.push(t)
    rewrite_trace(t, theory, rec.trace, new_trace)
    guard expected_file(read(t)) is Some(e) && @fs.exists(e) else {
      fail("\{t} names no tools/ocaml_ref/<name>_ref.expected file")
    }
    keep.push(e)
    rewrite_trace(e, theory, rec.trace, new_trace)
  }
  println("\{pkg}: \{given.length()} converted by hand, checked")
  let failures = match tests {
    [] => run_tests(pkg, None)
    tests => {
      let tdir = tests[0].split("/").map(p => p.to_owned()).to_array()
      run_tests(tdir[:tdir.length() - 1].join("/"), Some(tests))
    }
  }
  restore_others(keep)
  if failures.is_empty() {
    println("test: pass")
  } else {
    println("test: FAILED")
    for m in failures {
      println(m[:min(3000, m.length())].to_owned())
    }
    fail("the reference test fails")
  }
}

///|
async fn main {
  let args = @env.args()
  guard args.length() >= 2 else {
    fail("usage: moon run tools/migrate.mbtx -- [--retrace] <package dir>")
  }
  if args[1] == "--retrace" && args.length() >= 3 {
    return retrace(args[2].trim_end(chars="/").to_owned())
  }
  let pkg = args[1].trim_end(chars="/").to_owned()
  let (_, status) = sh("git", ["status", "--porcelain", "--untracked-files=all"])
  if status.trim() != "" {
    fail("the working tree is not clean; commit or stash first:\n" + status)
  }
  let theory = theory_of(pkg)
  let sources = []
  for f in mbt_files(pkg).filter(f => !f.has_suffix("_test.mbt")) {
    sources.push((f, read(f)))
  }
  let rec = record(pkg, theory, sources)
  // a site is migrated when it ran, and read the same printable way each time
  let new_spelling : Map[Int, String] = Map::new()
  let left = []
  let mut site = 0
  let steps = step_counts(sources.map(p => p.1).join("\n"))
  for p in sources {
    let cs = p.1.to_array()
    let file_calls = calls(cs)
    let load_only = load_step_calls(cs, file_calls.map(c => c.0), steps)
    for c in file_calls {
      let old = unquote(c.2)
      let kind = match rec.runs.get(site) {
        None => "not run"
        // checked in the environment it runs in only when that is the
        // load's
        Some(_) if !load_only.get(c.0).unwrap_or(false) => "may run later"
        Some(runs) =>
          if runs.iter().any(r => r.1.has_prefix(unprintable)) {
            "unprintable"
          } else if runs.iter().all(r => r.1 == runs[0].1) {
            new_spelling[site] = runs[0].1
            "migrated"
          } else {
            "conflict"
          }
      }
      if kind != "migrated" {
        left.push(kind + ": " + old)
      }
      site += 1
    }
  }
  let migrated = new_spelling.length()
  let mut base = 0
  for p in sources {
    let b = base
    let (text, n) = rewrite_calls(p.1.to_array(), (k, _) => match
      new_spelling.get(b + k) {
      Some(new) => Some("@term_syntax.parse_term(\"" + quote(new) + "\")")
      None => None
    })
    if n > 0 {
      @fs.write_file(p.0, text)
    }
    base += calls(p.1.to_array()).length()
  }
  let keep = [pkg + "/"]
  if migrated > 0 {
    import_term_syntax(pkg)
    let new_trace = rec.trace.copy()
    for s, new in new_spelling {
      for r in rec.runs[s] {
        if r.0 >= 0 {
          new_trace[r.0] = new
        }
      }
    }
    for t in golden_tests(pkg) {
      keep.push(t)
      rewrite_trace(t, theory, rec.trace, new_trace)
      // the golden is embedded from the .expected file: both change alike
      guard expected_file(read(t)) is Some(e) && @fs.exists(e) else {
        fail("\{t} names no tools/ocaml_ref/<name>_ref.expected file")
      }
      keep.push(e)
      rewrite_trace(e, theory, rec.trace, new_trace)
    }
  }
  let counts : Map[String, Int] = Map::new()
  for l in left {
    let k = l.split(":").next().unwrap().to_owned()
    counts[k] = counts.get(k).unwrap_or(0) + 1
  }
  println(
    "\{pkg}: \{migrated} migrated, \{left.length()} left (" +
    counts.to_array().map(p => "\{p.1} \{p.0}").join(", ") +
    ")",
  )
  for l in left[:min(20, left.length())] {
    println("  left " + l[:min(120, l.length())].to_owned())
  }
  if migrated == 0 {
    restore_others(keep)
    println("test: skipped (nothing migrated, nothing changed)")
    return
  }
  // the test that holds the golden
  let failures = match golden_tests(pkg) {
    [] => run_tests(pkg, None)
    tests => {
      let tdir = tests[0].split("/").map(p => p.to_owned()).to_array()
      run_tests(tdir[:tdir.length() - 1].join("/"), Some(tests))
    }
  }
  restore_others(keep)
  if failures.is_empty() {
    println("test: pass")
  } else {
    println("test: FAILED")
    for m in failures {
      println(m[:min(3000, m.length())].to_owned())
    }
    fail("the reference test fails: the golden differs in more than the trace lines")
  }
}
