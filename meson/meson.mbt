pub fn optimize_rules(
  x : @list.List[
    (
      Int,
      @list.List[
        ((@list.List[FolAtom], (Int, @list.List[FolTerm])), (Int, @kernel.Thm)),
      ],
    ),
  ],
) -> @list.List[
  (
    Int,
    @list.List[
      ((@list.List[FolAtom], (Int, @list.List[FolTerm])), (Int, @kernel.Thm)),
