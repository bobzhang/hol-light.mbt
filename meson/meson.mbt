  x110 : (TC) -> ((
    (
      @list.List[
        (
          (Int, @list.List[FolTerm]),
          @list.List[(Int, @list.List[((TE, (Int, @list.List[FolTerm])), TF)])],
        ),
      ],
      (@list.List[(FolTerm, Int)], Int, Int),
    ),
  ) -> TA raise) raise,
) -> TA raise {
  let loffset = x107
  let rules = x108
  let state = x109
  let cont = x110
  @lib.tryfind(
    (
      x111 : (
        (@list.List[(Int, @list.List[FolTerm])], (TB, @list.List[FolTerm])),
        TC,
      ),
    ) => {
      let r = x111
      let t112 = meson_single_expand(loffset, r, state)
      cont(r.1)(t112)
    },
    rules,
  )
}

///|
/// `meson_expand`
pub fn[TA, TB] meson_expand(
  x113 : @list.List[
    (
      Int,
      @list.List[
        (
          (@list.List[(Int, @list.List[FolTerm])], (TB, @list.List[FolTerm])),
          (Int, @kernel.Thm),
        ),
      ],
    ),
  ],
  x114 : (
    (
      (Int, @list.List[FolTerm]),
      @list.List[
        (
          Int,
          @list.List[
            (
              (
                @list.List[(Int, @list.List[FolTerm])],
                (Int, @list.List[FolTerm]),
              ),
              (Int, @kernel.Thm),
            ),
          ],
        ),
      ],
    ),
    (@list.List[(FolTerm, Int)], Int, Int),
  ),
  x115 : ((Int, @kernel.Thm)) -> ((
    (
      @list.List[
        (
          (Int, @list.List[FolTerm]),
          @list.List[
            (
              Int,
              @list.List[
                (
                  (
                    @list.List[(Int, @list.List[FolTerm])],
                    (Int, @list.List[FolTerm]),
                  ),
                  (Int, @kernel.Thm),
                ),
              ],
            ),
          ],
        ),
      ],
      (@list.List[(FolTerm, Int)], Int, Int),
    ),
  ) -> TA raise) raise,
) -> TA raise {
  let rules = x113
  let ((g, ancestors), (insts, offset, size) as tup) = x114
  let cont = x115
  let pr = g.0
  let newancestors = insertan(insts, g, ancestors)
  let newstate = ((g, newancestors), tup)
  try {
    if meson_prefine().val && pr > 0 {
      raise Failure("meson_expand")
    } else {
      let arules = @lib.assoc(pr, ancestors)
      meson_expand_cont(0, arules, newstate, cont)
    }
  } catch {
    Cut => raise Failure("meson_expand")
    Failure(_) =>
      try {
        let crules = @lib.filter(
          (
            x116 : (
              (
                @list.List[(Int, @list.List[FolTerm])],
                (TB, @list.List[FolTerm]),
              ),
              (Int, @kernel.Thm),
            ),
          ) => {
            let ((h, _), _) = x116
            @lib.length(h) <= size
          },
          @lib.assoc(pr, rules),
        )
        meson_expand_cont(offset, crules, newstate, cont)
      } catch {
        Cut => raise Failure("meson_expand")
        Failure(_) => raise Failure("meson_expand")
        e => raise e
      }
    e => raise e
  }
}

