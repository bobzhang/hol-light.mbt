}

///|
fn[TA : Eq + @lib.OCompare + @lib.OHash, TB : Eq + @lib.OCompare + @lib.OHash] expand_goal_l(
  rules : @list.List[
    (
      Int,
      @list.List[
        ((@list.List[FolAtom], (TB, @list.List[FolTerm])), (Int, @kernel.Thm)),
      ],
    ),
  ],
  x119 : Int,
  x120 : (
    (
      FolAtom,
      @list.List[
        (
          Int,
          @list.List[
            (
              (@list.List[FolAtom], (Int, @list.List[FolTerm])),
              (Int, @kernel.Thm),
            ),
          ],
        ),
      ],
    ),
    (@list.List[(FolTerm, Int)], Int, Int),
  ),
  x121 : ((FolGoal, (@list.List[(FolTerm, Int)], Int, Int))) -> TA raise,
) -> TA raise {
  let expand_goal = (
    x119 : Int,
    x120 : (
      (
        FolAtom,
        @list.List[
          (
            Int,
            @list.List[
              (
                (@list.List[FolAtom], (Int, @list.List[FolTerm])),
                (Int, @kernel.Thm),
              ),
            ],
          ),
        ],
      ),
      (@list.List[(FolTerm, Int)], Int, Int),
    ),
    x121 : ((FolGoal, (@list.List[(FolTerm, Int)], Int, Int))) -> TA raise,
  ) => expand_goal_l(rules, x119, x120, x121)
  let expand_goals = (
    x126 : Int,
    x127 : (
      @list.List[
        (
          (Int, @list.List[FolTerm]),
          @list.List[
            (
              Int,
              @list.List[
                (
                  (@list.List[FolAtom], (Int, @list.List[FolTerm])),
                  (Int, @kernel.Thm),
                ),
              ],
            ),
          ],
        ),
      ],
      (@list.List[(FolTerm, Int)], Int, Int),
    ),
    x128 : ((@list.List[FolGoal], (@list.List[(FolTerm, Int)], Int, Int))) -> TA raise,
  ) => expand_goals_l(rules, x126, x127, x128)
  let depth = x119
  let ((g, _), (insts, offset, size)) as state = x120
  let cont = x121
  if depth < 0 {
    raise Failure("expand_goal: too deep")
  } else {
    meson_expand(rules, state, (x122 : (Int, @kernel.Thm)) => {
      let apprule = x122
      (
        x123 : (
          @list.List[
            (
              (Int, @list.List[FolTerm]),
              @list.List[
                (
                  Int,
                  @list.List[
                    (
                      (@list.List[FolAtom], (Int, @list.List[FolTerm])),
                      (Int, @kernel.Thm),
                    ),
                  ],
                ),
              ],
            ),
          ],
          (@list.List[(FolTerm, Int)], Int, Int),
        ),
      ) => {
        let (_, (pinsts, _, _)) as newstate = x123
        let t125 = cacheconts((
          x124 : (@list.List[FolGoal], (@list.List[(FolTerm, Int)], Int, Int)),
        ) => {
          let (gs, (newinsts, newoffset, newsize)) = x124
          let (locin, globin) = separate_insts(offset, pinsts, newinsts)
          let g_p = Subgoal(g, gs, apprule, offset, locin)
          if globin == insts && gs == @list.empty() {
            cont((g_p, (globin, newoffset, size))) catch {
              Failure(_) => raise Cut
              e => raise e
            }
          } else {
            cont((g_p, (globin, newoffset, newsize))) catch {
              Cut => raise Failure("expand_goal")
              Failure(_) => raise Failure("expand_goal")
              e => raise e
            }
          }
        })
        expand_goals(depth - 1, newstate, t125)
      }
    })
  }
}

///|
fn[TA : Eq + @lib.OCompare + @lib.OHash, TB : Eq + @lib.OCompare + @lib.OHash] expand_goals_l(
  rules : @list.List[
    (
      Int,
      @list.List[
