  let tm1 = x59
  let tm2 = x60
  let sofar = x61
  match (tm1, tm2) {
    (Fnapp(f, fargs), Fnapp(g, gargs)) =>
      if f != g {
        raise Failure("")
      } else {
        @lib.itlist2(
          (x62 : FolTerm, x63 : FolTerm, x64 : @list.List[(FolTerm, Int)]) => {
            fol_unify(offset, x62, x63, x64)
          },
          fargs,
          gargs,
          sofar,
        )
      }
    (_, Fvar(x)) => {
      let x_p = x + offset
      try {
        let tm2_p = @lib.rev_assoc(x_p, sofar)
        fol_unify(0, tm1, tm2_p, sofar)
      } catch {
        Failure("find") =>
          if istriv(sofar, x_p, tm1) {
            sofar
          } else {
            sofar.prepend((tm1, x_p))
          }
        e => raise e
      }
    }
    (Fvar(x_1), _) =>
      try {
        let tm1_p = @lib.rev_assoc(x_1, sofar)
        fol_unify(offset, tm1_p, tm2, sofar)
      } catch {
        Failure("find") => {
          let tm2_p_1 = fol_subst_bump(offset, @list.empty(), tm2)
          if istriv(sofar, x_1, tm2_p_1) {
            sofar
          } else {
            sofar.prepend((tm2_p_1, x_1))
          }
        }
        e => raise e
      }
  }
}

///|
/// `fol_eq`
pub fn fol_eq(
  x65 : @list.List[(FolTerm, Int)],
  x66 : FolTerm,
  x67 : FolTerm,
) -> Bool raise {
  let insts = x65
  let tm1 = x66
  let tm2 = x67
  physical_equal(tm1, tm2) ||
  (match (tm1, tm2) {
    (Fnapp(f, fargs), Fnapp(g, gargs)) =>
      f == g &&
      @lib.forall2(
        (x68 : FolTerm, x69 : FolTerm) => fol_eq(insts, x68, x69),
        fargs,
        gargs,
      )
    (_, Fvar(x)) =>
      try {
        let tm2_p = @lib.rev_assoc(x, insts)
        fol_eq(insts, tm1, tm2_p)
      } catch {
        Failure("find") =>
          istriv(insts, x, tm1) catch {
            Failure(_) => false
            e => raise e
          }
        e => raise e
      }
    (Fvar(x_1), _) =>
      try {
        let tm1_p = @lib.rev_assoc(x_1, insts)
        fol_eq(insts, tm1_p, tm2)
      } catch {
        Failure("find") =>
          istriv(insts, x_1, tm2) catch {
            Failure(_) => false
            e => raise e
          }
        e => raise e
      }
  })
}

///|
/// `fol_atom_eq`
pub fn[TA : Eq + @lib.OCompare + @lib.OHash] fol_atom_eq(
  x70 : @list.List[(FolTerm, Int)],
  x71 : (TA, @list.List[FolTerm]),
  x72 : (TA, @list.List[FolTerm]),
) -> Bool raise {
  let insts = x70
  let (p1, args1) = x71
  let (p2, args2) = x72
  p1 == p2 &&
  @lib.forall2(
    (x73 : FolTerm, x74 : FolTerm) => fol_eq(insts, x73, x74),
    args1,
    args2,
  )
}

///|
/// `cacheconts`
pub fn[
  TA : Eq + @lib.OCompare + @lib.OHash,
  TB : Eq + @lib.OCompare + @lib.OHash,
  TC : Eq + @lib.OCompare + @lib.OHash,
  TD : Eq + @lib.OCompare + @lib.OHash,
  TE : Eq + @lib.OCompare + @lib.OHash,
] cacheconts(
  x75 : ((TB, (TC, TD, TE))) -> TA raise,
) -> (((TB, (TC, TD, TE))) -> TA raise) raise {
  let f = x75
  let memory = Ref::{ val: @list.empty(), }
  (x77 : (TB, (TC, TD, TE))) => {
    let (gg, (insts, offset, size)) as input = x77
    if @lib.exists(
        (x78 : (TB, (TC, TD, TE))) => {
          let (_, (insts_p, _, size_p)) = x78
          insts == insts_p &&
          (@lib.compare(size, size_p) <= 0 || meson_depth().val)
        },
        memory.val,
      ) {
      raise Failure("cachecont")
    } else {
      memory.val = memory.val.prepend(input)
      ()
    }
    f(input)
  }
}

///|
/// `checkan`
pub fn[
  TA : Eq + @lib.OCompare + @lib.OHash,
  TB : Eq + @lib.OCompare + @lib.OHash,
] checkan(
  x79 : @list.List[(FolTerm, Int)],
  x80 : (Int, @list.List[FolTerm]),
  x81 : @list.List[(Int, @list.List[((TA, (Int, @list.List[FolTerm])), TB)])],
) -> @list.List[(Int, @list.List[((TA, (Int, @list.List[FolTerm])), TB)])] raise {
  let insts = x79
  let (p, a) = x80
  let ancestors = x81
  let p_p = 0 - p
  let t_p = (p_p, a)
  try {
    let ours = @lib.assoc(p_p, ancestors)
    if @lib.exists(
        (x82 : ((TA, (Int, @list.List[FolTerm])), TB)) => {
          let u = x82
          fol_atom_eq(insts, t_p, u.0.1)
        },
        ours,
      ) {
      raise Failure("checkan")
    } else {
      ancestors
    }
  } catch {
    Failure("find") => ancestors
    e => raise e
  }
}

///|
/// `insertan`
pub fn[TA : Eq + @lib.OCompare + @lib.OHash] insertan(
  x83 : @list.List[(FolTerm, Int)],
  x84 : (Int, @list.List[FolTerm]),
  x85 : @list.List[
    (
      Int,
      @list.List[
        ((@list.List[TA], (Int, @list.List[FolTerm])), (Int, @kernel.Thm)),
      ],
    ),
  ],
) -> @list.List[
  (
    Int,
    @list.List[
      ((@list.List[TA], (Int, @list.List[FolTerm])), (Int, @kernel.Thm)),
    ],
  ),
] raise {
  let insts = x83
  let (p, a) = x84
  let ancestors = x85
  let p_p = 0 - p
  let t_p = (p_p, a)
  let (ourancp, otheranc) = @lib.remove(
    (
      x86 : (
        Int,
        @list.List[
          ((@list.List[TA], (Int, @list.List[FolTerm])), (Int, @kernel.Thm)),
        ],
      ),
    ) => {
      let (pr, _) = x86
      pr == p_p
    },
    ancestors,
  ) catch {
    Failure(_) => ((p_p, @list.empty()), ancestors)
    e => raise e
  }
  let ouranc = ourancp.1
  if @lib.exists(
      (x87 : ((@list.List[TA], (Int, @list.List[FolTerm])), (Int, @kernel.Thm))) => {
        let u = x87
        fol_atom_eq(insts, t_p, u.0.1)
      },
      ouranc,
    ) {
    raise Failure("insertan: loop")
  } else {
    otheranc.prepend(
      (p_p, ouranc.prepend(((@list.empty(), t_p), (0, @bool.truth())))),
    )
  }
}

///|
/// `fol_subst_partial`
pub fn fol_subst_partial(
  x88 : @list.List[(FolTerm, Int)],
  x89 : FolTerm,
) -> FolTerm raise {
  let insts = x88
  let tm = x89
  match tm {
    Fvar(v) =>
      try {
        let t = @lib.rev_assoc(v, insts)
        fol_subst_partial(insts, t)
      } catch {
        Failure("find") => tm
        e => raise e
      }
    Fnapp(f, args) =>
      Fnapp(f, @lib.map((x90 : FolTerm) => fol_subst_partial(insts, x90), args))
  }
}

///|
/// `separate_insts`
pub fn separate_insts(
  x91 : Int,
  x92 : @list.List[(FolTerm, Int)],
  x93 : @list.List[(FolTerm, Int)],
) -> (@list.List[(FolTerm, Int)], @list.List[(FolTerm, Int)]) raise {
  let offset = x91
  let oldinsts = x92
  let newinsts = x93
  let (locins, globins) = qpartition(
    (x94 : (FolTerm, Int)) => {
      let (_, v) = x94
      offset <= v
    },
    oldinsts,
  )(newinsts)
  if globins == oldinsts {
    (
      @lib.map(
        (x95 : (FolTerm, Int)) => {
          let (t, x) = x95
          (fol_subst_partial(newinsts, t), x)
        },
        locins,
      ),
      oldinsts,
    )
  } else {
    let t98 = @lib.map(
      (x97 : (FolTerm, Int)) => {
        let (t_2, x_2) = x97
        (fol_subst_partial(newinsts, t_2), x_2)
      },
      globins,
    )
    (
      @lib.map(
        (x96 : (FolTerm, Int)) => {
          let (t_1, x_1) = x96
          (fol_subst_partial(newinsts, t_1), x_1)
        },
        locins,
      ),
      t98,
    )
  }
}

///|
/// `meson_single_expand`
pub fn[
  TA : Eq + @lib.OCompare + @lib.OHash,
  TB : Eq + @lib.OCompare + @lib.OHash,
  TC : Eq + @lib.OCompare + @lib.OHash,
  TD : Eq + @lib.OCompare + @lib.OHash,
  TE : Eq + @lib.OCompare + @lib.OHash,
] meson_single_expand(
  x99 : Int,
  x100 : ((@list.List[FolAtom], (TC, @list.List[FolTerm])), TD),
  x101 : (
    (
      (TE, @list.List[FolTerm]),
      @list.List[(Int, @list.List[((TA, (Int, @list.List[FolTerm])), TB)])],
    ),
    (@list.List[(FolTerm, Int)], Int, Int),
  ),
) -> (
  @list.List[
    (
      (Int, @list.List[FolTerm]),
      @list.List[(Int, @list.List[((TA, (Int, @list.List[FolTerm])), TB)])],
    ),
  ],
  (@list.List[(FolTerm, Int)], Int, Int),
) raise {
  let loffset = x99
  let rule = x100
  let ((g, ancestors), (insts, offset, size)) = x101
  let ((hyps, conc), tag) = rule
  let allins = @lib.rev_itlist2(
    (x102 : FolTerm, x103 : FolTerm, x104 : @list.List[(FolTerm, Int)]) => {
      fol_unify(loffset, x102, x103, x104)
    },
    g.1,
    conc.1,
    insts,
  )
  let (locin, globin) = separate_insts(offset, insts, allins)
  let mk_ihyp : (FolAtom) -> (
    (Int, @list.List[FolTerm]),
    @list.List[(Int, @list.List[((TA, (Int, @list.List[FolTerm])), TB)])],
  ) raise = (x105 : FolAtom) => {
    let h = x105
    let h_p = fol_inst_bump(offset, locin, h)
    (h_p, checkan(insts, h_p, ancestors))
  }
  let newhyps = @lib.map(mk_ihyp, hyps)
  {
    inferences().val = inferences().val + 1
    ()
  }
  let t106 = size - @lib.length(hyps)
  (newhyps, (globin, offset + offinc(), t106))
}

///|
/// `meson_expand_cont`
pub fn[
  TA : Eq + @lib.OCompare + @lib.OHash,
  TB : Eq + @lib.OCompare + @lib.OHash,
  TC : Eq + @lib.OCompare + @lib.OHash,
  TD : Eq + @lib.OCompare + @lib.OHash,
  TE : Eq + @lib.OCompare + @lib.OHash,
