///|
let asm_meson_tac_c : @lib.Cell[
  (@list.List[@kernel.Thm]) -> @tactics.Tactic raise,
] = @lib.Cell::new("ASM_MESON_TAC")

///|
/// `ASM_MESON_TAC`
pub fn asm_meson_tac(x : @list.List[@kernel.Thm]) -> @tactics.Tactic raise {
  asm_meson_tac_c.get()(x)
}

///|
/// `MESON_TAC`
pub fn meson_tac(x473 : @list.List[@kernel.Thm]) -> @tactics.Tactic raise {
  let ths = x473
  let t476 = asm_meson_tac(ths)
  @tactics.then_tac(
    @tactics.pop_assum_list((x475 : @list.List[@kernel.Thm]) => @tactics.all_tac),
    t476,
  )
}

///|
/// `MESON`
pub fn meson(
  x477 : @list.List[@kernel.Thm],
  x478 : @kernel.Term,
) -> @kernel.Thm raise {
  let ths = x477
  let tm = x478
  let th = @tactics.tac_proof((@list.empty(), tm), meson_tac(ths))
  let (asl, tm_p) = @kernel.dest_thm(th)
  if asl != @list.empty() &&
    !@lib.subset(
      asl,
      @lib.unions(@lib.map((x479 : @kernel.Thm) => @kernel.hyp(x479), ths)),
    ) {
    raise Failure("MESON: too many assumptions in result")
  } else if tm_p == tm {
    th
  } else {
    @kernel.eq_mp(@equal.alpha_rule(tm_p, tm), th) catch {
      Failure(_) => raise Failure("MESON: the wrong result")
      e => raise e
    }
  }
}

