///|
let asm_meson_tac_c : @lib.Cell[
  (@list.List[@kernel.Thm]) -> @tactics.Tactic raise,
] = @lib.Cell::new("ASM_MESON_TAC")

///|
/// `ASM_MESON_TAC`
pub fn asm_meson_tac(x : @list.List[@kernel.Thm]) -> @tactics.Tactic raise {
  asm_meson_tac_c.get()(x)
}

///|
/// `MESON_TAC`
pub fn meson_tac(x470 : @list.List[@kernel.Thm]) -> @tactics.Tactic raise {
  let ths = x470
  let t473 = asm_meson_tac(ths)
  @tactics.then_tac(
    @tactics.pop_assum_list((x472 : @list.List[@kernel.Thm]) => @tactics.all_tac),
    t473,
  )
}

///|
/// `MESON`
pub fn meson(
  x474 : @list.List[@kernel.Thm],
  x475 : @kernel.Term,
) -> @kernel.Thm raise {
  let ths = x474
  let tm = x475
  let th = @tactics.tac_proof((@list.empty(), tm), meson_tac(ths))
  let (asl, tm_p) = @kernel.dest_thm(th)
  if asl != @list.empty() &&
    !@lib.subset(
      asl,
      @lib.unions(@lib.map((x476 : @kernel.Thm) => @kernel.hyp(x476), ths)),
    ) {
    raise Failure("MESON: too many assumptions in result")
  } else if tm_p == tm {
    th
  } else {
    @kernel.eq_mp(@equal.alpha_rule(tm_p, tm), th) catch {
      Failure(_) => raise Failure("MESON: the wrong result")
      e => raise e
    }
  }
}

