///|
fn[TC : Eq + @lib.OCompare + @lib.OHash, TD : Eq + @lib.OCompare + @lib.OHash] mk_contraposes_l(
  x157 : Int,
  x158 : TD,
  x159 : @list.List[(Int, TC)],
  x160 : @list.List[(Int, TC)],
  x161 : @list.List[((@list.List[(Int, TC)], (Int, TC)), (Int, TD))],
) -> @list.List[((@list.List[(Int, TC)], (Int, TC)), (Int, TD))] raise {
  let n = x157
  let th = x158
  let used = x159
  let unused = x160
  let sofar = x161
  match unused {
    Empty => sofar
    More(h, tail=t) => {
      let nw = (
        (
          @lib.map(
            (x162 : (Int, TC)) => mk_negated(x162.0, x162.1),
            used.concat(t),
          ),
          h,
        ),
        (n, th),
      )
      mk_contraposes_l(
        n + 1,
        th,
        used.concat(@list.List([h])),
        t,
        sofar.prepend(nw),
      )
    }
  }
}

///|
/// optimize_rules
fn step_13() -> Unit raise {
  let optimize_clause_order = x193 => {
    let cls = x193
    @lib.sort(
      (x194, x195) => {
        let ((l1, _), _) = x194
        let ((l2, _), _) = x195
        let t196 = @lib.length(l2)
        @lib.length(l1) <= t196
      },
      cls,
    )
  }
  optimize_rules_c.set(x198 => {
    @lib.map(
      (
        x197 : (
          Int,
          @list.List[
            (
              (@list.List[FolAtom], (Int, @list.List[FolTerm])),
              (Int, @kernel.Thm),
            ),
          ],
        ),
      ) => {
        let (a, b) = x197
        (a, optimize_clause_order(b))
      },
      x198,
    )
  })
}

