    x121 : ((FolGoal, (@list.List[(FolTerm, Int)], Int, Int))) -> TA raise,
  ) => expand_goal_l(rules, x119, x120, x121)
  let expand_goals = (
    x126 : Int,
    x127 : (
      @list.List[
        (
          (Int, @list.List[FolTerm]),
          @list.List[
            (
              Int,
              @list.List[
                (
                  (@list.List[FolAtom], (Int, @list.List[FolTerm])),
                  (Int, @kernel.Thm),
                ),
              ],
            ),
          ],
        ),
      ],
      (@list.List[(FolTerm, Int)], Int, Int),
    ),
    x128 : ((@list.List[FolGoal], (@list.List[(FolTerm, Int)], Int, Int))) -> TA raise,
  ) => expand_goals_l(rules, x126, x127, x128)
  let depth_1 = x126
  let (gl, (insts_1, offset_1, size_1) as tup) = x127
  let cont_1 = x128
  match gl {
    Empty => cont_1((@list.empty(), tup))
    More(g_1, tail=Empty) =>
      expand_goal(depth_1, (g_1, tup), (
        x129 : (FolGoal, (@list.List[(FolTerm, Int)], Int, Int)),
      ) => {
        let (g_p_1, stup) = x129
        cont_1((@list.List([g_p_1]), stup))
      })
    gl_1 =>
      if size_1 >= meson_dcutin().val {
        let lsize = size_1 / meson_skew().val
        let rsize = size_1 - lsize
        let (lgoals, rgoals) = @lib.chop_list(@lib.length(gl_1) / 2, gl_1)
        expand_goals(
          depth_1,
          (lgoals, (insts_1, offset_1, lsize)),
          cacheconts((
            x130 : (@list.List[FolGoal], (@list.List[(FolTerm, Int)], Int, Int)),
          ) => {
            let (lg_p, (i, off, n)) = x130
            let t132 = cacheconts((
              x131 : (
                @list.List[FolGoal],
                (@list.List[(FolTerm, Int)], Int, Int),
              ),
            ) => {
              let (rg_p, ztup) = x131
              cont_1((lg_p.concat(rg_p), ztup))
            })
            expand_goals(depth_1, (rgoals, (i, off, n + rsize)), t132)
          }),
        ) catch {
          Failure(_) =>
            expand_goals(
              depth_1,
              (rgoals, (insts_1, offset_1, lsize)),
              cacheconts((
                x133 : (
                  @list.List[FolGoal],
                  (@list.List[(FolTerm, Int)], Int, Int),
                ),
              ) => {
                let (rg_p_1, (i_1, off_1, n_1)) = x133
                let t136 = cacheconts((
                  x134 : (
                    @list.List[FolGoal],
                    (@list.List[(FolTerm, Int)], Int, Int),
                  ),
                ) => {
                  let (lg_p_1, (_, _, fsize) as ztup_1) = x134
                  let t135 = lsize + fsize
                  if n_1 + rsize <= t135 {
                    raise Failure("repetition of demigoal pair")
                  } else {
                    cont_1((lg_p_1.concat(rg_p_1), ztup_1))
                  }
                })
                expand_goals(depth_1, (lgoals, (i_1, off_1, n_1 + rsize)), t136)
              }),
            )
          e => raise e
        }
      } else {
        match gl_1 {
          More(g_2, tail=gs_1) =>
            expand_goal(
              depth_1,
              (g_2, tup),
              cacheconts((
                x137 : (FolGoal, (@list.List[(FolTerm, Int)], Int, Int)),
              ) => {
                let (g_p_2, stup_1) = x137
                expand_goals(
                  depth_1,
                  (gs_1, stup_1),
                  cacheconts((
                    x138 : (
                      @list.List[FolGoal],
                      (@list.List[(FolTerm, Int)], Int, Int),
                    ),
                  ) => {
                    let (gs_p, ftup) = x138
                    cont_1((gs_p.prepend(g_p_2), ftup))
                  }),
                )
              }),
            )
          _ => raise @lib.MatchFailure("tscript.ml:431")
        }
      }
  }
}

///|
/// `solve_goal`
pub fn[TA : Eq + @lib.OCompare + @lib.OHash] solve_goal(
  x143 : @list.List[
    (
      Int,
      @list.List[
        ((@list.List[FolAtom], (TA, @list.List[FolTerm])), (Int, @kernel.Thm)),
      ],
    ),
  ],
  x144 : Bool,
  x145 : Int,
  x146 : Int,
  x147 : Int,
) -> ((FolAtom) -> (FolGoal, (@list.List[(FolTerm, Int)], Int, Int)) raise) raise {
  let rules = x143
  let incdepth = x144
  let min = x145
  let max = x146
  let incsize = x147
  fn solve(
    x149 : Int,
    x150 : (
      FolAtom,
      @list.List[
        (
          Int,
          @list.List[
            (
              (@list.List[FolAtom], (Int, @list.List[FolTerm])),
              (Int, @kernel.Thm),
            ),
          ],
        ),
      ],
    ),
  ) -> (FolGoal, (@list.List[(FolTerm, Int)], Int, Int)) raise {
    let n = x149
    let g = x150
    if n > max {
      raise Failure("solve_goal: Too deep")
    } else if meson_chatty().val && @lib.verbose.val {
      let t151 = " inferences so far. " +
        ("Searching with maximum size " + (@lib.string_of_int(n) + "."))
      @pp.std_formatter.print_string(
        @lib.string_of_int(inferences().val) + t151,
      )
      @pp.std_formatter.print_newline()
    } else if @lib.verbose.val {
      @pp.std_formatter.print_string(
        @lib.string_of_int(inferences().val) + "..",
      )
      @pp.std_formatter.print_flush()
    } else {
      ()
    }
    try {
      let gi = if incdepth {
        expand_goal(rules)(g)(n)(100000)((
          x152 : (FolGoal, (@list.List[(FolTerm, Int)], Int, Int)),
        ) => {
          let x = x152
          x
        })
      } else {
        expand_goal(rules)(g)(100000)(n)((
          x153 : (FolGoal, (@list.List[(FolTerm, Int)], Int, Int)),
        ) => {
          let x_1 = x153
          x_1
        })
      }
      if meson_chatty().val && @lib.verbose.val {
        @pp.std_formatter.print_string(
          "Goal solved with " +
          (@lib.string_of_int(inferences().val) + " inferences."),
        )
        @pp.std_formatter.print_newline()
      } else if @lib.verbose.val {
        @pp.std_formatter.print_string(
          "solved at " + @lib.string_of_int(inferences().val),
        )
        @pp.std_formatter.print_newline()
      } else {
        ()
      }
      gi
    } catch {
      Failure(_) => solve(n + incsize, g)
      e => raise e
    }
  }
  (x154 : FolAtom) => {
    let g_1 = x154
    solve(min, (g_1, @list.empty()))
  }
}

///|
/// fol_of_hol_clauses
fn step_12() -> Unit raise {
  let eqt = x155 => {
    let (a1, (b1, c1)) = x155
    x156 => {
      let (a2, (b2, c2)) = x156
      a1 == a2 && b1 == b2 && @basics.equals_thm(c1, c2)
    }
  }
  let fol_of_hol_clause : (@kernel.Thm) -> @list.List[
    (
      (@list.List[(Int, @list.List[FolTerm])], (Int, @list.List[FolTerm])),
      (Int, @kernel.Thm),
    ),
  ] raise = (x163 : @kernel.Thm) => {
    let th_1 = x163
    let lconsts = @kernel.freesl(@kernel.hyp(th_1))
    let tm = @kernel.concl(th_1)
    let hlits = @basics.disjuncts(tm)
    let flits = @lib.map(
      (x164 : @kernel.Term) => fol_of_literal(@list.empty(), lconsts, x164),
      hlits,
    )
    let basics = mk_contraposes_l(0, th_1, @list.empty(), flits, @list.empty())
    if @lib.forall(
        (x165 : (Int, @list.List[FolTerm])) => {
          let (p, _) = x165
          p < 0
        },
        flits,
      ) {
      basics.prepend(
        (
          (
            @lib.map(
              (x166 : (Int, @list.List[FolTerm])) => mk_negated(x166.0, x166.1),
              flits,
            ),
            (1, @list.empty()),
          ),
          (-1, th_1),
        ),
      )
    } else {
      basics
    }
  }
  fol_of_hol_clauses_c.set((x167 : @list.List[@kernel.Thm]) => {
    let thms = x167
    let rawrules = @lib.itlist(
      (
        x173 : @kernel.Thm,
        x174 : @list.List[
          (
            (@list.List[(Int, @list.List[FolTerm])], (Int, @list.List[FolTerm])),
            (Int, @kernel.Thm),
          ),
        ],
      ) => {
        let t175 = fol_of_hol_clause(x173)
        (x176 => {
          ((x171, x172) => {
            @lib.union_eq(
              (
                x168 : (
                  (
                    @list.List[(Int, @list.List[FolTerm])],
                    (Int, @list.List[FolTerm]),
                  ),
                  (Int, @kernel.Thm),
                ),
                x169 : (
                  (
                    @list.List[(Int, @list.List[FolTerm])],
                    (Int, @list.List[FolTerm]),
                  ),
                  (Int, @kernel.Thm),
                ),
              ) => {
                let s170 = eqt(x168)
                s170(x169)
              },
              x171,
              x172,
            )
          })(t175, x176)
        })(x174)
      },
      thms,
      @list.empty(),
    )
    let prs = @lib.setify(
      @lib.map(
        (
          x181 : (
            (@list.List[(Int, @list.List[FolTerm])], (Int, @list.List[FolTerm])),
            (Int, @kernel.Thm),
          ),
        ) => {
          ((
            x179 : (
              @list.List[(Int, @list.List[FolTerm])],
              (Int, @list.List[FolTerm]),
            ),
          ) => {
            ((x177 : (Int, @list.List[FolTerm])) => x177.0)(
              ((
                x178 : (
                  @list.List[(Int, @list.List[FolTerm])],
                  (Int, @list.List[FolTerm]),
                ),
              ) => x178.1)(x179),
            )
          })(
            ((
              x180 : (
                (
                  @list.List[(Int, @list.List[FolTerm])],
                  (Int, @list.List[FolTerm]),
                ),
                (Int, @kernel.Thm),
              ),
            ) => x180.0)(x181),
          )
        },
        rawrules,
      ),
    )
    let prules = @lib.map(
      (x182 : Int) => {
        let t_1 = x182
        (
          t_1,
          @lib.filter(
            (
              x189 : (
                (
                  @list.List[(Int, @list.List[FolTerm])],
                  (Int, @list.List[FolTerm]),
                ),
                (Int, @kernel.Thm),
              ),
            ) => {
              ((
                x187 : (
                  @list.List[(Int, @list.List[FolTerm])],
                  (Int, @list.List[FolTerm]),
                ),
              ) => {
                ((x185 : (Int, @list.List[FolTerm])) => {
                  ((x183 : Int) => t_1 == x183)(
                    ((x184 : (Int, @list.List[FolTerm])) => x184.0)(x185),
                  )
                })(
                  ((
                    x186 : (
                      @list.List[(Int, @list.List[FolTerm])],
                      (Int, @list.List[FolTerm]),
                    ),
                  ) => x186.1)(x187),
                )
              })(
                ((
                  x188 : (
                    (
                      @list.List[(Int, @list.List[FolTerm])],
                      (Int, @list.List[FolTerm]),
                    ),
                    (Int, @kernel.Thm),
                  ),
                ) => x188.0)(x189),
              )
            },
            rawrules,
          ),
        )
      },
      prs,
    )
    let srules = @lib.sort(
      (
        x190 : (
          Int,
          @list.List[
            (
              (
                @list.List[(Int, @list.List[FolTerm])],
                (Int, @list.List[FolTerm]),
              ),
              (Int, @kernel.Thm),
            ),
          ],
        ),
        x191 : (
          Int,
          @list.List[
            (
              (
                @list.List[(Int, @list.List[FolTerm])],
                (Int, @list.List[FolTerm]),
              ),
              (Int, @kernel.Thm),
            ),
          ],
        ),
      ) => {
        let (p_1, _) = x190
        let (q, _) = x191
        let t192 = @lib.abs_int(q)
        @lib.abs_int(p_1) <= t192
      },
      prules,
    )
    srules
  })
}

///|
