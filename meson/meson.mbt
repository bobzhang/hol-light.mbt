  let expand_goal = (
    x119 : Int,
    x120 : (
      (
        FolAtom,
        @list.List[
          (
            Int,
            @list.List[
              (
                (@list.List[FolAtom], (Int, @list.List[FolTerm])),
                (Int, @kernel.Thm),
              ),
