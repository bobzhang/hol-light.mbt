let optimize_rules_c : @lib.Cell[
  (
    @list.List[
      (
        Int,
        @list.List[
          (
            (@list.List[FolAtom], (Int, @list.List[FolTerm])),
            (Int, @kernel.Thm),
          ),
        ],
      ),
    ],
  ) -> @list.List[
    (
      Int,
      @list.List[
        ((@list.List[FolAtom], (Int, @list.List[FolTerm])), (Int, @kernel.Thm)),
      ],
    ),
  ] raise,
] = @lib.Cell::new("optimize_rules")

