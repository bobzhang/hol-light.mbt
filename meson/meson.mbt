      ),
      (@list.List[(FolTerm, Int)], Int, Int),
    ),
    x121 : ((FolGoal, (@list.List[(FolTerm, Int)], Int, Int))) -> TA raise,
  ) => expand_goal_l(rules, x119, x120, x121)
  let expand_goals = (
    x126 : Int,
    x127 : (
      @list.List[
        (
          (Int, @list.List[FolTerm]),
          @list.List[
            (
              Int,
              @list.List[
                (
                  (@list.List[FolAtom], (Int, @list.List[FolTerm])),
                  (Int, @kernel.Thm),
                ),
              ],
            ),
          ],
