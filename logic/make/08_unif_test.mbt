// Logic/unif.ml in its directory's load order: the test block of
// logic/unif/unif_ref_test.mbt (tools/ocaml_ref/chain_test.py), with the same golden
// (tools/ocaml_ref/Logic_unif_ref.expected).

///|
test "Logic/unif matches Logic/unif.ml" {
  @testkit.release_output()
  @unif.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "Library/analysis", "Library/wo", "Library/rstc", "Examples/reduct",
      "Examples/multiwf", "Logic/fol", "Logic/prenex", "Logic/skolem", "Logic/fol_prop",
      "Logic/canon", "Logic/herbrand", "Logic/fole", "Logic/unif",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Logic/unif")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("LEFT_AND_EX_THM", () => sthm(@unif.left_and_ex_thm()))
  log.attempt("EX_ADHOC", () => sthm(@unif.ex_adhoc()))
  log.attempt("ALL_ADHOC", () => sthm(@unif.all_adhoc()))
  log.attempt("WF_FINITE_LEMMA", () => sthm(@unif.wf_finite_lemma()))
  log.attempt("TC_REV", () => sthm(@unif.tc_rev()))
  log.attempt("WF_DISJ", () => sthm(@unif.wf_disj()))
  log.attempt("WF_ALTERNATION", () => sthm(@unif.wf_alternation()))
  log.attempt("MULTISET_FILTEREQ", () => sthm(@unif.multiset_filtereq()))
  log.attempt("WF_MULTIZIP", () => sthm(@unif.wf_multizip()))
  log.attempt("WF_MEASURE_OR_NONINC", () => sthm(@unif.wf_measure_or_noninc()))
  log.attempt("WF_PROJ_EQ", () => sthm(@unif.wf_proj_eq()))
  log.attempt("OCC", () => sthm(@unif.occ()))
  log.attempt("LOOPFREE", () => sthm(@unif.loopfree()))
  log.attempt("LOOP_BREAK", () => sthm(@unif.loop_break()))
  log.attempt("LOOPFREE_PRESERVE", () => sthm(@unif.loopfree_preserve()))
  log.attempt("LOOPFREE_PRESERVE_EQ", () => sthm(@unif.loopfree_preserve_eq()))
  log.attempt("LOOPFREE_WF", () => sthm(@unif.loopfree_wf()))
  log.attempt("LOOPFREE_WF_TERM", () => sthm(@unif.loopfree_wf_term()))
  log.attempt("LOOPCHECK_EXISTS", () => sthm(@unif.loopcheck_exists()))
  log.attempt("loopcheck_raw", () => sthm(@unif.loopcheck_raw()))
  log.attempt("loopcheck", () => sthm(@unif.loopcheck()))
  log.attempt("LOOPCHECK", () => sthm(@unif.loopcheck_v1()))
  log.attempt("rightsubst", () => sthm(@unif.rightsubst()))
  log.attempt("SOLVE_EXISTS", () => sthm(@unif.solve_exists()))
  log.attempt("SOLVEC_RAW", () => sthm(@unif.solvec_raw()))
  log.attempt("SOLVE", () => sthm(@unif.solve()))
  log.attempt("CONFLICTFREE", () => sthm(@unif.conflictfree()))
  log.attempt("SOLVE_PRESERVES_LOOPFREE_LEMMA", () => {
    sthm(@unif.solve_preserves_loopfree_lemma())
  })
  log.attempt("SOLVE_PRESERVES_LOOPFREE", () => {
    sthm(@unif.solve_preserves_loopfree())
  })
  log.attempt("SOLVE_PRESERVES_CONFLICTFREE_LEMMA", () => {
    sthm(@unif.solve_preserves_conflictfree_lemma())
  })
  log.attempt("SOLVE_PRESERVES_CONFLICTFREE", () => {
    sthm(@unif.solve_preserves_conflictfree())
  })
  log.attempt("SOLVE_PRESERVES_DEFREE", () => {
    sthm(@unif.solve_preserves_defree())
  })
  log.attempt("SOLVE_PRESERVES_UNIFIERS", () => {
    sthm(@unif.solve_preserves_unifiers())
  })
  log.attempt("SOLVE_WORKS_GENERAL", () => sthm(@unif.solve_works_general()))
  log.attempt("SOLVE_WORKS", () => sthm(@unif.solve_works()))
  log.attempt("retval_INDUCT", () => sthm(@unif.retval_induct()))
  log.attempt("retval_RECURSION", () => sthm(@unif.retval_recursion()))
  log.attempt("retval_DISTINCT", () => sthm(@unif.retval_distinct()))
  log.attempt("ISTRIV_EXISTS", () => sthm(@unif.istriv_exists()))
  log.attempt("istriv_raw", () => sthm(@unif.istriv_raw()))
  log.attempt("istriv", () => sthm(@unif.istriv()))
  log.attempt("EQV", () => sthm(@unif.eqv()))
  log.attempt("EQV_IMP_OCC", () => sthm(@unif.eqv_imp_occ()))
  log.attempt("ISTRIV_WORKS", () => sthm(@unif.istriv_works()))
  log.attempt("SUB1", () => sthm(@unif.sub1()))
  log.attempt("WF_SUB1", () => sthm(@unif.wf_sub1()))
  log.attempt("RTC_SUB1", () => sthm(@unif.rtc_sub1()))
  log.attempt("WF_SUBCOMPONENT", () => sthm(@unif.wf_subcomponent()))
  log.attempt("WF_DESCENT", () => sthm(@unif.wf_descent()))
  log.attempt("termcases", () => sthm(@unif.termcases()))
  log.attempt("tpcases_def", () => sthm(@unif.tpcases_def()))
  log.attempt("tpcases", () => sthm(@unif.tpcases()))
  log.attempt("MLEFT", () => sthm(@unif.mleft()))
  log.attempt("CRIGHT", () => sthm(@unif.cright()))
  log.attempt("CALLORDER", () => sthm(@unif.callorder()))
  log.attempt("PAIRED_ETA_THM", () => sthm(@unif.paired_eta_thm()))
  log.attempt("WF_CRIGHT", () => sthm(@unif.wf_cright()))
  log.attempt("WF_CALLORDER", () => sthm(@unif.wf_callorder()))
  log.attempt("UNIFY_EXISTS_RAW", () => sthm(@unif.unify_exists_raw()))
  log.attempt("unify_raw", () => sthm(@unif.unify_raw()))
  log.attempt("unify", () => sthm(@unif.unify()))
  log.attempt("unifies", () => sthm(@unif.unifies()))
  log.attempt("OPTION_DISTINCT", () => sthm(@unif.option_distinct()))
  log.attempt("OPTION_INJ", () => sthm(@unif.option_inj()))
  log.attempt("TC_SUB1_IRREFL", () => sthm(@unif.tc_sub1_irrefl()))
  log.attempt("UNIFY_OCCURS", () => sthm(@unif.unify_occurs()))
  log.attempt("UNIFY_OCCURS_PROPER", () => sthm(@unif.unify_occurs_proper()))
  log.attempt("GOODLOOP_UNIFIABLE", () => sthm(@unif.goodloop_unifiable()))
  log.attempt("BADLOOP_UNUNIFIABLE", () => sthm(@unif.badloop_ununifiable()))
  log.attempt("UNIFY_WORKS_RAW", () => sthm(@unif.unify_works_raw()))
  log.attempt("THE", () => sthm(@unif.the()))
  log.attempt("unifier", () => sthm(@unif.unifier()))
  log.attempt("ITLIST_VALMOD_LEMMA", () => sthm(@unif.itlist_valmod_lemma()))
  log.attempt("UNIFIER_WORKS", () => sthm(@unif.unifier_works()))
  log.attempt("UNIFIER_MGU", () => sthm(@unif.unifier_mgu()))
  log.attempt("UNIFY_WORKS", () => sthm(@unif.unify_works()))
  log.attempt("UNIFY_WORKS_SIMPLE", () => sthm(@unif.unify_works_simple()))
  log.attempt("Unifies_DEF", () => sthm(@unif.unifies_def()))
  log.attempt("UNIFIES", () => sthm(@unif.unifies_v1()))
  log.attempt("UNIFIER_FORMPAIR_TERMLIST", () => {
    sthm(@unif.unifier_formpair_termlist())
  })
  log.attempt("UNIFIER_SUBTERMS", () => sthm(@unif.unifier_subterms()))
  log.attempt("MGU_EXISTS", () => sthm(@unif.mgu_exists()))
  log.attempt("mgu", () => sthm(@unif.mgu()))
  log.attempt("MGU", () => sthm(@unif.mgu_v1()))
  log.attempt("FORMSUBST_TERMSUBST_LEMMA", () => {
    sthm(@unif.formsubst_termsubst_lemma())
  })
  log.attempt("ismgu", () => sthm(@unif.ismgu()))
  log.attempt("ISMGU", () => sthm(@unif.ismgu_v1()))
  log.attempt("ISMGU_MGU", () => sthm(@unif.ismgu_mgu()))
  log.attempt("renaming", () => sthm(@unif.renaming()))
  log.attempt("RENAMING", () => sthm(@unif.renaming_v1()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.probe_counters()
  @testkit.check_axioms()
  inspect(
    @testkit.normalize_times(log.contents()),
    content=(
