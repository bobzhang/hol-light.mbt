  let pth = taut_v1(@parser.parse_term("(a ==> b) <=> (~b ==> ~a)"))
  contrapos_conv_c.set((x103 : @kernel.Term) => {
    let tm = x103
    try {
      let (p, q) = @basics.dest_imp(tm)
      @kernel.inst_rule(@list.List([(p, a), (q, b)]), pth)
    } catch {
      Failure(_) => raise Failure("CONTRAPOS_CONV")
      e => raise e
    }
  })
}

