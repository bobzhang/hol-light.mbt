// Load-fidelity test for realarith.ml: replays tools/ocaml_ref/realarith_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "realarith matches realarith.ml" {
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("realarith")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("REAL_LTE_TOTAL", () => sthm(@realarith.real_lte_total()))
  log.attempt("REAL_LET_TOTAL", () => sthm(@realarith.real_let_total()))
  log.attempt("REAL_LT_IMP_LE", () => sthm(@realarith.real_lt_imp_le()))
  log.attempt("REAL_LTE_TRANS", () => sthm(@realarith.real_lte_trans()))
  log.attempt("REAL_LET_TRANS", () => sthm(@realarith.real_let_trans()))
  log.attempt("REAL_LT_TRANS", () => sthm(@realarith.real_lt_trans()))
  log.attempt("REAL_LE_ADD", () => sthm(@realarith.real_le_add()))
  log.attempt("REAL_LTE_ANTISYM", () => sthm(@realarith.real_lte_antisym()))
  log.attempt("REAL_SUB_LE", () => sthm(@realarith.real_sub_le()))
  log.attempt("REAL_NEG_SUB", () => sthm(@realarith.real_neg_sub()))
  log.attempt("REAL_LE_LT", () => sthm(@realarith.real_le_lt()))
  log.attempt("REAL_SUB_LT", () => sthm(@realarith.real_sub_lt()))
  log.attempt("REAL_NOT_LT", () => sthm(@realarith.real_not_lt()))
  log.attempt("REAL_SUB_0", () => sthm(@realarith.real_sub_0()))
  log.attempt("REAL_LT_LE", () => sthm(@realarith.real_lt_le()))
  log.attempt("REAL_LT_REFL", () => sthm(@realarith.real_lt_refl()))
  log.attempt("REAL_LTE_ADD", () => sthm(@realarith.real_lte_add()))
  log.attempt("REAL_LET_ADD", () => sthm(@realarith.real_let_add()))
  log.attempt("REAL_LT_ADD", () => sthm(@realarith.real_lt_add()))
  log.attempt("REAL_ENTIRE", () => sthm(@realarith.real_entire()))
  log.attempt("REAL_LE_NEGTOTAL", () => sthm(@realarith.real_le_negtotal()))
  log.attempt("REAL_LE_SQUARE", () => sthm(@realarith.real_le_square()))
  log.attempt("REAL_MUL_RID", () => sthm(@realarith.real_mul_rid()))
  log.attempt("REAL_POW_2", () => sthm(@realarith.real_pow_2()))
  log.attempt("REAL_POLY_CLAUSES", () => sthm(@realarith.real_poly_clauses()))
  log.attempt("REAL_POLY_NEG_CLAUSES", () => {
    sthm(@realarith.real_poly_neg_clauses())
  })
  log.attempt("REAL_POS", () => sthm(@realarith.real_pos()))
  log.attempt("REAL_LT_NZ", () => sthm(@realarith.real_lt_nz()))
  log.attempt("REAL_POS_LT", () => sthm(@realarith.real_pos_lt()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(
    @testkit.normalize_times(log.contents()),
    content=(
      #|Searching with limit 0
      #|Searching with limit 1
      #|Searching with limit 2
      #|Searching with limit 3
