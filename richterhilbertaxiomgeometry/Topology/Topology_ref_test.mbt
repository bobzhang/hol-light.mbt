// Load-fidelity test for RichterHilbertAxiomGeometry/Topology.ml: replays tools/ocaml_ref/RichterHilbertAxiomGeometry_Topology_ref.ml
// (keep in sync; refresh with tools/ocaml_ref/refresh_ref.py).

///|
using @testkit {stm, sthm}

///|
test "RichterHilbertAxiomGeometry/Topology matches RichterHilbertAxiomGeometry/Topology.ml" {
  @Topology.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "RichterHilbertAxiomGeometry/readable", "Library/wo", "Library/card",
      "Library/floor", "Multivariate/misc", "Library/products", "Library/matroids",
      "Multivariate/vectors", "Library/permutations", "Multivariate/determinants",
      "RichterHilbertAxiomGeometry/Topology",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("RichterHilbertAxiomGeometry/Topology")
  log.capture_stdout()
  // BEGIN generated theorem list
