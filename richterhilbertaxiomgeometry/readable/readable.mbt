///|
/// `theorem`
pub fn theorem(x200 : String) -> @kernel.Thm raise {
  let s = x200
  let s_1 = cleanmathfontsforhol_light(s)
  try {
    let start = @lib.str_search_forward(@lib.str_regexp((ws() + ("proof\\(" + (ws() + ("\\(.\\|\n\\)*\\)" + (ws() + ("qed" + (ws0() + (";" + ws0()))))))))), s_1, 0L)
