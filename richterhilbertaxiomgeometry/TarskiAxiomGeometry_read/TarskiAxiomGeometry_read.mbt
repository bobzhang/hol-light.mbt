X2;\n        suppose ℬ a b c;\n          is_ordered (x,a,b,c)     [] by fol H1 - Y3 BTransitivityOrdered_THM;\n            fol - is_ordered_DEF;\n          end;\n        suppose ℬ a c b;\n            fol Y3 - B124and234then123_THM;\n        end;  :: x,a,c,b\n        suppose ℬ c a b;\n          ℬ b a x ∧ ℬ b a c     [] by fol Y3 - Bsymmetry_THM;\n          fol - H1 Gupta_THM;\n        end;\n      end;\n    qed;\n    fol - Bsymmetry_THM H2 Line_DEF;\n  qed;\n")))
