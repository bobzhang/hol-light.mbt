  } else {
    let flag = (s1 == s2)
    let k_tm = @kernel.rand(@arith_nat.mk_small_numeral_array(@lib.mul63(2L, pp)))
    let num_exp1 = mk_num_exp(n1, k_tm)
    let num_exp2 = mk_num_exp(n2, @misc_vars.zero_const())
    let (div_th, n_tm_2, e_tm_2) = if flag {
      let th = num_exp_op_hi_lt(pp, fn(x728 : @kernel.Term) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
        fn(x729 : @kernel.Term) -> @kernel.Thm raise {
          num_exp_div(x728, x729)
        }
      }, num_exp1, num_exp2)
      let (n_tm, e_tm) = dest_num_exp(@kernel.rand(@kernel.concl(th)))
      (th, n_tm, e_tm)
    } else {
      let th_1 = num_exp_op_lo(pp, fn(x730 : @kernel.Term) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
        fn(x731 : @kernel.Term) -> @kernel.Thm raise {
          num_exp_div(x730, x731)
        }
      }, num_exp1, num_exp2)
      let (n_tm_1, e_tm_1) = dest_num_exp(@equal.lhand(@kernel.concl(th_1)))
      (th_1, n_tm_1, e_tm_1)
    }
    let r1_th = @arith_nat.raw_add_conv_hash(@basics.mk_binop(@misc_vars.add_op_num(), e2, k_tm))
    let r1_tm = @kernel.rand(@kernel.concl(r1_th))
    let e_plus_e1 = @arith_nat.raw_add_conv_hash(@basics.mk_binop(@misc_vars.add_op_num(), e_tm_2, e1))
    let (ltm, rtm) = @kernel.dest_comb(@kernel.concl(e_plus_e1))
    let r2_th_p = @arith_nat.raw_add_conv_hash(@basics.mk_binop(@misc_vars.add_op_num(), @float_theory.min_exp_num_const(), rtm))
    let r2_th = @kernel.trans(@equal.ap_term(@kernel.mk_comb(@misc_vars.add_op_num(), @float_theory.min_exp_num_const()), e_plus_e1), r2_th_p)
    let r2_tm = @kernel.rand(@kernel.concl(r2_th))
    let (sub_th, le_th) = @arith_nat.raw_sub_and_le_hash_conv(r2_tm)(r1_tm)
    if (@kernel.rand(@kernel.concl(le_th)) != r2_tm) {
      raise Failure("float_div_hi: underflow")
    } else {
      let r_tm = @kernel.rand(@kernel.concl(sub_th))
      let n2_not_zero = @arith_nat.raw_eq0_hash_conv(n2)
      let inst : (@kernel.Thm) -> @kernel.Thm raise = (x732 : @kernel.Thm) => @kernel.inst_rule(@list.List([(r1_tm, @misc_vars.r1_var_num()), (r2_tm, @misc_vars.r2_var_num()), (n1, @misc_vars.n1_var_num()), (e1, @misc_vars.e1_var_num()), (e_tm_2, @misc_vars.e_var_num()), (k_tm, @misc_vars.k_var_num()), (n2, @misc_vars.n2_var_num()), (e2, @misc_vars.e2_var_num()), (n_tm_2, @misc_vars.n_var_num()), (r_tm, @misc_vars.r_var_num())]), x732)
      let th0 = inst(if flag {
        if (s1 == "F") {
          float_div_ff_hi_p()
        } else {
          float_div_tt_hi_p()
        }
      } else {
