///|
/// `float_div_lo`
pub fn float_div_lo(x709 : Int64, x710 : @kernel.Term, x711 : @kernel.Term) -> @kernel.Thm raise {
  let pp = x709
  let f1 = x710
  let f2 = x711
  let (s1, n1, e1) = dest_float(f1)
  let (s2, n2, e2) = dest_float(f2)
  let n1_eq0_th = @arith_nat.raw_eq0_hash_conv(n1)
  if (@kernel.rand((fn(x712 : @kernel.Thm) -> @kernel.Term raise {
    @kernel.concl(x712)
  })(n1_eq0_th)) == @misc_vars.t_const()) {
    let t714 = @list.List([(e1, @misc_vars.e1_var_num()), (f2, @misc_vars.f2_var_real()), (n1, @misc_vars.n1_var_num()), (if (s1 == "T") {
      @misc_vars.t_const()
    } else {
      @misc_vars.f_const()
    }, @misc_vars.s1_var_bool())])
    ((x713 : @kernel.Thm) => @misc_functions.my_prove_hyp(n1_eq0_th, x713))(((x715 : @kernel.Thm) => @kernel.inst_rule(t714, x715))(float_div_0x_lo_p()))
  } else {
    let flag = (s1 == s2)
    let k_tm = @kernel.rand(@arith_nat.mk_small_numeral_array(@lib.mul63(2L, pp)))
    let num_exp1 = mk_num_exp(n1, k_tm)
    let num_exp2 = mk_num_exp(n2, @misc_vars.zero_const())
    let (div_th, n_tm_2, e_tm_2) = if flag {
      let th = num_exp_op_lo(pp, fn(x716 : @kernel.Term) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
        fn(x717 : @kernel.Term) -> @kernel.Thm raise {
          num_exp_div(x716, x717)
        }
      }, num_exp1, num_exp2)
      let (n_tm, e_tm) = dest_num_exp(@equal.lhand(@kernel.concl(th)))
      (th, n_tm, e_tm)
    } else {
      let th_1 = num_exp_op_hi_lt(pp, fn(x718 : @kernel.Term) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
        fn(x719 : @kernel.Term) -> @kernel.Thm raise {
          num_exp_div(x718, x719)
        }
      }, num_exp1, num_exp2)
      let (n_tm_1, e_tm_1) = dest_num_exp(@kernel.rand(@kernel.concl(th_1)))
