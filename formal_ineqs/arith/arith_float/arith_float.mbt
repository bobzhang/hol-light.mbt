  let inst : (@kernel.Thm) -> @kernel.Thm raise = (x185 : @kernel.Thm) => @kernel.inst_rule(@list.List([(n1_tm_1, @misc_vars.n1_var_num()), (e1_tm, @misc_vars.e1_var_num()), (n2_tm_1, @misc_vars.n2_var_num()), (e2_tm, @misc_vars.e2_var_num())]), x185)
  let n2_not_0 = @arith_nat.raw_eq0_hash_conv(n2_tm_1)
  if ((fn(x188 : @kernel.Term) -> String raise {
    (fn(x187 : @kernel.Term) -> String raise {
      (fn(x186 : (String, @kernel.HolType)) -> String raise {
        x186.0
      })(@kernel.dest_const(x187))
    })(@kernel.rand(x188))
  })((fn(x189 : @kernel.Thm) -> @kernel.Term raise {
    @kernel.concl(x189)
  })(n2_not_0)) == "T") {
    raise Failure("num_exp_div: n2 = 0")
  } else {
    if (@kernel.rand(@kernel.concl(e_le)) == e1_tm) {
      let th0_p = inst(num_exp_div1_p())
      let th0 = @misc_functions.my_prove_hyp(n2_not_0, @misc_functions.my_prove_hyp(e_le, th0_p))
      let (ltm, rtm) = @kernel.dest_comb(@kernel.rand(@kernel.concl(th0)))
