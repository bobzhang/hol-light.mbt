      })
      let th1 = @misc_functions.my_prove_hyp(n2_not_zero, @misc_functions.my_prove_hyp(div_th, @misc_functions.my_prove_hyp(le_th, th0)))
      @misc_functions.my_prove_hyp(sub_th, @misc_functions.my_prove_hyp(r2_th, @misc_functions.my_prove_hyp(r1_th, th1)))
