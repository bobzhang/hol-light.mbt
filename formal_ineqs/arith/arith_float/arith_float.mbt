  }
}

///|
/// `float_div_hi`
pub fn float_div_hi(x721 : Int64, x722 : @kernel.Term, x723 : @kernel.Term) -> @kernel.Thm raise {
  let pp = x721
  let f1 = x722
  let f2 = x723
  let (s1, n1, e1) = dest_float(f1)
  let (s2, n2, e2) = dest_float(f2)
  let n1_eq0_th = @arith_nat.raw_eq0_hash_conv(n1)
  if (@kernel.rand((fn(x724 : @kernel.Thm) -> @kernel.Term raise {
    @kernel.concl(x724)
  })(n1_eq0_th)) == @misc_vars.t_const()) {
    let t726 = @list.List([(e1, @misc_vars.e1_var_num()), (f2, @misc_vars.f2_var_real()), (n1, @misc_vars.n1_var_num()), (if (s1 == "T") {
      @misc_vars.t_const()
