///|
/// `num_exp_div`
pub fn num_exp_div(x183 : @kernel.Term, x184 : @kernel.Term) -> @kernel.Thm raise {
  let tm1 = x183
  let tm2 = x184
  let (n1_tm, e1_tm) = @kernel.dest_comb(tm1)
  let n1_tm_1 = @kernel.rand(n1_tm)
