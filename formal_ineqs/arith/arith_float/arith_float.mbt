///|
/// `float_mul_eq`
pub fn float_mul_eq(x445 : @kernel.Term, x446 : @kernel.Term) -> @kernel.Thm raise {
  let f1 = x445
  let f2 = x446
  let (s1, n1, e1) = dest_float(f1)
  let (s2, n2, e2) = dest_float(f2)
  let flag = (s1 == s2)
  let num_exp1 = mk_num_exp(n1, e1)
  let num_exp2 = mk_num_exp(n2, e2)
  let mul_th = num_exp_mul(num_exp1, num_exp2)
  let (n_tm, e_tm) = dest_num_exp(@kernel.rand(@kernel.concl(mul_th)))
  let (sub_th, le_th) = @arith_nat.raw_sub_and_le_hash_conv(e_tm)(@float_theory.min_exp_num_const())
  if (@kernel.rand(@kernel.concl(le_th)) != e_tm) {
