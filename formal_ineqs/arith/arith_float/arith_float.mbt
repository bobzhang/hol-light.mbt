pub fn float_interval_abs(x1371 : @kernel.Thm) -> @kernel.Thm raise {
  let th = x1371
  let (x, lo, hi) = dest_float_interval(@kernel.concl(th))
  let (s1, n1, e1) = dest_float(lo)
  let (s2, n2, e2) = dest_float(hi)
  let inst : (@kernel.Thm) -> @kernel.Thm raise = (x1372 : @kernel.Thm) => @kernel.inst_rule(@list.List([(x, @misc_vars.x_var_real()), (n1, @misc_vars.n1_var_num()), (e1, @misc_vars.e1_var_num()), (n2, @misc_vars.n2_var_num()), (e2, @misc_vars.e2_var_num())]), x1372)
  if (s1 == s2) {
    if (s1 == "F") {
      @misc_functions.my_prove_hyp(th, inst(float_interval_abs_ff()))
    } else {
      @misc_functions.my_prove_hyp(th, inst(float_interval_abs_tt()))
    }
  } else {
    if (s1 == "F") {
      @misc_functions.my_prove_hyp(th, inst(float_interval_abs_ft()))
    } else {
      let max_th = float_max_v1(make_float("F")(n1)(e1))(hi)
      let t_tm = @kernel.rand(@kernel.concl(max_th))
      let th0 = @kernel.inst_rule(@list.List([(x, @misc_vars.x_var_real()), (t_tm, @misc_vars.t_var_real()), (n1, @misc_vars.n1_var_num()), (e1, @misc_vars.e1_var_num()), (n2, @misc_vars.n2_var_num()), (e2, @misc_vars.e2_var_num())]), float_interval_abs_tf())
      @misc_functions.my_prove_hyp(max_th, @misc_functions.my_prove_hyp(th, th0))
    }
  }
}

