    let th1 = @equal.thenc(@equal.thenc(@simp.rewrite_conv(@list.List([@float_theory.float_alt(), @float_theory.arith_base_def(), @float_theory.min_exp_def()])), @calc_num.num_reduce_conv), @calc_rat.real_rat_reduce_conv)(tm0)
    @kernel.trans(th0, th1)
  }
}

///|
/// `print_float`
pub fn print_float(x2308 : @pp.Formatter, x2309 : @kernel.Term) -> Unit raise {
  let fmt = x2308
  let tm = x2309
  try {
    let (s, m_tm, e_tm) = dest_float(tm)
    let m = @arith_num.raw_dest_hash(m_tm)
    let t2310 = @num.num_of_int64(@float_theory.min_exp())
    let e = @num.sub_num(@arith_num.raw_dest_hash(e_tm), t2310)
    let s_str = if (s == "T") {
      "-"
    } else {
      ""
    }
    let m_str = @num.string_of_num(m)
    let e_str = if (e == @num.num_0) {
      ""
    } else {
      let t2311 = ("^" + @num.string_of_num(e))
      ("*" + (Int64::to_string(@arith_num.arith_base()) + t2311))
    }
    let str = ("##" + (s_str + (m_str + e_str)))
    @pp.Formatter::print_string(fmt, str)
  } catch {
    _ => raise Failure("print_float")
  }
}

