///|
/// `get_big_int_digits`
pub fn get_big_int_digits(x1087 : Int64, x1088 : @bigint.BigInt) -> @list.List[@bigint.BigInt] raise {
  let b = x1087
  let n = x1088
  let bb = @num.big_int_of_int(b)
  if @num.le_big_int(n, @num.zero_big_int) {
    @list.empty()
  } else {
    let (q, r) = @num.quomod_big_int(n, bb)
    get_big_int_digits(b, q).prepend(r)
  }
}

///|
/// `big_int_from_list`
pub fn big_int_from_list(x1089 : Int64, x1090 : @list.List[@bigint.BigInt]) -> @bigint.BigInt raise {
  let b = x1089
  let list = x1090
  fn proc(x1091 : @bigint.BigInt, x1092 : @list.List[@bigint.BigInt]) -> @bigint.BigInt raise {
    let acc = x1091
    let list_1 = x1092
    match list_1 {
      Empty => acc
      More(h, tail=t) => proc(@num.add_big_int(h, @num.mult_int_big_int(b, acc)), t)
    }
  }
  proc(@num.zero_big_int, list)
}

///|
/// `take`
pub fn[TA] take(x1093 : Int64, x1094 : @list.List[TA]) -> @list.List[TA] raise {
  let n = x1093
  let list = x1094
  match list {
    More(x, tail=xs) => {
      if (n > 0L) {
        take(@lib.sub63(n, 1L), xs).prepend(x)
      } else {
        @list.empty()
      }
    }
    Empty => @list.empty()
  }
}

///|
/// `big_int_round_lo`
pub fn big_int_round_lo(x1095 : Int64, x1096 : Int64, x1097 : @bigint.BigInt) -> @bigint.BigInt raise {
  let base = x1095
  let pp = x1096
  let n = x1097
  let digits = @lib.rev(get_big_int_digits(base, n))
  let n_digits = Int::to_int64(@lib.length(digits))
  if (n_digits <= pp) {
    n
  } else {
    let m = big_int_from_list(base, take(pp, digits))
    @num.mult_big_int(@num.power_int_positive_int(base, @lib.sub63(n_digits, pp)), m)
  }
}

///|
/// `big_int_round_hi`
pub fn big_int_round_hi(x1098 : Int64, x1099 : Int64, x1100 : @bigint.BigInt) -> @bigint.BigInt raise {
  let base = x1098
