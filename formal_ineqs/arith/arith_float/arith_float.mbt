      let th0_p_1 = inst(num_exp_div2_p())
      let th0_1 = @misc_functions.my_prove_hyp(n2_not_0, @misc_functions.my_prove_hyp(e_le, th0_p_1))
      let (ltm_2, rtm_2) = @kernel.dest_comb(@kernel.rand(@kernel.concl(th0_1)))
      let num_exp_tm_1 = @kernel.rator(rtm_2)
      let th1_1 = @equal.ap_term(ltm_2, @equal.ap_term(num_exp_tm_1, e_sub))
      let (ltm_3, rtm_3) = @kernel.dest_comb(@kernel.rand(@kernel.concl(th1_1)))
