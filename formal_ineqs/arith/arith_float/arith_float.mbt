    let e_th_p = @equal.sym(@kernel.inst_rule(@list.List([(e_tm, @misc_vars.n_var_num())]), @arith_num.num_thm()))
    let n_th = @kernel.trans(n_th_p, @arith_nat.num_to_numeral_conv(@kernel.mk_comb(@arith_num.num_const(), n_tm)))
    let e_th = @kernel.trans(e_th_p, @arith_nat.num_to_numeral_conv(@kernel.mk_comb(@arith_num.num_const(), e_tm)))
