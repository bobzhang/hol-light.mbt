      let num_exp_tm = @kernel.rator(rtm2)
      let th1 = @equal.ap_thm(@equal.ap_term(div_tm, @equal.ap_term(num_exp_tm, e_sub)), rtm)
      let (ltm_1, rtm_1) = @kernel.dest_comb(@kernel.rand(@kernel.concl(th1)))
      let tm1_1 = @kernel.rand(ltm_1)
      let th2 = @equal.ap_thm(@equal.ap_term(div_tm, denormalize(tm1_1)), rtm_1)
      let th3 = @arith_nat.raw_div_hash_conv(@kernel.rand(@kernel.concl(th2)))
      let th = @kernel.trans(th0, @kernel.trans(th1, @kernel.trans(th2, th3)))
      @kernel.trans(th, @kernel.inst_rule(@list.List([(@kernel.rand(@kernel.concl(th)), @misc_vars.n_var_num())]), num_exp_0_p()))
