///|
/// compare_floats_raw
fn step_213() -> Unit raise {
  let denorm : (@num.Num) -> ((@num.Num) -> @num.Num raise) raise = fn(x1271 : @num.Num) -> ((@num.Num) -> @num.Num raise) raise {
    let n = x1271
    fn(x1272 : @num.Num) -> @num.Num raise {
