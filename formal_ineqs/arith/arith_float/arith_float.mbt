  } else {
    let (l1, l2) = @lib.chop_list(@lib.int63_to_int(pp), digits)
    if @lib.forall(fn(x1102 : @bigint.BigInt) -> Bool raise {
      ((x1101 : @bigint.BigInt) => @num.eq_big_int(@num.zero_big_int, x1101))(x1102)
    }, l2) {
      n
    } else {
      let m = @num.succ_big_int(big_int_from_list(base, l1))
      @num.mult_big_int(@num.power_int_positive_int(base, @lib.sub63(n_digits, pp)), m)
    }
  }
}

