    }
    let r1_th = @arith_nat.raw_add_conv_hash(@basics.mk_binop(@misc_vars.add_op_num(), e2, k_tm))
    let r1_tm = @kernel.rand(@kernel.concl(r1_th))
    let e_plus_e1 = @arith_nat.raw_add_conv_hash(@basics.mk_binop(@misc_vars.add_op_num(), e_tm_2, e1))
    let (ltm, rtm) = @kernel.dest_comb(@kernel.concl(e_plus_e1))
    let r2_th_p = @arith_nat.raw_add_conv_hash(@basics.mk_binop(@misc_vars.add_op_num(), @float_theory.min_exp_num_const(), rtm))
