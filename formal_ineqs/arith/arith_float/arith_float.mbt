      @num.mult_num(n, @num.power_num(@num.num_of_int64(@arith_num.arith_base()), e))
    }
  }
  let cmp : (@num.Num) -> ((@num.Num) -> ((@num.Num) -> ((@num.Num) -> Int64 raise) raise) raise) raise = fn(x1273 : @num.Num) -> ((@num.Num) -> ((@num.Num) -> ((@num.Num) -> Int64 raise) raise) raise) raise {
    let n1 = x1273
    fn(x1274 : @num.Num) -> ((@num.Num) -> ((@num.Num) -> Int64 raise) raise) raise {
      let e1 = x1274
      fn(x1275 : @num.Num) -> ((@num.Num) -> Int64 raise) raise {
        let n2 = x1275
