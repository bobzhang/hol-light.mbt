    0L => @kernel.inst_rule(@list.List([(x, @misc_vars.x_var_real())]), float_interval_pow0())
    1L => {
      let th0 = @kernel.inst_rule(@list.List([(x, @misc_vars.x_var_real()), (low, @misc_vars.lo_var_real()), (high, @misc_vars.hi_var_real())]), float_interval_pow1())
      @misc_functions.my_prove_hyp(x_th, th0)
    }
    _ => {
      let _ = if (n > 1L) {
        ()
      } else {
        raise @lib.AssertFailure("tscript.ml:454:11")
      }
      if ((n & 1L) == 1L) {
        let hi_th = float_pow_hi(pp, n, high)
        let lo_th = float_pow_lo(pp, n, low)
        let hi = @kernel.rand(@kernel.concl(hi_th))
        let lo = @equal.lhand(@kernel.concl(lo_th))
        let n_tm = @kernel.rand(@kernel.rand(@kernel.concl(lo_th)))
        let even_n = eval_even(n_tm)
        let th0_1 = @kernel.inst_rule(@list.List([(x, @misc_vars.x_var_real()), (low, @misc_vars.low_var_real()), (high, @misc_vars.high_var_real()), (hi, @misc_vars.hi_var_real()), (lo, @misc_vars.lo_var_real()), (n_tm, @misc_vars.n_var_num())]), float_interval_pow_odd())
        @misc_functions.my_prove_hyp(even_n, @misc_functions.my_prove_hyp(lo_th, @misc_functions.my_prove_hyp(hi_th, @misc_functions.my_prove_hyp(x_th, th0_1))))
      } else {
        let (s1, n1, e1) = @arith_float.dest_float(low)
        let (s2, n2, e2) = @arith_float.dest_float(high)
        if (s1 == s2) {
          if (s1 == "F") {
            let hi_th_1 = float_pow_hi(pp, n, high)
            let lo_th_1 = float_pow_lo(pp, n, low)
            let hi_1 = @kernel.rand(@kernel.concl(hi_th_1))
            let lo_1 = @equal.lhand(@kernel.concl(lo_th_1))
            let n_tm_1 = @kernel.rand(@kernel.rand(@kernel.concl(lo_th_1)))
            let th0_2 = @kernel.inst_rule(@list.List([(x, @misc_vars.x_var_real()), (n1, @misc_vars.n1_var_num()), (e1, @misc_vars.e1_var_num()), (n2, @misc_vars.n2_var_num()), (e2, @misc_vars.e2_var_num()), (n_tm_1, @misc_vars.n_var_num()), (lo_1, @misc_vars.lo_var_real()), (hi_1, @misc_vars.hi_var_real())]), float_interval_pow_ff())
            @misc_functions.my_prove_hyp(lo_th_1, @misc_functions.my_prove_hyp(hi_th_1, @misc_functions.my_prove_hyp(x_th, th0_2)))
          } else {
            let hi_th_2 = float_pow_hi(pp, n, @arith_float.make_float("F")(n1)(e1))
            let lo_th_2 = float_pow_lo(pp, n, @arith_float.make_float("F")(n2)(e2))
            let hi_2 = @kernel.rand(@kernel.concl(hi_th_2))
            let lo_2 = @equal.lhand(@kernel.concl(lo_th_2))
            let n_tm_2 = @kernel.rand(@kernel.rand(@kernel.concl(lo_th_2)))
            let even_n_1 = eval_even(n_tm_2)
            let th0_3 = @kernel.inst_rule(@list.List([(x, @misc_vars.x_var_real()), (n1, @misc_vars.n1_var_num()), (e1, @misc_vars.e1_var_num()), (n2, @misc_vars.n2_var_num()), (e2, @misc_vars.e2_var_num()), (n_tm_2, @misc_vars.n_var_num()), (lo_2, @misc_vars.lo_var_real()), (hi_2, @misc_vars.hi_var_real())]), float_interval_pow_even_tt())
            @misc_functions.my_prove_hyp(lo_th_2, @misc_functions.my_prove_hyp(hi_th_2, @misc_functions.my_prove_hyp(even_n_1, @misc_functions.my_prove_hyp(x_th, th0_3))))
          }
        } else {
          if (s1 == "F") {
            let n_tm_3 = @nums.mk_small_numeral(n)
            let n0 = eval_eq0(n_tm_3)
            let th0_4 = @kernel.inst_rule(@list.List([(x, @misc_vars.x_var_real()), (n_tm_3, @misc_vars.n_var_num()), (n1, @misc_vars.n1_var_num()), (e1, @misc_vars.e1_var_num()), (n2, @misc_vars.n2_var_num()), (e2, @misc_vars.e2_var_num())]), float_interval_pow_ft())
            @misc_functions.my_prove_hyp(n0, @misc_functions.my_prove_hyp(x_th, th0_4))
          } else {
            let max_eq = @arith_float.float_max_v1(@arith_float.make_float("F")(n1)(e1))(high)
            let t_tm = @kernel.rand(@kernel.concl(max_eq))
            let hi_th_3 = float_pow_hi(pp, n, t_tm)
            let (ltm, hi_3) = @kernel.dest_comb(@kernel.concl(hi_th_3))
            let n_tm_4 = @kernel.rand(@kernel.rand(ltm))
            let even_n_2 = eval_even(n_tm_4)
            let th0_5 = @kernel.inst_rule(@list.List([(x, @misc_vars.x_var_real()), (n_tm_4, @misc_vars.n_var_num()), (n1, @misc_vars.n1_var_num()), (e1, @misc_vars.e1_var_num()), (n2, @misc_vars.n2_var_num()), (e2, @misc_vars.e2_var_num()), (t_tm, @misc_vars.t_var_real()), (hi_3, @misc_vars.hi_var_real())]), float_interval_pow_even_tf())
            @misc_functions.my_prove_hyp(hi_th_3, @misc_functions.my_prove_hyp(max_eq, @misc_functions.my_prove_hyp(even_n_2, @misc_functions.my_prove_hyp(x_th, th0_5))))
          }
        }
      }
    }
  }
}

///|
fn load_steps() -> Unit raise {
  step_1()
  step_2()
  step_3()
  step_4()
  step_5()
  step_6()
  step_7()
  step_8()
  step_9()
  step_10()
  step_11()
  step_12()
  step_13()
  step_14()
  step_15()
  step_16()
  step_17()
  step_18()
  step_19()
  step_20()
  step_21()
  step_22()
  step_23()
  step_24()
  step_25()
  step_26()
  step_27()
}
