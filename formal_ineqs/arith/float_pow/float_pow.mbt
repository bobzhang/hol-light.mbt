          let th0_2 = @kernel.inst_rule(@list.List([(xn_tm, @misc_vars.n_var_num()), (e_tm, @misc_vars.e_var_num()), (n_tm_1, @misc_vars.i_var_num()), (n1_tm, @misc_vars.n1_var_num()), (e1_tm, @misc_vars.e1_var_num())]), float_pow_neg_odd_lo_th())
          @misc_functions.my_prove_hyp(n_even_1, @misc_functions.my_prove_hyp(hi_th, th0_2))
