  let th0 = @kernel.inst_rule(@list.List([(x1_tm, @misc_vars.x1_var_real()), (y1_tm, @misc_vars.y1_var_real()), (x2_tm, @misc_vars.x2_var_real()), (y2_tm, @misc_vars.y2_var_real()), (x_tm, @misc_vars.x_var_real())]), sub_ineq_lo())
  @misc_functions.my_prove_hyp(ineq1, @misc_functions.my_prove_hyp(ineq2, @misc_functions.my_prove_hyp(lhs_sub, th0)))
}

