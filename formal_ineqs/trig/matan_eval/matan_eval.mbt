pub fn float_interval_dmatan(x : Int64) -> ((@kernel.Thm) -> @kernel.Thm raise) raise {
  (float_interval_dmatan_c.get())(x)
}

///|
/// array_065
fn step_21() -> Unit raise {
  let t258 = @parser.parse_term("#0.65")
  let interval = mk_float_interval_decimal(20L)(t258)
  array_065_c.set(@lib.array_init(20L, fn(x259 : Int64) -> @kernel.Thm raise {
    let i = x259
    @arith_float.float_interval_round(i, interval)
  }))
}

///|
let array_065_c : @lib.Cell[FixedArray[@kernel.Thm]] = @lib.Cell::new("array_065")

///|
