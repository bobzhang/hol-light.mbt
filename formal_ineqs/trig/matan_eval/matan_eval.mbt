        let th0_1 = @kernel.inst_rule(@list.List([(x_tm, @misc_vars.x_var_real()), (lo_tm, @misc_vars.lo_var_real()), (hi_tm, @misc_vars.hi_var_real()), (bounds_tm, @misc_vars.bounds_var())]), dmatan_gt0())
        @lib.itlist(@misc_functions.my_prove_hyp, @list.List([x_th, lo_gt0, th1]), th0_1)
      }
    }
  })
}

///|
let float_interval_dmatan_c : @lib.Cell[(Int64) -> ((@kernel.Thm) -> @kernel.Thm raise) raise] = @lib.Cell::new("float_interval_dmatan")

///|
