pub fn array_065() -> FixedArray[@kernel.Thm] {
  array_065_c.get()
}

///|
/// `float_interval_ddmatan`
pub fn float_interval_ddmatan(x260 : Int64, x261 : @kernel.Thm) -> @kernel.Thm raise {
  let pp = x260
  let x_th = x261
  let (x_tm, bounds) = @interval_arith.dest_interval_arith(@kernel.concl(x_th))
  let (ltm, hi_tm) = @kernel.dest_comb(bounds)
  let lo_tm = @kernel.rand(ltm)
  let (flag, lo_ge) = @arith_float.float_prove_ge_interval(lo_tm)(interval_neg_02())
  if !flag {
    raise Failure("float_interval_ddmatan: the argument is out of range")
  } else {
    let int065 = @lib.array_get(array_065(), @lib.int63_to_int(pp))
    let (a_tm, b_tm) = @pair.dest_pair(@kernel.rand(@kernel.concl(int065)))
    let b2_eq = @more_float.float_neg(b_tm)
    let b2_tm = @kernel.rand(@kernel.rator(@kernel.concl(b2_eq)))
    let th0 = @kernel.inst_rule(@list.List([(x_tm, @misc_vars.x_var_real()), (lo_tm, @misc_vars.lo_var_real()), (hi_tm, @misc_vars.hi_var_real()), (a_tm, @misc_vars.a_var_real()), (b_tm, @misc_vars.b_var_real()), (b2_tm, @misc_vars.b2_var_real())]), ddmatan_ge_neg02())
    @lib.itlist(@misc_functions.my_prove_hyp, @list.List([x_th, lo_ge, int065, b2_eq]), th0)
  }
}

