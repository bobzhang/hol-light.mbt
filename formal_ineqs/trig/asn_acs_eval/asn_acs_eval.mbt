///|
/// `float_interval_asn`
pub fn float_interval_asn(x194 : Int64, x195 : @kernel.Thm) -> @kernel.Thm raise {
  let pp = x194
  let x_th = x195
  let (x_tm, bounds) = @interval_arith.dest_interval_arith(@kernel.concl(x_th))
  let (ltm, b_tm) = @kernel.dest_comb(bounds)
  let a_tm = @kernel.rand(ltm)
  let (flag1, cmp1) = @arith_float.float_prove_le(neg_one_float(), a_tm)
  let (flag2, cmp2) = @arith_float.float_prove_le(b_tm, @more_float.one_float())
  if (flag1 && flag2) {
    let asn_a = float_asn_lo(pp, a_tm)
    let asn_b = float_asn_hi(pp, b_tm)
    let lo_tm = @equal.lhand(@kernel.concl(asn_a))
    let hi_tm = @kernel.rand(@kernel.concl(asn_b))
    let th0 = @kernel.inst_rule(@list.List([(x_tm, @misc_vars.x_var_real()), (a_tm, @misc_vars.a_var_real()), (b_tm, @misc_vars.b_var_real()), (lo_tm, @misc_vars.lo_var_real()), (hi_tm, @misc_vars.hi_var_real())]), asn_interval())
    @lib.itlist(@misc_functions.my_prove_hyp, @list.List([x_th, cmp1, cmp2, asn_a, asn_b]), th0)
  } else {
    raise Failure(("float_interval_asn: x < -1 or x > 1: " + @printer.string_of_term(@kernel.concl(x_th))))
  }
