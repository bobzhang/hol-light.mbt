      raise Failure(("float_asn_lo: r <= 0: " + @printer.string_of_term(x_tm)))
    } else {
      let th0 = @kernel.inst_rule(@list.List([(n_tm, @misc_vars.n_var_num()), (e_tm, @misc_vars.e_var_num()), (lo_tm, @misc_vars.lo_var_real()), (b_tm, @misc_vars.b_var_real()), (c_tm, @misc_vars.c_var_real()), (r_tm, @misc_vars.r_var_real()), (t_tm, @misc_vars.t_var_real())]), asn_neg_lo_th())
      @lib.itlist(@misc_functions.my_prove_hyp, @list.List([x_pow2, b1, sqrt_c, x_div_r, atn_t, cmp]), th0)
    }
  } else {
    let x_pow2_1 = @float_pow.float_pow_lo(pp, 2L, x_tm)
    let b_tm_1 = @equal.lhand(@kernel.concl(x_pow2_1))
    let b1_1 = @arith_float.float_sub_hi_v1(pp)(@more_float.one_float())(b_tm_1)
    let c_tm_1 = @kernel.rand(@kernel.concl(b1_1))
    let sqrt_c_1 = @arith_float.float_sqrt_hi_v1(pp)(c_tm_1)
    let r_tm_1 = @kernel.rand(@kernel.concl(sqrt_c_1))
    let x_div_r_1 = @arith_float.float_div_lo_v1(pp)(x_tm)(r_tm_1)
    let t_tm_1 = @equal.lhand(@kernel.concl(x_div_r_1))
    let atn_t_1 = @atn_eval.float_atn_lo(pp, t_tm_1)
    let lo_tm_1 = @equal.lhand(@kernel.concl(atn_t_1))
    let cmp_1 = @arith_float.float_lt_v1(x_tm)(@more_float.one_float())
    if (@kernel.dest_const(@kernel.rand(@kernel.concl(cmp_1))).0 == "F") {
      raise Failure(("float_asn_hi: 1 <= x: " + @printer.string_of_term(x_tm)))
    } else {
      let th0_1 = @kernel.inst_rule(@list.List([(n_tm, @misc_vars.n_var_num()), (e_tm, @misc_vars.e_var_num()), (lo_tm_1, @misc_vars.lo_var_real()), (b_tm_1, @misc_vars.b_var_real()), (c_tm_1, @misc_vars.c_var_real()), (r_tm_1, @misc_vars.r_var_real()), (t_tm_1, @misc_vars.t_var_real())]), asn_pos_lo_th())
      @lib.itlist(@misc_functions.my_prove_hyp, @list.List([x_pow2_1, b1_1, sqrt_c_1, x_div_r_1, atn_t_1, cmp_1]), th0_1)
    }
  }
}

///|
/// `float_acs_hi`
pub fn float_acs_hi(x190 : Int64, x191 : @kernel.Term) -> @kernel.Thm raise {
  let pp = x190
  let x_tm = x191
  let (flag1, cmp1) = @arith_float.float_prove_le(x_tm, @more_float.one_float())
  let (flag2, cmp2) = @arith_float.float_prove_le(neg_one_float(), x_tm)
  if (flag1 && flag2) {
    let pi2 = @lib.array_get(@atn_eval.pi2_approx_array(), @lib.int63_to_int(pp))
    let bounds = @kernel.rand(@kernel.concl(pi2))
    let (ltm, b_tm) = @kernel.dest_comb(bounds)
    let a_tm = @kernel.rand(ltm)
    let asn_x = float_asn_lo(pp, x_tm)
    let c_tm = @equal.lhand(@kernel.concl(asn_x))
    let sub = @arith_float.float_sub_hi_v1(pp)(b_tm)(c_tm)
    let hi_tm = @kernel.rand(@kernel.concl(sub))
    let th0 = @kernel.inst_rule(@list.List([(x_tm, @misc_vars.x_var_real()), (a_tm, @misc_vars.a_var_real()), (b_tm, @misc_vars.b_var_real()), (c_tm, @misc_vars.c_var_real()), (hi_tm, @misc_vars.hi_var_real())]), acs_hi_th())
    @lib.itlist(@misc_functions.my_prove_hyp, @list.List([cmp1, cmp2, pi2, asn_x, sub]), th0)
  } else {
    raise Failure(("float_acs_hi: x < -1 or x > 1: " + @printer.string_of_term(x_tm)))
  }
}

