///|
/// `float_interval_acs`
pub fn float_interval_acs(x196 : Int64, x197 : @kernel.Thm) -> @kernel.Thm raise {
  let pp = x196
  let x_th = x197
  let (x_tm, bounds) = @interval_arith.dest_interval_arith(@kernel.concl(x_th))
  let (ltm, b_tm) = @kernel.dest_comb(bounds)
  let a_tm = @kernel.rand(ltm)
  let (flag1, cmp1) = @arith_float.float_prove_le(neg_one_float(), a_tm)
  let (flag2, cmp2) = @arith_float.float_prove_le(b_tm, @more_float.one_float())
  if (flag1 && flag2) {
    let acs_a = float_acs_hi(pp, a_tm)
    let acs_b = float_acs_lo(pp, b_tm)
    let lo_tm = @equal.lhand(@kernel.concl(acs_b))
    let hi_tm = @kernel.rand(@kernel.concl(acs_a))
    let th0 = @kernel.inst_rule(@list.List([(x_tm, @misc_vars.x_var_real()), (a_tm, @misc_vars.a_var_real()), (b_tm, @misc_vars.b_var_real()), (lo_tm, @misc_vars.lo_var_real()), (hi_tm, @misc_vars.hi_var_real())]), acs_interval())
    @lib.itlist(@misc_functions.my_prove_hyp, @list.List([x_th, cmp1, cmp2, acs_a, acs_b]), th0)
  } else {
    raise Failure(("float_interval_acs: x < -1 or x > 1: " + @printer.string_of_term(@kernel.concl(x_th))))
  }
}

///|
/// `float_interval_acs2`
pub fn float_interval_acs2(x198 : Int64, x199 : @kernel.Thm) -> @kernel.Thm raise {
  let pp = x198
  let x_th = x199
  let (x_tm, bounds) = @interval_arith.dest_interval_arith(@kernel.concl(x_th))
  let (ltm, b_tm) = @kernel.dest_comb(bounds)
  let a_tm = @kernel.rand(ltm)
  let (flag1, cmp1) = @arith_float.float_prove_le(neg_one_float(), a_tm)
  let (flag2, cmp2) = @arith_float.float_prove_le(b_tm, @more_float.one_float())
  if (flag1 && flag2) {
    let asn_a = float_asn_lo(pp, a_tm)
    let asn_b = float_asn_hi(pp, b_tm)
    let pi2 = @lib.array_get(@atn_eval.pi2_approx_array(), @lib.int63_to_int(pp))
    let bounds_1 = @kernel.rand(@kernel.concl(pi2))
    let (ltm_1, high_tm) = @kernel.dest_comb(bounds_1)
    let low_tm = @kernel.rand(ltm_1)
    let t_tm = @kernel.rand(@kernel.concl(asn_b))
    let r_tm = @equal.lhand(@kernel.concl(asn_a))
    let sub_lo = @arith_float.float_sub_lo_v1(pp)(low_tm)(t_tm)
    let sub_hi = @arith_float.float_sub_hi_v1(pp)(high_tm)(r_tm)
    let lo_tm = @equal.lhand(@kernel.concl(sub_lo))
    let hi_tm = @kernel.rand(@kernel.concl(sub_hi))
    let th0 = @kernel.inst_rule(@list.List([(x_tm, @misc_vars.x_var_real()), (a_tm, @misc_vars.a_var_real()), (b_tm, @misc_vars.b_var_real()), (low_tm, @misc_vars.low_var_real()), (high_tm, @misc_vars.high_var_real()), (t_tm, @misc_vars.t_var_real()), (r_tm, @misc_vars.r_var_real()), (lo_tm, @misc_vars.lo_var_real()), (hi_tm, @misc_vars.hi_var_real())]), acs_interval2())
    @lib.itlist(@misc_functions.my_prove_hyp, @list.List([x_th, cmp1, cmp2, pi2, asn_a, asn_b, sub_lo, sub_hi]), th0)
  } else {
    raise Failure(("float_interval_acs: x < -1 or x > 1: " + @printer.string_of_term(@kernel.concl(x_th))))
  }
}

