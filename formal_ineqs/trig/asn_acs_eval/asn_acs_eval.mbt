///|
/// `float_asn_hi`
pub fn float_asn_hi(x186 : Int64, x187 : @kernel.Term) -> @kernel.Thm raise {
  let pp = x186
  let x_tm = x187
  let (s, n_tm, e_tm) = @arith_float.dest_float(x_tm)
  if (s == "F") {
    let x_pow2 = @float_pow.float_pow_hi(pp, 2L, x_tm)
    let b_tm = @kernel.rand(@kernel.concl(x_pow2))
    let b1 = @arith_float.float_sub_lo_v1(pp)(@more_float.one_float())(b_tm)
    let c_tm = @equal.lhand(@kernel.concl(b1))
    let sqrt_c = @arith_float.float_sqrt_lo_v1(pp)(c_tm)
    let r_tm = @equal.lhand(@kernel.concl(sqrt_c))
    let x_div_r = @arith_float.float_div_hi_v1(pp)(x_tm)(r_tm)
    let t_tm = @kernel.rand(@kernel.concl(x_div_r))
    let atn_t = @atn_eval.float_atn_hi(pp, t_tm)
    let hi_tm = @kernel.rand(@kernel.concl(atn_t))
    let cmp = @arith_float.float_gt0_v1(r_tm)
    if (@kernel.dest_const(@kernel.rand(@kernel.concl(cmp))).0 == "F") {
      raise Failure(("float_asn_hi: r <= 0: " + @printer.string_of_term(x_tm)))
    } else {
      let th0 = @kernel.inst_rule(@list.List([(n_tm, @misc_vars.n_var_num()), (e_tm, @misc_vars.e_var_num()), (hi_tm, @misc_vars.hi_var_real()), (b_tm, @misc_vars.b_var_real()), (c_tm, @misc_vars.c_var_real()), (r_tm, @misc_vars.r_var_real()), (t_tm, @misc_vars.t_var_real())]), asn_pos_hi_th())
      @lib.itlist(@misc_functions.my_prove_hyp, @list.List([x_pow2, b1, sqrt_c, x_div_r, atn_t, cmp]), th0)
    }
  } else {
    let x_pow2_1 = @float_pow.float_pow_lo(pp, 2L, x_tm)
    let b_tm_1 = @equal.lhand(@kernel.concl(x_pow2_1))
    let b1_1 = @arith_float.float_sub_hi_v1(pp)(@more_float.one_float())(b_tm_1)
    let c_tm_1 = @kernel.rand(@kernel.concl(b1_1))
    let sqrt_c_1 = @arith_float.float_sqrt_hi_v1(pp)(c_tm_1)
    let r_tm_1 = @kernel.rand(@kernel.concl(sqrt_c_1))
    let x_div_r_1 = @arith_float.float_div_hi_v1(pp)(x_tm)(r_tm_1)
    let t_tm_1 = @kernel.rand(@kernel.concl(x_div_r_1))
    let atn_t_1 = @atn_eval.float_atn_hi(pp, t_tm_1)
    let hi_tm_1 = @kernel.rand(@kernel.concl(atn_t_1))
    let cmp_1 = @arith_float.float_lt_v1(neg_one_float())(x_tm)
    if (@kernel.dest_const(@kernel.rand(@kernel.concl(cmp_1))).0 == "F") {
      raise Failure(("float_asn_hi: x <= -1: " + @printer.string_of_term(x_tm)))
    } else {
      let th0_1 = @kernel.inst_rule(@list.List([(n_tm, @misc_vars.n_var_num()), (e_tm, @misc_vars.e_var_num()), (hi_tm_1, @misc_vars.hi_var_real()), (b_tm_1, @misc_vars.b_var_real()), (c_tm_1, @misc_vars.c_var_real()), (r_tm_1, @misc_vars.r_var_real()), (t_tm_1, @misc_vars.t_var_real())]), asn_neg_hi_th())
      @lib.itlist(@misc_functions.my_prove_hyp, @list.List([x_pow2_1, b1_1, sqrt_c_1, x_div_r_1, atn_t_1, cmp_1]), th0_1)
    }
  }
}

///|
/// `float_asn_lo`
pub fn float_asn_lo(x188 : Int64, x189 : @kernel.Term) -> @kernel.Thm raise {
  let pp = x188
