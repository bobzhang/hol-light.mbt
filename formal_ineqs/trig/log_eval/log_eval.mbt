  let t108 = @tactics.then_tac(@tactics.thenl(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t97), t98), t99), t100), t104), t106), t107)
  let t109 = (@parser.parse_term("inv x <= t /\\ log t <= r /\\ \n     low = --r /\\ &0 < x\n       ==> low <= log x"), t108)
  log_reduce_simple_low_c.set(th_rule((fn(x96 : (@kernel.Term, ((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise)) -> @kernel.Thm raise {
    @tactics.prove(x96.0, x96.1)
  })(t109)))
}

///|
let log_reduce_simple_low_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("log_reduce_simple_low")

///|
/// `log_reduce_simple_low` (not in the signature of its module)
pub fn log_reduce_simple_low() -> @kernel.Thm {
  log_reduce_simple_low_c.get()
}

///|
/// `float_log_hi`
pub fn float_log_hi(x110 : Int64, x111 : @kernel.Term) -> @kernel.Thm raise {
  let pp = x110
  let x_tm = x111
  let pp_1 = @lib.add63(pp, 1L)
  let x_gt0 = @bool.eqt_elim(@arith_float.float_gt0_v1(x_tm))
  let f = @lib.float_log(@more_float.float_of_float_tm(x_tm))
  let b_tm = @more_float.float_tm_of_float(pp_1)(f)
  let exp_lo = @exp_eval.float_exp_lo(pp_1, b_tm)
  let t_tm = @kernel.rand(@kernel.rator(@kernel.concl(exp_lo)))
  let t_gt0 = @bool.eqt_elim(@arith_float.float_gt0_v1(t_tm))
  let xt_le_r = @arith_float.float_div_hi_v1(pp_1)(x_tm)(t_tm)
  let r_tm = @kernel.rand(@kernel.concl(xt_le_r))
  let r1_le_a = @arith_float.float_sub_hi_v1(pp_1)(r_tm)(@more_float.one_float())
  let a_tm = @kernel.rand(@kernel.concl(r1_le_a))
  let ab_le_high = @arith_float.float_add_hi_v1(pp_1)(a_tm)(b_tm)
  let high_tm = @kernel.rand(@kernel.concl(ab_le_high))
  let th0 = @kernel.inst_rule(@list.List([(x_tm, @misc_vars.x_var_real()), (x_tm, @misc_vars.x_var_real()), (t_tm, @misc_vars.t_var_real()), (r_tm, @misc_vars.r_var_real()), (b_tm, @misc_vars.b_var_real()), (a_tm, @misc_vars.a_var_real()), (high_tm, @misc_vars.high_var_real())]), log_reduce_simple_high())
  @lib.itlist(@misc_functions.my_prove_hyp, @list.List([exp_lo, xt_le_r, r1_le_a, ab_le_high, x_gt0, t_gt0]), th0)
}

///|
/// `float_log_lo`
pub fn float_log_lo(x112 : Int64, x113 : @kernel.Term) -> @kernel.Thm raise {
  let pp = x112
  let x_tm = x113
  let x_gt0 = @bool.eqt_elim(@arith_float.float_gt0_v1(x_tm))
  let inv_x = @more_float.float_inv_hi(@lib.add63(pp, 1L))(x_tm)
  let t_tm = @kernel.rand(@kernel.concl(inv_x))
  let log_t = float_log_hi(pp, t_tm)
  let r_tm = @kernel.rand(@kernel.concl(log_t))
  let low_eq = @more_float.float_neg(r_tm)
  let low_tm = @kernel.rand(@kernel.rator(@kernel.concl(low_eq)))
  let th0 = @kernel.inst_rule(@list.List([(x_tm, @misc_vars.x_var_real()), (t_tm, @misc_vars.t_var_real()), (r_tm, @misc_vars.r_var_real()), (low_tm, @misc_vars.low_var_real())]), log_reduce_simple_low())
  @lib.itlist(@misc_functions.my_prove_hyp, @list.List([inv_x, log_t, low_eq, x_gt0]), th0)
}

///|
/// `float_interval_log`
pub fn float_interval_log(x114 : Int64, x115 : @kernel.Thm) -> @kernel.Thm raise {
  let pp = x114
  let x_th = x115
  let (x_tm, a_tm, b_tm) = @arith_float.dest_float_interval(@kernel.concl(x_th))
  let a_gt0 = @bool.eqt_elim(@arith_float.float_gt0_v1(a_tm))
  let log_lo = float_log_lo(pp, a_tm)
  let log_hi = float_log_hi(pp, b_tm)
  let lo_tm = @kernel.rand(@kernel.rator(@kernel.concl(log_lo)))
  let hi_tm = @kernel.rand(@kernel.concl(log_hi))
  let th0 = @kernel.inst_rule(@list.List([(x_tm, @misc_vars.x_var_real()), (a_tm, @misc_vars.a_var_real()), (b_tm, @misc_vars.b_var_real()), (lo_tm, @misc_vars.lo_var_real()), (hi_tm, @misc_vars.hi_var_real())]), log_interval())
  @lib.itlist(@misc_functions.my_prove_hyp, @list.List([x_th, log_lo, log_hi, a_gt0]), th0)
}

