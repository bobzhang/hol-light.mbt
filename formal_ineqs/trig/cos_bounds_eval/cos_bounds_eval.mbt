        @kernel.inst_rule(@list.List([(x_tm, @misc_vars.x_var_real())]), cos_low_trivial())
      } else {
        let th0 = @kernel.inst_rule(@list.List([(a_tm, @misc_vars.a_var_real()), (b_tm, @misc_vars.b_var_real()), (m_tm, @misc_vars.m_var_real()), (n_tm, @misc_vars.n_var_real()), (r_tm, @misc_vars.r_var_real()), (x_tm, @misc_vars.x_var_real())]), bound_th)
        @lib.itlist(@misc_functions.my_prove_hyp, @list.List([p1_low_th, p2_high_th, x_pow2_high, mb_le_n, r_le_an]), th0)
      }
    }
  })
}

