// Formal_ineqs/trig/exp_eval.ml: the load steps are generated (exp_eval.mbt).

///|
let loaded : Ref[Bool] = Ref::{ val: false, }

///|
/// Load Formal_ineqs/trig/exp_eval.ml (once), after the files it needs.
pub fn load() -> Unit {
  if loaded.val {
    return
  }
  loaded.val = true
  @poly_eval.load()
  @exp_log.load()
  @poly_eval.load()
  @float_pow.load()
  @parser.begin_theory("Formal_ineqs/trig/exp_eval")
  load_steps() catch {
    e =>
      abort(
        "HOL Light: loading Formal_ineqs/trig/exp_eval.ml failed: " +
        e.to_string(),
      )
  }
  @parser.end_theory()
}

///|
/// Load Formal_ineqs/trig/exp_eval.ml (once) as `needs` does: after what it needs itself, not
/// after the files its directory's make.ml loads before it.
pub fn load_alone() -> Unit {
  if loaded.val {
    return
  }
  loaded.val = true
  @exp_log.load()
  @poly_eval.load()
  @float_pow.load()
  @parser.begin_theory("Formal_ineqs/trig/exp_eval")
  load_steps() catch {
    e =>
      abort(
        "HOL Light: loading Formal_ineqs/trig/exp_eval.ml failed: " +
        e.to_string(),
      )
  }
  @parser.end_theory()
}
