}

///|
/// `x_pow_over_fact`
pub fn x_pow_over_fact(x143 : Double, x144 : Int64) -> Double raise {
  let x = x143
  let k = x144
  if (k <= 0L) {
    1.0
  } else {
    let t145 = x_pow_over_fact(x, @lib.sub63(k, 1L))
    ((x / Int64::to_double(k)) * t145)
  }
}

///|
/// `n_of_p_exp`
pub fn n_of_p_exp(x146 : Double, x147 : Int64, x148 : (Int64) -> Bool raise) -> Int64 raise {
  let x = x146
  let pp = x147
  let cond = x148
  let t149 = Int64::to_double(@lib.sub63(@lib.neg63(pp), 1L))
  let t = @lib.float_pow(Int64::to_double(@arith_num.arith_base()), t149)
  fn try_i(x150 : Int64) -> Int64 raise {
    let i = x150
    let _ = if (i > 50L) {
      raise Failure("n_of_p_exp: cannot find i")
    } else {
      ()
    }
    if cond(i) {
      let r = x_pow_over_fact(x, i)
      if (@lib.compare(r, t) <= 0) {
        i
      } else {
        try_i(@lib.add63(i, 1L))
      }
    } else {
      try_i(@lib.add63(i, 1L))
    }
  }
  try_i(0L)
}

