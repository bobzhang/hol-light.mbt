      let n = x137
      let n_tm = @nums.mk_small_numeral(n)
      let th0 = @kernel.inst_rule(@list.List([(n_tm, @misc_vars.n_var_num())]), exp_bound)
      let th1 = @equal.conv_rule(@calc_num.num_reduce_conv, th0)
      let poly_tms0 = find_poly_f(@kernel.concl(th1))
      let t138 = @equal.redepth_conv(@calc_num.num_conv)
      let ns_th = @lib.map(fn(x141 : @kernel.Term) -> @kernel.Thm raise {
        (fn(x140 : @kernel.Term) -> @kernel.Thm raise {
          (fn(x139 : @kernel.Term) -> @kernel.Thm raise {
            t138(@kernel.rand(x139))
          })(@kernel.rand(x140))
        })(@kernel.rator(x141))
      }, poly_tms0)
      let th2 = @simp.rewrite_rule(ns_th.concat(@list.List([@more_list.table_suc(), @more_list.table_0(), @lists.append()])))(th1)
      let bound_th = reduce_rule(th2)
      let poly_tms = find_poly_f(@kernel.concl(bound_th))
      let cs_tms = @lib.map(fn(x142 : @kernel.Term) -> @kernel.Term raise {
        @kernel.rand(@kernel.rator(x142))
      }, poly_tms)
      let cs_lists = @lib.map(@poly_eval.mk_poly_coeffs(pp), cs_tms)
