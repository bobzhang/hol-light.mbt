  let exp_bound = (fn(x127 : @kernel.Thm) -> @kernel.Thm raise {
    (fn(x125 : @kernel.Thm) -> @kernel.Thm raise {
      @bool.spec_all(t124(x125))
    })(t126(x127))
  })(t128(exp_bound_th))
  let t129 = @equal.depth_conv(@equal.first_conv(@list.List([@calc_num.num_suc_conv, @calc_num.num_add_conv, @calc_num.num_mult_conv])))
  let reduce_rule : (@kernel.Thm) -> @kernel.Thm raise = (x130 : @kernel.Thm) => @equal.conv_rule(t129, x130)
  let find_poly_f : (@kernel.Term) -> @list.List[@kernel.Term] raise = fn(x135 : @kernel.Term) -> @list.List[@kernel.Term] raise {
    (fn(x131 : @list.List[@kernel.Term]) -> @list.List[@kernel.Term] raise {
      @lib.rev(x131)
    })(((x134 : @kernel.Term) => @basics.find_terms(fn(x132 : @kernel.Term) -> Bool raise {
      let tm = x132
      try {
        let t133 = @parser.parse_term("poly_f")
        (@kernel.rator(@kernel.rator(tm)) == t133)
      } catch {
        Failure(_) => false
        e => raise e
      }
    }, x134))(x135))
  }
  fn(x136 : Int64) -> ((Int64) -> (@kernel.Thm, @list.List[(@kernel.Term, @list.List[@poly_eval.PolyCoeff])]) raise) raise {
    let pp = x136
