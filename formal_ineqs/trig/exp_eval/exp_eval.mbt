      let th0 = @kernel.inst_rule(@list.List([(tm, @misc_vars.x_var_real()), (hi_tm, @misc_vars.hi_var_real())]), div_lemma)
      @misc_functions.my_prove_hyp(div_th, th0)
    }
  })
}

///|
let float_inv_hi_c : @lib.Cell[(Int64) -> ((@kernel.Term) -> @kernel.Thm raise) raise] = @lib.Cell::new("float_inv_hi")

///|
/// `float_inv_hi`
pub fn float_inv_hi(x : Int64) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
  (float_inv_hi_c.get())(x)
}

///|
/// `float_exp_low_raw`
pub fn float_exp_low_raw(x209 : Int64, x210 : @kernel.Term) -> @kernel.Thm raise {
  let pp = x209
  let x_tm = x210
  try {
    let (s, n_tm, e_tm) = @arith_float.dest_float(x_tm)
    if (s == "F") {
      float_exp_pos_low_raw(pp)(x_tm)
    } else {
      let x_pos = @arith_float.make_float("F")(n_tm)(e_tm)
      let low_th = float_exp_neg_low_raw(pp)(x_pos)
      let r_tm = @kernel.rand(@kernel.rator(@kernel.concl(low_th)))
      let th0 = @kernel.inst_rule(@list.List([(r_tm, @misc_vars.r_var_real()), (n_tm, @misc_vars.n_var_num()), (e_tm, @misc_vars.e_var_num())]), exp_neg_low())
      @misc_functions.my_prove_hyp(low_th, th0)
    }
  } catch {
    Failure(msg) => @misc_functions.error(("float_exp_low_raw: " + msg), @list.List([x_tm]), @list.empty())
    e => raise e
  }
}

///|
/// `float_exp_high_raw`
pub fn float_exp_high_raw(x211 : Int64, x212 : @kernel.Term) -> @kernel.Thm raise {
  let pp = x211
  let x_tm = x212
  try {
    let (s, n_tm, e_tm) = @arith_float.dest_float(x_tm)
    if (s == "F") {
      let low_th = float_exp_neg_low_raw(pp)(x_tm)
      let t_tm = @kernel.rand(@kernel.rator(@kernel.concl(low_th)))
      let t_pos = @bool.eqt_elim(@arith_float.float_gt0_v1(t_tm))
      let inv_t = float_inv_hi(pp)(t_tm)
      let r_tm = @kernel.rand(@kernel.concl(inv_t))
      let th0 = @kernel.inst_rule(@list.List([(t_tm, @misc_vars.t_var_real()), (r_tm, @misc_vars.r_var_real()), (x_tm, @misc_vars.x_var_real())]), exp_pos_high())
      @misc_functions.my_prove_hyp(t_pos, @misc_functions.my_prove_hyp(low_th, @misc_functions.my_prove_hyp(inv_t, th0)))
    } else {
      let x_pos = @arith_float.make_float("F")(n_tm)(e_tm)
      let high_th = float_exp_neg_high_raw(pp)(x_pos)
      let r_tm_1 = @kernel.rand(@kernel.concl(high_th))
      let th0_1 = @kernel.inst_rule(@list.List([(r_tm_1, @misc_vars.r_var_real()), (n_tm, @misc_vars.n_var_num()), (e_tm, @misc_vars.e_var_num())]), exp_neg_high())
      @misc_functions.my_prove_hyp(high_th, th0_1)
    }
  } catch {
    Failure(msg) => @misc_functions.error(("float_exp_high_raw: " + msg), @list.List([x_tm]), @list.empty())
    e => raise e
  }
}

///|
/// `raw_num_to_numeral`
pub fn raw_num_to_numeral(x213 : @kernel.Term) -> @kernel.Thm raise {
  let tm = x213
  let th0 = @kernel.inst_rule(@list.List([(tm, @misc_vars.n_var_num())]), @equal.sym(@arith_num.num_thm()))
  let th1 = @arith_nat.num_to_numeral_conv(@kernel.mk_comb(@arith_num.num_const(), tm))
  @kernel.trans(th0, th1)
}

///|
/// mk_float_eq
fn step_17() -> Unit raise {
  let t215 = @simp.rewrite_rule(@list.List([@float_theory.min_exp_def()]))
  let eq_lemma = (fn(x216 : @kernel.Thm) -> @kernel.Thm raise {
    (fn(x214 : @kernel.Thm) -> @kernel.Thm raise {
      @equal.sym(@arith_nat.numerals_to_num(x214))
    })(t215(x216))
  })(@bool.spec_all(@float_theory.float_of_num()))
  let inj = @parser.parse_term("(&):num->real")
  mk_float_eq_c.set(fn(x217 : Int64) -> @kernel.Thm raise {
    let n = x217
    let th0 = @kernel.inst_rule(@list.List([(@kernel.rand(@arith_nat.mk_small_numeral_array(n)), @misc_vars.n_var_num())]), eq_lemma)
    let th1 = raw_num_to_numeral(@kernel.rand(@kernel.rand(@kernel.concl(th0))))
    @kernel.trans(th0, @equal.ap_term(inj, th1))
  })
}

///|
let mk_float_eq_c : @lib.Cell[(Int64) -> @kernel.Thm raise] = @lib.Cell::new("mk_float_eq")

///|
/// `mk_float_eq`
pub fn mk_float_eq(x : Int64) -> @kernel.Thm raise {
  (mk_float_eq_c.get())(x)
}

///|
/// `reduce_float`
pub fn reduce_float(x218 : @kernel.Term) -> ((Bool, Int64, @kernel.Thm)) raise {
  let x_tm = x218
  let f = Double::abs(@more_float.float_of_float_tm(x_tm))
  if (@lib.compare(f, exp_max_x()) <= 0) {
    (false, 0L, @bool.truth())
  } else {
    let k = @lib.add63(@lib.norm63(Double::to_int64(Double::floor((f / exp_max_x())))), 1L)
    (true, k, mk_float_eq(k))
  }
}

///|
/// `float_exp_hi`
pub fn float_exp_hi(x219 : Int64, x220 : @kernel.Term) -> @kernel.Thm raise {
  let pp = x219
  let x_tm = x220
  let (flag, k, k_eq) = reduce_float(x_tm)
  if !flag {
    float_exp_high_raw(pp, x_tm)
  } else {
    let (ltm, rtm) = @kernel.dest_comb(@kernel.concl(k_eq))
    let k_tm = @kernel.rand(rtm)
    let t_tm = @kernel.rand(ltm)
    let t_gt0 = @bool.eqt_elim(@arith_float.float_gt0_v1(t_tm))
    let div_th = @arith_float.float_div_hi_v1(@lib.add63(pp, 1L))(x_tm)(t_tm)
    let y_tm = @kernel.rand(@kernel.concl(div_th))
    let exp_y = float_exp_high_raw(@lib.add63(pp, 1L), y_tm)
    let hi_tm = @kernel.rand(@kernel.concl(exp_y))
    let hi_pow = @float_pow.float_pow_hi(pp, k, hi_tm)
    let high_tm = @kernel.rand(@kernel.concl(hi_pow))
    let th0 = @kernel.inst_rule(@list.List([(t_tm, @misc_vars.t_var_real()), (k_tm, @misc_vars.k_var_num()), (y_tm, @misc_vars.y_var_real()), (hi_tm, @misc_vars.hi_var_real()), (high_tm, @misc_vars.high_var_real()), (x_tm, @misc_vars.x_var_real())]), exp_reduce_high())
    @lib.itlist(@misc_functions.my_prove_hyp, @list.List([t_gt0, k_eq, div_th, exp_y, hi_pow]), th0)
  }
}

///|
/// `float_exp_lo`
pub fn float_exp_lo(x221 : Int64, x222 : @kernel.Term) -> @kernel.Thm raise {
  let pp = x221
  let x_tm = x222
  let (flag, k, k_eq) = reduce_float(x_tm)
  if !flag {
    float_exp_low_raw(pp, x_tm)
  } else {
    let (ltm, rtm) = @kernel.dest_comb(@kernel.concl(k_eq))
    let k_tm = @kernel.rand(rtm)
    let t_tm = @kernel.rand(ltm)
    let t_gt0 = @bool.eqt_elim(@arith_float.float_gt0_v1(t_tm))
    let div_th = @arith_float.float_div_lo_v1(@lib.add63(pp, 1L))(x_tm)(t_tm)
    let y_tm = @kernel.rand(@kernel.rator(@kernel.concl(div_th)))
    let exp_y = float_exp_low_raw(@lib.add63(pp, 1L), y_tm)
    let lo_tm = @kernel.rand(@kernel.rator(@kernel.concl(exp_y)))
    let lo_pow = @float_pow.float_pow_lo(pp, k, lo_tm)
    let low_tm = @kernel.rand(@kernel.rator(@kernel.concl(lo_pow)))
    let lo_ge0 = @bool.eqt_elim(@arith_float.float_ge0_v1(lo_tm))
    let th0 = @kernel.inst_rule(@list.List([(t_tm, @misc_vars.t_var_real()), (k_tm, @misc_vars.k_var_num()), (y_tm, @misc_vars.y_var_real()), (lo_tm, @misc_vars.lo_var_real()), (low_tm, @misc_vars.low_var_real()), (x_tm, @misc_vars.x_var_real())]), exp_reduce_low())
    @lib.itlist(@misc_functions.my_prove_hyp, @list.List([t_gt0, k_eq, div_th, exp_y, lo_pow, lo_ge0]), th0)
  }
}

///|
/// `float_interval_exp`
pub fn float_interval_exp(x223 : Int64, x224 : @kernel.Thm) -> @kernel.Thm raise {
  let pp = x223
  let x_th = x224
  let (x_tm, a_tm, b_tm) = @arith_float.dest_float_interval(@kernel.concl(x_th))
  let exp_lo = float_exp_lo(pp, a_tm)
  let exp_hi = float_exp_hi(pp, b_tm)
  let lo_tm = @kernel.rand(@kernel.rator(@kernel.concl(exp_lo)))
  let hi_tm = @kernel.rand(@kernel.concl(exp_hi))
  let th0 = @kernel.inst_rule(@list.List([(x_tm, @misc_vars.x_var_real()), (a_tm, @misc_vars.a_var_real()), (b_tm, @misc_vars.b_var_real()), (lo_tm, @misc_vars.lo_var_real()), (hi_tm, @misc_vars.hi_var_real())]), exp_interval())
  @misc_functions.my_prove_hyp(x_th, @misc_functions.my_prove_hyp(exp_lo, @misc_functions.my_prove_hyp(exp_hi, th0)))
}

