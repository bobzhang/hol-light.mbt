  let pi = @lib.array_init(19L, fn(x281 : Int64) -> @kernel.Thm raise {
    let i = x281
    @arith_float.float_interval_round(i, float_interval_pi)
  })
  let pi2 = @lib.array_init(19L, fn(x282 : Int64) -> @kernel.Thm raise {
    let i_1 = x282
    @arith_float.float_interval_round(i_1, float_interval_pi2)
  })
  let (pi_approx_array, pi2_approx_array) = (pi, pi2)
  pi_approx_array_c.set(pi_approx_array)
  pi2_approx_array_c.set(pi2_approx_array)
}

