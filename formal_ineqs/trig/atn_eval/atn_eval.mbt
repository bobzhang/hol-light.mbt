///|
/// `eval_halfatn_pos_hi`
pub fn eval_halfatn_pos_hi(x205 : Int64, x206 : @kernel.Thm) -> @kernel.Thm raise {
  let pp = x205
  let x_th = x206
  let (x_tm, bounds) = @interval_arith.dest_interval_arith(@kernel.concl(x_th))
  let t_tm = @kernel.rand(bounds)
  let tt_th = @arith_float.float_mul_lo_v1(pp)(t_tm)(t_tm)
  let a_tm = @equal.lhand(@kernel.concl(tt_th))
  let a1_th = @arith_float.float_add_lo_v1(pp)(@more_float.one_float())(a_tm)
  let b_tm = @equal.lhand(@kernel.concl(a1_th))
  let sqrt_th = @arith_float.float_sqrt_lo_v1(pp)(b_tm)
  let c_tm = @equal.lhand(@kernel.concl(sqrt_th))
  let c1_th = @arith_float.float_add_lo_v1(pp)(c_tm)(@more_float.one_float())
  let f_tm = @equal.lhand(@kernel.concl(c1_th))
  let (s, n1_tm, e1_tm) = @arith_float.dest_float(f_tm)
  let _ = if (s != "F") {
    raise Failure(("eval_halfatn_pos_hi: s <> F: " + @printer.string_of_term(@kernel.concl(x_th))))
  } else {
    ()
  }
  let div_th = @arith_float.float_div_hi_v1(pp)(t_tm)(f_tm)
  let hi_tm = @kernel.rand(@kernel.concl(div_th))
  let n1_not0 = @arith_nat.raw_eq0_hash_conv(n1_tm)
  let _ = if (@kernel.dest_const(@kernel.rand(@kernel.concl(n1_not0))).0 == "T") {
    raise Failure(("eval_halfatn_pos_hi: n1 = 0: " + @printer.string_of_term(@kernel.concl(x_th))))
  } else {
    ()
  }
  let th0 = @kernel.inst_rule(@list.List([(x_tm, @misc_vars.x_var_real()), (t_tm, @misc_vars.t_var_real()), (hi_tm, @misc_vars.hi_var_real()), (a_tm, @misc_vars.a_var_real()), (b_tm, @misc_vars.b_var_real()), (c_tm, @misc_vars.c_var_real()), (n1_tm, @misc_vars.n1_var_num()), (e1_tm, @misc_vars.e1_var_num())]), halfatn_pos_hi_th())
  @lib.itlist(@misc_functions.my_prove_hyp, @list.List([tt_th, a1_th, sqrt_th, c1_th, n1_not0, div_th, x_th]), th0)
}

