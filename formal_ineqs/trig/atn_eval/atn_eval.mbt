///|
/// `n_of_p_atn`
pub fn n_of_p_atn(x239 : Double, x240 : Int64, x241 : (Int64) -> Bool raise) -> Int64 raise {
  let x = x239
  let pp = x240
  let cond = x241
  let t242 = Int64::to_double(@lib.sub63(@lib.neg63(pp), 1L))
  let t = @lib.float_pow(Int64::to_double(@arith_num.arith_base()), t242)
  fn try_i(x243 : Int64) -> Int64 raise {
    let i = x243
    let _ = if (i > 50L) {
      raise Failure("n_of_p_atn: cannot find i")
    } else {
      ()
    }
    if cond(i) {
      let d = Int64::to_double(@lib.add63(@lib.mul63(2L, i), 1L))
      let r = (@lib.float_pow(x, d) / d)
      if (@lib.compare(r, t) <= 0) {
        i
      } else {
        try_i(@lib.add63(i, 1L))
      }
    } else {
      try_i(@lib.add63(i, 1L))
    }
  }
  try_i(0L)
}

