// Formal_ineqs/trig/series.ml: the load steps are generated (series.mbt).

///|
let loaded : Ref[Bool] = Ref::{ val: false, }

///|
/// Load Formal_ineqs/trig/series.ml (once), after the files it needs.
pub fn load() -> Unit {
  if loaded.val {
    return
  }
  loaded.val = true
  @float_pow.load()
  @realanalysis.load()
  @parser.begin_theory("Formal_ineqs/trig/series")
  load_steps() catch {
    e =>
      abort(
        "HOL Light: loading Formal_ineqs/trig/series.ml failed: " +
        e.to_string(),
      )
  }
  @parser.end_theory()
}

///|
/// Load Formal_ineqs/trig/series.ml (once) as `needs` does: after what it needs itself, not
/// after the files its directory's make.ml loads before it.
pub fn load_alone() -> Unit {
  if loaded.val {
    return
  }
  loaded.val = true
  @realanalysis.load()
  @parser.begin_theory("Formal_ineqs/trig/series")
  load_steps() catch {
    e =>
      abort(
        "HOL Light: loading Formal_ineqs/trig/series.ml failed: " +
        e.to_string(),
      )
  }
  @parser.end_theory()
}
