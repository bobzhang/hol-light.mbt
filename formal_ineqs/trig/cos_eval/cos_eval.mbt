      let red_th_2 = correct_ab(red_th_1)(a_tm)(b_tm)(a1_tm_2)(b1_tm_2)(a1_le0)(b1_le0)
      let inst_tms = @list.List([(x_tm, @misc_vars.x_var_real()), (a_tm, @misc_vars.a_var_real()), (b_tm, @misc_vars.b_var_real()), (a1_tm_2, @misc_vars.a1_var_real()), (b1_tm_2, @misc_vars.b1_var_real())])
