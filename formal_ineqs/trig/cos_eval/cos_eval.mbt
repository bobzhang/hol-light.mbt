///|
/// `get_i`
pub fn get_i(x503 : @kernel.Term) -> Int64 raise {
  let f_tm = x503
  let x = @more_float.float_of_float_tm(f_tm)
  let k0 = @lib.neg63(@lib.norm63(Double::to_int64((x / f_2_pi()))))
  let y = (x + (Int64::to_double(k0) * f_2_pi()))
  if (@lib.compare(y, @lib.float_neg(f_pi())) < 0) {
    @lib.add63(k0, 1L)
  } else {
    if (@lib.compare(y, f_pi()) > 0) {
      @lib.sub63(k0, 1L)
    } else {
      k0
    }
  }
}

