///|
/// `eval_high_0_pi`
pub fn eval_high_0_pi(x473 : Int64, x474 : @kernel.Thm, x475 : @kernel.Term) -> @kernel.Thm raise {
  let pp = x473
  let x_0_pi = x474
  let x_tm = x475
  let pi2_th = @lib.array_get(@atn_eval.pi2_approx_array(), @lib.int63_to_int(pp))
  let (flag, ge_pi2) = @arith_float.float_prove_ge_interval(x_tm)(pi2_th)
  if !flag {
    @cos_bounds_eval.float_cos_high_raw(pp)(x_tm)
  } else {
    let pi_th = @lib.array_get(@atn_eval.pi_approx_array(), @lib.int63_to_int(pp))
    let bounds = @kernel.rand(@kernel.concl(pi_th))
    let (ltm, hi_tm) = @kernel.dest_comb(bounds)
    let lo_tm = @kernel.rand(ltm)
    let hi_sub_x = @arith_float.float_sub_hi_v1(pp)(hi_tm)(x_tm)
    let t_tm = @kernel.rand(@kernel.concl(hi_sub_x))
    let (flag_1, t_le_pi) = @arith_float.float_prove_le_interval(t_tm)(pi_th)
    if !flag_1 {
      @kernel.inst_rule(@list.List([(x_tm, @misc_vars.x_var_real())]), cos_high_trivial())
    } else {
      let cos_t = @cos_bounds_eval.float_cos_low_raw(pp)(t_tm)
      let r_tm = @kernel.rand(@kernel.rator(@kernel.concl(cos_t)))
