///|
/// `get_all`
pub fn get_all(x202 : @kernel.Thm) -> @list.List[@kernel.Thm] raise {
  let th = x202
  let (ltm, list_tm) = @kernel.dest_comb(@kernel.concl(th))
  let p_tm = @kernel.rand(ltm)
  let list_ty = @kernel.type_of(list_tm)
  let p_ty = @kernel.type_of(p_tm)
  let ty = (fn(x204 : (String, @list.List[@kernel.HolType])) -> @kernel.HolType raise {
    @lib.hd((fn(x203 : (String, @list.List[@kernel.HolType])) -> @list.List[@kernel.HolType] raise {
      x203.1
    })(x204))
  })(@kernel.dest_type(list_ty))
  let p_var = @kernel.mk_var("P", p_ty)
  let h_var = @kernel.mk_var("h", ty)
  let t_var = @kernel.mk_var("t", list_ty)
  let inst_t : (@kernel.Thm) -> @kernel.Thm raise = fn(x208 : @kernel.Thm) -> @kernel.Thm raise {
    ((x205 : @kernel.Thm) => @kernel.inst_rule(@list.List([(p_tm, p_var)]), x205))((fn(x207 : @kernel.Thm) -> @kernel.Thm raise {
      ((x206 : @kernel.Thm) => @kernel.inst_type(@list.List([(ty, @kernel.aty)]), x206))(x207)
    })(x208))
  }
  let t209 = inst_t(all_a_tl())
  let (all_hd, all_tl) = (inst_t(all_a_hd()), t209)
  fn get_all_raw(x210 : @kernel.Thm, x211 : @kernel.Term) -> @list.List[@kernel.Thm] raise {
    let all_th = x210
    let list_tm_1 = x211
    if @kernel.is_comb(list_tm_1) {
      let (h_tm_p, t_tm) = @kernel.dest_comb(list_tm_1)
      let h_tm = @kernel.rand(h_tm_p)
      let inst_t_1 : (@kernel.Thm) -> @kernel.Thm raise = (x212 : @kernel.Thm) => @kernel.inst_rule(@list.List([(h_tm, h_var), (t_tm, t_var)]), x212)
      let th_tl = @misc_functions.my_prove_hyp(all_th, inst_t_1(all_tl))
      let th_hd = @misc_functions.my_prove_hyp(all_th, inst_t_1(all_hd))
      get_all_raw(th_tl, t_tm).prepend(th_hd)
    } else {
      @list.empty()
    }
  }
  get_all_raw(th, list_tm)
}

///|
/// `select_all`
pub fn select_all(x213 : @kernel.Thm, x214 : @list.List[Int64]) -> @list.List[@kernel.Thm] raise {
  let th = x213
  let indices = x214
  let (ltm, list_tm) = @kernel.dest_comb(@kernel.concl(th))
  let p_tm = @kernel.rand(ltm)
  let list_ty = @kernel.type_of(list_tm)
  let p_ty = @kernel.type_of(p_tm)
  let ty = (fn(x216 : (String, @list.List[@kernel.HolType])) -> @kernel.HolType raise {
    @lib.hd((fn(x215 : (String, @list.List[@kernel.HolType])) -> @list.List[@kernel.HolType] raise {
      x215.1
    })(x216))
  })(@kernel.dest_type(list_ty))
  let p_var = @kernel.mk_var("P", p_ty)
  let h_var = @kernel.mk_var("h", ty)
  let t_var = @kernel.mk_var("t", list_ty)
  let inst_t : (@kernel.Thm) -> @kernel.Thm raise = fn(x220 : @kernel.Thm) -> @kernel.Thm raise {
    ((x217 : @kernel.Thm) => @kernel.inst_rule(@list.List([(p_tm, p_var)]), x217))((fn(x219 : @kernel.Thm) -> @kernel.Thm raise {
      ((x218 : @kernel.Thm) => @kernel.inst_type(@list.List([(ty, @kernel.aty)]), x218))(x219)
    })(x220))
  }
  let t221 = inst_t(all_a_tl())
  let (all_hd, all_tl) = (inst_t(all_a_hd()), t221)
  fn get_all_raw(x222 : @kernel.Thm, x223 : @kernel.Term, x224 : @list.List[Int64], x225 : Int64) -> @list.List[@kernel.Thm] raise {
    let all_th = x222
    let list_tm_1 = x223
    let indices_1 = x224
    let n = x225
    match indices_1 {
      Empty => @list.empty()
      More(i, tail=is_) => {
        let (h_tm_p, t_tm) = @kernel.dest_comb(list_tm_1)
        let h_tm = @kernel.rand(h_tm_p)
        let inst_t_1 : (@kernel.Thm) -> @kernel.Thm raise = (x226 : @kernel.Thm) => @kernel.inst_rule(@list.List([(h_tm, h_var), (t_tm, t_var)]), x226)
        let th_tl = @misc_functions.my_prove_hyp(all_th, inst_t_1(all_tl))
        if (@lib.sub63(i, n) == 0L) {
          let th_hd = @misc_functions.my_prove_hyp(all_th, inst_t_1(all_hd))
          get_all_raw(th_tl, t_tm, is_, @lib.add63(n, 1L)).prepend(th_hd)
        } else {
          get_all_raw(th_tl, t_tm, is_.prepend(i), @lib.add63(n, 1L))
        }
      }
    }
  }
  get_all_raw(th, list_tm, indices, 0L)
}

