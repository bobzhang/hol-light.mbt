pub fn set_of_list_conv(x230 : @kernel.Term) -> @kernel.Thm raise {
  let tm = x230
  let list_tm = @kernel.rand(tm)
  let list_ty = @kernel.type_of(list_tm)
  let ty = (fn(x232 : (String, @list.List[@kernel.HolType])) -> @kernel.HolType raise {
