  let t_var = @kernel.mk_var("t", list_ty)
  let inst_t : (@kernel.Thm) -> @kernel.Thm raise = fn(x234 : @kernel.Thm) -> @kernel.Thm raise {
    ((x233 : @kernel.Thm) => @kernel.inst_type(@list.List([(ty, @kernel.aty)]), x233))(x234)
  }
  let t235 = inst_t(set_of_list_a_cons())
  let (set_of_list_h, set_of_list_cons) = (inst_t(set_of_list_a_h()), t235)
  fn set_of_list_conv_raw(x236 : @kernel.Term, x237 : @kernel.Term) -> @kernel.Thm raise {
    let h_tm = x236
