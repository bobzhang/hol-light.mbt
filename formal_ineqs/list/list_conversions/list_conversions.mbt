      let (ltm, rtm) = @kernel.dest_comb(@kernel.rand(@kernel.concl(th0)))
      @kernel.trans(th0, @equal.ap_term(ltm, set_of_list_conv_raw(@kernel.rand(h_tm_p), t_tm_p)))
    } else {
      @kernel.inst_rule(@list.List([(h_tm, h_var)]), set_of_list_h)
    }
  }
  if @kernel.is_comb(list_tm) {
    let (h_tm_1, t_tm_1) = @kernel.dest_comb(list_tm)
    set_of_list_conv_raw(@kernel.rand(h_tm_1), t_tm_1)
  } else {
    inst_t(set_of_list_a_empty())
  }
}

