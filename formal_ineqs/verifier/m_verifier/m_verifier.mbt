    let th_1 = x407
    let (ltm_1, acc_tm_1) = (fn(x409 : @kernel.Term) -> (@kernel.Term, @kernel.Term) raise {
      (fn(x408 : @kernel.Term) -> (@kernel.Term, @kernel.Term) raise {
        @kernel.dest_comb(@kernel.rand(x408))
      })(@kernel.rator(x409))
    })((fn(x410 : @kernel.Thm) -> @kernel.Term raise {
      @kernel.concl(x410)
