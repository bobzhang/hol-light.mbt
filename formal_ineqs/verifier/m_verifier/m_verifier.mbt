  let r : (@kernel.Thm) -> @kernel.Thm raise = (x395 : @kernel.Thm) => @m_taylor.inst_first_type_var(t394, x395)
  let t396 = r(cell_list_pass_move2())
  let t397 = r(cell_list_pass_move1())
