///|
/// `gen_restrict_lemma`
pub fn gen_restrict_lemma(x141 : Int64, x142 : Int64, x143 : Bool) -> @kernel.Thm raise {
  let n = x141
  let j = x142
  let left_flag = x143
  let xs = mk_real_vars(n, "x")
  let zs = mk_real_vars(n, "z")
  let ys = mk_real_vars(n, "y")
  let ws = mk_real_vars(n, "w")
  let j_tm = @nums.mk_small_numeral(j)
  let (a, b) = if left_flag {
    (zs, xs)
  } else {
    (xs, zs)
  }
  let x_tm = @m_taylor.mk_vector_list(xs)
  let z_tm = @m_taylor.mk_vector_list(zs)
  let y_tm = @m_taylor.mk_vector_list(ys)
  let w_tm = @m_taylor.mk_vector_list(ws)
  let u_tm = @m_taylor.mk_vector_list(@lib.map(fn(x144 : Int64) -> @kernel.Term raise {
    let i = x144
    let t145 = @lib.int63_to_int(@lib.sub63(i, 1L))
    @lib.list_nth(if (i == j) {
      b
    } else {
      a
    }, t145)
  }, @lib.range(1L, n)))
  let y_p_tm = @m_taylor.mk_vector_list(@lib.map(fn(x146 : Int64) -> @kernel.Term raise {
    let i_1 = x146
    let t147 = @lib.int63_to_int(@lib.sub63(i_1, 1L))
    @lib.list_nth(if (i_1 == j) {
      b
    } else {
      ys
    }, t147)
  }, @lib.range(1L, n)))
  let w_p_tm = @m_taylor.mk_vector_list(@lib.map(fn(x148 : Int64) -> @kernel.Term raise {
    let i_2 = x148
    if (i_2 == j) {
      @parser.parse_term("&0")
    } else {
      @lib.list_nth(ws, @lib.int63_to_int(@lib.sub63(i_2, 1L)))
    }
  }, @lib.range(1L, n)))
  let t150 = if left_flag {
    m_restrict_left_lemma()
  } else {
    m_restrict_right_lemma()
  }
  let th0 = @bool.spec_all(((x149 : @kernel.Thm) => @bool.ispecl(@list.List([j_tm, x_tm, z_tm, y_tm, w_tm, u_tm, y_p_tm, w_p_tm]), x149))(t150))
  let t151 = @m_taylor.gen_in_interval(n)
  let th1 = @simp.rewrite_rule(@list.List([@lib.array_get(@m_taylor.dimindex_array(), @lib.int63_to_int(n)), @iterate.in_numseg(), t151, @calc_num.arith()]))(th0)
  let th2 = @simp.rewrite_rule(@lib.array_to_list(@lib.array_get(@m_taylor.comp_thms_array(), @lib.int63_to_int(n))))(th1)
  @m_taylor.my_rule_float(th2)
}

