  let t399 = r(cell_list_pass_nil2())
  let t400 = r(cell_list_pass_nil1())
  let t401 = r(cell_list_pass_acc_rev())
  let t402 = r(cell_list_pass_acc_elim())
  let (acc_intro, acc_elim, acc_rev, pass_nil1, pass_nil2, same_hd, pass_move1, pass_move2) = (r(cell_list_pass_acc_intro()), t402, t401, t400, t399, t398, t397, t396)
  fn rev_acc(x403 : @kernel.Thm) -> @kernel.Thm raise {
    let th = x403
    let (ltm, s_tm) = (fn(x405 : @kernel.Term) -> (@kernel.Term, @kernel.Term) raise {
      (fn(x404 : @kernel.Term) -> (@kernel.Term, @kernel.Term) raise {
        @kernel.dest_comb(@kernel.rand(x404))
      })(@kernel.rator(x405))
    })((fn(x406 : @kernel.Thm) -> @kernel.Term raise {
      @kernel.concl(x406)
    })(th))
