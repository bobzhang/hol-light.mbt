// Formal_ineqs/verifier/m_verifier.hl in its directory's load order: the test block of
// formal_ineqs/verifier/m_verifier/m_verifier_ref_test.mbt (tools/ocaml_ref/chain_test.py), with the same golden
// (tools/ocaml_ref/Formal_ineqs_verifier_m_verifier_ref.expected).

///|
test "Formal_ineqs/verifier/m_verifier matches Formal_ineqs/verifier/m_verifier.ml" {
  @testkit.release_output()
  @m_verifier.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["Formal_ineqs/verifier/m_verifier"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Formal_ineqs/verifier/m_verifier")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("M_verifier.BOUNDED_INTERVAL_ARITH_IMP_HI'", () => {
