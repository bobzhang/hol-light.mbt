      let f1_p = @informal_nat.denormalize_nat(n1, p2)
      let f1 = @num.sqrt_big_int(@num.big_int_of_num(@informal_nat.dest_nat(f1_p)))
      let t118 = @informal_nat.mk_nat(@num.num_of_big_int(f1))
      let (n, e_p) = @informal_nat.lo_nat(pp)(t118)
      let e = @lib.sub63(@lib.add63(@lib.lsr63(@lib.add63(e1, min_exp()), 1L), e_p), pp)
      if (e < 0L) {
