///|
/// `add_float_lo`
pub fn add_float_lo(x103 : Int64, x104 : (Bool, @informal_nat.Nat, Int64), x105 : (Bool, @informal_nat.Nat, Int64)) -> ((Bool, @informal_nat.Nat, Int64)) raise {
  let pp = x103
  let (s1, n1, e1) = x104
  let (s2, n2, e2) = x105
  if (s1 == s2) {
    let (n_p, e_p) = num_exp_add((n1, e1))((n2, e2))
    let (n, e_p_p) = if s1 {
      @informal_nat.hi_nat(pp)(n_p)
    } else {
      @informal_nat.lo_nat(pp)(n_p)
    }
    (s1, n, @lib.add63(e_p, e_p_p))
  } else {
    if s1 {
      let ((n_p_1, e_p_1), flag) = num_exp_sub((n2, e2))((n1, e1))
      if flag {
        let (n_1, e_p_p_1) = @informal_nat.lo_nat(pp)(n_p_1)
        (false, n_1, @lib.add63(e_p_1, e_p_p_1))
      } else {
        let (n_2, e_p_p_2) = @informal_nat.hi_nat(pp)(n_p_1)
        (true, n_2, @lib.add63(e_p_1, e_p_p_2))
      }
    } else {
      let ((n_p_2, e_p_2), flag_1) = num_exp_sub((n1, e1))((n2, e2))
      if flag_1 {
        let (n_3, e_p_p_3) = @informal_nat.lo_nat(pp)(n_p_2)
        (false, n_3, @lib.add63(e_p_2, e_p_p_3))
      } else {
        let (n_4, e_p_p_4) = @informal_nat.hi_nat(pp)(n_p_2)
        (true, n_4, @lib.add63(e_p_2, e_p_p_4))
      }
    }
  }
}

