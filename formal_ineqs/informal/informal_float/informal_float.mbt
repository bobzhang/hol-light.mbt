    } else {
      let p2 = @lib.mul63(pp, 2L)
      let x = (fn(x122 : @informal_nat.Nat) -> @bigint.BigInt raise {
        @num.big_int_of_num(@informal_nat.dest_nat(x122))
      })((fn(x123 : (@informal_nat.Nat, Int64)) -> @informal_nat.Nat raise {
        @informal_nat.denormalize_nat(x123.0, x123.1)
      })((n1, p2)))
      let f1_p = @num.sqrt_big_int(x)
      let f1 = @informal_nat.mk_nat((fn(x124 : @bigint.BigInt) -> @num.Num raise {
        @num.num_of_big_int(x124)
      })(f1_p))
      let op_star : (@bigint.BigInt) -> ((@bigint.BigInt) -> @bigint.BigInt raise) raise = fn(x125 : @bigint.BigInt) -> ((@bigint.BigInt) -> @bigint.BigInt raise) raise {
        fn(x126 : @bigint.BigInt) -> @bigint.BigInt raise {
