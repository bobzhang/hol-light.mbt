///|
/// `pow_float_hi`
pub fn pow_float_hi(x138 : Int64, x139 : Int64, x140 : (Bool, @informal_nat.Nat, Int64)) -> Ifloat raise {
  let pp = x138
  let n = x139
  let x = x140
  match n {
    0L => float1()
    1L => x
    2L => mul_float_hi(pp, x, x)
    _ => {
      let _ = if (n > 2L) {
        ()
      } else {
        raise @lib.AssertFailure("tscript.ml:503:9")
      }
      if !sign_float(x.0, x.1, x.2) {
        pow_float_pos_hi(pp, n, x)
      } else {
        let x_pos = abs_float(x.0, x.1, x.2)
        if ((n & 1L) == 0L) {
          pow_float_pos_hi(pp, n, x_pos)
        } else {
          let t141 = pow_float_pos_lo(pp, n, x_pos)
          neg_float(t141.0, t141.1, t141.2)
        }
      }
    }
  }
}

