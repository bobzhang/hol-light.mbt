///|
/// `pow_float_pos_hi`
pub fn pow_float_pos_hi(x130 : Int64, x131 : Int64, x132 : (Bool, @informal_nat.Nat, Int64)) -> Ifloat raise {
  let pp = x130
  let n = x131
  let _ as x = x132
  fn pow(x133 : Int64) -> Ifloat raise {
    let n_1 = x133
    match n_1 {
      0L => float1()
      1L => x
      2L => mul_float_hi(pp, x, x)
      _ => {
        if ((n_1 & 1L) == 0L) {
          let t = pow(@lib.lsr63(n_1, 1L))
          mul_float_hi(pp, t, t)
        } else {
          let t_1 = pow(@lib.sub63(n_1, 1L))
          mul_float_hi(pp, x, t_1)
        }
      }
    }
  }
  let _ = if (n >= 0L) {
    ()
  } else {
    raise @lib.AssertFailure("tscript.ml:478:10")
  }
  pow(n)
}

///|
/// `pow_float_pos_lo`
pub fn pow_float_pos_lo(x134 : Int64, x135 : Int64, x136 : (Bool, @informal_nat.Nat, Int64)) -> Ifloat raise {
