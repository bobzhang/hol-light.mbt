      let op_eq_eq : (@bigint.BigInt) -> ((@bigint.BigInt) -> Bool raise) raise = fn(x127 : @bigint.BigInt) -> ((@bigint.BigInt) -> Bool raise) raise {
        fn(x128 : @bigint.BigInt) -> Bool raise {
          @num.eq_big_int(x127, x128)
        }
      }
      let t129 = if op_eq_eq(op_star(f1_p)(f1_p))(x) {
        f1
      } else {
        @informal_nat.suc_nat(f1)
      }
      let (n, e_p) = @informal_nat.hi_nat(pp)(t129)
      let e = @lib.sub63(@lib.add63(@lib.lsr63(@lib.add63(e1, min_exp()), 1L), e_p), pp)
