///|
/// `sqrt_float_hi`
pub fn sqrt_float_hi(x119 : Int64, x120 : (Bool, @informal_nat.Nat, Int64)) -> ((Bool, @informal_nat.Nat, Int64)) raise {
  let pp = x119
  let (s, n1, e1) = x120
