///|
/// `sqrt_float_lo`
pub fn sqrt_float_lo(x115 : Int64, x116 : (Bool, @informal_nat.Nat, Int64)) -> ((Bool, @informal_nat.Nat, Int64)) raise {
  let pp = x115
  let (s, n1, e1) = x116
  if s {
    raise Failure("sqrt_float_lo: negative argument")
  } else {
    if ((e1 & 1L) == 1L) {
      let t117 = @lib.sub63(e1, 1L)
      sqrt_float_lo(pp, (s, @informal_nat.denormalize_nat(n1, 1L), t117))
    } else {
