    }
    let a1_2 = correct_pi(pp, a1_1)
    let a1_case = if @informal_float.ge0_float(a1_2.0, a1_2.1, a1_2.2) {
      1L
    } else {
      (-1L)
    }
    if (a1_case > 0L) {
      let (ab_sum_case, b1_2) = correct_ab_sum(pp, a1_2, b1_1)
      let flag_b_pi = @informal_interval.le_interval(b1_2, @lib.array_get(@informal_atn.pi_approx_array(), @lib.int63_to_int(pp)))
      let flag_b_2pi = @informal_interval.le_interval(b1_2, @lib.array_get(two_pi_array(), @lib.int63_to_int(pp)))
      if flag_b_pi {
        let low = eval_low_0_pi(pp, b1_2)
        let high = eval_high_0_pi(pp, a1_2)
        @informal_interval.mk_interval(low, high)
      } else {
        if (ab_sum_case < 0L) {
          let high_1 = eval_high_0_pi(pp, a1_2)
          @informal_interval.mk_interval(neg_one(), high_1)
        } else {
          if ((ab_sum_case > 0L) && flag_b_2pi) {
            let high_2 = eval_high_pi_2pi(pp, b1_2)
            @informal_interval.mk_interval(neg_one(), high_2)
          } else {
            @informal_interval.mk_interval(neg_one(), one())
          }
        }
      }
    } else {
      if @informal_float.le0_float(b1_1.0, b1_1.1, b1_1.2) {
        let low_1 = eval_low_neg_pi_0(pp, a1_2)
        let high_3 = eval_high_neg_pi_0(pp, b1_1)
        @informal_interval.mk_interval(low_1, high_3)
      } else {
        let b2 = @informal_float.neg_float(b1_1.0, b1_1.1, b1_1.2)
        if @informal_float.le_float(a1_2, b2) {
          let low_2 = eval_low_neg_pi_0(pp, a1_2)
          @informal_interval.mk_interval(low_2, one())
        } else {
          if @informal_interval.le_interval(b1_1, @lib.array_get(@informal_atn.pi_approx_array(), @lib.int63_to_int(pp))) {
            let low_3 = eval_low_0_pi(pp, b1_1)
            @informal_interval.mk_interval(low_3, one())
          } else {
            @informal_interval.mk_interval(neg_one(), one())
          }
        }
      }
    }
  } catch {
    Correction_failed::Correction_failed => {
      let _ = @lib.warn(true, "cos_interval: reduction failed")
      @informal_interval.mk_interval(neg_one(), one())
    }
    e => raise e
  }
}

///|
/// `translate_pi2`
pub fn translate_pi2(x69 : Int64, x70 : @informal_interval.Interval) -> @informal_interval.Interval raise {
  let pp = x69
  let x_int = x70
  let (a, b) = @informal_interval.dest_interval(x_int.0, x_int.1)
  let t71 = @lib.array_get(@informal_atn.pi2_approx_array(), @lib.int63_to_int(pp))
  let (lo, hi) = @informal_interval.dest_interval(t71.0, t71.1)
  let a1 = @informal_float.sub_float_lo(pp, a, hi)
  let b1 = @informal_float.sub_float_hi(pp, b, lo)
  @informal_interval.mk_interval(a1, b1)
}

///|
/// `sin_interval`
pub fn sin_interval(x72 : Int64, x73 : @informal_interval.Interval) -> @informal_interval.Interval raise {
  let pp = x72
  let x_int = x73
  let x_pi2 = translate_pi2(pp, x_int)
  cos_interval(pp, x_pi2)
}

///|
fn load_steps() -> Unit raise {
  step_1()
  step_2()
  step_3()
  step_4()
  step_5()
  step_6()
  step_7()
  step_8()
}
