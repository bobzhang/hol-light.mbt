      let domain0 = x165
      fn(x166 : @list.List[(String, Int64)]) -> @informal_taylor.MCellDomain raise {
        let path = x166
        fn get_rec(x167 : @informal_taylor.MCellDomain, x168 : @list.List[(String, Int64)], x169 : String) -> @informal_taylor.MCellDomain raise {
          let domain = x167
          let path_1 = x168
          let hash = x169
          match path_1 {
