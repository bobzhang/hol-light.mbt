      }
      _ => raise Failure("False result")
    }
  }
  rec_verify(domain0, certificate)
}

///|
fn[TE] mono_test_l(fs_list : @list.List[VerificationFuns], x111 : @list.List[@certificate.MonoStatus], x112 : @informal_taylor.MCellDomain, x113 : TE, x114 : @list.List[Int64], x115 : Int64) -> Bool raise {
