  let xx = x158
  let zz = x159
  let domain_hash = @lib.hashtbl_create(@lib.int63_to_int(@lib.mul63(Int::to_int64(@lib.length(certificate_list)), 10L)))
  let (mem, find, add) = (fn(x160 : String) -> Bool raise {
