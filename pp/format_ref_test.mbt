///|
fn run(margin : Int, max_boxes : Int, doc : String) -> String raise {
  let buf = StringBuilder()
  let fmt = @pp.formatter_of_buffer(buf)
  fmt.set_max_boxes(max_boxes)
  fmt.set_margin(margin)
  for op in doc.split("|") {
    let op = op.to_owned()
    if op == "" {
      continue
    }
    match op[0] {
      '[' => {
        let n = @string.parse_int(op[2:])
        match op[1] {
          'h' => fmt.open_hbox()
          'v' => fmt.open_vbox(n)
          'H' => fmt.open_hvbox(n)
          'o' => fmt.open_hovbox(n)
          _ => fmt.open_box(n)
        }
      }
      ']' => fmt.close_box()
      's' => {
        let parts = op[1:].split(",").collect()
        fmt.print_break(
          @string.parse_int(parts[0]),
          @string.parse_int(parts[1]),
        )
      }
      'n' => fmt.force_newline()
      't' => fmt.print_string(op[1:].to_owned())
      _ => fail("bad op " + op)
    }
  }
  fmt.print_flush()
  buf.to_string()
}

///|
priv struct Log {
  buf : StringBuilder
}

///|
test "Format engine matches OCaml's Format" {
  let log = { buf: StringBuilder(), }
  let mut i = 0
  for line in cases.split("\n") {
    let parts = line.split(";").collect()
    let out = run(
      @string.parse_int(parts[0]),
      @string.parse_int(parts[1]),
      parts[2].to_owned(),
    )
    log.buf.write_string("case " + i.to_string() + "\n")
    for l in out.split("\n") {
      log.buf.write_string("|" + l.to_owned() + "|\n")
    }
    i += 1
  }
  inspect(
    log.buf.to_string(),
