// Load-fidelity test for 100/reciprocity.ml: replays tools/ocaml_ref/100_reciprocity_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/reciprocity matches 100/reciprocity.ml" {
  @reciprocity.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/prime", "Library/iter", "Library/pocklington", "Library/products", "100/reciprocity"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/reciprocity")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("IN_NUMSEG_1", () => sthm(@reciprocity.in_numseg_1()))
  log.attempt("EVEN_DIV", () => sthm(@reciprocity.even_div()))
  log.attempt("CONG_MINUS1_SQUARE", () => sthm(@reciprocity.cong_minus1_square()))
  log.attempt("CONG_EXP_MINUS1", () => sthm(@reciprocity.cong_exp_minus1()))
  log.attempt("NOT_CONG_MINUS1", () => sthm(@reciprocity.not_cong_minus1()))
  log.attempt("CONG_COND_LEMMA", () => sthm(@reciprocity.cong_cond_lemma()))
  log.attempt("FINITE_SUBCROSS", () => sthm(@reciprocity.finite_subcross()))
  log.attempt("CARD_SUBCROSS_DETERMINATE", () => sthm(@reciprocity.card_subcross_determinate()))
  log.attempt("CARD_SUBCROSS_SWAP", () => sthm(@reciprocity.card_subcross_swap()))
  log.attempt("is_quadratic_residue", () => sthm(@reciprocity.is_quadratic_residue()))
  log.attempt("IS_QUADRATIC_RESIDUE", () => sthm(@reciprocity.is_quadratic_residue_v1()))
  log.attempt("IS_QUADRATIC_RESIDUE_COMMON", () => sthm(@reciprocity.is_quadratic_residue_common()))
  log.attempt("QUADRATIC_RESIDUE_PAIR_ADD", () => sthm(@reciprocity.quadratic_residue_pair_add()))
  log.attempt("QUADRATIC_RESIDUE_PAIR", () => sthm(@reciprocity.quadratic_residue_pair()))
  log.attempt("IS_QUADRATIC_RESIDUE_PAIR", () => sthm(@reciprocity.is_quadratic_residue_pair()))
  log.attempt("QUADRATIC_RESIDUE_PAIR_PRODUCT", () => sthm(@reciprocity.quadratic_residue_pair_product()))
  log.attempt("legendre", () => sthm(@reciprocity.legendre()))
  log.attempt("nproduct", () => sthm(@reciprocity.nproduct()))
  log.attempt("CONG_NPRODUCT", () => sthm(@reciprocity.cong_nproduct()))
  log.attempt("NPRODUCT_DELTA_CONST", () => sthm(@reciprocity.nproduct_delta_const()))
  log.attempt("COPRIME_NPRODUCT", () => sthm(@reciprocity.coprime_nproduct()))
  log.attempt("FACT_NPRODUCT", () => sthm(@reciprocity.fact_nproduct()))
  log.attempt("NPRODUCT_PAIRUP_INDUCT", () => sthm(@reciprocity.nproduct_pairup_induct()))
  log.attempt("QUADRATIC_NONRESIDUE_FACT", () => sthm(@reciprocity.quadratic_nonresidue_fact()))
  log.attempt("QUADRATIC_RESIDUE_FACT", () => sthm(@reciprocity.quadratic_residue_fact()))
  log.attempt("WILSON_LEMMA", () => sthm(@reciprocity.wilson_lemma()))
  log.attempt("WILSON_IMP", () => sthm(@reciprocity.wilson_imp()))
  log.attempt("WILSON", () => sthm(@reciprocity.wilson()))
  log.attempt("EULER_CRITERION", () => sthm(@reciprocity.euler_criterion()))
  log.attempt("GAUSS_LEMMA_1", () => sthm(@reciprocity.gauss_lemma_1()))
  log.attempt("GAUSS_LEMMA_2", () => sthm(@reciprocity.gauss_lemma_2()))
  log.attempt("GAUSS_LEMMA_3", () => sthm(@reciprocity.gauss_lemma_3()))
  log.attempt("GAUSS_LEMMA_4", () => sthm(@reciprocity.gauss_lemma_4()))
  log.attempt("GAUSS_LEMMA", () => sthm(@reciprocity.gauss_lemma()))
  log.attempt("GAUSS_LEMMA_SYM", () => sthm(@reciprocity.gauss_lemma_sym()))
  log.attempt("GAUSS_LEMMA_SYM'", () => sthm(@reciprocity.gauss_lemma_sym_p()))
  log.attempt("RECIPROCITY_SET_LEMMA", () => sthm(@reciprocity.reciprocity_set_lemma()))
  log.attempt("RECIPROCITY_SIMPLE", () => sthm(@reciprocity.reciprocity_simple()))
  log.attempt("RECIPROCITY_LEGENDRE", () => sthm(@reciprocity.reciprocity_legendre()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
