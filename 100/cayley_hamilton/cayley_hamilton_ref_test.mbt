// Load-fidelity test for 100/cayley_hamilton.ml: replays tools/ocaml_ref/100_cayley_hamilton_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/cayley_hamilton matches 100/cayley_hamilton.ml" {
  @cayley_hamilton.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/wo", "Library/card", "Library/floor", "Multivariate/misc", "Library/products", "Library/iter", "Multivariate/metric", "Library/frag", "Library/prime", "Library/grouptheory", "Multivariate/homology", "Library/matroids", "Multivariate/vectors", "Library/permutations", "Multivariate/determinants", "Multivariate/topology", "Multivariate/convex", "Multivariate/paths", "Multivariate/polytope", "Multivariate/degree", "Multivariate/derivatives", "Library/binary", "Multivariate/clifford", "Multivariate/integration", "Multivariate/measure", "Multivariate/complexes", "Multivariate/msum", "100/cayley_hamilton"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/cayley_hamilton")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("mpow", () => sthm(@cayley_hamilton.mpow()))
  log.attempt("MPOW_ADD", () => sthm(@cayley_hamilton.mpow_add()))
  log.attempt("MPOW_1", () => sthm(@cayley_hamilton.mpow_1()))
  log.attempt("MPOW_SUC", () => sthm(@cayley_hamilton.mpow_suc()))
  log.attempt("MATRIC_POLYFUN_EQ_0", () => sthm(@cayley_hamilton.matric_polyfun_eq_0()))
  log.attempt("MATRIC_POLY_LEMMA", () => sthm(@cayley_hamilton.matric_poly_lemma()))
  log.attempt("POLYFUN_N_CONST", () => sthm(@cayley_hamilton.polyfun_n_const()))
  log.attempt("POLYFUN_N_ADD", () => sthm(@cayley_hamilton.polyfun_n_add()))
  log.attempt("POLYFUN_N_CMUL", () => sthm(@cayley_hamilton.polyfun_n_cmul()))
  log.attempt("POLYFUN_N_SUM", () => sthm(@cayley_hamilton.polyfun_n_sum()))
  log.attempt("POLYFUN_N_PRODUCT", () => sthm(@cayley_hamilton.polyfun_n_product()))
  log.attempt("COFACTOR_ENTRY_AS_POLYFUN", () => sthm(@cayley_hamilton.cofactor_entry_as_polyfun()))
  log.attempt("DETERMINANT_AS_POLYFUN", () => sthm(@cayley_hamilton.determinant_as_polyfun()))
  log.attempt("char_poly", () => sthm(@cayley_hamilton.char_poly()))
  log.attempt("COFACTOR_AS_MATRIC_POLYNOMIAL", () => sthm(@cayley_hamilton.cofactor_as_matric_polynomial()))
  log.attempt("MATRIC_POWER_DIFFERENCE", () => sthm(@cayley_hamilton.matric_power_difference()))
  log.attempt("MATRIC_CHARPOLY_DIFFERENCE", () => sthm(@cayley_hamilton.matric_charpoly_difference()))
  log.attempt("CAYLEY_HAMILTON", () => sthm(@cayley_hamilton.cayley_hamilton()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
