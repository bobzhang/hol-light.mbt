// Load-fidelity test for 100/four_squares.ml: replays tools/ocaml_ref/100_four_squares_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/four_squares matches 100/four_squares.ml" {
  @four_squares.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/prime", "Library/analysis", "100/four_squares"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/four_squares")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("involution", () => sthm(@four_squares.involution()))
  log.attempt("INVOLUTION_IMAGE", () => sthm(@four_squares.involution_image()))
  log.attempt("INVOLUTION_DELETE", () => sthm(@four_squares.involution_delete()))
  log.attempt("INVOLUTION_STEPDOWN", () => sthm(@four_squares.involution_stepdown()))
  log.attempt("INVOLUTION_NOFIXES", () => sthm(@four_squares.involution_nofixes()))
  log.attempt("INVOLUTION_SUBSET", () => sthm(@four_squares.involution_subset()))
  log.attempt("INVOLUTION_EVEN", () => sthm(@four_squares.involution_even()))
  log.attempt("INVOLUTION_FIX_ODD", () => sthm(@four_squares.involution_fix_odd()))
  log.attempt("INVOLUTION_ODD", () => sthm(@four_squares.involution_odd()))
  log.attempt("INVOLUTION_FIX_FIX", () => sthm(@four_squares.involution_fix_fix()))
  log.attempt("zset", () => sthm(@four_squares.zset()))
  log.attempt("zag", () => sthm(@four_squares.zag()))
  log.attempt("tag", () => sthm(@four_squares.tag()))
  log.attempt("ZAG_INVOLUTION_GENERAL", () => sthm(@four_squares.zag_involution_general()))
  log.attempt("IN_TRIPLE", () => sthm(@four_squares.in_triple()))
  log.attempt("PRIME_SQUARE", () => sthm(@four_squares.prime_square()))
  log.attempt("PRIME_4X", () => sthm(@four_squares.prime_4x()))
  log.attempt("PRIME_XYZ_NONZERO", () => sthm(@four_squares.prime_xyz_nonzero()))
  log.attempt("ZAG_INVOLUTION", () => sthm(@four_squares.zag_involution()))
  log.attempt("TAG_INVOLUTION", () => sthm(@four_squares.tag_involution()))
  log.attempt("ZAG_LEMMA", () => sthm(@four_squares.zag_lemma()))
  log.attempt("ZSET_BOUND", () => sthm(@four_squares.zset_bound()))
  log.attempt("ZSET_FINITE", () => sthm(@four_squares.zset_finite()))
  log.attempt("SUM_OF_TWO_SQUARES", () => sthm(@four_squares.sum_of_two_squares()))
  log.attempt("PIGEONHOLE_LEMMA", () => sthm(@four_squares.pigeonhole_lemma()))
  log.attempt("PIGEONHOLE_LEMMA_P12", () => sthm(@four_squares.pigeonhole_lemma_p12()))
  log.attempt("SQUAREMOD_INJ_LEMMA", () => sthm(@four_squares.squaremod_inj_lemma()))
  log.attempt("SQUAREMOD_INJ", () => sthm(@four_squares.squaremod_inj()))
  log.attempt("REFLECT_INJ", () => sthm(@four_squares.reflect_inj()))
  log.attempt("LAGRANGE_LEMMA_ODD", () => sthm(@four_squares.lagrange_lemma_odd()))
  log.attempt("LAGRANGE_LEMMA", () => sthm(@four_squares.lagrange_lemma()))
  log.attempt("REAL_INTEGER_CLOSURES", () => sthm(@four_squares.real_integer_closures()))
  log.attempt("REAL_NUM_ROUND", () => sthm(@four_squares.real_num_round()))
  log.attempt("REAL_POS_ABS_MIDDLE", () => sthm(@four_squares.real_pos_abs_middle()))
  log.attempt("REAL_RAT_ABS_MIDDLE", () => sthm(@four_squares.real_rat_abs_middle()))
  log.attempt("AUBREY_LEMMA_4", () => sthm(@four_squares.aubrey_lemma_4()))
  log.attempt("AUBREY_THM_4", () => sthm(@four_squares.aubrey_thm_4()))
  log.attempt("LAGRANGE_IDENTITY", () => sthm(@four_squares.lagrange_identity()))
  log.attempt("LAGRANGE_REAL_NUM", () => sthm(@four_squares.lagrange_real_num()))
  log.attempt("LAGRANGE_NUM", () => sthm(@four_squares.lagrange_num()))
  log.attempt("LAGRANGE_INT", () => sthm(@four_squares.lagrange_int()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
