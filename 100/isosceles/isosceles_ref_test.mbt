// Load-fidelity test for 100/isosceles.ml: replays tools/ocaml_ref/100_isosceles_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/isosceles matches 100/isosceles.ml" {
  @isosceles.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/wo", "Library/card", "Library/floor", "Multivariate/misc", "Library/products", "Library/iter", "Multivariate/metric", "Library/frag", "Library/prime", "Library/grouptheory", "Multivariate/homology", "Library/matroids", "Multivariate/vectors", "Library/permutations", "Multivariate/determinants", "Multivariate/topology", "Multivariate/convex", "Multivariate/paths", "Multivariate/polytope", "Multivariate/degree", "Multivariate/derivatives", "Library/binary", "Multivariate/clifford", "Multivariate/integration", "Multivariate/measure", "Multivariate/complexes", "Multivariate/canal", "Multivariate/transcendentals", "Library/binomial", "Multivariate/realanalysis", "Multivariate/geom", "100/isosceles"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/isosceles")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("ISOSCELES_TRIANGLE_THEOREM", () => sthm(@isosceles.isosceles_triangle_theorem()))
  log.attempt("ISOSCELES_TRIANGLE_CONVERSE", () => sthm(@isosceles.isosceles_triangle_converse()))
  log.attempt("lemma", () => sthm(@isosceles.lemma()))
  log.attempt("ISOSCELES_TRIANGLE_1", () => sthm(@isosceles.isosceles_triangle_1()))
  log.attempt("ISOSCELES_TRIANGLE_2", () => sthm(@isosceles.isosceles_triangle_2()))
  log.attempt("ISOSCELES_TRIANGLE_3", () => sthm(@isosceles.isosceles_triangle_3()))
  log.attempt("ISOSCELES_TRIANGLE_4", () => sthm(@isosceles.isosceles_triangle_4()))
  log.attempt("ISOSCELES_TRIANGLE_5", () => sthm(@isosceles.isosceles_triangle_5()))
  log.attempt("ISOSCELES_TRIANGLE_6", () => sthm(@isosceles.isosceles_triangle_6()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
