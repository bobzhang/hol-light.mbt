  log.attempt("square_integrable_on", () => sthm(@fourier.square_integrable_on()))
  log.attempt("SQUARE_INTEGRABLE_IMP_MEASURABLE", () => sthm(@fourier.square_integrable_imp_measurable()))
  log.attempt("SQUARE_INTEGRABLE_LSPACE", () => sthm(@fourier.square_integrable_lspace()))
  log.attempt("SQUARE_INTEGRABLE_0", () => sthm(@fourier.square_integrable_0()))
  log.attempt("SQUARE_INTEGRABLE_NEG_EQ", () => sthm(@fourier.square_integrable_neg_eq()))
  log.attempt("SQUARE_INTEGRABLE_NEG", () => sthm(@fourier.square_integrable_neg()))
  log.attempt("SQUARE_INTEGRABLE_LMUL", () => sthm(@fourier.square_integrable_lmul()))
  log.attempt("SQUARE_INTEGRABLE_RMUL", () => sthm(@fourier.square_integrable_rmul()))
  log.attempt("SQUARE_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE_PRODUCT", () => sthm(@fourier.square_integrable_imp_absolutely_integrable_product()))
