  log.attempt("SQUARE_INTEGRABLE_ADD", () => sthm(@fourier.square_integrable_add()))
  log.attempt("SQUARE_INTEGRABLE_SUB", () => sthm(@fourier.square_integrable_sub()))
  log.attempt("SQUARE_INTEGRABLE_ABS", () => sthm(@fourier.square_integrable_abs()))
  log.attempt("SQUARE_INTEGRABLE_SUM", () => sthm(@fourier.square_integrable_sum()))
  log.attempt("REAL_CONTINUOUS_IMP_SQUARE_INTEGRABLE", () => sthm(@fourier.real_continuous_imp_square_integrable()))
  log.attempt("SQUARE_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE", () => sthm(@fourier.square_integrable_imp_absolutely_integrable()))
  log.attempt("SQUARE_INTEGRABLE_IMP_INTEGRABLE", () => sthm(@fourier.square_integrable_imp_integrable()))
  log.attempt("l2product", () => sthm(@fourier.l2product()))
  log.attempt("l2norm", () => sthm(@fourier.l2norm()))
  log.attempt("L2NORM_LNORM", () => sthm(@fourier.l2norm_lnorm()))
  log.attempt("L2PRODUCT_SYM", () => sthm(@fourier.l2product_sym()))
