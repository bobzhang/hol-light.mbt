// Load-fidelity test for 100/morley.ml: replays tools/ocaml_ref/100_morley_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/morley matches 100/morley.ml" {
  @morley.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/iter", "Library/wo", "Library/card", "Library/floor", "Multivariate/misc", "Library/products", "Multivariate/metric", "Library/frag", "Library/prime", "Library/grouptheory", "Multivariate/homology", "Library/matroids", "Multivariate/vectors", "Library/permutations", "Multivariate/determinants", "Multivariate/topology", "Multivariate/convex", "Multivariate/paths", "Multivariate/polytope", "Multivariate/degree", "Multivariate/derivatives", "Library/binary", "Multivariate/clifford", "Multivariate/integration", "Multivariate/measure", "Multivariate/complexes", "Multivariate/canal", "Multivariate/transcendentals", "Library/binomial", "Multivariate/realanalysis", "Multivariate/geom", "100/morley"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/morley")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("reflect2d", () => sthm(@morley.reflect2d()))
  log.attempt("REFLECT2D_COMPOSE", () => sthm(@morley.reflect2d_compose()))
  log.attempt("rotate_about", () => sthm(@morley.rotate_about()))
  log.attempt("reflect_across", () => sthm(@morley.reflect_across()))
  log.attempt("REFLECT_ACROSS_COMPOSE", () => sthm(@morley.reflect_across_compose()))
  log.attempt("REFLECT_ACROSS_COMPOSE_ANGLE", () => sthm(@morley.reflect_across_compose_angle()))
  log.attempt("REFLECT_ACROSS_COMPOSE_INVOLUTION", () => sthm(@morley.reflect_across_compose_involution()))
  log.attempt("REFLECT_ACROSS_SYM", () => sthm(@morley.reflect_across_sym()))
  log.attempt("ITER_ROTATE_ABOUT", () => sthm(@morley.iter_rotate_about()))
  log.attempt("REAL_LE_IM_DIV_CYCLIC", () => sthm(@morley.real_le_im_div_cyclic()))
  log.attempt("ROTATE_ABOUT_INVERT", () => sthm(@morley.rotate_about_invert()))
  log.attempt("ROTATE_EQ_REFLECT_LEMMA", () => sthm(@morley.rotate_eq_reflect_lemma()))
  log.attempt("ROTATE_EQ_REFLECT_PI_LEMMA", () => sthm(@morley.rotate_eq_reflect_pi_lemma()))
  log.attempt("EQUILATERAL_TRIANGLE_ALGEBRAIC", () => sthm(@morley.equilateral_triangle_algebraic()))
  log.attempt("AFFINE_GROUP_ITER_3", () => sthm(@morley.affine_group_iter_3()))
  log.attempt("AFFINE_GROUP_COMPOSE", () => sthm(@morley.affine_group_compose()))
  log.attempt("AFFINE_GROUP_I", () => sthm(@morley.affine_group_i()))
  log.attempt("AFFINE_GROUP_EQ", () => sthm(@morley.affine_group_eq()))
  log.attempt("AFFINE_GROUP_ROTATE_ABOUT", () => sthm(@morley.affine_group_rotate_about()))
  log.attempt("ALGEBRAIC_LEMMA", () => sthm(@morley.algebraic_lemma()))
  log.attempt("MORLEY", () => sthm(@morley.morley()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
