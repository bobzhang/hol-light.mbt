// Load-fidelity test for 100/green.ml: replays tools/ocaml_ref/100_green_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/green matches 100/green.ml" {
  @green.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/wo", "Library/card", "Library/floor", "Multivariate/misc", "Library/products", "Library/iter", "Multivariate/metric", "Library/frag", "Library/prime", "Library/grouptheory", "Multivariate/homology", "Library/matroids", "Multivariate/vectors", "Library/permutations", "Multivariate/determinants", "Multivariate/topology", "Multivariate/convex", "Multivariate/paths", "Multivariate/polytope", "Multivariate/degree", "Multivariate/derivatives", "Library/binary", "Multivariate/clifford", "Multivariate/integration", "Multivariate/measure", "Multivariate/complexes", "Multivariate/canal", "Multivariate/transcendentals", "Library/binomial", "Multivariate/realanalysis", "Multivariate/moretop", "Multivariate/cauchy", "Multivariate/lpspaces", "100/green"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/green")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("wirtinger_dbar", () => sthm(@green.wirtinger_dbar()))
  log.attempt("wirtinger_dz", () => sthm(@green.wirtinger_dz()))
  log.attempt("WIRTINGER_DBAR_EQ_ZERO", () => sthm(@green.wirtinger_dbar_eq_zero()))
  log.attempt("WIRTINGER_DZ_COMPLEX_DERIVATIVE", () => sthm(@green.wirtinger_dz_complex_derivative()))
  log.attempt("FRECHET_WIRTINGER", () => sthm(@green.frechet_wirtinger()))
  log.attempt("HAS_DERIVATIVE_CNJ", () => sthm(@green.has_derivative_cnj()))
  log.attempt("JACOBIAN_CNJ", () => sthm(@green.jacobian_cnj()))
  log.attempt("WIRTINGER_DBAR_CNJ", () => sthm(@green.wirtinger_dbar_cnj()))
  log.attempt("WIRTINGER_DBAR_I", () => sthm(@green.wirtinger_dbar_i()))
  log.attempt("WIRTINGER_DBAR_FRECHET", () => sthm(@green.wirtinger_dbar_frechet()))
  log.attempt("WIRTINGER_DBAR_CONTINUOUS", () => sthm(@green.wirtinger_dbar_continuous()))
  log.attempt("WIRTINGER_DBAR_BOUNDED_SUPPORT", () => sthm(@green.wirtinger_dbar_bounded_support()))
  log.attempt("CAUCHY_TRANSFORM_DBAR_TRANSLATION", () => sthm(@green.cauchy_transform_dbar_translation()))
  log.attempt("CONTINUOUS_ON_TRANSLATE_UNIV", () => sthm(@green.continuous_on_translate_univ()))
  log.attempt("BOUNDED_SUPPORT_TRANSLATE", () => sthm(@green.bounded_support_translate()))
  log.attempt("POLAR_SIMPLIFY", () => sthm(@green.polar_simplify()))
  log.attempt("INV_CEXP_II", () => sthm(@green.inv_cexp_ii()))
  log.attempt("POLAR_CEXP_SIMPLIFY", () => sthm(@green.polar_cexp_simplify()))
  log.attempt("WIRTINGER_DBAR_FRECHET_POLAR", () => sthm(@green.wirtinger_dbar_frechet_polar()))
  log.attempt("CEXP_2PII", () => sthm(@green.cexp_2pii()))
  log.attempt("CEXP_0II", () => sthm(@green.cexp_0ii()))
  log.attempt("NORM_CPOW_COMPLEX", () => sthm(@green.norm_cpow_complex()))
  log.attempt("ABSOLUTELY_INTEGRABLE_CPOW", () => sthm(@green.absolutely_integrable_cpow()))
  log.attempt("INV_ABSOLUTELY_INTEGRABLE_BOUNDED", () => sthm(@green.inv_absolutely_integrable_bounded()))
  log.attempt("LSPACE_COMPLEX_INV", () => sthm(@green.lspace_complex_inv()))
  log.attempt("CAUCHY_KERNEL_ABSOLUTELY_INTEGRABLE", () => sthm(@green.cauchy_kernel_absolutely_integrable()))
  log.attempt("INTEGRAL_IF_CONST", () => sthm(@green.integral_if_const()))
  log.attempt("NEGLIGIBLE_GRAPH_PRODUCT", () => sthm(@green.negligible_graph_product()))
  log.attempt("MEASURABLE_ON_FUBINI_INTEGRAND", () => sthm(@green.measurable_on_fubini_integrand()))
  log.attempt("CAUCHY_KERNEL_NORM_UNIFORM_BOUND", () => sthm(@green.cauchy_kernel_norm_uniform_bound()))
  log.attempt("SUPPORT_BOUNDED_OUTSIDE", () => sthm(@green.support_bounded_outside()))
  log.attempt("CAUCHY_KERNEL_NORM_TRUNC_INTEGRABLE", () => sthm(@green.cauchy_kernel_norm_trunc_integrable()))
  log.attempt("CAUCHY_KERNEL_NORM_TRUNC_CONTINUOUS", () => sthm(@green.cauchy_kernel_norm_trunc_continuous()))
  log.attempt("CAUCHY_KERNEL_NORM_TRUNC_CONVERGES", () => sthm(@green.cauchy_kernel_norm_trunc_converges()))
  log.attempt("CAUCHY_KERNEL_WEIGHTED_MEASURABLE", () => sthm(@green.cauchy_kernel_weighted_measurable()))
  log.attempt("NEGLIGIBLE_ABSOLUTELY_CONTINUOUS_PATH_IMAGE", () => sthm(@green.negligible_absolutely_continuous_path_image()))
  log.attempt("PATH_INTEGRABLE_CONTINUOUS_ABSOLUTELY_CONTINUOUS", () => sthm(@green.path_integrable_continuous_absolutely_continuous()))
  log.attempt("FUBINI_PATH_AREA", () => sthm(@green.fubini_path_area()))
  log.attempt("ABSOLUTELY_INTEGRABLE_DBAR_KERNEL", () => sthm(@green.absolutely_integrable_dbar_kernel()))
  log.attempt("HAS_DERIVATIVE_CX_DROP", () => sthm(@green.has_derivative_cx_drop()))
  log.attempt("HAS_DERIVATIVE_II_CX_DROP", () => sthm(@green.has_derivative_ii_cx_drop()))
  log.attempt("HAS_DERIVATIVE_CEXP_POLAR", () => sthm(@green.has_derivative_cexp_polar()))
  log.attempt("HAS_DERIVATIVE_AFFINE_MUL", () => sthm(@green.has_derivative_affine_mul()))
  log.attempt("HAS_DERIVATIVE_POLAR_PATH", () => sthm(@green.has_derivative_polar_path()))
  log.attempt("CONTINUOUS_ON_COMPLEX_LMUL_FN", () => sthm(@green.continuous_on_complex_lmul_fn()))
  log.attempt("CONT_II_CX_DROP", () => sthm(@green.cont_ii_cx_drop()))
  log.attempt("CONT_CEXP_POLAR", () => sthm(@green.cont_cexp_polar()))
  log.attempt("CONTINUOUS_ON_POLAR_PATH", () => sthm(@green.continuous_on_polar_path()))
  log.attempt("CONTINUOUS_ON_POLAR_PATH_INTERVAL", () => sthm(@green.continuous_on_polar_path_interval()))
  log.attempt("CONTINUOUS_ON_F_POLAR", () => sthm(@green.continuous_on_f_polar()))
  log.attempt("HAS_VECTOR_DERIVATIVE_F_POLAR", () => sthm(@green.has_vector_derivative_f_polar()))
  log.attempt("ANGULAR_FTC", () => sthm(@green.angular_ftc()))
  log.attempt("ANGULAR_INTEGRAL_ZERO", () => sthm(@green.angular_integral_zero()))
  log.attempt("FRECHET_DERIVATIVE_CX_LMUL", () => sthm(@green.frechet_derivative_cx_lmul()))
  log.attempt("ANGULAR_INTEGRAL_II_ZERO", () => sthm(@green.angular_integral_ii_zero()))
  log.attempt("HAS_DERIVATIVE_RADIAL_PATH", () => sthm(@green.has_derivative_radial_path()))
  log.attempt("HAS_VECTOR_DERIVATIVE_F_RADIAL", () => sthm(@green.has_vector_derivative_f_radial()))
  log.attempt("CONTINUOUS_ON_RADIAL_PATH", () => sthm(@green.continuous_on_radial_path()))
  log.attempt("CONTINUOUS_ON_F_RADIAL", () => sthm(@green.continuous_on_f_radial()))
  log.attempt("RADIAL_FTC", () => sthm(@green.radial_ftc()))
  log.attempt("INNER_INTEGRAL_SIMPLIFY", () => sthm(@green.inner_integral_simplify()))
  log.attempt("RADIAL_INTEGRAL_NEG_FW", () => sthm(@green.radial_integral_neg_fw()))
  log.attempt("DROP_POS_OF_NONNEG_NZ", () => sthm(@green.drop_pos_of_nonneg_nz()))
  log.attempt("WIRTINGER_DZ_FRECHET", () => sthm(@green.wirtinger_dz_frechet()))
  log.attempt("WIRTINGER_DZ_CONTINUOUS", () => sthm(@green.wirtinger_dz_continuous()))
  log.attempt("FRECHET_CONTINUOUS_ON_JOINT", () => sthm(@green.frechet_continuous_on_joint()))
  log.attempt("CONTINUOUS_ON_CEXP_SNDCART", () => sthm(@green.continuous_on_cexp_sndcart()))
  log.attempt("CONTINUOUS_ON_POLAR_PASTECART", () => sthm(@green.continuous_on_polar_pastecart()))
  log.attempt("FRECHET_DERIVATIVE_ZERO_OUTSIDE", () => sthm(@green.frechet_derivative_zero_outside()))
  log.attempt("ZERO_OUTSIDE_SUPPORT_BALL", () => sthm(@green.zero_outside_support_ball()))
  log.attempt("POLAR_POINT_NORM_BOUND", () => sthm(@green.polar_point_norm_bound()))
  log.attempt("POLAR_FUBINI_SWAP", () => sthm(@green.polar_fubini_swap()))
  log.attempt("POLAR_INTEGRAL_DECOMPOSITION", () => sthm(@green.polar_integral_decomposition()))
  log.attempt("INTEGRAL_CONST_2PI", () => sthm(@green.integral_const_2pi()))
  log.attempt("INV_TWO_TIMES_TWO_PI", () => sthm(@green.inv_two_times_two_pi()))
  log.attempt("CAUCHY_TRANSFORM_INVERTS_DBAR", () => sthm(@green.cauchy_transform_inverts_dbar()))
  log.attempt("PIECEWISE_HAS_DERIVATIVE_LOCAL", () => sthm(@green.piecewise_has_derivative_local()))
  log.attempt("PIECEWISE_HAS_REAL_DERIVATIVE_LOCAL", () => sthm(@green.piecewise_has_real_derivative_local()))
  log.attempt("hermite_cutoff", () => sthm(@green.hermite_cutoff()))
  log.attempt("hermite_cutoff_deriv", () => sthm(@green.hermite_cutoff_deriv()))
  log.attempt("HAS_REAL_DERIVATIVE_HERMITE_INTERIOR", () => sthm(@green.has_real_derivative_hermite_interior()))
  log.attempt("HAS_REAL_DERIVATIVE_HERMITE_LEFT", () => sthm(@green.has_real_derivative_hermite_left()))
  log.attempt("HAS_REAL_DERIVATIVE_HERMITE_RIGHT", () => sthm(@green.has_real_derivative_hermite_right()))
  log.attempt("HAS_REAL_DERIVATIVE_HERMITE_AT_0", () => sthm(@green.has_real_derivative_hermite_at_0()))
  log.attempt("HAS_REAL_DERIVATIVE_HERMITE_AT_1", () => sthm(@green.has_real_derivative_hermite_at_1()))
  log.attempt("HAS_REAL_DERIVATIVE_HERMITE_EXPLICIT", () => sthm(@green.has_real_derivative_hermite_explicit()))
  log.attempt("POLY_CONTINUOUS_REAL1", () => sthm(@green.poly_continuous_real1()))
  log.attempt("HERMITE_CUTOFF_DERIV_CONTINUOUS", () => sthm(@green.hermite_cutoff_deriv_continuous()))
  log.attempt("HERMITE_CUTOFF_DIFFERENTIABLE", () => sthm(@green.hermite_cutoff_differentiable()))
  log.attempt("HERMITE_CUTOFF_DIFFERENTIABLE_ON", () => sthm(@green.hermite_cutoff_differentiable_on()))
  log.attempt("HERMITE_CUTOFF_CONTINUOUS", () => sthm(@green.hermite_cutoff_continuous()))
  log.attempt("HERMITE_CUTOFF_CHI_HAS_DERIVATIVE", () => sthm(@green.hermite_cutoff_chi_has_derivative()))
  log.attempt("HERMITE_CUTOFF_LE_0", () => sthm(@green.hermite_cutoff_le_0()))
  log.attempt("HERMITE_CUTOFF_GE_1", () => sthm(@green.hermite_cutoff_ge_1()))
  log.attempt("HERMITE_CUTOFF_NONNEG", () => sthm(@green.hermite_cutoff_nonneg()))
  log.attempt("HERMITE_CUTOFF_SHIFTED_HAS_DERIVATIVE", () => sthm(@green.hermite_cutoff_shifted_has_derivative()))
  log.attempt("PHI_SHIFTED_CONTINUOUS_ON", () => sthm(@green.phi_shifted_continuous_on()))
  log.attempt("HCD_SHIFTED_CONTINUOUS_ON", () => sthm(@green.hcd_shifted_continuous_on()))
  log.attempt("HC_SHIFTED_CONTINUOUS_ON", () => sthm(@green.hc_shifted_continuous_on()))
  log.attempt("SMOOTH_EXTENSION_FROM_OPEN", () => sthm(@green.smooth_extension_from_open()))
  log.attempt("ABSOLUTELY_INTEGRABLE_CAUCHY_PATH_PRODUCT", () => sthm(@green.absolutely_integrable_cauchy_path_product()))
  log.attempt("INTEGRABLE_WINDING_DBAR_PRODUCT", () => sthm(@green.integrable_winding_dbar_product()))
  log.attempt("COMPLEX_GREEN_ALT", () => sthm(@green.complex_green_alt()))
  log.attempt("COMPLEX_GREEN", () => sthm(@green.complex_green()))
  log.attempt("COMPLEX_GREEN_INSIDE", () => sthm(@green.complex_green_inside()))
  log.attempt("HAS_PATH_INTEGRAL_CNJ", () => sthm(@green.has_path_integral_cnj()))
  log.attempt("COMPLEX_GREEN_CNJ", () => sthm(@green.complex_green_cnj()))
  log.attempt("HAS_PATH_INTEGRAL_I_CLOSED", () => sthm(@green.has_path_integral_i_closed()))
  log.attempt("COMPLEX_GREEN_I", () => sthm(@green.complex_green_i()))
  log.attempt("COMPLEX_GREEN_AREA", () => sthm(@green.complex_green_area()))
  log.attempt("COMPLEX_GREEN_AREA_ABS", () => sthm(@green.complex_green_area_abs()))
  log.attempt("GREEN_THEOREM_CURL", () => sthm(@green.green_theorem_curl()))
  log.attempt("GREEN_AREA", () => sthm(@green.green_area()))
  log.attempt("GREEN_AREA_ALT", () => sthm(@green.green_area_alt()))
  log.attempt("GREEN_AREA_ABS", () => sthm(@green.green_area_abs()))
  log.attempt("GREEN_AREA_ABS_ALT", () => sthm(@green.green_area_abs_alt()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
