}

///|
/// `SUBADDITIVE_TAC`
pub fn subadditive_tac(x380 : @list.List[(String, @kernel.Thm)], x381 : @kernel.Term) -> @tactics.Goalstate raise {
  let (asl, w) = (x380, x381)
  let lhs = @equal.lhand(w)
  let prob_p = @kernel.rator(lhs)
  let union_set = @kernel.rand(lhs)
  let a_set = @equal.lhand(union_set)
  let b_set = @kernel.rand(union_set)
  let p_tm = @kernel.rand(prob_p)
  let ith = @bool.ispecl(@list.List([p_tm, a_set, b_set]), @probability_measure.prob_subadditive())
  let ant = @basics.dest_imp(@kernel.concl(ith)).0
  (@tactics.null_meta, @list.List([(asl, ant)]), fn(x382 : (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), x383 : @list.List[@kernel.Thm]) -> @kernel.Thm raise {
    let i = x382
    match x383 {
      More(pth, tail=Empty) => {
        let ith_p = @drule.instantiate_all(i, ith)
        let th = @bool.mp(ith_p, pth)
        if (@kernel.concl(th) == w) {
          th
        } else {
          let t384 = @kernel.rand(w)
          let rhs_eq = @equal.alpha_rule(@kernel.rand(@kernel.concl(th)), t384)
          @kernel.eq_mp(@equal.ap_term(@kernel.rator(@kernel.concl(th)), rhs_eq), th)
        }
      }
      _ => raise @lib.MatchFailure("tscript.ml:504")
    }
  })
}

///|
/// `PROB_ZERO_TAC`
pub fn prob_zero_tac(x385 : @list.List[(String, @kernel.Thm)], x386 : @kernel.Term) -> @tactics.Goalstate raise {
  let (asl, w) = (x385, x386)
  let prob_y = @kernel.rand(@equal.lhand(w))
  let target_eq = @basics.mk_eq(prob_y, @parser.parse_term("&0"))
  let (_, asm_th) = @lib.find(fn(x387 : (String, @kernel.Thm)) -> Bool raise {
    let (_, th) = x387
    try {
      let (l, r) = @kernel.dest_eq(@kernel.concl(th))
      (@basics.aconv(l, prob_y) && (r == @parser.parse_term("&0")))
    } catch {
      _ => false
    }
  }, asl)
  let bridge = if (@kernel.concl(asm_th) == target_eq) {
    asm_th
  } else {
    @kernel.eq_mp(@equal.alpha_rule(@kernel.concl(asm_th), target_eq), asm_th)
  }
  let t388 = @simp.rewrite_tac(@list.List([@calc_int.real_add_rid()]))
  @tactics.then_tac(@tactics.subst1_tac(bridge), t388)((asl, w))
}

