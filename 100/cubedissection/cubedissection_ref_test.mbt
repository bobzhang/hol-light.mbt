// Load-fidelity test for 100/cubedissection.ml: replays tools/ocaml_ref/100_cubedissection_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/cubedissection matches 100/cubedissection.ml" {
  @cubedissection.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/wo", "Library/card", "Library/floor", "Multivariate/misc", "Library/products", "Library/iter", "Multivariate/metric", "Library/frag", "Library/prime", "Library/grouptheory", "Multivariate/homology", "Library/matroids", "Multivariate/vectors", "Library/permutations", "Multivariate/determinants", "Multivariate/topology", "Multivariate/convex", "Multivariate/paths", "Multivariate/polytope", "Multivariate/degree", "Multivariate/derivatives", "Library/binary", "Multivariate/clifford", "Multivariate/integration", "100/cubedissection"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/cubedissection")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("cube", () => sthm(@cubedissection.cube()))
  log.attempt("CUBE_IMP_NONEMPTY_INTERIOR", () => sthm(@cubedissection.cube_imp_nonempty_interior()))
  log.attempt("CUBE_IMP_NONEMPTY", () => sthm(@cubedissection.cube_imp_nonempty()))
  log.attempt("interval_length", () => sthm(@cubedissection.interval_length()))
  log.attempt("INTERVAL_LENGTH_CUBE", () => sthm(@cubedissection.interval_length_cube()))
  log.attempt("INTERVAL_LENGTH_CUBE_COMPONENT", () => sthm(@cubedissection.interval_length_cube_component()))
  log.attempt("INTERVAL_LENGTH_CUBE_POS", () => sthm(@cubedissection.interval_length_cube_pos()))
  log.attempt("VECTOR2_CUBE", () => sthm(@cubedissection.vector2_cube()))
  log.attempt("cube_dissection", () => sthm(@cubedissection.cube_dissection()))
  log.attempt("POINT_IN_MULTIPLE_DIVISION_OF_GEN", () => sthm(@cubedissection.point_in_multiple_division_of_gen()))
  log.attempt("POINT_IN_MULTIPLE_DIVISION_OF", () => sthm(@cubedissection.point_in_multiple_division_of()))
  log.attempt("CUBE_EXISTS_FORM", () => sthm(@cubedissection.cube_exists_form()))
  log.attempt("SQUARE_DISSECTION_NONEDGE", () => sthm(@cubedissection.square_dissection_nonedge()))
  log.attempt("FINITE_PAIRWISE_MINIMUM", () => sthm(@cubedissection.finite_pairwise_minimum()))
  log.attempt("valley", () => sthm(@cubedissection.valley()))
  log.attempt("DIVISION_WHOLE_IS_SINGLETON", () => sthm(@cubedissection.division_whole_is_singleton()))
  log.attempt("VALLEY_INITIAL", () => sthm(@cubedissection.valley_initial()))
  log.attempt("DIVISION_FACE_LOWERBOUND", () => sthm(@cubedissection.division_face_lowerbound()))
  log.attempt("VALLEY_FACE_INTERIOR", () => sthm(@cubedissection.valley_face_interior()))
  log.attempt("REAL_OPEN_INTERVAL_AVOID_FINITE", () => sthm(@cubedissection.real_open_interval_avoid_finite()))
  log.attempt("VALLEY_DESCENT_CONTAINMENT", () => sthm(@cubedissection.valley_descent_containment()))
  log.attempt("VALLEY_FACE_EXISTS_ANOTHER", () => sthm(@cubedissection.valley_face_exists_another()))
  log.attempt("VALLEY_DESCENT", () => sthm(@cubedissection.valley_descent()))
  log.attempt("VALLEY_IMPOSSIBLE", () => sthm(@cubedissection.valley_impossible()))
  log.attempt("ONLY_TRIVIAL_CUBE_DISSECTION_CUBE", () => sthm(@cubedissection.only_trivial_cube_dissection_cube()))
  log.attempt("ONLY_TRIVIAL_CUBE_DISSECTION", () => sthm(@cubedissection.only_trivial_cube_dissection()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
