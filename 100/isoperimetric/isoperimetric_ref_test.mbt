// Load-fidelity test for 100/isoperimetric.ml: replays tools/ocaml_ref/100_isoperimetric_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/isoperimetric matches 100/isoperimetric.ml" {
  @isoperimetric.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/wo", "Library/card", "Library/floor", "Multivariate/misc", "Library/products", "Library/iter", "Multivariate/metric", "Library/frag", "Library/prime", "Library/grouptheory", "Multivariate/homology", "Library/matroids", "Multivariate/vectors", "Library/permutations", "Multivariate/determinants", "Multivariate/topology", "Multivariate/convex", "Multivariate/paths", "Multivariate/polytope", "Multivariate/degree", "Multivariate/derivatives", "Library/binary", "Multivariate/clifford", "Multivariate/integration", "Multivariate/measure", "Multivariate/complexes", "Multivariate/canal", "Multivariate/transcendentals", "Library/binomial", "Multivariate/realanalysis", "Multivariate/moretop", "Multivariate/cauchy", "Multivariate/lpspaces", "100/green", "100/isoperimetric"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/isoperimetric")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("lemma1", () => sthm(@isoperimetric.lemma1()))
  log.attempt("lemma2", () => sthm(@isoperimetric.lemma2()))
  log.attempt("lemma3", () => sthm(@isoperimetric.lemma3()))
  log.attempt("REAL_HOELDER_BOUND_2", () => sthm(@isoperimetric.real_hoelder_bound_2()))
  log.attempt("WIRTINGER_INEQUALITY", () => sthm(@isoperimetric.wirtinger_inequality()))
  log.attempt("SCALED_WIRTINGER_INEQUALITY", () => sthm(@isoperimetric.scaled_wirtinger_inequality()))
  log.attempt("GREEN_AREA_THEOREM", () => sthm(@isoperimetric.green_area_theorem()))
  log.attempt("ISOPERIMETRIC_THEOREM_CONVEX", () => sthm(@isoperimetric.isoperimetric_theorem_convex()))
  log.attempt("STEP_LEMMA", () => sthm(@isoperimetric.step_lemma()))
  log.attempt("ISOPERIMETRIC_CONVEXIFICATION", () => sthm(@isoperimetric.isoperimetric_convexification()))
  log.attempt("ISOPERIMETRIC_CONVEXIFICATION_1", () => sthm(@isoperimetric.isoperimetric_convexification_1()))
  log.attempt("ISOPERIMETRIC_THEOREM", () => sthm(@isoperimetric.isoperimetric_theorem()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
