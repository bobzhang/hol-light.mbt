// Load-fidelity test for 100/platonic.ml: replays tools/ocaml_ref/100_platonic_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/platonic matches 100/platonic.ml" {
  @platonic.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/wo", "Library/card", "Library/floor", "Multivariate/misc", "Library/products", "Library/iter", "Multivariate/metric", "Library/frag", "Library/prime", "Library/grouptheory", "Multivariate/homology", "Library/matroids", "Multivariate/vectors", "Library/permutations", "Multivariate/determinants", "Multivariate/topology", "Multivariate/convex", "Multivariate/paths", "Multivariate/polytope", "Library/binomial", "100/inclusion_exclusion", "100/combinations", "100/polyhedron", "Multivariate/cross", "100/platonic"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/platonic")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("std_tetrahedron", () => sthm(@platonic.std_tetrahedron()))
  log.attempt("std_cube", () => sthm(@platonic.std_cube()))
  log.attempt("std_octahedron", () => sthm(@platonic.std_octahedron()))
  log.attempt("std_dodecahedron", () => sthm(@platonic.std_dodecahedron()))
  log.attempt("std_icosahedron", () => sthm(@platonic.std_icosahedron()))
  log.attempt("STD_DODECAHEDRON", () => sthm(@platonic.std_dodecahedron_v1()))
  log.attempt("STD_ICOSAHEDRON", () => sthm(@platonic.std_icosahedron_v1()))
  log.attempt("COMPUTE_FACES_2", () => sthm(@platonic.compute_faces_2()))
  log.attempt("COMPUTE_FACES_2_STEP_1", () => sthm(@platonic.compute_faces_2_step_1()))
  log.attempt("COMPUTE_FACES_2_STEP_2", () => sthm(@platonic.compute_faces_2_step_2()))
  log.attempt("TETRAHEDRON_FACETS", () => sthm(@platonic.tetrahedron_facets()))
  log.attempt("CUBE_FACETS", () => sthm(@platonic.cube_facets()))
  log.attempt("OCTAHEDRON_FACETS", () => sthm(@platonic.octahedron_facets()))
  log.attempt("ICOSAHEDRON_FACETS", () => sthm(@platonic.icosahedron_facets()))
  log.attempt("DODECAHEDRON_FACETS", () => sthm(@platonic.dodecahedron_facets()))
  log.attempt("COMPUTE_FACES_1", () => sthm(@platonic.compute_faces_1()))
  log.attempt("CARD_EQ_LEMMA", () => sthm(@platonic.card_eq_lemma()))
  log.attempt("TETRAHEDRON_EDGES_PER_FACE", () => sthm(@platonic.tetrahedron_edges_per_face()))
  log.attempt("CUBE_EDGES_PER_FACE", () => sthm(@platonic.cube_edges_per_face()))
  log.attempt("OCTAHEDRON_EDGES_PER_FACE", () => sthm(@platonic.octahedron_edges_per_face()))
  log.attempt("DODECAHEDRON_EDGES_PER_FACE", () => sthm(@platonic.dodecahedron_edges_per_face()))
  log.attempt("ICOSAHEDRON_EDGES_PER_FACE", () => sthm(@platonic.icosahedron_edges_per_face()))
  log.attempt("POLYTOPE_3D_LEMMA", () => sthm(@platonic.polytope_3d_lemma()))
  log.attempt("STD_TETRAHEDRON_FULLDIM", () => sthm(@platonic.std_tetrahedron_fulldim()))
  log.attempt("STD_CUBE_FULLDIM", () => sthm(@platonic.std_cube_fulldim()))
  log.attempt("STD_OCTAHEDRON_FULLDIM", () => sthm(@platonic.std_octahedron_fulldim()))
  log.attempt("STD_DODECAHEDRON_FULLDIM", () => sthm(@platonic.std_dodecahedron_fulldim()))
  log.attempt("STD_ICOSAHEDRON_FULLDIM", () => sthm(@platonic.std_icosahedron_fulldim()))
  log.attempt("TETRAHEDRON_EDGES", () => sthm(@platonic.tetrahedron_edges()))
  log.attempt("CUBE_EDGES", () => sthm(@platonic.cube_edges()))
  log.attempt("OCTAHEDRON_EDGES", () => sthm(@platonic.octahedron_edges()))
  log.attempt("DODECAHEDRON_EDGES", () => sthm(@platonic.dodecahedron_edges()))
  log.attempt("ICOSAHEDRON_EDGES", () => sthm(@platonic.icosahedron_edges()))
  log.attempt("TETRAHEDRON_VERTICES", () => sthm(@platonic.tetrahedron_vertices()))
  log.attempt("CUBE_VERTICES", () => sthm(@platonic.cube_vertices()))
  log.attempt("OCTAHEDRON_VERTICES", () => sthm(@platonic.octahedron_vertices()))
  log.attempt("DODECAHEDRON_VERTICES", () => sthm(@platonic.dodecahedron_vertices()))
  log.attempt("ICOSAHEDRON_VERTICES", () => sthm(@platonic.icosahedron_vertices()))
  log.attempt("TETRAHEDRON_EDGES_PER_VERTEX", () => sthm(@platonic.tetrahedron_edges_per_vertex()))
  log.attempt("CUBE_EDGES_PER_VERTEX", () => sthm(@platonic.cube_edges_per_vertex()))
  log.attempt("OCTAHEDRON_EDGES_PER_VERTEX", () => sthm(@platonic.octahedron_edges_per_vertex()))
  log.attempt("DODECAHEDRON_EDGES_PER_VERTEX", () => sthm(@platonic.dodecahedron_edges_per_vertex()))
  log.attempt("ICOSAHEDRON_EDGES_PER_VERTEX", () => sthm(@platonic.icosahedron_edges_per_vertex()))
  log.attempt("MULTIPLE_COUNTING_LEMMA", () => sthm(@platonic.multiple_counting_lemma()))
  log.attempt("SIZE_ZERO_DIMENSIONAL_FACES", () => sthm(@platonic.size_zero_dimensional_faces()))
  log.attempt("PLATONIC_SOLIDS_LIMITS", () => sthm(@platonic.platonic_solids_limits()))
  log.attempt("PLATONIC_SOLIDS", () => sthm(@platonic.platonic_solids()))
  log.attempt("congruent", () => sthm(@platonic.congruent()))
  log.attempt("CONGRUENT_SIMPLE", () => sthm(@platonic.congruent_simple()))
  log.attempt("CONGRUENT_SEGMENTS", () => sthm(@platonic.congruent_segments()))
  log.attempt("MATRIX_VECTOR_MUL_3", () => sthm(@platonic.matrix_vector_mul_3()))
  log.attempt("MATRIX_LEMMA", () => sthm(@platonic.matrix_lemma()))
  log.attempt("MATRIX_BY_CRAMER_LEMMA", () => sthm(@platonic.matrix_by_cramer_lemma()))
  log.attempt("MATRIX_BY_CRAMER", () => sthm(@platonic.matrix_by_cramer()))
  log.attempt("TETRAHEDRON_CONGRUENT_EDGES", () => sthm(@platonic.tetrahedron_congruent_edges()))
  log.attempt("TETRAHEDRON_CONGRUENT_FACETS", () => sthm(@platonic.tetrahedron_congruent_facets()))
  log.attempt("CUBE_CONGRUENT_EDGES", () => sthm(@platonic.cube_congruent_edges()))
  log.attempt("CUBE_CONGRUENT_FACETS", () => sthm(@platonic.cube_congruent_facets()))
  log.attempt("OCTAHEDRON_CONGRUENT_EDGES", () => sthm(@platonic.octahedron_congruent_edges()))
  log.attempt("OCTAHEDRON_CONGRUENT_FACETS", () => sthm(@platonic.octahedron_congruent_facets()))
  log.attempt("DODECAHEDRON_CONGRUENT_EDGES", () => sthm(@platonic.dodecahedron_congruent_edges()))
  log.attempt("DODECAHEDRON_CONGRUENT_FACETS", () => sthm(@platonic.dodecahedron_congruent_facets()))
  log.attempt("ICOSAHEDRON_CONGRUENT_EDGES", () => sthm(@platonic.icosahedron_congruent_edges()))
  log.attempt("ICOSAHEDRON_CONGRUENT_FACETS", () => sthm(@platonic.icosahedron_congruent_facets()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
