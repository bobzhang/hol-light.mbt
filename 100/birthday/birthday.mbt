let birthday_thm_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("BIRTHDAY_THM")

///|
/// `BIRTHDAY_THM`
pub fn birthday_thm() -> @kernel.Thm {
  birthday_thm_c.get()
}

///|
/// FACT_DIV_SIMP
fn step_11() -> Unit raise {
  let t220 = @simp.rewrite_tac(@list.List([@arith.add_clauses(), @arith.fact()]))
  let t218 = @equal.gsym(fact_div_mult())
  let t219 = @simp.simp_tac(@list.List([@equal.gsym(@arith.mult_assoc()), t218, @arith.le_add()]))
  let t217 = @simp.rewrite_tac(@list.List([@arith.fact()]))
  let t216 = @simp.rewrite_tac(@list.List([@arith.fact_lt(), @int.arith_rule(@parser.parse_term("x + 0 = x"))]))
  let t215 = @tactics.exists_tac(@parser.parse_term("0"))
  let t214 = @tactics.match_mp_tac(@arith.div_uniq())
  let t213 = @simp.rewrite_tac(@list.List([@int.arith_rule(@parser.parse_term("(m + SUC d) - 1 = m + d")), @arith.add_sub2()]))
  let t212 = @simp.rewrite_tac(@list.List([@int.arith_rule(@parser.parse_term("(m + SUC d) - 1 - m = d"))]))
  let t211 = @simp.simp_tac(@list.List([@theorems.left_forall_imp_thm(), @theorems.exists_refl()]))
  let t210 = @simp.once_rewrite_tac(@list.List([@theorems.swap_forall_thm()]))
  let t221 = @tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.gen_tac, @simp.rewrite_tac(@list.List([@arith.lt_exists(), @theorems.left_imp_exists_thm()]))), t210), t211), t212), t213), @tactics.gen_tac), t214), t215), t216), t217), t219), t220)
  fact_div_simp_c.set(@tactics.prove(@parser.parse_term("!m n. m < n\n         ==> (FACT n) DIV (FACT m) = n * FACT(n - 1) DIV FACT(m)"), t221))
}

///|
let fact_div_simp_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("FACT_DIV_SIMP")

///|
/// `FACT_DIV_SIMP`
pub fn fact_div_simp() -> @kernel.Thm {
  fact_div_simp_c.get()
}

///|
/// BIRTHDAY_THM_EXPLICIT
fn step_12() -> Unit raise {
  let t241 = @tactics.conv_tac(@calc_num.num_reduce_conv)
  let t240 = @simp.asm_rewrite_tac(@list.empty())
  let t239 = @tactics.repeat_tac(@tactics.strip_tac)
  let t238 = @simp.rewrite_tac(@list.List([@sets.has_size()]))
  let t237 = @simp.simp_tac(@list.List([@arith.div_refl(), @equal.gsym(@arith.lt_nz()), @arith.fact_lt()]))
  let t235 = @tactics.conv_tac(@equal.once_depth_conv(@calc_num.num_sub_conv))
  let t236 = @tactics.repeat_tac(@tactics.changed_tac(@tactics.then_tac(@simp.simp_tac(@list.List([fact_div_simp(), @calc_num.arith_le(), @calc_num.arith_lt()])), t235)))
  let t234 = @tactics.conv_tac(@equal.once_depth_conv(@calc_num.num_sub_conv))
  let t231 = @drule.match_mp(has_size_funspace())
  let t233 = @tactics.first_assum(fn(x232 : @kernel.Thm) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise) raise {
    (fn(x228 : @kernel.Thm) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise) raise {
      let s229 = @tactics.mp_tac(x228)
      fn(x230 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise {
        s229(x230)
      }
    })(t231(x232))
  })
  let t225 = @drule.match_mp(birthday_thm())
  let t227 = @tactics.first_assum(fn(x226 : @kernel.Thm) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise) raise {
    (fn(x222 : @kernel.Thm) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise) raise {
      let s223 = @tactics.mp_tac(x222)
      fn(x224 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise {
        s223(x224)
      }
    })(t225(x226))
  })
  let t242 = @tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), @tactics.disch_tac), t227), t233), t234), t236), t237), t238), t239), t240), t241)
  birthday_thm_explicit_c.set(@tactics.prove(@parser.parse_term("!s t. s HAS_SIZE 23 /\\ t HAS_SIZE 365\n         ==> 2 * CARD {f | f IN (s --> t) /\\\n                           ?x y. x IN s /\\ y IN s /\\ ~(x = y) /\\ f(x) = f(y)}\n             >= CARD (s --> t)"), t242))
}

