// Load-fidelity test for 100/stirling.ml: replays tools/ocaml_ref/100_stirling_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/stirling matches 100/stirling.ml" {
  @stirling.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/analysis", "Library/transc", "100/stirling"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/stirling")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("ODDEVEN_INDUCT", () => sthm(@stirling.oddeven_induct()))
  log.attempt("LN_LIM_BOUND", () => sthm(@stirling.ln_lim_bound()))
  log.attempt("LN_LIM_LEMMA", () => sthm(@stirling.ln_lim_lemma()))
  log.attempt("POSITIVE_DIFF_LEMMA", () => sthm(@stirling.positive_diff_lemma()))
  log.attempt("stirling", () => sthm(@stirling.stirling()))
  log.attempt("STIRLING_DIFF", () => sthm(@stirling.stirling_diff()))
  log.attempt("STIRLING_DELTA_DERIV", () => sthm(@stirling.stirling_delta_deriv()))
  log.attempt("STIRLING_DELTA_LIMIT", () => sthm(@stirling.stirling_delta_limit()))
  log.attempt("STIRLING_DECREASES", () => sthm(@stirling.stirling_decreases()))
  log.attempt("OTHER_DERIV_LEMMA", () => sthm(@stirling.other_deriv_lemma()))
  log.attempt("STIRLING_INCREASES", () => sthm(@stirling.stirling_increases()))
  log.attempt("STIRLING_UPPERBOUND", () => sthm(@stirling.stirling_upperbound()))
  log.attempt("STIRLING_LOWERBOUND", () => sthm(@stirling.stirling_lowerbound()))
  log.attempt("STIRLING_MONO", () => sthm(@stirling.stirling_mono()))
  log.attempt("STIRLING_CONVERGES", () => sthm(@stirling.stirling_converges()))
  log.attempt("PI2_LT", () => sthm(@stirling.pi2_lt()))
  log.attempt("PI2_LE", () => sthm(@stirling.pi2_le()))
  log.attempt("PI2_NZ", () => sthm(@stirling.pi2_nz()))
  log.attempt("WALLIS_PARTS", () => sthm(@stirling.wallis_parts()))
  log.attempt("WALLIS_PARTS'", () => sthm(@stirling.wallis_parts_p()))
  log.attempt("WALLIS_0", () => sthm(@stirling.wallis_0()))
  log.attempt("WALLIS_1", () => sthm(@stirling.wallis_1()))
  log.attempt("WALLIS_EVEN", () => sthm(@stirling.wallis_even()))
  log.attempt("WALLIS_ODD", () => sthm(@stirling.wallis_odd()))
  log.attempt("WALLIS_QUOTIENT", () => sthm(@stirling.wallis_quotient()))
  log.attempt("WALLIS_QUOTIENT'", () => sthm(@stirling.wallis_quotient_p()))
  log.attempt("WALLIS_MONO", () => sthm(@stirling.wallis_mono()))
  log.attempt("WALLIS_LT", () => sthm(@stirling.wallis_lt()))
  log.attempt("WALLIS_NZ", () => sthm(@stirling.wallis_nz()))
  log.attempt("WALLIS_BOUNDS", () => sthm(@stirling.wallis_bounds()))
  log.attempt("WALLIS_RATIO_BOUNDS", () => sthm(@stirling.wallis_ratio_bounds()))
  log.attempt("WALLIS", () => sthm(@stirling.wallis()))
  log.attempt("LN_WALLIS", () => sthm(@stirling.ln_wallis()))
  log.attempt("STIRLING", () => sthm(@stirling.stirling_v1()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
