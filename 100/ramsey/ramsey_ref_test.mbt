// Load-fidelity test for 100/ramsey.ml: replays tools/ocaml_ref/100_ramsey_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/ramsey matches 100/ramsey.ml" {
  @ramsey.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "100/ramsey"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/ramsey")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("AND1_THM", () => sthm(@ramsey.and1_thm()))
  log.attempt("AND2_THM", () => sthm(@ramsey.and2_thm()))
  log.attempt("AND_IMP_INTRO", () => sthm(@ramsey.and_imp_intro()))
  log.attempt("AND_INTRO_THM", () => sthm(@ramsey.and_intro_thm()))
  log.attempt("BOOL_EQ_DISTINCT", () => sthm(@ramsey.bool_eq_distinct()))
  log.attempt("EQ_EXPAND", () => sthm(@ramsey.eq_expand()))
  log.attempt("EQ_IMP_THM", () => sthm(@ramsey.eq_imp_thm()))
  log.attempt("FALSITY", () => sthm(@ramsey.falsity()))
  log.attempt("F_IMP", () => sthm(@ramsey.f_imp()))
  log.attempt("IMP_DISJ_THM", () => sthm(@ramsey.imp_disj_thm()))
  log.attempt("IMP_F", () => sthm(@ramsey.imp_f()))
  log.attempt("IMP_F_EQ_F", () => sthm(@ramsey.imp_f_eq_f()))
  log.attempt("LEFT_AND_OVER_OR", () => sthm(@ramsey.left_and_over_or()))
  log.attempt("LEFT_OR_OVER_AND", () => sthm(@ramsey.left_or_over_and()))
  log.attempt("NOT_AND", () => sthm(@ramsey.not_and()))
  log.attempt("NOT_F", () => sthm(@ramsey.not_f()))
  log.attempt("OR_ELIM_THM", () => sthm(@ramsey.or_elim_thm()))
  log.attempt("OR_IMP_THM", () => sthm(@ramsey.or_imp_thm()))
  log.attempt("OR_INTRO_THM1", () => sthm(@ramsey.or_intro_thm1()))
  log.attempt("OR_INTRO_THM2", () => sthm(@ramsey.or_intro_thm2()))
  log.attempt("RIGHT_AND_OVER_OR", () => sthm(@ramsey.right_and_over_or()))
  log.attempt("RIGHT_OR_OVER_AND", () => sthm(@ramsey.right_or_over_and()))
  log.attempt("ZERO_LESS_EQ", () => sthm(@ramsey.zero_less_eq()))
  log.attempt("LESS_EQ_MONO", () => sthm(@ramsey.less_eq_mono()))
  log.attempt("NOT_LESS", () => sthm(@ramsey.not_less()))
  log.attempt("LESS_0", () => sthm(@ramsey.less_0()))
  log.attempt("LESS_EQ_REFL", () => sthm(@ramsey.less_eq_refl()))
  log.attempt("LESS_EQUAL_ANTISYM", () => sthm(@ramsey.less_equal_antisym()))
  log.attempt("NOT_LESS_0", () => sthm(@ramsey.not_less_0()))
  log.attempt("LESS_TRANS", () => sthm(@ramsey.less_trans()))
  log.attempt("LESS_LEMMA1", () => sthm(@ramsey.less_lemma1()))
  log.attempt("LESS_SUC_REFL", () => sthm(@ramsey.less_suc_refl()))
  log.attempt("FACT_LESS", () => sthm(@ramsey.fact_less()))
  log.attempt("LESS_EQ_SUC_REFL", () => sthm(@ramsey.less_eq_suc_refl()))
  log.attempt("LESS_EQ_ADD", () => sthm(@ramsey.less_eq_add()))
  log.attempt("GREATER_EQ", () => sthm(@ramsey.greater_eq()))
  log.attempt("LESS_EQUAL_ADD", () => sthm(@ramsey.less_equal_add()))
  log.attempt("LESS_EQ_IMP_LESS_SUC", () => sthm(@ramsey.less_eq_imp_less_suc()))
  log.attempt("LESS_IMP_LESS_OR_EQ", () => sthm(@ramsey.less_imp_less_or_eq()))
  log.attempt("LESS_MONO_ADD", () => sthm(@ramsey.less_mono_add()))
  log.attempt("LESS_SUC", () => sthm(@ramsey.less_suc()))
  log.attempt("LESS_CASES", () => sthm(@ramsey.less_cases()))
  log.attempt("LESS_EQ", () => sthm(@ramsey.less_eq()))
  log.attempt("LESS_OR_EQ", () => sthm(@ramsey.less_or_eq()))
  log.attempt("LESS_ADD_1", () => sthm(@ramsey.less_add_1()))
  log.attempt("SUC_SUB1", () => sthm(@ramsey.suc_sub1()))
  log.attempt("LESS_MONO_EQ", () => sthm(@ramsey.less_mono_eq()))
  log.attempt("LESS_ADD_SUC", () => sthm(@ramsey.less_add_suc()))
  log.attempt("LESS_REFL", () => sthm(@ramsey.less_refl()))
  log.attempt("INV_SUC_EQ", () => sthm(@ramsey.inv_suc_eq()))
  log.attempt("LESS_EQ_CASES", () => sthm(@ramsey.less_eq_cases()))
  log.attempt("LESS_EQ_TRANS", () => sthm(@ramsey.less_eq_trans()))
  log.attempt("LESS_THM", () => sthm(@ramsey.less_thm()))
  log.attempt("GREATER", () => sthm(@ramsey.greater()))
  log.attempt("LESS_EQ_0", () => sthm(@ramsey.less_eq_0()))
  log.attempt("OR_LESS", () => sthm(@ramsey.or_less()))
  log.attempt("SUB_EQUAL_0", () => sthm(@ramsey.sub_equal_0()))
  log.attempt("SUB_MONO_EQ", () => sthm(@ramsey.sub_mono_eq()))
  log.attempt("NOT_SUC_LESS_EQ", () => sthm(@ramsey.not_suc_less_eq()))
  log.attempt("SUC_NOT", () => sthm(@ramsey.suc_not()))
  log.attempt("LESS_LESS_CASES", () => sthm(@ramsey.less_less_cases()))
  log.attempt("NOT_LESS_EQUAL", () => sthm(@ramsey.not_less_equal()))
  log.attempt("LESS_EQ_EXISTS", () => sthm(@ramsey.less_eq_exists()))
  log.attempt("LESS_MONO_ADD_EQ", () => sthm(@ramsey.less_mono_add_eq()))
  log.attempt("LESS_LESS_EQ_TRANS", () => sthm(@ramsey.less_less_eq_trans()))
  log.attempt("SUB_SUB", () => sthm(@ramsey.sub_sub()))
  log.attempt("LESS_CASES_IMP", () => sthm(@ramsey.less_cases_imp()))
  log.attempt("SUB_LESS_EQ", () => sthm(@ramsey.sub_less_eq()))
  log.attempt("SUB_EQ_EQ_0", () => sthm(@ramsey.sub_eq_eq_0()))
  log.attempt("SUB_LEFT_LESS_EQ", () => sthm(@ramsey.sub_left_less_eq()))
  log.attempt("SUB_LEFT_GREATER_EQ", () => sthm(@ramsey.sub_left_greater_eq()))
  log.attempt("LESS_EQ_LESS_TRANS", () => sthm(@ramsey.less_eq_less_trans()))
  log.attempt("LESS_0_CASES", () => sthm(@ramsey.less_0_cases()))
  log.attempt("LESS_OR", () => sthm(@ramsey.less_or()))
  log.attempt("SUB", () => sthm(@ramsey.sub()))
  log.attempt("LESS_MULT_MONO", () => sthm(@ramsey.less_mult_mono()))
  log.attempt("LESS_MONO_MULT", () => sthm(@ramsey.less_mono_mult()))
  log.attempt("LESS_MULT2", () => sthm(@ramsey.less_mult2()))
  log.attempt("SUBSET_FINITE", () => sthm(@ramsey.subset_finite()))
  log.attempt("LESS_EQ_SUC", () => sthm(@ramsey.less_eq_suc()))
  log.attempt("INFINITE_MEMBER", () => sthm(@ramsey.infinite_member()))
  log.attempt("INFINITE_CHOOSE", () => sthm(@ramsey.infinite_choose()))
  log.attempt("INFINITE_DELETE", () => sthm(@ramsey.infinite_delete()))
  log.attempt("INFINITE_INSERT", () => sthm(@ramsey.infinite_insert()))
  log.attempt("SIZE_INSERT", () => sthm(@ramsey.size_insert()))
  log.attempt("SIZE_DELETE", () => sthm(@ramsey.size_delete()))
  log.attempt("SIZE_EXISTS", () => sthm(@ramsey.size_exists()))
  log.attempt("SUBSET_DELETE", () => sthm(@ramsey.subset_delete()))
  log.attempt("INFINITE_FINITE_CHOICE", () => sthm(@ramsey.infinite_finite_choice()))
  log.attempt("IMAGE_WOP_LEMMA", () => sthm(@ramsey.image_wop_lemma()))
  log.attempt("COLOURING_LEMMA", () => sthm(@ramsey.colouring_lemma()))
  log.attempt("COLOURING_THM", () => sthm(@ramsey.colouring_thm()))
  log.attempt("RAMSEY_LEMMA1", () => sthm(@ramsey.ramsey_lemma1()))
  log.attempt("RAMSEY_LEMMA2", () => sthm(@ramsey.ramsey_lemma2()))
  log.attempt("RAMSEY_LEMMA3", () => sthm(@ramsey.ramsey_lemma3()))
  log.attempt("RAMSEY", () => sthm(@ramsey.ramsey()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
