// Load-fidelity test for 100/derangements.ml: replays tools/ocaml_ref/100_derangements_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/derangements matches 100/derangements.ml" {
  @derangements.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/analysis", "Library/transc", "Library/calc_real", "Library/floor", "100/derangements"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/derangements")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("PAIR_BETA_THM", () => sthm(@derangements.pair_beta_thm()))
  log.attempt("domain", () => sthm(@derangements.domain()))
  log.attempt("range", () => sthm(@derangements.range()))
  log.attempt("compose", () => sthm(@derangements.compose()))
  log.attempt("id", () => sthm(@derangements.id()))
  log.attempt("converse", () => sthm(@derangements.converse()))
  log.attempt("swap", () => sthm(@derangements.swap()))
  log.attempt("pairsup", () => sthm(@derangements.pairsup()))
  log.attempt("permutes", () => sthm(@derangements.permutes()))
  log.attempt("deranges", () => sthm(@derangements.deranges()))
  log.attempt("CONVERSE_COMPOSE", () => sthm(@derangements.converse_compose()))
  log.attempt("CONVERSE_CONVERSE", () => sthm(@derangements.converse_converse()))
  log.attempt("PAIRSUP_EXPLICIT", () => sthm(@derangements.pairsup_explicit()))
  log.attempt("PERMUTES_EXPLICIT", () => sthm(@derangements.permutes_explicit()))
  log.attempt("PAIRSUP_DOMRAN", () => sthm(@derangements.pairsup_domran()))
  log.attempt("PERMUTES_DOMRAN", () => sthm(@derangements.permutes_domran()))
  log.attempt("PAIRSUP_FUNCTIONAL", () => sthm(@derangements.pairsup_functional()))
  log.attempt("PERMUTES_FUNCTIONAL", () => sthm(@derangements.permutes_functional()))
  log.attempt("PAIRSUP_COFUNCTIONAL", () => sthm(@derangements.pairsup_cofunctional()))
  log.attempt("PERMUTES_COFUNCTIONAL", () => sthm(@derangements.permutes_cofunctional()))
  log.attempt("PAIRSUP_ID", () => sthm(@derangements.pairsup_id()))
  log.attempt("PERMUTES_ID", () => sthm(@derangements.permutes_id()))
  log.attempt("PAIRSUP_CONVERSE", () => sthm(@derangements.pairsup_converse()))
  log.attempt("PERMUTES_CONVERSE", () => sthm(@derangements.permutes_converse()))
  log.attempt("PAIRSUP_COMPOSE", () => sthm(@derangements.pairsup_compose()))
  log.attempt("PERMUTES_COMPOSE", () => sthm(@derangements.permutes_compose()))
  log.attempt("PERMUTES_SWAP", () => sthm(@derangements.permutes_swap()))
  log.attempt("PAIRSUP_EMPTY", () => sthm(@derangements.pairsup_empty()))
  log.attempt("PAIRSUP_INSERT", () => sthm(@derangements.pairsup_insert()))
  log.attempt("NUMBER_OF_PAIRINGS", () => sthm(@derangements.number_of_pairings()))
  log.attempt("NUMBER_OF_PERMUTATIONS", () => sthm(@derangements.number_of_permutations()))
  log.attempt("derangements", () => sthm(@derangements.derangements()))
  log.attempt("DERANGEMENT_INDUCT", () => sthm(@derangements.derangement_induct()))
  log.attempt("DERANGEMENT_ADD2", () => sthm(@derangements.derangement_add2()))
  log.attempt("DERANGEMENT_ADD1", () => sthm(@derangements.derangement_add1()))
  log.attempt("DERANGEMENT_EMPTY", () => sthm(@derangements.derangement_empty()))
  log.attempt("DERANGEMENT_SING", () => sthm(@derangements.derangement_sing()))
  log.attempt("NUMBER_OF_DERANGEMENTS", () => sthm(@derangements.number_of_derangements()))
  log.attempt("SUM_1", () => sthm(@derangements.sum_1()))
  log.attempt("SUM_2", () => sthm(@derangements.sum_2()))
  log.attempt("DERANGEMENTS", () => sthm(@derangements.derangements_v1()))
  log.attempt("round", () => sthm(@derangements.round()))
  log.attempt("ROUND_WORKS", () => sthm(@derangements.round_works()))
  log.attempt("DERANGEMENTS_EXP", () => sthm(@derangements.derangements_exp()))
  log.attempt("THE_DERANGEMENTS_FORMULA", () => sthm(@derangements.the_derangements_formula()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
