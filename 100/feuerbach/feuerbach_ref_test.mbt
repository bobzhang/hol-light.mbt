// Load-fidelity test for 100/feuerbach.ml: replays tools/ocaml_ref/100_feuerbach_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/feuerbach matches 100/feuerbach.ml" {
  @feuerbach.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/wo", "Library/card", "Library/floor", "Multivariate/misc", "Library/products", "Library/iter", "Multivariate/metric", "Library/frag", "Library/prime", "Library/grouptheory", "Multivariate/homology", "Library/matroids", "Multivariate/vectors", "Library/permutations", "Multivariate/determinants", "Multivariate/topology", "Multivariate/convex", "100/feuerbach"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/feuerbach")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("CIRCLES_TANGENT", () => sthm(@feuerbach.circles_tangent()))
  log.attempt("FEUERBACH", () => sthm(@feuerbach.feuerbach()))
  log.attempt("NINE_POINT_CIRCLE_1", () => sthm(@feuerbach.nine_point_circle_1()))
  log.attempt("NINE_POINT_CIRCLE_2", () => sthm(@feuerbach.nine_point_circle_2()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
