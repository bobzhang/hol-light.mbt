// Load-fidelity test for 100/constructible.ml: replays tools/ocaml_ref/100_constructible_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/constructible matches 100/constructible.ml" {
  @constructible.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/prime", "Library/floor", "Library/wo", "Library/card", "Multivariate/misc", "Library/products", "Library/iter", "Multivariate/metric", "Library/frag", "Library/grouptheory", "Multivariate/homology", "Library/matroids", "Multivariate/vectors", "Library/permutations", "Multivariate/determinants", "Multivariate/topology", "Multivariate/convex", "Multivariate/paths", "Multivariate/polytope", "Multivariate/degree", "Multivariate/derivatives", "Library/binary", "Multivariate/clifford", "Multivariate/integration", "Multivariate/measure", "Multivariate/complexes", "Multivariate/canal", "Multivariate/transcendentals", "100/constructible"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/constructible")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("STEP_LEMMA", () => sthm(@constructible.step_lemma()))
  log.attempt("STEP_LEMMA_SQRT", () => sthm(@constructible.step_lemma_sqrt()))
  log.attempt("radical_RULES", () => sthm(@constructible.radical_rules()))
  log.attempt("radical_INDUCT", () => sthm(@constructible.radical_induct()))
  log.attempt("radical_CASES", () => sthm(@constructible.radical_cases()))
  log.attempt("RADICAL_RULES", () => sthm(@constructible.radical_rules_v1()))
  log.attempt("expression_INDUCT", () => sthm(@constructible.expression_induct()))
  log.attempt("expression_RECURSION", () => sthm(@constructible.expression_recursion()))
  log.attempt("value", () => sthm(@constructible.value()))
  log.attempt("wellformed", () => sthm(@constructible.wellformed()))
  log.attempt("radicals", () => sthm(@constructible.radicals()))
  log.attempt("FINITE_RADICALS", () => sthm(@constructible.finite_radicals()))
  log.attempt("WELLFORMED_RADICALS", () => sthm(@constructible.wellformed_radicals()))
  log.attempt("RADICALS_WELLFORMED", () => sthm(@constructible.radicals_wellformed()))
  log.attempt("RADICALS_SUBSET", () => sthm(@constructible.radicals_subset()))
  log.attempt("RADICAL_EXPRESSION", () => sthm(@constructible.radical_expression()))
  log.attempt("LT_MAX", () => sthm(@constructible.lt_max()))
  log.attempt("depth", () => sthm(@constructible.depth()))
  log.attempt("IN_RADICALS_SMALLER", () => sthm(@constructible.in_radicals_smaller()))
  log.attempt("NOT_IN_OWN_RADICALS", () => sthm(@constructible.not_in_own_radicals()))
  log.attempt("RADICALS_EMPTY_RATIONAL", () => sthm(@constructible.radicals_empty_rational()))
  log.attempt("FINITE_MAX", () => sthm(@constructible.finite_max()))
  log.attempt("RADICAL_TOP", () => sthm(@constructible.radical_top()))
  log.attempt("RADICAL_CANONICAL_TRIVIAL", () => sthm(@constructible.radical_canonical_trivial()))
  log.attempt("RADICAL_CANONICAL", () => sthm(@constructible.radical_canonical()))
  log.attempt("CUBIC_ROOT_STEP", () => sthm(@constructible.cubic_root_step()))
  log.attempt("CUBIC_ROOT_RADICAL_INDUCT", () => sthm(@constructible.cubic_root_radical_induct()))
  log.attempt("CUBIC_ROOT_RATIONAL", () => sthm(@constructible.cubic_root_rational()))
  log.attempt("RATIONAL_LOWEST_LEMMA", () => sthm(@constructible.rational_lowest_lemma()))
  log.attempt("RATIONAL_LOWEST", () => sthm(@constructible.rational_lowest()))
  log.attempt("RATIONAL_ROOT_INTEGER", () => sthm(@constructible.rational_root_integer()))
  log.attempt("CUBIC_ROOT_INTEGER", () => sthm(@constructible.cubic_root_integer()))
  log.attempt("length", () => sthm(@constructible.length()))
  log.attempt("parallel", () => sthm(@constructible.parallel()))
  log.attempt("collinear3", () => sthm(@constructible.collinear3()))
  log.attempt("is_intersection", () => sthm(@constructible.is_intersection()))
  log.attempt("on_circle", () => sthm(@constructible.on_circle()))
  log.attempt("SQRT_CASES_LEMMA", () => sthm(@constructible.sqrt_cases_lemma()))
  log.attempt("RADICAL_LINEAR_EQUATION", () => sthm(@constructible.radical_linear_equation()))
  log.attempt("RADICAL_SIMULTANEOUS_LINEAR_EQUATION", () => sthm(@constructible.radical_simultaneous_linear_equation()))
  log.attempt("RADICAL_QUADRATIC_EQUATION", () => sthm(@constructible.radical_quadratic_equation()))
  log.attempt("RADICAL_SIMULTANEOUS_LINEAR_QUADRATIC", () => sthm(@constructible.radical_simultaneous_linear_quadratic()))
  log.attempt("RADICAL_SIMULTANEOUS_QUADRATIC_QUADRATIC", () => sthm(@constructible.radical_simultaneous_quadratic_quadratic()))
  log.attempt("constructible_RULES", () => sthm(@constructible.constructible_rules()))
  log.attempt("constructible_INDUCT", () => sthm(@constructible.constructible_induct()))
  log.attempt("constructible_CASES", () => sthm(@constructible.constructible_cases()))
  log.attempt("RADICAL_LINE_LINE_INTERSECTION", () => sthm(@constructible.radical_line_line_intersection()))
  log.attempt("RADICAL_LINE_CIRCLE_INTERSECTION", () => sthm(@constructible.radical_line_circle_intersection()))
  log.attempt("RADICAL_CIRCLE_CIRCLE_INTERSECTION", () => sthm(@constructible.radical_circle_circle_intersection()))
  log.attempt("CONSTRUCTIBLE_RADICAL", () => sthm(@constructible.constructible_radical()))
  log.attempt("DOUBLE_THE_CUBE_ALGEBRA", () => sthm(@constructible.double_the_cube_algebra()))
  log.attempt("DOUBLE_THE_CUBE", () => sthm(@constructible.double_the_cube()))
  log.attempt("COS_TRIPLE", () => sthm(@constructible.cos_triple()))
  log.attempt("COS_PI3", () => sthm(@constructible.cos_pi3()))
  log.attempt("TRISECT_60_DEGREES_ALGEBRA", () => sthm(@constructible.trisect_60_degrees_algebra()))
  log.attempt("TRISECT_60_DEGREES", () => sthm(@constructible.trisect_60_degrees()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
