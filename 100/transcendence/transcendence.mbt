  let t353 = @parser.parse_term("i:num")
  let t354 = specialize(@list.List([@parser.parse_term("n-1"), t353]))(@binomial.binom_top_step())
  let t352 = @list.List([@tactics.then_tac(simp(@list.List([@binomial.binom()])), @int.asm_arith_tac), pass])
  let t361 = @list.List([@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.thenl(case(@parser.parse_term("i = 0")), t352), t354), t355), t356), t357), t358), t359), t360), pass])
  let t351 = subgoal(@parser.parse_term("(n - i) * binom (n,i) = binom (n - 1,i) + (n - 1) * binom (n - 1,i)"))
  let t350 = simp(@list.empty())
