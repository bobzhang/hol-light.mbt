  let t349 = @list.List([@tactics.then_tac(num_linear_fact(@parser.parse_term("i < n ==> n-i = SUC(n-1-i)")), t348), pass])
  let t363 = @tactics.then_tac(@tactics.then_tac(@tactics.thenl(@tactics.then_tac(@tactics.then_tac(@tactics.thenl(@tactics.then_tac(intro, subgoal(@parser.parse_term("FACT(n-i) = (n-i)*FACT(n-1-i)"))), t349), t350), t351), t361), t362), @int.asm_arith_tac)
