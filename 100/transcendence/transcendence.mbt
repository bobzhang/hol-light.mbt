  let t11594 = simp(@list.List([]))
  let t11592 = @equal.gsym(ring_sum_restrict_subset())
  let t11589 = @term_syntax.parse_term("(s : Cart[Real, Tybit0[Unit]]) => ring_mul(complex_ring, (B : (Cart[Real, Tybit0[Unit]]) -> Cart[Real, Tybit0[Unit]])(s), cexp(s))")
  let t11590 = @term_syntax.parse_term("(S : (Cart[Real, Tybit0[Unit]]) -> Bool)")
  let t11591 = @term_syntax.parse_term("{(s : Cart[Real, Tybit0[Unit]]) | IN(s, (S : (Cart[Real, Tybit0[Unit]]) -> Bool)) && !((B : (Cart[Real, Tybit0[Unit]]) -> Cart[Real, Tybit0[Unit]])(s) == ring_0(complex_ring))}")
  let t11593 = specialize(@list.List([@term_syntax.parse_term("complex_ring"), t11591, t11590, t11589]))(t11592)
  let t11602 = @list.List([@tactics.then_tac(@tactics.thenl(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(rw(@list.List([@equal.gsym(complex_ring_clauses())])), t11593), t11594), t11595), t11600), t11601), pass])
  let t11588 = subgoal(@term_syntax.parse_term("ring_sum(complex_ring, {(s : Cart[Real, Tybit0[Unit]]) | IN(s, (S : (Cart[Real, Tybit0[Unit]]) -> Bool)) && !((B : (Cart[Real, Tybit0[Unit]]) -> Cart[Real, Tybit0[Unit]])(s) == ring_0(complex_ring))}, (s : Cart[Real, Tybit0[Unit]]) => B(s) * cexp(s)) == Cx(real_of_num(0))"))
