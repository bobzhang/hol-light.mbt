pub fn choose2(x106 : @kernel.Term, x107 : @kernel.Term, x108 : @kernel.Term, x109 : @list.List[@kernel.Thm]) -> @tactics.Tactic raise {
  let n1 = x106
  let n2 = x107
  let p = x108
  let why = x109
  let t111 = choose(n2, p, @list.empty())
  @tactics.then_tac(choose(n1, @bool.mk_exists(n2, p), why), t111)
}

