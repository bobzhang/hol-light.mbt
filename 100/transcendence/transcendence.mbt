  let t1710 = have(@parser.parse_term("ring_powerseries(r:R ring) (x_pow r 0)"), @list.List([x_pow_series()]))
  let t1723 = @tactics.thenl(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(intro, rw(@list.List([one_minus_constx()]))), t1710), t1711), t1712), t1713), t1714), t1715), t1716), t1717), t1722)
  coeff_one_minus_constx_times_c.set(@tactics.prove(@parser.parse_term("\n  !(r:R ring) c p e.\n  c IN ring_carrier r ==>\n  ring_powerseries r p ==>\n  coeff e (poly_mul r (one_minus_constx r c) p)\n  = if e = 0 then coeff 0 p\n    else ring_sub r (coeff e p) (ring_mul r c (coeff (e-1) p))\n"), t1723))
