  let t670 = have(@term_syntax.parse_term("ring_mul((r : Ring[R]), ring_mul(r, ring_pow(r, (p : R), (e : Num)), ring_pow(r, p, (d : Num) - e)), (f : R)) == ring_mul(r, ring_pow(r, p, e), (g : R))"), @list.List([]))
