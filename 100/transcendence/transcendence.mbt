  let t1717 = case(@parser.parse_term("e = 0"))
  let t1716 = simp(@list.List([@int.arith_rule(@parser.parse_term("~(e:num < 0)"))]))
  let t1715 = simp(@list.List([coeff_const_x_pow_times()]))
  let t1714 = simp(@list.List([coeff_x_pow_times()]))
  let t1713 = rw(@list.List([coeff_poly_sub()]))
