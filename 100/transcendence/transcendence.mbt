  let t11607 = subgoal(@term_syntax.parse_term("∀ s : Cart[Real, Tybit0[Unit]], IN(s, {(s : Cart[Real, Tybit0[Unit]]) | IN(s, (S : (Cart[Real, Tybit0[Unit]]) -> Bool)) && !((B : (Cart[Real, Tybit0[Unit]]) -> Cart[Real, Tybit0[Unit]])(s) == ring_0(complex_ring))}) → !(B(s) == Cx(real_of_num(0)))"))
  let t11606 = have(@term_syntax.parse_term("∀ s : Cart[Real, Tybit0[Unit]], IN(s, {(s : Cart[Real, Tybit0[Unit]]) | IN(s, (S : (Cart[Real, Tybit0[Unit]]) -> Bool)) && !((B : (Cart[Real, Tybit0[Unit]]) -> Cart[Real, Tybit0[Unit]])(s) == ring_0(complex_ring))}) → algebraic_number(B(s))"), @list.List([@sets.subset()]))
  let t11605 = have(@term_syntax.parse_term("SUBSET({(s : Cart[Real, Tybit0[Unit]]) | IN(s, (S : (Cart[Real, Tybit0[Unit]]) -> Bool)) && !((B : (Cart[Real, Tybit0[Unit]]) -> Cart[Real, Tybit0[Unit]])(s) == ring_0(complex_ring))}, algebraic_number)"), @list.List([@sets.subset_trans()]))
  let t11603 = @term_syntax.parse_term("(s : Cart[Real, Tybit0[Unit]]) => !((B : (Cart[Real, Tybit0[Unit]]) -> Cart[Real, Tybit0[Unit]])(s) == ring_0(complex_ring))")
  let t11604 = specialize(@list.List([@term_syntax.parse_term("(S : (Cart[Real, Tybit0[Unit]]) -> Bool)"), t11603]))(@sets.finite_restrict())
  let t11601 = qed(@list.List([complex_ring_clauses()]))
  let t11599 = @tactics.conv_tac(@complexes.complex_field)
  let t11598 = simp(@list.List([]))
  let t11597 = rw(@list.List([complex_ring_clauses()]))
  let t11596 = rw(@list.List([@theorems.beta_thm(), @sets.in_elim_thm()]))
  let t11600 = @list.List([@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(sufficesby(@ringtheory.ring_sum_eq()), t11596), intro), t11597), t11598), t11599), pass])
