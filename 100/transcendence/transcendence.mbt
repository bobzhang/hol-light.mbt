  let t142 = have(@parser.parse_term("FINITE({}:X->bool)"), @list.List([@sets.finite_empty()]))
  let t153 = @tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(intro, have(@parser.parse_term("{} SUBSET S:X->bool"), @list.List([@sets.empty_subset()]))), t142), t144), t145), t148), t150), t151), t152)
