  let t410 = @parser.parse_term("v IN range(CARD(S:X->bool)) /\\ f v = x':X")
  let t416 = @tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(choose(@parser.parse_term("v:num"), t410, @list.List([@sets.in_image()])), t411), t412), t413), t414), t415)
  let t409 = simp(@list.List([@int.arith_rule(@parser.parse_term("n < 1+n"))]))
  let t408 = rw(@list.List([range_lt()]))
  let t417 = @tactics.thenl(intro, @list.List([@tactics.then_tac(@tactics.then_tac(witness(@parser.parse_term("CARD(S:X->bool)")), t408), t409), t416]))
  let t407 = qed(@list.List([@sets.in_image()]))
  let t406 = have(@parser.parse_term("v IN range(CARD(S:X->bool))"), @list.List([range_lt()]))
  let t405 = num_linear_fact(@parser.parse_term("v < 1+CARD(S:X->bool) ==> ~(v = CARD S) ==> v < CARD S"))
  let t404 = proven_if(@parser.parse_term("v = CARD(S:X->bool)"), @list.empty())
  let t418 = @list.List([@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(intro, have(@parser.parse_term("v < 1+CARD(S:X->bool)"), @list.List([range_lt()]))), t404), t405), t406), t407), t417])
  let t403 = rw(@list.List([@int.arith_rule(@parser.parse_term("SUC n = 1+n"))]))
  let t402 = simp(@list.List([@sets.extension(), in_image_vw(), @sets.in_insert(), @sets.card_clauses()]))
  let t401 = witness(@parser.parse_term("\\i:num. if i = CARD(S:X->bool) then x else f i:X"))
  let t400 = set_fact(@parser.parse_term("!s:X. s IN S ==> s IN x INSERT S"))
  let t419 = @tactics.thenl(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(set_fact(@parser.parse_term("(x:X) IN x INSERT S")), t400), t401), t402), t403), intro), splitiff), t418)
  let t420 = @list.List([rw(@list.List([@sets.card_clauses(), range_0(), @sets.image_clauses()])), t419])
  let t421 = @tactics.thenl(@tactics.then_tac(sufficesby(@sets.finite_induct_strong()), intro), t420)
  finite_ordering_c.set(@tactics.prove(@parser.parse_term("\n  !S:X->bool.\n  FINITE S ==>\n  ?f. IMAGE f (range(CARD S)) = S\n"), t421))
