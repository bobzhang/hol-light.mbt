  @tactics.remove_then(l, fn(x97 : @kernel.Thm) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise) raise {
    let th = x97
    @tactics.all_tac
  })
}

///|
/// `choose`
pub fn choose(x99 : @kernel.Term, x100 : @kernel.Term, x101 : @list.List[@kernel.Thm]) -> @tactics.Tactic raise {
  let n = x99
  let p = x100
  let why = x101
  let t105 = removelabeled("choosetmp")
  let t103 = @bool.mk_exists(n, p)
  let t104 = @tactics.x_choose_tac(n, @bool.undisch(@class.taut(@bool.mk_imp(@bool.mk_exists(n, p), t103))))
  @tactics.then_tac(@tactics.then_tac(labelhave("choosetmp", @bool.mk_exists(n, p), why), t104), t105)
}

