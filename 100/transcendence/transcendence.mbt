  let t155 = @tactics.thenl(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(intro, rw(@list.List([@sets.extension(), @sets.in_elim_thm(), @sets.in_image(), @iterate.in_numseg_0()]))), intro), splitiff), t154)
