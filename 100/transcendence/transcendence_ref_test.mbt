// Load-fidelity test for 100/transcendence.ml: replays tools/ocaml_ref/100_transcendence_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/transcendence matches 100/transcendence.ml" {
  @transcendence.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/products", "Library/binomial", "Library/iter", "Library/prime", "Library/pocklington", "Library/wo", "Library/card", "Library/ringtheory", "Library/floor", "Multivariate/misc", "Multivariate/metric", "Library/frag", "Library/grouptheory", "Multivariate/homology", "Library/matroids", "Multivariate/vectors", "Library/permutations", "Multivariate/determinants", "Multivariate/topology", "Multivariate/convex", "Multivariate/paths", "Multivariate/polytope", "Multivariate/degree", "Multivariate/derivatives", "Library/binary", "Multivariate/clifford", "Multivariate/integration", "Multivariate/measure", "Multivariate/complexes", "Multivariate/canal", "Multivariate/transcendentals", "Multivariate/realanalysis", "Multivariate/moretop", "Multivariate/cauchy", "100/transcendence"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/transcendence")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("subset_y", () => sthm(@transcendence.subset_y()))
