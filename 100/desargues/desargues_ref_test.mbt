// Load-fidelity test for 100/desargues.ml: replays tools/ocaml_ref/100_desargues_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/desargues matches 100/desargues.ml" {
  @desargues.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/wo", "Library/card", "Library/floor", "Multivariate/misc", "Library/products", "Library/iter", "Multivariate/metric", "Library/frag", "Library/prime", "Library/grouptheory", "Multivariate/homology", "Library/matroids", "Multivariate/vectors", "Library/permutations", "Multivariate/determinants", "Multivariate/topology", "Multivariate/cross", "100/desargues"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/desargues")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("NORMAL_EXISTS", () => sthm(@desargues.normal_exists()))
  log.attempt("direction_tybij", () => sthm(@desargues.direction_tybij()))
  log.attempt("perpdir", () => sthm(@desargues.perpdir()))
  log.attempt("pardir", () => sthm(@desargues.pardir()))
  log.attempt("DIRECTION_CLAUSES", () => sthm(@desargues.direction_clauses()))
  log.attempt("PARDIR_REFL", () => sthm(@desargues.pardir_refl()))
  log.attempt("PARDIR_SYM", () => sthm(@desargues.pardir_sym()))
  log.attempt("PARDIR_TRANS", () => sthm(@desargues.pardir_trans()))
  log.attempt("PARDIR_EQUIV", () => sthm(@desargues.pardir_equiv()))
  log.attempt("DIRECTION_AXIOM_1", () => sthm(@desargues.direction_axiom_1()))
  log.attempt("DIRECTION_AXIOM_2", () => sthm(@desargues.direction_axiom_2()))
  log.attempt("DIRECTION_AXIOM_3", () => sthm(@desargues.direction_axiom_3()))
  log.attempt("DIRECTION_AXIOM_4_WEAK", () => sthm(@desargues.direction_axiom_4_weak()))
  log.attempt("ORTHOGONAL_COMBINE", () => sthm(@desargues.orthogonal_combine()))
  log.attempt("DIRECTION_AXIOM_4", () => sthm(@desargues.direction_axiom_4()))
  log.attempt("PERPDIR_WELLDEF", () => sthm(@desargues.perpdir_welldef()))
  log.attempt("perpl", () => sthm(@desargues.perpl()))
  log.attempt("perpl_th", () => sthm(@desargues.perpl_th()))
  log.attempt("LINE_AXIOM_1", () => sthm(@desargues.line_axiom_1()))
  log.attempt("LINE_AXIOM_2", () => sthm(@desargues.line_axiom_2()))
  log.attempt("LINE_AXIOM_3", () => sthm(@desargues.line_axiom_3()))
  log.attempt("LINE_AXIOM_4", () => sthm(@desargues.line_axiom_4()))
  log.attempt("point_tybij", () => sthm(@desargues.point_tybij()))
  log.attempt("on", () => sthm(@desargues.on()))
  log.attempt("POINT_CLAUSES", () => sthm(@desargues.point_clauses()))
  log.attempt("AXIOM_1", () => sthm(@desargues.axiom_1()))
  log.attempt("AXIOM_2", () => sthm(@desargues.axiom_2()))
  log.attempt("AXIOM_3", () => sthm(@desargues.axiom_3()))
  log.attempt("AXIOM_4", () => sthm(@desargues.axiom_4()))
  log.attempt("projl", () => sthm(@desargues.projl()))
  log.attempt("projp", () => sthm(@desargues.projp()))
  log.attempt("PROJL_TOTAL", () => sthm(@desargues.projl_total()))
  log.attempt("homol", () => sthm(@desargues.homol()))
  log.attempt("PROJP_TOTAL", () => sthm(@desargues.projp_total()))
  log.attempt("homop_def", () => sthm(@desargues.homop_def()))
  log.attempt("homop", () => sthm(@desargues.homop()))
  log.attempt("parallel", () => sthm(@desargues.parallel()))
  log.attempt("ON_HOMOL", () => sthm(@desargues.on_homol()))
  log.attempt("EQ_HOMOL", () => sthm(@desargues.eq_homol()))
  log.attempt("EQ_HOMOP", () => sthm(@desargues.eq_homop()))
  log.attempt("PARALLEL_PROJL_HOMOL", () => sthm(@desargues.parallel_projl_homol()))
  log.attempt("PARALLEL_PROJP_HOMOP", () => sthm(@desargues.parallel_projp_homop()))
  log.attempt("PARALLEL_PROJP_HOMOP_EXPLICIT", () => sthm(@desargues.parallel_projp_homop_explicit()))
  log.attempt("bracket", () => sthm(@desargues.bracket()))
  log.attempt("COLLINEAR", () => sthm(@desargues.collinear()))
  log.attempt("COLLINEAR_SINGLETON", () => sthm(@desargues.collinear_singleton()))
  log.attempt("COLLINEAR_PAIR", () => sthm(@desargues.collinear_pair()))
  log.attempt("COLLINEAR_TRIPLE", () => sthm(@desargues.collinear_triple()))
  log.attempt("COLLINEAR_BRACKET", () => sthm(@desargues.collinear_bracket()))
  log.attempt("BRACKET_SWAP", () => sthm(@desargues.bracket_swap()))
  log.attempt("BRACKET_SHUFFLE", () => sthm(@desargues.bracket_shuffle()))
  log.attempt("DESARGUES_DIRECT", () => sthm(@desargues.desargues_direct()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
