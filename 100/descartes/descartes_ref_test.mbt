// Load-fidelity test for 100/descartes.ml: replays tools/ocaml_ref/100_descartes_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/descartes matches 100/descartes.ml" {
  @descartes.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/wo", "Library/card", "Library/floor", "Multivariate/misc", "Library/products", "Library/iter", "Multivariate/metric", "Library/frag", "Library/prime", "Library/grouptheory", "Multivariate/homology", "Library/matroids", "Multivariate/vectors", "Library/permutations", "Multivariate/determinants", "Multivariate/topology", "Multivariate/convex", "Multivariate/paths", "Multivariate/polytope", "Multivariate/degree", "Multivariate/derivatives", "Library/binary", "Multivariate/clifford", "Multivariate/integration", "Multivariate/measure", "Multivariate/complexes", "Multivariate/canal", "Multivariate/transcendentals", "Library/binomial", "Multivariate/realanalysis", "100/descartes"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/descartes")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("OPPOSITE_SIGNS", () => sthm(@descartes.opposite_signs()))
  log.attempt("VARIATION_SET_FINITE", () => sthm(@descartes.variation_set_finite()))
  log.attempt("variation", () => sthm(@descartes.variation()))
  log.attempt("VARIATION_EQ", () => sthm(@descartes.variation_eq()))
  log.attempt("VARIATION_SUBSET", () => sthm(@descartes.variation_subset()))
  log.attempt("VARIATION_SPLIT", () => sthm(@descartes.variation_split()))
  log.attempt("VARIATION_SPLIT_NUMSEG", () => sthm(@descartes.variation_split_numseg()))
  log.attempt("VARIATION_1", () => sthm(@descartes.variation_1()))
  log.attempt("VARIATION_2", () => sthm(@descartes.variation_2()))
  log.attempt("VARIATION_3", () => sthm(@descartes.variation_3()))
  log.attempt("VARIATION_OFFSET", () => sthm(@descartes.variation_offset()))
  log.attempt("ARTHAN_LEMMA", () => sthm(@descartes.arthan_lemma()))
  log.attempt("VARIATION_OPPOSITE_ENDS", () => sthm(@descartes.variation_opposite_ends()))
  log.attempt("REAL_POLYFUN_SGN_AT_INFINITY", () => sthm(@descartes.real_polyfun_sgn_at_infinity()))
  log.attempt("REAL_POLYFUN_HAS_POSITIVE_ROOT", () => sthm(@descartes.real_polyfun_has_positive_root()))
  log.attempt("ODD_VARIATION_POSITIVE_ROOT", () => sthm(@descartes.odd_variation_positive_root()))
  log.attempt("multiplicity", () => sthm(@descartes.multiplicity()))
  log.attempt("MULTIPLICITY_UNIQUE", () => sthm(@descartes.multiplicity_unique()))
  log.attempt("MULTIPLICITY_WORKS", () => sthm(@descartes.multiplicity_works()))
  log.attempt("MULTIPLICITY_OTHER_ROOT", () => sthm(@descartes.multiplicity_other_root()))
  log.attempt("VARIATION_POSITIVE_ROOT_FACTOR", () => sthm(@descartes.variation_positive_root_factor()))
  log.attempt("VARIATION_POSITIVE_ROOT_MULTIPLE_FACTOR", () => sthm(@descartes.variation_positive_root_multiple_factor()))
  log.attempt("VARIATION_POSITIVE_ROOT_MULTIPLICITY_FACTOR", () => sthm(@descartes.variation_positive_root_multiplicity_factor()))
  log.attempt("DESCARTES_RULE_OF_SIGNS", () => sthm(@descartes.descartes_rule_of_signs()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
