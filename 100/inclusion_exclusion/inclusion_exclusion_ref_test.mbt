// Load-fidelity test for 100/inclusion_exclusion.ml: replays tools/ocaml_ref/100_inclusion_exclusion_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/inclusion_exclusion matches 100/inclusion_exclusion.ml" {
  @inclusion_exclusion.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "100/inclusion_exclusion"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/inclusion_exclusion")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("SUBSET_INSERT_EXISTS", () => sthm(@inclusion_exclusion.subset_insert_exists()))
  log.attempt("INCLUSION_EXCLUSION_REAL_RESTRICTED_INDEXED", () => sthm(@inclusion_exclusion.inclusion_exclusion_real_restricted_indexed()))
  log.attempt("INCLUSION_EXCLUSION_REAL_RESTRICTED", () => sthm(@inclusion_exclusion.inclusion_exclusion_real_restricted()))
  log.attempt("INCLUSION_EXCLUSION_REAL_INDEXED", () => sthm(@inclusion_exclusion.inclusion_exclusion_real_indexed()))
  log.attempt("INCLUSION_EXCLUSION_REAL", () => sthm(@inclusion_exclusion.inclusion_exclusion_real()))
  log.attempt("INCLUSION_EXCLUSION", () => sthm(@inclusion_exclusion.inclusion_exclusion()))
  log.attempt("INCLUSION_EXCLUSION_USUAL", () => sthm(@inclusion_exclusion.inclusion_exclusion_usual()))
  log.attempt("FINITE_SUBSETS_RESTRICT", () => sthm(@inclusion_exclusion.finite_subsets_restrict()))
  log.attempt("CARD_ADJUST_LEMMA", () => sthm(@inclusion_exclusion.card_adjust_lemma()))
  log.attempt("CARD_SUBSETS_STEP", () => sthm(@inclusion_exclusion.card_subsets_step()))
  log.attempt("CARD_SUBSUPERSETS_EVEN_ODD", () => sthm(@inclusion_exclusion.card_subsupersets_even_odd()))
  log.attempt("SUM_ALTERNATING_CANCELS", () => sthm(@inclusion_exclusion.sum_alternating_cancels()))
  log.attempt("INCLUSION_EXCLUSION_SYMMETRIC", () => sthm(@inclusion_exclusion.inclusion_exclusion_symmetric()))
  log.attempt("INCLUSION_EXCLUSION_MOBIUS", () => sthm(@inclusion_exclusion.inclusion_exclusion_mobius()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
