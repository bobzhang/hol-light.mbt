// Load-fidelity test for 100/polyhedron.ml: replays tools/ocaml_ref/100_polyhedron_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/polyhedron matches 100/polyhedron.ml" {
  @polyhedron.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/wo", "Library/card", "Library/floor", "Multivariate/misc", "Library/products", "Library/iter", "Multivariate/metric", "Library/frag", "Library/prime", "Library/grouptheory", "Multivariate/homology", "Library/matroids", "Multivariate/vectors", "Library/permutations", "Multivariate/determinants", "Multivariate/topology", "Multivariate/convex", "Multivariate/paths", "Multivariate/polytope", "Library/binomial", "100/inclusion_exclusion", "100/combinations", "100/polyhedron"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/polyhedron")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("hyperplane_side", () => sthm(@polyhedron.hyperplane_side()))
  log.attempt("hyperplane_equiv", () => sthm(@polyhedron.hyperplane_equiv()))
  log.attempt("HYPERPLANE_EQUIV_REFL", () => sthm(@polyhedron.hyperplane_equiv_refl()))
  log.attempt("HYPERPLANE_EQUIV_SYM", () => sthm(@polyhedron.hyperplane_equiv_sym()))
  log.attempt("HYPERPLANE_EQUIV_TRANS", () => sthm(@polyhedron.hyperplane_equiv_trans()))
  log.attempt("HYPERPLANE_EQUIV_UNION", () => sthm(@polyhedron.hyperplane_equiv_union()))
  log.attempt("hyperplane_cell", () => sthm(@polyhedron.hyperplane_cell()))
  log.attempt("HYPERPLANE_CELL", () => sthm(@polyhedron.hyperplane_cell_v1()))
  log.attempt("NOT_HYPERPLANE_CELL_EMPTY", () => sthm(@polyhedron.not_hyperplane_cell_empty()))
  log.attempt("NONEMPTY_HYPERPLANE_CELL", () => sthm(@polyhedron.nonempty_hyperplane_cell()))
  log.attempt("UNIONS_HYPERPLANE_CELLS", () => sthm(@polyhedron.unions_hyperplane_cells()))
  log.attempt("DISJOINT_HYPERPLANE_CELLS", () => sthm(@polyhedron.disjoint_hyperplane_cells()))
  log.attempt("DISJOINT_HYPERPLANE_CELLS_EQ", () => sthm(@polyhedron.disjoint_hyperplane_cells_eq()))
  log.attempt("HYPERPLANE_CELL_EMPTY", () => sthm(@polyhedron.hyperplane_cell_empty()))
  log.attempt("HYPERPLANE_CELL_SING_CASES", () => sthm(@polyhedron.hyperplane_cell_sing_cases()))
  log.attempt("HYPERPLANE_CELL_SING", () => sthm(@polyhedron.hyperplane_cell_sing()))
  log.attempt("HYPERPLANE_CELL_UNION", () => sthm(@polyhedron.hyperplane_cell_union()))
  log.attempt("FINITE_HYPERPLANE_CELLS", () => sthm(@polyhedron.finite_hyperplane_cells()))
  log.attempt("FINITE_RESTRICT_HYPERPLANE_CELLS", () => sthm(@polyhedron.finite_restrict_hyperplane_cells()))
  log.attempt("PAIRWISE_DISJOINT_HYPERPLANE_CELLS", () => sthm(@polyhedron.pairwise_disjoint_hyperplane_cells()))
  log.attempt("HYPERPLANE_CELL_INTER_OPEN_AFFINE", () => sthm(@polyhedron.hyperplane_cell_inter_open_affine()))
  log.attempt("HYPERPLANE_CELL_RELATIVELY_OPEN", () => sthm(@polyhedron.hyperplane_cell_relatively_open()))
  log.attempt("HYPERPLANE_CELL_RELATIVE_INTERIOR", () => sthm(@polyhedron.hyperplane_cell_relative_interior()))
  log.attempt("HYPERPLANE_CELL_CONVEX", () => sthm(@polyhedron.hyperplane_cell_convex()))
  log.attempt("HYPERPLANE_CELL_INTERS", () => sthm(@polyhedron.hyperplane_cell_inters()))
  log.attempt("HYPERPLANE_CELL_INTER", () => sthm(@polyhedron.hyperplane_cell_inter()))
  log.attempt("hyperplane_cellcomplex", () => sthm(@polyhedron.hyperplane_cellcomplex()))
  log.attempt("HYPERPLANE_CELLCOMPLEX_EMPTY", () => sthm(@polyhedron.hyperplane_cellcomplex_empty()))
  log.attempt("HYPERPLANE_CELL_CELLCOMPLEX", () => sthm(@polyhedron.hyperplane_cell_cellcomplex()))
  log.attempt("HYPERPLANE_CELLCOMPLEX_UNIONS", () => sthm(@polyhedron.hyperplane_cellcomplex_unions()))
  log.attempt("HYPERPLANE_CELLCOMPLEX_UNION", () => sthm(@polyhedron.hyperplane_cellcomplex_union()))
  log.attempt("HYPERPLANE_CELLCOMPLEX_UNIV", () => sthm(@polyhedron.hyperplane_cellcomplex_univ()))
  log.attempt("HYPERPLANE_CELLCOMPLEX_INTERS", () => sthm(@polyhedron.hyperplane_cellcomplex_inters()))
  log.attempt("HYPERPLANE_CELLCOMPLEX_INTER", () => sthm(@polyhedron.hyperplane_cellcomplex_inter()))
  log.attempt("HYPERPLANE_CELLCOMPLEX_COMPL", () => sthm(@polyhedron.hyperplane_cellcomplex_compl()))
  log.attempt("HYPERPLANE_CELLCOMPLEX_DIFF", () => sthm(@polyhedron.hyperplane_cellcomplex_diff()))
  log.attempt("HYPERPLANE_CELLCOMPLEX_MONO", () => sthm(@polyhedron.hyperplane_cellcomplex_mono()))
  log.attempt("FINITE_HYPERPLANE_CELLCOMPLEXES", () => sthm(@polyhedron.finite_hyperplane_cellcomplexes()))
  log.attempt("FINITE_RESTRICT_HYPERPLANE_CELLCOMPLEXES", () => sthm(@polyhedron.finite_restrict_hyperplane_cellcomplexes()))
  log.attempt("FINITE_SET_OF_HYPERPLANE_CELLS", () => sthm(@polyhedron.finite_set_of_hyperplane_cells()))
  log.attempt("CELL_SUBSET_CELLCOMPLEX", () => sthm(@polyhedron.cell_subset_cellcomplex()))
  log.attempt("euler_characteristic", () => sthm(@polyhedron.euler_characteristic()))
  log.attempt("EULER_CHARACTERISTIC_EMPTY", () => sthm(@polyhedron.euler_characteristic_empty()))
  log.attempt("EULER_CHARACTERISTIC_CELL_UNIONS", () => sthm(@polyhedron.euler_characteristic_cell_unions()))
  log.attempt("EULER_CHARACTERISTIC_CELL", () => sthm(@polyhedron.euler_characteristic_cell()))
  log.attempt("EULER_CHARACTERISTIC_CELLCOMPLEX_UNION", () => sthm(@polyhedron.euler_characteristic_cellcomplex_union()))
  log.attempt("EULER_CHARACTERISTIC_CELLCOMPLEX_UNIONS", () => sthm(@polyhedron.euler_characteristic_cellcomplex_unions()))
  log.attempt("EULER_CHARACTERISTIC", () => sthm(@polyhedron.euler_characteristic_v1()))
  log.attempt("HYPERPLANE_CELLS_DISTINCT_LEMMA", () => sthm(@polyhedron.hyperplane_cells_distinct_lemma()))
  log.attempt("EULER_CHARACTERSTIC_LEMMA", () => sthm(@polyhedron.euler_characterstic_lemma()))
  log.attempt("EULER_CHARACTERSTIC_INVARIANT", () => sthm(@polyhedron.euler_characterstic_invariant()))
  log.attempt("EULER_CHARACTERISTIC_INCLUSION_EXCLUSION", () => sthm(@polyhedron.euler_characteristic_inclusion_exclusion()))
  log.attempt("EULER_POLYHEDRAL_CONE", () => sthm(@polyhedron.euler_polyhedral_cone()))
  log.attempt("EULER_POINCARE_LEMMA", () => sthm(@polyhedron.euler_poincare_lemma()))
  log.attempt("EULER_POINCARE_SPECIAL", () => sthm(@polyhedron.euler_poincare_special()))
  log.attempt("EULER_POINCARE_FULL", () => sthm(@polyhedron.euler_poincare_full()))
  log.attempt("EULER_RELATION", () => sthm(@polyhedron.euler_relation()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
