///|
/// `bezout`
pub fn bezout(x323 : @num.Num, x324 : @num.Num) -> ((@num.Num, @num.Num)) raise {
  let (m, n) = (x323, x324)
  if @num.eq_num(m, @num.num_of_int64(0L)) {
    let t325 = @num.num_of_int64(1L)
    (@num.num_of_int64(0L), t325)
  } else {
    if @num.eq_num(n, @num.num_of_int64(0L)) {
      let t326 = @num.num_of_int64(0L)
      (@num.num_of_int64(1L), t326)
    } else {
      if @num.le_num(m, n) {
        let q = @num.quo_num(n, m)
        let r = @num.mod_num(n, m)
        let (x, y) = bezout(m, r)
        (@num.sub_num(x, @num.mult_num(q, y)), y)
      } else {
        let (x_1, y_1) = bezout(n, m)
        (y_1, x_1)
      }
    }
  }
}

