let primepow_conv_c : @lib.Cell[(@kernel.Term) -> @kernel.Thm raise] = @lib.Cell::new("PRIMEPOW_CONV")

///|
/// `PRIMEPOW_CONV`
pub fn primepow_conv(x : @kernel.Term) -> @kernel.Thm raise {
  (primepow_conv_c.get())(x)
}

///|
/// APRIMEDIVISOR_CONV
fn step_23() -> Unit raise {
  let t409 = @meson.meson_tac(@list.List([aprimedivisor_primepow()]))
  let pth = @tactics.prove(@parser.parse_term("prime p ==> 1 <= k /\\ (q = p EXP k) ==> (aprimedivisor q = p)"), t409)
  let p_tm = @parser.parse_term("p:num")
  let k_tm = @parser.parse_term("k:num")
  let q_tm = @parser.parse_term("q:num")
  let aprimedivisor_tm = @parser.parse_term("aprimedivisor")
  aprimedivisor_conv_c.set(fn(x410 : @kernel.Term) -> @kernel.Thm raise {
    let tm0 = x410
    let (ptm, tm) = @kernel.dest_comb(tm0)
    if (ptm != aprimedivisor_tm) {
      raise Failure("expected primepow(numeral)")
    } else {
      let q = @basics.dest_numeral(tm)
      if @num.eq_num(q, @num.num_of_int64(0L)) {
        raise Failure("APRIMEDIVISOR_CONV: not a prime power")
      } else {
        match @pocklington.factor(q) {
          More((p, k), tail=Empty) => {
            let t411 = (@nums.mk_numeral(k), k_tm)
            let t412 = (@nums.mk_numeral(p), p_tm)
            let th1 = @kernel.inst_rule(@list.List([(@nums.mk_numeral(q), q_tm), t412, t411]), pth)
            let th2 = @bool.mp(th1, @bool.eqt_elim(@pocklington.prime_conv(@equal.lhand(@kernel.concl(th1)))))
            @bool.mp(th2, @bool.eqt_elim(@calc_num.num_reduce_conv(@equal.lhand(@kernel.concl(th2)))))
          }
          _ => raise Failure("APRIMEDIVISOR_CONV: not a prime power")
        }
      }
    }
  })
}

///|
let aprimedivisor_conv_c : @lib.Cell[(@kernel.Term) -> @kernel.Thm raise] = @lib.Cell::new("APRIMEDIVISOR_CONV")

///|
/// `APRIMEDIVISOR_CONV`
pub fn aprimedivisor_conv(x : @kernel.Term) -> @kernel.Thm raise {
  (aprimedivisor_conv_c.get())(x)
}

///|
/// mangoldt
fn step_24() -> Unit raise {
  mangoldt_c.set(@pair.new_definition(@parser.parse_term("mangoldt d = if primepow d then ln(&(aprimedivisor d)) else &0")))
}

///|
let mangoldt_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("mangoldt")

///|
/// `mangoldt`
pub fn mangoldt() -> @kernel.Thm {
  mangoldt_c.get()
}

