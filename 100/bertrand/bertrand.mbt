///|
/// PSI_LIST
fn step_34() -> Unit raise {
  let t1225 = @simp.rewrite_tac(@list.List([psi(), @analysis.sum(), @transc.ln_1()]))
  let psi_0 = @tactics.prove(@parser.parse_term("psi(0) = ln(&1)"), t1225)
  let t1226 = @simp.rewrite_tac(@list.List([@arith.add_ac()]))
  let t1227 = @tactics.then_tac(@simp.rewrite_tac(@list.List([psi(), @analysis.sum(), @arith.add1()])), t1226)
  let psi_suc = @tactics.prove(@parser.parse_term("psi(SUC n) = psi(n) + mangoldt(SUC n)"), t1227)
  let n_tm = @parser.parse_term("n:num")
  let simper_conv : (@kernel.Term) -> @kernel.Thm raise = @simp.simp_conv(@list.List([@calc_int.real_add_rid(), @equal.gsym(@transc.ln_mul()), @realax.real_of_num_mul(), @real.real_of_num_lt(), @calc_num.arith()]))
  fn psi_list_1(x1228 : Int64) -> @list.List[@kernel.Thm] raise {
    let n = x1228
    if (n == 0L) {
      @list.List([psi_0])
    } else {
      let ths = psi_list_1(@lib.sub63(n, 1L))
      let th1 = @kernel.inst_rule(@list.List([(@nums.mk_small_numeral(@lib.sub63(n, 1L)), n_tm)]), psi_suc)
      let th2 = @simp.gen_rewrite_rule(fn(x1235 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
        (fn(x1229 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
          let s1230 = @equal.rand_conv(x1229)
          fn(x1231 : @kernel.Term) -> @kernel.Thm raise {
            s1230(x1231)
          }
        })((fn(x1232 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
          let s1233 = @equal.land_conv(x1232)
          fn(x1234 : @kernel.Term) -> @kernel.Thm raise {
            s1233(x1234)
          }
        })(x1235))
      }, @list.List([@lib.hd(ths)]))(th1)
      let th3 = @equal.conv_rule(@equal.comb_conv(@lib.funpow(2, fn(x1236 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
        let s1237 = @equal.rand_conv(x1236)
        fn(x1238 : @kernel.Term) -> @kernel.Thm raise {
          s1237(x1238)
        }
      }, @calc_num.num_suc_conv)), th2)
      let th4 = @equal.conv_rule(@lib.funpow(2, fn(x1239 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
        let s1240 = @equal.rand_conv(x1239)
        fn(x1241 : @kernel.Term) -> @kernel.Thm raise {
          s1240(x1241)
        }
      }, mangoldt_conv), th3)
      ths.prepend(@equal.conv_rule(@equal.rand_conv(simper_conv), th4))
    }
  }
  psi_list_c.set(psi_list_1)
}

