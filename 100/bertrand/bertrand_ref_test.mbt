// Load-fidelity test for 100/bertrand.ml: replays tools/ocaml_ref/100_bertrand_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/bertrand matches 100/bertrand.ml" {
  @bertrand.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/prime", "Library/iter", "Library/pocklington", "Library/analysis", "Library/transc", "Library/calc_real", "Library/floor", "100/bertrand"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/bertrand")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("ISQRT", () => sthm(@bertrand.isqrt()))
  log.attempt("ISQRT_WORKS", () => sthm(@bertrand.isqrt_works()))
  log.attempt("ISQRT_0", () => sthm(@bertrand.isqrt_0()))
  log.attempt("ISQRT_UNIQUE", () => sthm(@bertrand.isqrt_unique()))
  log.attempt("ISQRT_SUC", () => sthm(@bertrand.isqrt_suc()))
  log.attempt("LN_2_COMPOSITION", () => sthm(@bertrand.ln_2_composition()))
  log.attempt("FLOOR_DOUBLE_NUM", () => sthm(@bertrand.floor_double_num()))
  log.attempt("LN_FACT", () => sthm(@bertrand.ln_fact()))
  log.attempt("LN_FACT_BOUNDS", () => sthm(@bertrand.ln_fact_bounds()))
  log.attempt("primepow", () => sthm(@bertrand.primepow()))
  log.attempt("aprimedivisor", () => sthm(@bertrand.aprimedivisor()))
  log.attempt("PRIMEPOW_GE_2", () => sthm(@bertrand.primepow_ge_2()))
  log.attempt("PRIMEPOW_0", () => sthm(@bertrand.primepow_0()))
  log.attempt("APRIMEDIVISOR_PRIMEPOW", () => sthm(@bertrand.aprimedivisor_primepow()))
  log.attempt("APRIMEDIVISOR", () => sthm(@bertrand.aprimedivisor_v1()))
  log.attempt("BIG_POWER_LEMMA", () => sthm(@bertrand.big_power_lemma()))
  log.attempt("PRIME_PRIMEPOW", () => sthm(@bertrand.prime_primepow()))
  log.attempt("mangoldt", () => sthm(@bertrand.mangoldt()))
  log.attempt("MANGOLDT_POS", () => sthm(@bertrand.mangoldt_pos()))
  log.attempt("LN_PRIMEFACT", () => sthm(@bertrand.ln_primefact()))
  log.attempt("MANGOLDT", () => sthm(@bertrand.mangoldt_v1()))
  log.attempt("psi", () => sthm(@bertrand.psi()))
  log.attempt("PSI_BOUNDS_LN_FACT", () => sthm(@bertrand.psi_bounds_ln_fact()))
  log.attempt("LN_FACT_DIFF_BOUNDS", () => sthm(@bertrand.ln_fact_diff_bounds()))
  log.attempt("PSI_BOUNDS_INDUCT", () => sthm(@bertrand.psi_bounds_induct()))
  log.attempt("PSI_UBOUND_128", () => sthm(@bertrand.psi_ubound_128()))
  log.attempt("PSI_UBOUND_128_LOG", () => sthm(@bertrand.psi_ubound_128_log()))
  log.attempt("OVERPOWER_LEMMA", () => sthm(@bertrand.overpower_lemma()))
  log.attempt("PSI_UBOUND_1024_LOG", () => sthm(@bertrand.psi_ubound_1024_log()))
  log.attempt("PSI_BOUNDS_SUSTAINED_INDUCT", () => sthm(@bertrand.psi_bounds_sustained_induct()))
  log.attempt("PSI_BOUNDS_SUSTAINED", () => sthm(@bertrand.psi_bounds_sustained()))
  log.attempt("PSI_UBOUND_LOG", () => sthm(@bertrand.psi_ubound_log()))
  log.attempt("PSI_UBOUND_3_2", () => sthm(@bertrand.psi_ubound_3_2()))
  log.attempt("PSI_LBOUND_3_5", () => sthm(@bertrand.psi_lbound_3_5()))
  log.attempt("theta", () => sthm(@bertrand.theta()))
  log.attempt("PRIMEPOW_ODD_EVEN", () => sthm(@bertrand.primepow_odd_even()))
  log.attempt("PSI_SPLIT", () => sthm(@bertrand.psi_split()))
  log.attempt("SUM_SURJECT", () => sthm(@bertrand.sum_surject()))
  log.attempt("PSI_RESIDUES_COMPARE_2", () => sthm(@bertrand.psi_residues_compare_2()))
  log.attempt("PSI_RESIDUES_COMPARE", () => sthm(@bertrand.psi_residues_compare()))
  log.attempt("PSI_SQRT", () => sthm(@bertrand.psi_sqrt()))
  log.attempt("PSI_THETA", () => sthm(@bertrand.psi_theta()))
  log.attempt("THETA_LE_PSI", () => sthm(@bertrand.theta_le_psi()))
  log.attempt("PSI_UBOUND_30", () => sthm(@bertrand.psi_ubound_30()))
  log.attempt("THETA_UBOUND_3_2", () => sthm(@bertrand.theta_ubound_3_2()))
  log.attempt("THETA_LBOUND_1_2", () => sthm(@bertrand.theta_lbound_1_2()))
  log.attempt("FLOOR_POS", () => sthm(@bertrand.floor_pos()))
  log.attempt("FLOOR_NUM_EXISTS", () => sthm(@bertrand.floor_num_exists()))
  log.attempt("FLOOR_DIV_INTERVAL", () => sthm(@bertrand.floor_div_interval()))
  log.attempt("FLOOR_DIV_EXISTS", () => sthm(@bertrand.floor_div_exists()))
  log.attempt("FLOOR_HALF_INTERVAL", () => sthm(@bertrand.floor_half_interval()))
  log.attempt("SUM_EXPAND_LEMMA", () => sthm(@bertrand.sum_expand_lemma()))
  log.attempt("FACT_EXPAND_PSI", () => sthm(@bertrand.fact_expand_psi()))
  log.attempt("PSI_MONO", () => sthm(@bertrand.psi_mono()))
  log.attempt("PSI_POS", () => sthm(@bertrand.psi_pos()))
  log.attempt("PSI_EXPANSION_CUTOFF", () => sthm(@bertrand.psi_expansion_cutoff()))
  log.attempt("FACT_PSI_BOUND_ODD", () => sthm(@bertrand.fact_psi_bound_odd()))
  log.attempt("FACT_PSI_BOUND_EVEN", () => sthm(@bertrand.fact_psi_bound_even()))
  log.attempt("FACT_PSI_BOUND_2_3", () => sthm(@bertrand.fact_psi_bound_2_3()))
  log.attempt("PSI_DOUBLE_LEMMA", () => sthm(@bertrand.psi_double_lemma()))
  log.attempt("THETA_DOUBLE_LEMMA", () => sthm(@bertrand.theta_double_lemma()))
  log.attempt("BIG_BERTRAND", () => sthm(@bertrand.big_bertrand()))
  log.attempt("LANDAU_TRICK", () => sthm(@bertrand.landau_trick()))
  log.attempt("BERTRAND", () => sthm(@bertrand.bertrand()))
  log.attempt("pii", () => sthm(@bertrand.pii()))
  log.attempt("PRIMES_FINITE", () => sthm(@bertrand.primes_finite()))
  log.attempt("PII", () => sthm(@bertrand.pii_v1()))
  log.attempt("PII_LBOUND", () => sthm(@bertrand.pii_lbound()))
  log.attempt("PII_UBOUND_CASES_50", () => sthm(@bertrand.pii_ubound_cases_50()))
  log.attempt("THETA_POS", () => sthm(@bertrand.theta_pos()))
  log.attempt("PII_MONO", () => sthm(@bertrand.pii_mono()))
  log.attempt("PII_POS", () => sthm(@bertrand.pii_pos()))
  log.attempt("PII_CHANGE", () => sthm(@bertrand.pii_change()))
  log.attempt("PII_ISQRT_INDUCT", () => sthm(@bertrand.pii_isqrt_induct()))
  log.attempt("PII_UBOUND_5", () => sthm(@bertrand.pii_ubound_5()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
