// Load-fidelity test for 100/friendship.ml: replays tools/ocaml_ref/100_friendship_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/friendship matches 100/friendship.ml" {
  @friendship.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/prime", "Library/iter", "Library/pocklington", "100/friendship"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/friendship")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("GCD_INDUCT", () => sthm(@friendship.gcd_induct()))
  log.attempt("LOOP_GCD", () => sthm(@friendship.loop_gcd()))
  log.attempt("LOOP_COPRIME", () => sthm(@friendship.loop_coprime()))
  log.attempt("EQUIVALENCE_UNIFORM_PARTITION", () => sthm(@friendship.equivalence_uniform_partition()))
  log.attempt("EQUIVALENCE_UNIFORM_PARTITION_RESTRICT", () => sthm(@friendship.equivalence_uniform_partition_restrict()))
  log.attempt("ELEMENTS_PAIR_UP", () => sthm(@friendship.elements_pair_up()))
  log.attempt("cycle", () => sthm(@friendship.cycle()))
  log.attempt("path", () => sthm(@friendship.path()))
  log.attempt("CYCLE_OFFSET", () => sthm(@friendship.cycle_offset()))
  log.attempt("CYCLE_MOD", () => sthm(@friendship.cycle_mod()))
  log.attempt("PATHS_MONO", () => sthm(@friendship.paths_mono()))
  log.attempt("HAS_SIZE_PATHS", () => sthm(@friendship.has_size_paths()))
  log.attempt("FINITE_PATHS", () => sthm(@friendship.finite_paths()))
  log.attempt("HAS_SIZE_CYCLES", () => sthm(@friendship.has_size_cycles()))
  log.attempt("FINITE_CYCLES", () => sthm(@friendship.finite_cycles()))
  log.attempt("CARD_PATHCYCLES_STEP", () => sthm(@friendship.card_pathcycles_step()))
  log.attempt("shiftable", () => sthm(@friendship.shiftable()))
  log.attempt("SHIFTABLE_REFL", () => sthm(@friendship.shiftable_refl()))
  log.attempt("SHIFTABLE_TRANS", () => sthm(@friendship.shiftable_trans()))
  log.attempt("SHIFTABLE_LOCAL", () => sthm(@friendship.shiftable_local()))
  log.attempt("SHIFTABLE_SYM", () => sthm(@friendship.shiftable_sym()))
  log.attempt("CYCLES_PRIME_LEMMA", () => sthm(@friendship.cycles_prime_lemma()))
  log.attempt("FRIENDSHIP", () => sthm(@friendship.friendship()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
