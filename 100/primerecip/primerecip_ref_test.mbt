// Load-fidelity test for 100/primerecip.ml: replays tools/ocaml_ref/100_primerecip_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/primerecip matches 100/primerecip.ml" {
  @primerecip.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/prime", "Library/iter", "Library/pocklington", "Library/analysis", "Library/transc", "Library/calc_real", "Library/floor", "100/bertrand", "100/divharmonic", "100/primerecip"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/primerecip")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("INDUCTION_FROM_1", () => sthm(@primerecip.induction_from_1()))
  log.attempt("PRIMERECIP_HARMONIC_LBOUND", () => sthm(@primerecip.primerecip_harmonic_lbound()))
  log.attempt("PRIMERECIP_LBOUND", () => sthm(@primerecip.primerecip_lbound()))
  log.attempt("UNBOUNDED_DIVERGENT", () => sthm(@primerecip.unbounded_divergent()))
  log.attempt("PRIMERECIP_DIVERGES_NUMSEG", () => sthm(@primerecip.primerecip_diverges_numseg()))
  log.attempt("PRIMERECIP_DIVERGES", () => sthm(@primerecip.primerecip_diverges()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
