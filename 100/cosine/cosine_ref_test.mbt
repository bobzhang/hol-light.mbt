// Load-fidelity test for 100/cosine.ml: replays tools/ocaml_ref/100_cosine_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/cosine matches 100/cosine.ml" {
  @cosine.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/wo", "Library/card", "Library/floor", "Multivariate/misc", "Library/products", "Library/iter", "Multivariate/metric", "Library/frag", "Library/prime", "Library/grouptheory", "Multivariate/homology", "Library/matroids", "Multivariate/vectors", "Library/permutations", "Multivariate/determinants", "Multivariate/topology", "Multivariate/convex", "Multivariate/paths", "Multivariate/polytope", "Multivariate/degree", "Multivariate/derivatives", "Library/binary", "Multivariate/clifford", "Multivariate/integration", "Multivariate/measure", "Multivariate/complexes", "Multivariate/canal", "Multivariate/transcendentals", "100/cosine"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/cosine")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("vangle", () => sthm(@cosine.vangle()))
  log.attempt("angle", () => sthm(@cosine.angle()))
  log.attempt("VANGLE", () => sthm(@cosine.vangle_v1()))
  log.attempt("VANGLE_RANGE", () => sthm(@cosine.vangle_range()))
  log.attempt("ORTHOGONAL_VANGLE", () => sthm(@cosine.orthogonal_vangle()))
  log.attempt("VANGLE_EQ_PI", () => sthm(@cosine.vangle_eq_pi()))
  log.attempt("ANGLE_EQ_PI", () => sthm(@cosine.angle_eq_pi()))
  log.attempt("SIN_ANGLE_POS", () => sthm(@cosine.sin_angle_pos()))
  log.attempt("ANGLE", () => sthm(@cosine.angle_v1()))
  log.attempt("ANGLE_REFL", () => sthm(@cosine.angle_refl()))
  log.attempt("ANGLE_REFL_MID", () => sthm(@cosine.angle_refl_mid()))
  log.attempt("ANGLE_SYM", () => sthm(@cosine.angle_sym()))
  log.attempt("ANGLE_RANGE", () => sthm(@cosine.angle_range()))
  log.attempt("LAW_OF_COSINES", () => sthm(@cosine.law_of_cosines()))
  log.attempt("LAW_OF_SINES", () => sthm(@cosine.law_of_sines()))
  log.attempt("TRIANGLE_ANGLE_SUM_LEMMA", () => sthm(@cosine.triangle_angle_sum_lemma()))
  log.attempt("COS_MINUS1_LEMMA", () => sthm(@cosine.cos_minus1_lemma()))
  log.attempt("TRIANGLE_ANGLE_SUM", () => sthm(@cosine.triangle_angle_sum()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
