// Load-fidelity test for 100/independence.ml: replays tools/ocaml_ref/100_independence_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/independence matches 100/independence.ml" {
  @independence.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/wo", "Library/card", "Library/floor", "Multivariate/misc", "Library/products", "Library/iter", "Multivariate/metric", "Library/frag", "Library/prime", "Library/grouptheory", "Multivariate/homology", "Library/matroids", "Multivariate/vectors", "Library/permutations", "Multivariate/determinants", "Multivariate/topology", "Multivariate/convex", "Multivariate/paths", "Multivariate/polytope", "Multivariate/degree", "Multivariate/derivatives", "Library/binary", "Multivariate/clifford", "Multivariate/integration", "Multivariate/measure", "Multivariate/complexes", "Multivariate/canal", "Multivariate/transcendentals", "Library/binomial", "Multivariate/realanalysis", "Multivariate/moretop", "Multivariate/cauchy", "Multivariate/tarski", "100/independence"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/independence")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("ddist", () => sthm(@independence.ddist()))
  log.attempt("DDIST_INCREASES_ONLINE", () => sthm(@independence.ddist_increases_online()))
  log.attempt("DDIST_REFL", () => sthm(@independence.ddist_refl()))
  log.attempt("DDIST_SYM", () => sthm(@independence.ddist_sym()))
  log.attempt("DDIST_POS_LT", () => sthm(@independence.ddist_pos_lt()))
  log.attempt("DDIST_POS_LE", () => sthm(@independence.ddist_pos_le()))
  log.attempt("DDIST_EQ_0", () => sthm(@independence.ddist_eq_0()))
  log.attempt("BETWEEN_COLLINEAR_DDIST_EQ", () => sthm(@independence.between_collinear_ddist_eq()))
  log.attempt("CONTINUOUS_AT_LIFT_DDIST", () => sthm(@independence.continuous_at_lift_ddist()))
  log.attempt("HYPERBOLIC_MIDPOINT", () => sthm(@independence.hyperbolic_midpoint()))
  log.attempt("DDIST_EQ_ORIGIN", () => sthm(@independence.ddist_eq_origin()))
  log.attempt("DDIST_CONGRUENT_TRIPLES_0", () => sthm(@independence.ddist_congruent_triples_0()))
  log.attempt("kleinify", () => sthm(@independence.kleinify()))
  log.attempt("poincarify", () => sthm(@independence.poincarify()))
  log.attempt("KLEINIFY_0", () => sthm(@independence.kleinify_0()))
  log.attempt("POINCARIFY_0", () => sthm(@independence.poincarify_0()))
  log.attempt("NORM_KLEINIFY", () => sthm(@independence.norm_kleinify()))
  log.attempt("NORM_KLEINIFY_LT", () => sthm(@independence.norm_kleinify_lt()))
  log.attempt("NORM_POINCARIFY_LT", () => sthm(@independence.norm_poincarify_lt()))
  log.attempt("KLEINIFY_POINCARIFY", () => sthm(@independence.kleinify_poincarify()))
  log.attempt("POINCARIFY_KLEINIFY", () => sthm(@independence.poincarify_kleinify()))
  log.attempt("DDIST_KLEINIFY", () => sthm(@independence.ddist_kleinify()))
  log.attempt("DDIST_KLEINIFY_EQ", () => sthm(@independence.ddist_kleinify_eq()))
  log.attempt("NORM_KLEINIFY_MOEBIUS_LT", () => sthm(@independence.norm_kleinify_moebius_lt()))
  log.attempt("DDIST_KLEINIFY_MOEBIUS", () => sthm(@independence.ddist_kleinify_moebius()))
  log.attempt("COLLINEAR_KLEINIFY_MOEBIUS", () => sthm(@independence.collinear_kleinify_moebius()))
  log.attempt("BETWEEN_KLEINIFY_MOEBIUS", () => sthm(@independence.between_kleinify_moebius()))
  log.attempt("hyperbolic_isometry", () => sthm(@independence.hyperbolic_isometry()))
  log.attempt("HYPERBOLIC_TRANSLATION", () => sthm(@independence.hyperbolic_translation()))
  log.attempt("plane_tybij", () => sthm(@independence.plane_tybij()))
  log.attempt("pbetween", () => sthm(@independence.pbetween()))
  log.attempt("pdist", () => sthm(@independence.pdist()))
  log.attempt("DEST_PLANE_NORM_LT", () => sthm(@independence.dest_plane_norm_lt()))
  log.attempt("DEST_PLANE_EQ", () => sthm(@independence.dest_plane_eq()))
  log.attempt("FORALL_DEST_PLANE", () => sthm(@independence.forall_dest_plane()))
  log.attempt("EXISTS_DEST_PLANE", () => sthm(@independence.exists_dest_plane()))
  log.attempt("TARSKI_AXIOM_1_NONEUCLIDEAN", () => sthm(@independence.tarski_axiom_1_noneuclidean()))
  log.attempt("TARSKI_AXIOM_2_NONEUCLIDEAN", () => sthm(@independence.tarski_axiom_2_noneuclidean()))
  log.attempt("TARSKI_AXIOM_3_NONEUCLIDEAN", () => sthm(@independence.tarski_axiom_3_noneuclidean()))
  log.attempt("TARSKI_AXIOM_4_NONEUCLIDEAN", () => sthm(@independence.tarski_axiom_4_noneuclidean()))
  log.attempt("TARSKI_AXIOM_5_NONEUCLIDEAN", () => sthm(@independence.tarski_axiom_5_noneuclidean()))
  log.attempt("TARSKI_AXIOM_6_NONEUCLIDEAN", () => sthm(@independence.tarski_axiom_6_noneuclidean()))
  log.attempt("TARSKI_AXIOM_7_NONEUCLIDEAN", () => sthm(@independence.tarski_axiom_7_noneuclidean()))
  log.attempt("TARSKI_AXIOM_8_NONEUCLIDEAN", () => sthm(@independence.tarski_axiom_8_noneuclidean()))
  log.attempt("TARSKI_AXIOM_9_NONEUCLIDEAN", () => sthm(@independence.tarski_axiom_9_noneuclidean()))
  log.attempt("NOT_TARSKI_AXIOM_10_NONEUCLIDEAN", () => sthm(@independence.not_tarski_axiom_10_noneuclidean()))
  log.attempt("TARSKI_AXIOM_11_NONEUCLIDEAN", () => sthm(@independence.tarski_axiom_11_noneuclidean()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
