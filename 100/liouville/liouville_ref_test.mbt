// Load-fidelity test for 100/liouville.ml: replays tools/ocaml_ref/100_liouville_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/liouville matches 100/liouville.ml" {
  @liouville.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/floor", "Library/analysis", "Library/poly", "100/liouville"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/liouville")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("algebraic", () => sthm(@liouville.algebraic()))
  log.attempt("transcendental", () => sthm(@liouville.transcendental()))
  log.attempt("REAL_INTEGER_EQ_0", () => sthm(@liouville.real_integer_eq_0()))
  log.attempt("FACT_LE_REFL", () => sthm(@liouville.fact_le_refl()))
  log.attempt("EXP_LE_REFL", () => sthm(@liouville.exp_le_refl()))
  log.attempt("MVT_INEQ", () => sthm(@liouville.mvt_ineq()))
  log.attempt("POLY_MULTIPLE_INTEGER", () => sthm(@liouville.poly_multiple_integer()))
  log.attempt("SEPARATE_FINITE_SET", () => sthm(@liouville.separate_finite_set()))
  log.attempt("POLY_ROOT_SEPARATE_LE", () => sthm(@liouville.poly_root_separate_le()))
  log.attempt("POLY_ROOT_SEPARATE_LT", () => sthm(@liouville.poly_root_separate_lt()))
  log.attempt("POLY_BOUND_INTERVAL", () => sthm(@liouville.poly_bound_interval()))
  log.attempt("LIOUVILLE_INTERVAL", () => sthm(@liouville.liouville_interval()))
  log.attempt("LIOUVILLE", () => sthm(@liouville.liouville()))
  log.attempt("LIOUVILLE_IRRATIONAL", () => sthm(@liouville.liouville_irrational()))
  log.attempt("liouville", () => sthm(@liouville.liouville_v1()))
  log.attempt("LIOUVILLE_SUM_BOUND", () => sthm(@liouville.liouville_sum_bound()))
  log.attempt("LIOUVILLE_PSUM_BOUND", () => sthm(@liouville.liouville_psum_bound()))
  log.attempt("LIOUVILLE_SUMS", () => sthm(@liouville.liouville_sums()))
  log.attempt("LIOUVILLE_PSUM_LE", () => sthm(@liouville.liouville_psum_le()))
  log.attempt("LIOUVILLE_PSUM_LT", () => sthm(@liouville.liouville_psum_lt()))
  log.attempt("LIOVILLE_PSUM_DIFF", () => sthm(@liouville.lioville_psum_diff()))
  log.attempt("TRANSCENDENTAL_LIOUVILLE", () => sthm(@liouville.transcendental_liouville()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
