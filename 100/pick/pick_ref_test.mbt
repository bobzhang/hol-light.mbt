// Load-fidelity test for 100/pick.ml: replays tools/ocaml_ref/100_pick_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "100/pick matches 100/pick.ml" {
  @pick.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for th in ["simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder", "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion", "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax", "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart", "define", "Library/wo", "Library/card", "Library/floor", "Multivariate/misc", "Library/products", "Library/iter", "Multivariate/metric", "Library/frag", "Library/prime", "Library/grouptheory", "Multivariate/homology", "Library/matroids", "Multivariate/vectors", "Library/permutations", "Multivariate/determinants", "Multivariate/topology", "Multivariate/convex", "Multivariate/paths", "Multivariate/polytope", "Multivariate/degree", "Multivariate/derivatives", "Library/binary", "Multivariate/clifford", "Multivariate/integration", "Multivariate/measure", "Multivariate/complexes", "Multivariate/canal", "Multivariate/transcendentals", "Library/binomial", "Multivariate/realanalysis", "Multivariate/moretop", "100/pick"] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("100/pick")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("COLLINEAR_IMP_NEGLIGIBLE", () => sthm(@pick.collinear_imp_negligible()))
  log.attempt("CONVEX_HULL_3_0", () => sthm(@pick.convex_hull_3_0()))
  log.attempt("INTERIOR_CONVEX_HULL_3_0", () => sthm(@pick.interior_convex_hull_3_0()))
  log.attempt("MEASURE_CONVEX_HULL_2_TRIVIAL", () => sthm(@pick.measure_convex_hull_2_trivial()))
  log.attempt("NEGLIGIBLE_SEGMENT_2", () => sthm(@pick.negligible_segment_2()))
  log.attempt("TRIANGLE_DECOMPOSITION", () => sthm(@pick.triangle_decomposition()))
  log.attempt("TRIANGLE_ADDITIVE_DECOMPOSITION", () => sthm(@pick.triangle_additive_decomposition()))
  log.attempt("integral_vector", () => sthm(@pick.integral_vector()))
  log.attempt("INTEGRAL_VECTOR_VEC", () => sthm(@pick.integral_vector_vec()))
  log.attempt("INTEGRAL_VECTOR_STDBASIS", () => sthm(@pick.integral_vector_stdbasis()))
  log.attempt("INTEGRAL_VECTOR_ADD", () => sthm(@pick.integral_vector_add()))
  log.attempt("INTEGRAL_VECTOR_SUB", () => sthm(@pick.integral_vector_sub()))
  log.attempt("INTEGRAL_VECTOR_ADD_LCANCEL", () => sthm(@pick.integral_vector_add_lcancel()))
  log.attempt("FINITE_BOUNDED_INTEGER_POINTS", () => sthm(@pick.finite_bounded_integer_points()))
  log.attempt("FINITE_TRIANGLE_INTEGER_POINTS", () => sthm(@pick.finite_triangle_integer_points()))
  log.attempt("LINEAR_INTEGRAL_VECTOR", () => sthm(@pick.linear_integral_vector()))
  log.attempt("INTEGRAL_BASIS_UNIMODULAR", () => sthm(@pick.integral_basis_unimodular()))
  log.attempt("PICK_ELEMENTARY_TRIANGLE_0", () => sthm(@pick.pick_elementary_triangle_0()))
  log.attempt("PICK_ELEMENTARY_TRIANGLE", () => sthm(@pick.pick_elementary_triangle()))
  log.attempt("PICK_TRIANGLE_FLAT", () => sthm(@pick.pick_triangle_flat()))
  log.attempt("PICK_TRIANGLE_ALT", () => sthm(@pick.pick_triangle_alt()))
  log.attempt("PICK_TRIANGLE", () => sthm(@pick.pick_triangle()))
  log.attempt("PARITY_LEMMA", () => sthm(@pick.parity_lemma()))
  log.attempt("polygonal_path", () => sthm(@pick.polygonal_path()))
  log.attempt("POLYGONAL_PATH_CONS_CONS", () => sthm(@pick.polygonal_path_cons_cons()))
  log.attempt("POLYGONAL_PATH_TRANSLATION", () => sthm(@pick.polygonal_path_translation()))
  log.attempt("POLYGONAL_PATH_LINEAR_IMAGE", () => sthm(@pick.polygonal_path_linear_image()))
  log.attempt("PATHSTART_POLYGONAL_PATH", () => sthm(@pick.pathstart_polygonal_path()))
  log.attempt("PATHFINISH_POLYGONAL_PATH", () => sthm(@pick.pathfinish_polygonal_path()))
  log.attempt("VERTICES_IN_PATH_IMAGE_POLYGONAL_PATH", () => sthm(@pick.vertices_in_path_image_polygonal_path()))
  log.attempt("ARC_POLYGONAL_PATH_IMP_DISTINCT", () => sthm(@pick.arc_polygonal_path_imp_distinct()))
  log.attempt("PATH_POLYGONAL_PATH", () => sthm(@pick.path_polygonal_path()))
  log.attempt("PATH_IMAGE_POLYGONAL_PATH_SUBSET_CONVEX_HULL", () => sthm(@pick.path_image_polygonal_path_subset_convex_hull()))
  log.attempt("PATH_IMAGE_POLYGONAL_PATH_SUBSET_SEGMENTS", () => sthm(@pick.path_image_polygonal_path_subset_segments()))
  log.attempt("SET_OF_LIST_POLYGONAL_PATH_ROTATE", () => sthm(@pick.set_of_list_polygonal_path_rotate()))
  log.attempt("PROPERTIES_POLYGONAL_PATH_SNOC", () => sthm(@pick.properties_polygonal_path_snoc()))
  log.attempt("PATH_IMAGE_POLYGONAL_PATH_ROTATE", () => sthm(@pick.path_image_polygonal_path_rotate()))
  log.attempt("SIMPLE_PATH_POLYGONAL_PATH_ROTATE", () => sthm(@pick.simple_path_polygonal_path_rotate()))
  log.attempt("ROTATE_LIST_TO_FRONT_1", () => sthm(@pick.rotate_list_to_front_1()))
  log.attempt("ROTATE_LIST_TO_FRONT_0", () => sthm(@pick.rotate_list_to_front_0()))
  log.attempt("DISTINGUISHING_ROTATION_EXISTS_PAIR", () => sthm(@pick.distinguishing_rotation_exists_pair()))
  log.attempt("DISTINGUISHING_ROTATION_EXISTS", () => sthm(@pick.distinguishing_rotation_exists()))
  log.attempt("DISTINGUISHING_ROTATION_EXISTS_POLYGON", () => sthm(@pick.distinguishing_rotation_exists_polygon()))
  log.attempt("POLYGON_CHOP_IN_TWO", () => sthm(@pick.polygon_chop_in_two()))
  log.attempt("PICK", () => sthm(@pick.pick()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(@testkit.normalize_times(log.contents()))
}
