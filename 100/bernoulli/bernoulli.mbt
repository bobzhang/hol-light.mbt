  let t101 = @simp.once_rewrite_tac(@list.List([@equal.gsym(@realax.real_mul_sym())]))
  let t109 = @tactics.thenl(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.gen_tac, @simp.asm_simp_tac(@list.List([@real.real_eq_rdiv_eq(), @calc_rat.real_arith(@parser.parse_term("&0 < &n + &1"))]))), t101), t102), t103), t104), @tactics.conj_tac), t108)
  sum_of_powers_c.set(@tactics.prove(@parser.parse_term("!n. sum(0..n) (\\k. &k pow m) =\n        (bernpoly(SUC m) (&n + &1) - bernpoly(SUC m) (&0)) / (&m + &1)"), t109))
}

///|
let sum_of_powers_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("SUM_OF_POWERS")

///|
/// `SUM_OF_POWERS`
pub fn sum_of_powers() -> @kernel.Thm {
  sum_of_powers_c.get()
}

///|
/// SUM_CONV
fn step_11() -> Unit raise {
  let t110 = @simp.simp_tac(@list.List([@iterate.sum_clauses_numseg(), @arith.le_0()]))
  let pth = @tactics.prove(@parser.parse_term("sum(0..0) f = f 0 /\\ sum(0..SUC n) f = sum(0..n) f + f(SUC n)"), t110)
  let econv_0 : (@kernel.Term) -> @kernel.Thm raise = @simp.gen_rewrite_conv(fn(x111 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    x111
  }, @list.List([@bool.conjunct1(pth)]))
  let econv_1 : (@kernel.Term) -> @kernel.Thm raise = @simp.gen_rewrite_conv(fn(x112 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    x112
  }, @list.List([@bool.conjunct2(pth)]))
  fn sconv(x113 : @kernel.Term) -> @kernel.Thm raise {
    let tm = x113
    let t114 = @equal.rand_conv(@calc_num.num_suc_conv)
    let t115 = @equal.comb2_conv(@equal.rand_conv(sconv), t114)
    @equal.orelsec(econv_0, @equal.thenc(@equal.thenc(@equal.land_conv(@equal.rand_conv(@calc_num.num_conv)), econv_1), t115))(tm)
  }
  sum_conv_c.set(sconv)
}

///|
let sum_conv_c : @lib.Cell[@equal.Conv] = @lib.Cell::new("SUM_CONV")

///|
/// `SUM_CONV`
pub fn sum_conv(x : @kernel.Term) -> @kernel.Thm raise {
  (sum_conv_c.get())(x)
}

///|
/// BINOM_CONV
fn step_12() -> Unit raise {
  let t127 = @meson.meson_tac(@list.List([@arith.lt_nz(), @arith.fact_lt()]))
  let t126 = @simp.simp_tac(@list.List([@arith.lt_nz(), @arith.mult_assoc(), @arith.mult_clauses()]))
  let t125 = @simp.once_rewrite_tac(@list.List([@equal.gsym(@class.contrapos_thm())]))
  let t128 = @tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.pop_assum(fn(x122 : @kernel.Thm) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise) raise {
    let s123 = @tactics.mp_tac(x122)
    fn(x124 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise {
      s123(x124)
    }
  }), t125), t126), t127)
  let t129 = @list.List([@tactics.then_tac(@tactics.pop_assum(fn(x119 : @kernel.Thm) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise) raise {
    let s120 = @tactics.mp_tac(x119)
    fn(x121 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise {
      s120(x121)
    }
  }), @int.arith_tac), t128])
  let t118 = @tactics.exists_tac(@parser.parse_term("0"))
  let t117 = @tactics.match_mp_tac(@arith.div_uniq())
  let t116 = @tactics.conv_tac(@equal.sym_conv)
  let t130 = @tactics.thenl(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t116), t117), t118), @tactics.conj_tac), t129)
  let pth = @tactics.prove(@parser.parse_term("a * b * x = FACT c ==> x = (FACT c) DIV (a * b)"), t130)
  let match_pth : (@kernel.Thm) -> @kernel.Thm raise = @drule.match_mp(pth)
  let binom_tm = @parser.parse_term("binom")
  binom_conv_c.set(fn(x131 : @kernel.Term) -> @kernel.Thm raise {
    let tm = x131
    let (bop, lr) = @kernel.dest_comb(tm)
    if (bop != binom_tm) {
      raise Failure("BINOM_CONV")
    } else {
      let (l, r) = @pair.dest_pair(lr)
      let n = @basics.dest_numeral(l)
      let k = @basics.dest_numeral(r)
      if @num.lt_num(n, k) {
        let th = @bool.specl(@list.List([l, r]), @binomial.binom_lt())
        @bool.mp(th, @bool.eqt_elim(@calc_num.num_lt_conv(@equal.lhand(@kernel.concl(th)))))
      } else {
        let d = @num.sub_num(n, k)
        let th1 = match_pth(@bool.specl(@list.List([@nums.mk_numeral(d), r]), @binomial.binom_fact()))
        @equal.conv_rule(@calc_num.num_reduce_conv, th1)
      }
    }
  })
}

///|
let binom_conv_c : @lib.Cell[(@kernel.Term) -> @kernel.Thm raise] = @lib.Cell::new("BINOM_CONV")

///|
/// `BINOM_CONV`
pub fn binom_conv(x : @kernel.Term) -> @kernel.Thm raise {
  (binom_conv_c.get())(x)
}

///|
/// BERNOULLIS
fn step_13() -> Unit raise {
  let (th_0, th_1) = @bool.conj_pair(bernoulli())
  let b_tm = @parser.parse_term("bernoulli")
  let conv_1 : (@kernel.Term) -> @kernel.Thm raise = @simp.gen_rewrite_conv(fn(x132 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    x132
  }, @list.List([th_1]))
  fn bconv(x133 : Int64) -> @list.List[@kernel.Thm] raise {
    let n = x133
    if (n <= 0L) {
      @list.List([th_0])
    } else {
      let bths = bconv(@lib.sub63(n, 1L))
      let tm = @kernel.mk_comb(b_tm, @nums.mk_small_numeral(n))
      let t140 = @simp.gen_rewrite_conv(fn(x137 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
        let s138 = @equal.once_depth_conv(x137)
        fn(x139 : @kernel.Term) -> @kernel.Thm raise {
          s138(x139)
        }
      }, bths)
      let t136 = @equal.depth_conv(@equal.orelsec(@calc_num.num_red_conv, binom_conv))
      let t135 = @equal.once_depth_conv(@equal.beta_conv)
      let t134 = @equal.land_conv(@equal.rand_conv(sum_conv))
      bths.prepend(@equal.thenc(@equal.thenc(@equal.thenc(@equal.thenc(@equal.thenc(@equal.thenc(@equal.rand_conv(@calc_num.num_conv), conv_1), t134), t135), t136), t140), @calc_rat.real_rat_reduce_conv)(tm))
    }
  }
  bernoullis_c.set(bconv)
}

///|
let bernoullis_c : @lib.Cell[(Int64) -> @list.List[@kernel.Thm] raise] = @lib.Cell::new("BERNOULLIS")

///|
/// `BERNOULLIS`
pub fn bernoullis(x : Int64) -> @list.List[@kernel.Thm] raise {
  (bernoullis_c.get())(x)
}

///|
/// BERNOULLI_CONV
fn step_14() -> Unit raise {
  let b_tm = @parser.parse_term("bernoulli")
  bernoulli_conv_c.set(fn(x141 : @kernel.Term) -> @kernel.Thm raise {
    let tm = x141
    let (op, n) = @kernel.dest_comb(tm)
    if ((op != b_tm) || !@nums.is_numeral(n)) {
      raise Failure("BERNOULLI_CONV")
    } else {
      @lib.hd(bernoullis(@nums.dest_small_numeral(n)))
    }
  })
}

///|
let bernoulli_conv_c : @lib.Cell[(@kernel.Term) -> @kernel.Thm raise] = @lib.Cell::new("BERNOULLI_CONV")

///|
/// `BERNOULLI_CONV`
pub fn bernoulli_conv(x : @kernel.Term) -> @kernel.Thm raise {
  (bernoulli_conv_c.get())(x)
}

///|
/// BERNPOLY_CONV
fn step_15() -> Unit raise {
  let t142 = @equal.top_depth_conv(@equal.beta_conv)
  let conv_1 : (@kernel.Term) -> @kernel.Thm raise = @equal.thenc(@equal.thenc(@equal.thenc(@simp.rewr_conv(bernpoly()), sum_conv), t142), @calc_num.num_reduce_conv)
  let conv_3 : (@kernel.Term) -> @kernel.Thm raise = @equal.thenc(@equal.once_depth_conv(binom_conv), @calc_rat.real_poly_conv)
  bernpoly_conv_c.set(fn(x143 : @kernel.Term) -> @kernel.Thm raise {
    let tm = x143
    let n = @nums.dest_small_numeral(@equal.lhand(tm))
    let conv_2 : (@kernel.Term) -> @kernel.Thm raise = @simp.gen_rewrite_conv(fn(x144 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
      let s145 = @equal.once_depth_conv(x144)
      fn(x146 : @kernel.Term) -> @kernel.Thm raise {
        s145(x146)
      }
    }, bernoullis(n))
    @equal.thenc(@equal.thenc(conv_1, conv_2), conv_3)(tm)
  })
}

///|
let bernpoly_conv_c : @lib.Cell[(@kernel.Term) -> @kernel.Thm raise] = @lib.Cell::new("BERNPOLY_CONV")

///|
/// `BERNPOLY_CONV`
pub fn bernpoly_conv(x : @kernel.Term) -> @kernel.Thm raise {
  (bernpoly_conv_c.get())(x)
}

///|
/// SOP_CONV
fn step_16() -> Unit raise {
  let t147 = @simp.rewrite_tac(@list.List([sum_of_powers()]))
  let pth = @tactics.prove(@parser.parse_term("sum(0..n) (\\k. &k pow m) =\n        (\\p. (p(&n + &1) - p(&0)) / (&m + &1))\n        (\\x. bernpoly (SUC m) x)"), t147)
  let conv_0 : (@kernel.Term) -> @kernel.Thm raise = @simp.rewr_conv(pth)
  let t149 = @equal.top_depth_conv(@equal.beta_conv)
  let t148 = @equal.rand_conv(@equal.abs_conv(@equal.thenc(@equal.land_conv(@calc_num.num_suc_conv), bernpoly_conv)))
  sop_conv_c.set(@equal.thenc(@equal.thenc(@equal.thenc(@simp.rewr_conv(pth), t148), t149), @calc_rat.real_poly_conv))
}

