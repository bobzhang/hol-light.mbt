///|
/// Check that `new` reads as `spelt` does: the term HOL reads its quotation
/// as, spelt out (operators applied by name, binders one at a time).
fn same(new : String, spelt : String) -> Unit raise {
  let t = @term_syntax.parse_term(new)
  let u = @term_syntax.parse_term(spelt)
  if !@basics.aconv(t, u) {
    fail("\{new} is not \{spelt}")
  }
}

///|
test "quantifiers, connectives and their precedence" {
  same("∀ n : Num, n + 0 == n", "∀ n : Num, op_eq(op_plus(n, 0), n)")
  same(
    "∀ p : Bool, ∃ q : Bool, p → q", "∀ p : Bool, ∃ q : Bool, op_eq_eq_gt(p, q)",
  )
  same(
    "∀ x : _, ∀ y : _, x + y == y + x", "∀ x : Num, ∀ y : Num, op_eq(op_plus(x, y), op_plus(y, x))",
  )
  same(
    "∀ x : Num, x == x && true", "∀ x : Num, op_slash_bslash(op_eq(x, x), true)",
  )
  same(
    "∀ a : Bool, ∀ b : Bool, ∀ c : Bool, a && b || c", "∀ a : Bool, ∀ b : Bool, ∀ c : Bool, op_bslash_slash(op_slash_bslash(a, b), c)",
  )
  same(
    "∀ p : _, ∀ q : _, ∀ r : _, p → q → r", "∀ p : Bool, ∀ q : Bool, ∀ r : Bool, op_eq_eq_gt(p, op_eq_eq_gt(q, r))",
  )
  same(
    "∀ a : _, ∀ b : _, ∀ c : _, ∀ d : Num, a + b * c == d", "∀ a : Num, ∀ b : Num, ∀ c : Num, ∀ d : Num, op_eq(op_plus(a, op_star(b, c)), d)",
  )
  same(
    "∀ p : _, ∀ q : _, !p || q", "∀ p : Bool, ∀ q : Bool, op_bslash_slash(op_tilde(p), q)",
  )
  same(
    "∀ x : Num, ∀ y : _, x != y → y != x", "∀ x : Num, ∀ y : Num, op_eq_eq_gt(op_tilde(op_eq(x, y)), op_tilde(op_eq(y, x)))",
  )
  same(
    "∀ a : Num, ∀ b : _, a - b <= a", "∀ a : Num, ∀ b : Num, op_lt_eq(op_minus(a, b), a)",
  )
}

///|
test "application, lambdas, conditionals, tuples and lists" {
  same("∀ n : _, SUC(n) > n", "∀ n : Num, op_gt(SUC(n), n)")
  same("(x : Num) => x * 2", "(x : Num) => op_star(x, 2)")
  same("(x : Num, y : Num) => x + y", "(x : Num) => (y : Num) => op_plus(x, y)")
  same(
    "∀ f : (Num, Num) -> Num, ∀ x : _, ∀ y : _, x.f(y) == f(x, y)", "∀ f : (Num) -> (Num) -> Num, ∀ x : Num, ∀ y : Num, op_eq(f(x)(y), f(x)(y))",
  )
  same(
    "∀ c : Bool, ∀ a : Num, ∀ b : _, (if c { a } else { b }) <= a + b", "∀ c : Bool, ∀ a : Num, ∀ b : Num, op_lt_eq(COND(c, a, b), op_plus(a, b))",
  )
  same("(1, 2)", "op_comma(1, 2)")
  same("(1, true, 3)", "op_comma(1, op_comma(true, 3))")
  same("[1, 2, 3]", "CONS(1, CONS(2, CONS(3, NIL)))")
}

///|
test "HOL names: primes and capitalised binders" {
  same("∀ x' : Num, x' == x'", "∀ x' : Num, op_eq(x', x')")
  // as in MoonBit, a quantifier is not an operand of → without parentheses
  same(
    "∀ P : (Num) -> Bool, P(0) → (∃ n : _, P(n))", "∀ P : (Num) -> Bool, op_eq_eq_gt(P(0), ∃ n : Num, P(n))",
  )
}

///|
test "types" {
  let ty = @term_syntax.parse_type
  let num = @kernel.mk_type("num", @list.List([]))
  let a = @kernel.mk_vartype("A")
  let b = @kernel.mk_vartype("B")
  let arrow = @basics.mk_fun_ty
  let list = (x : @kernel.HolType) => @kernel.mk_type("list", @list.List([x]))
  assert_eq(
    ty("(Num, Bool) -> Bool"),
    arrow(num, arrow(@kernel.bool_ty, @kernel.bool_ty)),
  )
  assert_eq(
    ty("(Num, Bool)"),
    @kernel.mk_type("prod", @list.List([num, @kernel.bool_ty])),
  )
  assert_eq(ty("List[A]"), list(a))
  assert_eq(ty("((A) -> B, A) -> B"), arrow(arrow(a, b), arrow(a, b)))
  assert_eq(ty("List[6]"), list(ty("6")))
  assert_eq(ty("1"), @kernel.mk_type("1", @list.List([])))
  assert_true((Some(ty("0")) catch { _ => None }) is None)
}

///|
test "syntax errors name the offset" {
  let msg = try @term_syntax.parse_term("∀ x : Num x") catch {
    Failure(m) => m
    e => raise e
  } noraise {
    _ => "parsed"
  }
  assert_true(msg.has_prefix("term syntax: unexpected"))
}

///|
test "binders cannot capture what the syntax stands for" {
  // true is the constant T even under a binder named T
  same("(T : Bool) => true", "(x : Bool) => true")
  same("(T : Bool) => T", "(x : Bool) => x")
  same("(NIL : Num) => [NIL]", "(x : Num) => CONS(x, NIL)")
  // a binder named like a constant or an interface name binds its uses
  same("(SUC : Num) => SUC", "(x : Num) => x")
  same("(exists : Num) => exists", "(x : Num) => x")
}

///|
fn rejects(s : String, is_type~ : Bool = false) -> String raise {
  try {
    if is_type {
      ignore(@term_syntax.parse_type(s))
    } else {
      ignore(@term_syntax.parse_term(s))
    }
    fail("accepted: " + s)
  } catch {
    Failure(m) => m
    e => raise e
  }
}

///|
test "input without a meaning is an error, not an abort" {
  inspect(
    rejects("1 % 2"),
    content="term syntax: operator % has no HOL meaning",
  )
  inspect(
    rejects("Bool[Num]", is_type=true),
    content="term syntax: type Bool takes 0 arguments",
  )
  inspect(
    rejects("_", is_type=true),
    content="term syntax: _ alone is not a type",
  )
  inspect(
    rejects("(let : Bool) => let"),
    content="term syntax: let is a MoonBit keyword",
  )
}

///|
test "a hole inside a type is a fresh type variable" {
  let t = @term_syntax.parse_term("(xs : List[_]) => xs == xs")
  let elem = @kernel.type_of(@kernel.dest_abs(t).0)
  assert_true(elem is Tyapp("list", More(Tyvar(_), tail=Empty)))
  assert_true(
    @kernel.is_vartype(
      @basics.dest_fun_ty(@term_syntax.parse_type("(_) -> Bool")).0,
    ),
  )
}

///|
test "names with a semicolon are escaped" {
  assert_eq(@grammar.escape(";;"), Some("op_semi_semi"))
  inspect(@grammar.unescape("op_semi_semi"), content=";;")
}

///|
test "an overload declared before its constant reads as the constant once defined" {
  @preterm.make_overloadable("zz_ovl", @term_syntax.parse_type("(A) -> A"))
  @preterm.overload_interface(
    "zz_ovl",
    @term_syntax.parse_term("(zz_ovl_num : (Num) -> Num)"),
  )
  // a read before the definition must not fix the view without the overload
  ignore(@term_syntax.parse_term("(0 : Num)"))
  @kernel.new_constant("zz_ovl_num", @term_syntax.parse_type("(Num) -> Num"))
  let t = @term_syntax.parse_term("zz_ovl((0 : Num))")
  assert_true(@kernel.is_const(@kernel.rator(t)))
}

///|
test "parse_term_in_context types free variables from the context" {
  let bool_pty = @preterm.pretype_of_type(@kernel.bool_ty)
  let x = @term_syntax.parse_term_in_context(@list.List([("x", bool_pty)]), "x")
  inspect(@kernel.type_of(x) == @kernel.bool_ty, content="true")
  let y = @term_syntax.parse_term_in_context(@list.List([]), "y", ty=bool_pty)
  inspect(@kernel.type_of(y) == @kernel.bool_ty, content="true")
  let e = @term_syntax.parse_term_in_context(
    @list.List([("x", bool_pty)]),
    "x && z",
  )
  inspect(@term_syntax.print_term(e), content="(x : Bool) && (z : Bool)")
}

///|
test "a context variable named like a constant means the variable" {
  let bool_pty = @preterm.pretype_of_type(@kernel.bool_ty)
  let t = @term_syntax.parse_term_in_context(
    @list.List([("select", bool_pty)]),
    "select",
    ty=bool_pty,
  )
  inspect(t == @kernel.mk_var("select", @kernel.bool_ty), content="true")
}

///|
test "print_term_in_context leaves the context's variables untyped" {
  let bool_pty = @preterm.pretype_of_type(@kernel.bool_ty)
  let num_pty = @preterm.pretype_of_type(@kernel.mk_type("num", @list.List([])))
  let env = @list.List([("x", bool_pty), ("select", bool_pty), ("n", num_pty)])
  let e = @term_syntax.parse_term_in_context(env, "x && z && select")
  inspect(
    @term_syntax.print_term_in_context(env, e),
    content="x && (z : Bool) && select",
  )
  // the context would give a variable of the same name its type
  let n = @kernel.mk_var("n", @kernel.bool_ty)
  inspect(
    @term_syntax.print_term_in_context(env, n) catch {
      Unprintable(m) => m
    },
    content="term whose types the syntax cannot pin down",
  )
  let f = @term_syntax.parse_term_in_context(env, "∀ m : Num, m == n")
  inspect(
    @term_syntax.print_term_in_context(env, f),
    content="∀ m : Num, m == n",
  )
  // a binder that would capture the context's variable is renamed, which
  // an exact spelling does not allow
  let x_num = @kernel.mk_var("x", @kernel.mk_type("num", @list.List([])))
  let shadow = @kernel.mk_abs(x_num, @kernel.mk_var("x", @kernel.bool_ty))
  inspect(
    @term_syntax.print_term_in_context(env, shadow),
    content="(x' : Num) => x",
  )
  inspect(
    @term_syntax.print_term_in_context(env, shadow, exact=true) catch {
      Unprintable(m) => m
    },
    content="term whose bound variables would be renamed",
  )
}

///|
test "type definitions" {
  let tree = @kernel.mk_vartype("tree")
  let num = @kernel.mk_type("num", @list.List([]))
  assert_eq(
    @term_syntax.parse_type_definition(
      "enum Tree { Leaf(Num); Node(Tree, Tree) }",
    ),
    @list.List([
      (
        tree,
        @list.List([
          ("Leaf", @list.List([num])),
          ("Node", @list.List([tree, tree])),
        ]),
      ),
    ]),
  )
  // mutually recursive types, symbolic and nullary constructors
  let defs = @term_syntax.parse_type_definition(
    "enum Form { False; `&&`(Form, Form); All(Num, List[Term]) } enum Term { V(Num); Fn(Num, List[Term]); }",
  )
  let term = @kernel.mk_vartype("term")
  let form = @kernel.mk_vartype("form")
  let terms = @kernel.mk_type("list", @list.List([term]))
  assert_eq(
    defs,
    @list.List([
      (
        form,
        @list.List([
          ("False", @list.List([])),
          ("&&", @list.List([form, form])),
          ("All", @list.List([num, terms])),
        ]),
      ),
      (
        term,
        @list.List([("V", @list.List([num])), ("Fn", @list.List([num, terms]))]),
      ),
    ]),
  )
}

///|
test "record definitions" {
  let num = @kernel.mk_type("num", @list.List([]))
  assert_eq(
    @term_syntax.parse_record_definition(
      "struct Point { x : Num; y : List[Num]; }",
    ),
    (
      "point",
      @list.List([("x", num), ("y", @kernel.mk_type("list", @list.List([num])))]),
    ),
  )
  // a field referring to the record reads as the type being defined
  let zz_r = @kernel.mk_vartype("zz_r")
  assert_eq(
    @term_syntax.parse_record_definition("struct Zz_r { kids : List[Zz_r] }"),
    (
      "zz_r",
      @list.List([("kids", @kernel.mk_type("list", @list.List([zz_r])))]),
    ),
  )
}

///|
test "an enum's own types read before other names" {
  // `Zz_t` between backticks is a type variable, not the type being defined
  let defs = @term_syntax.parse_type_definition(
    "enum Zz_t { Zl; Zb(`Zz_t`, Zz_t) }",
  )
  let zz_t = @kernel.mk_vartype("zz_t")
  assert_eq(
    defs,
    @list.List([
      (
        zz_t,
        @list.List([
          ("Zl", @list.List([])),
          ("Zb", @list.List([@kernel.mk_vartype("Zz_t"), zz_t])),
        ]),
      ),
    ]),
  )
  // nor is a type variable an abbreviation stands for
  let a_num = @kernel.mk_type(
    "prod",
    @list.List([@kernel.mk_vartype("A"), @kernel.mk_type("num", @list.List([]))]),
  )
  @preterm.new_type_abbrev("zz_ab", a_num)
  defer @preterm.remove_type_abbrev("zz_ab")
  let a = @kernel.mk_vartype("a")
  assert_eq(
    @term_syntax.parse_type_definition("enum A { Mk(Zz_ab, A) }"),
    @list.List([(a, @list.List([("Mk", @list.List([a_num, a]))]))]),
  )
  // even one named as the syntax names a type being defined
  let enum_a = @kernel.mk_vartype("enum A")
  @preterm.new_type_abbrev("zz_ae", enum_a)
  defer @preterm.remove_type_abbrev("zz_ae")
  assert_eq(
    @term_syntax.parse_type_definition("enum A { Mk(Zz_ae, A) }"),
    @list.List([(a, @list.List([("Mk", @list.List([enum_a, a]))]))]),
  )
}

///|
test "verbatim type names" {
  // a HOL type whose name starts with a capital, beside one that doesn't
  @kernel.new_type("zz_v", 0L)
  @kernel.new_type("Zz_v", 1L)
  let ty = @term_syntax.parse_type
  let lower = @kernel.mk_type("zz_v", @list.List([]))
  let upper = @kernel.mk_type("Zz_v", @list.List([@kernel.bool_ty]))
  assert_eq(ty("Zz_v"), lower)
  assert_eq(ty("`Zz_v`[Bool]"), upper)
  inspect(@term_syntax.print_type(upper), content="`Zz_v`[Bool]")
  assert_true((Some(ty("`Zz_v`")) catch { _ => None }) is None)
  // a primed type variable, as HOL writes its type variables
  let a = @kernel.mk_vartype("'a")
  assert_eq(ty("`'a`"), a)
  assert_eq(ty("List[`'a`]"), @kernel.mk_type("list", @list.List([a])))
  inspect(@term_syntax.print_type(a), content="`'a`")
  // so is one named as a type constant is before it is defined, though
  // not once it is
  let zz_u = @kernel.mk_vartype("zz_u")
  inspect(@term_syntax.print_type(zz_u), content="`zz_u`")
  assert_eq(ty("`zz_u`"), zz_u)
  let zz_v = @kernel.mk_vartype("zz_v")
  assert_true((Some(@term_syntax.print_type(zz_v)) catch { _ => None }) is None)
  // and an enum defining one, whose constructors refer to it so; a
  // constructor named like a keyword is written so too
  let zz_w = @kernel.mk_vartype("Zz_w")
  assert_eq(
    @term_syntax.parse_type_definition(
      "enum `Zz_w` { Zw0; Zw(`Zz_w`, A); `module` }",
    ),
    @list.List([
      (
        zz_w,
        @list.List([
          ("Zw0", @list.List([])),
          ("Zw", @list.List([zz_w, @kernel.mk_vartype("A")])),
          ("module", @list.List([])),
        ]),
      ),
    ]),
  )
}

///|
test "type abbreviations" {
  let a_num = @kernel.mk_type(
    "prod",
    @list.List([@kernel.mk_vartype("A"), @kernel.mk_type("num", @list.List([]))]),
  )
  @preterm.new_type_abbrev("zz_pair", a_num)
  defer @preterm.remove_type_abbrev("zz_pair")
  let ty = @term_syntax.parse_type
  assert_eq(ty("(Zz_pair) -> Bool"), @basics.mk_fun_ty(a_num, @kernel.bool_ty))
  assert_true((Some(ty("Zz_pair[Num]")) catch { _ => None }) is None)
  // a type variable named like the abbreviation would read as it, so is
  // written verbatim
  let v = @kernel.mk_vartype("Zz_pair")
  inspect(@term_syntax.print_type(v), content="`Zz_pair`")
  assert_eq(ty("`Zz_pair`"), v)
  // Unit is HOL's 1 before any abbreviation named unit, in both directions
  @preterm.new_type_abbrev("unit", @kernel.bool_ty)
  defer @preterm.remove_type_abbrev("unit")
  let one = @kernel.mk_type("1", @list.List([]))
  assert_eq(ty("Unit"), one)
  inspect(@term_syntax.print_type(one), content="Unit")
}

///|
test "a name that is a MoonBit keyword is written between backticks" {
  let t = @term_syntax.parse_term("∀ `move` : Bool, `move` || (`ref` : Bool)")
  inspect(
    @term_syntax.print_term(t),
    content="∀ `move` : Bool, `move` || (`ref` : Bool)",
  )
  @kernel.new_constant("yield", @kernel.bool_ty)
  let c = @term_syntax.parse_term("`yield`")
  inspect(@kernel.is_const(c), content="true")
  inspect(@term_syntax.print_term(c), content="`yield`")
  // types and enums keep their backticks: a type named move
  let move_ty = @kernel.mk_vartype("move")
  inspect(@term_syntax.parse_type("`move`") == move_ty, content="true")
  assert_eq(
    @term_syntax.parse_type_definition("enum `move` { Mk(`move`) }"),
    @list.List([(move_ty, @list.List([("Mk", @list.List([move_ty]))]))]),
  )
}
