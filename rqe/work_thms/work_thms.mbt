///|
/// `LENGTH_N`
pub fn length_n(x561 : Int64, x562 : @kernel.HolType) -> @kernel.Thm raise {
  let n = x561
  let ty = x562
  let zero = @parser.parse_term("0")
  let neg = @parser.parse_term("(~)")
  let imp_thm = @class.taut(@parser.parse_term("(a ==> b) ==> (b ==> a) ==> (a <=> b)"))
  match n {
    0L => @bool.conjunct1(@lists.length())
    1L => @rqe_list.length_sing()
    n_1 => {
      let len_tm = @kernel.mk_const("LENGTH", @list.List([(ty, @kernel.aty)]))
      let tl_tm = @kernel.mk_const("TL", @list.List([(ty, @kernel.aty)]))
      let hd_tm = @kernel.mk_const("HD", @list.List([(ty, @kernel.aty)]))
      let t = @kernel.mk_var("t", @kernel.mk_type("list", @list.List([ty])))
      let n_tm = @nums.mk_small_numeral(n_1)
      let pren_tm = @nums.mk_small_numeral(@lib.sub63(n_1, 1L))
      let len_thm = @kernel.assume_rule(@basics.mk_eq(@kernel.mk_comb(len_tm, t), n_tm))
      let pre_thm = length_n(@lib.sub63(n_1, 1L), ty)
      let n_nz = @tactics.prove(@bool.mk_neg(@basics.mk_eq(n_tm, zero)), @int.arith_tac)
      let t563 = @equal.ap_term(neg, @bool.ispec(t, @rqe_list.length_0()))
      let not_nil_thm = @kernel.eq_mp(@simp.rewrite_rule(@list.List([len_thm]))(t563), n_nz)
      let n_suc = @tactics.prove(@basics.mk_eq(n_tm, @kernel.mk_comb(@parser.parse_term("SUC"), pren_tm)), @int.arith_tac)
      let t564 = @drule.match_mp(length_tl())(not_nil_thm)
      let len_tl = @simp.rewrite_rule(@list.List([n_suc, @arith.pre(), @bool.ispec(@kernel.mk_comb(tl_tm, t), pre_thm), len_thm]))(t564)
      let cons_thm = @drule.match_mp(@bool.ispec(t, hd_tl()))(not_nil_thm)
      let hd_thm = @simp.once_rewrite_rule(@list.List([hd_lem()]))(len_tl)
      let thm = @simp.rewrite_rule(@list.List([@equal.gsym(cons_thm)]))(hd_thm)
      let x0 = @kernel.mk_var(("x" + Int64::to_string(n_1)), ty)
      let hdt = @kernel.mk_comb(hd_tm, t)
      let t565 = @kernel.mk_comb(hd_tm, t)
      let ex_thm = @bool.exists_rule(@bool.mk_exists(x0, @basics.subst(@list.List([(x0, hdt)]), @kernel.concl(thm))), t565, thm)
      let left = @bool.disch(@kernel.concl(len_thm), ex_thm)
      let t567 = @simp.asm_rewrite_tac(@list.List([@lists.length()]))
      let t568 = @tactics.then_tac(@tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t567), @int.arith_tac)
      let t566 = @kernel.concl(len_thm)
      let right = @tactics.prove(@bool.mk_imp(@kernel.concl(ex_thm), t566), t568)
      @bool.gen_all(@rqe_tactics_ext.match_mpl(@list.List([imp_thm, left, right])))
    }
  }
}

