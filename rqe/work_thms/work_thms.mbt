    More("r", tail=t_1) => @equal.rand_conv(path_conv2(t_1, cnv))
    More("q", tail=t_2) => quant_conv(path_conv2(t_2, cnv))
    More("a", tail=t_3) => @equal.abs_conv(path_conv2(t_3, cnv))
    _ => raise Failure("PATH_CONV2: unknown direction")
  }
}

