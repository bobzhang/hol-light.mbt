      let pols_p = pols1.concat(@lib.tl(pols2))
      let t130 = @signs.findsign(vars)(sgns)(p)
      let cont_p : (@kernel.Thm) -> ((@list.List[(@kernel.Term, @kernel.Thm)]) -> @kernel.Thm raise) raise = (x131 : @kernel.Thm) => @matinsert.matinsert(vars, i, t130, cont, x131)
      matrix(vars, pols_p, cont_p, sgns, ex_thms, fm)
    } else {
      let t132 = @lib.hd(vars)
      let kqs = @lib.map((x133 : @kernel.Term) => @poly_ext.weakfactor(t132, x133), pols)
      if @lib.exists(fn(x134 : (Int64, @kernel.Term)) -> Bool raise {
        let (k, q) = x134
        ((k != 0L) && !@poly_ext.is_constant(vars, q))
      }, kqs) {
        let t136 = @lib.map(fn(x135 : (Int64, @kernel.Term)) -> @kernel.Term raise {
          x135.1
        }, kqs)
        let pols_p_1 = t136.prepend(@poly_ext.poly_var(@lib.hd(vars)))
        let ks = @lib.map(fn(x137 : (Int64, @kernel.Term)) -> Int64 raise {
          x137.0
        }, kqs)
        let cont_p_1 : (@kernel.Thm) -> ((@list.List[(@kernel.Term, @kernel.Thm)]) -> @kernel.Thm raise) raise = fn(x138 : @kernel.Thm) -> ((@list.List[(@kernel.Term, @kernel.Thm)]) -> @kernel.Thm raise) raise {
          let mat_thm = x138
          fn(x139 : @list.List[(@kernel.Term, @kernel.Thm)]) -> @kernel.Thm raise {
            let ex_thms_1 = x139
            cont(unfactor_mat(vars, pols, mat_thm))(ex_thms_1)
          }
        }
        matrix(vars, pols_p_1, cont_p_1, sgns, ex_thms, fm)
      } else {
        let d = @lib.itlist(fn(x143 : @kernel.Term, x144 : Int64) -> Int64 raise {
          (fn(x140 : Int64) -> ((Int64) -> Int64 raise) raise {
            fn(x141 : Int64) -> Int64 raise {
              if (x140 >= x141) {
                x140
              } else {
                x141
              }
            }
          })(((x142 : @kernel.Term) => @poly_ext.degree_(vars, x142))(x143))(x144)
        }, pols, (-1L))
        let p_2 = @lib.find(fn(x145 : @kernel.Term) -> Bool raise {
          let p_1 = x145
          (@poly_ext.degree_(vars, p_1) == d)
        }, pols)
        let pl_thm = @poly_ext.poly_enlist_conv(vars)(p_2)
        let pl = @equal.rhs(@kernel.concl(pl_thm))
        let (l, x) = @poly_ext.dest_poly(pl)
        let pdiff_thm = gen_poly_diff_conv(vars, p_2)
        let p_pl = @equal.rhs(@kernel.concl(pdiff_thm))
        let t146 = @lib.hd(vars)
        let p_p = @kernel.mk_comb(@kernel.mk_comb(@poly_ext.poly_tm(), p_pl), t146)
        let p_pthm = @equal.thenc(@poly_ext.poly_delist_conv, @poly_ext.polynate_conv(vars))(p_p)
        let p_pc = @equal.rhs(@kernel.concl(p_pthm))
        let hdp_p = @lib.last(@basics.dest_list(p_pl))
        let sign_thm = @signs.findsign(vars)(sgns)(hdp_p)
        let normal_thm = normal_list_conv(sign_thm, p_pl)
        let i_1 = try {
          Int::to_int64(@lib.index(p_2, pols))
        } catch {
          _ => raise Failure("MATRIX: no such pol1")
        }
        let (p1, p2) = @lib.chop_list(@lib.int63_to_int(i_1), pols)
        let qs = (p1.prepend(p_pc)).concat(@lib.tl(p2))
        let (gs, div_thms) = @lib.unzip(@lib.map((x147 : @kernel.Term) => @pdivides.pdivides(vars, sgns, p_2, x147), qs))
        let cont_p_2 : (@kernel.Thm) -> ((@list.List[(@kernel.Term, @kernel.Thm)]) -> @kernel.Thm raise) raise = fn(x148 : @kernel.Thm) -> ((@list.List[(@kernel.Term, @kernel.Thm)]) -> @kernel.Thm raise) raise {
          let mat_thm_1 = x148
          cont(swap_head_col(i_1, mat_thm_1))
        }
        let dedcont : (@kernel.Thm) -> ((@list.List[(@kernel.Term, @kernel.Thm)]) -> @kernel.Thm raise) raise = fn(x150 : @kernel.Thm) -> ((@list.List[(@kernel.Term, @kernel.Thm)]) -> @kernel.Thm raise) raise {
          let mat_thm_2 = x150
          fn(x151 : @list.List[(@kernel.Term, @kernel.Thm)]) -> @kernel.Thm raise {
            let ex_thms_2 = x151
            @dedmatrix.dedmatrix(vars, sgns, div_thms, pdiff_thm, normal_thm, cont_p_2, mat_thm_2, ex_thms_2)
          }
