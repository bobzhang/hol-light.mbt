pub fn[TA] splitsigns(x183 : @list.List[@kernel.Term], x184 : @list.List[@kernel.Term], x185 : @list.List[@kernel.Term], x186 : (@kernel.Thm) -> ((@list.List[(@kernel.Term, @kernel.Thm)]) -> @kernel.Thm raise) raise, x187 : @list.List[@kernel.Thm], x188 : TA, x189 : @kernel.Term) -> @kernel.Thm raise {
