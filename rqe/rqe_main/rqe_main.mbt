    }
  }, monic_pols)
  let transform : (@kernel.Thm) -> @kernel.Thm raise = fn(x202 : @kernel.Thm) -> @kernel.Thm raise {
    let mat_thm_5 = x202
    let mat_thm_p_1 = duplicate_columns_v2(mat_thm_5, indices)
    unmonicize_mat(vars_3, monic_thms, mat_thm_p_1)
  }
  let cont_p_6 : (@kernel.Thm) -> ((@list.List[(@kernel.Term, @kernel.Thm)]) -> @kernel.Thm raise) raise = fn(x203 : @kernel.Thm) -> ((@list.List[(@kernel.Term, @kernel.Thm)]) -> @kernel.Thm raise) raise {
    let mat_thm_6 = x203
    fn(x204 : @list.List[(@kernel.Term, @kernel.Thm)]) -> @kernel.Thm raise {
      let ex_thms_11 = x204
      cont_3(transform(mat_thm_6))(ex_thms_11)
    }
  }
  matrix(vars_3, sols, cont_p_6, sgns_6, ex_thms_10, fm_3)
}

///|
/// `polynomials`
pub fn polynomials(x205 : @kernel.Term) -> @list.List[@kernel.Term] raise {
  let tm = x205
  fn polynomials_1(x206 : @kernel.Term) -> @list.List[@kernel.Term] raise {
    let tm_1 = x206
    if ((tm_1 == @lift_qelim.t_tm()) || (tm_1 == @lift_qelim.f_tm())) {
      @list.empty()
    } else {
      if (@basics.is_conj(tm_1) || (@basics.is_disj(tm_1) || (@basics.is_imp(tm_1) || @bool.is_iff(tm_1)))) {
        let (_, l, r) = @rqe_lib.get_binop(tm_1)
        let t207 = polynomials_1(r)
        polynomials_1(l).concat(t207)
      } else {
        if @basics.is_neg(tm_1) {
          polynomials_1(@basics.dest_neg(tm_1))
        } else {
          if (@lib.can((x208 : @kernel.Term) => @basics.dest_binop(@rqe_real.rlt(), x208), tm_1) || (@lib.can((x209 : @kernel.Term) => @basics.dest_binop(@rqe_real.rgt(), x209), tm_1) || (@lib.can((x210 : @kernel.Term) => @basics.dest_binop(@rqe_real.rle(), x210), tm_1) || (@lib.can((x211 : @kernel.Term) => @basics.dest_binop(@rqe_real.rge(), x211), tm_1) || (@lib.can((x212 : @kernel.Term) => @basics.dest_binop(@rqe_real.req(), x212), tm_1) || @lib.can((x213 : @kernel.Term) => @basics.dest_binop(@rqe_real.rneq(), x213), tm_1)))))) {
            let (_, l_1, _) = @rqe_lib.get_binop(tm_1)
            @list.List([l_1])
          } else {
            raise Failure("not a fol atom")
          }
        }
      }
    }
  }
  @lib.setify(polynomials_1(tm))
}

///|
/// `BASIC_REAL_QELIM_CONV`
pub fn basic_real_qelim_conv(x214 : @list.List[@kernel.Term], x215 : @kernel.Term) -> @kernel.Thm raise {
  let vars = x214
  let fm = x215
  let (x, bod) = @basics.dest_exists(fm)
  let pols = polynomials(bod)
  let cont : (@kernel.Thm) -> ((@list.List[(@kernel.Term, @kernel.Thm)]) -> @kernel.Thm raise) raise = fn(x216 : @kernel.Thm) -> ((@list.List[(@kernel.Term, @kernel.Thm)]) -> @kernel.Thm raise) raise {
    let mat_thm = x216
    fn(x217 : @list.List[(@kernel.Term, @kernel.Thm)]) -> @kernel.Thm raise {
      let ex_thms = x217
      let ex_thms_p = @lib.sort(fn(x218 : (@kernel.Term, @kernel.Thm), x219 : (@kernel.Term, @kernel.Thm)) -> Bool raise {
        let x_1 = x218
        let y = x219
        @signs.xterm_lt(y.0, x_1.0)
      }, ex_thms)
      let comb_thm = @testform.combine_testforms(x, mat_thm, bod)
      let comb_thm_p = @lib.rev_itlist(fn(x220 : (@kernel.Term, @kernel.Thm), x221 : @kernel.Thm) -> @kernel.Thm raise {
        @bool.choose_rule(x220.0, x220.1, x221)
      }, ex_thms_p, comb_thm)
      comb_thm_p
    }
  }
  let ret_thm = splitzero(vars.prepend(x), @list.empty(), pols, cont, @main_thms.empty_sgns(), @list.empty(), fm)
  @simp.pure_rewrite_rule(@list.List([@basic.neq()]))(ret_thm)
}

///|
/// `REAL_QELIM_CONV`
pub fn real_qelim_conv(x222 : @kernel.Term) -> @kernel.Thm raise {
  let fm = x222
  reset_counts(())
  @equal.thenc(@equal.thenc(@lift_qelim.lift_qelim_conv(fn(x223 : @list.List[@kernel.Term]) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    fn(x224 : @kernel.Term) -> @kernel.Thm raise {
      @poly_ext.polyatom_conv(x223, x224)
    }
  }, @equal.thenc(@simplify.evalc_conv, @simplify.simplify_conv), fn(x225 : @list.List[@kernel.Term]) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    fn(x226 : @kernel.Term) -> @kernel.Thm raise {
      basic_real_qelim_conv(x225, x226)
    }
  }), @simplify.evalc_conv), @simplify.simplify_conv)(fm)
}

