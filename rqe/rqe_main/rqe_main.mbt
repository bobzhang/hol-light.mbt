  let fm_3 = x198
  @lib.incr(monicize_count())
  let monic_thms = @lib.map(@poly_ext.monic_conv(vars_3), pols_3)
  let monic_pols = @lib.map(fn(x200 : @kernel.Thm) -> @kernel.Term raise {
    @equal.rhs((fn(x199 : @kernel.Thm) -> @kernel.Term raise {
      @kernel.concl(x199)
