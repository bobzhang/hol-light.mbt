pub fn unfactor_isign(x93 : @list.List[@kernel.Term], x94 : @kernel.Thm, x95 : @kernel.Term, x96 : @kernel.Thm) -> @kernel.Thm raise {
  let vars = x93
  let xsign_thm = x94
  let pol = x95
  let isign_thm = x96
  let x = @lib.hd(vars)
  let (k, pol_p) = @poly_ext.weakfactor(x, pol)
  if (k == 0L) {
    isign_thm
  } else {
    let fact_thm = @bool.gen(x, @equal.gsym(@poly_ext.weakfactor_conv(x, pol)))
    let par_thm = @rqe_num.parity_conv(@nums.mk_small_numeral(k))
    let (_, _, xsign) = @defs.dest_interpsign(xsign_thm)
    let (_, _, psign) = @defs.dest_interpsign(isign_thm)
    let (parity, _) = @kernel.dest_comb(@kernel.concl(par_thm))
    if (xsign == @defs.spos_tm()) {
      let mp_thm = if (psign == @defs.spos_tm()) {
        @main_thms.factor_pos_pos()
      } else {
        if (psign == @defs.sneg_tm()) {
          @main_thms.factor_pos_neg()
        } else {
          if (psign == @defs.szero_tm()) {
            @main_thms.factor_pos_zero()
          } else {
            raise Failure("bad sign")
          }
        }
      }
      let ret = @equal.beta_rule(@rqe_tactics_ext.match_mpl(@list.List([mp_thm, xsign_thm, isign_thm])))
      @drule.match_mp(ret)(fact_thm)
    } else {
      if (xsign == @defs.szero_tm()) {
        let k_thm = @tactics.prove(@bool.mk_neg(@basics.mk_eq(@nums.mk_small_numeral(k), @rqe_num.nzero())), @int.arith_tac)
        let mp_thm_1 = if (psign == @defs.spos_tm()) {
          @main_thms.factor_zero_pos()
        } else {
          if (psign == @defs.sneg_tm()) {
            @main_thms.factor_zero_neg()
          } else {
            if (psign == @defs.szero_tm()) {
              @main_thms.factor_zero_zero()
            } else {
              raise Failure("bad sign")
            }
          }
        }
        let ret_1 = @equal.beta_rule(@rqe_tactics_ext.match_mpl(@list.List([mp_thm_1, xsign_thm, isign_thm, k_thm])))
        @drule.match_mp(ret_1)(fact_thm)
      } else {
        if ((xsign == @defs.sneg_tm()) && (parity == @rqe_num.even_tm())) {
          let k_thm_1 = @tactics.prove(@bool.mk_neg(@basics.mk_eq(@nums.mk_small_numeral(k), @rqe_num.nzero())), @int.arith_tac)
          let mp_thm_2 = if (psign == @defs.spos_tm()) {
            @main_thms.factor_neg_even_pos()
          } else {
            if (psign == @defs.sneg_tm()) {
              @main_thms.factor_neg_even_neg()
            } else {
              if (psign == @defs.szero_tm()) {
                @main_thms.factor_neg_even_zero()
              } else {
                raise Failure("bad sign")
              }
            }
          }
          let ret_2 = @equal.beta_rule(@rqe_tactics_ext.match_mpl(@list.List([mp_thm_2, xsign_thm, isign_thm, par_thm, k_thm_1])))
          @drule.match_mp(ret_2)(fact_thm)
        } else {
          if ((xsign == @defs.sneg_tm()) && (parity == @rqe_num.odd_tm())) {
            let k_thm_2 = @tactics.prove(@bool.mk_neg(@basics.mk_eq(@nums.mk_small_numeral(k), @rqe_num.nzero())), @int.arith_tac)
            let mp_thm_3 = if (psign == @defs.spos_tm()) {
              @main_thms.factor_neg_odd_pos()
            } else {
              if (psign == @defs.sneg_tm()) {
                @main_thms.factor_neg_odd_neg()
              } else {
                if (psign == @defs.szero_tm()) {
                  @main_thms.factor_neg_odd_zero()
                } else {
                  raise Failure("bad sign")
                }
              }
            }
            let ret_3 = @equal.beta_rule(@rqe_tactics_ext.match_mpl(@list.List([mp_thm_3, xsign_thm, isign_thm, par_thm, k_thm_2])))
            @drule.match_mp(ret_3)(fact_thm)
          } else {
            raise Failure("bad something...")
          }
        }
      }
    }
  }
}

///|
/// `UNFACTOR_ISIGNS`
pub fn unfactor_isigns(x97 : @list.List[@kernel.Term], x98 : @list.List[@kernel.Term], x99 : @kernel.Thm) -> @kernel.Thm raise {
  let vars = x97
  let pols = x98
  let isigns_thm = x99
  let isign_thms = @defs.interpsigns_thms2(isigns_thm)
  let t103 = @lib.tl(isign_thms)
  let t100 = @lib.hd(isign_thms)
  let isign_thms_p = @lib.map2((x101 : @kernel.Term, x102 : @kernel.Thm) => unfactor_isign(vars, t100, x101, x102), pols, t103)
  @defs.mk_interpsigns(isign_thms_p)
}

///|
/// `UNFACTOR_MAT`
pub fn unfactor_mat_v1(x104 : @list.List[@kernel.Term], x105 : @list.List[@kernel.Term], x106 : @kernel.Thm) -> @kernel.Thm raise {
  let vars = x104
  let pols = x105
  let mat_thm = x106
  let (rol_thm, all_thm) = @defs.interpmat_thms(mat_thm)
  let (ints, part, signs) = @defs.dest_all2(@kernel.concl(all_thm))
  let part_thm = @defs.partition_line_conv(@kernel.dest_comb(part).1)
  let isigns_thms = @bool.conjuncts_rule(@simp.rewrite_rule(@list.List([@lists.all2(), part_thm]))(all_thm))
  let isigns_thms_p = @lib.map((x107 : @kernel.Thm) => unfactor_isigns(vars, pols, x107), isigns_thms)
  let all_thm_p = @defs.mk_all2_interpsigns(part_thm, isigns_thms_p)
  let all_thm_p_p = @simp.rewrite_rule(@list.List([@equal.gsym(part_thm)]))(all_thm_p)
  let mat_thm_p = @defs.mk_interpmat_thm(rol_thm, all_thm_p_p)
  mat_thm_p
}

///|
/// `UNFACTOR_MAT`
pub fn unfactor_mat(x108 : @list.List[@kernel.Term], x109 : @list.List[@kernel.Term], x110 : @kernel.Thm) -> @kernel.Thm raise {
  let vars = x108
  let pols = x109
  let mat_thm = x110
  let start_time = {
    (@lib.cpu_time.val)()
  }
  let res = unfactor_mat_v1(vars, pols, mat_thm)
  @rqe_lib.op_plus_dot_eq(@timers.unfactor_mat_timer(), (({
    (@lib.cpu_time.val)()
  }) - start_time))
  res
}

