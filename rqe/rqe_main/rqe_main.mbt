              fn(x177 : @kernel.Term) -> @kernel.Thm raise {
                ((x170 : (@kernel.Thm) -> ((@list.List[(@kernel.Term, @kernel.Thm)]) -> @kernel.Thm raise) raise, x171 : @list.List[@kernel.Thm], x172 : TA, x173 : @kernel.Term) => splitzero(vars_1, dun, ops.prepend(hp), x170, x171, x172, x173))(x174, x175, x176, x177)
