///|
/// `MATRIX`
pub fn[TA] matrix(x122 : @list.List[@kernel.Term], x123 : @list.List[@kernel.Term], x124 : (@kernel.Thm) -> ((@list.List[(@kernel.Term, @kernel.Thm)]) -> @kernel.Thm raise) raise, x125 : @list.List[@kernel.Thm], x126 : TA, x127 : @kernel.Term) -> @kernel.Thm raise {
