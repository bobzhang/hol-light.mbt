pub fn[TA] splitzero(x152 : @list.List[@kernel.Term], x153 : @list.List[@kernel.Term], x154 : @list.List[@kernel.Term], x155 : (@kernel.Thm) -> ((@list.List[(@kernel.Term, @kernel.Thm)]) -> @kernel.Thm raise) raise, x156 : @list.List[@kernel.Thm], x157 : TA, x158 : @kernel.Term) -> @kernel.Thm raise {
