///|
/// `MONICIZE`
pub fn[TA] monicize(x193 : @list.List[@kernel.Term], x194 : @list.List[@kernel.Term], x195 : (@kernel.Thm) -> ((@list.List[(@kernel.Term, @kernel.Thm)]) -> @kernel.Thm raise) raise, x196 : @list.List[@kernel.Thm], x197 : TA, x198 : @kernel.Term) -> @kernel.Thm raise {
