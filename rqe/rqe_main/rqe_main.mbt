        let tmp : (@list.List[@kernel.Thm]) -> ((TA) -> ((@kernel.Term) -> @kernel.Thm raise) raise) raise = fn(x165 : @list.List[@kernel.Thm]) -> ((TA) -> ((@kernel.Term) -> @kernel.Thm raise) raise) raise {
