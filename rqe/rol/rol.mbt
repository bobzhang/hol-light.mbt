///|
/// lem2
fn step_23() -> Unit raise {
  let t185 = @list.List([@meson.asm_meson_tac(@list.List([real_ordered_list(), @lists.not_cons_nil(), @lists.hd(), @lists.tl()]))])
  lem2_v1_c.set(@rqe_tactics_ext.prove_by_refinement(@parser.parse_term("!x y. x < y ==> real_ordered_list (CONS y t) ==>\n     real_ordered_list (CONS x (CONS y t))"), t185))
}

///|
let lem2_v1_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("lem2")

///|
/// `lem2`
pub fn lem2_v1() -> @kernel.Thm {
  lem2_v1_c.get()
}

///|
/// `mk_rol`
pub fn mk_rol(x186 : @list.List[@kernel.Thm]) -> @kernel.Thm raise {
  let ord_thms = x186
  match ord_thms {
    Empty => lem0()
    More(x, tail=Empty) => @drule.match_mp(lem1())(x)
    More(h1, tail=More(h2, tail=rest)) => {
      let t189 = @lib.last(ord_thms)
      let t190 = @drule.match_mp(lem1())(t189)
      @lib.itlist(fn(x187 : @kernel.Thm, x188 : @kernel.Thm) -> @kernel.Thm raise {
        let x_1 = x187
        let y = x188
        @rqe_tactics_ext.match_mpl(@list.List([lem2_v1(), x_1, y]))
      }, @lib.butlast(ord_thms), t190)
    }
  }
}

