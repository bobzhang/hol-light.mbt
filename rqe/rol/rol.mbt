  lem_c.get()
}

///|
/// lem2
fn step_27() -> Unit raise {
  lem2_c.set(@tactics.prove(@parser.parse_term("!x y z. y < z ==> (y < x <=> (y < x /\\ x < z) \\/ (x = z) \\/ z < x)"), @calc_rat.real_arith_tac))
}

///|
let lem2_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("lem2")

///|
/// `lem2`
pub fn lem2() -> @kernel.Thm {
  lem2_c.get()
}

///|
/// `ROL_COVERS`
pub fn rol_covers(x198 : @kernel.Thm) -> @kernel.Thm raise {
  let rol_thm = x198
  let pts = @basics.dest_list(@kernel.dest_comb(@kernel.concl(rol_thm)).1)
  if (Int::to_int64(@lib.length(pts)) == 1L) {
    @bool.ispec(@lib.hd(pts), lem())
  } else {
    let thms = rol_thms(rol_thm)
    let thms_p = @lib.map(@drule.match_mp(lem2()), thms)
    let base = @bool.ispec(@lib.hd(pts), lem())
    @lib.itlist(fn(x199 : @kernel.Thm, x200 : @kernel.Thm) -> @kernel.Thm raise {
      let x = x199
      let y = x200
      @simp.once_rewrite_rule(@list.List([@drule.match_mp(lem2())(x)]))(y)
    }, @lib.rev(thms), base)
  }
}

