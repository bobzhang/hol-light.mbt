///|
/// `rol_nonempty_thms`
pub fn rol_nonempty_thms(x179 : @kernel.Thm) -> @list.List[@kernel.Thm] raise {
  let rol_thm = x179
  let pts = @basics.dest_list(@kernel.dest_comb(@kernel.concl(rol_thm)).1)
  if (Int::to_int64(@lib.length(pts)) == 0L) {
    @list.List([lem0_v1()])
  } else {
    if (Int::to_int64(@lib.length(pts)) == 1L) {
      @bool.conjuncts_rule(@bool.ispec(@lib.hd(pts), lem1_v2()))
    } else {
      let rthms = rol_thms(rol_thm)
      let pt_thms = @lib.map(fn(x182 : @kernel.Term) -> @kernel.Thm raise {
        (fn(x180 : @kernel.Term) -> ((@kernel.Thm) -> @kernel.Thm raise) raise {
          fn(x181 : @kernel.Thm) -> @kernel.Thm raise {
            @bool.ispec(x180, x181)
          }
        })(x182)(lem_v1())
      }, pts)
      let left_thm = @bool.ispec(@lib.hd(pts), @rqe_real.real_gt_exists())
      let right_thm = @bool.ispec(@lib.last(pts), @rqe_real.real_lt_exists())
      let int_thms = @lib.map(@drule.match_mp(@rqe_real.real_dense()), rthms)
      let thms = interleave(pt_thms, int_thms)
      (thms.prepend(left_thm)).concat(@list.List([right_thm]))
    }
  }
}

///|
/// lem0
fn step_21() -> Unit raise {
  let t183 = @list.List([@simp.rewrite_tac(@list.List([real_ordered_list()]))])
  lem0_c.set(@rqe_tactics_ext.prove_by_refinement(@parser.parse_term("real_ordered_list []"), t183))
}

///|
let lem0_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("lem0")

