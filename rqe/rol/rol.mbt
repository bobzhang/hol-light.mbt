///|
/// `ROL_INSERT`
pub fn rol_insert(x168 : @kernel.Thm, x169 : @kernel.Thm) -> @kernel.Thm raise {
  let place_thm = x168
  let rol_thm = x169
  let place_thm_p = @simp.rewrite_rule(@list.List([@realax.real_gt()]))(place_thm)
  if @basics.is_conj(@kernel.concl(place_thm_p)) {
    rol_insert_middle(place_thm_p, rol_thm)
  } else {
    let (_, rlist) = @kernel.dest_comb(@kernel.concl(rol_thm))
    let rlist_p = @basics.dest_list(rlist)
    let h = @lib.hd(rlist_p)
    let (l, r) = @basics.dest_binop(@rqe_real.rlt(), @kernel.concl(place_thm_p))
    if (r == h) {
      rol_insert_front(place_thm_p, rol_thm)
    } else {
      rol_insert_back(place_thm_p, rol_thm)
    }
  }
}

