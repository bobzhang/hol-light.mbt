///|
/// `interleave`
pub fn[TA] interleave(x172 : @list.List[TA], x173 : @list.List[TA]) -> @list.List[TA] raise {
  let l1 = x172
  let l2 = x173
  match l1 {
    Empty => l2
    More(h, tail=t) => {
      match l2 {
        Empty => l1
        More(h1, tail=t1_1) => (interleave(t, t1_1).prepend(h1)).prepend(h)
      }
    }
  }
}

