  let t147 = @lists.mk_list(l2_p, @rqe_real.real_ty())
  let (l1, l2) = (@lists.mk_list(l1_p, @rqe_real.real_ty()), t147)
  let tm = @basics.mk_binop(@rqe_real.rappend(), l1, l2)
  @equal.gsym(@simp.rewrite_conv(@list.List([@lists.append()]))(tm))
}

