///|
/// `ROL_INSERT_MIDDLE`
pub fn rol_insert_middle(x155 : @kernel.Thm, x156 : @kernel.Thm) -> @kernel.Thm raise {
  let place_thm = x155
  let rol_thm = x156
  match @bool.conjuncts_rule(place_thm) {
    More(pl1, tail=More(pl2, tail=Empty)) => {
      let list = @kernel.dest_comb(@kernel.concl(rol_thm)).1
      let (ltl, ltr) = @basics.dest_conj(@kernel.concl(place_thm))
      let (x1, x4) = @basics.dest_binop(@rqe_real.rlt(), ltl)
      let (_, x2) = @basics.dest_binop(@rqe_real.rlt(), ltr)
      let n = @lib.add63(Int::to_int64(@lib.index(x1, @basics.dest_list(list))), 1L)
      let (new_x, slot) = (x4, n)
      let (lthm, rthm, lt_thm) = rol_chop_list(slot, rol_thm)
      let llist = @kernel.dest_comb(@kernel.concl(lthm)).1
      let hllist = @lib.hd(@basics.dest_list(llist))
      let tllist = @rqe_real.mk_rlist(@lib.tl(@basics.dest_list(llist)))
      let rlist = @kernel.dest_comb(@kernel.concl(rthm)).1
      let hrlist = @lib.hd(@basics.dest_list(rlist))
      let trlist = @rqe_real.mk_rlist(@lib.tl(@basics.dest_list(rlist)))
      let gthm = @simp.rewrite_rule(@list.List([@basic.and_imp_thm()]))(rol_insert_thm())
      let a1 = lthm
      let a2 = rthm
      let a3 = @bool.ispecl(@list.List([hllist, tllist]), @lists.not_cons_nil())
      let a4 = @bool.ispecl(@list.List([hrlist, trlist]), @lists.not_cons_nil())
      let (l, r) = @basics.dest_binop(@rqe_real.rlt(), @kernel.concl(pl1))
      let t157 = @simp.rewrite_tac(@list.List([@lists.last(), @class.cond_clauses(), @lists.not_cons_nil()]))
      let a5_aux = @tactics.prove(@basics.mk_eq(@kernel.mk_comb(@rqe_real.rlast(), llist), l), t157)
      let a5 = @rqe_tactics_ext.match_mpl(@list.List([@bool.ispecl(@list.List([l, r, llist]), @simp.rewrite_rule(@list.List([@basic.and_imp_thm()]))(lem1_v1())), pl1, a5_aux]))
      let a6_aux = @bool.ispecl(@list.List([trlist, hrlist]), @bool.gen_all(@lists.hd()))
      let a6 = @equal.conv_rule(@equal.rand_conv(@simp.once_rewrite_conv(@list.List([@equal.gsym(a6_aux)]))), pl2)
      let thm = @rqe_tactics_ext.match_mpl(@list.List([gthm, a1, a2, a3, a4, a5, a6]))
      @simp.rewrite_rule(@list.List([@lists.append()]))(thm)
    }
    _ => raise @lib.MatchFailure("tscript.ml:327")
  }
}

///|
/// `ROL_INSERT_FRONT`
pub fn rol_insert_front(x158 : @kernel.Thm, x159 : @kernel.Thm) -> @kernel.Thm raise {
  let place_thm = x158
  let rol_thm = x159
  let (_, rlist) = @kernel.dest_comb(@kernel.concl(rol_thm))
  let t160 = @rqe_real.mk_rlist(@lib.tl(@basics.dest_list(rlist)))
  let (h, t) = (@lib.hd(@basics.dest_list(rlist)), t160)
  let imp_thm = @bool.ispecl(@list.List([h, t]), @equal.gsym(rol_cons_cons()))
  let t161 = @bool.eq_imp_rule(imp_thm).0
  let imp_thm_p = @simp.rewrite_rule(@list.List([@basic.and_imp_thm()]))(t161)
  @rqe_tactics_ext.match_mpl(@list.List([imp_thm_p, rol_thm, place_thm]))
}

///|
/// `ROL_INSERT_BACK`
pub fn rol_insert_back(x162 : @kernel.Thm, x163 : @kernel.Thm) -> @kernel.Thm raise {
  let place_thm = x162
  let rol_thm = x163
  let (_, rlist) = @kernel.dest_comb(@kernel.concl(rol_thm))
  let rlist_p = @basics.dest_list(rlist)
  let t164 = @rqe_real.mk_rlist(@lib.tl(rlist_p))
  let (h, t) = (@lib.hd(rlist_p), t164)
  let lst = @lib.last(rlist_p)
  let (b, x) = @basics.dest_binop(@rqe_real.rlt(), @kernel.concl(place_thm))
  let t165 = @bool.ispecl(@list.List([x, rlist]), rol_insert_back_thm())
  let imp_thm = @simp.rewrite_rule(@list.List([@basic.and_imp_thm()]))(t165)
  let a1 = rol_thm
  let a2 = @bool.ispecl(@list.List([h, t]), @lists.not_cons_nil())
  let t166 = @simp.rewrite_tac(@list.List([@lists.last(), @class.cond_clauses(), @lists.not_cons_nil()]))
  let a3_aux = @tactics.prove(@basics.mk_eq(@kernel.mk_comb(@rqe_real.rlast(), rlist), lst), t166)
  let a3 = @rqe_tactics_ext.match_mpl(@list.List([@bool.ispecl(@list.List([lst, x, rlist]), @simp.rewrite_rule(@list.List([@basic.and_imp_thm()]))(lem1_v1())), place_thm, a3_aux]))
  let t167 = @rqe_tactics_ext.match_mpl(@list.List([imp_thm, a1, a2, a3]))
