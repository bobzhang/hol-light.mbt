  rol_nil_c.set(@tactics.prove(@parser.parse_term("real_ordered_list ([]:real list)"), t191))
}

///|
let rol_nil_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("ROL_NIL")

///|
/// `ROL_NIL`
pub fn rol_nil() -> @kernel.Thm {
  rol_nil_c.get()
}

///|
/// `ROL_REMOVE`
pub fn rol_remove(x192 : @kernel.Term, x193 : @kernel.Thm) -> @kernel.Thm raise {
  let x = x192
  let rol_thm = x193
  let list = @basics.dest_list(@kernel.dest_comb(@kernel.concl(rol_thm)).1)
  if (Int::to_int64(@lib.length(list)) == 0L) {
    raise Failure("ROL_REMOVE: 0")
  } else {
    if (Int::to_int64(@lib.length(list)) == 1L) {
      if (x == @lib.hd(list)) {
        rol_nil()
      } else {
        raise Failure("ROL_REMOVE: Not an elem")
      }
    } else {
      if (Int::to_int64(@lib.length(list)) == 2L) {
        match list {
          More(l, tail=More(r, tail=Empty)) => {
            if (l == x) {
              @bool.ispec(r, rol_sing())
            } else {
              if (r == x) {
                @bool.ispec(l, rol_sing())
              } else {
                raise Failure("ROL_REMOVE: Not an elem")
              }
            }
          }
          _ => raise @lib.MatchFailure("tscript.ml:543")
        }
      } else {
        let ord_thms = rol_thms(rol_thm)
        let partition_fun : (@kernel.Thm) -> Bool raise = fn(x194 : @kernel.Thm) -> Bool raise {
          let thm = x194
          let (l_1, r_1) = @basics.dest_binop(@rqe_real.rlt(), @kernel.concl(thm))
          (!((x == l_1)) && !((x == r_1)))
        }
        let (ord_thms_p, elim_thms) = @lib.partition(partition_fun, ord_thms)
        if (Int::to_int64(@lib.length(elim_thms)) == 1L) {
          mk_rol(ord_thms_p)
        } else {
          match elim_thms {
            More(xy_thm, tail=More(yz_thm, tail=Empty)) => {
              let t195 = @bool.conj(xy_thm, yz_thm)
              let connect_thm = @drule.match_mp(@realarith.real_lt_trans())(t195)
              fn insert(x196 : @kernel.Thm, x197 : @list.List[@kernel.Thm]) -> @list.List[@kernel.Thm] raise {
                let xz_thm = x196
                let thms = x197
                match thms {
                  Empty => @list.List([connect_thm])
                  More(h, tail=t) => {
                    let (l_2, r_2) = @basics.dest_binop(@rqe_real.rlt(), @kernel.concl(h))
                    let (l1, r1) = @basics.dest_binop(@rqe_real.rlt(), @kernel.concl(xz_thm))
                    if (r1 == l_2) {
                      (t.prepend(h)).prepend(xz_thm)
                    } else {
                      insert(xz_thm, t).prepend(h)
                    }
                  }
                }
              }
              let ord_thms_p_p = insert(connect_thm, ord_thms_p)
              mk_rol(ord_thms_p_p)
            }
            _ => raise @lib.MatchFailure("tscript.ml:554")
          }
        }
      }
    }
  }
}

///|
/// lem
fn step_26() -> Unit raise {
  lem_c.set(@tactics.prove(@parser.parse_term("!y x. x < y \\/ (x = y) \\/ y < x"), @calc_rat.real_arith_tac))
}

