///|
/// `pgoal`
pub fn pgoal(x152 : Unit) -> @tactics.Goalstack raise {
  let _ = x152
  @tactics.current_goalstack.val
}

///|
fn load_steps() -> Unit raise {
  step_1()
  step_2()
  step_3()
  step_4()
  step_5()
  step_6()
}
