///|
/// `MATCH_MPL`
pub fn match_mpl(x132 : @list.List[@kernel.Thm]) -> @kernel.Thm raise {
  let thms = x132
  match thms {
    More(thm, tail=Empty) => thm
    More(impl_, tail=More(ant, tail=rest)) => match_mpl(rest.prepend(@drule.match_mp(impl_)(ant)))
    _ => raise @lib.MatchFailure("tscript.ml:216")
  }
}

///|
/// `MATCH_EQ_MPL`
pub fn match_eq_mpl(x133 : @list.List[@kernel.Thm]) -> @kernel.Thm raise {
  let thms = x133
  match thms {
    More(thm, tail=Empty) => thm
    More(impl_, tail=More(ant, tail=rest)) => match_eq_mpl(rest.prepend(match_eq_mp(impl_, ant)))
    _ => raise @lib.MatchFailure("tscript.ml:222")
  }
}

