///|
/// CCONTR_TAC
fn step_5() -> Unit raise {
  ccontr_tac_c.set(@tactics.then_tac(@tactics.match_mp_tac(@class.taut(@parser.parse_term("(~x ==> F) ==> x"))), @tactics.strip_tac))
}

///|
let ccontr_tac_c : @lib.Cell[@tactics.Tactic] = @lib.Cell::new("CCONTR_TAC")

///|
/// `CCONTR_TAC`
pub fn ccontr_tac(x : @tactics.Goal) -> @tactics.Goalstate raise {
  (ccontr_tac_c.get())(x)
}

///|
/// DISCH_ASS
fn step_6() -> Unit raise {
  disch_ass_c.set(@tactics.disch_then(fn(x149 : @kernel.Thm) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise) raise {
    let x = x149
    let t151 = @tactics.mp_tac(x)
    @tactics.then_tac(@tactics.assume_tac(x), t151)
  }))
