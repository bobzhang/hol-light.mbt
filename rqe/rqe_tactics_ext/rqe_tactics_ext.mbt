///|
let disch_ass_c : @lib.Cell[@tactics.Tactic] = @lib.Cell::new("DISCH_ASS")

///|
/// `DISCH_ASS`
pub fn disch_ass(x : @tactics.Goal) -> @tactics.Goalstate raise {
  (disch_ass_c.get())(x)
