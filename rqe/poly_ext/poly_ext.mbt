///|
/// POLY_DERIV_CONV
fn step_26() -> Unit raise {
  let poly_diff_tm = @parser.parse_term("poly_diff")
  let pth = @simp.gen_rewrite_rule(fn(x223 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    x223
  }, @list.List([@theorems.swap_forall_thm()]))(poly_diff())
  poly_deriv_conv_c.set(fn(x224 : @list.List[@kernel.Term]) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    let vars = x224
    fn(x225 : @kernel.Term) -> @kernel.Thm raise {
      let tm = x225
      let th1 = poly_enlist_conv(vars)(tm)
      let t226 = @equal.lhand(@kernel.rand(@kernel.concl(th1)))
      let th2 = @bool.specl(@list.List([@lib.hd(vars), t226]), pth)
      let t227 = poly_mul_conv(vars)
      let t229 = @equal.thenc(@equal.land_conv(@equal.thenc(canon_poly_diff_conv, (x228 : @kernel.Term) => @lists.list_conv(t227, x228))), poly_delist_conv)
      @equal.conv_rule(@equal.rator_conv(@equal.comb2_conv(@equal.rand_conv(@equal.abs_conv(poly_delist_conv)), t229)), th2)
    }
  })
}

