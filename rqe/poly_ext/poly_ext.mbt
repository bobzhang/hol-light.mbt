  let aux_conv0 : (@kernel.Term) -> @kernel.Thm raise = @simp.gen_rewrite_conv(fn(x93 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    x93
  }, @list.List([@bool.conjunct1(@poly.poly_diff_aux())]))
  let aux_conv1 : (@kernel.Term) -> @kernel.Thm raise = @simp.gen_rewrite_conv(fn(x94 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    x94
  }, @list.List([@bool.conjunct2(@poly.poly_diff_aux())]))
  let diff_conv0 : (@kernel.Term) -> @kernel.Thm raise = @simp.gen_rewrite_conv(fn(x95 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    x95
  }, @lib.butlast(@bool.conjuncts_rule(poly_diff_clauses())))
  let diff_conv1 : (@kernel.Term) -> @kernel.Thm raise = @simp.gen_rewrite_conv(fn(x96 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    x96
  }, @list.List([@lib.last(@bool.conjuncts_rule(poly_diff_clauses()))]))
  fn poly_diff_aux_conv(x97 : @kernel.Term) -> @kernel.Thm raise {
    let tm = x97
    @equal.orelsec(aux_conv0, @equal.thenc(aux_conv1, @equal.rand_conv(@equal.thenc(@equal.land_conv(@calc_num.num_suc_conv), poly_diff_aux_conv))))(tm)
  }
  canon_poly_diff_conv_c.set(@equal.orelsec(diff_conv0, @equal.thenc(diff_conv1, poly_diff_aux_conv)))
}

