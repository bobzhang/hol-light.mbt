///|
/// `SIMP_POW_CONV`
pub fn simp_pow_conv(x249 : @kernel.Term) -> @kernel.Thm raise {
  let tm = x249
  let t250 = @num_calc_simp.arith_simp_conv(@list.empty())
  let thm1 = @equal.thenc(@simp.rewrite_conv(@list.List([@equal.gsym(@realax.real_mul_assoc()), lem1(), lem2(), pow_prod_sum()])), t250)(tm)
  let (_, r) = @kernel.dest_eq(@kernel.concl(thm1))
  if @lib.can(@rqe_real.dest_pow, r) {
    thm1
  } else {
    let thm2 = @bool.ispec(r, lem3())
    thm2
  }
}

///|
/// `WEAKFACTOR_CONV`
pub fn weakfactor_conv(x251 : @kernel.Term, x252 : @kernel.Term) -> @kernel.Thm raise {
  let x = x251
  let pol = x252
  let (k, pol_p) = weakfactor(x, pol)
  let t263 = @simp.pure_rewrite_conv(@list.List([@realax.real_mul_assoc()]))
  let t262 = @lib.range(0L, @lib.sub63(k, 1L))
  let t261 = @lib.int63_to_int(k)
  let thm1 = @equal.thenc(@lib.itlist2(fn(x253 : (@kernel.Term) -> @kernel.Thm raise, x254 : Int64, x255 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    let x_1 = x253
    let y = x254
    let z = x255
    @equal.thenc(@lib.funpow(@lib.int63_to_int(y), fn(x257 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
      let s258 = @equal.rand_conv(x257)
      fn(x259 : @kernel.Term) -> @kernel.Thm raise {
        s258(x259)
      }
    }, x_1), z)
  }, @lib.replicate(@simp.gen_rewrite_conv(fn(x260 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    x260
  }, @list.List([@realax.real_add_lid()])), t261), t262, @equal.all_conv), t263)(pol)
  let thm2 = @equal.conv_rule(@equal.rand_conv(@equal.land_conv(simp_pow_conv)), thm1)
  thm2
}

