///|
/// POLY_MUL_CONV
fn step_12() -> Unit raise {
  let t120 = @parser.parse_term("(pol1 * (d + y * q) = (pol1 * d) + y * (pol1 * q)) /\\\n     ((c + x * p) * pol2 = (c * pol2) + x * (p * pol2)) /\\\n     (pol1 * (d + x * q) = pol1 * d + (&0 + x * pol1 * q)) /\\\n     (&0 * pol2 = &0) /\\\n     (pol1 * &0 = &0)")
  poly_mul_conv_c.set(match (fn(x119 : @kernel.Thm) -> @list.List[(@kernel.Term) -> @kernel.Thm raise] raise {
    ((x118 : @list.List[@kernel.Thm]) => @lib.map(@simp.rewr_conv, x118))(@bool.conjuncts_rule(x119))
  })(@calc_rat.real_arith(t120)) {
    More(cnv_l1, tail=More(cnv_r1, tail=More(cnv_2, tail=More(cnv_l0, tail=More(cnv_r0, tail=Empty))))) => {
      let t121 = @parser.parse_term("( * )")
      let dest_mul : (@kernel.Term) -> (@kernel.Term, @kernel.Term) raise = (x122 : @kernel.Term) => @basics.dest_binop(t121, x122)
      let zero_tm = @parser.parse_term("&0")
      fn poly_mul_conv_1(x123 : @list.List[@kernel.Term], x124 : @kernel.Term) -> @kernel.Thm raise {
        let vars = x123
        let tm = x124
        let (pol1, pol2) = dest_mul(tm)
        if (pol1 == zero_tm) {
          cnv_l0(tm)
        } else {
          if (pol2 == zero_tm) {
            cnv_r0(tm)
          } else {
            if (@calc_int.is_ratconst(pol1) && @calc_int.is_ratconst(pol2)) {
              @calc_rat.real_rat_mul_conv(tm)
            } else {
              let x = polyvar(pol1)
              let y = polyvar(pol2)
              if (!@kernel.is_var(y) || earlier(vars, x, y)) {
                @equal.thenc(cnv_r1, @equal.comb_conv(@equal.rand_conv((x125 : @kernel.Term) => poly_mul_conv_1(vars, x125))))(tm)
              } else {
                if (!@kernel.is_var(x) || earlier(vars, y, x)) {
                  @equal.thenc(cnv_l1, @equal.comb_conv(@equal.rand_conv((x126 : @kernel.Term) => poly_mul_conv_1(vars, x126))))(tm)
                } else {
                  let t133 = poly_add_conv(vars)
                  let t132 = @lib.funpow(2, fn(x128 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
                    let s129 = @equal.rand_conv(x128)
                    fn(x130 : @kernel.Term) -> @kernel.Thm raise {
                      s129(x130)
                    }
                  }, (x131 : @kernel.Term) => poly_mul_conv_1(vars, x131))
                  @equal.thenc(@equal.thenc(cnv_2, @equal.comb2_conv(@equal.rand_conv((x127 : @kernel.Term) => poly_mul_conv_1(vars, x127)), t132)), t133)(tm)
                }
              }
            }
          }
        }
      }
      fn(x134 : @list.List[@kernel.Term]) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
        fn(x135 : @kernel.Term) -> @kernel.Thm raise {
          poly_mul_conv_1(x134, x135)
        }
      }
    }
    _ => raise @lib.MatchFailure("tscript.ml:254")
  })
}

