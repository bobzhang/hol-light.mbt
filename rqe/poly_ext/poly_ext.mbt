///|
/// `headconst`
pub fn headconst(x195 : @kernel.Term) -> @num.Num raise {
  let p = x195
  try {
    @calc_int.rat_of_term(p)
  } catch {
    Failure(_) => headconst(@lib.funpow(2, @kernel.rand, p))
    e => raise e
  }
}

///|
/// MONIC_CONV
fn step_23() -> Unit raise {
  let mul_tm = @parser.parse_term("( * ):real->real->real")
  monic_conv_c.set(fn(x196 : @list.List[@kernel.Term]) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    let vars = x196
    fn(x197 : @kernel.Term) -> @kernel.Thm raise {
      let p = x197
      let t198 = headconst(p)
      let c = @num.div_num(@num.num_of_int64(1L), t198)
      let t199 = @kernel.mk_comb(@kernel.mk_comb(mul_tm, @calc_int.term_of_rat(c)), p)
      poly_mul_conv(vars)(t199)
    }
  })
}

