///|
/// POLYNATE_CONV
fn step_14() -> Unit raise {
  let cnv_var : (@kernel.Term) -> @kernel.Thm raise = @simp.rewr_conv(@calc_rat.real_arith(@parser.parse_term("x = &0 + x * &1")))
  let cnv_div : (@kernel.Term) -> @kernel.Thm raise = @simp.rewr_conv(@realax.real_div())
  let neg_tm = @parser.parse_term("(--)")
  let add_tm = @parser.parse_term("(+)")
  let sub_tm = @parser.parse_term("(-)")
  let mul_tm = @parser.parse_term("( * )")
  let pow_tm = @parser.parse_term("(pow)")
  let div_tm = @parser.parse_term("(/)")
  fn polynate_conv_1(x143 : @list.List[@kernel.Term], x144 : @kernel.Term) -> @kernel.Thm raise {
    let vars = x143
    let tm = x144
    if @kernel.is_var(tm) {
      cnv_var(tm)
    } else {
      if @calc_int.is_ratconst(tm) {
        @kernel.refl(tm)
      } else {
        let (lop, r) = @kernel.dest_comb(tm)
        if (lop == neg_tm) {
          @equal.thenc(@equal.rand_conv((x145 : @kernel.Term) => polynate_conv_1(vars, x145)), poly_neg_conv)(tm)
        } else {
          let (op, l) = @kernel.dest_comb(lop)
          if (op == pow_tm) {
            let t147 = poly_pow_conv(vars)
            @equal.thenc(@equal.land_conv((x146 : @kernel.Term) => polynate_conv_1(vars, x146)), t147)(tm)
          } else {
            if (op == div_tm) {
              let t149 = poly_mul_conv(vars)
              @equal.thenc(@equal.thenc(cnv_div, @equal.comb2_conv(@equal.rand_conv((x148 : @kernel.Term) => polynate_conv_1(vars, x148)), @calc_rat.real_rat_reduce_conv)), t149)(tm)
            } else {
              let cnv : (@list.List[@kernel.Term]) -> ((@kernel.Term) -> @kernel.Thm raise) raise = if (op == add_tm) {
                poly_add_conv
              } else {
                if (op == sub_tm) {
                  poly_sub_conv
                } else {
                  if (op == mul_tm) {
                    poly_mul_conv
                  } else {
                    raise Failure("POLYNATE_CONV: unknown operation")
                  }
                }
              }
              let t151 = cnv(vars)
              @equal.thenc(@equal.binop_conv((x150 : @kernel.Term) => polynate_conv_1(vars, x150)), t151)(tm)
            }
          }
        }
      }
    }
  }
  polynate_conv_c.set(fn(x152 : @list.List[@kernel.Term]) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    fn(x153 : @kernel.Term) -> @kernel.Thm raise {
      polynate_conv_1(x152, x153)
    }
  })
}

