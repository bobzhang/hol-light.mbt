///|
/// `degree_`
pub fn degree_(x172 : @list.List[@kernel.Term], x173 : @kernel.Term) -> Int64 raise {
  let vars = x172
  let tm = x173
  let t174 = @lib.hd(vars)
  if (polyvar(tm) == t174) {
    @lib.add63(1L, degree_(vars, @lib.funpow(2, @kernel.rand, tm)))
  } else {
    0L
  }
}

///|
/// `coefficients`
pub fn coefficients(x175 : @list.List[@kernel.Term], x176 : @kernel.Term) -> @list.List[@kernel.Term] raise {
  let vars = x175
  let tm = x176
  let t177 = @lib.hd(vars)
  if (polyvar(tm) == t177) {
    let t178 = coefficients(vars, @lib.funpow(2, @kernel.rand, tm))
    t178.prepend(@equal.lhand(tm))
  } else {
    @list.List([tm])
  }
}

///|
/// `head`
pub fn head(x179 : @list.List[@kernel.Term], x180 : @kernel.Term) -> @kernel.Term raise {
  let vars = x179
  let p = x180
  @lib.last(coefficients(vars, p))
}

///|
/// `behead`
pub fn behead(x181 : @list.List[@kernel.Term], x182 : @kernel.Term) -> @kernel.Term raise {
  let vars = x181
  let tm = x182
  try {
    let (c, r) = @rqe_real.dest_plus(tm)
    let (x, p) = @rqe_real.dest_mult(r)
    if !((x == @lib.hd(vars))) {
      raise Failure("")
    } else {
      let p_p = behead(vars, p)
      if (p_p == @rqe_real.rzero()) {
        c
      } else {
        let t183 = @rqe_real.mk_mult(x)(p_p)
        @rqe_real.mk_plus(c)(t183)
      }
    }
  } catch {
    _ => @rqe_real.rzero()
  }
}

///|
/// BEHEAD
fn step_20() -> Unit raise {
  let lem = @int.arith_rule(@parser.parse_term("a + b * &0 = a"))
  behead_v1_c.set(fn(x184 : @list.List[@kernel.Term]) -> ((@kernel.Thm) -> ((@kernel.Term) -> @kernel.Thm raise) raise) raise {
    let vars = x184
    fn(x185 : @kernel.Thm) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
      let zthm = x185
      fn(x186 : @kernel.Term) -> @kernel.Thm raise {
        let tm = x186
        let tm_p = behead(vars, tm)
        let thm1 = @simp.pure_rewrite_conv(@list.List([zthm]))(tm)
        let t187 = @equal.rhs(@kernel.concl(thm1))
        let thm2 = @simp.pure_rewrite_conv(@list.List([lem]))(t187)
        let thm3 = @kernel.trans(thm1, thm2)
        thm3
      }
    }
  })
}

