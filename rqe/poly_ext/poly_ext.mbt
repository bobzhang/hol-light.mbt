///|
/// BEHEAD3
fn step_21() -> Unit raise {
  let lem = @int.arith_rule(@parser.parse_term("a + b * &0 = a"))
  behead3_c.set(fn(x188 : @list.List[@kernel.Term]) -> ((@kernel.Thm) -> ((@kernel.Term) -> @kernel.Thm raise) raise) raise {
    let vars = x188
    fn(x189 : @kernel.Thm) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
      let zthm = x189
      fn(x190 : @kernel.Term) -> @kernel.Thm raise {
        let tm = x190
        let tm_p = behead(vars, tm)
        let (l, r) = @basics.dest_binop(@rqe_real.rp(), tm)
        let (l1, r1) = @basics.dest_binop(@rqe_real.rm(), r)
        let conv : (@kernel.Term) -> @kernel.Thm raise = if (l1 == @lib.hd(vars)) {
          @equal.rand_conv(@simp.pure_once_rewrite_conv(@list.List([zthm])))
        } else {
          @simp.pure_once_rewrite_conv(@list.List([zthm]))
        }
        let thm1 = conv(tm)
        let t191 = @equal.rhs(@kernel.concl(thm1))
        let thm2 = @simp.pure_rewrite_conv(@list.List([lem]))(t191)
        let thm3 = @kernel.trans(thm1, thm2)
        thm3
      }
    }
  })
}

