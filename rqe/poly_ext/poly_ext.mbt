///|
/// `POLYATOM_CONV`
pub fn polyatom_conv(x230 : @list.List[@kernel.Term], x231 : @kernel.Term) -> @kernel.Thm raise {
  let vars = x230
  let tm = x231
  let thm1 = @simp.once_rewrite_conv(@list.List([@realax.real_gt(), @realax.real_ge(), eq_lem()]))(tm)
  let (l, r) = @kernel.dest_eq(@kernel.concl(thm1))
  let thm2 = @simp.once_rewrite_conv(@list.List([lt_lem(), le_lem()]))(r)
  let (op, l_p, r_p) = @rqe_lib.get_binop(@equal.rhs(@kernel.concl(thm2)))
  let thm3a = polynate_conv(vars)(l_p)
  let thm3b = @equal.ap_term(op, thm3a)
  let thm3 = @equal.ap_thm(thm3b, @rqe_real.rzero())
  @lib.end_itlist(@kernel.trans, @list.List([thm1, thm2, thm3]))
}

///|
/// `weakfactor`
pub fn weakfactor(x232 : @kernel.Term, x233 : @kernel.Term) -> ((Int64, @kernel.Term)) raise {
  let x = x232
  let pol = x233
  fn weakfactor_1(x234 : Int64, x235 : @kernel.Term, x236 : @kernel.Term) -> ((Int64, @kernel.Term)) raise {
    let k = x234
    let x_1 = x235
    let pol_1 = x236
    try {
      let (ls, rs) = @rqe_real.dest_plus(pol_1)
      if !((ls == @rqe_real.rzero())) {
        raise Failure("")
      } else {
        let (lm, rm) = @rqe_real.dest_mult(rs)
        if !((lm == x_1)) {
          raise Failure("")
        } else {
          weakfactor_1(@lib.add63(k, 1L), x_1, rm)
        }
      }
    } catch {
      Failure(_) => (k, pol_1)
      e => raise e
    }
  }
  weakfactor_1(0L, x, pol)
}

///|
/// `poly_var`
pub fn poly_var(x237 : @kernel.Term) -> @kernel.Term raise {
  let x = x237
  let t238 = @rqe_real.mk_mult(x)(@rqe_real.rone())
  @rqe_real.mk_plus(@rqe_real.rzero())(t238)
}

///|
/// POW_PROD_SUM
fn step_30() -> Unit raise {
  let t243 = @tactics.pop_assum(fn(x242 : @kernel.Thm) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise) raise {
    (fn(x239 : @kernel.Thm) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise) raise {
      let s240 = @tactics.subst1_tac(x239)
      fn(x241 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise {
        s240(x241)
      }
    })(@equal.gsym(x242))
  })
  let t244 = @simp.rewrite_tac(@list.List([@realax.real_pow()]))
  let t245 = @simp.rewrite_tac(@list.List([@int.arith_rule(@parser.parse_term("n + SUC m = SUC (n + m)"))]))
  let t246 = @simp.rewrite_tac(@list.List([@realax.real_pow()]))
  let t247 = @simp.rewrite_tac(@list.List([@realax.real_pow()]))
  let t248 = @list.List([@tactics.then_tac(@tactics.then_tac(@tactics.strip_tac, @tactics.strip_tac), @nums.induct_tac), t247, @rewrites.num_simp_tac, @rewrites.real_simp_tac, t246, t245, t244, t243, @calc_rat.real_arith_tac])
  pow_prod_sum_c.set(@rqe_tactics_ext.prove_by_refinement(@parser.parse_term("!x n m. (x pow n) * x pow m = x pow (n + m)"), t248))
}

