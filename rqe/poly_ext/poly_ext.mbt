///|
/// `earlier`
pub fn[TA : Eq + @lib.OCompare + @lib.OHash] earlier(x98 : @list.List[TA], x99 : TA, x100 : TA) -> Bool raise {
  let l = x98
  let x = x99
  let y = x100
  match l {
    More(h, tail=t) => {
      if (h == y) {
        false
      } else {
        if (h == x) {
          true
        } else {
          earlier(t, x, y)
        }
      }
    }
    Empty => false
  }
}

///|
/// POLY_ADD_CONV
fn step_9() -> Unit raise {
  let t103 = @parser.parse_term("(pol1 + (d + y * q) = (pol1 + d) + y * q) /\\\n     ((c + x * p) + pol2 = (c + pol2) + x * p) /\\\n     ((c + x * p) + (d + x * q) = (c + d) + x * (p + q)) /\\\n     (c + x * &0 = c)")
  poly_add_conv_c.set(match (fn(x102 : @kernel.Thm) -> @list.List[(@kernel.Term) -> @kernel.Thm raise] raise {
    ((x101 : @list.List[@kernel.Thm]) => @lib.map(@simp.rewr_conv, x101))(@bool.conjuncts_rule(x102))
  })(@calc_rat.real_arith(t103)) {
    More(cnv_r, tail=More(cnv_l, tail=More(cnv_2, tail=More(cnv_0, tail=Empty)))) => {
      let t104 = @parser.parse_term("(+)")
      let dest_add : (@kernel.Term) -> (@kernel.Term, @kernel.Term) raise = (x105 : @kernel.Term) => @basics.dest_binop(t104, x105)
      fn poly_add_conv_1(x106 : @list.List[@kernel.Term], x107 : @kernel.Term) -> @kernel.Thm raise {
        let vars = x106
        let tm = x107
        let (pol1, pol2) = dest_add(tm)
        let x = polyvar(pol1)
        let y = polyvar(pol2)
        if (!@kernel.is_var(x) && !@kernel.is_var(y)) {
          @calc_rat.real_rat_reduce_conv(tm)
        } else {
          if (!@kernel.is_var(y) || earlier(vars, x, y)) {
            @equal.thenc(cnv_l, @equal.land_conv((x108 : @kernel.Term) => poly_add_conv_1(vars, x108)))(tm)
          } else {
            if (!@kernel.is_var(x) || earlier(vars, y, x)) {
              @equal.thenc(cnv_r, @equal.land_conv((x109 : @kernel.Term) => poly_add_conv_1(vars, x109)))(tm)
            } else {
              let t111 = @equal.try_conv(cnv_0)
              @equal.thenc(@equal.thenc(cnv_2, @equal.comb_conv(@equal.rand_conv((x110 : @kernel.Term) => poly_add_conv_1(vars, x110)))), t111)(tm)
            }
          }
        }
      }
      fn(x112 : @list.List[@kernel.Term]) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
        fn(x113 : @kernel.Term) -> @kernel.Thm raise {
          poly_add_conv_1(x112, x113)
        }
      }
    }
    _ => raise @lib.MatchFailure("tscript.ml:199")
  })
}

