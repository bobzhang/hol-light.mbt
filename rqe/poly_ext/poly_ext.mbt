///|
/// PDIVIDE
fn step_24() -> Unit raise {
  let zero_tm = @parser.parse_term("&0")
  let add0_tm = @parser.parse_term("(+) (&0)")
  let add_tm = @parser.parse_term("(+)")
  let mul_tm = @parser.parse_term("( * )")
  let pow_tm = @parser.parse_term("(pow)")
  let one_tm = @parser.parse_term("&1")
  let mk_varpow : (@list.List[@kernel.Term]) -> ((Int64) -> @kernel.Term raise) raise = fn(x200 : @list.List[@kernel.Term]) -> ((Int64) -> @kernel.Term raise) raise {
    let vars = x200
    fn(x201 : Int64) -> @kernel.Term raise {
      let k = x201
      let mulx_tm = @kernel.mk_comb(mul_tm, @lib.hd(vars))
      @lib.funpow(@lib.int63_to_int(k), fn(x202 : @kernel.Term) -> @kernel.Term raise {
        let t = x202
        @kernel.mk_comb(add0_tm, @kernel.mk_comb(mulx_tm, t))
      }, one_tm)
    }
  }
  fn pdivide_aux(x203 : @list.List[@kernel.Term], x204 : @kernel.Term, x205 : Int64, x206 : @kernel.Term, x207 : @kernel.Term) -> ((Int64, @kernel.Term, @kernel.Term)) raise {
    let vars_1 = x203
    let a = x204
    let n = x205
    let p = x206
    let s = x207
    if (s == zero_tm) {
      (0L, zero_tm, s)
    } else {
      let b = head(vars_1, s)
      let m = degree_(vars_1, s)
      if (m < n) {
        (0L, zero_tm, s)
      } else {
        let t208 = @lib.sub63(m, n)
        let xp = mk_varpow(vars_1)(t208)
        let p_p = poly_mul_(vars_1)(xp)(p)
        if (a == b) {
          let (k_1, q, r) = pdivide_aux(vars_1, a, n, p, poly_sub_(vars_1)(s)(p_p))
          let t209 = poly_pow_(vars_1)(a)(k_1)
          let t210 = poly_mul_(vars_1)(xp)(t209)
          (k_1, poly_add_(vars_1)(q)(t210), r)
        } else {
          let t211 = poly_mul_(vars_1)(b)(p_p)
          let t212 = poly_mul_(vars_1)(a)(s)
          let (k_2, q_1, r_1) = pdivide_aux(vars_1, a, n, p, poly_sub_(vars_1)(t212)(t211))
          let t213 = poly_pow_(vars_1)(a)(k_2)
          let t214 = poly_mul_(vars_1)(t213)(xp)
          let t215 = poly_mul_(vars_1)(b)(t214)
          let q_p = poly_add_(vars_1)(q_1)(t215)
          (@lib.add63(k_2, 1L), q_p, r_1)
        }
      }
    }
  }
  pdivide_c.set(fn(x216 : @list.List[@kernel.Term]) -> ((@kernel.Term) -> ((@kernel.Term) -> @kernel.Thm raise) raise) raise {
    let vars_2 = x216
    fn(x217 : @kernel.Term) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
      let s_1 = x217
      fn(x218 : @kernel.Term) -> @kernel.Thm raise {
        let p_1 = x218
        let a_1 = head(vars_2, p_1)
        let (k_3, q_2, r_2) = pdivide_aux(vars_2, a_1, degree_(vars_2, p_1), p_1, s_1)
        let t219 = @kernel.mk_comb(@kernel.mk_comb(mul_tm, q_2), p_1)
        let th1 = poly_mul_conv(vars_2)(t219)
        let th2 = @equal.ap_thm(@equal.ap_term(add_tm, th1), r_2)
        let th3 = @equal.conv_rule(@equal.rand_conv(poly_add_conv(vars_2)), th2)
        let t220 = @nums.mk_small_numeral(k_3)
        let t221 = @kernel.mk_comb(@kernel.mk_comb(pow_tm, a_1), t220)
        let th4 = poly_pow_conv(vars_2)(t221)
        let th5 = @equal.ap_thm(@equal.ap_term(mul_tm, th4), s_1)
        let th6 = @equal.conv_rule(@equal.rand_conv(poly_mul_conv(vars_2)), th5)
        @kernel.trans(th6, @equal.gsym(th3))
      }
    }
  })
}

///|
let pdivide_c : @lib.Cell[(@list.List[@kernel.Term]) -> ((@kernel.Term) -> ((@kernel.Term) -> @kernel.Thm raise) raise) raise] = @lib.Cell::new("PDIVIDE")

///|
/// `PDIVIDE`
pub fn pdivide(x : @list.List[@kernel.Term]) -> ((@kernel.Term) -> ((@kernel.Term) -> @kernel.Thm raise) raise) raise {
  (pdivide_c.get())(x)
}

///|
/// SIGN_CONST
fn step_25() -> Unit raise {
  let zero = @num.num_of_int64(0L)
  let zero_tm = @parser.parse_term("&0")
  let eq_tm = @parser.parse_term("(=):real->real->bool")
  let gt_tm = @parser.parse_term("(>):real->real->bool")
  let lt_tm = @parser.parse_term("(<):real->real->bool")
  sign_const_c.set(fn(x222 : @kernel.Term) -> @kernel.Thm raise {
    let tm = x222
    let x = @calc_int.rat_of_term(tm)
    if @num.eq_num(x, zero) {
      @bool.eqt_elim(@calc_rat.real_rat_eq_conv(@kernel.mk_comb(@kernel.mk_comb(eq_tm, tm), zero_tm)))
    } else {
      if @num.gt_num(x, zero) {
        @bool.eqt_elim(@calc_rat.real_rat_gt_conv(@kernel.mk_comb(@kernel.mk_comb(gt_tm, tm), zero_tm)))
      } else {
        @bool.eqt_elim(@calc_rat.real_rat_lt_conv(@kernel.mk_comb(@kernel.mk_comb(lt_tm, tm), zero_tm)))
      }
    }
  })
}

