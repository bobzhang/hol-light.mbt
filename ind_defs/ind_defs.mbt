///|
fn[TA : Eq + @lib.OCompare + @lib.OHash, TB : Eq + @lib.OCompare + @lib.OHash] getequs_l(
  x42 : @list.List[TB],
  x43 : @list.List[(TA, TB)],
) -> @list.List[(TA, TB)] raise {
  let (avs_1, plis) = (x42, x43)
  if plis == @list.empty() {
    @list.empty()
  } else {
    match plis {
      More(h, tail=t_1) => {
        let r_1 = h.1
        if @lib.mem(r_1, avs_1) {
          getequs_l(
            avs_1,
            @lib.filter(
              (x46 : (TA, TB)) => {
                ((x44 : TB) => r_1 != x44)(((x45 : (TA, TB)) => x45.1)(x46))
              },
              t_1,
            ),
          ).prepend(h)
        } else {
          getequs_l(avs_1, t_1)
        }
      }
      _ => raise @lib.MatchFailure("tscript.ml:84")
    }
  }
}

