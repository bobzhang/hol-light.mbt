pub fn spec_rule(x691 : @kernel.Term, x692 : @kernel.Thm) -> @kernel.Thm raise {
  let t = x691
  let th = x692
  specl_rule(@list.List([t]), th)
}

///|
/// `gen_rule`
pub fn gen_rule(x693 : Int64, x694 : @kernel.Thm) -> @kernel.Thm raise {
  let t = x693
  let th = x694
  let t695 = @drule.match_mp(gen())(th)
  @bool.spec(@nums.mk_small_numeral(t), t695)
}

///|
/// `gens_tac`
pub fn gens_tac(x696 : @list.List[Int64], x697 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) -> @tactics.Goalstate raise {
  let ns = x696
  let (asl, w) = x697
  let (avs, bod) = @lib.nsplit(@basics.dest_forall, ns, w)
  let t699 = @parser.parse_term("V")
  let nvs = @lib.map(fn(x701 : Int64) -> @kernel.Term raise {
    ((x700 : @kernel.Term) => @lib.curry(fn(x698 : (@kernel.Term, @kernel.Term)) -> @kernel.Term raise {
      @kernel.mk_comb(x698.0, x698.1)
    }, t699, x700))(@nums.mk_small_numeral(x701))
  }, ns)
  let bod_p = @basics.subst(@lib.zip(nvs, avs), bod)
  let t702 = @kernel.assume_rule(bod_p)
  let th = @bool.genl(avs, instantiate_rule(@lib.zip(avs, ns), t702))
  @tactics.match_mp_tac(@bool.disch_all(th))((asl, w))
}

///|
/// `gen_tac`
pub fn gen_tac(x703 : Int64) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> @tactics.Goalstate raise) raise {
  let n = x703
  (x705 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) => gens_tac(@list.List([n]), x705)
}

