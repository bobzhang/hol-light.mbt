///|
/// VARS
fn step_81() -> Unit raise {
  let t305 = @parser.parse_term("(VARS False = {}) /\\\n  (VARS True = {}) /\\\n  (VARS (s === t) = FVT s UNION FVT t) /\\\n  (VARS (s << t) = FVT s UNION FVT t) /\\\n  (VARS (s <<= t) = FVT s UNION FVT t) /\\\n  (VARS (Not p) = VARS p) /\\\n  (VARS (p && q) = VARS p UNION VARS q) /\\\n  (VARS (p || q) = VARS p UNION VARS q) /\\\n  (VARS (p --> q) = VARS p UNION VARS q) /\\\n  (VARS (p <-> q) = VARS p UNION VARS q) /\\\n  (VARS (!! x p) = x INSERT VARS p) /\\\n  (VARS (?? x p) = x INSERT VARS p)")
  vars_c.set(@recursion.new_recursive_definition(@fol.form_recursion())(t305))
}

