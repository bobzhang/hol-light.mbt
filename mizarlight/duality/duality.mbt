  let t88 = @miz2a.hence(@miz2a.contradiction())
  let t89 = @miz2a.from(@miz2a.so(@miz2a.have, "l1 = l2"), @list.List([1L]))
  let t90 = @miz2a.otherwise(@miz2a.have, "?p p'. ~(l1 = l2) /\\ ~(p = p') /\\\n        p ON l1 /\\ p' ON l1 /\\ p ON l2 /\\ p' ON l2")
  let t91 = @list.List([@miz2a.fix(@list.List(["l1:Line", "l2:Line"])), t90, t89, t88])
  let t128 = @miz2a.proof(@miz2a.have("!l1 l2. ~(l1 = l2) ==> ?!p. p ON l1 /\\ p ON l2"), t91)
  let t129 = @miz2a.at(@miz2a.have("!l. ?p p' p''. ~(p = p') /\\ ~(p' = p'') /\\ ~(p = p'') /\\\n                         p ON l /\\ p' ON l /\\ p'' ON l"), 4L)
  let t130 = @miz2a.at(@miz2a.have("?p p' p''. ~(p = p') /\\ ~(p' = p'') /\\ ~(p = p'') /\\\n                     ~(?l. p ON l /\\ p' ON l /\\ p'' ON l)"), 3L)
  let t131 = @miz2a.at(@miz2a.have("!l l'. ?p. p ON l /\\ p ON l'"), 2L)
  let t132 = @miz2a.at(@miz2a.have("!p p'. ~(p = p') ==> ?!l. p ON l /\\ p' ON l"), 1L)
  let t133 = @miz2a.assume("projective(ON)")
  let t134 = @list.List([@miz2a.fix(@list.List(["(ON):Point->Line->bool"])), t133, t132, t131, t130, t129, t128, t127, t126, t125, @miz2a.qed()])
  let t136 = @list.List([@miz2a.proof(@miz2a.have("!(ON):Point->Line->bool. projective(ON) ==> projective (\\l p. p ON l)"), t134), t135, @miz2a.qed()])
  projective_duality_c.set(@miz2a.theorem("!(ON):Point->Line->bool. projective(ON) = projective (\\l p. p ON l)")(t136))
}

///|
let projective_duality_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("PROJECTIVE_DUALITY")

///|
/// `PROJECTIVE_DUALITY`
pub fn projective_duality() -> @kernel.Thm {
  projective_duality_c.get()
}

///|
fn load_steps() -> Unit raise {
  step_1()
  step_2()
  step_3()
  step_4()
  step_5()
  step_6()
  step_7()
  step_8()
}
