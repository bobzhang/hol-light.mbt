}

///|
/// DUAL_4
fn step_26() -> Unit raise {
  let t60 = @miz2a.by(@miz2a.from(@miz2a.hence("~(OP = OQ) /\\ ~(OQ = OR) /\\ ~(OP = OR) /\\\n    O ON OP /\\ O ON OQ /\\ O ON OR"), @list.List([1L, 3L, 5L, 6L, 8L, 9L, 10L])), @list.List([axiom_1_p()]))
  let t61 = @miz2a.by(@miz2a.from(@miz2a.have("~(O ON l)"), @list.List([1L, 3L, 5L, 6L])), @list.List([axiom_1_p()]))
  let t62 = @miz2a.take(@list.List(["OP", "OQ", "OR"]))
  let t63 = @miz2a.at(@miz2a.by(@miz2a.st(@miz2a.consider(@list.List(["OR:Line"])))("O ON OR /\\ R ON OR"), @list.List([dual_2()])), 10L)
  let t64 = @miz2a.at(@miz2a.by(@miz2a.st(@miz2a.consider(@list.List(["OQ:Line"])))("O ON OQ /\\ Q ON OQ"), @list.List([dual_2()])), 9L)
  let t65 = @miz2a.at(@miz2a.from(@miz2a.st(@miz2a.so(@miz2a.consider, @list.List(["R:Point"])))("R ON l /\\ ~(R = P) /\\ ~(R = Q)"), @list.List([7L])), 8L)
  let t66 = @miz2a.have("((r = P) \\/ (r = Q) \\/ ~(r = P) /\\ ~(r = Q)) /\\\n    ((r' = P) \\/ (r' = Q) \\/ ~(r' = P) /\\ ~(r' = Q))")
  let t67 = @miz2a.at(@miz2a.by(@miz2a.st(@miz2a.consider(@list.List(["r:Point", "r':Point", "r'':Point"])))("~(r = r') /\\ ~(r' = r'') /\\ ~(r = r'') /\\\n      r ON l /\\ r' ON l /\\ r'' ON l"), @list.List([axiom_4()])), 7L)
  let t68 = @miz2a.at(@miz2a.by(@miz2a.st(@miz2a.consider(@list.List(["l:Line"])))("P ON l /\\ Q ON l"), @list.List([dual_2()])), 6L)
  let t69 = @miz2a.at(@miz2a.st(@miz2a.so(@miz2a.consider, @list.List(["Q:Point"])))("~(Q ON OP)"), 5L)
  let t70 = @miz2a.from(@miz2a.have("~(q ON OP) \\/ ~(q' ON OP) \\/ ~(q'' ON OP)"), @list.List([4L]))
  let t71 = @miz2a.at(@miz2a.by(@miz2a.st(@miz2a.consider(@list.List(["q:Point", "q':Point", "q'':Point"])))("~(q = q') /\\ ~(q' = q'') /\\ ~(q = q'') /\\\n      ~(?l. q ON l /\\ q' ON l /\\ q'' ON l)"), @list.List([axiom_3()])), 4L)
  let t72 = @miz2a.at(@miz2a.from(@miz2a.st(@miz2a.so(@miz2a.consider, @list.List(["P:Point"])))("~(P = O) /\\ P ON OP"), @list.List([2L])), 3L)
  let t73 = @miz2a.from(@miz2a.have("~(p = O) \\/ ~(p' = O)"), @list.List([2L]))
  let t74 = @miz2a.at(@miz2a.by(@miz2a.st(@miz2a.consider(@list.List(["p:Point", "p':Point", "p'':Point"])))("~(p = p') /\\ ~(p' = p'') /\\ ~(p = p'') /\\\n      p ON OP /\\ p' ON OP /\\ p'' ON OP"), @list.List([axiom_4()])), 2L)
  let t75 = @miz2a.at(@miz2a.by(@miz2a.st(@miz2a.consider(@list.List(["OP:Line"])))("O ON OP"), @list.List([lemma_1()])), 1L)
  let t76 = @list.List([@miz2a.fix(@list.List(["O:Point"])), t75, t74, t73, t72, t71, t70, t69, t68, t67, t66, t65, t64, t63, t62, t61, t60])
  dual_4_c.set(@miz2a.theorem("!O. ?OP OQ OR. ~(OP = OQ) /\\ ~(OQ = OR) /\\ ~(OP = OR) /\\\n    O ON OP /\\ O ON OQ /\\ O ON OR")(t76))
}

