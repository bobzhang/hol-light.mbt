///|
/// DUAL_3
fn step_25() -> Unit raise {
  let t49 = @miz2a.from(@miz2a.hence(@miz2a.contradiction()), @list.List([1L, 3L, 6L]))
  let t50 = @miz2a.from(@miz2a.so(@miz2a.have, "... = p1"), @list.List([2L, 4L, 7L]))
  let t51 = @miz2a.from(@miz2a.have("q = q'"), @list.List([6L, 7L]))
  let t52 = @miz2a.at(@miz2a.by(@miz2a.from(@miz2a.st(@miz2a.consider(@list.List(["q':Point"])))("q' ON l1 /\\ q' ON l3 /\\\n    !p'. p' ON l1 /\\ p' ON l3 ==> (p' = q')"), @list.List([5L])), @list.List([dual_1()])), 7L)
  let t53 = @miz2a.at(@miz2a.st(@miz2a.otherwise(@miz2a.consider, @list.List(["q:Point"])))("q ON l1 /\\ q ON l2 /\\ q ON l3"), 6L)
  let t54 = @miz2a.at(@miz2a.from(@miz2a.thus("~(l1 = l2) /\\ ~(l2 = l3) /\\ ~(l1 = l3)"), @list.List([1L, 2L, 3L, 4L])), 5L)
  let t55 = @miz2a.take(@list.List(["l1", "l2", "l3"]))
  let t56 = @miz2a.at(@miz2a.by(@miz2a.st(@miz2a.consider(@list.List(["l3:Line"])))("p1 ON l3 /\\ p2 ON l3"), @list.List([dual_2()])), 4L)
  let t57 = @miz2a.at(@miz2a.by(@miz2a.st(@miz2a.consider(@list.List(["l2:Line"])))("p2 ON l2 /\\ p3 ON l2"), @list.List([dual_2()])), 3L)
  let t58 = @miz2a.at(@miz2a.by(@miz2a.st(@miz2a.consider(@list.List(["l1:Line"])))("p1 ON l1 /\\ p3 ON l1"), @list.List([dual_2()])), 2L)
  let t59 = @list.List([@miz2a.at(@miz2a.by(@miz2a.st(@miz2a.consider(@list.List(["p1:Point", "p2:Point", "p3:Point"])))("~(p1 = p2) /\\ ~(p2 = p3) /\\ ~(p1 = p3) /\\\n      ~(?l. p1 ON l /\\ p2 ON l /\\ p3 ON l)"), @list.List([axiom_3()])), 1L), t58, t57, t56, t55, t54, t53, t52, t51, t50, t49])
  dual_3_c.set(@miz2a.theorem("?l1 l2 l3. ~(l1 = l2) /\\ ~(l2 = l3) /\\ ~(l1 = l3) /\\\n    ~(?p. p ON l1 /\\ p ON l2 /\\ p ON l3)")(t59))
}

