///|
/// `N_ASSUME_TAC`
pub fn n_assume_tac(x87 : Int64?, x88 : @kernel.Thm, x89 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) -> @tactics.Goalstate raise {
  let l = x87
  let th = x88
  let (asl, _) as g = x89
  match l {
    None => @tactics.assume_tac(th)(g)
    Some(n) => {
      @lib.warn(((n >= 0L) && (Int::to_int64(@lib.length(asl)) != n)), "*** out of sequence label ***")
      @tactics.label_tac(if (n < 0L) {
        "="
      } else {
        Int64::to_string(n)
      }, th)(g)
    }
  }
}

