}

///|
/// P521_GROUP_ELEMENT_ORDER
fn step_24() -> Unit raise {
  let t104 = @meson.meson_tac(@list.List([size_p521_group(), @sets.has_size(), @grouptheory.group_element_order_prime(), prime_n521()]))
  p521_group_element_order_c.set(@tactics.prove(@parser.parse_term("!P. P IN group_carrier p521_group\n       ==> group_element_order p521_group P =\n           if P = group_id p521_group then 1 else n_521"), t104))
}

