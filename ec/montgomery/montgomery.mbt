/// MONTGOMERY_GROUP
fn step_21() -> Unit raise {
  let t224 = @simp.asm_simp_tac(@list.List([montgomery_curve_neg(), @ringtheory.field_imp_integral_domain()]))
  let t225 = @tactics.then_tac(@tactics.match_mp_tac(montgomery_add_sym()), t224)
  let t226 = @list.List([@simp.asm_simp_tac(@list.List([montgomery_add_lneg()])), t225])
  let t223 = @tactics.match_mp_tac(@meson.meson(@list.empty(), @parser.parse_term("x = a /\\ x = y ==> x = a /\\ y = a")))
  let t227 = @tactics.thenl(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@simp.rewrite_tac(@list.List([@sets.in_()])), @tactics.gen_tac), @tactics.strip_tac), t223), @tactics.conj_tac), t226)
  let t228 = @simp.rewrite_tac(@list.List([@ind_types.forall_option_thm(), @pair.forall_pair_thm(), montgomery_add()]))
  let t222 = @simp.asm_simp_tac(@list.List([montgomery_add_assoc()]))
  let t229 = @tactics.then_tac(@simp.rewrite_tac(@list.List([@sets.in_()])), t222)
  let t221 = @simp.asm_simp_tac(@list.List([montgomery_curve_add()]))
  let t230 = @tactics.then_tac(@simp.rewrite_tac(@list.List([@sets.in_()])), t221)
  let t220 = @simp.asm_simp_tac(@list.List([montgomery_curve_neg(), @ringtheory.field_imp_integral_domain()]))
  let t231 = @tactics.then_tac(@simp.rewrite_tac(@list.List([@sets.in_()])), t220)
  let t232 = @list.List([@simp.rewrite_tac(@list.List([@sets.in_(), montgomery_curve()])), t231, t230, t229, t228, t227])
  let t219 = @tactics.repeat_tac(@tactics.conj_tac)
  let t218 = @simp.rewrite_tac(@list.List([montgomery_group(), @equal.gsym(@bool.conjunct2(@grouptheory.group_tybij()))]))
  let t217 = @simp.rewrite_tac(@list.List([@grouptheory.group_carrier(), @grouptheory.group_id(), @grouptheory.group_inv(), @grouptheory.group_mul(), @equal.gsym(@pair.pair_eq())]))
  let t233 = @tactics.thenl(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), @tactics.strip_tac), t217), t218), t219), t232)
