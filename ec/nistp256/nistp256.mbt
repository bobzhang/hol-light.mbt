///|
/// `SIZE_P256_GROUP`
pub fn size_p256_group() -> @kernel.Thm {
  size_p256_group_c.get()
}

///|
/// P256_GROUP_ORDER
fn step_23() -> Unit raise {
  let t103 = @simp.rewrite_tac(@list.List([@simp.rewrite_rule(@list.List([@sets.has_size()]))(size_p256_group())]))
  p256_group_order_c.set(@tactics.prove(@parser.parse_term("CARD(group_carrier p256_group) = n_256"), t103))
}

///|
