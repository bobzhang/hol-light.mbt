import {
  "bobzhang/hol_light/kernel",
  "bobzhang/hol_light/lib",
  "bobzhang/hol_light/parser",
  "bobzhang/hol_light/printer",
  "bobzhang/hol_light/library/words",
} for "test"

// a statement mixes #| lines (for the backslash of /\) with $| lines (for
// \{MID}), which syntax_lint flags; the lint has no narrower name
// (compiler/ideas#2616)

warnings = "-syntax_lint"
