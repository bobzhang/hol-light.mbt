  )
  let t227 = @int.arith_rule(@parser.parse_term("SUC n <= m ==> n <= m"))
  let t228 = @simp.asm_simp_tac(
    @list.List([
      @sets.finite_product(),
      @int.arith_rule(@parser.parse_term("1 <= SUC n")),
