  let t233 = @tactics.exists_tac(@parser.parse_term("(v:A^N)$(SUC n)"))
  let t232 = @simp.rewrite_tac(@list.List([@sets.in_elim_thm()]))
  let t231 = @tactics.x_gen_tac(@parser.parse_term("v:A^N"))
  let t230 = @simp.rewrite_tac(
