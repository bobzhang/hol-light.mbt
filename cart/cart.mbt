  let t222 = @tactics.subgoal_then(
    @parser.parse_term(
      "{v | !i. 1 <= i /\\ i <= dimindex (:N) ==> v$i = (@x. F)} =\n      {(lambda i. @x. F):A^N}",
    ),
    fn(
      x220 : @kernel.Thm,
    ) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> (
