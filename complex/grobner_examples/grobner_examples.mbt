  sdet_lincomb_c.set(@tactics.prove(@parser.parse_term("(FST p * sdet3(i,j,k) =\n    FST i * sdet3(j,k,p) + FST j * sdet3(k,i,p) + FST k * sdet3(i,j,p)) /\\\n   (SND p * sdet3(i,j,k) =\n    SND i * sdet3(j,k,p) + SND j * sdet3(k,i,p) + SND k * sdet3(i,j,p))"), t21))
}

