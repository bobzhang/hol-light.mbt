  sdet_cramer_c.set(@tactics.prove(@parser.parse_term("sdet3(s,t,q) * sdet3(t,p,r) = sdet3(t,q,r) * sdet3(s,t,p) +\n                                 sdet3(t,p,q) * sdet3(s,t,r)"), t15))
}

