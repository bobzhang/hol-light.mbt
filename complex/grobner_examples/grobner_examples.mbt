  let t18 = @tactics.then_tac(@simp.rewrite_tac(@list.List([@pair.forall_pair_thm(), @pair.pair_eq(), sdet3(), det3()])), t17)
  sdet_nz_c.set(@tactics.prove(@parser.parse_term("!p q r. ~(sdet3(p,q,r) = Cx(&0))\n           ==> ~(p = q) /\\ ~(q = r) /\\ ~(r = p)"), t18))
