///|
/// POLY_NORMALIZE_CONV
fn step_88() -> Unit raise {
  let t1010 = @simp.rewrite_tac(@list.List([normalize()]))
  let pth = @tactics.prove(@parser.parse_term("normalize (CONS h t) =\n      (\\n. if n = [] then if h = Cx(&0) then [] else [h] else CONS h n)\n      (normalize t)"), t1010)
  let norm_conv0 : (@kernel.Term) -> @kernel.Thm raise = @simp.gen_rewrite_conv(fn(x1011 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    x1011
  }, @list.List([@bool.conjunct1(normalize())]))
  let norm_conv1 : (@kernel.Term) -> @kernel.Thm raise = @simp.gen_rewrite_conv(fn(x1012 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    x1012
  }, @list.List([pth]))
  let norm_conv2 : (@kernel.Term) -> @kernel.Thm raise = @simp.gen_rewrite_conv(fn(x1013 : (@kernel.Term) -> @kernel.Thm raise) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    let s1014 = @equal.depth_conv(x1013)
    fn(x1015 : @kernel.Term) -> @kernel.Thm raise {
      s1014(x1015)
    }
  }, @list.List([@class.cond_clauses(), @lists.not_cons_nil(), @bool.eqt_intro(@bool.spec_all(@theorems.eq_refl()))]))
  fn poly_normalize_conv_1(x1016 : @kernel.Term) -> @kernel.Thm raise {
    let tm = x1016
    let t1017 = @equal.rator_conv(@equal.rand_conv(@equal.rator_conv(@equal.land_conv(complex_rat_eq_conv))))
    @equal.orelsec(norm_conv0, @equal.thenc(@equal.thenc(@equal.thenc(@equal.thenc(norm_conv1, @equal.rand_conv(poly_normalize_conv_1)), @equal.beta_conv), t1017), norm_conv2))(tm)
  }
  poly_normalize_conv_c.set(poly_normalize_conv_1)
}

