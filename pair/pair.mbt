  let t205 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.gen_tac,
      @tactics.match_mp_tac(
        @class.taut(@parser.parse_term("(~p <=> ~q) ==> (p <=> q)")),
      ),
    ),
    t204,
  )
  exists_paired_thm_c.set(
    @tactics.prove(
      @parser.parse_term("!P:A->B->bool. (?(x,y). P x y) <=> (?x y. P x y)"),
      t205,
    ),
  )
}

