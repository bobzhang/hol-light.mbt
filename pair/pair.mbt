  }
  let gen_beta_conv_1 : (@kernel.Term) -> @kernel.Thm raise = fn(
    x138 : @kernel.Term,
  ) -> @kernel.Thm raise {
    let tm_1 = x138
    @equal.beta_conv(tm_1) catch {
      Failure(_) => {
