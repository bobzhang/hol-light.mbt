// Load-fidelity and behaviour test for pair.ml: replays
// tools/ocaml_ref/pair_ref.ml (keep in sync; the theorem list part is
// generated by tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "pair matches pair.ml" {
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("pair")
  // BEGIN generated theorem list
  log.attempt("LET_DEF", () => sthm(@pair.let_def()))
  log.attempt("LET_END_DEF", () => sthm(@pair.let_end_def()))
  log.attempt("GABS_DEF", () => sthm(@pair.gabs_def()))
  log.attempt("GEQ_DEF", () => sthm(@pair.geq_def()))
  log.attempt("_SEQPATTERN", () => sthm(@pair._seqpattern()))
  log.attempt("_UNGUARDED_PATTERN", () => sthm(@pair._unguarded_pattern()))
  log.attempt("_GUARDED_PATTERN", () => sthm(@pair._guarded_pattern()))
  log.attempt("_MATCH", () => sthm(@pair._match()))
  log.attempt("_FUNCTION", () => sthm(@pair._function()))
  log.attempt("mk_pair_def", () => sthm(@pair.mk_pair_def()))
  log.attempt("PAIR_EXISTS_THM", () => sthm(@pair.pair_exists_thm()))
  log.attempt("prod_tybij", () => sthm(@pair.prod_tybij()))
  log.attempt("REP_ABS_PAIR", () => sthm(@pair.rep_abs_pair()))
  log.attempt("COMMA_DEF", () => sthm(@pair.comma_def()))
  log.attempt("FST_DEF", () => sthm(@pair.fst_def()))
  log.attempt("SND_DEF", () => sthm(@pair.snd_def()))
  log.attempt("PAIR_EQ", () => sthm(@pair.pair_eq()))
  log.attempt("PAIR_SURJECTIVE", () => sthm(@pair.pair_surjective()))
  log.attempt("FST", () => sthm(@pair.fst()))
  log.attempt("SND", () => sthm(@pair.snd()))
  log.attempt("PAIR", () => sthm(@pair.pair()))
  log.attempt("pair_INDUCT", () => sthm(@pair.pair_induct()))
  log.attempt("pair_RECURSION", () => sthm(@pair.pair_recursion()))
  log.attempt("CURRY_DEF", () => sthm(@pair.curry_def()))
  log.attempt("UNCURRY_DEF", () => sthm(@pair.uncurry_def()))
  log.attempt("PASSOC_DEF", () => sthm(@pair.passoc_def()))
  log.attempt("FORALL_PAIR_THM", () => sthm(@pair.forall_pair_thm()))
  log.attempt("EXISTS_PAIR_THM", () => sthm(@pair.exists_pair_thm()))
  log.attempt("LAMBDA_PAIR_THM", () => sthm(@pair.lambda_pair_thm()))
  log.attempt("LAMBDA_PAIR", () => sthm(@pair.lambda_pair()))
  log.attempt("LAMBDA_TRIPLE_THM", () => sthm(@pair.lambda_triple_thm()))
  log.attempt("LAMBDA_TRIPLE", () => sthm(@pair.lambda_triple()))
  log.attempt("PAIRED_ETA_THM", () => sthm(@pair.paired_eta_thm()))
  log.attempt("FORALL_UNCURRY", () => sthm(@pair.forall_uncurry()))
  log.attempt("EXISTS_UNCURRY", () => sthm(@pair.exists_uncurry()))
  log.attempt("EXISTS_CURRY", () => sthm(@pair.exists_curry()))
  log.attempt("FORALL_CURRY", () => sthm(@pair.forall_curry()))
  log.attempt("FORALL_UNPAIR_THM", () => sthm(@pair.forall_unpair_thm()))
  log.attempt("EXISTS_UNPAIR_THM", () => sthm(@pair.exists_unpair_thm()))
  log.attempt("FORALL_PAIR_FUN_THM", () => sthm(@pair.forall_pair_fun_thm()))
  log.attempt("EXISTS_PAIR_FUN_THM", () => sthm(@pair.exists_pair_fun_thm()))
  log.attempt("FORALL_UNPAIR_FUN_THM", () => sthm(@pair.forall_unpair_fun_thm()))
  log.attempt("EXISTS_UNPAIR_FUN_THM", () => sthm(@pair.exists_unpair_fun_thm()))
  log.attempt("EXISTS_SWAP_FUN_THM", () => sthm(@pair.exists_swap_fun_thm()))
  log.attempt("FORALL_PAIRED_THM", () => sthm(@pair.forall_paired_thm()))
  log.attempt("EXISTS_PAIRED_THM", () => sthm(@pair.exists_paired_thm()))
  log.attempt("FORALL_TRIPLED_THM", () => sthm(@pair.forall_tripled_thm()))
  log.attempt("EXISTS_TRIPLED_THM", () => sthm(@pair.exists_tripled_thm()))
  log.attempt("CHOICE_UNPAIR_THM", () => sthm(@pair.choice_unpair_thm()))
  log.attempt("CHOICE_PAIRED_THM", () => sthm(@pair.choice_paired_thm()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  log.attempt("print_gabs", () => {
    @printer.string_of_term(tm("\\(x:A,y:B). (y,x)"))
  })
  log.attempt("print_let", () => {
    @printer.string_of_term(tm("let (x:A,y:B) = p in (y,x)"))
  })
  log.attempt("gen_beta", () => {
    sthm(@pair.gen_beta_conv(tm("(\\(x:A,y:B). (y,x)) (a,b)")))
  })
  log.attempt("let_conv", () => {
    sthm(@pair.let_conv(tm("let (x:A,y:B) = (a,b) in (y,x)")))
  })
  log.attempt("pair_def", () => {
    sthm(@pair.new_definition(tm("swapit (x:A,y:B) = (y,x)")))
  })
  log.attempt("pair_tac", () => {
    sthm(
      @tactics.prove(
        tm("!p:A#B. FST p,SND p = p"),
        @tactics.then_tac(
          @tactics.gen_tac,
          @simp.rewrite_tac(@list.singleton(@pair.pair())),
        ),
      ),
    )
  })
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(
    log.contents(),
    content=(
      #|Searching with limit 0
      #|Searching with limit 1
      #|Searching with limit 2
