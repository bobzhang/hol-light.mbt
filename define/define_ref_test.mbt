      #|  \226\136\128(<<) clauses.\n        WF((<<):A->A->bool) /\\\n        ALL (\\(s,t). ?P G H.\n                     (\226\136\128 f a y. P f a /\\ y << G f a ==> y << s a) /\\\n                     (\226\136\128 f g a. (\226\136\128 z. z << s(a) ==> (f z = g z))\n                              ==> (P f a = P g a) /\\\n                                  (G f a = G g a) /\\ (H f a = H g a)) /\\\n                     (\226\136\128 f a:P. t f a = if P f a then f(G f a) else H f a))\n            clauses\n        ==> ?f:A->B. \226\136\128 x. f x = CASEWISE clauses f x
      #|  \226\136\128(<<) clauses.\n        WF((<<):A->A->bool) /\\\n        ALL (\\(s,t). tailadmissible(<<) (\\f a. T) s t) clauses\n        ==> ?f:A->B. \226\136\128 x. f x = CASEWISE clauses f x
      #|  \226\136\128 clauses.\n   (?(<<). WF(<<) /\\\n           ALL (\\(s:P->A,t). tailadmissible(<<) (\\f a. T) s t) clauses) /\\\n   (\226\136\128 s t s' t' f x y. MEM (s,t) clauses /\\ MEM (s',t') clauses\n                      ==> (s x = s' y) ==> (t f x = t' f y))\n   ==> ?f:A->B. ALL (\\(s,t). \226\136\128 x. f (s x) = t f x) clauses
      #|  \226\136\128 P. (\226\136\128 x y. P x y ==> P y x)\n         ==> \226\136\128 l. (\226\136\128 x y. MEM x l /\\ MEM y l ==> P x y) <=>\n                 ALL (\\x. P x x) l /\\ PAIRWISE P l
      #|  (\\x. P x) = (\\(a,b). P (a,b))
