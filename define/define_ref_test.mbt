      #|  \226\136\128(<<) p P s h k:(A->B)->P->B.\n        admissible(<<) p s P /\\\n        superadmissible(<<) (\\f x. p f x /\\ P f x) s h /\\\n        superadmissible(<<) (\\f x. p f x /\\ ~P f x) s k\n        ==> superadmissible(<<) p s (\\f x. if P f x then h f x else k f x)
      #|  \\f:A->B a:P. if p f a then if P f a then H2 f a else H1 f a else w:B
      #|  \\f:A->B a:P. if p f a then if P f a then G2 f a else G1 f a else z:A
      #|  \\f:A->B a:P. if p f a then if P f a then P2 f a else P1 f a else F
      #|  \226\136\128(<<) p s c1 c2 e.\n        admissible(<<) p s (\\f x. ?y. c1 f x (e f x) y) /\\\n        superadmissible(<<) (\\f x. p f x /\\ ?y. c1 f x (e f x) y) s\n                            (\\f x. _MATCH (e f x) (c1 f x)) /\\\n        superadmissible(<<) (\\f x. p f x /\\ ~(?y. c1 f x (e f x) y)) s\n                            (\\f x. _MATCH (e f x) (c2 f x))\n        ==> superadmissible(<<) p s\n              (\\f x:P. _MATCH (e f x) (_SEQPATTERN (c1 f x) (c2 f x)))
      #|  \\(f:A->B) x:P. (@z:B. F)
      #|  \\f:A->B x:P. arg x (@t. (pat:Q->D) t = e x):A
      #|  \\(f:A->B) x:P. p f x /\\ ?t:Q. pat t:D = e x
      #|  \226\136\128 f:A->B x:P.\n     p f x ==> ((?!v. ?t:Q. pat t:D = e x /\\ f(arg x t) = v) <=>\n                ?t. pat t = e x)
      #|  \226\136\128(<<) p s e:P->D pat:Q->D arg.\n      (\226\136\128 f a t u. p f a /\\ pat t = e a /\\ pat u = e a ==> arg a t = arg a u) /\\\n      (\226\136\128 f a t. p f a /\\ pat t = e a ==> \226\136\128 y. y << arg a t ==> y << s a)\n      ==> superadmissible(<<) p s\n           (\\f:A->B x. _MATCH (e x)\n                    (\\u v. ?t. _UNGUARDED_PATTERN (GEQ (pat t) u)\n                                                  (GEQ (f(arg x t)) v)))
      #|  \\(f:A->B) x:P. (@z:B. F)
      #|  \\f:A->B x:P. arg x (@t. (pat:Q->D) t = e x /\\ q x t):A
      #|  \\(f:A->B) x:P. p f x /\\ ?t:Q. pat t:D = e x /\\ q x t
      #|  \226\136\128 f:A->B x:P.\n     p f x ==> ((?!v. ?t:Q. pat t:D = e x /\\ q x t /\\ f(arg x t) = v) <=>\n                ?t. pat t = e x /\\ q x t)
      #|  \226\136\128(<<) p s e:P->D pat:Q->D q arg.\n      (\226\136\128 f a t u. p f a /\\ pat t = e a /\\ q a t /\\ pat u = e a /\\ q a u\n                 ==> arg a t = arg a u) /\\\n      (\226\136\128 f a t. p f a /\\ q a t /\\ pat t = e a ==> \226\136\128 y. y << arg a t ==> y << s a)\n      ==> superadmissible(<<) p s\n           (\\f:A->B x. _MATCH (e x)\n                    (\\u v. ?t. _GUARDED_PATTERN (GEQ (pat t) u)\n                                                (q x t)\n                                                (GEQ (f(arg x t)) v)))
      #|  \226\136\128 P G H H'.\n         WF (<<) /\\\n         (\226\136\128 f g x. (\226\136\128 z. z << x ==> (f z = g z))\n                  ==> (P f x <=> P g x) /\\\n                      (G f x = G g x) /\\ (H' f x = H' g x)) /\\\n         (\226\136\128 f x y. P f x /\\ y << G f x ==> y << x) /\\\n         (\226\136\128 f x. H f x = if P f x then f(G f x) else H' f x)\n         ==> ?f. \226\136\128 x. f x = H f x
      #|  \\f:A->B x:A. if ?y:P. s y = x\n                           then H2 f (@y. s y = x) else H1 f x:B
