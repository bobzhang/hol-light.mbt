// Load-fidelity test for define.ml: replays tools/ocaml_ref/define_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "define matches define.ml" {
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("define")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("CASEWISE_DEF", () => sthm(@define.casewise_def()))
  log.attempt("CASEWISE", () => sthm(@define.casewise()))
  log.attempt("CASEWISE_CASES", () => sthm(@define.casewise_cases()))
  log.attempt("CASEWISE_WORKS", () => sthm(@define.casewise_works()))
  log.attempt("admissible", () => sthm(@define.admissible()))
  log.attempt("tailadmissible", () => sthm(@define.tailadmissible()))
  log.attempt("superadmissible", () => sthm(@define.superadmissible()))
  log.attempt("MATCH_SEQPATTERN", () => sthm(@define.match_seqpattern()))
  log.attempt("ADMISSIBLE_CONST", () => sthm(@define.admissible_const()))
  log.attempt("ADMISSIBLE_BASE", () => sthm(@define.admissible_base()))
  log.attempt("ADMISSIBLE_COMB", () => sthm(@define.admissible_comb()))
  log.attempt("ADMISSIBLE_RAND", () => sthm(@define.admissible_rand()))
  log.attempt("ADMISSIBLE_LAMBDA", () => sthm(@define.admissible_lambda()))
  log.attempt("ADMISSIBLE_NEST", () => sthm(@define.admissible_nest()))
  log.attempt("ADMISSIBLE_COND", () => sthm(@define.admissible_cond()))
  log.attempt("ADMISSIBLE_MATCH", () => sthm(@define.admissible_match()))
  log.attempt("ADMISSIBLE_SEQPATTERN", () => {
    sthm(@define.admissible_seqpattern())
  })
  log.attempt("ADMISSIBLE_UNGUARDED_PATTERN", () => {
    sthm(@define.admissible_unguarded_pattern())
  })
  log.attempt("ADMISSIBLE_GUARDED_PATTERN", () => {
    sthm(@define.admissible_guarded_pattern())
  })
  log.attempt("ADMISSIBLE_NSUM", () => sthm(@define.admissible_nsum()))
  log.attempt("ADMISSIBLE_SUM", () => sthm(@define.admissible_sum()))
  log.attempt("ADMISSIBLE_MAP", () => sthm(@define.admissible_map()))
  log.attempt("ADMISSIBLE_MATCH_SEQPATTERN", () => {
    sthm(@define.admissible_match_seqpattern())
  })
  log.attempt("ADMISSIBLE_IMP_SUPERADMISSIBLE", () => {
    sthm(@define.admissible_imp_superadmissible())
  })
  log.attempt("SUPERADMISSIBLE_CONST", () => {
    sthm(@define.superadmissible_const())
  })
  log.attempt("SUPERADMISSIBLE_TAIL", () => sthm(@define.superadmissible_tail()))
  log.attempt("SUPERADMISSIBLE_COND", () => sthm(@define.superadmissible_cond()))
  log.attempt("SUPERADMISSIBLE_MATCH_SEQPATTERN", () => {
    sthm(@define.superadmissible_match_seqpattern())
  })
  log.attempt("SUPERADMISSIBLE_MATCH_UNGUARDED_PATTERN", () => {
    sthm(@define.superadmissible_match_unguarded_pattern())
  })
  log.attempt("SUPERADMISSIBLE_MATCH_GUARDED_PATTERN", () => {
    sthm(@define.superadmissible_match_guarded_pattern())
  })
  log.attempt("WF_REC_TAIL_GENERAL'", () => {
    sthm(@define.wf_rec_tail_general_p())
  })
  log.attempt("WF_REC_CASES", () => sthm(@define.wf_rec_cases()))
  log.attempt("WF_REC_CASES'", () => sthm(@define.wf_rec_cases_p()))
  log.attempt("RECURSION_CASEWISE", () => sthm(@define.recursion_casewise()))
  log.attempt("RECURSION_CASEWISE_PAIRWISE", () => {
    sthm(@define.recursion_casewise_pairwise())
  })
  log.attempt("SUPERADMISSIBLE_T", () => sthm(@define.superadmissible_t()))
  log.attempt("RECURSION_SUPERADMISSIBLE", () => {
    sthm(@define.recursion_superadmissible())
  })
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  log.attempt("define_fib", () => {
    sthm(
      @define.define_(tm("fib n = if n < 2 then 1 else fib(n - 1) + fib(n - 2)")),
    )
  })
  log.attempt("define_gcd", () => {
    sthm(@define.define_(tm("gcdx m n = if n = 0 then m else gcdx n (m MOD n)")))
  })
  log.attempt("define_pat", () => {
    sthm(
      @define.define_(
        tm("(sumlist [] = 0) /\\ (sumlist (CONS h t) = h + sumlist t)"),
      ),
    )
  })
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  @testkit.check_axioms()
  inspect(
    @testkit.normalize_times(log.contents()),
    content=(
      #|Searching with limit 0
      #|Searching with limit 1
      #|Searching with limit 2
      #|Searching with limit 3
