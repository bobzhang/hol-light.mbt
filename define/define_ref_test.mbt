      #|  (1 = m + n) <=> (m = 1) /\\ (n = 0) \\/ (m = 0) /\\ (n = 1)
      #|  (m + n = 1) <=> (m = 1) /\\ (n = 0) \\/ (m = 0) /\\ (n = 1)
