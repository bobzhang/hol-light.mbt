///|
/// Expected values from OCaml 4.14's `string_of_float`.
test "string_of_float matches OCaml" {
  let xs : Array[Double] = [
    0.0,
    -0.0,
    1.0,
    -1.0,
    2.0,
    0.5,
    1.0 / 3.0,
    2.0 / 3.0,
    100.0,
    1.0e12,
    1.0e11,
    999999999999.5,
    999999999999.4,
    1.0e-4,
    1.5e-5,
    1.0e-5,
    123456789012345.0,
    0.1,
    0.3,
    1.0e300,
    1.0e-300,
    5.0e-324,
    1.7976931348623157e308,
    1.0 / 0.0,
    -1.0 / 0.0,
    3.14159265358979,
    1234.5,
    0.000123456789012345,
    12345678.9,
    2.5e-7,
    4.9406564584124654e-324,
    0.30000000000000004,
    1.0e21,
    123456789012.25,
    0.125,
    1.0e15,
    33.0,
    1.0e100,
  ]
  inspect(
    xs.map(@lib.string_of_float).join("|"),
    content="0.|-0.|1.|-1.|2.|0.5|0.333333333333|0.666666666667|100.|1e+12|100000000000.|1e+12|999999999999.|0.0001|1.5e-05|1e-05|1.23456789012e+14|0.1|0.3|1e+300|1e-300|4.94065645841e-324|1.79769313486e+308|inf|-inf|3.14159265359|1234.5|0.000123456789012|12345678.9|2.5e-07|4.94065645841e-324|0.3|1e+21|123456789012.|0.125|1e+15|33.|1e+100",
  )
}

///|
/// Expected values from OCaml 4.14's `int_of_string` (failures as "!").
test "int_of_string matches OCaml" {
  let cases = [
    "0", "12", "-12", "+7", "1_000", "_1", "0x1f", "0X1F", "0o17", "0b101", "0u42",
    "-0x7fffffffffffffff", "-0u9223372036854775807", "2147483647", "2147483648",
    "-2147483648", "0x", "12a", "", "-", "0xffffffff", "4611686018427387904",
  ]
  inspect(
    cases
    .map(c => {
      let r = @lib.int_of_string(c).to_string() catch { _ => "!" }
      c + "=" + r
    })
    .join(" "),
    content="0=0 12=12 -12=-12 +7=7 1_000=1000 _1=! 0x1f=31 0X1F=31 0o17=15 0b101=5 0u42=42 -0x7fffffffffffffff=1 -0u9223372036854775807=1 2147483647=2147483647 2147483648=! -2147483648=-2147483648 0x=! 12a=! =! -=! 0xffffffff=! 4611686018427387904=!",
  )
}

///|
test "float_ldexp gives the bits of OCaml 4.14's ldexp" {
  let cases : Array[(Double, Int64)] = [
    (0.5, 1L),
    (0.75, 25L),
    (0.6180339887, 53L),
    (-0.5, -3L),
    (1.0, 1023L),
    (1.0, 1024L),
    (1.0, -1022L),
    (1.0, -1074L),
    (1.0, -1075L),
    (0.0, 5000L),
    (3.0, 2000L),
    (3.0, -3000L),
    (0.3, -1070L),
    (1.7976931348623157e308, -2098L),
  ]
  inspect(
    cases
    .map(c => @lib.float_ldexp(c.0, c.1).reinterpret_as_int64().to_string())
    .join(" "),
    // Int64.bits_of_float (ldexp x n) in OCaml 4.14.1, in the same order
    content="4607182418800017408 4717520609670594560 4842432755078335947 -4634204016564240384 9214364837600034816 9218868437227405312 4503599627370496 1 0 0 9218868437227405312 0 5 1",
  )
}
