///|
/// Expected values from OCaml 4.14's `string_of_float`.
test "string_of_float matches OCaml" {
  let xs : Array[Double] = [
    0.0,
    -0.0,
    1.0,
    -1.0,
    2.0,
    0.5,
    1.0 / 3.0,
    2.0 / 3.0,
    100.0,
    1.0e12,
    1.0e11,
    999999999999.5,
    999999999999.4,
    1.0e-4,
    1.5e-5,
    1.0e-5,
    123456789012345.0,
    0.1,
    0.3,
    1.0e300,
    1.0e-300,
    5.0e-324,
    1.7976931348623157e308,
    1.0 / 0.0,
    -1.0 / 0.0,
    3.14159265358979,
    1234.5,
    0.000123456789012345,
    12345678.9,
    2.5e-7,
    4.9406564584124654e-324,
    0.30000000000000004,
    1.0e21,
    123456789012.25,
    0.125,
    1.0e15,
    33.0,
    1.0e100,
  ]
  inspect(
    xs.map(@lib.string_of_float).join("|"),
    content="0.|-0.|1.|-1.|2.|0.5|0.333333333333|0.666666666667|100.|1e+12|100000000000.|1e+12|999999999999.|0.0001|1.5e-05|1e-05|1.23456789012e+14|0.1|0.3|1e+300|1e-300|4.94065645841e-324|1.79769313486e+308|inf|-inf|3.14159265359|1234.5|0.000123456789012|12345678.9|2.5e-07|4.94065645841e-324|0.3|1e+21|123456789012.|0.125|1e+15|33.|1e+100",
  )
}
