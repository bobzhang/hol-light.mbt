///|
/// 63-bit int arithmetic against OCaml 4.14 (tools: values printed by
/// `ocaml` for the same operands).
test "int63 matches OCaml" {
  let vals : Array[Int64] = [
    0L,
    1L,
    -1L,
    2147483647L,
    2147483648L,
    -2147483649L,
    max_int63,
    min_int63,
    max_int63 - 5L,
    min_int63 + 7L,
    0x2AAAAAAAAAAAAAAAL,
    123456789012345L,
  ]
  let out = StringBuilder::new()
  for a in vals {
    for b in vals {
      out.write_string("\{a} \{b} \{add63(a, b)} \{sub63(a, b)} \{mul63(a, b)}")
      if b != 0L {
        out.write_string(" \{div63(a, b)} \{mod63(a, b)}")
      } else {
        out.write_string(" Z Z")
      }
      out.write_string("\n")
    }
  }
  for a in vals {
    for k in [0L, 1L, 2L, 31L, 32L, 33L, 61L, 62L, 63L] {
      out.write_string(
        "S \{a} \{k} \{lsl63(a, k)} \{lsr63(a, k)} \{asr63(a, k)}\n",
      )
    }
  }
  for a in vals {
    out.write_string(
      "U \{a} \{neg63(a)} \{abs63(a)} \{lnot63(a)} \{succ63(a)}\n",
    )
  }
  let expected =
