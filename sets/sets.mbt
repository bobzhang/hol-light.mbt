  has_size_diff_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!(s:A->bool) t m n.\n        s HAS_SIZE m /\\ t HAS_SIZE n /\\ t SUBSET s\n        ==> (s DIFF t) HAS_SIZE (m - n)",
      ),
      t1271,
    ),
  )
}

