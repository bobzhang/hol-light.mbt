}

///|
/// FINITE_RECURSION
fn step_315() -> Unit raise {
  let t1051 = @simp.asm_rewrite_tac(@list.empty())
  let t1050 = @tactics.match_mp_tac(set_recursion_lemma())
  let t1049 = @tactics.conv_tac(@class.select_conv)
  let t1048 = @simp.rewrite_tac(@list.List([itset()]))
  let t1052 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.repeat_tac(@tactics.gen_tac),
            @tactics.disch_tac,
          ),
          t1048,
        ),
        t1049,
      ),
      t1050,
    ),
    t1051,
  )
  finite_recursion_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!(f:A->B->B) b.\n        (!x y s. ~(x = y) ==> (f x (f y s) = f y (f x s)))\n        ==> (ITSET f {} b = b) /\\\n            !x s. FINITE s\n                  ==> (ITSET f (x INSERT s) b =\n                       if x IN s then ITSET f s b\n                                 else f x (ITSET f s b))",
      ),
      t1052,
    ),
  )
}

