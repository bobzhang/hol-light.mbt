  finite_card_le_subset_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!s (t:A->bool) n.\n        s SUBSET t /\\ FINITE t /\\ CARD t <= n\n        ==> FINITE s /\\ CARD s <= n",
      ),
      t1401,
    ),
  )
}

