///|
/// IMAGE_INJECTIVE_IMAGE_OF_SUBSET
fn step_258() -> Unit raise {
  let t472 = @tactics.asm_tac(set_tac)(@list.empty())
  let t473 = @tactics.then_tac(
    @tactics.exists_tac(@parser.parse_term("IMAGE (g:B->A) (IMAGE (f:A->B) s)")),
    t472,
