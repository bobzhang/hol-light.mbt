  let t474 = @list.List([
    @tactics.then_tac(
      @simp.rewrite_tac(
        @list.List([@equal.gsym(surjective_on_right_inverse())]),
      ),
      t471,
    ),
    t473,
  ])
  let t470 = @tactics.subgoal_then(
    @parser.parse_term(
      "?g. !y. y IN IMAGE (f:A->B) s ==> g(y) IN s /\\ f(g(y)) = y",
    ),
    @tactics.strip_assume_tac,
  )
  let t475 = @tactics.thenl(
    @tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), t470),
    t474,
  )
  image_injective_image_of_subset_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!f:A->B s.\n     ?t. t SUBSET s /\\\n         IMAGE f s = IMAGE f t /\\\n         (!x y. x IN t /\\ y IN t /\\ f x = f y ==> x = y)",
      ),
      t475,
    ),
  )
}

