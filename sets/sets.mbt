          @list.List[(@kernel.HolType, @kernel.HolType)],
        ),
      ),
      @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)],
      (
        (
          @list.List[(Int64, @kernel.Term)],
          @list.List[(@kernel.Term, @kernel.Term)],
          @list.List[(@kernel.HolType, @kernel.HolType)],
        ),
        @list.List[@kernel.Thm],
      ) -> @kernel.Thm raise,
    ) raise) raise {
      let s3613 = ((x3611 : @kernel.Thm) => @tactics.label_tac("lt", x3611))(
        x3612,
      )
      fn(
        x3614 : (@list.List[(String, @kernel.Thm)], @kernel.Term),
      ) -> (
        (
          @list.List[@kernel.Term],
          (
            @list.List[(Int64, @kernel.Term)],
            @list.List[(@kernel.Term, @kernel.Term)],
            @list.List[(@kernel.HolType, @kernel.HolType)],
          ),
        ),
        @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)],
        (
          (
            @list.List[(Int64, @kernel.Term)],
            @list.List[(@kernel.Term, @kernel.Term)],
            @list.List[(@kernel.HolType, @kernel.HolType)],
          ),
          @list.List[@kernel.Thm],
        ) -> @kernel.Thm raise,
      ) raise {
        s3613(x3614)
      }
    })(t3615(x3616))
  })
  let t3610 = @theorems.hyp_tac(
    "m: t m1 m2",
    @simp.rewrite_rule(@list.List([has_sup_v1()])),
  )
  let t3609 = @theorems.hyp_tac(
    "l: s l1 l2",
    @simp.rewrite_rule(@list.List([has_sup_v1()])),
  )
  let t3631 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.thenl(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(
                @tactics.then_tac(
                  @tactics.thenl(
                    @tactics.then_tac(
                      @tactics.then_tac(
                        @tactics.then_tac(
                          @tactics.then_tac(
                            @theorems.intro_tac("!s t l m; l m le"),
                            t3609,
                          ),
                          t3610,
                        ),
                        t3617,
                      ),
                      t3618,
                    ),
                    t3619,
                  ),
                  t3622,
                ),
                t3623,
              ),
              t3624,
            ),
            t3625,
          ),
          t3626,
        ),
        t3629,
      ),
      t3630,
    ),
    @calc_rat.asm_real_arith_tac,
  )
  has_sup_le_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!s t l m. s has_sup l /\\ t has_sup m /\\\n             (!y. y IN t ==> ?x. x IN s /\\ y <= x)\n             ==> m <= l",
      ),
      t3631,
    ),
  )
}

///|
let has_sup_le_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("HAS_SUP_LE")

///|
/// `HAS_SUP_LE`
pub fn has_sup_le() -> @kernel.Thm {
  has_sup_le_c.get()
}

///|
/// new_inductive_set
fn step_684() -> Unit raise {
  let const_of_var : (@kernel.Term) -> @kernel.Term raise = fn(
    x3632 : @kernel.Term,
  ) -> @kernel.Term raise {
    let v = x3632
    let t3633 = @kernel.type_of(v)
    @basics.mk_mconst(@printer.name_of(v), t3633)
  }
  fn f(
    x3634 : Int64,
    x3635 : @kernel.Term,
    x3636 : @list.List[@kernel.HolType],
  ) -> @kernel.Term raise {
    let _ as n = x3634
    let _ as tm = x3635
    match x3636 {
      Empty => tm
      More(ty, tail=tys) => {
        let t3637 = @kernel.mk_var("x" + Int64::to_string(n), ty)
        let v_1 = @kernel.variant(@basics.variables(tm), t3637)
        let t3638 = @kernel.mk_comb(tm, v_1)
        f(@lib.add63(n, 1L), t3638, tys)
      }
    }
  }
  let comb_all : (@kernel.Term) -> @kernel.Term raise = fn(
    x3639 : @kernel.Term,
  ) -> @kernel.Term raise {
    let tm_1 = x3639
    let tys_1 = @lib.splitlist(@basics.dest_fun_ty, @kernel.type_of(tm_1)).0
    f(0L, tm_1, tys_1)
  }
  let t3640 = @simp.rewr_conv(@equal.gsym(in_()))
  let mk_eqin : (@kernel.Term) -> @kernel.Thm raise = fn(
    x3641 : @kernel.Term,
  ) -> @kernel.Thm raise {
    t3640(comb_all(x3641))
  }
  let remove_in_conv : (@kernel.Term) -> ((@kernel.Term) -> @kernel.Thm raise) raise = fn(
    x3647 : @kernel.Term,
  ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    let ptm = x3647
    let rconv : (@kernel.Term) -> @kernel.Thm raise = @simp.rewr_conv(
      @equal.sym(mk_eqin(ptm)),
    )
    fn(x3649 : @kernel.Term) -> @kernel.Thm raise {
      let tm_2 = x3649
      let htm = @basics.strip_comb(@basics.dest_binary("IN", tm_2).1).0
      if htm == ptm {
        rconv(tm_2)
      } else {
        @lib.failure()
      }
    }
  }
  let remove_in_transf : (@list.List[@kernel.Term]) -> ((@kernel.Term) -> @kernel.Term raise) raise = fn(
    x3656 : @list.List[@kernel.Term],
  ) -> ((@kernel.Term) -> @kernel.Term raise) raise {
    (fn(
      x3654 : @list.List[(@kernel.Term) -> @kernel.Thm raise],
    ) -> ((@kernel.Term) -> @kernel.Term raise) raise {
      (fn(
        x3653 : (@kernel.Term) -> @kernel.Thm raise,
      ) -> ((@kernel.Term) -> @kernel.Term raise) raise {
        transf_l(
          (fn(
            x3650 : (@kernel.Term) -> @kernel.Thm raise,
          ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
            let s3651 = @equal.once_depth_conv(x3650)
            fn(x3652 : @kernel.Term) -> @kernel.Thm raise { s3651(x3652) }
          })(x3653),
        )
      })(@equal.first_conv(x3654))
    })(
      ((x3655 : @list.List[@kernel.Term]) => @lib.map(remove_in_conv, x3655))(
        x3656,
      ),
    )
  }
  let rule_head : (@kernel.Term) -> @kernel.Term raise = fn(
    x3657 : @kernel.Term,
  ) -> @kernel.Term raise {
    let tm_3 = x3657
    let tm_4 = @basics.strip_forall(tm_3).1
    let t3658 = @parser.parse_term("(==>)")
    let tm_5 = @lib.splitlist(
        (x3659 : @kernel.Term) => @basics.dest_binop(t3658, x3659),
        tm_4,
      ).1
    let tm_6 = @basics.dest_binary("IN", tm_5).1
    @basics.strip_comb(tm_6).0
  }
  let t3663 = @parser.parse_term("(/\\)")
  let find_pvars : (@kernel.Term) -> @list.List[@kernel.Term] raise = fn(
    x3666 : @kernel.Term,
  ) -> @list.List[@kernel.Term] raise {
    (fn(x3662 : @list.List[@kernel.Term]) -> @list.List[@kernel.Term] raise {
      (fn(x3660 : @list.List[@kernel.Term]) -> @list.List[@kernel.Term] raise {
        @lib.setify(x3660)
      })(
        ((x3661 : @list.List[@kernel.Term]) => @lib.map(rule_head, x3661))(
          x3662,
        ),
      )
    })(
      (fn(x3665 : @kernel.Term) -> @list.List[@kernel.Term] raise {
        ((x3664 : @kernel.Term) => @basics.binops(t3663, x3664))(x3665)
      })(x3666),
    )
  }
  new_inductive_set_c.set(fn(
    x3667 : @kernel.Term,
  ) -> (@kernel.Thm, @kernel.Thm, @kernel.Thm) raise {
    let tm_7 = x3667
    let pvars = find_pvars(tm_7)
    let dtm = remove_in_transf(pvars)(tm_7)
    let (th_rules, th_induct, th_cases) = @ind_defs.new_inductive_definition(
      dtm,
    )
    let insert_in_rule : (@kernel.Thm) -> @kernel.Thm raise = @simp.rewrite_rule(
      @lib.map(
        fn(x3668 : @kernel.Term) -> @kernel.Thm raise {
          mk_eqin(const_of_var(x3668))
        },
        pvars,
      ),
    )
    let t3669 = insert_in_rule(th_cases)
    let t3670 = insert_in_rule(th_induct)
    (insert_in_rule(th_rules), t3670, t3669)
  })
}

///|
let new_inductive_set_c : @lib.Cell[
  (@kernel.Term) -> (@kernel.Thm, @kernel.Thm, @kernel.Thm) raise,
] = @lib.Cell::new("new_inductive_set")

///|
/// `new_inductive_set`
pub fn new_inductive_set(
  x : @kernel.Term,
) -> (@kernel.Thm, @kernel.Thm, @kernel.Thm) raise {
  new_inductive_set_c.get()(x)
}

///|
fn[TA] transf_l(
  x3642 : (TA) -> @kernel.Thm raise,
) -> ((TA) -> @kernel.Term raise) raise {
  let conv = x3642
  fn(x3646 : TA) -> @kernel.Term raise {
    (fn(x3645 : @kernel.Thm) -> @kernel.Term raise {
      @equal.rhs(
        (fn(x3644 : @kernel.Thm) -> @kernel.Term raise { @kernel.concl(x3644) })(
          x3645,
        ),
      )
    })(conv(x3646))
  }
}

