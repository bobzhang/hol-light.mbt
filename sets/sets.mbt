/// `SET_RECURSION_LEMMA`
pub fn set_recursion_lemma() -> @kernel.Thm {
  set_recursion_lemma_c.get()
}

///|
/// ITSET
fn step_314() -> Unit raise {
  itset_c.set(
    @pair.new_definition(
      @parser.parse_term(
        "ITSET (f:A->B->B) s b =\n        (@g. (g {} = b) /\\\n             !x s. FINITE s\n                   ==> (g (x INSERT s) = if x IN s then g s else f x (g s)))\n        s",
      ),
    ),
  )
}

///|
