  let t1102 = @simp.simp_tac(
    @list.List([finite_recursion(), not_in_empty(), in_insert()]),
  )
  let t1101 = @tactics.match_mp_tac(finite_induct_strong())
  let t1100 = @simp.rewrite_tac(@list.List([@theorems.right_forall_imp_thm()]))
  let t1108 = @tactics.then_tac(
