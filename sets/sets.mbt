///|
/// HAS_SIZE_UNION
fn step_334() -> Unit raise {
  let t1270 = @simp.simp_tac(
    @list.List([has_size(), finite_union(), disjoint(), card_union()]),
  )
  has_size_union_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!(s:A->bool) t m n.\n        s HAS_SIZE m /\\ t HAS_SIZE n /\\ DISJOINT s t\n        ==> (s UNION t) HAS_SIZE (m + n)",
      ),
      t1270,
    ),
  )
}

