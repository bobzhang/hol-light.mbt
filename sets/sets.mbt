  let t1316 = @meson.meson_tac(@list.List([lemma, in_delete()]))
  let t1318 = @list.List([
    @tactics.then_tac(
      @simp.rewrite_tac(
        @list.List([has_size_suc(), @equal.gsym(member_not_empty())]),
      ),
      t1316,
    ),
    t1317,
  ])
  let t1315 = @tactics.repeat_tac(@tactics.strip_tac)
  let t1319 = @tactics.thenl(
    @tactics.then_tac(
      @tactics.then_tac(@simp.rewrite_tac(@list.List([has_size_0()])), t1315),
      @tactics.eq_tac,
    ),
    t1318,
  )
  has_size_clauses_c.set(
    @tactics.prove(
      @parser.parse_term(
        "(s HAS_SIZE 0 <=> s = {}) /\\\n   (s HAS_SIZE (SUC n) <=>\n        ?(a:A) t. t HAS_SIZE n /\\ ~(a IN t) /\\ (s = a INSERT t))",
      ),
      t1319,
    ),
