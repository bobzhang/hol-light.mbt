        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.disch_tac,
              @tactics.x_gen_tac(@parser.parse_term("s:A->bool")),
            ),
            @tactics.disch_tac,
          ),
          t127,
        ),
        @tactics.ants_tac,
      ),
      t128,
    ),
    t129,
  )
  let t119 = @tactics.asm_tac(set_tac)(@list.empty())
  let t118 = @tactics.first_x_assum(@tactics.match_mp_tac)
  let t131 = @list.List([
    @tactics.then_tac(
      @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t118),
      t119,
    ),
    t130,
  ])
  let t132 = @tactics.thenl(
    @tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), @tactics.eq_tac),
    t131,
  )
  forall_subset_union_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!t u:A->bool.\n        (!s. s SUBSET t UNION u ==> P s) <=>\n        (!t' u'. t' SUBSET t /\\ u' SUBSET u ==> P(t' UNION u'))",
      ),
      t132,
    ),
  )
}

