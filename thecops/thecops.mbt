}

///|
/// `bot_of_litmat_ext`
pub fn[
  TA : Eq + @lib.OCompare + @lib.OHash,
  TB : Eq + @lib.OCompare + @lib.OHash,
] bot_of_litmat_ext(
  x1028 : ReconData,
  x1029 : (
    @list.List[(@kernel.Term, @kernel.Thm)],
    @list.List[
      (
        Litmat[TA],
        Proof1[
          Litmat[TA],
          @list.List[Litmat[TA]],
          ((Int, TB), @list.List[Int]),
          (
            @list.List[((Int, @list.List[Int]), Int)],
            (
              (Int, @list.List[Int]),
              (
                @list.List[((Int, @list.List[Int]), @list.List[Litmat[Int]])],
                @list.List[((Int, @list.List[Int]), @list.List[Litmat[Int]])],
              ),
              LitmatExt[Int],
            ),
          ),
        ],
      ),
    ],
  ),
  x1030 : @kernel.Thm,
  x1031 : LitmatExt[Int],
) -> (
  (
    @list.List[(@kernel.Term, @kernel.Thm)],
    @list.List[
      (
        Litmat[TA],
        Proof1[
          Litmat[TA],
          Clause[TA],
          ((Int, TB), @list.List[Int]),
          (@list.List[((Int, @list.List[Int]), Int)], ClauseExt[Int]),
        ],
      ),
    ],
  ),
  @kernel.Thm,
) raise {
  let data_2 = x1028
  let acc_1 = x1029
  let thi = x1030
  match x1031 {
    LitmatExt::Litext((clal, clar), clac) => {
      let j = @lib.length(clal)
      let (thj, (thl, thr)) = nth_disj(j, thi)
      let (acc1, botsl) = eat_proofs(data_2)(acc_1)(thl)
      let (acc2, botsr) = eat_proofs(data_2)(acc1)(thr)
      if @firstorder.copverb().val {
        @pp.std_formatter.print_string(
          "bot_of_litmat_ext: thi = " + @printer.string_of_thm(thi) + "\n",
        )
        @pp.std_formatter.print_flush()
        ()
      } else {
        ()
      }
      let tmj = @kernel.concl(thj)
      if !(@basics.is_conj(tmj) || @basics.is_disj(tmj)) {
        ()
      } else {
        raise @lib.AssertFailure("tscript.ml:1350:6")
      }
      let botj = contradiction(
        thj,
        @lib.op_bar_gt(
          @lib.op_bar_gt(@kernel.concl(thj), flip_neg),
          @kernel.assume_rule,
        ),
      )
      (acc2, disj_cases_list(thi, botsl.concat(botsr.prepend(botj))))
    }
    LitmatExt::Matext(j_1, (clal_1, clar_1), clext) => {
      let j_p = @lib.list_assoc(j_1, data_2.mapping)
      if j_p == @lib.length(clal_1) {
        ()
      } else {
        raise @lib.AssertFailure("tscript.ml:1355:6")
      }
      let (thj_1, (thl_1, thr_1)) = nth_disj(j_p, thi)
      let (acc1_1, botj_1) = bot_of_clause_ext(data_2, clext, acc_1, thj_1)
      let (acc2_1, botsl_1) = eat_proofs(data_2)(acc1_1)(thl_1)
      let (acc3, botsr_1) = eat_proofs(data_2)(acc2_1)(thr_1)
      (acc3, disj_cases_list(thi, botsl_1.concat(botsr_1.prepend(botj_1))))
    }
  }
}

///|
/// `bot_of_proof`
pub fn[
  TA : Eq + @lib.OCompare + @lib.OHash,
  TB : Eq + @lib.OCompare + @lib.OHash,
] bot_of_proof(
  x1032 : ReconData,
  x1033 : @list.List[(@kernel.Term, @kernel.Thm)],
  x1034 : @kernel.Thm,
  x1035 : (
    Litmat[TA],
    Proof1[
      Litmat[TA],
      @list.List[Litmat[TA]],
      ((Int, TB), @list.List[Int]),
      (
        @list.List[((Int, @list.List[Int]), Int)],
        (
          (Int, @list.List[Int]),
          (
            @list.List[((Int, @list.List[Int]), @list.List[Litmat[Int]])],
            @list.List[((Int, @list.List[Int]), @list.List[Litmat[Int]])],
          ),
          LitmatExt[Int],
        ),
      ),
    ],
  ),
) -> @kernel.Thm raise {
  let data_3 = x1032
  let lem_1 = x1033
  let th_2 = x1034
  match x1035 {
    (
      Litmat::Mat((j_2, mat_1)),
      Proof1::Decomposition(cla, ((i_1, k), v_1), prfs_2),
    ) => {
      let i_p_1 = @lib.list_assoc(i_1, data_3.mapping)
      if i_p_1 < @lib.length(mat_1) {
        ()
      } else {
        raise @lib.AssertFailure("tscript.ml:1365:6")
      }
      if @lib.list_nth(mat_1, i_p_1).1 == cla {
        ()
      } else {
        raise @lib.AssertFailure("tscript.ml:1366:6")
      }
      if @firstorder.copverb().val {
        @pp.std_formatter.print_string(
          "Decomposition " +
          @lib.string_of_int(i_p_1) +
          ": " +
          @printer.string_of_term(@kernel.concl(th_2)) +
          "\n",
        )
        @pp.std_formatter.print_flush()
        ()
      } else {
        ()
      }
      let t1036 = data_3.sub
      let thi_1 = @lib.op_bar_gt(nth_conj(i_p_1, th_2), (x1037 : @kernel.Thm) => {
        spec_vars(t1036, v_1, x1037)
      })
      let djs = @basics.disjuncts(@kernel.concl(thi_1))
      let t1038 = @lib.length(prfs_2)
      if @lib.length(djs) == t1038 {
        ()
      } else {
        raise @lib.AssertFailure("tscript.ml:1371:6")
      }
      let t1039 = eat_proofs(data_3)((lem_1, prfs_2))
      @lib.op_bar_gt(
        @lib.op_bar_gt(
          @lib.op_bar_gt(@lib.map(@kernel.assume_rule, djs), t1039),
          (
            x1040 : (
              (
                @list.List[(@kernel.Term, @kernel.Thm)],
                @list.List[
                  (
                    Litmat[TA],
                    Proof1[
                      Litmat[TA],
                      @list.List[Litmat[TA]],
                      ((Int, TB), @list.List[Int]),
                      (
                        @list.List[((Int, @list.List[Int]), Int)],
                        (
                          (Int, @list.List[Int]),
                          (
                            @list.List[
                              ((Int, @list.List[Int]), @list.List[Litmat[Int]]),
                            ],
                            @list.List[
                              ((Int, @list.List[Int]), @list.List[Litmat[Int]]),
                            ],
                          ),
                          LitmatExt[Int],
                        ),
                      ),
                    ],
                  ),
                ],
              ),
              @list.List[@kernel.Thm],
            ),
          ) => x1040.1,
        ),
        (x1041 : @list.List[@kernel.Thm]) => disj_cases_list(thi_1, x1041),
      )
    }
    (Litmat::Lit(lit_1), prf_1) => {
      let t1042 = inst_lit_v1(data_3.sub, lit_1)
      let liti = @firstorder.hol_of_literal(t1042.0, t1042.1)
      if @firstorder.copverb().val {
        @pp.std_formatter.print_string(
          "bot_of_proof: lit = " + @printer.string_of_term(liti) + "\n",
        )
        @pp.std_formatter.print_flush()
        ()
      } else {
        ()
      }
      if liti == @kernel.concl(th_2) {
        ()
      } else {
        raise @lib.AssertFailure("tscript.ml:1378:6")
      }
      match prf_1 {
        Proof1::Reduction =>
          @lib.op_bar_gt(@lib.op_bar_gt(flip_neg(liti), @kernel.assume_rule), (
            x1043 : @kernel.Thm,
          ) => contradiction(th_2, x1043))
        Proof1::Lemma => {
          if @lib.list_mem_assoc(liti, lem_1) {
            ()
          } else {
            raise @lib.AssertFailure("tscript.ml:1381:17")
          }
          @lib.list_assoc(liti, lem_1)
        }
        Proof1::Extension(_, (prefix, postfix), prfs_3) => {
          let prefix_th = prefix_problem(data_3)(prefix)
          if @firstorder.copverb().val {
            @pp.std_formatter.print_string(
              "prefix_th = " + @printer.string_of_thm(prefix_th) + "\n",
            )
            @pp.std_formatter.print_flush()
            ()
          } else {
            ()
          }
          let ((_, prfs_p), bot_1) = bot_of_clause_ext(
            data_3,
            postfix,
            (lem_1, prfs_3),
            prefix_th,
          )
          if prfs_p == @list.empty() {
            ()
          } else {
            raise @lib.AssertFailure("tscript.ml:1388:10")
          }
          let t1044 = @kernel.hyp(bot_1)
          if @lib.mem(@kernel.concl(th_2), t1044) {
            ()
          } else {
            raise @lib.AssertFailure("tscript.ml:1389:10")
          }
          @bool.mp(@bool.disch(@kernel.concl(th_2), bot_1), th_2)
        }
        _ => raise Failure("bot_of_proof: not a well-formed proof")
      }
    }
    _ => raise Failure("bot_of_proof: not a well-formed proof")
  }
}

