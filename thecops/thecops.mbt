  let t1026 = data_1.sub
  bot_of_litmat_ext(
    data_1,
    acc,
    @lib.op_bar_gt(nth_conj(i_p, th_1), (x1027 : @kernel.Thm) => {
      spec_vars(t1026, v, x1027)
    }),
    lmext,
