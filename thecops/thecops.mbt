///|
/// `recon_data`
pub(all) struct ReconData {
  problem : @kernel.Thm
  mapping : @list.List[(Int, Int)]
  sub : T1
}

///|
pub impl @lib.OCompare for ReconData with fn ocompare(self, other) {
  let c = @lib.compare(self.problem, other.problem)
  if c != 0 {
    return c
  }
  let c = @lib.compare(self.mapping, other.mapping)
  if c != 0 {
    return c
  }
  @lib.compare(self.sub, other.sub)
}

///|
pub impl @lib.OHash for ReconData with fn ohash_visit(self, h) {
  h.block(0, 3)
  h.field(self.problem)
  h.field(self.mapping)
  h.field(self.sub)
}

///|
/// `clause_index_mapping`
pub fn[TA] clause_index_mapping(
  x986 : @list.List[Litmat[TA]],
) -> @list.List[(TA, Int)] raise {
  let cl = x986
  @lib.op_bar_gt(
    @lib.op_bar_gt(cl, x989 => {
      @lib.list_mapi(
        fn(x987 : Int, x988 : Litmat[TA]) -> @list.List[(TA, Int)] raise {
          let idx = x987
          match x988 {
            Litmat::Lit(_) => @list.empty()
            Litmat::Mat((j, mat_1)) =>
              matrix_index_mapping(mat_1).prepend((j, idx))
          }
        },
        x989,
      )
    }),
    fn(
      x990 : @list.List[@list.List[(TA, Int)]],
    ) -> @list.List[(TA, Int)] raise {
      @lib.flat(x990)
    },
  )
}

///|
/// `matrix_index_mapping`
pub fn[TA] matrix_index_mapping(
  x991 : @list.List[((TA, @list.List[Int]), @list.List[Litmat[TA]])],
) -> @list.List[(TA, Int)] raise {
  let mat_2 = x991
  @lib.op_bar_gt(
    @lib.op_bar_gt(mat_2, x994 => {
      @lib.list_mapi(
        fn(
          x992 : Int,
          x993 : ((TA, @list.List[Int]), @list.List[Litmat[TA]]),
        ) -> @list.List[(TA, Int)] raise {
          let idx_1 = x992
          let ((i, v), cl_1) = x993
          clause_index_mapping(cl_1).prepend((i, idx_1))
        },
        x994,
      )
    }),
    fn(
      x995 : @list.List[@list.List[(TA, Int)]],
    ) -> @list.List[(TA, Int)] raise {
      @lib.flat(x995)
    },
  )
}

///|
/// `mk_recon_data`
pub fn mk_recon_data(
  x996 : @kernel.Thm,
  x997 : @list.List[((Int, @list.List[Int]), @list.List[Litmat[Int]])],
  x998 : T1,
) -> ReconData raise {
  let (problem, mat_1, sub) = (x996, x997, x998)
  ReconData::{ problem, mapping: matrix_index_mapping(mat_1), sub, }
