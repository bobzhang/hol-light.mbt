///|
/// `fol_of_thm`
pub fn fol_of_thm(x1055 : @kernel.Thm) -> @meson.FolForm raise {
  let th = x1055
  let lconsts = @kernel.freesl(@kernel.hyp(th))
  let tm = @kernel.concl(th)
  if @lib.forall(
      fn(x1056 : @kernel.Term) -> Bool raise {
        let x = x1056
        @lib.mem(x, lconsts)
      },
      @kernel.frees(tm),
    ) {
    ()
  } else {
    raise @lib.AssertFailure("tscript.ml:1424:2")
  }
  @firstorder.fol_of_form(@list.empty(), lconsts, tm)
}

///|
/// `NANOCOP_DEEPEN`
pub fn nanocop_deepen(
  x1057 : SearchOpts,
  x1058 : @list.List[@kernel.Thm],
) -> @kernel.Thm raise {
  let opt = x1057
  let ths = x1058
  if @firstorder.copverb().val {
    {
      @pp.std_formatter.print_string("NANOCOP_DEEPEN with ths:\n")
      @pp.std_formatter.print_flush()
      ()
    }
    @lib.do_list(
      (x1060 : @kernel.Thm) => {
        ((x1059 : String) => {
          @pp.std_formatter.print_string("  th: " + x1059 + "\n")
          @pp.std_formatter.print_flush()
          ()
        })(@printer.string_of_thm(x1060))
      },
      ths,
    )
  } else {
    ()
  }
  @firstorder.reset_vars(())
  @firstorder.reset_consts(())
  let t1062 = create_eq_axs(opt.add_eq_symmetry)
  let gen_eq : (@list.List[@kernel.Thm]) -> @list.List[@kernel.Thm] raise = (
    x1066 : @list.List[@kernel.Thm],
  ) => {
    ((x1063 : @list.List[@kernel.Term]) => {
      ((x1061 : @list.List[@kernel.Thm]) => @lib.map(@bool.gen_all, x1061))(
        t1062(x1063),
      )
    })(
      ((x1065 : @list.List[@kernel.Thm]) => {
        @lib.map(
          fn(x1064 : @kernel.Thm) -> @kernel.Term raise { @kernel.concl(x1064) },
          x1065,
        )
      })(x1066),
    )
  }
  let ths_p = if @lib.exists(
      fn(x1067 : @kernel.Thm) -> Bool raise {
        let th = x1067
        @kernel.concl(th) == hashek_tm()
      },
      ths,
    ) {
    ths
  } else {
    ths.prepend(hashek_thm())
  }
  let ths_p_1 = @lib.setify(ths_p.concat(gen_eq(ths_p)))
  let th_1 = @lib.end_itlist(@bool.conj, ths_p_1)
  let fol = fol_of_thm(th_1)
  let mat_1 = index_matrix_v1(matrix_of_form(fol))
  if @firstorder.copverb().val {
    {
      @pp.std_formatter.print_string("Matrix:\n")
      @pp.std_formatter.print_flush()
      ()
    }
    print_matrix_i(mat_1)
  } else {
    ()
  }
  matrix2db(mat_1)
  if @firstorder.copverb().val {
    @pp.std_formatter.print_string("Matrix loaded.\n")
    @pp.std_formatter.print_flush()
    ()
  } else {
    ()
  }
  let (sub, prfs) = strategy(opt, fn(
    x1070 : SearchOpts,
  ) -> ((Int) -> (
    T1,
    (
      Litmat[(Int, Int)],
      Proof1[
        Litmat[(Int, Int)],
        @list.List[Litmat[(Int, Int)]],
        ((Int, Int), @list.List[Int]),
        (
          @list.List[((Int, @list.List[Int]), Int)],
          (
            (Int, @list.List[Int]),
            (
              @list.List[((Int, @list.List[Int]), @list.List[Litmat[Int]])],
              @list.List[((Int, @list.List[Int]), @list.List[Litmat[Int]])],
            ),
            LitmatExt[Int],
          ),
        ),
      ],
    ),
  )? raise) raise {
    fn(
      x1071 : Int,
    ) -> (
      T1,
      (
        Litmat[(Int, Int)],
        Proof1[
          Litmat[(Int, Int)],
          @list.List[Litmat[(Int, Int)]],
          ((Int, Int), @list.List[Int]),
          (
            @list.List[((Int, @list.List[Int]), Int)],
            (
              (Int, @list.List[Int]),
              (
                @list.List[((Int, @list.List[Int]), @list.List[Litmat[Int]])],
                @list.List[((Int, @list.List[Int]), @list.List[Litmat[Int]])],
              ),
              LitmatExt[Int],
            ),
          ),
        ],
      ),
    )? raise {
      ((x1068 : SearchOpts, x1069 : Int) => start_v1(mat_1, x1068, x1069))(
        x1070, x1071,
      )
    }
  })
  if @firstorder.copverb().val {
    {
      @pp.std_formatter.print_string("Theorem\n")
      @pp.std_formatter.print_flush()
      ()
    }
    print_proof_def(sub, prfs)
  } else {
    ()
  }
  let data = mk_recon_data(th_1, mat_1, sub)
  let bot = bot_of_proof(data, @list.empty(), th_1, prfs)
  if @firstorder.copverb().val {
    {
      @pp.std_formatter.print_string("Reconstruction:\n")
      @pp.std_formatter.print_flush()
      ()
    }
    @printer.print_thm(bot)
  } else {
    ()
  }
  let t1072 = @kernel.hyp(th_1)
  if @lib.set_eq(@kernel.hyp(bot), t1072) {
    ()
  } else {
    raise @lib.AssertFailure("tscript.ml:1456:2")
  }
  let t1073 = @parser.parse_term("F")
  if @kernel.concl(bot) == t1073 {
    ()
  } else {
    raise @lib.AssertFailure("tscript.ml:1457:2")
  }
  bot
}

///|
