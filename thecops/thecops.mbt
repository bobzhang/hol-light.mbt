///|
/// `proof`
pub(all) enum Proof[TA, TB] {
  Lemma
  Reduction
  Extension(TB, @list.List[(TA, Proof[TA, TB])])
} derive(Eq, Debug)

///|
fn[TA, TB] ocaml_rank_Proof(x : Proof[TA, TB]) -> Int {
  match x {
    Lemma => 0
    Reduction => 1
    Extension(_, _) => 1000000
  }
}

///|
pub impl[TA : @lib.OCompare, TB : @lib.OCompare] @lib.OCompare for Proof[TA, TB] with fn ocompare(
  self,
  other,
) {
  match (self, other) {
    (Extension(a0, a1), Extension(b0, b1)) => {
      let c = @lib.compare(a0, b0)
      if c != 0 {
        return c
      }
      @lib.compare(a1, b1)
    }
    _ => ocaml_rank_Proof(self).compare(ocaml_rank_Proof(other))
  }
}

///|
pub impl[TA : @lib.OHash, TB : @lib.OHash] @lib.OHash for Proof[TA, TB] with fn ohash_visit(
  self,
  h,
) {
  match self {
    Lemma => h.int(0L)
    Reduction => h.int(1L)
    Extension(a0, a1) => {
      h.block(0, 2)
      h.field(a0)
      h.field(a1)
    }
  }
}

///|
/// `cut`
pub fn[TA] cut_v1(
  x436 : Bool,
  x437 : (Unit) -> TA raise,
  x438 : (Unit) -> TA raise,
) -> ((Unit) -> TA raise) raise {
  let p = x436
  let xs = x437
  let ys = x438
  if p {
    cut(xs, ys)
  } else {
    append(xs, ys)
  }
}

///|
/// `prove_lit`
pub fn prove_lit(
  x440 : SearchOpts,
  x441 : (T1, Int),
  x442 : (
    @list.List[(Int, @list.List[@meson.FolTerm])],
    @list.List[(Int, @list.List[@meson.FolTerm])],
    Int,
  ),
  x443 : (Int, @list.List[@meson.FolTerm]),
) -> Strom[
  (
    (T1, Int),
    @list.List[Lit],
    Proof[(Int, @list.List[@meson.FolTerm]), (Int, @kernel.Thm)],
  ),
] raise {
  let opt = x440
  let sub = x441
  let (path, lem, lim) = x442
  let lit = x443
  if @firstorder.copverb().val {
    @pp.std_formatter.print_string(
      "Lit: " + string_of_lit(inst_lit_v1(sub.0, lit)) + "\n",
    )
    @pp.std_formatter.print_flush()
    ()
  } else {
    ()
  }
  if @firstorder.copverb().val {
    @pp.std_formatter.print_string(
      "Path: " +
      string_of_lits(
        @lib.map(
          (x445 : (Int, @list.List[@meson.FolTerm])) => inst_lit_v1(sub.0, x445),
          path,
        ),
      ) +
      "\n",
    )
    @pp.std_formatter.print_flush()
    ()
  } else {
    ()
  }
  if @firstorder.copverb().val {
    @pp.std_formatter.print_string(
      "Lemmas: " +
      string_of_lits(
        @lib.map(
          (x446 : (Int, @list.List[@meson.FolTerm])) => inst_lit_v1(sub.0, x446),
          lem,
        ),
      ) +
      "\n",
    )
    @pp.std_formatter.print_flush()
    ()
  } else {
    ()
  }
  let neglit = negate_lit(lit.0, lit.1)
  let lemmas : (Unit) -> (
    (T1, Int),
    @list.List[(Int, @list.List[@meson.FolTerm])],
    Proof[_, _],
  ) raise = if opt.improved_lemmas {
    if @lib.exists(
        (x447 : (Int, @list.List[@meson.FolTerm])) => eq(sub, lit, x447),
        lem,
      ) {
      if @firstorder.copverb().val {
        @pp.std_formatter.print_string("lemma\n")
        @pp.std_formatter.print_flush()
        ()
      } else {
        ()
      }
      cons((sub, lem, Proof::Lemma), nil)
    } else {
      nil
    }
  } else {
    @lib.op_bar_gt(
      @lib.op_bar_gt(of_list(lem), fn(
        x451 : (Unit) -> (Int, @list.List[@meson.FolTerm]) raise,
      ) -> ((Unit) -> (Int, @list.List[@meson.FolTerm]) raise) raise {
        fn(x452 : Unit) -> (Int, @list.List[@meson.FolTerm]) raise {
          ((
            x449 : (Unit) -> (Int, @list.List[@meson.FolTerm]) raise,
            x450 : Unit,
          ) => {
            filter(
              (x448 : (Int, @list.List[@meson.FolTerm])) => eq(sub, lit, x448),
              x449,
              x450,
            )
          })(x451, x452)
        }
      }),
      (x456 : (Unit) -> (Int, @list.List[@meson.FolTerm]) raise) => {
        (x457 : Unit) => {
          ((
            x454 : (Unit) -> (Int, @list.List[@meson.FolTerm]) raise,
            x455 : Unit,
          ) => {
            map(
              (x453 : (Int, @list.List[@meson.FolTerm])) => {
                let l = x453
                if @firstorder.copverb().val {
                  @pp.std_formatter.print_string("lemma\n")
                  @pp.std_formatter.print_flush()
                  ()
                } else {
                  ()
                }
                (sub, lem.prepend(lit), Proof::Lemma)
              },
              x454,
              x455,
            )
          })(x456, x457)
        }
      },
    )
  }
  let t461 = of_list(path)
  let reductions : (Unit) -> (
    (T1, Int),
    @list.List[(Int, @list.List[@meson.FolTerm])],
    Proof[_, _],
  ) raise = (x462 : Unit) => {
    filter_map(
      (x458 : (Int, @list.List[@meson.FolTerm])) => {
        let p = x458
        if @firstorder.copverb().val {
          let t459 = string_of_lit(inst_lit_v1(sub.0, lit))
          @pp.std_formatter.print_string(
            "Reduction try " +
            string_of_lit(p) +
            " (for lit " +
            t459 +
            ", lim " +
            @lib.string_of_int(lim) +
            ")\n",
          )
          @pp.std_formatter.print_flush()
          ()
        } else {
          ()
        }
        @firstorder.op_gt_gt_eq(unify(sub, neglit, p), (x460 : (T1, Int)) => {
          let sub1 = x460
          if @firstorder.copverb().val {
            @pp.std_formatter.print_string("Reduction works\n")
            @pp.std_formatter.print_flush()
            ()
          } else {
            ()
          }
          Some((sub1, lem.prepend(lit), Proof::Reduction))
        })
      },
      t461,
      x462,
    )
  }
  let extensions : (Unit) -> (
    (T1, Int),
    @list.List[(Int, @list.List[@meson.FolTerm])],
    Proof[(Int, @list.List[@meson.FolTerm]), (Int, @kernel.Thm)],
  ) raise = @lib.op_bar_gt(@lib.op_bar_gt(db_entries(neglit), of_list), (
    x470 : (Unit) -> (
      @list.List[@meson.FolTerm],
      @list.List[@meson.FolAtom],
      Int,
      (Int, @kernel.Thm),
    ) raise,
  ) => {
    concat_map(
      fn(
        x463 : (
          @list.List[@meson.FolTerm],
          @list.List[@meson.FolAtom],
          Int,
          (Int, @kernel.Thm),
        ),
      ) -> ((Unit) -> (
        (T1, Int),
        @list.List[(Int, @list.List[@meson.FolTerm])],
        Proof[(Int, @list.List[@meson.FolTerm]), (Int, @kernel.Thm)],
      ) raise) raise {
        let (_, _, vars, hsh) as contra = x463
        if lim < 0 && vars > 0 {
          nil
        } else {
          match unify_rename(sub, lit.1, contra) {
            Some((sub1_1, cla1)) =>
              @lib.op_bar_gt(
                prove_clause(
                  opt,
                  sub1_1,
                  (path.prepend(lit), lem, lim - 1),
                  (cla1, hsh),
                ),
                fn(
                  x468 : (Unit) -> (
                    (T1, Int),
                    @list.List[
                      (
                        (Int, @list.List[@meson.FolTerm]),
                        Proof[
                          (Int, @list.List[@meson.FolTerm]),
                          (Int, @kernel.Thm),
                        ],
                      ),
                    ],
                  ) raise,
                ) -> ((Unit) -> (
                  (T1, Int),
                  @list.List[(Int, @list.List[@meson.FolTerm])],
                  Proof[(Int, @list.List[@meson.FolTerm]), (Int, @kernel.Thm)],
                ) raise) raise {
                  fn(
                    x469 : Unit,
                  ) -> (
                    (T1, Int),
                    @list.List[(Int, @list.List[@meson.FolTerm])],
                    Proof[(Int, @list.List[@meson.FolTerm]), (Int, @kernel.Thm)],
                  ) raise {
                    ((
                      x466 : (Unit) -> (
                        (T1, Int),
                        @list.List[
                          (
                            (Int, @list.List[@meson.FolTerm]),
                            Proof[
                              (Int, @list.List[@meson.FolTerm]),
                              (Int, @kernel.Thm),
                            ],
                          ),
                        ],
                      ) raise,
                      x467 : Unit,
                    ) => {
                      map(
                        fn(
                          x465 : (
                            (T1, Int),
                            @list.List[
                              (
                                (Int, @list.List[@meson.FolTerm]),
                                Proof[
                                  (Int, @list.List[@meson.FolTerm]),
                                  (Int, @kernel.Thm),
                                ],
                              ),
                            ],
                          ),
                        ) -> (
                          (T1, Int),
                          @list.List[(Int, @list.List[@meson.FolTerm])],
                          Proof[
                            (Int, @list.List[@meson.FolTerm]),
                            (Int, @kernel.Thm),
                          ],
                        ) raise {
                          let (sub2, prfs) = x465
                          (sub2, lem.prepend(lit), Proof::Extension(hsh, prfs))
                        },
                        x466,
                        x467,
                      )
                    })(x468, x469)
                  }
                },
              )
            None => nil
          }
        }
      },
      x470,
    )
  })
  let t471 = cut_v1(opt.cut3, extensions, nil)
  let t472 = cut_v1(opt.cut2, reductions, t471)
  cut_v1(opt.cut1, lemmas, t472)
}

///|
/// `prove_clause`
pub fn prove_clause(
  x473 : SearchOpts,
  x474 : (T1, Int),
  x475 : (
    @list.List[(Int, @list.List[@meson.FolTerm])],
    @list.List[(Int, @list.List[@meson.FolTerm])],
    Int,
  ),
  x476 : (@list.List[(Int, @list.List[@meson.FolTerm])], (Int, @kernel.Thm)),
) -> Strom[
  (
    (T1, Int),
    @list.List[
      (
        (Int, @list.List[@meson.FolTerm]),
        Proof[(Int, @list.List[@meson.FolTerm]), (Int, @kernel.Thm)],
      ),
    ],
  ),
] raise {
  let opt_1 = x473
  let sub_1 = x474
  let (path_1, lem_1, lim_1) = x475
  let (cl, cl_hsh) = x476
  match cl {
    More(lit_1, tail=lits) =>
      if @lib.exists(
          fn(x478 : (Int, @list.List[@meson.FolTerm])) -> Bool raise {
            let x = x478
            @lib.exists(
              (x479 : (Int, @list.List[@meson.FolTerm])) => eq(sub_1, x, x479),
              path_1,
            )
          },
          cl,
        ) {
        if @firstorder.copverb().val {
          @pp.std_formatter.print_string("regularity\n")
          @pp.std_formatter.print_flush()
          ()
        } else {
          ()
        }
        nil
      } else {
        @lib.op_bar_gt(prove_lit(opt_1, sub_1, (path_1, lem_1, lim_1), lit_1), (
          x487 : (Unit) -> (
            (T1, Int),
            @list.List[(Int, @list.List[@meson.FolTerm])],
            Proof[(Int, @list.List[@meson.FolTerm]), (Int, @kernel.Thm)],
          ) raise,
        ) => {
          concat_map(
            fn(
              x480 : (
                (T1, Int),
                @list.List[(Int, @list.List[@meson.FolTerm])],
                Proof[(Int, @list.List[@meson.FolTerm]), (Int, @kernel.Thm)],
              ),
            ) -> ((Unit) -> (
              (T1, Int),
              @list.List[
                (
                  (Int, @list.List[@meson.FolTerm]),
                  Proof[(Int, @list.List[@meson.FolTerm]), (Int, @kernel.Thm)],
                ),
              ],
            ) raise) raise {
              let (sub1_2, lem1, prf1) = x480
              @lib.op_bar_gt(
                prove_clause(
                  opt_1,
                  sub1_2,
                  (path_1, lem1, lim_1),
                  (lits, cl_hsh),
                ),
                fn(
                  x485 : (Unit) -> (
                    (T1, Int),
                    @list.List[
                      (
                        (Int, @list.List[@meson.FolTerm]),
                        Proof[
                          (Int, @list.List[@meson.FolTerm]),
                          (Int, @kernel.Thm),
                        ],
                      ),
                    ],
                  ) raise,
                ) -> ((Unit) -> (
                  (T1, Int),
                  @list.List[
                    (
                      (Int, @list.List[@meson.FolTerm]),
                      Proof[
                        (Int, @list.List[@meson.FolTerm]),
                        (Int, @kernel.Thm),
                      ],
                    ),
                  ],
                ) raise) raise {
                  fn(
                    x486 : Unit,
                  ) -> (
                    (T1, Int),
                    @list.List[
                      (
                        (Int, @list.List[@meson.FolTerm]),
                        Proof[
                          (Int, @list.List[@meson.FolTerm]),
                          (Int, @kernel.Thm),
                        ],
                      ),
                    ],
                  ) raise {
                    ((
                      x483 : (Unit) -> (
                        (T1, Int),
                        @list.List[
                          (
                            (Int, @list.List[@meson.FolTerm]),
                            Proof[
                              (Int, @list.List[@meson.FolTerm]),
                              (Int, @kernel.Thm),
                            ],
                          ),
                        ],
                      ) raise,
                      x484 : Unit,
                    ) => {
                      map(
                        fn(
                          x482 : (
                            (T1, Int),
                            @list.List[
                              (
                                (Int, @list.List[@meson.FolTerm]),
                                Proof[
                                  (Int, @list.List[@meson.FolTerm]),
                                  (Int, @kernel.Thm),
                                ],
                              ),
                            ],
                          ),
                        ) -> (
                          (T1, Int),
                          @list.List[
                            (
                              (Int, @list.List[@meson.FolTerm]),
                              Proof[
                                (Int, @list.List[@meson.FolTerm]),
                                (Int, @kernel.Thm),
                              ],
                            ),
                          ],
                        ) raise {
                          let (sub2_1, prfs_1) = x482
                          (sub2_1, prfs_1.prepend((lit_1, prf1)))
                        },
                        x483,
                        x484,
                      )
                    })(x485, x486)
                  }
                },
              )
            },
            x487,
          )
        })
      }
    Empty => cons((sub_1, @list.empty()), nil)
  }
}

///|
/// `hol_negate`
pub fn hol_negate(x488 : @kernel.Term) -> @kernel.Term raise {
  let tm = x488
  @basics.dest_neg(tm) catch {
    Failure(_) => @bool.mk_neg(tm)
    e => raise e
  }
}

///|
/// `hashek_of_proof`
pub fn hashek_of_proof(
  x489 : T1,
  x490 : @list.List[@kernel.Thm],
  x491 : (Int, @list.List[@meson.FolTerm]),
) -> ((Proof[Lit, (Int, @kernel.Thm)]) -> @kernel.Thm raise) raise {
  let sub = x489
  let lem = x490
  let lit = x491
  let t493 = inst_lit_v1(sub, lit)
  let liti = @firstorder.hol_of_literal(t493.0, t493.1)
  fn(
    x494 : Proof[(Int, @list.List[@meson.FolTerm]), (Int, @kernel.Thm)],
  ) -> @kernel.Thm raise {
    match x494 {
      Proof::Lemma =>
        @lib.find(
          fn(x495 : @kernel.Thm) -> Bool raise {
            let x = x495
            @kernel.concl(x) == liti
          },
          lem,
        )
      Proof::Reduction => @kernel.assume_rule(liti)
      Proof::Extension(contra, prfs) => {
        let (_, ths) = @firstorder.fold_map(
          fn(
            x496 : @list.List[@kernel.Thm],
          ) -> ((
            (
              (Int, @list.List[@meson.FolTerm]),
              Proof[(Int, @list.List[@meson.FolTerm]), (Int, @kernel.Thm)],
            ),
          ) -> (@list.List[@kernel.Thm], @kernel.Thm) raise) raise {
            let lem_1 = x496
            fn(
              x497 : (
                (Int, @list.List[@meson.FolTerm]),
                Proof[(Int, @list.List[@meson.FolTerm]), (Int, @kernel.Thm)],
              ),
            ) -> (@list.List[@kernel.Thm], @kernel.Thm) raise {
              let (lit_1, prf) = x497
              let p = hashek_of_proof(sub, lem_1, lit_1)(prf)
              (lem_1.prepend(p), p)
            }
          },
          lem,
          prfs,
        )
        let cth = @meson.make_hol_contrapos(contra)
        let hth = if ths == @list.empty() {
          cth
        } else {
          let t498 = @lib.end_itlist(@bool.conj, ths)
          @drule.match_mp(cth)(t498)
        }
        let ith = @drule.part_match((x499 : @kernel.Term) => x499, hth)(liti)
        @meson.finish_rule(@bool.disch(hol_negate(@kernel.concl(ith)), ith))
      }
    }
  }
}

///|
/// `start`
pub fn start(
  x500 : SearchOpts,
  x501 : Int,
) -> (T1, Proof[(Int, @list.List[@meson.FolTerm]), (Int, @kernel.Thm)])? raise {
  let opt = x500
  let lim = x501
  if @firstorder.copverb().val {
    @pp.std_formatter.print_string(
      "Start " + @lib.string_of_int(lim + 1) + "\n",
    )
    @pp.std_formatter.print_flush()
    ()
  } else {
    ()
  }
  let sub0 = empty_v1(1000000)
  let hashek = @firstorder.fol_of_literal(
    @list.empty(),
    @list.empty(),
    hashek_tm(),
  )
  let hashek_neg = negate_lit(hashek.0, hashek.1)
  let prfs : (Unit) -> (
    (T1, Int),
    @list.List[(Int, @list.List[@meson.FolTerm])],
    Proof[(Int, @list.List[@meson.FolTerm]), (Int, @kernel.Thm)],
  ) raise = prove_lit(
    opt,
    (sub0, 0),
    (@list.empty(), @list.empty(), lim),
    hashek_neg,
  )
  match next_opt(prfs) {
    Some((sub, _, prf)) => Some((sub.0, prf))
    None => None
  }
}

///|
/// `LEANCOP_DEEPEN`
pub fn leancop_deepen(
  x502 : SearchOpts,
  x503 : @list.List[@kernel.Thm],
) -> @kernel.Thm raise {
  let opt = x502
  let ths = x503
  @meson.clear_contrapos_cache(())
  @firstorder.reset_vars(())
  @firstorder.reset_consts(())
  let t505 = @lib.map(
    fn(x504 : @kernel.Thm) -> @kernel.Term raise { @kernel.concl(x504) },
    ths,
  )
  let ths_p = ths.concat(create_eq_axs(opt.add_eq_symmetry)(t505))
  axioms2db(ths_p)
  let (sub, prf) = strategy(opt, fn(
    x506 : SearchOpts,
  ) -> ((Int) -> (
    T1,
    Proof[(Int, @list.List[@meson.FolTerm]), (Int, @kernel.Thm)],
  )? raise) raise {
    fn(
      x507 : Int,
    ) -> (T1, Proof[(Int, @list.List[@meson.FolTerm]), (Int, @kernel.Thm)])? raise {
      start(x506, x507)
    }
  })
  let hashek = @firstorder.fol_of_literal(
    @list.empty(),
    @list.empty(),
    hashek_tm(),
  )
  let hashek_neg = negate_lit(hashek.0, hashek.1)
  let th = hashek_of_proof(sub, @list.empty(), hashek_neg)(prf)
  @kernel.eq_mp(hashek_eq(), th)
}

///|
/// `PREPARE_LEAN_TAC`
pub fn prepare_lean_tac(
  x508 : @list.List[@kernel.Thm],
) -> @tactics.Tactic raise {
  let ths = x508
  let t524 = @tactics.repeat_tac(@tactics.first_x_assum(@tactics.subst_var_tac))
  let t521 = @canon.assoc_conv(@theorems.disj_assoc())
  let t523 = @tactics.rule_assum_tac((x522 : @kernel.Thm) => {
    @equal.conv_rule(t521, x522)
  })
  let t520 = @tactics.repeat_tac(
    @tactics.first_x_assum((x519 : @kernel.Thm) => {
      @meson.conjuncts_then_p(
        fn(
          x516 : @kernel.Thm,
        ) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> (
          (
            @list.List[@kernel.Term],
            (
              @list.List[(Int, @kernel.Term)],
              @list.List[(@kernel.Term, @kernel.Term)],
              @list.List[(@kernel.HolType, @kernel.HolType)],
            ),
          ),
          @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)],
          (
            (
              @list.List[(Int, @kernel.Term)],
              @list.List[(@kernel.Term, @kernel.Term)],
              @list.List[(@kernel.HolType, @kernel.HolType)],
            ),
            @list.List[@kernel.Thm],
          ) -> @kernel.Thm raise,
        ) raise) raise {
          let s517 = @tactics.assume_tac(x516)
          fn(
            x518 : (@list.List[(String, @kernel.Thm)], @kernel.Term),
          ) -> (
            (
              @list.List[@kernel.Term],
              (
                @list.List[(Int, @kernel.Term)],
                @list.List[(@kernel.Term, @kernel.Term)],
                @list.List[(@kernel.HolType, @kernel.HolType)],
              ),
            ),
            @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)],
            (
              (
                @list.List[(Int, @kernel.Term)],
                @list.List[(@kernel.Term, @kernel.Term)],
                @list.List[(@kernel.HolType, @kernel.HolType)],
              ),
              @list.List[@kernel.Thm],
            ) -> @kernel.Thm raise,
          ) raise {
            s517(x518)
          }
        },
        x519,
      )
    }),
  )
  let t515 = @tactics.rule_assum_tac((x514 : @kernel.Thm) => {
    @lib.repeat(
      fn(x513 : @kernel.Thm) -> @kernel.Thm raise {
        let th = x513
        @bool.spec(
          @basics.genvar(
            @kernel.type_of(@basics.dest_forall(@kernel.concl(th)).0),
          ),
          th,
        )
      },
      x514,
    )
  })
  let t510 = @equal.thenc(@canon.prenex_conv, @canon.weak_cnf_conv)
  let t512 = @tactics.rule_assum_tac((x511 : @kernel.Thm) => {
    @equal.conv_rule(t510, x511)
  })
  @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(@tactics.then_tac(prepare_cop_tac(ths), t512), t515),
        t520,
      ),
      t523,
    ),
    t524,
  )
}

///|
/// `PURE_LEANCOP`
pub fn pure_leancop(
  x525 : SearchOpts,
  x526 : (@list.List[(String, @kernel.Thm)], @kernel.Term),
) -> @tactics.Goalstate raise {
  let opt = x525
  let gl = x526
  @tactics.orelse_tac(
    @tactics.first_assum(fn(
      x527 : @kernel.Thm,
    ) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> (
      (
        @list.List[@kernel.Term],
        (
          @list.List[(Int, @kernel.Term)],
          @list.List[(@kernel.Term, @kernel.Term)],
          @list.List[(@kernel.HolType, @kernel.HolType)],
