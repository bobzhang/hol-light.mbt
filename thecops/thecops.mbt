  )
}

///|
/// `litmat_ext`
pub(all) enum LitmatExt[TA] {
  Litext((Clause[TA], Clause[TA]), Clause[TA])
  Matext(Int, (Clause[TA], Clause[TA]), ClauseExt[TA])
} derive(Eq, Debug)

///|
fn[TA] ocaml_rank_LitmatExt(x : LitmatExt[TA]) -> Int {
  match x {
    Litext(_, _) => 1000000
    Matext(_, _, _) => 1000001
  }
}

///|
pub impl[TA : @lib.OCompare] @lib.OCompare for LitmatExt[TA] with fn ocompare(
  self,
  other,
) {
  match (self, other) {
    (Litext(a0, a1), Litext(b0, b1)) => {
      let c = @lib.compare(a0, b0)
      if c != 0 {
        return c
      }
      @lib.compare(a1, b1)
    }
    (Matext(a0, a1, a2), Matext(b0, b1, b2)) => {
      let c = @lib.compare(a0, b0)
      if c != 0 {
        return c
      }
      let c = @lib.compare(a1, b1)
      if c != 0 {
        return c
      }
      @lib.compare(a2, b2)
    }
    _ => ocaml_rank_LitmatExt(self).compare(ocaml_rank_LitmatExt(other))
  }
}

///|
pub impl[TA : @lib.OHash] @lib.OHash for LitmatExt[TA] with fn ohash_visit(
  self,
  h,
) {
  match self {
    Litext(a0, a1) => {
      h.block(0, 2)
      h.field(a0)
      h.field(a1)
    }
    Matext(a0, a1, a2) => {
      h.block(1, 3)
      h.field(a0)
      h.field(a1)
      h.field(a2)
    }
  }
}

///|
/// `clause_ext`
pub type ClauseExt[TA] = (
  (Int, @list.List[TA]),
  (Matrix[TA], Matrix[TA]),
  LitmatExt[TA],
)

///|
/// `offset_iv`
pub fn[TA] offset_iv(
  x782 : Int,
  x783 : (TA, @list.List[Int]),
) -> (TA, @list.List[Int]) raise {
  let off = x782
  let (i, v) = x783
  (i, @lib.map((x784 : Int) => off + x784, v))
}

