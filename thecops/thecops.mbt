      x776 : @pp.Formatter,
    ) -> (((TA, Proof1[TA, TC, TD, TE])) -> Unit raise) raise {
      fn(x777 : (TA, Proof1[TA, TC, TD, TE])) -> Unit raise {
        ((x774 : @pp.Formatter, x775 : (TA, Proof1[TA, TC, TD, TE])) => {
          pp_print_proof((fl, fc), sub, x774, x775)
        })(x776, x777)
      }
    },
