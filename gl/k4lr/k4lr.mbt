  let t433 = @tactics.exists_tac(@parser.parse_term("Box (Box p --> p) --> Box (Box p)"))
  let t432 = @tactics.match_mp_tac(k4lr_imp_trans())
  let t442 = @tactics.thenl(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.gen_tac, @tactics.match_mp_tac(k4lr_lobrule())), t432), t433), @tactics.conj_tac), t441)
  k4lr_proves_lob_axiom_c.set(@tactics.prove(@parser.parse_term("!p. |~ (Box (Box p --> p) --> Box p)"), t442))
}

///|
let k4lr_proves_lob_axiom_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("K4LR_proves_Lob_axiom")

///|
/// `K4LR_proves_Lob_axiom`
pub fn k4lr_proves_lob_axiom() -> @kernel.Thm {
  k4lr_proves_lob_axiom_c.get()
}

///|
/// K4LR_proves_GLaxioms
fn step_130() -> Unit raise {
  let t443 = @meson.meson_tac(@list.List([k4lrproves_rules(), k4lraxiom_rules(), k4lr_proves_lob_axiom()]))
  let t444 = @tactics.then_tac(@tactics.match_mp_tac(@gl.glaxiom_induct()), t443)
  k4lr_proves_glaxioms_c.set(@tactics.prove(@parser.parse_term("!p. GLaxiom p ==> |~ p"), t444))
}

///|
let k4lr_proves_glaxioms_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("K4LR_proves_GLaxioms")

///|
/// `K4LR_proves_GLaxioms`
pub fn k4lr_proves_glaxioms() -> @kernel.Thm {
  k4lr_proves_glaxioms_c.get()
}

///|
/// GLproves_subset_K4LRproves
fn step_131() -> Unit raise {
  let t445 = @meson.meson_tac(@list.List([k4lr_proves_glaxioms(), k4lr_modusponens(), k4lr_necessitation(), k4lr_proves_lob_axiom()]))
  let t446 = @tactics.then_tac(@tactics.match_mp_tac(@gl.glproves_induct()), t445)
  glproves_subset_k4lrproves_c.set(@tactics.prove(@parser.parse_term("!p. |-- p ==> |~ p"), t446))
}

///|
let glproves_subset_k4lrproves_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("GLproves_subset_K4LRproves")

///|
/// `GLproves_subset_K4LRproves`
pub fn glproves_subset_k4lrproves() -> @kernel.Thm {
  glproves_subset_k4lrproves_c.get()
}

///|
/// GL_equiv_K4LR
fn step_132() -> Unit raise {
  let t447 = @meson.meson_tac(@list.List([glproves_subset_k4lrproves(), k4lrproves_subset_glproves()]))
  gl_equiv_k4lr_c.set(@tactics.prove(@parser.parse_term("!p. |-- p <=> |~ p"), t447))
}

