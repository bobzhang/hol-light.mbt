      #|  ?groupel:(bool#K)list->A.\n        groupel [] = group_id G /\\\n        (!x l. groupel (CONS (F,x) l) = group_mul G (gdecmap x) (groupel l)) /\\\n        (!x l. groupel (CONS (T,x) l) =\n               group_mul G (group_inv G (gdecmap x)) (groupel l))
      #|  :P
      #|  :P
      #|  :P
      #|  :P
      #|  \\n. n + 1
      #|  (+):num->num->num
      #|  (+):num->num->num
      #|  gencmap:A->K
      #|  gdecmap:K->A
