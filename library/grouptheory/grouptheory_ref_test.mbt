  log.attempt("GROUP_MUL_LID", () => sthm(@grouptheory.group_mul_lid()))
  log.attempt("GROUP_MUL_RID", () => sthm(@grouptheory.group_mul_rid()))
  log.attempt("GROUP_MUL_LINV", () => sthm(@grouptheory.group_mul_linv()))
  log.attempt("GROUP_MUL_RINV", () => sthm(@grouptheory.group_mul_rinv()))
  log.attempt("GROUPS_EQ", () => sthm(@grouptheory.groups_eq()))
  log.attempt("GROUP_CARRIER_NONEMPTY", () => {
