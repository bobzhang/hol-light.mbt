      #|  !G h k:A->bool.\n        k subgroup_of G\n        ==> (h subgroup_of (subgroup_generated G k) <=>\n             h subgroup_of G /\\ h SUBSET k)
      #|  !G:A group. subgroup_generated G (group_carrier G) = G
