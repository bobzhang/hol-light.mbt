// Load-fidelity test for Library/grouptheory.ml: replays tools/ocaml_ref/Library_grouptheory_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "Library/grouptheory matches Library/grouptheory.ml" {
  @grouptheory.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "Library/frag", "Library/wo", "Library/card", "Library/prime", "Library/grouptheory",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Library/grouptheory")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("group_tybij", () => sthm(@grouptheory.group_tybij()))
  log.attempt("group_carrier", () => sthm(@grouptheory.group_carrier()))
  log.attempt("group_id", () => sthm(@grouptheory.group_id()))
  log.attempt("group_inv", () => sthm(@grouptheory.group_inv()))
  log.attempt("group_mul", () => sthm(@grouptheory.group_mul()))
  log.attempt("GROUP_ID", () => sthm(@grouptheory.group_id_v1()))
