      #|  !G h x y:A.\n        h subgroup_of G /\\ x IN group_carrier G /\\ y IN group_carrier G\n        ==> (left_coset G x h = left_coset G y h <=>\n             ~(DISJOINT (left_coset G x h) (left_coset G y h)))
