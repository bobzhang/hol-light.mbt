      #|  !G s:A->bool.\n        s SUBSET group_carrier G\n        ==> group_centralizer G s =\n             {x | x IN group_carrier G /\\\n                  !y. y IN s ==> group_mul G x y = group_mul G y x}
      #|  s SUBSET u ==> u INTER s = s
