///|
fn[TA : Eq + @lib.OCompare + @lib.OHash] find_rot_l(
  x432 : @list.List[TA],
  x433 : @list.List[TA],
) -> Int raise {
  let l_1 = x432
  let l_p = x433
  @lib.find(
    fn(x434 : Int) -> Bool raise {
      let n_2 = x434
      let (l1, l2) = @lib.chop_list(n_2, l_1)
      l2.concat(l1) == l_p
    },
    @lib.range(0, @lib.length(l_1) - 1),
  )
}

