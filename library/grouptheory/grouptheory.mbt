///|
/// ABELIAN_GROUP_SUM_MUL
fn step_163() -> Unit raise {
  let t1005 = @meson.asm_meson_tac(@list.List([abelian_group()]))
  let t1004 = @simp.asm_rewrite_tac(@list.List([@sets.pairwise()]))
  let t1003 = @tactics.match_mp_tac(group_sum_mul())
  let t1006 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t1003),
      t1004,
    ),
    t1005,
  )
  abelian_group_sum_mul_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!G k f (g:K->A).\n        abelian_group G /\\\n        FINITE {i | i IN k /\\ ~(f i = group_id G)} /\\\n        FINITE {i | i IN k /\\ ~(g i = group_id G)} /\\\n        (!i. i IN k ==> f i IN group_carrier G /\\ g i IN group_carrier G)\n        ==> group_sum G k (\\i. group_mul G (f i) (g i)) =\n            group_mul G (group_sum G k f) (group_sum G k g)",
      ),
      t1006,
    ),
  )
}

