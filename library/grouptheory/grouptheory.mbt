        t6444,
      ),
      t6445,
    ),
    t6446,
  )
  let t6443 = @simp.asm_simp_tac(
    @list.List([group_mul_lid(), group_mul_rid(), group_pow_v1()]),
  )
  let t6448 = @list.List([
    @tactics.then_tac(
      @simp.asm_simp_tac(
        @list.List([group_pow_mul(), group_pow_element_order(), group_pow_id()]),
      ),
      t6443,
