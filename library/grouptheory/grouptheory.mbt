///|
/// OPPOSITE_GROUP
fn step_21() -> Unit raise {
  let t43 = @simp.simp_tac(
    @list.List([group_carrier(), group_id(), group_inv(), group_mul()]),
  )
  let t44 = @list.List([@simp.simp_tac(group_properties()), t43])
  let t42 = @simp.rewrite_tac(@list.List([@equal.gsym(opposite_group())]))
  let t41 = @bool.conjunct2(group_tybij())
  let t45 = @tactics.thenl(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.gen_tac,
          @tactics.mp_tac(
            @bool.eq_imp_rule(
              @bool.ispec(
                @kernel.rand(
                  @kernel.rand(
                    @basics.strip_forall(@kernel.concl(opposite_group())).1,
                  ),
                ),
                t41,
              ),
            ).0,
          ),
        ),
        t42,
      ),
      @tactics.ants_tac,
    ),
    t44,
  )
  opposite_group_v1_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!G:A group.\n        group_carrier(opposite_group G) = group_carrier G /\\\n        group_id(opposite_group G) = group_id G /\\\n        group_inv(opposite_group G) = group_inv G /\\\n        group_mul(opposite_group G) = \\x y. group_mul G y x",
      ),
      t45,
    ),
  )
}

