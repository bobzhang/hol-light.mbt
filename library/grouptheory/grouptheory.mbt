  let t3368 = @tactics.exists_tac(
    @parser.parse_term("group_mul G (group_inv G h:A)"),
  )
  let t3367 = @tactics.match_mp_tac(
    @sets.set_rule(
      @parser.parse_term(
        "!g. (!x. x IN u ==> (P x <=> g x IN t)) /\\ t SUBSET u /\\\n        (!y. y IN u ==> f y IN u /\\ g(f y) = y /\\ f(g y) = y)\n        ==> {x | x IN u /\\ P x} = IMAGE f t",
      ),
    ),
  )
  let t3372 = @tactics.then_tac(
    @tactics.thenl(
      @tactics.then_tac(
        @tactics.then_tac(
