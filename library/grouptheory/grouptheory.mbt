            t3368,
          ),
          t3369,
        ),
        @tactics.conj_tac,
      ),
      t3370,
    ),
    t3371,
  )
  group_action_fibres_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!G s (a:A->X->X) h x.\n        group_action G s a /\\ h IN group_carrier G /\\ x IN s\n        ==> {g | g IN group_carrier G /\\ (a:A->X->X) g x = a h x} =\n            IMAGE (group_mul G h) (group_stabilizer G a x)",
      ),
      t3372,
    ),
