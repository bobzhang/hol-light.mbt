///|
/// GROUP_COMMUTES_ZPOW
fn step_86() -> Unit raise {
  let t288 = @meson.asm_meson_tac(
    @list.List([group_commutes_inv(), group_inv_v1()]),
  )
  let t287 = @tactics.match_mp_tac(group_commutes_pow())
  let t286 = @tactics.repeat_tac(@tactics.strip_tac)
  let t285 = @simp.asm_simp_tac(@list.List([group_inv_pow()]))
  let t284 = @simp.rewrite_tac(@list.List([group_commutes_pow()]))
  let t283 = @tactics.repeat_tac(@tactics.gen_tac)
  let t289 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @simp.rewrite_tac(
                @list.List([@int.forall_int_cases(), group_zpow_pow()]),
              ),
              t283,
            ),
            t284,
          ),
          t285,
        ),
        t286,
      ),
      t287,
    ),
    t288,
  )
  group_commutes_zpow_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!G (x:A) (y:A) n.\n      x IN group_carrier G /\\ y IN group_carrier G /\\\n      group_mul G x y = group_mul G y x\n      ==> group_mul G (group_zpow G x n) y = group_mul G y (group_zpow G x n)",
      ),
      t289,
    ),
  )
}

