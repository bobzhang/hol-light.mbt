    ),
  )
  let t14958 = @tactics.asm_tac(@sets.set_tac)(@list.empty())
  let t14959 = @list.List([
    @tactics.then_tac(
      @tactics.rule_assum_tac(
        @simp.rewrite_rule(
          @list.List([
            group_isomorphisms(),
            group_homomorphism(),
            group_exactness(),
          ]),
        ),
      ),
      t14958,
    ),
    @tactics.all_tac,
  ])
  let t14957 = @tactics.subgoal_then(
    @parser.parse_term(
      "(c:W->C) x IN group_carrier C /\\\n    (h':C->A) (c x) IN group_carrier A /\\\n    (a:A->Y) (h'(c x)) IN group_carrier Y /\\\n    (i:A->X) (h'(c x)) IN group_carrier X /\\\n    (d:W->D) x IN group_carrier D /\\\n    (k':D->B) (d x) IN group_carrier B /\\\n    (b:B->Y) (k'(d x)) IN group_carrier Y /\\\n    (j:B->X) (k'(d x)) IN group_carrier X",
    ),
    @tactics.strip_assume_tac,
  )
  let t14955 = @tactics.asm_tac(@sets.set_tac)(@list.empty())
  let t14956 = @list.List([
    @tactics.then_tac(
      @tactics.rule_assum_tac(
        @simp.rewrite_rule(
          @list.List([group_homomorphism(), group_exactness()]),
        ),
      ),
      t14955,
    ),
    @tactics.all_tac,
  ])
  let t14954 = @tactics.subgoal_then(
    @parser.parse_term("(l:W->X) x IN group_carrier X"),
    fn(
      x14951 : @kernel.Thm,
    ) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> (
      (
        @list.List[@kernel.Term],
        (
          @list.List[(Int, @kernel.Term)],
          @list.List[(@kernel.Term, @kernel.Term)],
          @list.List[(@kernel.HolType, @kernel.HolType)],
        ),
      ),
      @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)],
      (
        (
          @list.List[(Int, @kernel.Term)],
          @list.List[(@kernel.Term, @kernel.Term)],
          @list.List[(@kernel.HolType, @kernel.HolType)],
        ),
        @list.List[@kernel.Thm],
      ) -> @kernel.Thm raise,
    ) raise) raise {
      let s14952 = @tactics.assume_tac(x14951)
      fn(
        x14953 : (@list.List[(String, @kernel.Thm)], @kernel.Term),
      ) -> (
        (
          @list.List[@kernel.Term],
          (
            @list.List[(Int, @kernel.Term)],
            @list.List[(@kernel.Term, @kernel.Term)],
            @list.List[(@kernel.HolType, @kernel.HolType)],
          ),
        ),
        @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)],
        (
          (
            @list.List[(Int, @kernel.Term)],
            @list.List[(@kernel.Term, @kernel.Term)],
            @list.List[(@kernel.HolType, @kernel.HolType)],
          ),
          @list.List[@kernel.Thm],
        ) -> @kernel.Thm raise,
      ) raise {
        s14952(x14953)
      }
    },
  )
  let t15115 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(
                @tactics.thenl(
                  @tactics.then_tac(
                    @tactics.then_tac(
                      @tactics.then_tac(
                        @tactics.then_tac(
                          @tactics.then_tac(
                            @tactics.then_tac(
                              @tactics.then_tac(
                                @tactics.then_tac(
                                  @tactics.then_tac(
                                    @tactics.then_tac(
                                      @tactics.then_tac(
                                        @tactics.then_tac(
                                          @tactics.then_tac(
                                            @tactics.then_tac(
                                              @tactics.then_tac(
                                                @tactics.then_tac(
                                                  @tactics.then_tac(
                                                    @tactics.then_tac(
                                                      @tactics.then_tac(
                                                        @tactics.then_tac(
                                                          @tactics.then_tac(
                                                            @tactics.then_tac(
                                                              @tactics.then_tac(
                                                                @tactics.then_tac(
                                                                  @tactics.thenl(
                                                                    @tactics.then_tac(
                                                                      @tactics.then_tac(
                                                                        @tactics.then_tac(
                                                                          @tactics.then_tac(
                                                                            @tactics.then_tac(
                                                                              @tactics.then_tac(
                                                                                @tactics.then_tac(
                                                                                  @tactics.thenl(
                                                                                    @tactics.then_tac(
                                                                                      @tactics.then_tac(
                                                                                        @tactics.then_tac(
                                                                                          @tactics.thenl(
                                                                                            @tactics.then_tac(
                                                                                              @tactics.thenl(
                                                                                                @tactics.then_tac(
                                                                                                  @tactics.repeat_tac(
                                                                                                    @tactics.strip_tac,
                                                                                                  ),
                                                                                                  t14954,
                                                                                                ),
                                                                                                t14956,
                                                                                              ),
                                                                                              t14957,
                                                                                            ),
                                                                                            t14959,
                                                                                          ),
                                                                                          t14970,
                                                                                        ),
                                                                                        t14971,
                                                                                      ),
                                                                                      @tactics.ants_tac,
                                                                                    ),
                                                                                    t14972,
                                                                                  ),
                                                                                  t14980,
                                                                                ),
                                                                                t14989,
                                                                              ),
                                                                              t14990,
                                                                            ),
                                                                            t14992,
                                                                          ),
                                                                          t14993,
                                                                        ),
                                                                        @tactics.strip_tac,
                                                                      ),
                                                                      t14994,
                                                                    ),
                                                                    t14996,
                                                                  ),
                                                                  t14997,
                                                                ),
                                                                t15011,
                                                              ),
                                                              t15012,
                                                            ),
                                                            t15017,
                                                          ),
                                                          t15031,
                                                        ),
                                                        t15032,
                                                      ),
                                                      t15037,
                                                    ),
                                                    t15038,
                                                  ),
                                                  t15039,
                                                ),
                                                t15044,
                                              ),
                                              t15045,
                                            ),
                                            t15046,
                                          ),
                                          t15049,
                                        ),
                                        t15050,
                                      ),
                                      t15051,
                                    ),
                                    t15052,
                                  ),
                                  t15053,
                                ),
                                t15054,
                              ),
                              t15059,
                            ),
                            @tactics.binop_tac,
                          ),
                          @tactics.ap_term_tac,
                        ),
                        t15073,
                      ),
                      t15074,
                    ),
                    t15079,
                  ),
                  t15091,
                ),
                t15104,
              ),
