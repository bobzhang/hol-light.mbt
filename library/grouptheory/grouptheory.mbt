    t6447,
  ])
  let t6442 = @tactics.match_mp_tac(
    @meson.meson(
      @list.empty(),
      @parser.parse_term(
        "(group_mul G (group_pow G x m) (group_pow G y m) = group_pow G x m /\\\n     group_mul G (group_pow G x n) (group_pow G y n) = group_pow G y n) /\\\n    (group_mul G (group_pow G x m) (group_pow G y m) = group_id G /\\\n     group_mul G (group_pow G x n) (group_pow G y n) = group_id G)\n    ==> group_pow G x m = group_id G /\\ group_pow G y n = group_id G",
      ),
    ),
  )
  let t6441 = @simp.asm_simp_tac(@list.List([@equal.gsym(group_pow_eq_id())]))
  let t6440 = @tactics.match_mp_tac(
    @int.number_rule(
      @parser.parse_term(
        "(a:num) divides (b * c) /\\ b divides (a * c) /\\ coprime(a,b)\n    ==> (a * b) divides c",
      ),
    ),
  )
  let t6439 = @simp.asm_simp_tac(
    @list.List([group_element_order_mul_divides()]),
  )
  let t6438 = @simp.rewrite_tac(
    @list.List([@equal.gsym(@int.divides_antisym())]),
  )
  let t6449 = @tactics.thenl(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t6438),
              t6439,
            ),
            t6440,
