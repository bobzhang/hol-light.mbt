///|
/// GROUP_SUM_NORMAL_EQ_COMMUTING
fn step_1103() -> Unit raise {
  let t10697 = @simp.asm_rewrite_tac(@list.empty())
  let t10698 = @tactics.then_tac(
    @tactics.match_mp_tac(group_sum_commuting_imp_normal()),
    t10697,
  )
  let t10696 = @simp.asm_rewrite_tac(@list.empty())
  let t10699 = @list.List([
    @tactics.then_tac(
      @tactics.match_mp_tac(group_sum_normal_imp_commuting()),
      t10696,
    ),
    t10698,
  ])
  let t10700 = @tactics.thenl(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.repeat_tac(@tactics.strip_tac),
        @tactics.eq_tac,
      ),
      @tactics.strip_tac,
    ),
    t10699,
  )
  group_sum_normal_eq_commuting_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!G g h:A->bool.\n        g subgroup_of G /\\ h subgroup_of G /\\\n        group_carrier G SUBSET group_setmul G g h /\\\n        g INTER h SUBSET {group_id G}\n        ==> (g normal_subgroup_of G /\\ h normal_subgroup_of G <=>\n             !x y. x IN g /\\ y IN h ==> group_mul G x y = group_mul G y x)",
      ),
      t10700,
    ),
  )
}

