///|
/// GROUP_SUM_MUL
fn step_162() -> Unit raise {
  let t1001 = @simp.rewrite_tac(@list.List([@wo.wo()]))
  let t1000 = @tactics.conv_tac(@class.select_conv)
  let t999 = @simp.asm_rewrite_tac(@list.empty())
  let t998 = @tactics.match_mp_tac(group_product_mul())
  let t997 = @simp.rewrite_tac(@list.List([group_sum()]))
  let t1002 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t997),
          t998,
        ),
        t999,
      ),
      t1000,
    ),
    t1001,
  )
  group_sum_mul_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!G k f (g:K->A).\n        FINITE {i | i IN k /\\ ~(f i = group_id G)} /\\\n        FINITE {i | i IN k /\\ ~(g i = group_id G)} /\\\n        (!i. i IN k ==> f i IN group_carrier G /\\ g i IN group_carrier G) /\\\n        pairwise (\\i j. group_mul G (f i) (g j) = group_mul G (g j) (f i)) k\n        ==> group_sum G k (\\i. group_mul G (f i) (g i)) =\n            group_mul G (group_sum G k f) (group_sum G k g)",
      ),
      t1002,
    ),
  )
}

