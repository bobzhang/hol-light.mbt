///|
/// `GROUP_MONOMORPHISM`
pub fn group_monomorphism_v1() -> @kernel.Thm {
  group_monomorphism_v1_c.get()
}

///|
/// GROUP_MONOMORPHISM_ALT
fn step_803() -> Unit raise {
  let t5445 = @sets.set_tac(@list.empty())
  let t5444 = @simp.rewrite_tac(@list.List([group_homomorphism()]))
  let t5443 = @tactics.mp_tac(
    @bool.ispec(@parser.parse_term("G:A group"), group_id_v1()),
  )
  let t5442 = @simp.rewrite_tac(
    @list.List([group_monomorphism_v1(), group_kernel()]),
  )
  let t5446 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), t5442),
        t5443,
      ),
      t5444,
    ),
    t5445,
  )
  group_monomorphism_alt_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!G G' (f:A->B).\n        group_monomorphism(G,G') f <=>\n        group_homomorphism(G,G') f /\\\n        !x. x IN group_carrier G /\\ f x = group_id G' ==> x = group_id G",
      ),
      t5446,
    ),
  )
}

