///|
/// GROUP_RULE
fn step_121() -> Unit raise {
  fn group_mem(x364 : @kernel.Term) -> @kernel.Thm raise {
    let tm = x364
    if @basics.is_conj(tm) {
      let t365 = group_mem(@kernel.rand(tm))
      @bool.conj(group_mem(@equal.lhand(tm)), t365)
    } else {
      @drule.part_match(
        fn(x366 : @kernel.Term) -> @kernel.Term raise { x366 },
        group_id_v1(),
      )(tm) catch {
        Failure(_) =>
          try {
            let th = @drule.part_match(@kernel.rand, group_inv_v1())(tm) catch {
              Failure(_) =>
                @drule.part_match(@kernel.rand, group_pow_v1())(tm) catch {
                  Failure(_) =>
                    @drule.part_match(@kernel.rand, group_zpow_v1())(tm) catch {
                      Failure(_) =>
                        @drule.part_match(@kernel.rand, group_mul_v1())(tm) catch {
                          Failure(_) =>
                            @drule.part_match(@kernel.rand, group_div_v1())(tm)
                          e => raise e
                        }
                      e => raise e
                    }
                  e => raise e
                }
              e => raise e
            }
            @bool.mp(th, group_mem(@equal.lhand(@kernel.concl(th))))
          } catch {
            Failure(_) => @kernel.assume_rule(tm)
            e => raise e
          }
        e => raise e
      }
    }
  }
  let group_rewr_conv : (@kernel.Thm) -> ((@kernel.Term) -> @kernel.Thm raise) raise = fn(
    x367 : @kernel.Thm,
  ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    let th_1 = x367
    if !@basics.is_imp(@basics.strip_forall(@kernel.concl(th_1)).1) {
      @simp.rewr_conv(th_1)
    } else {
      let mfn : (@kernel.Term) -> @kernel.Thm raise = @drule.part_match(
        fn(x369 : @kernel.Term) -> @kernel.Term raise {
          @equal.lhand(@kernel.rand(x369))
        },
        th_1,
      )
      fn(x370 : @kernel.Term) -> @kernel.Thm raise {
        let tm_1 = x370
        let ith = mfn(tm_1)
        @bool.mp(ith, group_mem(@equal.lhand(@kernel.concl(ith))))
      }
    }
  }
  let t372 = @simp.simp_tac(
    @list.List([@theorems.imp_conj(), group_neg(), group_inv_v1()]),
  )
  let t373 = (
    @parser.parse_term(
      "!G t t':A.\n            t = t' /\\ t IN group_carrier G\n            ==> group_inv G t = group_neg G t' /\\\n                group_inv G t IN group_carrier G",
    ),
    t372,
  )
  let mfn_inv : (@kernel.Thm) -> @kernel.Thm raise = @drule.match_mp(
    (fn(
      x371 : (
        @kernel.Term,
        ((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> (
          (
            @list.List[@kernel.Term],
            (
              @list.List[(Int, @kernel.Term)],
              @list.List[(@kernel.Term, @kernel.Term)],
              @list.List[(@kernel.HolType, @kernel.HolType)],
            ),
          ),
          @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)],
          (
            (
              @list.List[(Int, @kernel.Term)],
              @list.List[(@kernel.Term, @kernel.Term)],
              @list.List[(@kernel.HolType, @kernel.HolType)],
            ),
            @list.List[@kernel.Thm],
          ) -> @kernel.Thm raise,
        ) raise,
      ),
    ) -> @kernel.Thm raise {
      @tactics.prove(x371.0, x371.1)
    })(t373),
  )
  let t375 = @simp.simp_tac(@list.List([group_neg_v1()]))
  let t376 = (
    @parser.parse_term(
      "!G t t':A.\n            t = t' /\\ t IN group_carrier G\n            ==> group_neg G t = group_neg G t' /\\\n                group_neg G t IN group_carrier G",
    ),
    t375,
  )
  let mfn_neg : (@kernel.Thm) -> @kernel.Thm raise = @drule.match_mp(
