  group_homomorphism_image_preimage_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!G H (f:A->B) t.\n        group_homomorphism(G,H) f\n        ==> IMAGE f {x | x IN group_carrier G /\\ f x IN t} =\n            t INTER (group_image(G,H) f)",
      ),
      t5776,
    ),
  )
}

