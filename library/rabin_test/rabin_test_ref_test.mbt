// Load-fidelity test for Library/rabin_test.ml: replays tools/ocaml_ref/Library_rabin_test_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "Library/rabin_test matches Library/rabin_test.ml" {
  @rabin_test.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "Library/wo", "Library/card", "Library/matroids", "Library/binomial",
      "Library/iter", "Library/prime", "Library/pocklington", "Library/ringtheory",
      "Library/fieldtheory", "Library/rabin_test",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Library/rabin_test")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("RING_DIVIDES_POW_ITERATE", () => {
    sthm(@rabin_test.ring_divides_pow_iterate())
  })
  log.attempt("POLY_NONUNIT_DEGREE_GE_1", () => {
    sthm(@rabin_test.poly_nonunit_degree_ge_1())
  })
  log.attempt("RING_DIVIDES_REDUCE", () => {
    sthm(@rabin_test.ring_divides_reduce())
  })
  log.attempt("FIELD_NONZERO_PRODUCT_PERMUTE", () => {
    sthm(@rabin_test.field_nonzero_product_permute())
  })
  log.attempt("FINITE_FIELD_ELEMENT_POW", () => {
    sthm(@rabin_test.finite_field_element_pow())
  })
  log.attempt("QUOTIENT_POLY_RING_FINITE_CARD", () => {
    sthm(@rabin_test.quotient_poly_ring_finite_card())
  })
  log.attempt("IRREDUCIBLE_DIVIDES_XQ_MINUS_X_GEN", () => {
    sthm(@rabin_test.irreducible_divides_xq_minus_x_gen())
  })
  log.attempt("IRREDUCIBLE_DIVIDES_XQ_MINUS_X", () => {
    sthm(@rabin_test.irreducible_divides_xq_minus_x())
  })
  log.attempt("FINITE_FIELD_POW_ITERATE", () => {
    sthm(@rabin_test.finite_field_pow_iterate())
  })
  log.attempt("RING_ENDOMORPHISM_FROBENIUS_ITERATE", () => {
    sthm(@rabin_test.ring_endomorphism_frobenius_iterate())
  })
  log.attempt("FIELD_ROOTS_BOUND", () => sthm(@rabin_test.field_roots_bound()))
  log.attempt("FINITE_FIELD_CARD_CHAR_POWER", () => {
    sthm(@rabin_test.finite_field_card_char_power())
  })
  log.attempt("IRREDUCIBLE_DIVIDES_DEGREE_BOUND", () => {
    sthm(@rabin_test.irreducible_divides_degree_bound())
  })
  log.attempt("IRREDUCIBLE_DIVIDES_DEGREE", () => {
    sthm(@rabin_test.irreducible_divides_degree())
  })
  log.attempt("RABIN_IRREDUCIBILITY_NECESSARY", () => {
    sthm(@rabin_test.rabin_irreducibility_necessary())
  })
  log.attempt("RABIN_IRREDUCIBILITY_SUFFICIENT", () => {
    sthm(@rabin_test.rabin_irreducibility_sufficient())
  })
  log.attempt("RABIN_IRREDUCIBILITY_TEST", () => {
    sthm(@rabin_test.rabin_irreducibility_test())
  })
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  inspect(
    @testkit.normalize_times(log.contents()),
    content=(
      #|Searching with limit 0
      #|Searching with limit 1
      #|Searching with limit 2
      #|Searching with limit 3
