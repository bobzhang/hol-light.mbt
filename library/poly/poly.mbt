  let lemma05 = @int.arith_rule(
    @parser.parse_term("(y:num) >= z ==> (x + (y - x) >= z) "),
  )
  let t1542 = @bool.gen_all(lemma05)
  let t1540 = @parser.parse_term("SUC (LENGTH (t:(real)list))")
  let t1541 = @parser.parse_term("LENGTH (h ## (CONS h' t'))")
  let lemma06 = @bool.specl(
    @list.List([
      @parser.parse_term("SUC (LENGTH (t ** (CONS (h':real) t')))"),
      t1541,
      t1540,
    ]),
    t1542,
  )
  let lemma07 = @drule.match_mp(lemma06)(lemma03)
  let t1544 = @simp.asm_simp_tac(
    @list.List([
      poly_add_length(),
      @lists.length(),
      lemma07,
      @int.arith_rule(@parser.parse_term("!x y. (MAX x y) = x + (y - x)")),
    ]),
  )
  let t1545 = @list.List([
    @tactics.then_tac(
      @simp.asm_simp_tac(@list.List([poly_cmul_length(), @lists.length()])),
      @int.arith_tac,
    ),
    t1544,
  ])
  let t1543 = @class.asm_cases_tac(@parser.parse_term("(t:(real)list) = []"))
  let t1546 = @tactics.thenl(
    @tactics.then_tac(@simp.simp_tac(@list.List([poly_mul()])), t1543),
    t1545,
  )
  let t1547 = @tactics.thenl(
    @lists.list_induct_tac,
    @list.List([
      @tactics.then_tac(
        @simp.simp_tac(@list.List([poly_mul_clauses()])),
        @int.arith_tac,
      ),
      t1546,
    ]),
  )
  poly_mul_length_c.set(
