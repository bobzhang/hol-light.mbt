    t894,
  )
  order_divides_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!p a n. ([--a; &1] exp n) divides p <=>\n           (poly p = poly []) \\/ n <= order a p",
      ),
      t895,
    ),
  )
}

