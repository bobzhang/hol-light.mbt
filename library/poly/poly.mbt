  let t1515 = @simp.simp_tac(@list.List([lem2, poly_diff_aux_add_lemma()]))
  let t1514 = @simp.once_rewrite_tac(@list.List([lem1, @lists.not_cons_nil()]))
  let t1516 = @tactics.then_tac(
