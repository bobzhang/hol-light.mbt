fn step_82() -> Unit raise {
  let t706 = @simp.asm_rewrite_tac(
    @list.List([
      @class.fun_eq_thm(),
      poly_mul_v1(),
      poly(),
      @analysis.real_mul_rzero(),
    ]),
  )
  let t705 = @tactics.exists_tac(@parser.parse_term("[]:real list"))
  let t704 = @simp.rewrite_tac(@list.List([divides()]))
  let t707 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.repeat_tac(@tactics.gen_tac),
          @tactics.disch_tac,
        ),
        t704,
      ),
      t705,
    ),
    t706,
  )
  poly_divides_zero_c.set(
    @tactics.prove(
      @parser.parse_term("!p q. (poly p = poly []) ==> q divides p"),
      t707,
    ),
  )
}

///|
let poly_divides_zero_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new(
  "POLY_DIVIDES_ZERO",
)

///|
/// `POLY_DIVIDES_ZERO`
pub fn poly_divides_zero() -> @kernel.Thm {
  poly_divides_zero_c.get()
}

