    @list.List([
      @class.fun_eq_thm(),
      @theorems.left_imp_exists_thm(),
      @class.not_forall_thm(),
      poly(),
    ]),
  )
  let t410 = @simp.rewrite_tac(@list.List([poly_roots_finite_lemma()]))
  let t419 = @tactics.then_tac(
    @tactics.then_tac(
