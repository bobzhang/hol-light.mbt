      #|  forall(f:A->B) (g:C->D) f' g' r r' r'' r'''.\n        ring_isomorphisms(prod_ring r r'',prod_ring r' r''')\n                ((\\(x,y). f x,g y),(\\(x,y). f' x,g' y)) <=>\n        ring_isomorphisms(r,r') (f,f') /\\\n        ring_isomorphisms(r'',r''') (g,g')
