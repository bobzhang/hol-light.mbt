      #|  !(r:A ring) p q.\n        integral_domain r /\\\n        ring_polynomial r q /\\\n        ring_divides (poly_ring r (:1)) p (poly_recip r q)\n        ==> ring_divides (poly_ring r (:1)) (poly_recip r p) q
      #|  !(r:A ring) p q.\n    integral_domain r /\\\n    ring_polynomial r p /\\ ring_polynomial r q /\\\n    ~(coeff 0 p = ring_0 r)\n    ==> (ring_divides (poly_ring r (:1)) (poly_recip r p) (poly_recip r q) <=>\n         ring_divides (poly_ring r (:1)) p q)
      #|  poly_recip (r:A ring) e
      #|  poly_recip (r:A ring) d
      #|  e:(1->num)->A
      #|  d:(1->num)->A
      #|  !(r:A ring) p.\n        integral_domain r /\\ ~(coeff 0 p = ring_0 r) /\\\n        ring_prime (poly_ring r (:1)) p\n        ==> ring_prime (poly_ring r (:1)) (poly_recip r p)
      #|  !(r:A ring) p.\n        integral_domain r /\\ ring_polynomial r p /\\ ~(coeff 0 p = ring_0 r)\n        ==> (ring_prime (poly_ring r (:1)) (poly_recip r p) <=>\n             ring_prime (poly_ring r (:1)) p)
      #|  poly_recip (r:A ring) e
      #|  poly_recip (r:A ring) d
      #|  coeff 0 e:A = ring_0 r
      #|  coeff 0 d:A = ring_0 r
      #|  coeff 0:((1->num)->A)->A
      #|  e:(1->num)->A
      #|  d:(1->num)->A
