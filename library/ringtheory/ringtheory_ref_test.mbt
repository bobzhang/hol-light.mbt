      #|  !r a:A. ring_prime r a ==> a IN ring_carrier r
      #|  !r a:A. ring_irreducible r a ==> a IN ring_carrier r
      #|  !r x:A.\n        x IN ring_carrier r\n        ==> (ring_prime r (ring_neg r x) <=> ring_prime r x)
      #|  b:A
      #|  ring_neg r a:A
      #|  b:A
      #|  a:A
      #|  !r x:A.\n        x IN ring_carrier r\n        ==> (ring_irreducible r (ring_neg r x) <=> ring_irreducible r x)
      #|  !r p:A. ring_prime r p ==> ~trivial_ring r
      #|  !r p:A. ring_irreducible r p ==> ~trivial_ring r
      #|  a:A = ring_0 r
      #|  (a:A) IN ring_carrier r
      #|  !r a:A. field r ==> ~(ring_prime r a)
      #|  a:A = ring_0 r
      #|  (a:A) IN ring_carrier r
      #|  !r a:A. field r ==> ~(ring_irreducible r a)
      #|  !r a a':A.\n        ring_associates r a a' ==> (ring_prime r a <=> ring_prime r a')
      #|  x:A
      #|  p:A
      #|  x:A
      #|  !r p q:A.\n        ~(ring_unit r p) /\\\n        ring_irreducible r q /\\\n        ring_divides r p q\n        ==> ring_associates r p q
      #|  !r p q:A.\n        ring_prime r p /\\\n        ring_irreducible r q /\\\n        ring_divides r p q\n        ==> ring_prime r q
      #|  !r p a b:A.\n        ring_prime r p /\\ a IN ring_carrier r /\\ b IN ring_carrier r\n        ==> (ring_divides r p (ring_mul r a b) <=>\n             ring_divides r p a \\/ ring_divides r p b)
      #|  !r p (x:A) n.\n        ring_prime r p /\\ x IN ring_carrier r /\\\n        ring_divides r p (ring_pow r x n)\n        ==> ring_divides r p x
      #|  !r p k (f:K->A).\n        ring_prime r p /\\ FINITE k /\\ (!i. i IN k ==> f i IN ring_carrier r)\n        ==> (ring_divides r p (ring_product r k f) <=>\n             ?i. i IN k /\\ ring_divides r p (f i))
      #|  p:A
      #|  r:A ring
      #|  x:A
      #|  b:A
      #|  a:A
      #|  b:A
      #|  a:A
      #|  !r p:A. integral_domain r /\\ ring_prime r p ==> ring_irreducible r p
      #|  x:A
      #|  r:A ring
      #|  u:A
      #|  ring_unit r (x:A)
      #|  y:A
      #|  x:A
      #|  (p ==> (q <=> q')) ==> (p /\\ q <=> p /\\ q')
      #|  !r a:A.\n        integral_domain r\n        ==> (ring_irreducible r a <=>\n             a IN ring_carrier r /\\\n             ~(a = ring_0 r) /\\\n             ~ring_unit r a /\\\n             !d. ring_divides r d a\n                 ==> ring_unit r d \\/ ring_divides r a d)
      #|  !r a:A.\n        integral_domain r\n        ==> (ring_irreducible r a <=>\n             a IN ring_carrier r /\\\n             ~(a = ring_0 r) /\\\n             ~ring_unit r a /\\\n             !d. ring_divides r d a\n                 ==> ring_unit r d \\/ ring_associates r d a)
      #|  c:A
      #|  b:A
      #|  c:A
      #|  b:A
      #|  !r a:A.\n         integral_domain r\n         ==> (ring_irreducible r a <=>\n              a IN ring_carrier r /\\\n              ~(a = ring_0 r) /\\\n              ~ring_unit r a /\\\n              !b c. b IN ring_carrier r /\\ c IN ring_carrier r /\\\n                    ring_mul r b c = a\n                    ==> ring_divides r a b \\/ ring_divides r a c)
      #|  !r a a':A.\n        integral_domain r /\\ ring_associates r a a'\n        ==> (ring_irreducible r a <=> ring_irreducible r a')
      #|  p:A
      #|  r:A ring
      #|  y:A
      #|  y:A
      #|  x:A
      #|  a:A
      #|  x:A
      #|  !r p a b:A.\n        integral_domain r /\\ ring_prime r p /\\\n        a IN ring_carrier r /\\ b IN ring_carrier r /\\ ~(ring_divides r p a)\n        ==> (ring_divides r a (ring_mul r p b) <=> ring_divides r a b)
      #|  !r p a b:A.\n        integral_domain r /\\ ring_prime r p /\\\n        a IN ring_carrier r /\\ b IN ring_carrier r /\\ ~(ring_divides r p a)\n        ==> (ring_divides r a (ring_mul r b p) <=> ring_divides r a b)
      #|  !r p a:A.\n        ring_irreducible r p /\\ a IN ring_carrier r\n        ==> ring_divides r p a \\/ ring_coprime r (p,a)
      #|  p:A
      #|  (a:A) IN ring_carrier r
      #|  !r p a:A.\n        ring_irreducible r p\n        ==> (ring_coprime r (p,a) <=>\n             a IN ring_carrier r /\\ ~(ring_divides r p a))
      #|  !r p q:A.\n        ring_irreducible r p /\\ ring_irreducible r q\n        ==> ring_coprime r (p,q) \\/ ring_associates r p q
      #|  !r p a:A.\n        integral_domain r /\\ ring_prime r p /\\ a IN ring_carrier r\n        ==> ring_divides r p a \\/ ring_coprime r (p,a)
      #|  !r p a:A.\n        integral_domain r /\\ ring_prime r p\n        ==> (ring_coprime r (p,a) <=>\n             a IN ring_carrier r /\\ ~(ring_divides r p a))
      #|  !r p q:A.\n        integral_domain r /\\ ring_prime r p /\\ ring_prime r q\n        ==> ring_coprime r (p,q) \\/ ring_associates r p q
      #|  !r p q:A.\n        integral_domain r /\\ ring_prime r p /\\ ring_prime r q\n        ==> (ring_divides r p q <=> ring_associates r p q)
      #|  !r r' (f:A->B) a.\n        ring_isomorphism(r,r') f /\\ a IN ring_carrier r\n        ==> (ring_prime r' (f a) <=> ring_prime r a)
      #|  !r r' (f:A->B) a.\n        ring_isomorphism(r,r') f /\\ a IN ring_carrier r\n        ==> (ring_irreducible r' (f a) <=> ring_irreducible r a)
      #|  x'':A
      #|  ring_divides r a (ring_mul r b (x':A))
      #|  ring_divides r a (x':A)
      #|  !r a b x:A.\n        ring_prime r a /\\ ~(ring_divides r a b) /\\\n        ring_divides r a x /\\ ring_divides r b x\n        ==> ring_divides r (ring_mul r a b) x
      #|  !r p q x:A.\n        ring_prime r p /\\ q IN ring_carrier r /\\ ~(ring_divides r p q)\n        ==> (ring_divides r (ring_mul r p q) x <=>\n             ring_divides r p x /\\ ring_divides r q x)
      #|  s:K->bool
      #|  i:K
      #|  (x:A) IN ring_carrier r
      #|  !r p (s:K->bool) x:A.\n        FINITE s /\\\n        x IN ring_carrier r /\\\n        (!i. i IN s ==> ring_prime r (p i)) /\\\n        pairwise (\\i j. ~ring_divides r (p i) (p j)) s\n        ==> (ring_divides r (ring_product r s p) x <=>\n             !i. i IN s ==> ring_divides r (p i) x)
      #|  !r p (s:K->bool) x:A.\n        integral_domain r /\\\n        FINITE s /\\\n        x IN ring_carrier r /\\\n        (!i. i IN s ==> ring_prime r (p i)) /\\\n        pairwise (\\i j. ~ring_associates r (p i) (p j)) s\n        ==> (ring_divides r (ring_product r s p) x <=>\n             !i. i IN s ==> ring_divides r (p i) x)
      #|  t = (j:L) INSERT u
      #|  u = t DELETE (j:L)
      #|  a IN ring_carrier r /\\ b = a ==> ring_divides r a b
      #|  ring_mul r ((g:L->A) j) (ring_product r (t DELETE j) g)
      #|  ring_divides r (ring_mul r (f i) (ring_product r s (f:K->A)))\n                   (ring_mul r (f i) (ring_product r (t DELETE (j:L)) g))
      #|  \\k. if k = i then j else (h:K->L) k
      #|  h:K->L
      #|  ring_associates r ((f:K->A) i) ((g:L->A) j)
      #|  g:L->A
      #|  t DELETE (j:L)
      #|  j:L
      #|  f:K->A
      #|  g:L->A
      #|  t:L->bool
      #|  f:K->A
      #|  s:K->bool
      #|  i:K
      #|  !r s (f:K->A) t (g:L->A).\n        integral_domain r /\\\n        FINITE s /\\ (!i. i IN s ==> ring_prime r (f i)) /\\\n        FINITE t /\\ (!j. j IN t ==> ring_irreducible r (g j)) /\\\n        ring_divides r (ring_product r s f) (ring_product r t g)\n        ==> ?h. IMAGE h s SUBSET t /\\\n                (!i j. i IN s /\\ j IN s /\\ h i = h j ==> i = j) /\\\n                (!i. i IN s ==> ring_associates r (f i) (g(h i)))
      #|  ring_product r (IMAGE (h:K->L) s) (g:L->A)
      #|  h:K->L
      #|  !r s (f:K->A) t (g:L->A).\n        integral_domain r /\\\n        FINITE s /\\ (!i. i IN s ==> ring_prime r (f i)) /\\\n        FINITE t /\\ (!j. j IN t ==> ring_irreducible r (g j))\n        ==> (ring_divides r (ring_product r s f) (ring_product r t g) <=>\n             ?h. IMAGE h s SUBSET t /\\\n                 (!i j. i IN s /\\ j IN s /\\ h i = h j ==> i = j) /\\\n                 (!i. i IN s ==> ring_associates r (f i) (g(h i))))
      #|  CARD(IMAGE (h:K->L) s)
      #|  h:K->L
      #|  !r s (f:K->A) t (g:L->A).\n        integral_domain r /\\\n        FINITE s /\\ (!i. i IN s ==> ring_prime r (f i)) /\\\n        FINITE t /\\ (!j. j IN t ==> ring_irreducible r (g j)) /\\\n        ring_divides r (ring_product r s f) (ring_product r t g)\n        ==> CARD s <= CARD t
      #|  s SUBSET t ==> s UNION (t DIFF s) = t
      #|  DISJOINT s (t DIFF s)
      #|  ring_mul r (ring_product r (IMAGE h s) g)\n               (ring_product r (t DIFF IMAGE (h:K->L) s) g):A
      #|  ring_associates r\n        (ring_product r s (f:K->A))\n        (ring_mul r (ring_product r s f)\n                    (ring_product r (t DIFF IMAGE (h:K->L) s) g))
      #|  s SUBSET t /\\ (~(t DIFF s = {}) ==> F) ==> s = t
      #|  h:K->L
      #|  g:L->A
      #|  t:L->bool
      #|  f:K->A
      #|  s:K->bool
      #|  r:A ring
      #|  !r s (f:K->A) t (g:L->A).\n        integral_domain r /\\\n        FINITE s /\\ (!i. i IN s ==> ring_prime r (f i)) /\\\n        FINITE t /\\ (!j. j IN t ==> ring_irreducible r (g j)) /\\\n        ring_associates r (ring_product r s f) (ring_product r t g)\n        ==> ?h. IMAGE h s = t /\\\n                (!i j. i IN s /\\ j IN s /\\ h i = h j ==> i = j) /\\\n                (!i. i IN s ==> ring_associates r (f i) (g(h i)))
      #|  k:L->K
      #|  h:K->L
      #|  !r s (f:K->A) t (g:L->A).\n        integral_domain r /\\\n        FINITE s /\\ (!i. i IN s ==> ring_prime r (f i)) /\\\n        FINITE t /\\ (!j. j IN t ==> ring_irreducible r (g j)) /\\\n        ring_associates r (ring_product r s f) (ring_product r t g)\n        ==> ?h k. IMAGE h s = t /\\ IMAGE k t = s /\\\n                  (!i. i IN s ==> k(h i) = i) /\\\n                  (!j. j IN t ==> h(k j) = j) /\\\n                  (!i. i IN s ==> ring_associates r (f i) (g(h i))) /\\\n                  (!j. j IN t ==> ring_associates r (g j) (f(k j)))
      #|  IMAGE (h:K->L) s = t
      #|  !r s (f:K->A) t (g:L->A).\n        integral_domain r /\\\n        FINITE s /\\ (!i. i IN s ==> ring_prime r (f i)) /\\\n        FINITE t /\\ (!j. j IN t ==> ring_irreducible r (g j))\n        ==> (ring_associates r (ring_product r s f) (ring_product r t g) <=>\n             ?h k. IMAGE h s = t /\\ IMAGE k t = s /\\\n                   (!i. i IN s ==> k(h i) = i) /\\\n                   (!j. j IN t ==> h(k j) = j) /\\\n                   (!i. i IN s ==> ring_associates r (f i) (g(h i))) /\\\n                   (!j. j IN t ==> ring_associates r (g j) (f(k j))))
      #|  !r s (f:K->A) t (g:L->A).\n        integral_domain r /\\\n        FINITE s /\\ (!i. i IN s ==> ring_prime r (f i)) /\\\n        FINITE t /\\ (!j. j IN t ==> ring_irreducible r (g j))\n        ==> (ring_associates r (ring_product r s f) (ring_product r t g) <=>\n             ?h. IMAGE h s = t /\\\n                 (!i j. i IN s /\\ j IN s /\\ h i = h j ==> i = j) /\\\n                 (!i. i IN s ==> ring_associates r (f i) (g(h i))))
      #|  !r s (f:K->A) t (g:L->A).\n        integral_domain r /\\\n        FINITE s /\\ (!i. i IN s ==> ring_prime r (f i)) /\\\n        FINITE t /\\ (!j. j IN t ==> ring_irreducible r (g j)) /\\\n        ring_associates r (ring_product r s f) (ring_product r t g)\n        ==> CARD s = CARD t
      #|  CARD(IMAGE (h:K->L) s)
      #|  h:K->L
      #|  (?x. P x) /\\ ~(?x. Q x) ==> ?x. P x /\\ ~Q x
      #|  ring_divides r x y /\\ ~(ring_divides r y x) <=>\n    ring_divides r x y /\\ ~(ring_associates r x y)
      #|  !r s (f:K->A) t (g:L->A).\n        integral_domain r /\\\n        FINITE s /\\ (!i. i IN s ==> ring_prime r (f i)) /\\\n        FINITE t /\\ (!j. j IN t ==> ring_irreducible r (g j)) /\\\n        ring_divides r (ring_product r s f) (ring_product r t g) /\\\n        ~(ring_divides r (ring_product r t g) (ring_product r s f))\n        ==> CARD s < CARD t
      #|  ring_squarefree (r:A ring) (a:A) <=>\n  a IN ring_carrier r /\\\n  !q. q IN ring_carrier r /\\ ring_divides r (ring_pow r q 2) a\n      ==> ring_unit r q
      #|  !r (a:A). ring_squarefree r a ==> a IN ring_carrier r
      #|  ~(2 = 0)
      #|  ring_pow r (q:A) 2
      #|  a:A
      #|  r:A ring
      #|  !r (a:A). ring_unit r a ==> ring_squarefree r a
      #|  !r:A ring. ring_squarefree r (ring_1 r)
      #|  !r d (a:A).\n        ring_squarefree r a /\\ ring_divides r d a\n        ==> ring_squarefree r d
      #|  !r a (b:A).\n        ring_associates r a b\n        ==> (ring_squarefree r a <=> ring_squarefree r b)
      #|  !r:A ring. ring_squarefree r (ring_0 r) <=> trivial_ring r
      #|  !r (a:A). ~trivial_ring r /\\ ring_squarefree r a ==> ~(a = ring_0 r)
      #|  ring_mul r (q:A) e
      #|  q:A
      #|  e:A
      #|  ring_divides r (ring_pow r (q:A) 2) a
      #|  q:A
      #|  !r (a:A). ring_irreducible r a ==> ring_squarefree r a
      #|  !r (a:A). integral_domain r /\\ ring_prime r a ==> ring_squarefree r a
      #|  !r a p:A.\n        ring_squarefree r a /\\ ring_prime r p\n        ==> ~ring_divides r (ring_pow r p 2) a
      #|  ring_mul r (q:A) x
      #|  q:A
      #|  ring_divides r (ring_pow r (q:A) 2) a
      #|  q:A
      #|  !r (a:A).\n     ring_squarefree r a <=>\n     a IN ring_carrier r /\\\n     !b c. b IN ring_carrier r /\\ c IN ring_carrier r /\\ ring_mul r b c = a\n           ==> ring_coprime r (b,c)
      #|  !r (a:A).\n     ring_squarefree r a <=>\n     a IN ring_carrier r /\\\n     !b c. b IN ring_carrier r /\\ c IN ring_carrier r /\\\n           ring_divides r (ring_mul r b c) a\n           ==> ring_coprime r (b,c)
      #|  !r a (b:A).\n        a IN ring_carrier r /\\ b IN ring_carrier r /\\\n        ring_squarefree r (ring_mul r a b)\n        ==> ring_coprime r (a,b) /\\\n            ring_squarefree r a /\\ ring_squarefree r b
      #|  k = 2 + (k - 2)
      #|  a:A
      #|  k = 1
      #|  k = 0
      #|  ring_unit r (a:A)
      #|  !r (a:A) k.\n        a IN ring_carrier r\n        ==> (ring_squarefree r (ring_pow r a k) <=>\n             ring_unit r a \\/ k = 0 \\/ ring_squarefree r a /\\ k = 1)
      #|  ring_multsys (r:A ring) s <=>\n        s SUBSET ring_carrier r /\\\n        ring_1 r IN s /\\\n        (!x y. x IN s /\\ y IN s ==> ring_mul r x y IN s)
      #|  (!r s x:A. ring_multsys r s /\\ x IN s ==> x IN ring_carrier r) /\\\n   (!r s:A->bool. ring_multsys r s ==> ring_1 r IN s) /\\\n   (!r s x y:A. ring_multsys r s /\\ x IN s /\\ y IN s\n                ==> ring_mul r x y IN s)
      #|  !r s:A->bool. ring_multsys r s ==> s SUBSET ring_carrier r
      #|  !r s:A->bool. ring_multsys r s ==> ~(s = {})
      #|  !r:A ring. ring_multsys r {ring_1 r}
      #|  !r:A ring. ring_multsys r (ring_carrier r)
      #|  !r:A ring.\n        ring_multsys r {a | ring_regular r a}
      #|  !r:A ring.\n        ring_multsys r (ring_carrier r DIFF {ring_0 r}) <=>\n        integral_domain r
      #|  !r x:A. x IN ring_carrier r\n           ==> ring_multsys r {ring_pow r x n | n IN (:num)}
      #|  !r:A ring. ring_multsys r {u | ring_unit r u}
      #|  !r x:A.\n        x IN ring_carrier r /\\ ring_mul r x x = x\n        ==> ring_multsys r {ring_1 r,x}
      #|  !r gs.\n         (!g. g IN gs ==> ring_multsys r g) /\\ ~(gs = {})\n         ==> ring_multsys r (INTERS gs)
      #|  !r s t:A->bool.\n        ring_multsys r s /\\ ring_multsys r t ==> ring_multsys r (s INTER t)
      #|  !r s (x:A) n.\n        ring_multsys r s /\\ x IN s ==> ring_pow r x n IN s
      #|  n:num
      #|  x:A
      #|  !r s:A->bool.\n        ring_multsys r s\n        ==> ((?x. ring_nilpotent r x /\\ x IN s) <=> ring_0 r IN s)
      #|  ring_localequiv r s (a,b) (a',b') <=>\n        a IN ring_carrier r /\\ a' IN ring_carrier r /\\ b IN s /\\ b' IN s /\\\n        ?u. u IN s /\\\n            ring_mul r u (ring_sub r (ring_mul r a b') (ring_mul r a' b)) =\n            ring_0 r
      #|  !r s a b a' b':A.\n      ring_multsys r s\n      ==> (ring_localequiv r s (a,b) (a',b') <=>\n           a IN ring_carrier r /\\ a' IN ring_carrier r /\\\n           b IN ring_carrier r /\\ b' IN ring_carrier r /\\\n           b IN s /\\ b' IN s /\\\n           ?u. u IN s /\\\n               ring_mul r u (ring_sub r (ring_mul r a b') (ring_mul r a' b)) =\n               ring_0 r)
      #|  (b:A) IN s
      #|  (a:A) IN ring_carrier r
      #|  !r s a b:A.\n        ring_multsys r s\n        ==> (ring_localequiv r s (a,b) (a,b) <=>\n             a IN ring_carrier r /\\ b IN s)
      #|  u:A
      #|  !r s a b a' b':A.\n        ring_multsys r s\n        ==> (ring_localequiv r s (a,b) (a',b') <=>\n             ring_localequiv r s (a',b') (a,b))
      #|  ring_mul r b' (ring_mul r u v):A
      #|  v:A
      #|  u:A
      #|  !r s a b a' b' a'' b'':A.\n        ring_multsys r s /\\\n        ring_localequiv r s (a,b) (a',b') /\\\n        ring_localequiv r s (a',b') (a'',b'')\n        ==> ring_localequiv r s (a,b) (a'',b'')
      #|  !r s a b a' b'.\n        ring_multsys r s /\\\n        a IN ring_carrier r /\\ a' IN ring_carrier r /\\ b IN s /\\ b' IN s\n        ==> (ring_localequiv r s (a,b) (a',b') <=>\n             ring_localequiv r s (a,b) = ring_localequiv r s (a',b'))
      #|  u:A
      #|  u:A
      #|  !r s a b a' b':A.\n        ring_multsys r s /\\\n        ring_localequiv r s (a,b) (a',b')\n        ==> ring_localequiv r s (ring_neg r a,b) (ring_neg r a',b')
      #|  ring_mul r u v:A
      #|  v:A
      #|  u:A
      #|  !r s a1 b1 a1' b1' a2 b2 a2' b2':A.\n        ring_multsys r s /\\\n        ring_localequiv r s (a1,b1) (a1',b1') /\\\n        ring_localequiv r s (a2,b2) (a2',b2')\n        ==> ring_localequiv r s\n             (ring_add r (ring_mul r a1 b2) (ring_mul r a2 b1),\n              ring_mul r b1 b2)\n             (ring_add r (ring_mul r a1' b2') (ring_mul r a2' b1'),\n              ring_mul r b1' b2')
      #|  ring_mul r u v:A
      #|  v:A
      #|  u:A
      #|  !r s a1 b1 a1' b1' a2 b2 a2' b2':A.\n        ring_multsys r s /\\\n        ring_localequiv r s (a1,b1) (a1',b1') /\\\n        ring_localequiv r s (a2,b2) (a2',b2')\n        ==> ring_localequiv r s\n             (ring_mul r a1 a2,ring_mul r b1 b2)\n             (ring_mul r a1' a2',ring_mul r b1' b2')
      #|  ring_localization (r:A ring) s =\n        ring({ring_localequiv r s (a,b) |a,b| a IN ring_carrier r /\\ b IN s},\n             ring_localequiv r s (ring_0 r,ring_1 r),\n             ring_localequiv r s (ring_1 r,ring_1 r),\n             (@f. !a b. a IN ring_carrier r /\\ b IN s\n                      ==> f (ring_localequiv r s (a,b)) =\n                          ring_localequiv r s (ring_neg r a,b)),\n             (@f. !a1 b1 a2 b2.\n                        a1 IN ring_carrier r /\\ b1 IN s /\\\n                        a2 IN ring_carrier r /\\ b2 IN s\n                        ==> f (ring_localequiv r s (a1,b1))\n                              (ring_localequiv r s (a2,b2)) =\n                            ring_localequiv r s\n                             (ring_add r (ring_mul r a1 b2) (ring_mul r a2 b1),\n                              ring_mul r b1 b2)),\n             (@f. !a1 b1 a2 b2.\n                        a1 IN ring_carrier r /\\ b1 IN s /\\\n                        a2 IN ring_carrier r /\\ b2 IN s\n                        ==> f (ring_localequiv r s (a1,b1))\n                              (ring_localequiv r s (a2,b2)) =\n                            ring_localequiv r s\n                              (ring_mul r a1 a2,ring_mul r b1 b2)))
      #|  (!x y. P x y ==> g (r x) (r y) = r (f x y)) <=>\n      (!w z x y. P x y /\\ r x = w /\\ r y = z ==> g w z = r (f x y))
