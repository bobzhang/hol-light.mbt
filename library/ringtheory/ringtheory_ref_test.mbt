      #|  r:A ring
      #|  ring_homomorphism (r,r') (f:A->B)
      #|  !r r' (f:A->B).\n      ring_isomorphism (r,r') f <=>\n      IMAGE f (ring_carrier r) = ring_carrier r' /\\\n      f (ring_1 r) = ring_1 r' /\\\n      (!x y. x IN ring_carrier r /\\ y IN ring_carrier r\n             ==> f(ring_add r x y) = ring_add r' (f x) (f y)) /\\\n      (!x y. x IN ring_carrier r /\\ y IN ring_carrier r\n             ==> f(ring_mul r x y) = ring_mul r' (f x) (f y)) /\\\n      (!x. x IN ring_carrier r /\\ f x = ring_0 r' ==> x = ring_0 r)
      #|  ring_add r (ring_neg r x:A)
