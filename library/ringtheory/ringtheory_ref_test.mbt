      #|  !k (r:K->A ring) x.\n        ring_nilpotent (product_ring k r) x <=>\n        EXTENSIONAL k x /\\\n        (!i. i IN k ==> ring_nilpotent (r i) (x i)) /\\\n        (?n. ~(n = 0) /\\ !i. i IN k ==> ring_pow (r i) (x i) n = ring_0(r i))
