      #|  !r k:A->bool.\n        FINITE k /\\ k SUBSET ring_carrier r\n        ==> ideal_generated r k =\n            { ring_sum r k (\\i. ring_mul r (c i) i) | c |\n              !i. i IN k ==> c i IN ring_carrier r }
