      #|  !(f:A->B) k l (s:V->bool) a.\n        ring_homomorphism(k,l) f /\\\n        (!i. i IN s ==> a i IN ring_carrier l)\n        ==> IMAGE (poly_extend(k,l) f a) (ring_carrier(poly_ring k s)) =\n            ring_carrier\n             (subring_generated l (IMAGE a s UNION IMAGE f (ring_carrier k)))
