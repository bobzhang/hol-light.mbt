      #|  IMAGE (f:A->B) j
      #|  !r r' (f:A->B) j.\n        ring_epimorphism(r,r') f\n        ==> (ring_ideal r j /\\ ring_kernel(r,r') f SUBSET j <=>\n             ?k. ring_ideal r' k /\\\n                 {x | x IN ring_carrier r /\\ f x IN k} = j /\\\n                 IMAGE f j = k)
      #|  k:B->bool
