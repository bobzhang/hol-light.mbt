      #|  p:(V->num)->A
      #|  poly_add r p q:(V->num)->A
      #|  r:A ring
      #|  q:(V->num)->A
      #|  p:(V->num)->A
      #|  r:A ring
      #|  !r (p:(V->num)->A) q.\n        ring_polynomial r p /\\ ring_polynomial r q /\\\n        ~(poly_deg r p = poly_deg r q)\n        ==> poly_deg r (poly_add r p q) = MAX (poly_deg r p) (poly_deg r q)
      #|  !r (p:(V->num)->A) q.\n        ring_polynomial r p /\\ ring_polynomial r q /\\\n        ~(poly_deg r p = poly_deg r q)\n        ==> poly_deg r (poly_sub r p q) = MAX (poly_deg r p) (poly_deg r q)
      #|  (p:(V->num)->A) m1 IN ring_carrier r /\\\n    (q:(V->num)->A) m2 IN ring_carrier r /\\\n    ~(p m1 = ring_0 r) /\\ ~(q m2 = ring_0 r)
      #|  m2:V->num
      #|  m1:V->num
      #|  ~(p /\\ q ==> r) <=> p /\\ q /\\ ~r
      #|  m:V->num
      #|  !r (p:(V->num)->A) q.\n        ring_polynomial r p /\\ ring_polynomial r q\n        ==> poly_deg r (poly_mul r p q) <= poly_deg r p + poly_deg r q
      #|  !(r:A ring) (p:(V->num)->A) n.\n        ring_polynomial r p\n        ==> poly_deg r (poly_pow r p n) <= n * poly_deg r p
      #|  l:V->V->bool
      #|  !l. monomial_lt l m n ==> ~(m = n)
      #|  n2:V->num = m2
      #|  n1:V->num = m1
      #|  x + y:num = m + n ==> x <= m /\\ y <= n ==> x = m /\\ y = n
      #|  (monomial_deg m = monomial_deg m' ==> ~p ==> ~(m = m'))\n    ==> m = m' ==> p
