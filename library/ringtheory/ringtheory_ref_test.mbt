      #|  !(r:A ring) (s:V->bool) n.\n        ring_of_num (powser_ring r s) n = poly_const r (ring_of_num r n)
      #|  !(r:A ring) (s:V->bool) n.\n        ring_of_num (poly_ring r s) n = poly_const r (ring_of_num r n)
