      #|  (if p then q else T) <=> p ==> q
      #|  !r c. poly_deg r (poly_const r c:(V->num)->A) = 0
      #|  !r. poly_deg r (poly_0 r:(V->num)->A) = 0
      #|  !r. poly_deg r (poly_1 r:(V->num)->A) = 0
      #|  monomial_deg:(V->num)->num
      #|  !r (p:(V->num)->A) n.\n        ring_polynomial r p\n        ==> (poly_deg r p <= n <=>\n             !m. ~(p m = ring_0 r) ==> monomial_deg m <= n)
      #|  !r (p:(V->num)->A) n.\n        ring_polynomial r p /\\\n        (!m. ~(p m = ring_0 r) ==> monomial_deg m <= n)\n        ==> poly_deg r p <= n
      #|  !r (p:(V->num)->A) m.\n        ring_polynomial r p /\\ ~(p m = ring_0 r)\n        ==> monomial_deg m <= poly_deg r p
      #|  n = 0
      #|  n <= x <=> n = 0 \\/ ~(x <= n - 1)
      #|  !r (p:(V->num)->A) n.\n        ring_polynomial r p\n        ==> (n <= poly_deg r p <=>\n             n = 0 \\/ ?m. ~(p m = ring_0 r) /\\ n <= monomial_deg m)
      #|  !r (p:(V->num)->A) m n.\n        ring_polynomial r p /\\\n        ~(p m = ring_0 r) /\\ n <= monomial_deg m\n        ==> n <= poly_deg r p
      #|  (\\v:1. d):(1->num)
      #|  poly_deg r (p:(1->num)->A)
      #|  p:(1->num)->A
      #|  r:A ring
      #|  !r (p:(1->num)->A) d.\n     ring_polynomial r p /\\ poly_deg r p < d\n     ==> coeff d p = ring_0 r
      #|  poly_deg r (p:(V->num)->A) = 0
      #|  (!m. Q m ==> monomial_deg m <= n) /\\ ~(!m. Q m ==> monomial_deg m < n)\n    ==> ?m. Q m /\\ monomial_deg m = n
      #|  !r (p:(V->num)->A).\n        ring_polynomial r p /\\ ~(p = poly_0 r)\n        ==> ?m. ~(p m = ring_0 r) /\\ monomial_deg m = poly_deg r p
      #|  p:(V->num)->A
      #|  r:A ring
      #|  ~(p m = ring_0 r) /\\ monomial_deg m = d <=>\n    m IN {m | ~(p m = ring_0 r) /\\ monomial_deg m = d}
      #|  !(<<=) r (p:(V->num)->A).\n        toset(<<=) /\\ fld(<<=) = (:V) /\\\n        ring_polynomial r p /\\ ~(p = poly_0 r)\n        ==> ?m. ~(p m = ring_0 r) /\\ monomial_deg m = poly_deg r p /\\\n                !m'. ~(p m' = ring_0 r) /\\ monomial_deg m' = poly_deg r p\n                     ==> monomial_le(<<=) m' m
      #|  !(<<=) r (p:(V->num)->A).\n        toset(<<=) /\\ fld(<<=) = (:V) /\\\n        ring_polynomial r p /\\ ~(p = poly_0 r)\n        ==> ?m. ~(p m = ring_0 r) /\\ monomial_deg m = poly_deg r p /\\\n                !m'. ~(p m' = ring_0 r) /\\ monomial_deg m' = poly_deg r p /\\\n                     ~(m' = m)\n                     ==> monomial_lt(<<=) m' m
      #|  !r (p:(V->num)->A).\n      ring_polynomial r p\n      ==> (poly_deg r p = 0 <=> p = poly_const r (p monomial_1))
      #|  (p:(V->num)->A) monomial_1
      #|  !r (p:(V->num)->A).\n      ring_polynomial r p\n      ==> (poly_deg r p = 0 <=>\n           ?c. c IN ring_carrier r /\\ p = poly_const r c)
      #|  !r (p:(V->num)->A) n.\n        ring_polynomial r p\n        ==> (poly_deg r p = n <=>\n             (!m. ~(p m = ring_0 r) ==> monomial_deg m <= n) /\\\n             (n = 0 \\/ ?m. ~(p m = ring_0 r) /\\ monomial_deg m = n))
      #|  !r (p:(V->num)->A) n.\n        ring_polynomial r p /\\\n        (!m. ~(p m = ring_0 r) ==> monomial_deg m <= n) /\\\n        (n = 0 \\/ ?m. ~(p m = ring_0 r) /\\ monomial_deg m = n)\n        ==> poly_deg r p = n
      #|  !r. poly_deg r (poly_var r v:(V->num)->A) =\n       if ring_1 r = ring_0 r then 0 else 1
      #|  ~(coeff d (p:(1->num)->A) = ring_0 r)
      #|  monomial_deg (\\v:1. d) <= poly_deg r (p:(1->num)->A)
      #|  !r (p:(1->num)->A) d.\n        ring_polynomial r p /\\ ~(coeff d p = ring_0 r)\n        ==> d <= poly_deg r p
      #|  !r (p:(1->num)->A) n d.\n        ring_polynomial r p /\\ poly_deg r p <= n /\\\n        ~(coeff d p = ring_0 r)\n        ==> d <= n
      #|  !r (p:(1->num)->A) n.\n        ring_polynomial r p\n        ==> (poly_deg r p <= n <=>\n             !d. ~(coeff d p = ring_0 r) ==> d <= n)
      #|  n:num
