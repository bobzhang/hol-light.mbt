      #|  !r P:A->bool.\n        (noetherian_ring r \\/ UFD r) /\\\n        (!a. a IN ring_carrier r /\\\n             (!d. ring_divides r d a /\\ ~(ring_divides r a d) ==> P d)\n             ==> P a)\n        ==> !a. a IN ring_carrier r ==> P a
