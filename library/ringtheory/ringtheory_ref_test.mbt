      #|  FINITE s <=> ~INFINITE s
      #|  !(r:K->A ring) k.\n        noetherian_ring(product_ring k r) <=>\n        FINITE {i | i IN k /\\ ~trivial_ring(r i)} /\\\n        !i. i IN k ==> noetherian_ring (r i)
