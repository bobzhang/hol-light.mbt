      #|  r:A ring
      #|  !r r' (f:A->B).\n        ring_monomorphism(r,r') f <=>\n        ring_homomorphism(r,r') f /\\\n        !x. x IN ring_carrier r /\\ f x = ring_0 r' ==> x = ring_0 r
      #|  !r r' f:A->B.\n        ring_monomorphism (r,r') f <=>\n        ring_homomorphism (r,r') f /\\\n        !x. x IN ring_carrier r ==> (f x = ring_0 r' <=> x = ring_0 r)
