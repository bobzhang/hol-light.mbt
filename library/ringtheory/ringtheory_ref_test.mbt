      #|  forall(r:A ring) (r':B ring).\n         r isomorphic_ring r' ==> (integral_domain r <=> integral_domain r')
      #|  forall r r' (f:A->B).\n        ring_monomorphism(r,r') f /\\ integral_domain r' ==> integral_domain r
