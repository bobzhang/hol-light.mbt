      #|  !r r' f:A->B. ring_isomorphism (r,r') f ==> r isomorphic_ring r'
      #|  \\x:A. x
      #|  !r:A ring. r isomorphic_ring r
      #|  !r r':A ring. r = r' ==> r isomorphic_ring r'
      #|  !(r:A ring) (r':B ring). r isomorphic_ring r' <=> r' isomorphic_ring r
      #|  !(r1:A ring) (r2:B ring) (r3:C ring).\n        r1 isomorphic_ring r2 /\\ r2 isomorphic_ring r3\n        ==> r1 isomorphic_ring r3
      #|  !(r:A ring) (r':B ring).\n        r isomorphic_ring r' ==> (trivial_ring r <=> trivial_ring r')
      #|  (\\x. b):A->B
