      #|  s:V->bool
      #|  trivial_ring(r:A ring)
      #|  s:V->bool
      #|  x:V
      #|  s:V->bool
      #|  s:V->bool
      #|  FINITE(s:V->bool)
      #|  FINITE(s:V->bool)
      #|  !(r:A ring) (s:V->bool).\n      noetherian_ring (powser_ring r s) <=>\n      noetherian_ring r /\\ (FINITE s \\/ trivial_ring r)
      #|  monic (r:A ring) (p:(1->num)->A) <=> coeff (poly_deg r p) p = ring_1 r
      #|  !r:A ring. monic r (poly_1 r)
      #|  !r:A ring. monic r (poly_0 r) <=> trivial_ring r
      #|  !r:A ring p.\n     ring_polynomial r p /\\ monic r p /\\ ~trivial_ring r\n     ==> ~(p = poly_0 r)
      #|  !r:A ring p.\n        ring_powerseries r p /\\ trivial_ring r ==> monic r p
      #|  !r c:A. monic r (poly_const r c) <=> c = ring_1 r
      #|  !r:A ring p.\n     ring_polynomial r p /\\ monic r p /\\ poly_deg r p = 0\n     ==> p = poly_1 r
      #|  !r:A ring. monic r (poly_var r one)
      #|  !r:A ring s p. monic (subring_generated r s) p <=> monic r p
      #|  trivial_ring(r:A ring)
      #|  !r (p:(1->num)->A) q.\n     ring_polynomial r p /\\ ring_polynomial r q /\\\n     monic r p /\\ monic r q\n     ==> poly_deg r (poly_mul r p q) = poly_deg r p + poly_deg r q
      #|  monic (r:A ring) (q:(1->num)->A)
      #|  monic (r:A ring) (p:(1->num)->A)
      #|  !r p q:(1->num)->A.\n     ring_polynomial r p /\\ ring_polynomial r q /\\ monic r p /\\ monic r q\n     ==> monic r (poly_mul r p q)
      #|  !r (p:(1->num)->A) n.\n     ring_polynomial r p /\\ monic r p ==> monic r (poly_pow r p n)
      #|  (f:K->(1->num)->A) x IN ring_carrier(poly_ring r (:1))
      #|  t:K->bool
      #|  x:K
      #|  !r (f:K->(1->num)->A) s.\n     FINITE s /\\\n     (!i. i IN s ==> ring_polynomial r (f i)) /\\\n     (!i. i IN s ==> monic r (f i))\n     ==> monic r (ring_product (poly_ring r (:1)) s f)
      #|  ~(p:(1->num)->A = poly_0 r)
      #|  (c:A) IN ring_carrier r /\\ ~(c = ring_0 r)
      #|  monic r (q:(1->num)->A)
      #|  c:A
      #|  u:(1->num)->A
      #|  q:(1->num)->A
      #|  p:(1->num)->A
      #|  poly_ring (r:A ring) (:1)
      #|  ring_polynomial r (p:(1->num)->A) /\\ ring_polynomial r (q:(1->num)->A)
      #|  !r p q:(1->num)->A.\n        integral_domain r /\\\n        monic r p /\\ monic r q /\\ ring_associates (poly_ring r (:1)) p q\n        ==> p = q
      #|  p:(1->num)->A = poly_0 r
      #|  !r (p:(1->num)->A).\n     integral_domain r /\\\n     ring_polynomial r p /\\\n     ring_unit r (coeff (poly_deg r p) p)\n     ==> monic r (poly_mul r\n                    (poly_const r (ring_inv r (coeff (poly_deg r p) p))) p)
      #|  poly_mul f (poly_const f c_inv) (p:(1->num)->A)
      #|  (c_inv:A) IN ring_carrier f
      #|  c_inv = ring_inv (f:A ring) (coeff (poly_deg f p) p)
      #|  ring_unit (f:A ring) (coeff (poly_deg f p) p)
      #|  ~(coeff (poly_deg (f:A ring) p) p = ring_0 f)
      #|  coeff (poly_deg (f:A ring) p) p IN ring_carrier f
      #|  integral_domain (f:A ring)
      #|  !f (p:(1->num)->A).\n     field f /\\ ring_polynomial f p /\\ ~(p = poly_0 f)\n     ==> ?q. ring_polynomial f q /\\\n             monic f q /\\\n             ring_associates (poly_ring f (:1)) p q /\\\n             poly_deg f q = poly_deg f p
      #|  p:(1->num)->A
      #|  f:A ring
      #|  ring_polynomial (f:A ring) (p:(1->num)->A) /\\\n                ~(p = poly_0 f)
      #|  !f (p:(1->num)->A).\n     field f /\\ ring_irreducible (poly_ring f (:1)) p\n     ==> ?q. ring_polynomial f q /\\\n             monic f q /\\\n             ring_irreducible (poly_ring f (:1)) q /\\\n             ring_associates (poly_ring f (:1)) p q /\\\n             poly_deg f q = poly_deg f p
      #|  !r (p:(1->num)->A) q.\n     integral_domain r /\\\n     monic r p /\\ monic r q /\\\n     ring_irreducible (poly_ring r (:1)) p /\\\n     ring_irreducible (poly_ring r (:1)) q /\\\n     ~(p = q)\n     ==> ring_coprime (poly_ring r (:1)) (p, q)
      #|  !(r:A ring) p q.\n        ring_divides (poly_ring r (:1)) p q /\\\n        monic r p /\\\n        ~(q = poly_0 r)\n        ==> poly_deg r p <= poly_deg r q
      #|  poly_recip (r:A ring) p =\n        \\m. if m one <= poly_deg r p then p(\\v:1. poly_deg r p - m one)\n            else ring_0 r
      #|  !(r:A ring) p i.\n        coeff i (poly_recip r p) =\n        if i <= poly_deg r p then coeff (poly_deg r p - i) p else ring_0 r
      #|  !(r:A ring) p.\n        ring_powerseries r p ==> ring_powerseries r (poly_recip r p)
      #|  poly_deg r (p:(1->num)->A)
      #|  !(r:A ring) p. ring_polynomial r p ==> ring_polynomial r (poly_recip r p)
      #|  !(r:A ring) p.\n        p IN ring_carrier(poly_ring r (:1))\n        ==> poly_recip r p IN ring_carrier(poly_ring r (:1))
      #|  !(r:A ring) p.\n        ring_polynomial r p\n        ==> (coeff 0 (poly_recip r p) = ring_0 r <=> p = poly_0 r)
      #|  !(r:A ring) p.\n        ring_polynomial r p\n        ==> poly_deg r (poly_recip r p) <= poly_deg r p
      #|  !(r:A ring) p.\n        ring_polynomial r p /\\ ~(coeff 0 p = ring_0 r)\n        ==> poly_deg r (poly_recip r p) = poly_deg r p
      #|  p - d:num <= p
      #|  d:num <= p ==> p - (p - d) = d
      #|  !(r:A ring) p.\n        ring_polynomial r p /\\ ~(coeff 0 p = ring_0 r)\n        ==> poly_recip r (poly_recip r p) = p
      #|  n - m:num <= n
      #|  poly_deg r (p:(1->num)->A) - d
      #|  poly_recip (r:A ring) p
      #|  r:A ring
