      #|  forall r r' (f:A->B) s.\n        ring_epimorphism(r,r') f /\\ s SUBSET ring_carrier r\n        ==> ideal_generated r' (IMAGE f s) = IMAGE f (ideal_generated r s)
      #|  forall r r' f:A->B.\n        ring_monomorphism (r,r') f /\\ ring_epimorphism (r,r') f <=>\n        ring_isomorphism (r,r') f
