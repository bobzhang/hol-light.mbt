      #|  !(r:K->A ring) k t.\n        FINITE {i | i IN k /\\ ~trivial_ring(r i)}\n        ==> (ring_ideal (product_ring k r) t <=>\n             ?j. (!i. i IN k ==> ring_ideal (r i) (j i)) /\\\n                 cartesian_product k j = t)
      #|  i:K
