      #|  \\((f:K->A),g) x. if x IN k then f x else g x
      #|  \\(f:K->A). RESTRICTION k f,RESTRICTION l f
      #|  !(f:K->A ring) k l.\n        DISJOINT k l\n        ==> product_ring (k UNION l) f isomorphic_ring\n            prod_ring (product_ring k f) (product_ring l f)
      #|  !(r:K->A ring) k. product_ring {k} r isomorphic_ring r k
