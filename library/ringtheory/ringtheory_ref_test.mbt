      #|  !(r:A ring) (p:(1->num)->A) n.\n        ring_powerseries r p\n        ==> poly_deriv r (poly_pow r p n) =\n            poly_mul r (poly_const r (ring_of_num r n))\n                       (poly_mul r (poly_deriv r p) (poly_pow r p (n - 1)))
      #|  n:num
      #|  poly_var (r:A ring) (one:1)
      #|  r:A ring
      #|  !(r:A ring) n.\n    poly_deriv r (poly_pow r (poly_var r one) n) =\n    ring_mul (poly_ring r (:1))\n      (poly_const r (ring_of_num r n))\n      (poly_pow r (poly_var r one) (n - 1))
      #|  (:1)
      #|  d <= d' /\\ ~(d = 0) ==> d' <= d - 1 ==> F
      #|  p:(1->num)->A
      #|  r:A ring
      #|  ~p ==> p \\/ q ==> q
      #|  !(r:A ring) p.\n    integral_domain r /\\ ring_char r = 0 /\\\n    ring_irreducible(poly_ring r (:1)) p /\\ ~(poly_deg r p = 0)\n    ==> ring_coprime(poly_ring r (:1)) (p, poly_deriv r p)
      #|  !(k:A ring) p.\n        field k /\\ ring_char k = 0 /\\\n        ring_irreducible(poly_ring k (:1)) p\n        ==> ring_coprime(poly_ring k (:1)) (p, poly_deriv k p)
      #|  R = poly_ring (r:A ring) (:1)
      #|  poly_add r (poly_mul r (poly_const r (ring_of_num r 2:A))\n                           (poly_mul r (poly_deriv r p) q))\n               (poly_mul r p (poly_deriv r q)):(1->num)->A
      #|  q:(1->num)->A
      #|  !(r:A ring) (p:(1->num)->A) f.\n        ring_polynomial r p /\\\n        ring_divides (poly_ring r (:1)) (poly_pow r p 2) f\n        ==> ring_divides (poly_ring r (:1)) p (poly_deriv r f)
      #|  d:(1->num)->A
