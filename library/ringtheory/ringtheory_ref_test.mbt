      #|  !r a b c:A.\n        (UFD r \\/ integral_domain r /\\ bezout_ring r) /\\\n        a IN ring_carrier r /\\ b IN ring_carrier r /\\ c IN ring_carrier r\n        ==> ring_associates r (ring_gcd r (ring_mul r a c,ring_mul r b c))\n                              (ring_mul r (ring_gcd r (a,b)) c)
