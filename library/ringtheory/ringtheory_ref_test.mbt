      #|  !k (r:K->A ring) a i.\n        RESTRICTION k (\\j. if j = i then a else ring_0 (r j)) IN\n        ring_carrier(product_ring k r) <=>\n        i IN k ==> a IN ring_carrier(r i)
      #|  !(k:K->bool) (r:A ring).\n     ring_homomorphism (r,product_ring k (\\i. r)) (\\x. RESTRICTION k (\\i. x))
