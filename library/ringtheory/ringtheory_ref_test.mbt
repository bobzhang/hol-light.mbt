      #|  ~(n = 0) ==> n - 1 + 1 = n
      #|  poly_deg r (p:(1->num)->A) = 0
      #|  !(r:A ring) (p:(1->num)->A).\n        integral_domain r /\\ ring_char r = 0 /\\ ring_polynomial r p\n        ==> poly_deg r (poly_deriv r p) = poly_deg r p - 1
      #|  poly_deg k (p:(1->num)->A) - 1
      #|  !(k:A ring) p.\n    integral_domain k /\\ ring_char k = 0 /\\\n    ring_polynomial k p /\\\n    1 <= poly_deg k p\n    ==> ~(poly_deriv k p = poly_0 k)
      #|  !(r:A ring) c. poly_deriv r (poly_const r c) = poly_0 r
      #|  !(r:A ring). poly_deriv r (poly_0 r) = poly_0 r
