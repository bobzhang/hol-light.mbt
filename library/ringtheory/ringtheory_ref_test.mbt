      #|  n1:V->num
      #|  (m1:V->num,m2:V->num)
      #|  !m. ring_sum r t f = ring_sum r {m} f /\\ ~(ring_sum r {m} f = a)\n        ==> ~(ring_sum r t f = a)
      #|  monomial (:V) m1 /\\ monomial (:V) m2
      #|  monomial_mul m1 m2:V->num
      #|  m2:V->num
      #|  m1:V->num
      #|  r:A ring
      #|  l:V->V->bool
      #|  l:V->V->bool
      #|  (:V)
      #|  q:(V->num)->A = poly_0 r
      #|  !r (p:(V->num)->A) q.\n        integral_domain r /\\ ring_polynomial r p /\\ ring_polynomial r q /\\\n        (p = poly_0 r <=> q = poly_0 r)\n        ==> poly_deg r (poly_mul r p q) = poly_deg r p + poly_deg r q
      #|  p:(V->num)->A
      #|  q:(V->num)->A
      #|  (p:(1->num)->A) = poly_0 (r:A ring)
      #|  !r (c:A) (p:(1->num)->A).\n     integral_domain r /\\\n     c IN ring_carrier r /\\ ~(c = ring_0 r) /\\\n     ring_polynomial r p\n     ==> poly_deg r (poly_mul r (poly_const r c) p) = poly_deg r p
      #|  coeff ((poly_deg r (p:(1->num)->A) + poly_deg r q) - a)\n              (q:(1->num)->A) = ring_0 (r:A ring)
      #|  coeff a (p:(1->num)->A) = ring_0 (r:A ring)
      #|  poly_deg r (p:(1->num)->A) < a
      #|  a:num
      #|  ring_sum (r:A ring) (0..poly_deg r p + poly_deg r q)\n      (\\a. ring_mul r (coeff a p)\n                      (coeff ((poly_deg r p + poly_deg r q) - a) q)) =\n     ring_sum r (0..poly_deg r p + poly_deg r q)\n      (\\a. if a = poly_deg r p\n           then ring_mul r (coeff (poly_deg r p) p) (coeff (poly_deg r q) q)\n           else ring_0 r)
      #|  !r (p:(1->num)->A) q.\n     ring_polynomial r p /\\ ring_polynomial r q\n     ==> coeff (poly_deg r p + poly_deg r q) (poly_mul r p q) =\n         ring_mul r (coeff (poly_deg r p) p) (coeff (poly_deg r q) q)
      #|  !r (p:(1->num)->A) q.\n     ring_polynomial r p /\\ ring_polynomial r q /\\\n     ~(ring_mul r (coeff (poly_deg r p) p) (coeff (poly_deg r q) q) =\n       ring_0 r)\n     ==> poly_deg r (poly_mul r p q) = poly_deg r p + poly_deg r q
      #|  monomial_div (monomial_mul m1 m2) m1 = m2
      #|  monomial_mul (monomial_var (x:V)) m
      #|  monomial (:V) m
      #|  m:V->num
      #|  p:(V->num)->A
      #|  r:A ring
      #|  !(r:A ring) p (x:V).\n        ring_polynomial r p\n        ==> poly_deg r (poly_mul r (poly_var r x) p) =\n            if p = poly_0 r then 0 else poly_deg r p + 1
      #|  !(r:A ring) p (x:V).\n        ring_polynomial r p\n        ==> poly_deg r (poly_mul r p (poly_var r x)) =\n            if p = poly_0 r then 0 else poly_deg r p + 1
      #|  p:(V->num)->A = poly_0 r
      #|  !(r:A ring) p (x:V) k.\n        ring_polynomial r p\n        ==> poly_deg r (poly_mul r (poly_pow r (poly_var r x) k) p) =\n            if p = poly_0 r then 0 else poly_deg r p + k
      #|  !(r:A ring) p (x:V) k.\n        ring_polynomial r p\n        ==> poly_deg r (poly_mul r p (poly_pow r (poly_var r x) k)) =\n            if p = poly_0 r then 0 else poly_deg r p + k
      #|  d:A
      #|  c:A
      #|  q:(V->num)->A
      #|  p:(V->num)->A
      #|  r:A ring
      #|  p \\/ q <=> ~(~p /\\ ~q)
      #|  q:(V->num)->A
      #|  p:(V->num)->A
      #|  !(r:A ring) (s:V->bool).\n        integral_domain(poly_ring r s) <=> integral_domain r
      #|  n:num
      #|  p:(V->num)->A
      #|  poly_ring (r:A ring) (:V)
      #|  p:(V->num)->A = poly_0 r
      #|  !(r:A ring) (p:(V->num)->A) n.\n        integral_domain r /\\\n        ring_polynomial r p\n        ==> poly_deg r (poly_pow r p n) = n * poly_deg r p
      #|  poly_deg r (poly_mul r (p:(V->num)->A) (x:(V->num)->A)) =\n     poly_deg r p + poly_deg r x
      #|  ~(q:(V->num)->A = poly_0 r)
      #|  ~((p:(V->num)->A) = poly_0 r) /\\ ~((x:(V->num)->A) = poly_0 r)
      #|  !(r:A ring) (v:V->bool) p q.\n        integral_domain r /\\\n        ring_divides (poly_ring r v) p q /\\\n        ~(q = poly_0 r)\n        ==> poly_deg r p <= poly_deg r q
      #|  a <= n /\\ b <= n /\\ c <= MAX a b ==> c <= n
      #|  !r s p (q:(V->num)->A) n.\n        p IN ring_carrier(poly_ring r s) /\\\n        q IN ring_carrier(poly_ring r s) /\\\n        poly_deg r p <= n /\\ poly_deg r q <= n\n        ==> poly_deg r (ring_add (poly_ring r s) p q) <= n
      #|  a <= n /\\ b <= n /\\ c <= MAX a b ==> c <= n
      #|  !r s p (q:(V->num)->A) n.\n        p IN ring_carrier(poly_ring r s) /\\\n        q IN ring_carrier(poly_ring r s) /\\\n        poly_deg r p <= n /\\ poly_deg r q <= n\n        ==> poly_deg r (ring_sub (poly_ring r s) p q) <= n
      #|  !r s (f:K->(V->num)->A) k n.\n        FINITE k /\\\n        (!i. i IN k\n             ==> f i IN ring_carrier(poly_ring r s) /\\ poly_deg r (f i) <= n)\n        ==> poly_deg r (ring_sum (poly_ring r s) k f) <= n
      #|  (!m. ~((if m = a then w else z) = z) ==> P m) <=> (w = z \\/ P a)
      #|  !(r:A ring) (s:V->bool) i k.\n        poly_deg r (ring_pow (poly_ring r s) (poly_var r i) k) =\n        if ring_1 r = ring_0 r then 0 else k
      #|  monomial v (m2:V->num)
      #|  m2:V->num
      #|  v:V->bool
      #|  monomial_mul m1 m2:V->num
      #|  m1:V->num
      #|  m2:V->num
      #|  monomial_restrict v m:V->num
      #|  v:V->bool
      #|  monomial_restrict (u:V->bool) m
      #|  monomial_restrict (v:V->bool) m
      #|  monomial (u UNION v) (m:V->num)
      #|  m:V->num
      #|  ~((if p then x else z) = z) <=> p /\\ ~(x = z)
      #|  v:V->bool
      #|  u:V->bool
      #|  r:A ring
      #|  !r u v (p:(V->num)->A).\n        DISJOINT u v /\\\n        p IN ring_carrier(poly_ring r (u UNION v))\n        ==> (poly_deg (poly_ring r u)\n              (\\m1 m2. if monomial v m1 /\\ monomial u m2\n                       then p(monomial_mul m1 m2) else ring_0 r) = 0 <=>\n             poly_vars r p SUBSET u)
      #|  (f:((V->num)->A)->((V->num)->(V->num)->A)) p2
      #|  (f:((V->num)->A)->((V->num)->(V->num)->A)) p1
      #|  poly_ring (r:A ring) (s:V->bool)
      #|  ~(q /\\ s) /\\ (~(p /\\ r) ==> t)\n   ==> (p <=> q) ==> (r <=> s) ==> t
      #|  f:((V->num)->A)->((V->num)->(V->num)->A)
      #|  t DELETE a = s ==> a IN t ==> s UNION {a} = t
      #|  {a:V}
      #|  s:V->bool
      #|  r:A ring
      #|  {a:V}
      #|  s:V->bool
      #|  r:A ring
      #|  s SUBSET t ==> !a. ~(a IN s) ==> s SUBSET t DELETE a
      #|  a:V
      #|  s = (poly_vars (r:A ring) p1 UNION poly_vars r p2) DELETE (a:V)
      #|  a:V
      #|  t = s <=> t SUBSET s /\\ ~(t PSUBSET s)
      #|  (p <=> q) <=> p /\\ q \\/ ~p /\\ ~q
      #|  !r p1 (p2:(V->num)->A).\n        integral_domain r /\\\n        ring_polynomial r p1 /\\ ring_polynomial r p2 /\\\n        (p1 = poly_0 r <=> p2 = poly_0 r)\n        ==> poly_vars r (poly_mul r p1 p2) =\n            poly_vars r p1 UNION poly_vars r p2
      #|  p1:(V->num)->A
      #|  p2:(V->num)->A
      #|  poly_mul r p1 p2:(V->num)->A
      #|  p1:(V->num)->A
      #|  p2:(V->num)->A
      #|  p2:(V->num)->A
      #|  p1:(V->num)->A
      #|  p1:(V->num)->A
      #|  p2:(V->num)->A
      #|  n:num
      #|  p:(V->num)->A
      #|  poly_ring (r:A ring) (:V)
      #|  p:(V->num)->A = poly_0 r
      #|  !r (p:(V->num)->A) n.\n        integral_domain r /\\ ring_polynomial r p\n        ==> poly_vars r (poly_pow r p n) =\n            if n = 0 then {} else poly_vars r p
      #|  {x | ~(f x = k x)} SUBSET s <=>\n    IMAGE f s SUBSET UNIV /\\ {x | ~(f x = k x)} SUBSET s
      #|  FINITE s ==> (FINITE t /\\ t SUBSET s <=> t SUBSET s)
      #|  !s:V->bool. FINITE s /\\ ~(s = {}) ==> {m | monomial s m} =_c (:num)
      #|  ~(1 = 0)
      #|  {m | FINITE {i | ~(m i = 0)} /\\ {i | ~(m i = 0)} SUBSET s} =\n    {m | IMAGE m s SUBSET (:num) /\\\n         {i | ~(m i = 0)} SUBSET s /\\\n         FINITE {i | ~(m i = 0)}}
      #|  !s:V->bool. INFINITE s ==> {m | monomial s m} =_c s
      #|  s:V->bool
      #|  !s:V->bool. COUNTABLE s /\\ ~(s = {}) ==> {m | monomial s m} =_c (:num)
      #|  r:A ring
      #|  (\\m. ring_0 r):(V->num)->A
      #|  ring_carrier r:A->bool
      #|  {m | monomial (s:V->bool) m}
      #|  !(r:A ring) (s:V->bool).\n        COUNTABLE s /\\ ~(s = {})\n        ==> ring_carrier(powser_ring r s) =_c (ring_carrier r) ^_c (:num)
      #|  !(r:A ring) (s:V->bool).\n        FINITE s /\\ ~(s = {})\n        ==> ring_carrier(powser_ring r s) =_c (ring_carrier r) ^_c (:num)
      #|  r:A ring
      #|  (\\m. ring_0 r):(V->num)->A
      #|  ring_carrier r:A->bool
      #|  {m | monomial (s:V->bool) m}
      #|  !(r:A ring) (s:V->bool).\n        INFINITE s\n        ==> ring_carrier(powser_ring r s) =_c (ring_carrier r) ^_c s
      #|  r:A ring
      #|  (\\m. ring_0 r):(V->num)->A
      #|  ring_carrier r:A->bool
      #|  {m | monomial (s:V->bool) m}
      #|  !(r:A ring) (s:V->bool).\n        ~trivial_ring r /\\ COUNTABLE s /\\ ~(s = {})\n        ==> ring_carrier(poly_ring r s) =_c (ring_carrier r) *_c (:num)
      #|  !(r:A ring) (s:V->bool).\n        ~trivial_ring r /\\ FINITE s /\\ ~(s = {})\n        ==> ring_carrier(poly_ring r s) =_c (ring_carrier r) *_c (:num)
      #|  r:A ring
      #|  (\\m. ring_0 r):(V->num)->A
      #|  ring_carrier r:A->bool
      #|  {m | monomial (s:V->bool) m}
      #|  !(r:A ring) (s:V->bool).\n        ~trivial_ring r /\\ INFINITE s\n        ==> ring_carrier(poly_ring r s) =_c (ring_carrier r) *_c s
      #|  poly_evaluate r p (x:V->A) = poly_extend (r,r) I x p
      #|  !r p (x:V->A). poly_evaluate r p x IN ring_carrier r
      #|  !r (x:V->A). poly_evaluate r (poly_0 r) x = ring_0 r
      #|  !r (x:V->A). poly_evaluate r (poly_1 r) x = ring_1 r
      #|  !(r:A ring) (i:V) x.\n        x i IN ring_carrier r ==> poly_evaluate r (poly_var r i) x = x i
      #|  !r a (x:V->A).\n        a IN ring_carrier r ==> poly_evaluate r (poly_const r a) x = a
      #|  !r p q (x:V->A).\n        ring_polynomial r p /\\ ring_polynomial r q\n        ==> poly_evaluate r (poly_add r p q) x =\n            ring_add r (poly_evaluate r p x) (poly_evaluate r q x)
      #|  !r p q (x:V->A).\n        ring_polynomial r p /\\ ring_polynomial r q\n        ==> poly_evaluate r (poly_sub r p q) x =\n            ring_sub r (poly_evaluate r p x) (poly_evaluate r q x)
      #|  !r p q (x:V->A).\n        ring_polynomial r p /\\ ring_polynomial r q /\\\n        (!i. i IN poly_vars r p UNION poly_vars r q\n             ==> x i IN ring_carrier r)\n        ==> poly_evaluate r (poly_mul r p q) x =\n            ring_mul r (poly_evaluate r p x) (poly_evaluate r q x)
      #|  !r p (x:V->A) n.\n        ring_polynomial r p /\\\n        (!i. i IN poly_vars r p ==> x i IN ring_carrier r)\n        ==> poly_evaluate r (poly_pow r p n) x =\n            ring_pow r (poly_evaluate r p x) n
      #|  !(r:A ring) (v:V->bool) (s:W->bool) f x.\n        (!i. i IN v ==> x i IN ring_carrier r) /\\\n        FINITE s /\\\n        (!a. a IN s ==> f a IN ring_carrier(poly_ring r v))\n        ==> poly_evaluate r (ring_sum (poly_ring r v) s f) x =\n            ring_sum r s (\\a. poly_evaluate r (f a) x)
      #|  !(r:A ring) (v:V->bool) (s:W->bool) f x.\n        (!i. i IN v ==> x i IN ring_carrier r) /\\\n        FINITE s /\\\n        (!a. a IN s ==> f a IN ring_carrier(poly_ring r v))\n        ==> poly_evaluate r (ring_product (poly_ring r v) s f) x =\n            ring_product r s (\\a. poly_evaluate r (f a) x)
      #|  !r s (x:V->A).\n        IMAGE x s SUBSET ring_carrier r\n        ==> ring_homomorphism (poly_ring r s,r) (\\p. poly_evaluate r p x)
      #|  poly_const r a:(V->num)->A
      #|  a:A
      #|  !r s (x:V->A).\n        IMAGE x s SUBSET ring_carrier r\n        ==> ring_epimorphism (poly_ring r s,r) (\\p. poly_evaluate r p x)
      #|  p:(V->num)->A
      #|  f:A->B
      #|  x:V->A
      #|  v:V->bool
      #|  I:A->A
      #|  s:B ring
      #|  r:A ring
      #|  r:A ring
      #|  !(r:A ring) (s:B ring) (x:V->A) f v p.\n        ring_homomorphism (r,s) f /\\\n        IMAGE x v SUBSET ring_carrier r /\\\n        p IN ring_carrier (poly_ring r v)\n        ==> f(poly_evaluate r p x) = poly_evaluate s (f o p) (f o x)
      #|  !r s (f:A->B) (x:V->B) p.\n        ring_homomorphism(r,s) f\n        ==> poly_extend (r,s) f x p = poly_evaluate s (f o p) x
      #|  s:V->bool
      #|  !r s (p:(V->num)->A) x y.\n        (!i. i IN s ==> x i IN ring_carrier r) /\\\n        (!i. i IN s ==> x i = y i) /\\\n        p IN ring_carrier(poly_ring r s)\n        ==> poly_evaluate r p x = poly_evaluate r p y
      #|  !r (p:(V->num)->A).\n        ring_powerseries r p\n        ==> poly_evaluate r p (\\x. ring_0 r) = p monomial_1
      #|  !r v (p:(V->num)->A).\n        p IN ring_carrier (poly_ring r v)\n        ==> poly_evaluate r p (\\x. ring_0 r) = p monomial_1
      #|  !(r:A ring) (s:V->bool).\n        ring_homomorphism (powser_ring r s,r)\n                          (\\p. poly_evaluate r p (\\i. ring_0 r))
      #|  poly_const r a:(V->num)->A
      #|  a:A
      #|  !(r:A ring) (s:V->bool).\n        ring_epimorphism (powser_ring r s,r)\n                         (\\p. poly_evaluate r p (\\i. ring_0 r))
      #|  !(r:R ring) A B q f:X->Y c:Y->R.\n        BIJ f A B /\\ poly_vars r q SUBSET B\n        ==> poly_evaluate r (poly_reindex r q f A B) (c o f) =\n            poly_evaluate r q c
      #|  poly_eval (r:A ring) p x = poly_evaluate r p (\\v:1. x)
      #|  !r p (x:A). poly_eval r p x IN ring_carrier r
      #|  !(r:A ring) x. poly_eval r (poly_0 r) x = ring_0 r
      #|  !(r:A ring) x. poly_eval r (poly_1 r) x = ring_1 r
      #|  !(r:A ring) x.\n        x IN ring_carrier r ==> poly_eval r (poly_var r one) x = x
      #|  !(r:A ring) a x.\n        a IN ring_carrier r ==> poly_eval r (poly_const r a) x = a
      #|  !(r:A ring) p q x.\n        ring_polynomial r p /\\ ring_polynomial r q\n        ==> poly_eval r (poly_add r p q) x =\n            ring_add r (poly_eval r p x) (poly_eval r q x)
      #|  !(r:A ring) p q x.\n        ring_polynomial r p /\\ ring_polynomial r q\n        ==> poly_eval r (poly_sub r p q) x =\n            ring_sub r (poly_eval r p x) (poly_eval r q x)
      #|  !(r:A ring) p q x.\n        ring_polynomial r p /\\ ring_polynomial r q /\\ x IN ring_carrier r\n        ==> poly_eval r (poly_mul r p q) x =\n            ring_mul r (poly_eval r p x) (poly_eval r q x)
      #|  !(r:A ring) p n x.\n        ring_polynomial r p /\\ x IN ring_carrier r\n        ==> poly_eval r (poly_pow r p n) x =\n            ring_pow r (poly_eval r p x) n
      #|  !(r:A ring) (s:W->bool) (f:W->(1->num)->A) (x:A).\n        x IN ring_carrier r /\\ FINITE s /\\\n        (!a. a IN s ==> f a IN ring_carrier(poly_ring r (:1)))\n        ==> poly_eval r (ring_sum (poly_ring r (:1)) s f) x =\n            ring_sum r s (\\a. poly_eval r (f a) x)
      #|  !(r:A ring) (s:W->bool) (f:W->(1->num)->A) (x:A).\n        x IN ring_carrier r /\\ FINITE s /\\\n        (!a. a IN s ==> f a IN ring_carrier(poly_ring r (:1)))\n        ==> poly_eval r (ring_product (poly_ring r (:1)) s f) x =\n            ring_product r s (\\a. poly_eval r (f a) x)
      #|  !r s x:A.\n        x IN ring_carrier r\n        ==> ring_homomorphism (poly_ring r s,r) (\\p. poly_eval r p x)
      #|  !r s x:A.\n        x IN ring_carrier r\n        ==> ring_epimorphism (poly_ring r s,r) (\\p. poly_eval r p x)
      #|  p:(1->num)->A
      #|  (:1)
      #|  f:A->B
      #|  (\\v. x):1->A
      #|  s:B ring
      #|  r:A ring
      #|  !(r:A ring) (s:B ring) x f p.\n        ring_homomorphism (r,s) f /\\\n        x IN ring_carrier r /\\\n        p IN ring_carrier (poly_ring r (:1))\n        ==> f(poly_eval r p x) = poly_eval s (f o p) (f x)
      #|  i:num
      #|  r /\\ (r ==> (q <=> p)) ==> ~p ==> ~q /\\ r
      #|  m:1->num
      #|  \\m:1->num. m one
      #|  \\(i:num) (v:1). i
      #|  i:num
      #|  i:num
      #|  {i | ~((p:(1->num)->A) (\\v. i) = ring_0 r)}
      #|  !t. t SUBSET s /\\ (!x. x IN s /\\ ~(x IN t) ==> f x = ring_0 r) /\\\n         ring_sum r t f = p\n        ==> p = ring_sum r s f
      #|  !r r' (h:A->B) x p.\n      ring_homomorphism(r,r') h /\\ x one IN ring_carrier r' /\\\n      p IN ring_carrier (poly_ring r (:1))\n      ==> poly_extend (r,r') h x p =\n          ring_sum r' (0..poly_deg r p)\n                      (\\i. ring_mul r' (h(coeff i p)) (ring_pow r' (x one) i))
      #|  !(r:A ring) x p.\n        x IN ring_carrier r /\\\n        p IN ring_carrier (poly_ring r (:1))\n        ==> poly_eval r p x =\n            ring_sum r (0..poly_deg r p)\n                       (\\i. ring_mul r (coeff i p) (ring_pow r x i))
      #|  p:(1->num)->A
      #|  (:1)
      #|  r:A ring
      #|  !r (p:(1->num)->A).\n        p IN ring_carrier (poly_ring r (:1))\n        ==> p = ring_sum\n                  (poly_ring r (:1)) (0..poly_deg r p)\n                  (\\i. ring_mul (poly_ring r (:1))\n                         (poly_const r (coeff i p))\n                         (ring_pow (poly_ring r (:1)) (poly_var r one) i))
      #|  !(r:A ring) p.\n        ring_powerseries r p\n        ==> poly_eval r p (ring_0 r) = coeff 0 p
      #|  !(r:A ring) p.\n        p IN ring_carrier (poly_ring r (:1))\n        ==> poly_eval r p (ring_0 r) = coeff 0 p
      #|  !(r:A ring) s. ring_homomorphism (powser_ring r s,r)\n                                    (\\p. poly_eval r p (ring_0 r))
      #|  !(r:A ring) s. ring_epimorphism (powser_ring r s,r)\n                                   (\\p. poly_eval r p (ring_0 r))
      #|  \\p. poly_eval r p (ring_0 r:A)
      #|  !(r:A ring) s. ring_homomorphism (powser_ring r s,r) (coeff 0)
      #|  \\p. poly_eval r p (ring_0 r:A)
      #|  !(r:A ring) s. ring_homomorphism (poly_ring r s,r) (coeff 0)
      #|  \\p. poly_eval r p (ring_0 r:A)
      #|  !(r:A ring) s. ring_epimorphism (powser_ring r s,r) (coeff 0)
      #|  \\p. poly_eval r p (ring_0 r:A)
      #|  !(r:A ring) s. ring_epimorphism (poly_ring r s,r) (coeff 0)
      #|  i:num
      #|  p:(1->num)->A
      #|  r:A ring
      #|  coeff i (p:(1->num)->A) = ring_0 r
      #|  coeff i (p:(1->num)->A) = ring_0 r
      #|  i:num
      #|  poly_eval r (p:(1->num)->A) x =\n   ring_sum r (0..poly_deg r p)\n             (\\i. ring_mul r (coeff i p) (ring_pow r x i))
      #|  (p:(1->num)->A) IN ring_carrier(poly_ring r (:1))
      #|  !r (p:(1->num)->A) x n.\n        ring_polynomial r p /\\\n        x IN ring_carrier r /\\\n        poly_deg r p <= n\n        ==> poly_eval r p x =\n            ring_sum r (0..n)\n                       (\\d. ring_mul r (coeff d p) (ring_pow r x d))
      #|  a:A
      #|  l:A ring
      #|  subring_generated l k:A ring
      #|  I:A->A
      #|  !l k a:A.\n        k subring_of l /\\ a IN ring_carrier l\n        ==> IMAGE (\\p. poly_eval l p a)\n                  (ring_carrier(poly_ring (subring_generated l k) (:1))) =\n            ring_carrier (subring_generated l (a INSERT k))
      #|  p /\\ (p ==> q) ==> p /\\ q
      #|  \\m. (p:(1->num)->A) (\\v. m one + 1)
      #|  ring_polynomial r (p:(1->num)->A)
      #|  !(r:A ring) p.\n        ring_divides (poly_ring r (:1)) (poly_var r one) p <=>\n        ring_polynomial r p /\\ coeff 0 p = ring_0 r
      #|  !r s (f:A->B) (p:(V->num)->A).\n        ring_homomorphism(r,s) f /\\ ring_powerseries r p\n        ==> ring_powerseries s (f o p)
      #|  !r s (v:V->bool) (f:A->B) p.\n        ring_homomorphism(r,s) f /\\\n        p IN ring_carrier(powser_ring r v)\n        ==> (f o p) IN ring_carrier(powser_ring s v)
      #|  !r s (f:A->B) (p:(V->num)->A).\n        ring_homomorphism(r,s) f /\\ ring_polynomial r p\n        ==> ring_polynomial s (f o p)
      #|  !r s (f:A->B) v p.\n        ring_homomorphism(r,s) f /\\\n        p IN ring_carrier(poly_ring r v)\n        ==> (f o p) IN ring_carrier(poly_ring s v)
      #|  !r s (f:A->B) (p:(V->num)->A).\n        ring_homomorphism (r,s) f /\\ ring_polynomial r p\n        ==> poly_deg s (f o p) <= poly_deg r p
      #|  !r s (f:A->B) (p:(V->num)->A).\n        ring_monomorphism (r,s) f /\\ ring_polynomial r p\n        ==> poly_deg s (f o p) = poly_deg r p
      #|  !r s (f:A->B) (p:(V->num)->A).\n        ring_monomorphism (r,s) f /\\ ring_polynomial r p\n        ==> (f o p = poly_0 s <=> p = poly_0 r)
      #|  f(ring_0 r) = ring_0 s\n      ==> x = ring_0 r /\\ y = ring_0 s ==> f x = y
      #|  FINITE(monomial_vars(m:V->num))
      #|  m:V->num
      #|  (!r s (f:A->B) (v:V->bool).\n        ring_homomorphism (r,s) f\n        ==> ring_homomorphism (powser_ring r v,powser_ring s v) (\\p. f o p)) /\\\n   (!r s (f:A->B) (v:V->bool).\n        ring_homomorphism (r,s) f\n        ==> ring_homomorphism (poly_ring r v,poly_ring s v) (\\p. f o p))
      #|  (!r s (f:A->B) (v:V->bool).\n        ring_monomorphism (r,s) f\n        ==> ring_monomorphism (powser_ring r v,powser_ring s v) (\\p. f o p)) /\\\n   (!r s (f:A->B) (v:V->bool).\n        ring_monomorphism (r,s) f\n        ==> ring_monomorphism (poly_ring r v,poly_ring s v) (\\p. f o p))
      #|  (g:B->A) o (p:(V->num)->B)
      #|  p:(V->num)->B
      #|  \\y. if y = ring_0 s then ring_0 r else (g:B->A) y
      #|  g:B->A
      #|  (?g. Q g) /\\ (!g. Q g ==> ?h. P h /\\ Q h) ==> ?g. P g /\\ Q g
      #|  ?g:B->A. g(ring_0 s) = ring_0 r /\\\n             !y. y IN ring_carrier s ==> g(y) IN ring_carrier r /\\ f(g y) = y
      #|  (!r s (f:A->B) (v:V->bool).\n        ring_epimorphism (r,s) f\n        ==> ring_epimorphism (powser_ring r v,powser_ring s v) (\\p. f o p)) /\\\n   (!r s (f:A->B) (v:V->bool).\n        ring_epimorphism (r,s) f\n        ==> ring_epimorphism (poly_ring r v,poly_ring s v) (\\p. f o p))
      #|  !r s (f:A->B) (v:V->bool).\n        ring_isomorphism (r,s) f\n        ==> ring_isomorphism (powser_ring r v,powser_ring s v) (\\p. f o p)
