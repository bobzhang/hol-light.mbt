      #|  forall(f:A->B) (g:B->C) A B C.\n        ring_epimorphism (A,B) f /\\\n        ring_homomorphism (B,C) g /\\\n        ring_isomorphism (A,C) (g o f)\n        ==> ring_isomorphism (A,B) f /\\ ring_isomorphism (B,C) g
