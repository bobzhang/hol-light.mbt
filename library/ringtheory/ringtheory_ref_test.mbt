      #|  a IN ring_carrier r /\\ b IN ring_carrier r /\\ c IN ring_carrier r /\\\n    x IN ring_carrier r /\\ y IN ring_carrier r /\\\n    ring_mul r a b = c\n    ==> ring_mul r (ring_mul r x y) c =\n        ring_mul r (ring_mul r x a) (ring_mul r y b)
      #|  (m2 : (V) -> Num)
      #|  (m1 : (V) -> Num)
