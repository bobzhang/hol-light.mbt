// Load-fidelity test for Library/ringtheory.ml: replays tools/ocaml_ref/Library_ringtheory_ref.ml
// (keep in sync; refresh with tools/ocaml_ref/refresh_ref.py).

///|
using @testkit {stm, sthm}

///|
test "Library/ringtheory matches Library/ringtheory.ml" {
  @ringtheory.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "Library/binomial", "Library/iter", "Library/prime", "Library/pocklington",
      "Library/wo", "Library/card", "Library/ringtheory",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Library/ringtheory")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("ring_tybij", () => sthm(@ringtheory.ring_tybij()))
  log.attempt("ring_carrier", () => sthm(@ringtheory.ring_carrier()))
