      #|  (z : A)
      #|  forall r r' (f:A->B) x y.\n        ring_homomorphism(r,r') f /\\ ring_divides r x y\n        ==> ring_divides r' (f x) (f y)
      #|  forall r r' (f:A->B) x y.\n        ring_homomorphism(r,r') f /\\ ring_associates r x y\n        ==> ring_associates r' (f x) (f y)
