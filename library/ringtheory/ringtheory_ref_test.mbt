      #|  !r r' (f:A->B) a.\n        ring_isomorphism(r,r') f /\\ a IN ring_carrier r\n        ==> (ring_zerodivisor r' (f a) <=> ring_zerodivisor r a)
      #|  !r r' (f:A->B) a.\n        ring_isomorphism(r,r') f /\\ a IN ring_carrier r\n        ==> (ring_regular r' (f a) <=> ring_regular r a)
