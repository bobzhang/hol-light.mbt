      #|  forall r r' (f:A->B).\n        ring_isomorphism (r,r') f <=>\n        ring_epimorphism (r,r') f /\\\n        (forall x y. x IN ring_carrier r /\\ y IN ring_carrier r /\\ f x = f y\n               ==> x = y)
