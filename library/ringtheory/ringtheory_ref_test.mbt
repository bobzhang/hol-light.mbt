      #|  IMAGE (f:A->B) j
      #|  !r r' (f:A->B) j.\n        ring_epimorphism(r,r') f\n        ==> (j subring_of r /\\ ring_kernel(r,r') f SUBSET j <=>\n             ?k. k subring_of r' /\\\n                 {x | x IN ring_carrier r /\\ f x IN k} = j /\\\n                 IMAGE f j = k)
      #|  j = {x | x IN ring_carrier r /\\ (f:A->B) x IN IMAGE f j}
