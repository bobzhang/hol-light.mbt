      #|  !(r:A ring) p.\n        integral_domain r /\\ ring_polynomial r p /\\ ~(coeff 0 p = ring_0 r)\n        ==> (ring_irreducible (poly_ring r (:1)) (poly_recip r p) <=>\n             ring_irreducible (poly_ring r (:1)) p)
