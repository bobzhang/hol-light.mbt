      #|  d:num
      #|  !(r:A ring) (f:B->(1->num)->A) s.\n        FINITE s /\\ (!x. x IN s ==> ring_powerseries r (f x))\n        ==> poly_deriv r (ring_sum (powser_ring r (:1)) s f) =\n            ring_sum (powser_ring r (:1)) s (\\x. poly_deriv r (f x))
      #|  ~(i IN k) /\\ j IN k ==> (i INSERT k) DELETE j = i INSERT (k DELETE j)
      #|  ~(i IN k) ==> (i INSERT k) DELETE i = k
      #|  k:K->bool
      #|  i:K
      #|  !(r:A ring) (f:K->(1->num)->A) s.\n        FINITE s /\\ (!x. x IN s ==> ring_powerseries r (f x))\n        ==> poly_deriv r (ring_product (powser_ring r (:1)) s f) =\n            ring_sum (powser_ring r (:1)) s\n               (\\x. poly_mul r (poly_deriv r (f x))\n                    (ring_product (powser_ring r (:1))\n                                  (s DELETE x) f))
      #|  1..n
      #|  (\\i. p):num->(1->num)->A
