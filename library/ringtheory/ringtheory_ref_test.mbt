      #|  !r x y:A.\n        x IN ring_carrier r /\\ y IN ring_carrier r\n        ==> ring_mul r (ring_neg r x) y = ring_neg r (ring_mul r x y)
      #|  !r x y:A.\n        x IN ring_carrier r /\\ y IN ring_carrier r\n        ==> ring_mul r x (ring_neg r y) = ring_neg r (ring_mul r x y)
      #|  ring_add r (ring_add r y\n      (ring_add r x (ring_neg r x))) (ring_neg r y):A
      #|  !r x y:A.\n        x IN ring_carrier r /\\ y IN ring_carrier r\n        ==> ring_neg r (ring_add r x y) =\n            ring_add r (ring_neg r x) (ring_neg r y)
      #|  !r x:A. x IN ring_carrier r ==> ring_sub r x x = ring_0 r
      #|  !r x:A. x IN ring_carrier r ==> ring_sub r (ring_0 r) x = ring_neg r x
      #|  !r x:A. x IN ring_carrier r ==> ring_sub r x (ring_0 r) = x
      #|  !r x y:A.\n        x IN ring_carrier r /\\ y IN ring_carrier r\n        ==> (ring_sub r x y = ring_0 r <=> x = y)
      #|  !r x y z:A.\n        x IN ring_carrier r /\\ y IN ring_carrier r /\\ z IN ring_carrier r\n        ==> ring_mul r x (ring_sub r y z) =\n            ring_sub r (ring_mul r x y) (ring_mul r x z)
      #|  !r x y z:A.\n        x IN ring_carrier r /\\ y IN ring_carrier r /\\ z IN ring_carrier r\n        ==> ring_mul r (ring_sub r x y) z =\n            ring_sub r (ring_mul r x z) (ring_mul r y z)
      #|  !r x y z:A.\n        x IN ring_carrier r /\\ y IN ring_carrier r /\\ z IN ring_carrier r\n        ==> (x = ring_sub r y z <=> ring_add r x z = y)
      #|  !r x y z:A.\n        x IN ring_carrier r /\\ y IN ring_carrier r /\\ z IN ring_carrier r\n        ==> (ring_sub r x y = z <=> x = ring_add r z y)
      #|  !r (a:A) b c.\n     a IN ring_carrier r /\\ b IN ring_carrier r /\\ c IN ring_carrier r\n     ==> ring_add r (ring_sub r a b) (ring_sub r b c) =\n         ring_sub r a c
      #|  !r x y:A.\n        x IN ring_carrier r /\\ y IN ring_carrier r\n        ==> ring_neg r (ring_sub r x y) = ring_sub r y x
      #|  !r:A ring. ~(ring_carrier r = {})
      #|  trivial_ring r <=> ring_carrier r = {ring_0 r}
      #|  !r:A ring. trivial_ring r ==> FINITE(ring_carrier r)
      #|  !r:A ring. trivial_ring r <=> ring_carrier r SUBSET {ring_0 r}
      #|  c IN s ==> (s = {c} <=> ?a. s = {a})
      #|  !r:A ring. trivial_ring r <=> ?a. ring_carrier r = {a}
      #|  (?a. s = {a}) <=> (?a. s SUBSET {a}) /\\ ~(s = {})
      #|  !r:A ring. trivial_ring r <=> ?a. ring_carrier r SUBSET {a}
      #|  !r:A ring. trivial_ring r <=> ring_1 r = ring_0 r
      #|  !r:A ring. ring_carrier r HAS_SIZE 1 <=> trivial_ring r
      #|  !r:A ring. trivial_ring r <=> ring_carrier(r) HAS_SIZE 1
      #|  r:A ring
      #|  r:A ring
      #|  p /\\ (p ==> q) ==> p /\\ q
      #|  b:A
      #|  a:A
      #|  !r:A ring.\n        ring_carrier r HAS_SIZE 2 <=>\n        ~(trivial_ring r) /\\\n        ring_carrier r = {ring_0 r,ring_1 r}
      #|  singleton_ring (a:A) = ring({a},a,a,(\\x. a),(\\x y. a),(\\x y. a))
      #|  (!a:A. ring_carrier(singleton_ring a) = {a}) /\\\n   (!a:A. ring_0(singleton_ring a) = a) /\\\n   (!a:A. ring_1(singleton_ring a) = a) /\\\n   (!a:A. ring_neg(singleton_ring a) = \\x. a) /\\\n   (!a:A. ring_add(singleton_ring a) = \\x y. a) /\\\n   (!a:A. ring_mul(singleton_ring a) = \\x y. a)
      #|  !a:A. trivial_ring(singleton_ring a)
      #|  !a:A. FINITE(ring_carrier(singleton_ring a))
      #|  ring_of_num (r:A ring) 0 = ring_0 r /\\\n  ring_of_num (r:A ring) (SUC n) = ring_add r (ring_of_num r n) (ring_1 r)
      #|  ring_of_int (r:A ring) n =\n        if &0 <= n then ring_of_num r (num_of_int n)\n        else ring_neg r (ring_of_num r (num_of_int(--n)))
      #|  !(r:A ring) n. ring_of_num r n IN ring_carrier r
      #|  !(r:A ring) n. ring_of_int r n IN ring_carrier r
      #|  !(r:A ring) n. ring_of_int r (&n) = ring_of_num r n
      #|  !r:A ring. ring_of_num r 0 = ring_0 r
      #|  1
      #|  !r:A ring. ring_of_num r 1 = ring_1 r
      #|  !(r:A ring) m n.\n      ring_of_num r (m + n) = ring_add r (ring_of_num r m) (ring_of_num r n)
      #|  !(r:A ring) m n.\n      ring_of_num r (m * n) = ring_mul r (ring_of_num r m) (ring_of_num r n)
      #|  !r:A ring. ring_of_int r (&0) = ring_0 r
      #|  !r:A ring. ring_of_int r (&1) = ring_1 r
      #|  &0:int <= -- &n <=> &n:int = &0
      #|  (!(r:A ring) n. ring_of_int r (&n) = ring_of_num r n) /\\\n   (!(r:A ring) n. ring_of_int r (-- &n) = ring_neg r (ring_of_num r n))
      #|  !(r:A ring) n. ring_of_int r (--n) = ring_neg r (ring_of_int r n)
      #|  x IN ring_carrier r /\\ y IN ring_carrier r /\\ ring_add r x y = z\n    ==> ring_add r y x = z
      #|  !x y. x IN ring_carrier r /\\ y IN ring_carrier r\n         ==> ring_add r (ring_neg r x) y = ring_add r y (ring_neg r x)
      #|  (&a + &b:int = -- &c <=> &a:int = &0 /\\ &b:int = &0 /\\ &c:int = &0) /\\\n    (!m n p. m + --n:int = &p <=> m = n + &p) /\\\n    (!m n p. m + --n:int = -- &p <=> m + &p = n)
      #|  --b + a:int = a + --b
      #|  !(r:A ring) m n p.\n        m + n = p ==>\n      ring_of_int r p = ring_add r (ring_of_int r m) (ring_of_int r n)
      #|  !(r:A ring) m n.\n      ring_of_int r (m + n) = ring_add r (ring_of_int r m) (ring_of_int r n)
      #|  !(r:A ring) m n.\n      ring_of_int r (m * n) = ring_mul r (ring_of_int r m) (ring_of_int r n)
      #|  !(r:A ring) m n.\n      ring_of_int r (m - n) = ring_sub r (ring_of_int r m) (ring_of_int r n)
      #|  \\n. ring_of_num r n:A
      #|  \\x:A. x = ring_0 r
      #|  !r:A ring. ?p. !n. ring_of_num r n = ring_0 r <=> p divides n
      #|  (!n:num. n divides n) /\\ (!n. 0 divides n <=> n = 0)
      #|  !r:A ring. ring_char r = 0 <=> !n. ring_of_num r n = ring_0 r <=> n = 0
      #|  !r:A ring. ring_char r = 1 <=> trivial_ring r
      #|  !(r:A ring) n.\n        ring_of_int r n = ring_0 r <=> &(ring_char r) divides n
      #|  !(r:A ring) m n.\n        ring_of_int r m = ring_of_int r n <=> (m == n) (mod &(ring_char r))
      #|  !(r:A ring) m n.\n        ring_of_num r m = ring_of_num r n <=> (m == n) (mod (ring_char r))
      #|  !(f:A ring) n. ring_of_int f (n rem &(ring_char f)) = ring_of_int f n
      #|  !(f:A ring) n. ring_of_num f (n MOD ring_char f) = ring_of_num f n
      #|  !r:A ring. ring_of_num r (ring_char r) = ring_0 r
      #|  (:num)
      #|  ring_of_num r:num->A
      #|  !r:A ring. ring_char r = 0 ==> INFINITE(ring_carrier r)
      #|  !r:A ring. FINITE(ring_carrier r) ==> ~(ring_char r = 0)
      #|  !m n p:num. m divides n /\\ n divides p ==> m divides p
      #|  !n:num. n divides n
      #|  !(r:A ring) p.\n        ring_char r = p <=> !n. ring_of_num r n = ring_0 r <=> p divides n
      #|  ring_pow r x 0 = ring_1 r /\\\n  ring_pow r x (SUC n) = ring_mul r x (ring_pow r x n)
      #|  !r (x:A) n. x IN ring_carrier r ==> ring_pow r x n IN ring_carrier r
      #|  !r k. ring_pow r (ring_0 r) k = if k = 0 then ring_1 r else ring_0 r
      #|  !r (x:A). ring_pow r x 0 = ring_1 r
      #|  1
      #|  !r x:A. x IN ring_carrier r ==> ring_pow r x 1 = x
      #|  1
      #|  2
      #|  !r x:A. x IN ring_carrier r ==> ring_pow r x 2 = ring_mul r x x
      #|  !n. ring_pow r (ring_1 r) n = ring_1 r
      #|  !r (x:A) m n.\n        x IN ring_carrier r\n        ==> ring_pow r x (m + n) =\n            ring_mul r (ring_pow r x m) (ring_pow r x n)
      #|  !r (x:A) m n.\n        x IN ring_carrier r\n        ==> ring_pow r x (m * n) = ring_pow r (ring_pow r x m) n
      #|  !r (x:A) m n.\n        x IN ring_carrier r\n        ==> ring_pow r (ring_pow r x m) n = ring_pow r x (m * n)
      #|  !r (x:A) (y:A) n.\n        x IN ring_carrier r /\\ y IN ring_carrier r\n        ==> ring_pow r (ring_mul r x y) n =\n            ring_mul r (ring_pow r x n) (ring_pow r y n)
      #|  !(r:A ring) m n.\n        ring_of_num r (m EXP n) = ring_pow r (ring_of_num r m) n
      #|  !(r:A ring) x n.\n        ring_of_int r (x pow n) = ring_pow r (ring_of_int r x) n
      #|  n:num
      #|  !r (x:A) n.\n        x IN ring_carrier r\n        ==> ring_pow r (ring_neg r x) n =\n            if EVEN n then ring_pow r x n else ring_neg r (ring_pow r x n)
      #|  !r (x:A) n.\n        x IN ring_carrier r /\\ ring_mul r x x = x\n        ==> ring_pow r x n = if n = 0 then ring_1 r else x
      #|  (!(r:A ring).\n     ring_0 r = ring_of_num r 0) /\\\n   (!(r:A ring).\n     ring_1 r = ring_of_num r 1) /\\\n   (!(r:A ring) m n.\n     ring_add r (ring_of_num r m) (ring_of_num r n) = ring_of_num r (m + n)) /\\\n   (!(r:A ring) m n.\n     ring_mul r (ring_of_num r m) (ring_of_num r n) = ring_of_num r (m * n)) /\\\n   (!(r:A ring) m n.\n     ring_pow r (ring_of_num r m) n = ring_of_num r (m EXP n))
      #|  (!(r:A ring).\n     ring_0 r = ring_of_int r (&0)) /\\\n   (!(r:A ring).\n     ring_1 r = ring_of_int r (&1)) /\\\n   (!(r:A ring) n.\n     ring_neg r (ring_of_int r n) = ring_of_int r (--n)) /\\\n   (!(r:A ring) m n.\n     ring_add r (ring_of_int r m) (ring_of_int r n) = ring_of_int r (m + n)) /\\\n   (!(r:A ring) m n.\n     ring_sub r (ring_of_int r m) (ring_of_int r n) = ring_of_int r (m - n)) /\\\n   (!(r:A ring) m n.\n     ring_mul r (ring_of_int r m) (ring_of_int r n) = ring_of_int r (m * n)) /\\\n   (!(r:A ring) m n.\n     ring_pow r (ring_of_int r m) n = ring_of_int r (m pow n))
      #|  ring_sum r s (f:K->A) =\n        iterate (\\x y. if x IN ring_carrier r /\\ y IN ring_carrier r\n                       then ring_add r x y\n                       else if x IN ring_carrier r then y\n                       else if y IN ring_carrier r then x\n                       else @z:A. ~(z IN ring_carrier r))\n                {x | x IN s /\\ f(x) IN ring_carrier r} f
      #|  ring_0 r:A
      #|  x:A
      #|  !r:A ring.\n        neutral (\\x y. if x IN ring_carrier r /\\ y IN ring_carrier r\n                       then ring_add r x y\n                       else if x IN ring_carrier r then y\n                       else if y IN ring_carrier r then x\n                       else @z. ~(z IN ring_carrier r)) = ring_0 r
      #|  (z:A) IN ring_carrier r
      #|  (y:A) IN ring_carrier r
      #|  (x:A) IN ring_carrier r
      #|  z:A
      #|  y:A
      #|  x:A
      #|  !r:A ring.\n        monoidal (\\x y. if x IN ring_carrier r /\\ y IN ring_carrier r\n                        then ring_add r x y\n                        else if x IN ring_carrier r then y\n                         else if y IN ring_carrier r then x\n                        else @z. ~(z IN ring_carrier r))
      #|  r:C ring
      #|  \\x:B. x IN ring_carrier r
      #|  !r s (f:K->A). ring_sum r s f IN ring_carrier r
      #|  !s f. ring_sum r {a | a IN s /\\ f a IN ring_carrier r} f = ring_sum r s f
      #|  !s (f:K->A).\n        ring_sum r {a | a IN s /\\ ~(f a = ring_0 r)} f = ring_sum r s f
      #|  ((p /\\ q) /\\ r) /\\ q <=> p /\\ r /\\ q
      #|  !r k (f:K->A).\n        INFINITE {i | i IN k /\\ f i IN ring_carrier r /\\ ~(f i = ring_0 r)}\n        ==> ring_sum r k f = ring_0 r
      #|  {x | x IN {} /\\ P x} = {}
      #|  (!r f:K->A. ring_sum r {} f = ring_0 r) /\\\n   (!r x (f:K->A) s.\n          FINITE s\n          ==> ring_sum r (x INSERT s) f =\n              (if f(x) IN ring_carrier r ==> x IN s\n               then ring_sum r s f else ring_add r (f x) (ring_sum r s f)))
      #|  !r (f:K->A) a.\n        ring_sum r {a} f = if f a IN ring_carrier r then f a else ring_0 r
      #|  ~(SUC n <= n)
      #|  m <= SUC n
      #|  m = 0
      #|  (!r m f:num->A.\n        ring_sum r (m..0) f =\n        if m = 0 /\\ f 0 IN ring_carrier r then f 0 else ring_0 r) /\\\n   (!r m n f:num->A.\n        ring_sum r (m..SUC n) f =\n        if m <= SUC n /\\ f(SUC n) IN ring_carrier r\n        then ring_add r (f(SUC n)) (ring_sum r (m..n) f)\n        else ring_sum r (m..n) f)
      #|  (!r m f:num->A.\n        ring_sum r (m..0) f =\n        if m = 0 /\\ f 0 IN ring_carrier r then f 0 else ring_0 r) /\\\n   (!r m n f:num->A.\n        ring_sum r (m..SUC n) f =\n        if m <= SUC n /\\ f(SUC n) IN ring_carrier r\n        then ring_add r (ring_sum r (m..n) f) (f(SUC n))\n        else ring_sum r (m..n) f)
      #|  ~(n + 1 <= n)
      #|  !r (f:num->A) m n.\n        m <= n\n        ==> ring_sum r (m..n) f =\n            if f m IN ring_carrier r\n            then ring_add r (f m) (ring_sum r (m+1..n) f)\n            else ring_sum r (m+1..n) f
      #|  n <= n - 1 <=> n = 0
      #|  !r (f:num->A) m n.\n        0 < n /\\ m <= n\n        ==> ring_sum r (m..n) f =\n            if f n IN ring_carrier r\n            then ring_add r (ring_sum r (m..n-1) f) (f n)\n            else ring_sum r (m..n-1) f
      #|  r:C ring
      #|  !r (f:K->A) s t.\n        FINITE s /\\ FINITE t /\\ DISJOINT s t\n        ==> ring_sum r (s UNION t) f =\n            ring_add r (ring_sum r s f) (ring_sum r t f)
      #|  r:C ring
      #|  !r (f:K->A) s t.\n        FINITE s /\\ t SUBSET s\n        ==> ring_sum r (s DIFF t) f =\n            ring_sub r (ring_sum r s f) (ring_sum r t f)
      #|  r:C ring
      #|  !r (f:K->A) s t.\n        FINITE s /\\ FINITE t\n        ==> ring_add r (ring_sum r s f) (ring_sum r t f) =\n            ring_add r (ring_sum r (s UNION t) f)\n                       (ring_sum r (s INTER t) f)
      #|  r:C ring
      #|  {a | a IN s /\\ (f:K->A) a IN ring_carrier r}
      #|  f:K->A
      #|  \\x:A. x IN ring_carrier r /\\ P x
      #|  !r P (f:K->A) s.\n        P(ring_0 r) /\\\n        (!x y. x IN ring_carrier r /\\ y IN ring_carrier r /\\ P x /\\ P y\n               ==> P(ring_add r x y)) /\\\n        (!a. a IN s ==> P(f a))\n        ==> P(ring_sum r s f)
      #|  p /\\ q /\\ r ==> s <=> p /\\ q ==> r ==> s
      #|  !r R (f:K->A) g s.\n        R (ring_0 r) (ring_0 r)/\\\n        (!x y x' y'. x IN ring_carrier r /\\ y IN ring_carrier r /\\\n                     x' IN ring_carrier r /\\ y' IN ring_carrier r /\\\n                     R x y /\\ R x' y'\n                     ==> R (ring_add r x x') (ring_add r y y')) /\\\n        FINITE s /\\\n        (!a. a IN s\n             ==> (f a IN ring_carrier r <=> g a IN ring_carrier r) /\\\n                 R (f a) (g a))\n        ==> R (ring_sum r s f) (ring_sum r s g)
      #|  s = {} ==> ring_sum r s f = ring_0 r
      #|  !r (f:K->A) s.\n        (!a. a IN s /\\ f a IN ring_carrier r ==> f a = ring_0 r)\n        ==> ring_sum r s f = ring_0 r
      #|  !r s. ring_sum r s (\\i:K. ring_0 r):A = ring_0 r
      #|  s = (a:K) INSERT t
      #|  t = s DELETE (a:K)
      #|  (a:K) IN s
      #|  !r (f:K->A) s a.\n        FINITE s /\\ a IN s /\\ f a IN ring_carrier r\n        ==> ring_sum r (s DELETE a) f = ring_sub r (ring_sum r s f) (f a)
      #|  !r (f:K->A) s.\n        FINITE s /\\\n        (!a. a IN s ==> f a IN ring_carrier r)\n        ==> ring_sum r s (\\x. ring_neg r (f x)) =\n            ring_neg r (ring_sum r s f)
      #|  !r (f:K->A) (g:K->A) s.\n        FINITE s /\\\n        (!a. a IN s ==> f a IN ring_carrier r /\\ g a IN ring_carrier r)\n        ==> ring_sum r s (\\x. ring_add r (f x) (g x)) =\n            ring_add r (ring_sum r s f) (ring_sum r s g)
      #|  !r (f:K->A) (g:K->A) s.\n        FINITE s /\\\n        (!a. a IN s ==> f a IN ring_carrier r /\\ g a IN ring_carrier r)\n        ==> ring_sum r s (\\x. ring_sub r (f x) (g x)) =\n            ring_sub r (ring_sum r s f) (ring_sum r s g)
      #|  r:C ring
      #|  {a | a IN s /\\ (g:K->A) a IN ring_carrier r} =\n    {a | a IN s /\\ (f:K->A) a IN ring_carrier r}
      #|  !r (f:K->A) g s.\n        (!a. a IN s ==> f a = g a) ==> ring_sum r s f = ring_sum r s g
      #|  i IN s ==> {j | j IN s /\\ j = i} = {i}
      #|  ~((p /\\ q) /\\ ~q)
      #|  (a:A) IN ring_carrier r
      #|  a:A = ring_0 r
      #|  ~(i IN s) ==> {j | (j IN s /\\ j = i /\\ P j) /\\ Q j} = {}
      #|  (i:K) IN s
      #|  (if p then q else T) <=> p ==> q
      #|  !r s (i:K) (a:A).\n        ring_sum r s (\\j. if j = i then a else ring_0 r) =\n        if i IN s /\\ a IN ring_carrier r then a else ring_0 r
      #|  !r (f:K->A) c s.\n        c IN ring_carrier r /\\\n        FINITE s /\\\n        (!a. a IN s ==> f a IN ring_carrier r)\n        ==> ring_sum r s (\\x. ring_mul r c (f x)) =\n            ring_mul r c (ring_sum r s f)
      #|  !r (f:K->A) c s.\n        c IN ring_carrier r /\\\n        FINITE s /\\\n        (!a. a IN s ==> f a IN ring_carrier r)\n        ==> ring_sum r s (\\x. ring_mul r (f x) c) =\n            ring_mul r (ring_sum r s f) c
      #|  !r (f:K->L->A) s t.\n        FINITE s /\\ FINITE t /\\\n        (!i j. i IN s /\\ j IN t ==> f i j IN ring_carrier r)\n        ==> ring_sum r s (\\i. ring_sum r t (f i)) =\n            ring_sum r t (\\j. ring_sum r s (\\i. f i j))
      #|  r:C ring
      #|  n:num
      #|  m:num
      #|  x:num->A
      #|  {x | P x /\\ f x IN s} = {x | P x /\\ (P x ==> f x IN s)}
      #|  ~(n < m)\n    ==> !j. 0 <= j /\\ j <= n - m ==> (x:num->A) (n - j) IN ring_carrier r
      #|  !r (x:num->A) m n.\n        (!i. m <= i /\\ i <= n ==> x i IN ring_carrier r)\n        ==> ring_sum r (m..n) x =\n            if n < m then ring_0 r\n            else ring_sum r (0..n-m) (\\i. x(n - i))
      #|  i:K
      #|  monoidal op /\\ s = t /\\ (!i. i IN s ==> f i = g i)\n    ==> iterate op s f = iterate op t g
      #|  t' = t /\\ s' = s ==> s = t ==> s' = t'
      #|  r:D ring
      #|  x:K->L->A
      #|  t:K->L->bool
      #|  s:K->bool
      #|  !r s t (x:K->L->A).\n        FINITE s /\\\n        (!i. i IN s ==> FINITE(t i)) /\\\n        (!i j. i IN s /\\ j IN t i ==> x i j IN ring_carrier r)\n        ==> ring_sum r s (\\i. ring_sum r (t i) (x i)) =\n            ring_sum r {i,j | i IN s /\\ j IN t i} (\\(i,j). x i j)
      #|  !r (f:K->A) u v.\n        u SUBSET v /\\ (!x. x IN v /\\ ~(x IN u) ==> f x = ring_0 r)\n        ==> ring_sum r v f = ring_sum r u f
      #|  ring_sum r s' f = ring_sum r s' f' /\\\n    ring_sum r s f' = ring_sum r s' f'\n    ==> ring_sum r s' f = ring_sum r s f'
      #|  !P r s (f:K->A).\n        ring_sum r {x | x IN s /\\ P x} f =\n        ring_sum r s (\\x. if P x then f x else ring_0 r)
      #|  {x:K | x IN s /\\ ~P x}
      #|  {x:K | x IN s /\\ P x}
      #|  \\x. if P x then (f:K->A) x else g x
      #|  r:A ring
      #|  !r s P (f:K->A) g.\n        FINITE s\n        ==> ring_sum r s (\\x. if P x then f x else g x) =\n            ring_add r (ring_sum r {x | x IN s /\\ P x} f)\n                       (ring_sum r {x | x IN s /\\ ~P x} g)
      #|  r:C ring
      #|  !r (f:K->L) (g:L->A) s.\n        (!x y. x IN s /\\ y IN s /\\ f x = f y ==> x = y)\n        ==> ring_sum r (IMAGE f s) g = ring_sum r s (g o f)
      #|  ring_sum r s ((g:L->A) o (h:K->L))
      #|  !r s t (f:K->A) (g:L->A) h k.\n        (!y. y IN t ==> k y IN s /\\ h (k y) = y) /\\\n        (!x. x IN s ==> h x IN t /\\ k (h x) = x /\\ g (h x) = f x)\n        ==> ring_sum r s f = ring_sum r t g
      #|  !p r (f:num->A) m n.\n        ring_sum r (m+p..n+p) f = ring_sum r (m..n) (\\i. f(i + p))
      #|  !(r:A ring) (c:A) (s:B->bool).\n        FINITE s /\\ c IN ring_carrier r\n        ==> ring_sum r s (\\i. c) = ring_mul r (ring_of_num r (CARD s)) c
      #|  (x IN s /\\ f x = a) /\\ P x <=>\n                        x IN {x | x IN s /\\ f x = a} /\\ P x
      #|  (x IN s /\\ y IN t) /\\ a = b <=> (x IN s /\\ a = b) /\\ y IN t
      #|  r:C ring
      #|  {x | x IN s /\\ (g:K->A) x IN ring_carrier r}
      #|  g:K->A
      #|  f:K->B
      #|  !r (f:K->B) (g:K->A) s.\n         FINITE s\n         ==> ring_sum r s g =\n             ring_sum r (IMAGE f s)\n                        (\\y. ring_sum r {x | x IN s /\\ f x = y} g)
      #|  k <= n ==> SUC n - k = SUC(n - k)
      #|  ring_sum r (m+1..n+1) (\\i. f i)
      #|  a IN ring_carrier r /\\ b IN ring_carrier r /\\ c IN ring_carrier r /\\\n    d IN ring_carrier r /\\ e IN ring_carrier r /\\\n    a = e /\\ b = ring_add r c d\n    ==> ring_add r a b = ring_add r c (ring_add r d e)
      #|  0 <= n + 1
      #|  !r n x y:A.\n        x IN ring_carrier r /\\ y IN ring_carrier r\n        ==> ring_pow r (ring_add r x y) n =\n            ring_sum r (0..n)\n              (\\k. ring_mul r (ring_of_num r (binom(n,k)))\n                    (ring_mul r (ring_pow r x k) (ring_pow r y (n - k))))
      #|  x = ring_0 r /\\ y IN ring_carrier r ==> ring_mul r x y = ring_0 r
      #|  i:num
      #|  !(r:A ring) x y.\n        prime(ring_char r) /\\\n        x IN ring_carrier r /\\ y IN ring_carrier r\n         ==> ring_pow r (ring_add r x y) (ring_char r) =\n             ring_add r (ring_pow r x (ring_char r))\n                        (ring_pow r y (ring_char r))
      #|  i <= n ==> i <= SUC n
      #|  n <= SUC n
      #|  !r (f:num->A) n.\n          (!i. i <= n + 1 ==> f i IN ring_carrier r)\n          ==> ring_sum r (0..n) (\\k. ring_sub r (f k) (f(SUC k))) =\n              ring_sub r (f 0) (f(SUC n))
      #|  d:num
      #|  \\i. (f:num->A)(i + m)
      #|  r:A ring
      #|  d:num
      #|  !r (f:num->A) m n.\n        (!i. m <= i /\\ i <= n + 1 ==> f i IN ring_carrier r)\n        ==> ring_sum r (m..n) (\\k. ring_sub r (f k) (f(k + 1))) =\n            if m <= n then ring_sub r (f m) (f(n + 1)) else ring_0 r
      #|  ring_neg (r:A ring)
      #|  !r (f:num->A) m n.\n        (!i. m <= i /\\ i <= n + 1 ==> f i IN ring_carrier r)\n        ==> ring_sum r (m..n) (\\k. ring_sub r (f(k + 1)) (f k)) =\n            if m <= n then ring_sub r (f(n + 1)) (f m) else ring_0 r
      #|  i <= n ==> SUC n - i = SUC(n - i)
      #|  i:num
      #|  n:num
      #|  0
      #|  \\i. ring_mul r (ring_pow r x i:A) (ring_pow r y (SUC n - i))
      #|  r:A ring
      #|  !(r:A ring) x y n.\n        x IN ring_carrier r /\\ y IN ring_carrier r\n        ==> ring_mul r (ring_sub r x y)\n             (ring_sum r (0..n)\n                (\\i. ring_mul r (ring_pow r x i) (ring_pow r y (n - i)))) =\n             ring_sub r (ring_pow r x (SUC n)) (ring_pow r y (SUC n))
      #|  n:num
      #|  ring_1 r:A
      #|  x:A
      #|  r:A ring
      #|  !r (x:A) n.\n        x IN ring_carrier r\n        ==> ring_mul r (ring_sub r x (ring_1 r))\n                       (ring_sum r (0..n) (\\i. ring_pow r x i)) =\n            ring_sub r (ring_pow r x (SUC n)) (ring_1 r)
      #|  !r (f:K->A) g s.\n    (!a. a IN s ==> f a = g a) ==> ring_sum r s (\\i. f i) = ring_sum r s g
      #|  ring_product r s (f:K->A) =\n        iterate (\\x y. if x IN ring_carrier r /\\ y IN ring_carrier r\n                       then ring_mul r x y\n                       else if x IN ring_carrier r then y\n                       else if y IN ring_carrier r then x\n                       else @z:A. ~(z IN ring_carrier r))\n                {x | x IN s /\\ f(x) IN ring_carrier r} f
      #|  ring_1 r:A
      #|  x:A
      #|  !r:A ring.\n        neutral (\\x y. if x IN ring_carrier r /\\ y IN ring_carrier r\n                       then ring_mul r x y\n                       else if x IN ring_carrier r then y\n                       else if y IN ring_carrier r then x\n                       else @z. ~(z IN ring_carrier r)) = ring_1 r
      #|  (z:A) IN ring_carrier r
      #|  (y:A) IN ring_carrier r
      #|  (x:A) IN ring_carrier r
      #|  z:A
      #|  y:A
      #|  x:A
      #|  !r:A ring.\n        monoidal (\\x y. if x IN ring_carrier r /\\ y IN ring_carrier r\n                        then ring_mul r x y\n                        else if x IN ring_carrier r then y\n                         else if y IN ring_carrier r then x\n                        else @z. ~(z IN ring_carrier r))
      #|  r:C ring
      #|  \\x:B. x IN ring_carrier r
      #|  !r s (f:K->A). ring_product r s f IN ring_carrier r
      #|  !s f. ring_product r {a | a IN s /\\ f a IN ring_carrier r} f =\n         ring_product r s f
      #|  !s (f:K->A).\n        ring_product r {a | a IN s /\\ ~(f a = ring_1 r)} f =\n        ring_product r s f
      #|  ((p /\\ q) /\\ r) /\\ q <=> p /\\ r /\\ q
      #|  !r k (f:K->A).\n        INFINITE {i | i IN k /\\ f i IN ring_carrier r /\\ ~(f i = ring_1 r)}\n        ==> ring_product r k f = ring_1 r
      #|  {x | x IN {} /\\ P x} = {}
      #|  (!r f:K->A. ring_product r {} f = ring_1 r) /\\\n   (!r x (f:K->A) s.\n          FINITE s\n          ==> ring_product r (x INSERT s) f =\n              (if f(x) IN ring_carrier r ==> x IN s\n               then ring_product r s f\n               else ring_mul r (f x) (ring_product r s f)))
      #|  !r (f:K->A) a.\n       ring_product r {a} f = if f a IN ring_carrier r then f a else ring_1 r
      #|  ~(SUC n <= n)
      #|  m <= SUC n
      #|  m = 0
      #|  (!r m f:num->A.\n        ring_product r (m..0) f =\n        if m = 0 /\\ f 0 IN ring_carrier r then f 0 else ring_1 r) /\\\n   (!r m n f:num->A.\n        ring_product r (m..SUC n) f =\n        if m <= SUC n /\\ f(SUC n) IN ring_carrier r\n        then ring_mul r (f(SUC n)) (ring_product r (m..n) f)\n        else ring_product r (m..n) f)
      #|  (!r m f:num->A.\n        ring_product r (m..0) f =\n        if m = 0 /\\ f 0 IN ring_carrier r then f 0 else ring_1 r) /\\\n   (!r m n f:num->A.\n        ring_product r (m..SUC n) f =\n        if m <= SUC n /\\ f(SUC n) IN ring_carrier r\n        then ring_mul r (ring_product r (m..n) f) (f(SUC n))\n        else ring_product r (m..n) f)
      #|  ~(n + 1 <= n)
      #|  !r (f:num->A) m n.\n        m <= n\n        ==> ring_product r (m..n) f =\n            if f m IN ring_carrier r\n            then ring_mul r (f m) (ring_product r (m+1..n) f)\n            else ring_product r (m+1..n) f
      #|  r:C ring
      #|  !r (f:K->A) s t.\n        FINITE s /\\ FINITE t /\\ DISJOINT s t\n        ==> ring_product r (s UNION t) f =\n            ring_mul r (ring_product r s f) (ring_product r t f)
      #|  r:C ring
      #|  !r (f:K->A) s t.\n        FINITE s /\\ FINITE t\n        ==> ring_mul r (ring_product r s f) (ring_product r t f) =\n            ring_mul r (ring_product r (s UNION t) f)\n                       (ring_product r (s INTER t) f)
      #|  r:C ring
      #|  {a | a IN s /\\ (f:K->A) a IN ring_carrier r}
      #|  f:K->A
      #|  \\x:A. x IN ring_carrier r /\\ P x
      #|  !r P (f:K->A) s.\n        P(ring_1 r) /\\\n        (!x y. x IN ring_carrier r /\\ y IN ring_carrier r /\\ P x /\\ P y\n               ==> P(ring_mul r x y)) /\\\n        (!a. a IN s ==> P(f a))\n        ==> P(ring_product r s f)
      #|  p /\\ q /\\ r ==> s <=> p /\\ q ==> r ==> s
      #|  !r R (f:K->A) g s.\n        R (ring_1 r) (ring_1 r)/\\\n        (!x y x' y'. x IN ring_carrier r /\\ y IN ring_carrier r /\\\n                     x' IN ring_carrier r /\\ y' IN ring_carrier r /\\\n                     R x y /\\ R x' y'\n                     ==> R (ring_mul r x x') (ring_mul r y y')) /\\\n        FINITE s /\\\n        (!a. a IN s\n             ==> (f a IN ring_carrier r <=> g a IN ring_carrier r) /\\\n                 R (f a) (g a))\n        ==> R (ring_product r s f) (ring_product r s g)
      #|  s = {} ==> ring_product r s f = ring_1 r
      #|  !r (f:K->A) s.\n        (!a. a IN s /\\ f a IN ring_carrier r ==> f a = ring_1 r)\n        ==> ring_product r s f = ring_1 r
      #|  !r s. ring_product r s (\\i:K. ring_1 r):A = ring_1 r
      #|  s:K->bool
      #|  s:K->bool
      #|  FINITE(s:K->bool)
      #|  FINITE(s:K->bool)
      #|  (\\x. ring_0 r):K->A
      #|  s:K->bool
      #|  r:A ring
      #|  trivial_ring(r:A ring)
      #|  !r s. ring_product r s (\\i:K. ring_0 r):A =\n         if s = {} \\/ INFINITE s then ring_1 r else ring_0 r
      #|  !r (f:K->A) (g:K->A) s.\n        FINITE s /\\\n        (!a. a IN s ==> f a IN ring_carrier r /\\ g a IN ring_carrier r)\n        ==> ring_product r s (\\x. ring_mul r (f x) (g x)) =\n            ring_mul r (ring_product r s f) (ring_product r s g)
      #|  r:C ring
      #|  {a | a IN s /\\ (g:K->A) a IN ring_carrier r} =\n    {a | a IN s /\\ (f:K->A) a IN ring_carrier r}
      #|  !r (f:K->A) g s.\n       (!a. a IN s ==> f a = g a) ==> ring_product r s f = ring_product r s g
      #|  i IN s ==> {j | j IN s /\\ j = i} = {i}
      #|  ~((p /\\ q) /\\ ~q)
      #|  (a:A) IN ring_carrier r
      #|  a:A = ring_1 r
      #|  ~(i IN s) ==> {j | (j IN s /\\ j = i /\\ P j) /\\ Q j} = {}
      #|  (i:K) IN s
      #|  (if p then q else T) <=> p ==> q
      #|  !r s (i:K) (a:A).\n        ring_product r s (\\j. if j = i then a else ring_1 r) =\n        if i IN s /\\ a IN ring_carrier r then a else ring_1 r
      #|  t:K->bool
      #|  a:K
      #|  !r (x:A) (s:K->bool).\n     FINITE s /\\ x IN ring_carrier r\n     ==> ring_product r s (\\i. x) = ring_pow r x (CARD s)
      #|  ring_product r s (\\y:A. ring_mul r x y) =\n     ring_mul r (ring_product r s (\\y:A. x)) (ring_product r s (\\y:A. y))
      #|  !r (x:A) (s:A->bool).\n     FINITE s /\\ x IN ring_carrier r /\\\n     (!y. y IN s ==> y IN ring_carrier r)\n     ==> ring_product r s (\\y. ring_mul r x y) =\n         ring_mul r (ring_pow r x (CARD s)) (ring_product r s (\\y. y))
      #|  !r (f:K->L->A) s t.\n        FINITE s /\\ FINITE t /\\\n        (!i j. i IN s /\\ j IN t ==> f i j IN ring_carrier r)\n        ==> ring_product r s (\\i. ring_product r t (f i)) =\n            ring_product r t (\\j. ring_product r s (\\i. f i j))
      #|  r:C ring
      #|  n:num
      #|  m:num
      #|  x:num->A
      #|  {x | P x /\\ f x IN s} = {x | P x /\\ (P x ==> f x IN s)}
      #|  ~(n < m)\n    ==> !j. 0 <= j /\\ j <= n - m ==> (x:num->A) (n - j) IN ring_carrier r
      #|  !r (x:num->A) m n.\n        (!i. m <= i /\\ i <= n ==> x i IN ring_carrier r)\n        ==> ring_product r (m..n) x =\n            if n < m then ring_1 r\n            else ring_product r (0..n-m) (\\i. x(n - i))
      #|  !r (f:K->A) u v.\n        u SUBSET v /\\ (!x. x IN v /\\ ~(x IN u) ==> f x = ring_1 r)\n        ==> ring_product r v f = ring_product r u f
      #|  ring_product r s' f = ring_product r s' f' /\\\n    ring_product r s f' = ring_product r s' f'\n    ==> ring_product r s' f = ring_product r s f'
      #|  !P r s (f:K->A).\n        ring_product r {x | x IN s /\\ P x} f =\n        ring_product r s (\\x. if P x then f x else ring_1 r)
      #|  {x:K | x IN s /\\ ~P x}
      #|  {x:K | x IN s /\\ P x}
      #|  \\x. if P x then (f:K->A) x else g x
      #|  r:A ring
      #|  !r s P (f:K->A) g.\n        FINITE s\n        ==> ring_product r s (\\x. if P x then f x else g x) =\n            ring_mul r (ring_product r {x | x IN s /\\ P x} f)\n                       (ring_product r {x | x IN s /\\ ~P x} g)
      #|  r:C ring
      #|  !r (f:K->L) (g:L->A) s.\n        (!x y. x IN s /\\ y IN s /\\ f x = f y ==> x = y)\n        ==> ring_product r (IMAGE f s) g = ring_product r s (g o f)
      #|  ring_product r s ((g:L->A) o (h:K->L))
      #|  !r s t (f:K->A) (g:L->A) h k.\n        (!y. y IN t ==> k y IN s /\\ h (k y) = y) /\\\n        (!x. x IN s ==> h x IN t /\\ k (h x) = x /\\ g (h x) = f x)\n        ==> ring_product r s f = ring_product r t g
      #|  !p r (f:num->A) m n.\n        ring_product r (m+p..n+p) f = ring_product r (m..n) (\\i. f(i + p))
      #|  (x IN s /\\ f x = a) /\\ P x <=>\n                        x IN {x | x IN s /\\ f x = a} /\\ P x
      #|  (x IN s /\\ y IN t) /\\ a = b <=> (x IN s /\\ a = b) /\\ y IN t
      #|  r:C ring
      #|  {x | x IN s /\\ (g:K->A) x IN ring_carrier r}
      #|  g:K->A
      #|  f:K->B
      #|  !r (f:K->B) (g:K->A) s.\n         FINITE s\n         ==> ring_product r s g =\n             ring_product r (IMAGE f s)\n                            (\\y. ring_product r {x | x IN s /\\ f x = y} g)
      #|  !(r:A ring) s (e:K->num) a.\n      FINITE s /\\ a IN ring_carrier r\n      ==> ring_pow r a (nsum s e) = ring_product r s (\\i. ring_pow r a (e i))
      #|  !r (f:K->A) g s.\n    (!a. a IN s ==> f a = g a)\n    ==> ring_product r s (\\i. f i) = ring_product r s g
      #|  ring_divides r (a:A) b <=>\n        a IN ring_carrier r /\\ b IN ring_carrier r /\\\n        ?x. x IN ring_carrier r /\\ b = ring_mul r a x
      #|  ring_zerodivisor r (a:A) <=>\n        a IN ring_carrier r /\\\n        ?x. x IN ring_carrier r /\\ ~(x = ring_0 r) /\\\n            ring_mul r a x = ring_0 r
      #|  ring_regular r (a:A) <=> a IN ring_carrier r /\\ ~(ring_zerodivisor r a)
      #|  ring_nilpotent r (a:A) <=>\n        a IN ring_carrier r /\\ ?n. ~(n = 0) /\\ ring_pow r a n = ring_0 r
      #|  ring_unit r (a:A) <=>\n        a IN ring_carrier r /\\\n        ?x. x IN ring_carrier r /\\ ring_mul r a x = ring_1 r
      #|  ring_associates r (a:A) b <=> ring_divides r a b /\\ ring_divides r b a
      #|  ring_coprime r (a:A,b) <=>\n        a IN ring_carrier r /\\ b IN ring_carrier r /\\\n        !d. ring_divides r d a /\\ ring_divides r d b ==> ring_unit r d
      #|  ring_inv r (a:A) =\n        if ring_unit r a\n        then @x. x IN ring_carrier r /\\ ring_mul r a x = ring_1 r\n        else ring_0 r
      #|  ring_div r (a:A) b = ring_mul r a (ring_inv r b)
      #|  !r a b:A.\n        ring_divides r a b <=>\n        a IN ring_carrier r /\\ b IN ring_carrier r /\\\n        ?x. x IN ring_carrier r /\\ b = ring_mul r x a
      #|  !r a b:A.\n        ring_divides r a b\n        ==> a IN ring_carrier r /\\ b IN ring_carrier r
      #|  !r a:A. ring_zerodivisor r a ==> a IN ring_carrier r
      #|  !r a:A. ring_regular r a ==> a IN ring_carrier r
      #|  !r a:A. ring_nilpotent r a ==> a IN ring_carrier r
      #|  !r a:A. ring_unit r a ==> a IN ring_carrier r
      #|  !r a a':A. ring_associates r a a'\n              ==> a IN ring_carrier r /\\ a' IN ring_carrier r
      #|  !r a b:A.\n        ring_coprime r (a,b)\n        ==> a IN ring_carrier r /\\ b IN ring_carrier r
      #|  (a:A) IN ring_carrier r
      #|  ring_unit r (a:A)
      #|  (!r a:A. a IN ring_carrier r ==> (ring_inv r a) IN ring_carrier r) /\\\n   (!r a:A. ring_unit r a ==> ring_mul r a (ring_inv r a) = ring_1 r)
      #|  !r a:A. ring_unit r a ==> ring_mul r (ring_inv r a) a = ring_1 r
      #|  !r a b:A. a IN ring_carrier r /\\ b IN ring_carrier r\n             ==> ring_div r a b IN ring_carrier r
      #|  (!(r:A ring). ring_0 r IN ring_carrier r) /\\\n   (!(r:A ring). ring_1 r IN ring_carrier r) /\\\n   (!(r:A ring) n. ring_of_num r n IN ring_carrier r) /\\\n   (!(r:A ring) x. x IN ring_carrier r ==> ring_neg r x IN ring_carrier r) /\\\n   (!(r:A ring) x. x IN ring_carrier r ==> ring_inv r x IN ring_carrier r) /\\\n   (!(r:A ring) x y.\n        x IN ring_carrier r /\\ y IN ring_carrier r\n        ==> ring_add r x y IN ring_carrier r) /\\\n   (!(r:A ring) x y.\n        x IN ring_carrier r /\\ y IN ring_carrier r\n        ==> ring_sub r x y IN ring_carrier r) /\\\n   (!(r:A ring) x y.\n        x IN ring_carrier r /\\ y IN ring_carrier r\n        ==> ring_mul r x y IN ring_carrier r) /\\\n   (!(r:A ring) x y.\n        x IN ring_carrier r /\\ y IN ring_carrier r\n        ==> ring_div r x y IN ring_carrier r) /\\\n   (!(r:A ring) x n. x IN ring_carrier r\n                     ==> ring_pow r x n IN ring_carrier r)
      #|  ring_mul r (ring_mul r a c) b:A
      #|  ring_mul r (ring_mul r a b) c:A
      #|  c:A
      #|  !r a b:A.\n        a IN ring_carrier r /\\ b IN ring_carrier r /\\\n        ring_mul r a b = ring_1 r\n        ==> ring_inv r a = b
      #|  !r a b:A.\n        a IN ring_carrier r /\\ b IN ring_carrier r /\\\n        ring_mul r a b = ring_1 r\n        ==> ring_inv r b = a
      #|  !r:A ring. ring_inv r (ring_1 r) = ring_1 r
      #|  !r x:A. x IN ring_carrier r ==> ring_div r x (ring_1 r) = x
      #|  !(r:A ring) x.\n        x IN ring_carrier r ==> ring_div r (ring_1 r) x = ring_inv r x
      #|  !r x:A. ~ring_unit r x ==> ring_inv r x = ring_0 r
      #|  ring_mul r (ring_mul r a (ring_inv r a))\n               (ring_mul r b (ring_inv r b)):A
      #|  ~ring_unit r (b:A)
      #|  ring_unit r (b:A)
      #|  ~ring_unit r (a:A)
      #|  ring_unit r (a:A)
      #|  !r a b:A.\n        a IN ring_carrier r /\\ b IN ring_carrier r\n        ==> ring_inv r (ring_mul r a b) =\n            ring_mul r (ring_inv r a) (ring_inv r b)
      #|  !r (x:A) n.\n        x IN ring_carrier r\n        ==> ring_inv r (ring_pow r x n) = ring_pow r (ring_inv r x) n
      #|  !r (x:A) n.\n        x IN ring_carrier r\n        ==> ring_pow r (ring_inv r x) n = ring_inv r (ring_pow r x n)
      #|  !r a:A. ring_unit r a ==> ring_inv r (ring_inv r a) = a
      #|  !r x:A.\n        x IN ring_carrier r\n        ==> (ring_mul r x (ring_inv r x) = ring_1 r <=> ring_unit r x)
      #|  !r x:A.\n        x IN ring_carrier r\n        ==> (ring_mul r (ring_inv r x) x = ring_1 r <=> ring_unit r x)
      #|  !r a:A. ring_unit r a <=> ring_divides r a (ring_1 r)
      #|  !r:A ring. ring_unit r (ring_0 r) <=> trivial_ring r
      #|  x:A
      #|  !r:A ring. ring_inv r (ring_0 r) = ring_0 r
      #|  ring_1 r:A
      #|  !r:A ring. ring_unit r (ring_1 r)
      #|  ring_neg r x':A
      #|  x':A
      #|  !r x:A. ring_unit r x ==> ring_unit r (ring_neg r x)
      #|  !r x:A.\n        x IN ring_carrier r\n        ==> (ring_unit r (ring_neg r x) <=> ring_unit r x)
      #|  ring_inv r (x':A)
      #|  x':A
      #|  !r x:A. ring_unit r x ==> ring_unit r (ring_inv r x)
      #|  ring_mul r (ring_mul r x x') (ring_mul r y y'):A
      #|  ring_mul r x' y':A
      #|  y':A
      #|  x':A
