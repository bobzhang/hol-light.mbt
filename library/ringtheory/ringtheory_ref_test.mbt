      #|  !k (r:K->A ring).\n        FINITE(ring_carrier(product_ring k r)) <=>\n        FINITE {i | i IN k /\\ ~trivial_ring(r i)} /\\\n        !i. i IN k ==> FINITE(ring_carrier(r i))
