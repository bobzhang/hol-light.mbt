      #|  ring_mul (poly_ring r (:1)) (g1:(1->num)->A) h1 =\n      ring_mul (poly_ring r (:1))\n       (poly_const r (ring_mul r c1 c2)) (f:(1->num)->A)
      #|  ring_fractionate (r:A ring) {a | ring_regular r a} =\n      (frc:A->(A#A->bool))
      #|  (h1 : ((Unit) -> Num) -> A)
      #|  (c2 : A)
      #|  (h' : ((Unit) -> Num, (A, A)) -> Bool)
