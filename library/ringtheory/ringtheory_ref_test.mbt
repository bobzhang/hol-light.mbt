      #|  j:V
      #|  i:V = a
      #|  i:V
      #|  i:V
      #|  monomial_le (<<) (n0:V->num) m0
      #|  n0:V->num = \\b. if m0(b) < n(b) /\\ b << (a:V) then m0(b) else n b
      #|  i:V
      #|  n = monomial_mul (monomial_var a) (n0:V->num)
      #|  n0:V->num = \\b. if b = a then m0(a) else (n:V->num) b
      #|  (n:V->num)(a) = m0(a) + 1
      #|  n:V->num
      #|  m0:V->num
      #|  a:V
      #|  (!x y. Q x y ==> R x y) ==> (!x y. P x y /\\ Q x y ==> R x y)
      #|  a ==> b <=> a ==> a /\\ b
      #|  !P. (!m. m IN w /\\ (!m'. monomial_lt (<<) m' m ==> P m') ==> P m)\n           ==> !m:V->num. m IN w ==> P m
      #|  !m:V->num. m IN w ==> P m
      #|  P:(V->num)->bool
      #|  !m. monomial (:V) m ==> m IN w
      #|  !m:V->num. w m <=> m IN w
      #|  !m. monomial (:V) m /\\ (!m'. monomial_lt (<<) m' m ==> w m') ==> w m
      #|  w:(V->num)->bool
      #|  (<<):V->V->bool
      #|  !x:V z:V. x <<< z ==> x << z \\/ ?y:V. x <<< y /\\ y << z
      #|  \\y:V. ?z:V. P z /\\ z <<< y
      #|  P:V->bool
      #|  p /\\ (p ==> q) ==> p /\\ q
      #|  monomial_lt((<<<):V->V->bool)
      #|  (!x y. x << y ==> x <<< y) /\\\n      (!(x:V) y z. x <<< y /\\ y <<< z ==> x <<< z)
      #|  (<<<):V->V->bool
      #|  (<<):V->V->bool
      #|  !(<<):V->V->bool.\n        WF(<<) /\\\n        (\\m1 m2. monomial (:V) m1 /\\ monomial (:V) m2 /\\\n                 !i. m2 i < m1 i ==> ?j. i << j /\\ m1 j < m2 j) =\n        monomial_le (<<)\n        ==> WF(monomial_lt(<<))
      #|  !(<<):V->V->bool. WF(<<) ==> WF(monomial_lt(<<))
      #|  (<<=):V->V->bool
      #|  !(<<=). woset(<<=) /\\ fld(<<=) = (:V) ==> woset(monomial_le(<<=))
      #|  (\\v. z):1->A
      #|  (f:1->A) one
      #|  !P. (?f. P (f one) f) <=> (?z:A. P z (\\v. z))
      #|  (p <=> q) <=> (~p <=> ~q)
      #|  !P. (!f. P (f one) f) <=> (!z:A. P z (\\v. z))
      #|  (\\v:1. a:A) = (\\v. b) <=> a = b
      #|  !f:1->num c. f = (\\v:1. c) <=> f one = c
      #|  !m:1->num. m = (\\v:1. m one)
      #|  (\\v:1. (m:1->num) one) = m
      #|  (m:1->num) one
      #|  m:1->num
      #|  IMAGE (\\(d:num) (v:1). d) {d | P(\\v:1. d)}
      #|  (\\v:1. d):1->num
      #|  d:num
      #|  IMAGE (\\(m:1->num). m one) {m | P m}
      #|  !P. FINITE {m:1->num | P m} <=> FINITE {d:num | P(\\v:1. d)}
      #|  i:num
      #|  (m1:1->num) one
      #|  m2:1->num
      #|  m1:1->num
      #|  !n. {(m1,m2) | monomial_mul m1 m2 = (\\v:1. n)} =\n       IMAGE (\\i. ((\\v:1. i), (\\v:1. n - i))) (0..n)
      #|  coeff = \\i (p:(1->num)->A). p(\\v:1. i)
      #|  !i (p:(1->num)->A). coeff i p = p(\\v:1. i)
      #|  !p:(1->num)->A. coeff 0 p = p(monomial_1)
      #|  m:1->num = (\\v:1. (m:1->num) one)
      #|  m:1->num
      #|  !(p:(1->num)->A) q. (!d. coeff d p = coeff d q) <=> p = q
      #|  !r p. ring_polynomial r p <=>\n         ring_powerseries r p /\\ FINITE {i | ~(coeff i p:A = ring_0 r)}
      #|  (m:1->num) one
      #|  m:1->num
      #|  !r (p:(1->num)->A).\n        ring_powerseries r p <=> (!d. coeff d p IN ring_carrier r)
      #|  !r (p:(1->num)->A) d.\n        ring_powerseries r p ==> coeff d p IN ring_carrier r
      #|  !r (p:(1->num)->A) d.\n        ring_polynomial r p ==> coeff d p IN ring_carrier r
      #|  !r (p:(1->num)->A).\n        ring_polynomial r p <=>\n        (!d. coeff d p IN ring_carrier r) /\\\n        FINITE {d | ~(coeff d p = ring_0 r)}
      #|  !(h:A->B) p i. coeff i (h o p) = h(coeff i p)
      #|  !r c d. coeff d (poly_const r c :(1->num)->A) =\n           if d = 0 then c else ring_0 r
      #|  !r d. coeff d (poly_0 r :(1->num)->A) = ring_0 r
      #|  !r d. coeff d (poly_1 r :(1->num)->A) =\n         if d = 0 then ring_1 r else ring_0 r
      #|  !r d x. coeff d (poly_var r x) = if d = 1 then ring_1 r else ring_0 r
      #|  !r p d. coeff d (poly_neg r p :(1->num)->A) = ring_neg r (coeff d p)
      #|  !r p q d. coeff d (poly_add r p q :(1->num)->A) =\n             ring_add r (coeff d p) (coeff d q)
      #|  !r p q d. coeff d (poly_sub r p q :(1->num)->A) =\n             ring_sub r (coeff d p) (coeff d q)
      #|  \\(i:num,j:num). (\\v:1. i),(\\v:1. j)
      #|  \\(m1,m2). m1 one:num,m2 one:num
      #|  !(r:A ring) p q d.\n        coeff d (poly_mul r p q :(1->num)->A) =\n        ring_sum r {i,j | i,j | i + j = d}\n                   (\\(i,j). ring_mul r (coeff i p) (coeff j q))
      #|  !r p q d. coeff d (poly_mul r p q :(1->num)->A) =\n             ring_sum r (0..d)\n                        (\\a. ring_mul r (coeff a p) (coeff (d - a) q))
      #|  k:num
      #|  one
      #|  (:1)
      #|  r:A ring
      #|  !(r:A ring) x k d.\n        coeff d (poly_pow r (poly_var r x) k) =\n        if d = k then ring_1 r else ring_0 r
      #|  a:num
      #|  !a. ring_mul r (if a = 0 then c else ring_0 r)\n                    (coeff (d - a) (p:(1->num)->A)) =\n        if a = 0 then ring_mul r c (coeff d p) else ring_0 r
      #|  !r c (p:(1->num)->A) d.\n        c IN ring_carrier r /\\ ring_powerseries r p\n        ==> coeff d (poly_mul r (poly_const r c) p) =\n            ring_mul r c (coeff d p)
      #|  !r c (p:(1->num)->A) d.\n        c IN ring_carrier r /\\ ring_powerseries r p\n        ==> coeff d (poly_mul r p (poly_const r c)) =\n            ring_mul r (coeff d p) c
      #|  1 <= d <=> ~(d = 0)
      #|  !r (p:(1->num)->A) x d.\n        ring_powerseries r p\n        ==> coeff d (poly_mul r (poly_var r x) p) =\n            if d = 0 then ring_0 r else coeff (d - 1) p
      #|  !r (p:(1->num)->A) x d.\n        ring_powerseries r p\n        ==> coeff d (poly_mul r p (poly_var r x)) =\n            if d = 0 then ring_0 r else coeff (d - 1) p
      #|  !r (p:(1->num)->A) x k d.\n        ring_powerseries r p\n        ==> coeff d (poly_mul r (poly_pow r (poly_var r x) k) p) =\n            if d < k then ring_0 r else coeff (d - k) p
      #|  !r (p:(1->num)->A) x k d.\n        ring_powerseries r p\n        ==> coeff d (poly_mul r p (poly_pow r (poly_var r x) k)) =\n            if d < k then ring_0 r else coeff (d - k) p
      #|  m:1->num = (\\v:1. m one)
      #|  m:1->num
      #|  !r (p:(1->num)->R) q.\n      poly_mul r p q =\n      \\m. ring_sum r (0..m one)\n              (\\i. ring_mul r (coeff i p) (coeff (m one - i) q))
      #|  !r G (p:(1->num)->A).\n        ring_polynomial r p /\\\n        (!d. coeff d p IN ring_carrier(subring_generated r G))\n        ==> ring_polynomial (subring_generated r G) p
      #|  !r (p:(1->num)->A).\n        ring_polynomial r p ==> FINITE {d | ~(coeff d p = ring_0 r)}
      #|  {d:num | d <= n}
