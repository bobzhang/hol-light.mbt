      #|  !s r r' (h:A->B) p (x:V->B).\n        ring_homomorphism(r,r') h /\\\n        {m | ~(p m = ring_0 r)} SUBSET s\n        ==> poly_extend (r,r') h x (p:(V->num)->A) =\n            ring_sum r' s (\\m. ring_mul r' (h (p m))\n                                (ring_product r' (monomial_vars m)\n                                         (\\i. ring_pow r' (x i) (m i))))
