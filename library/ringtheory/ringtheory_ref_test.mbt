      #|  poly_var (r:A ring) (v:V) =\n        \\m:V->num. if m = monomial_var v then ring_1 r else ring_0 r
      #|  !r (p:(V->num)->A) q. poly_sub r p q = poly_add r p (poly_neg r q)
      #|  !r p m. ring_powerseries r p /\\ ~(p m:A = ring_0 r) ==> monomial (:V) m
      #|  !r p m. ring_polynomial r p /\\ ~(p m:A = ring_0 r) ==> monomial (:V) m
      #|  !r. poly_0 r :(V->num)->A = \\m. ring_0 r
      #|  !r:A ring. poly_const r (ring_0 r):(V->num)->A = poly_0 r
      #|  !r:A ring. poly_const r (ring_1 r):(V->num)->A = poly_1 r
      #|  !r c. ring_powerseries r (poly_const r c :(V->num)->A) <=>\n         c IN ring_carrier r
      #|  !r v. ring_powerseries r (poly_var r v:(V->num)->A)
      #|  !r. ring_powerseries r (poly_0 r:(V->num)->A)
      #|  !r. ring_powerseries r (poly_1 r:(V->num)->A)
      #|  !(r:A ring) (v:V).\n     (poly_var r v:(V->num)->A) monomial_1 = ring_0 r
      #|  !r (p:(V->num)->A).\n        ring_powerseries r p ==> ring_powerseries r (poly_neg r p)
      #|  !r p1 (p2:(V->num)->A).\n        ring_powerseries r p1 /\\ ring_powerseries r p2\n        ==> ring_powerseries r (poly_add r p1 p2)
      #|  !r p1 (p2:(V->num)->A).\n        ring_powerseries r p1 /\\ ring_powerseries r p2\n        ==> ring_powerseries r (poly_sub r p1 p2)
      #|  m:V->num
      #|  !r p1 (p2:(V->num)->A).\n        ring_powerseries r p1 /\\ ring_powerseries r p2\n        ==> ring_powerseries r (poly_mul r p1 p2)
      #|  {(monomial_1:V->num)}
      #|  q ==> (p /\\ q <=> p)
      #|  !r c. ring_polynomial r (poly_const r c :(V->num)->A) <=>\n         c IN ring_carrier r
      #|  {(monomial_var v:V->num)}
      #|  !r v. ring_polynomial r (poly_var r v:(V->num)->A)
      #|  !(r:A ring) (v:V) c.\n        poly_var r v = poly_const r c <=> trivial_ring r /\\ c = ring_0 r
      #|  monomial_1:V->num
      #|  monomial_var (v:V)
      #|  !r. ring_polynomial r (poly_0 r:(V->num)->A)
      #|  !r. ring_polynomial r (poly_1 r:(V->num)->A)
      #|  !r (p:(V->num)->A).\n        ring_polynomial r p ==> ring_polynomial r (poly_neg r p)
      #|  !r p1 (p2:(V->num)->A).\n        ring_polynomial r p1 /\\ ring_polynomial r p2\n        ==> ring_polynomial r (poly_add r p1 p2)
      #|  !r p1 (p2:(V->num)->A).\n        ring_polynomial r p1 /\\ ring_polynomial r p2\n        ==> ring_polynomial r (poly_sub r p1 p2)
      #|  m2:V->num
      #|  m1:V->num
      #|  m2:V->num
      #|  m1:V->num
      #|  m:V->num
      #|  { monomial_mul m1 m2 |\n                m1 IN {m | ~((p1:(V->num)->A) m = ring_0 r)} /\\\n                m2 IN {m | ~((p2:(V->num)->A) m = ring_0 r)}}
      #|  !r p1 (p2:(V->num)->A).\n        ring_polynomial r p1 /\\ ring_polynomial r p2\n        ==> ring_polynomial r (poly_mul r p1 p2)
      #|  m:V->num
      #|  !r p1 (p2:(V->num)->A).\n        ring_powerseries r p1 /\\ ring_powerseries r p2\n        ==> poly_add r p1 p2 = poly_add r p2 p1
      #|  m:V->num
      #|  !r p1 p2 (p3:(V->num)->A).\n      ring_powerseries r p1 /\\\n      ring_powerseries r p2 /\\\n      ring_powerseries r p3\n      ==> poly_add r p1 (poly_add r p2 p3) = poly_add r (poly_add r p1 p2) p3
      #|  m:V->num
      #|  !r (p:(V->num)->A).\n        ring_powerseries r p\n        ==> poly_add r (poly_0 r) p = p
      #|  !r (p:(V->num)->A).\n        ring_powerseries r p\n        ==> poly_add r p (poly_0 r) = p
      #|  m:V->num
      #|  !r (p:(V->num)->A).\n        ring_powerseries r p\n        ==> poly_add r (poly_neg r p) p = poly_0 r
      #|  p /\\ (p ==> q) ==> p /\\ q
      #|  \\(m:V->num,m':V->num). (m',m)
      #|  m:V->num
      #|  !r p1 (p2:(V->num)->A).\n        ring_powerseries r p1 /\\ ring_powerseries r p2\n        ==> poly_mul r p1 p2 = poly_mul r p2 p1
      #|  m2:V->num
      #|  m1:V->num
      #|  x = ring_0 r /\\ y = ring_0 r /\\ z = ring_0 r\n      ==> z = ring_add r x y
      #|  FINITE(monomial_vars(m:V->num))
      #|  m:V->num
      #|  !r p1 p2 (p3:(V->num)->A).\n      ring_powerseries r p1 /\\\n      ring_powerseries r p2 /\\\n      ring_powerseries r p3\n      ==> poly_mul r p1 (poly_add r p2 p3) =\n          poly_add r (poly_mul r p1 p2) (poly_mul r p1 p3)
      #|  {(monomial_1:V->num,m:V->num)}
      #|  !t. ring_sum r t f = a /\\ ring_sum r s f = ring_sum r t f\n        ==> ring_sum r s f = a
      #|  m:V->num
      #|  !r (p:(V->num)->A).\n        ring_powerseries r p\n        ==> poly_mul r (poly_1 r) p = p
      #|  !r (p:(V->num)->A).\n        ring_powerseries r p\n        ==> poly_mul r p (poly_1 r) = p
      #|  \\(m1:V->num,m3:V->num,m4:V->num). (m1,monomial_mul m3 m4),(m3,m4)
      #|  \\((m1:V->num,m2:V->num),(m3:V->num,m4:V->num)). (m1,m3,m4)
      #|  m2:V->num
      #|  m1:V->num
      #|  \\(m1:V->num,m:V->num) (m2:V->num,m3:V->num).\n          ring_mul (r:A ring) (p1 m1)\n                   (ring_mul r (p2 m2) (p3 m3))
      #|  \\(m1:V->num,m). {m2,m3 | monomial_mul m2 m3:V->num = m}
      #|  {m1,m2 | monomial_mul m1 m2:V->num = m}
      #|  r:A ring
      #|  x IN ring_carrier r /\\ y = ring_0 r\n          ==> ring_mul r x y = ring_0 r
      #|  ring_sum r s f = ring_0 r /\\ ring_sum r t g = ring_0 r\n        ==> ring_sum r s f = ring_sum r t g
      #|  FINITE(monomial_vars m:V->bool)
      #|  m:V->num
      #|  !r p1 p2 (p3:(V->num)->A).\n      ring_powerseries r p1 /\\ ring_powerseries r p2 /\\ ring_powerseries r p3\n      ==> poly_mul r p1 (poly_mul r p2 p3) =\n          \\m. ring_sum r\n               {(m1,m2,m3) | monomial_mul m1 (monomial_mul m2 m3) = m}\n               (\\(m1,m2,m3). ring_mul r (p1 m1) (ring_mul r (p2 m2) (p3 m3)))
      #|  \\(m3:V->num,m1:V->num,m2:V->num). m1,m2,m3
      #|  \\(m1:V->num,m2:V->num,m3:V->num). m3,m1,m2
      #|  m:V->num
      #|  !r p1 p2 (p3:(V->num)->A).\n      ring_powerseries r p1 /\\ ring_powerseries r p2 /\\ ring_powerseries r p3\n      ==> poly_mul r p1 (poly_mul r p2 p3) = poly_mul r (poly_mul r p1 p2) p3
      #|  (!r (p:(V->num)->A).\n        ring_powerseries r p ==> poly_mul r p (poly_0 r) = poly_0 r) /\\\n   (!r (q:(V->num)->A).\n        ring_powerseries r q ==> poly_mul r (poly_0 r) q = poly_0 r)
      #|  (!r (p:(V->num)->A).\n        ring_polynomial r p ==> poly_mul r p (poly_0 r) = poly_0 r) /\\\n   (!r (q:(V->num)->A).\n        ring_polynomial r q ==> poly_mul r (poly_0 r) q = poly_0 r)
      #|  {x,y | x = a /\\ y = b} = {(a,b)}
      #|  !r (p:(V->num)->A) q.\n        ring_powerseries r p /\\ ring_powerseries r q\n        ==> poly_mul r p q monomial_1 =\n            ring_mul r (p monomial_1) (q monomial_1)
      #|  !r (p:(V->num)->A) q.\n        ring_polynomial r p /\\ ring_polynomial r q\n        ==> poly_mul r p q monomial_1 =\n            ring_mul r (p monomial_1) (q monomial_1)
      #|  {f x y | x = a /\\ y = b} = {f a b}
      #|  monomial_mul m1 m2 = m /\\ m1 = monomial_1 <=>\n     m1 = monomial_1 /\\ m2 = m
      #|  {p | p IN {f x y |x,y| P x y} /\\ Q p} =\n                        {f x y |x,y| P x y /\\ Q(f x y)}
      #|  m:V->num
      #|  !r c (p:(V->num)->A).\n        c IN ring_carrier r /\\ ring_powerseries r p\n        ==> poly_mul r (poly_const r c) p = \\m. ring_mul r c (p m)
      #|  !r c (p:(V->num)->A).\n        c IN ring_carrier r /\\ ring_polynomial r p\n        ==> poly_mul r (poly_const r c) p = \\m. ring_mul r c (p m)
      #|  monomial_mul m1 m2 = m <=> monomial_divides m1 m /\\ monomial_div m m1 = m2
      #|  {f a b |P a b /\\ a = c} = IMAGE (f c) {b | P c b}
      #|  {x | x IN {f a b | P a b} /\\ Q x} =\n                        {f a b |a,b| P a b /\\ Q(f a b)}
      #|  m:V->num
      #|  !r (p:(V->num)->A) x.\n        ring_powerseries r p\n        ==> poly_mul r (poly_var r x) p =\n            \\m. if monomial_divides (monomial_var x) m\n                then p(monomial_div m (monomial_var x))\n                else ring_0 r
      #|  !r (p:(V->num)->A) x.\n        ring_powerseries r p\n        ==> poly_mul r p (poly_var r x) =\n            \\m. if monomial_divides (monomial_var x) m\n                then p(monomial_div m (monomial_var x))\n                else ring_0 r
      #|  !r (p:(V->num)->A) x.\n        ring_polynomial r p\n        ==> poly_mul r (poly_var r x) p =\n            \\m. if monomial_divides (monomial_var x) m\n                then p(monomial_div m (monomial_var x))\n                else ring_0 r
      #|  !r (p:(V->num)->A) x.\n        ring_polynomial r p\n        ==> poly_mul r p (poly_var r x) =\n            \\m. if monomial_divides (monomial_var x) m\n                then p(monomial_div m (monomial_var x))\n                else ring_0 r
      #|  c:A = ring_0 r
      #|  ~(if p then q else T) <=> p /\\ ~q
      #|  !(r:A ring) c. poly_vars r (poly_const r c) = {}
      #|  !r:A ring. poly_vars r (poly_0 r) = {}
      #|  !r:A ring. poly_vars r (poly_1 r) = {}
      #|  ~(if p then q else T) <=> p /\\ ~q
      #|  !(r:A ring) (v:V).\n        poly_vars r (poly_var r v) =\n        if trivial_ring r then {} else {v}
      #|  !r (p:(V->num)->A).\n        ring_powerseries r p ==> poly_vars r (poly_neg r p) = poly_vars r p
      #|  !r (p1:(V->num)->A) (p2:(V->num)->A).\n        ring_powerseries r p1 /\\ ring_powerseries r p2\n        ==> poly_vars r (poly_add r p1 p2) SUBSET\n            poly_vars r p1 UNION poly_vars r p2
      #|  ~(ring_mul r x y = ring_0 r)\n    ==> x IN ring_carrier r /\\ y IN ring_carrier r\n        ==> ~(x = ring_0 r) /\\ ~(y = ring_0 r)
      #|  m:V->num
      #|  x:V
      #|  !r (p1:(V->num)->A) (p2:(V->num)->A).\n        ring_powerseries r p1 /\\ ring_powerseries r p2\n        ==> poly_vars r (poly_mul r p1 p2) SUBSET\n            poly_vars r p1 UNION poly_vars r p2
      #|  !r (p:(V->num)->A). ring_polynomial r p ==> FINITE(poly_vars r p)
      #|  powser_ring (r:A ring) (s:V->bool) =\n        ring({p | ring_powerseries r p /\\ poly_vars r p SUBSET s},\n             poly_0 r,poly_1 r,poly_neg r,poly_add r,poly_mul r)
      #|  poly_ring (r:A ring) (s:V->bool) =\n        ring({p | ring_polynomial r p /\\ poly_vars r p SUBSET s},\n             poly_0 r,poly_1 r,poly_neg r,poly_add r,poly_mul r)
      #|  (!(r:A ring) (s:V->bool).\n        ring_carrier(powser_ring r s) =\n        {p | ring_powerseries r p /\\ poly_vars r p SUBSET s}) /\\\n   (!(r:A ring) (s:V->bool). ring_0(powser_ring r s) = poly_0 r) /\\\n   (!(r:A ring) (s:V->bool). ring_1(powser_ring r s) = poly_1 r) /\\\n   (!(r:A ring) (s:V->bool). ring_neg(powser_ring r s) = poly_neg r) /\\\n   (!(r:A ring) (s:V->bool). ring_add(powser_ring r s) = poly_add r) /\\\n   (!(r:A ring) (s:V->bool). ring_mul(powser_ring r s) = poly_mul r)
      #|  !(r:A ring) (s:V->bool).\n        {p | ring_polynomial r p /\\ poly_vars r p SUBSET s}\n        subring_of powser_ring r s
      #|  !(r:A ring) (s:V->bool).\n        poly_ring r s =\n        subring_generated (powser_ring r s)\n                          {p | ring_polynomial r p /\\ poly_vars r p SUBSET s}
      #|  !(r:A ring) (s:V->bool).\n        poly_ring r s =\n        subring_generated (powser_ring r s) {p | ring_polynomial r p}
      #|  !(r:A ring) (s:V->bool).\n           poly_ring r s =\n           subring_generated (powser_ring r s)\n                             {p | FINITE {m | ~(p m = ring_0 r)}}
      #|  !(r:A ring) (s:V->bool).\n        ring_carrier(poly_ring r s) subring_of powser_ring r s
      #|  !r s:A->bool. ring_monomorphism(poly_ring r s,powser_ring r s) (\\x. x)
      #|  (!(r:A ring) (s:V->bool).\n        ring_carrier(poly_ring r s) =\n        {p | ring_polynomial r p /\\ poly_vars r p SUBSET s}) /\\\n   (!(r:A ring) (s:V->bool). ring_0(poly_ring r s) = poly_0 r) /\\\n   (!(r:A ring) (s:V->bool). ring_1(poly_ring r s) = poly_1 r) /\\\n   (!(r:A ring) (s:V->bool). ring_neg(poly_ring r s) = poly_neg r) /\\\n   (!(r:A ring) (s:V->bool). ring_add(poly_ring r s) = poly_add r) /\\\n   (!(r:A ring) (s:V->bool). ring_mul(poly_ring r s) = poly_mul r)
      #|  !(r:A ring) (v:V->bool) p.\n        p IN ring_carrier(poly_ring r v)\n        ==> p IN ring_carrier(powser_ring r v)
      #|  poly_pow (r:A ring) = ring_pow (powser_ring r (:V))
      #|  (!r p. poly_pow r (p:(V->num)->A) 0 = poly_1 r) /\\\n   (!r p n. poly_pow r (p:(V->num)->A) (SUC n) =\n            poly_mul r p (poly_pow r p n))
      #|  !r:A ring. poly_pow r = ring_pow (poly_ring r (:V))
      #|  !r (p:(V->num)->A) n.\n        ring_powerseries r p ==> ring_powerseries r (poly_pow r p n)
      #|  !r (p:(V->num)->A) n.\n        ring_polynomial r p ==> ring_polynomial r (poly_pow r p n)
      #|  !r n. poly_pow r (poly_1 r:(V->num)->A) n = poly_1 r
      #|  !r n. poly_pow r (poly_0 r:(V->num)->A) n =\n         if n = 0 then poly_1 r else poly_0 r
      #|  !r (p:(V->num)->A) n.\n        ring_powerseries r p\n        ==> poly_vars r (poly_pow r p n) SUBSET poly_vars r p
      #|  (!(r:A ring) (s:V->bool).\n        ring_carrier(powser_ring r s) =\n        {p | ring_powerseries r p /\\ poly_vars r p SUBSET s}) /\\\n   (!(r:A ring) (s:V->bool). ring_0(powser_ring r s) = poly_0 r) /\\\n   (!(r:A ring) (s:V->bool). ring_1(powser_ring r s) = poly_1 r) /\\\n   (!(r:A ring) (s:V->bool). ring_neg(powser_ring r s) = poly_neg r) /\\\n   (!(r:A ring) (s:V->bool). ring_add(powser_ring r s) = poly_add r) /\\\n   (!(r:A ring) (s:V->bool). ring_sub(powser_ring r s) = poly_sub r) /\\\n   (!(r:A ring) (s:V->bool). ring_mul(powser_ring r s) = poly_mul r) /\\\n   (!(r:A ring) (s:V->bool). ring_pow(powser_ring r s) = poly_pow r)
      #|  (!(r:A ring). {p | ring_powerseries r p} =\n                 ring_carrier (powser_ring r (:V))) /\\\n   (!(r:A ring). poly_0 r = ring_0 (powser_ring r (:V))) /\\\n   (!(r:A ring). poly_1 r = ring_1 (powser_ring r (:V))) /\\\n   (!(r:A ring). poly_neg r = ring_neg (powser_ring r (:V))) /\\\n   (!(r:A ring). poly_add r = ring_add (powser_ring r (:V))) /\\\n   (!(r:A ring). poly_sub r = ring_sub (powser_ring r (:V))) /\\\n   (!(r:A ring). poly_mul r = ring_mul (powser_ring r (:V))) /\\\n   (!(r:A ring). poly_pow r = ring_pow (powser_ring r (:V)))
      #|  (!(r:A ring) (s:V->bool).\n        ring_carrier(poly_ring r s) =\n        {p | ring_polynomial r p /\\ poly_vars r p SUBSET s}) /\\\n   (!(r:A ring) (s:V->bool). ring_0(poly_ring r s) = poly_0 r) /\\\n   (!(r:A ring) (s:V->bool). ring_1(poly_ring r s) = poly_1 r) /\\\n   (!(r:A ring) (s:V->bool). ring_neg(poly_ring r s) = poly_neg r) /\\\n   (!(r:A ring) (s:V->bool). ring_add(poly_ring r s) = poly_add r) /\\\n   (!(r:A ring) (s:V->bool). ring_sub(poly_ring r s) = poly_sub r) /\\\n   (!(r:A ring) (s:V->bool). ring_mul(poly_ring r s) = poly_mul r) /\\\n   (!(r:A ring) (s:V->bool). ring_pow(poly_ring r s) = poly_pow r)
      #|  (!(r:A ring). {p | ring_polynomial r p} = ring_carrier (poly_ring r (:V))) /\\\n   (!(r:A ring). poly_0 r = ring_0 (poly_ring r (:V))) /\\\n   (!(r:A ring). poly_1 r = ring_1 (poly_ring r (:V))) /\\\n   (!(r:A ring). poly_neg r = ring_neg (poly_ring r (:V))) /\\\n   (!(r:A ring). poly_add r = ring_add (poly_ring r (:V))) /\\\n   (!(r:A ring). poly_sub r = ring_sub (poly_ring r (:V))) /\\\n   (!(r:A ring). poly_mul r = ring_mul (poly_ring r (:V))) /\\\n   (!(r:A ring). poly_pow r = ring_pow (poly_ring r (:V)))
      #|  (!(r:A ring) s (v:V->bool).\n        ring_0 (poly_ring (subring_generated r s) v) =\n        ring_0 (poly_ring r v)) /\\\n   (!(r:A ring) s (v:V->bool).\n        ring_1 (poly_ring (subring_generated r s) v) =\n        ring_1 (poly_ring r v)) /\\\n   (!(r:A ring) s (v:V->bool).\n        ring_neg (poly_ring (subring_generated r s) v) =\n        ring_neg (poly_ring r v)) /\\\n   (!(r:A ring) s (v:V->bool).\n        ring_add (poly_ring (subring_generated r s) v) =\n        ring_add (poly_ring r v)) /\\\n   (!(r:A ring) s (v:V->bool) p q.\n        (!m. p m IN ring_carrier(subring_generated r s)) /\\\n        (!m. q m IN ring_carrier(subring_generated r s))\n        ==> ring_mul (poly_ring (subring_generated r s) v) p q =\n            ring_mul (poly_ring r v) p q) /\\\n   (!(r:A ring) s (v:V->bool).\n        ring_sub (poly_ring (subring_generated r s) v) =\n        ring_sub (poly_ring r v))
      #|  !r s c:A. poly_const (subring_generated r s) a = poly_const r a
      #|  !r s (p:(V->num)->A) m.\n        p IN ring_carrier (powser_ring r s) ==> p m IN ring_carrier r
      #|  !r s (p:(V->num)->A) m.\n        p IN ring_carrier (poly_ring r s) ==> p m IN ring_carrier r
      #|  !(r:A ring) p. ring_polynomial r p <=> p IN ring_carrier(poly_ring r (:V))
      #|  !(r:A ring) p.\n        ring_powerseries r p <=> p IN ring_carrier(powser_ring r (:V))
      #|  !(r:A ring) (s:V->bool).\n        p IN ring_carrier(poly_ring r s) <=>\n        ring_polynomial r p /\\ poly_vars r p SUBSET s
      #|  !(r:A ring) (s:V->bool) p.\n        poly_vars r p SUBSET s\n        ==> (ring_polynomial r p <=> p IN ring_carrier(poly_ring r s))
      #|  !r (p:(V->num)->A).\n        ring_polynomial r p <=>\n        p IN ring_carrier(poly_ring r (poly_vars r p))
      #|  !(r:A ring) (s:V->bool).\n        p IN ring_carrier(poly_ring r s)\n        ==> FINITE {m | ~(p m = ring_0 r)}
      #|  !(r:A ring) (s:V->bool) p.\n        p IN ring_carrier(poly_ring r s) ==> FINITE(poly_vars r p)
      #|  !(r:A ring) (s:V->bool).\n           ring_carrier(poly_ring r s) =\n           ring_carrier(powser_ring r s) INTER\n           {p | FINITE {m | ~(p m = ring_0 r)}}
      #|  !r s t (p:(V->num)->A).\n        s SUBSET t /\\ p IN ring_carrier(powser_ring r s)\n        ==> p IN ring_carrier(powser_ring r t)
      #|  !r s t (p:(V->num)->A).\n        s SUBSET t /\\ p IN ring_carrier(poly_ring r s)\n        ==> p IN ring_carrier(poly_ring r t)
      #|  !r (p:(V->num)->A).\n        p IN ring_carrier(poly_ring r (poly_vars r p)) <=>\n        ring_polynomial r p
      #|  !(r:A ring) (v:V->bool) p.\n        p IN ring_carrier(poly_ring r v)\n        ==> p IN ring_carrier(poly_ring r (poly_vars r p))
      #|  !r v (p:(V->num)->A).\n        p IN ring_carrier(poly_ring r v)\n        ==> ?w. FINITE w /\\ w SUBSET v /\\ p IN ring_carrier(poly_ring r w)
      #|  ring_0 r INSERT IMAGE (p:(V->num)->A) {m | ~(p m = ring_0 r)}
      #|  IMAGE (p:(V->num)->A) UNIV
      #|  s:A->bool
      #|  r:A ring
      #|  !r s v (p:(V->num)->A).\n        p IN ring_carrier(poly_ring (subring_generated r s) v)\n        ==> ?t. FINITE t /\\\n                t SUBSET s /\\\n                p IN ring_carrier(poly_ring (subring_generated r t) v)
      #|  !(r:A ring) (s:V->bool) i.\n        poly_var r i IN ring_carrier(poly_ring r s) <=>\n        trivial_ring r \\/ i IN s
