      #|  forall(f:A->B) (g:A->C) r r' K.\n        ring_homomorphism(r,prod_ring r' K) (\\x. f x,g x) <=>\n        ring_homomorphism(r,r') f /\\\n        ring_homomorphism(r,K) g
