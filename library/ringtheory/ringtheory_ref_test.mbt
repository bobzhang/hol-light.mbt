      #|  !r a x y:A.\n        integral_domain r /\\\n        a IN ring_carrier r /\\\n        x IN ring_carrier r /\\ y IN ring_carrier r\n        ==> (ring_mul r a x = ring_mul r a y <=>\n             a = ring_0 r \\/ x = y)
      #|  !r a x y:A.\n        integral_domain r /\\\n        a IN ring_carrier r /\\ ~(a = ring_0 r) /\\\n        x IN ring_carrier r /\\ y IN ring_carrier r /\\\n        ring_mul r x a = ring_mul r y a\n        ==> x = y
      #|  !r a x y:A.\n        integral_domain r /\\\n        a IN ring_carrier r /\\\n        x IN ring_carrier r /\\ y IN ring_carrier r\n        ==> (ring_mul r x a = ring_mul r y a <=>\n             x = y \\/ a = ring_0 r)
