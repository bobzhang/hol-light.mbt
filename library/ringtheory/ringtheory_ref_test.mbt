      #|  \226\136\128 r : Ring[A], \226\136\128 p : ((V) -> Num) -> A, \226\136\128 x : (V) -> A, IN(poly_evaluate(r, p, x), ring_carrier(r))
      #|  \226\136\128 r : Ring[A], \226\136\128 x : (V) -> A, poly_evaluate(r, poly_0(r), x) == ring_0(r)
