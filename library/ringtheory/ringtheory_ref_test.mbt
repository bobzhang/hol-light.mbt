      #|  \\x:K->A. RESTRICTION {i | i IN k /\\ ~trivial_ring((r:K->A ring) i)} x
      #|  !k (r:K->A ring).\n        product_ring {i | i IN k /\\ ~trivial_ring(r i)} r isomorphic_ring\n        product_ring k r
      #|  r = s ==> r isomorphic_ring s
      #|  !k l (r:K->A ring).\n        (!i. i IN (k DIFF l) UNION (l DIFF k) ==> trivial_ring(r i))\n        ==> product_ring k r isomorphic_ring product_ring l r
      #|  (r':L->B ring) (f(i:K))
      #|  (r:K->A ring) (g(j:L))
      #|  i:K
      #|  j:L
