      #|  q:(1->num)->A
      #|  d:(1->num)->A
      #|  !(k:A ring) p.\n    field k /\\\n    p IN ring_carrier (poly_ring k (:1)) /\\\n    ~(p = ring_0 (poly_ring k (:1))) /\\\n    CARD {x | x IN ring_carrier k /\\ poly_eval k p x = ring_0 k} = poly_deg k p\n    ==> ring_squarefree (poly_ring k (:1)) p
      #|  (poly_const r (pp:A)):(V->num)->A
      #|  poly_ring (r:A ring) (s:V->bool)
