      #|  !r s a:A.\n        s SUBSET ring_carrier r /\\ a IN ring_carrier r\n        ==> ideal_generated r (IMAGE (ring_mul r a) s) =\n            IMAGE (ring_mul r a) (ideal_generated r s)
