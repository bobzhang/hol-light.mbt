      #|  p:(1->num)->A
      #|  k:A ring
      #|  s:(1->num)->A
      #|  !(k:A ring) (p:(1->num)->A) f.\n        field k /\\ ring_char k = 0 /\\\n        ring_irreducible (poly_ring k (:1)) p\n        ==> (ring_divides (poly_ring k (:1)) p f /\\\n             ring_divides (poly_ring k (:1)) p (poly_deriv k f) <=>\n             ring_divides (poly_ring k (:1)) (poly_pow k p 2) f)
      #|  q:(1->num)->A
