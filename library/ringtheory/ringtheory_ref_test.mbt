      #|  !r (p:(1->num)->A) n.\n        ring_powerseries r p /\\\n        (!d. n <= d ==> coeff d p = ring_0 r)\n        ==> ring_polynomial r p
      #|  poly_deg r (p:(V->num)->A) =\n        minimal d. !m. ~(p m = ring_0 r) ==> monomial_deg m <= d
