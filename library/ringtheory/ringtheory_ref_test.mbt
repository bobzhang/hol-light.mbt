      #|  !r (p:(1->num)->A) n.\n        ring_powerseries r p /\\\n        (!d. ~(coeff d p = ring_0 r) ==> d <= n)\n        ==> poly_deg r p <= n
      #|  !r (p:(1->num)->A) n.\n        ring_polynomial r p\n        ==> (n <= poly_deg r p <=>\n             n = 0 \\/ ?d. ~(coeff d p = ring_0 r) /\\ n <= d)
      #|  !r (p:(1->num)->A) d n.\n        ring_polynomial r p /\\\n        ~(coeff d p = ring_0 r) /\\ n <= d\n        ==> n <= poly_deg r p
      #|  !r (p:(1->num)->A) n.\n        ring_polynomial r p\n        ==> (poly_deg r p = n <=>\n             (!d. ~(coeff d p = ring_0 r) ==> d <= n) /\\\n             (n = 0 \\/ ~(coeff n p = ring_0 r)))
      #|  n:num
