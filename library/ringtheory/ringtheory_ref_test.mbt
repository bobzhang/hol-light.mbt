      #|  !r (p:(1->num)->A) n.\n        ring_powerseries r p /\\\n        (!d. ~(coeff d p = ring_0 r) ==> d <= n) /\\\n        ~(coeff n p = ring_0 r)\n        ==> poly_deg r p = n
      #|  !r (p:(1->num)->A) n.\n        ring_polynomial r p /\\\n        poly_deg r p <= n /\\\n        ~(coeff n p = ring_0 r)\n        ==> poly_deg r p = n
      #|  !r (p:K->(1->num)->A) d (s:K->bool).\n        FINITE s /\\ (!x. x IN s ==> ring_powerseries r (p x))\n        ==> coeff d (ring_sum (powser_ring r (:1)) s p) =\n            ring_sum r s (\\x. coeff d (p x))
      #|  !r (p:K->(1->num)->A) d (s:K->bool).\n        FINITE s /\\ (!x. x IN s ==> ring_polynomial r (p x))\n        ==> coeff d (ring_sum (poly_ring r (:1)) s p) =\n            ring_sum r s (\\x. coeff d (p x))
      #|  !r (p:(V->num)->A).\n        ring_polynomial r p ==> poly_deg r (poly_neg r p) = poly_deg r p
      #|  x <= MAX m n <=> x <= m \\/ x <= n
      #|  !r (p:(V->num)->A) q.\n        ring_polynomial r p /\\ ring_polynomial r q\n        ==> poly_deg r (poly_add r p q) <= MAX (poly_deg r p) (poly_deg r q)
      #|  !r (p:(V->num)->A) q.\n        ring_polynomial r p /\\ ring_polynomial r q\n        ==> poly_deg r (poly_sub r p q) <= MAX (poly_deg r p) (poly_deg r q)
      #|  ring_sub r (ring_add r x y) y:A = x
      #|  ring_sub r (ring_add r x y) x:A = y
      #|  q:(V->num)->A
      #|  poly_add r p q:(V->num)->A
