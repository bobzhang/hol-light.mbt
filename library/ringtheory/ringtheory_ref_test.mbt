      #|  !(r:A ring) (s:V->bool) i.\n        poly_var r i IN ring_carrier(powser_ring r s) <=>\n        trivial_ring r \\/ i IN s
      #|  !(r:A ring) i. poly_var r i IN ring_carrier (powser_ring r (:V))
      #|  !(r:A ring) (s:V->bool) c.\n        poly_const r c IN ring_carrier(powser_ring r s) <=>\n        c IN ring_carrier r
