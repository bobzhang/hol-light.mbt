    @tactics.prove(
      @parser.parse_term(
        "!r (a:A) p.\n        a IN ring_carrier r /\\\n        p IN ring_carrier(poly_ring r (:1)) /\\\n        poly_eval r p a = ring_0 r\n        ==> ring_divides (poly_ring r (:1))\n                         (poly_sub r (poly_var r one) (poly_const r a)) p",
