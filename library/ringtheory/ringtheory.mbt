    @list.List([ring_isomorphism(), @theorems.left_imp_exists_thm()]),
  )
  let t11835 = @simp.rewrite_tac(@list.List([isomorphic_ring()]))
  let t11840 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), t11835),
          t11836,
        ),
        t11837,
      ),
      t11838,
    ),
    t11839,
  )
  isomorphic_ring_euclideanness_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!(r:A ring) (r':B ring).\n        r isomorphic_ring r' ==> (euclidean_ring r <=> euclidean_ring r')",
      ),
      t11840,
    ),
  )
}

