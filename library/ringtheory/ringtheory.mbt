///|
/// RING_SUM_CLOSED
fn step_137() -> Unit raise {
  let t472 = @simp.asm_simp_tac(
    @list.List([
      neutral_ring_add(),
      @theorems.imp_imp(),
      ring_0_v1(),
      ring_add_v1(),
      @sets.in_elim_thm(),
    ]),
  )
  let t469 = @bool.ispec(@parser.parse_term("r:C ring"), monoidal_ring_add())
  let t470 = @drule.match_mp(
    @simp.rewrite_rule(@list.List([@theorems.right_imp_forall_thm()]))(
      @iterate.iterate_closed(),
    ),
  )(t469)
  let t467 = @parser.parse_term("{a | a IN s /\\ (f:K->A) a IN ring_carrier r}")
  let t468 = @parser.parse_term("f:K->A")
  let t471 = @tactics.mp_tac(
    @bool.ispecl(
      @list.List([
        @parser.parse_term("\\x:A. x IN ring_carrier r /\\ P x"),
        t468,
        t467,
      ]),
      t470,
    ),
  )
  let t466 = @simp.rewrite_tac(@list.List([ring_sum()]))
  let t473 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t466),
      t471,
    ),
    t472,
  )
  ring_sum_closed_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!r P (f:K->A) s.\n        P(ring_0 r) /\\\n        (!x y. x IN ring_carrier r /\\ y IN ring_carrier r /\\ P x /\\ P y\n               ==> P(ring_add r x y)) /\\\n        (!a. a IN s ==> P(f a))\n        ==> P(ring_sum r s f)",
      ),
      t473,
    ),
  )
}

