        let th_p = ring_monomorphic_image_rule(hth)(tm_1)
        let utm = if ths_p == @list.empty() {
          @kernel.rand(@kernel.concl(th_p))
        } else {
          let t5603 = @kernel.rand(@kernel.concl(th_p))
          @bool.mk_imp(
            @bool.list_mk_conj(
              @lib.map(
                fn(x5602 : @kernel.Thm) -> @kernel.Term raise {
                  @kernel.concl(x5602)
                },
                ths_p,
