  let ring_ring_horn : (@kernel.Term) -> @kernel.Thm raise = fn(
    x5623 : @kernel.Term,
  ) -> @kernel.Thm raise {
    let tm_2 = x5623
    if !@basics.is_disj(tm_2) {
      ring_ring_word(@list.empty())(tm_2)
    } else {
      let th0 = ddj_conv(tm_2)
      let tm_p = @kernel.rand(@kernel.concl(th0))
      let abod = @equal.lhand(tm_p)
      let ths_1 = @bool.conjuncts_rule(@kernel.assume_rule(abod))
      let t5624 = @kernel.rand(tm_p)
      let th1_3 = ring_ring_word(ths_1)(t5624)
      let t5625 = @bool.disch(abod, @lib.itlist(@bool.prove_hyp, ths_1, th1_3))
      @kernel.eq_mp(@equal.sym(th0), t5625)
