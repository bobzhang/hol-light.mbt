  let t3171 = @parser.parse_term("ring_mul(r:A ring)")
  let t3172 = @parser.parse_term("ring_inv(r:A ring)")
  let t3173 = @parser.parse_term("ring_sub(r:A ring)")
  let t3174 = @parser.parse_term("ring_add(r:A ring)")
  let (basic_rule, idealconv) = @grobner.ring_and_ideal_conv(
