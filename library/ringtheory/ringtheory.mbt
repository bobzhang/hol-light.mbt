  let rule_div : (@kernel.Term) -> @kernel.Thm raise = @drule.part_match(
    @kernel.rand,
    ring_div_v1(),
  )
  ring_carrier_rule_c.set(fn(
    x3068 : @list.List[@kernel.Thm],
  ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    let asm_ = x3068
    let rule_nullary : (@kernel.Term) -> @kernel.Thm raise = fn(
      x3070 : @kernel.Term,
    ) -> @kernel.Thm raise {
      let tm = x3070
