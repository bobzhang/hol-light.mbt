      @parser.parse_term(
        "!(f:((V->num)->A)->B) g r v r'.\n        ring_homomorphism (poly_ring r v,r') f /\\\n        ring_homomorphism (poly_ring r v,r') g /\\\n        (!c. c IN ring_carrier r ==> f(poly_const r c) = g(poly_const r c)) /\\\n        (!x. x IN v ==> f(poly_var r x) = g(poly_var r x))\n        ==> !p. p IN ring_carrier(poly_ring r v) ==> f p = g p",
