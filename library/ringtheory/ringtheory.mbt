  ])
  let t12674 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.thenl(
        @tactics.then_tac(
          @tactics.repeat_tac(@tactics.gen_tac),
          @tactics.eq_tac,
        ),
        t12671,
      ),
      t12672,
    ),
    t12673,
  )
  ring_gcd_eq_1_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!r a b:A.\n        ring_gcd r (a,b) = ring_1 r <=>\n        a IN ring_carrier r /\\ b IN ring_carrier r ==> ring_coprime r (a,b)",
      ),
      t12674,
    ),
  )
}

