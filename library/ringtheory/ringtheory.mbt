///|
/// UNIQUE_PRIME_IDEAL
fn step_1212() -> Unit raise {
  let t10070 = @tactics.asm_tac(@sets.set_tac)(
    @list.List([ring_nilpotent_unit(), ring_unit(), ring_nilpotent()]),
  )
  let t10069 = @simp.asm_simp_tac(
    @list.List([unions_prime_ideals(), inters_prime_ideals(), radical_0()]),
  )
  let t10067 = @simp.rewrite_tac(
    @list.List([@sets.exists_unique_unions_inters()]),
  )
  let t10068 = @list.List([
    @meson.asm_meson_tac(@list.List([prime_ideal_exists()])),
    t10067,
  ])
  let t10071 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.thenl(
        @tactics.then_tac(
          @tactics.gen_tac,
          @class.asm_cases_tac(@parser.parse_term("trivial_ring(r:A ring)")),
        ),
        t10068,
      ),
      t10069,
    ),
    t10070,
  )
  unique_prime_ideal_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!r:A ring.\n        (?!j. prime_ideal r j) <=>\n        ~(trivial_ring r) /\\\n        !x. x IN ring_carrier r ==> ring_unit r x \\/ ring_nilpotent r x",
      ),
      t10071,
    ),
  )
}

