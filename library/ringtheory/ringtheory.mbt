  let t632 = @list.List([
    @tactics.then_tac(
      @tactics.then_tac(@tactics.ap_thm_tac, @tactics.ap_term_tac),
      t629,
    ),
    t631,
  ])
  let t628 = @tactics.match_mp_tac(@theorems.eq_imp())
  let t626 = @sets.set_tac(@list.empty())
  let t627 = @list.List([
    @tactics.then_tac(
      @simp.asm_simp_tac(@list.List([@sets.finite_restrict()])),
      t626,
    ),
    @tactics.all_tac,
  ])
  let t622 = @parser.parse_term("{x:K | x IN s /\\ ~P x}")
  let t623 = @parser.parse_term("{x:K | x IN s /\\ P x}")
  let t624 = @parser.parse_term("\\x. if P x then (f:K->A) x else g x")
  let t625 = @tactics.mp_tac(
    @bool.ispecl(
      @list.List([@parser.parse_term("r:A ring"), t624, t623, t622]),
      ring_sum_union(),
