  let pth_1 = @class.taut(@parser.parse_term("p ==> q <=> (p \\/ q <=> q)"))
  let ptm = @parser.parse_term("p:bool")
  let qtm = @parser.parse_term("q:bool")
  let ring_ring_core : (@kernel.Term) -> @kernel.Thm raise = fn(
    x5626 : @kernel.Term,
  ) -> @kernel.Thm raise {
    let tm_3 = x5626
    let (negdjs, posdjs) = @lib.partition(
      fn(x5627 : @kernel.Term) -> Bool raise { @basics.is_neg(x5627) },
      @basics.disjuncts(tm_3),
    )
    let th_1 = @lib.tryfind(
      fn(x5628 : @kernel.Term) -> @kernel.Thm raise {
        let p = x5628
        ring_ring_horn(@bool.list_mk_disj(negdjs.prepend(p)))
      },
      posdjs,
    )
    let th1_4 = @kernel.inst_rule(
      @list.List([(@kernel.concl(th_1), ptm), (tm_3, qtm)]),
      pth_1,
