///|
/// UFD_EQ_ATOMIC
fn step_1222() -> Unit raise {
  let t10529 = @meson.asm_meson_tac(
    @list.List([
      ufd_irreducible_eq_prime(),
      ufd(),
      integral_domain_prime_imp_irreducible(),
    ]),
