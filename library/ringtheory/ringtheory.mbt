    @tactics.prove(
      @parser.parse_term(
        "!r (f:K->A) u v.\n        u SUBSET v /\\ (!x. x IN v /\\ ~(x IN u) ==> f x = ring_0 r)\n        ==> ring_sum r v f = ring_sum r u f",
      ),
      t614,
    ),
  )
}

