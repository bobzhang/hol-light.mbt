///|
/// UFD
fn step_1213() -> Unit raise {
  ufd_c.set(
    @pair.new_definition(
      @parser.parse_term(
        "UFD (r:A ring) <=>\n        integral_domain r /\\\n        !j. prime_ideal r j /\\ ~(j = {ring_0 r})\n            ==> ?p. ring_prime r p /\\ p IN j",
      ),
    ),
  )
}

