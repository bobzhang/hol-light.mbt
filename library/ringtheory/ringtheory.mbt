///|
/// POLY_EXTEND_EQ
fn step_1708() -> Unit raise {
  let t16560 = @meson.asm_meson_tac(
    @list.List([poly_monomials(), monomial(), @sets.subset()]),
  )
  let t16559 = @tactics.match_mp_tac(ring_product_eq())
  let t16558 = @list.List([
    @meson.asm_meson_tac(@list.List([poly_monomial_in_carrier()])),
    @tactics.all_tac,
  ])
  let t16557 = @tactics.repeat_tac(@tactics.strip_tac)
  let t16556 = @simp.rewrite_tac(@list.List([@sets.forall_in_gspec()]))
  let t16555 = @tactics.match_mp_tac(ring_sum_eq())
  let t16554 = @simp.rewrite_tac(@list.List([poly_extend()]))
  let t16561 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.thenl(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(
                @tactics.then_tac(
                  @tactics.repeat_tac(@tactics.strip_tac),
                  t16554,
                ),
                t16555,
              ),
              t16556,
            ),
            t16557,
          ),
          @tactics.binop_tac,
        ),
        t16558,
      ),
      t16559,
    ),
    t16560,
  )
  poly_extend_eq_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!r r' s (h:A->B) k (x:V->B) y p.\n        (!i. i IN s ==> x i IN ring_carrier r') /\\\n        (!a. a IN ring_carrier r ==> h a = k a) /\\\n        (!i. i IN s ==> x i = y i) /\\\n        p IN ring_carrier(poly_ring r s)\n        ==> poly_extend(r,r') h x p = poly_extend(r,r') k y p",
      ),
      t16561,
    ),
  )
}

