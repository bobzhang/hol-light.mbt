      ring_homomorphism_i(),
      poly_extend_from_subring_generated(),
    ]),
  )
  let t20624 = @parser.parse_term("a:A")
  let t20625 = @parser.parse_term("l:A ring")
  let t20626 = @parser.parse_term("subring_generated l k:A ring")
  let t20627 = @tactics.mp_tac(
    @bool.ispecl(
      @list.List([@parser.parse_term("I:A->A"), t20626, t20625, t20624]),
      image_poly_extend_1(),
    ),
  )
  let t20623 = @simp.rewrite_tac(
    @list.List([poly_eval(), poly_evaluate(), @class.eta_ax()]),
  )
  let t20629 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t20623),
      t20627,
    ),
    t20628,
  )
  image_poly_eval_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!l k a:A.\n        k subring_of l /\\ a IN ring_carrier l\n        ==> IMAGE (\\p. poly_eval l p a)\n                  (ring_carrier(poly_ring (subring_generated l k) (:1))) =\n            ring_carrier (subring_generated l (a INSERT k))",
      ),
      t20629,
    ),
  )
}

