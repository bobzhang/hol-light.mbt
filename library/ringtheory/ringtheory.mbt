///|
/// CARD_EQ_RING_COSETS
fn step_894() -> Unit raise {
  let t5743 = @sets.set_tac(@list.empty())
  let t5742 = @tactics.match_mp_tac(@theorems.mono_exists())
  let t5744 = @tactics.then_tac(
    @tactics.then_tac(
      @simp.rewrite_tac(
        @list.List([@sets.eq_c(), @theorems.left_forall_imp_thm()]),
      ),
      t5742,
    ),
    t5743,
  )
  let lemma = @tactics.prove(
    @parser.parse_term(
      "!f g. (IMAGE f s = t /\\ IMAGE g t = s) /\\\n           (!x y. x IN s /\\ y IN s /\\ f x = f y ==> x = y)\n     ==> s =_c t",
    ),
    t5744,
  )
  let t5751 = @meson.asm_meson_tac(
    @list.List([
      ring_sub_v1(),
      @sets.subset(),
      ring_coset_v1(),
      subring_of_imp_subset(),
      ring_ideal_imp_subset(),
    ]),
  )
  let t5750 = @tactics.match_mp_tac(ring_add_lcancel())
  let t5749 = @tactics.repeat_tac(@tactics.strip_tac)
  let t5748 = @simp.asm_simp_tac(
    @list.List([image_ring_coset_switch(), @sets.injective_on_alt()]),
  )
  let t5747 = @tactics.exists_tac(
    @parser.parse_term("\\a:A. ring_add r (ring_sub r x y) a"),
  )
  let t5746 = @tactics.exists_tac(
    @parser.parse_term("\\a:A. ring_add r (ring_sub r y x) a"),
  )
  let t5745 = @tactics.match_mp_tac(lemma)
  let t5752 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t5745),
              t5746,
            ),
            t5747,
          ),
          t5748,
        ),
        t5749,
      ),
      t5750,
    ),
    t5751,
  )
  card_eq_ring_cosets_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!r j x y:A.\n        (ring_ideal r j \\/ j subring_of r) /\\\n        x IN ring_carrier r /\\ y IN ring_carrier r\n        ==> ring_coset r j x =_c ring_coset r j y",
      ),
      t5752,
    ),
  )
}

