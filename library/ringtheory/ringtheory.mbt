  "PID_EQ_INTEGRAL_DOMAIN_PRIME_PRINCIPAL",
)

///|
/// `PID_EQ_INTEGRAL_DOMAIN_PRIME_PRINCIPAL`
pub fn pid_eq_integral_domain_prime_principal() -> @kernel.Thm {
  pid_eq_integral_domain_prime_principal_c.get()
}

///|
/// TRIVIAL_QUOTIENT_RING
fn step_1164() -> Unit raise {
  let t9375 = @simp.simp_tac(@list.List([ring_sub_rzero(), ring_1_v1()]))
  let t9374 = @simp.simp_tac(
    @list.List([ring_coset_eq(), ring_0_v1(), ring_1_v1(), proper_ideal_v1()]),
  )
  let t9376 = @tactics.then_tac(
    @tactics.then_tac(
      @simp.simp_tac(@list.List([trivial_ring_10(), quotient_ring_v1()])),
      t9374,
    ),
    t9375,
  )
  trivial_quotient_ring_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!r j:A->bool.\n        ring_ideal r j\n        ==> (trivial_ring (quotient_ring r j) <=> ~proper_ideal r j)",
      ),
      t9376,
    ),
  )
