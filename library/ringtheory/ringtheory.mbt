///|
/// RING_PULL_DIV_CONV
fn step_2158() -> Unit raise {
  let t27163 = @class.taut(
    @parser.parse_term("a ==> b /\\ c <=> (a ==> b) /\\ (a ==> c)"),
  )
  let (divthms, sidethms) = @lib.chop_list(
    13,
    @bool.conjuncts_rule(
      @simp.rewrite_rule(
        @list.List([
          @theorems.forall_and_thm(),
          @theorems.imp_imp(),
          @equal.gsym(@theorems.conj_assoc()),
          @theorems.right_imp_forall_thm(),
          t27163,
        ]),
      )(ring_pull_div()),
    ),
  )
  let simpers = @lib.map(
    (x27165 : @kernel.Thm) => {
      @drule.part_match(
        fn(x27164 : @kernel.Term) -> @kernel.Term raise {
          @equal.lhand(@kernel.rand(x27164))
        },
        x27165,
      )
    },
    divthms,
  )
  let siders = @lib.map(
    (x27166 : @kernel.Thm) => @drule.part_match(@kernel.rand, x27166),
    sidethms,
  )
  ring_pull_div_conv_c.set(fn(
    x27167 : @list.List[@kernel.Thm],
  ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    let asm_ = x27167
    fn sideprove(x27169 : @kernel.Term) -> @kernel.Thm raise {
      let t = x27169
      @lib.find(
        fn(x27170 : @kernel.Thm) -> Bool raise {
          let a = x27170
          @kernel.concl(a) == t
        },
        asm_,
      ) catch {
        Failure(_) =>
          ring_carrier_rule(asm_)(t) catch {
            Failure(_) =>
              @lib.tryfind(
                fn(
                  x27171 : (@kernel.Term) -> @kernel.Thm raise,
                ) -> @kernel.Thm raise {
                  let sfn = x27171
                  let th = sfn(t)
                  let scs = @basics.conjuncts(
                    @basics.dest_imp(@kernel.concl(th)).0,
                  )
                  @bool.mp(
                    th,
                    @lib.end_itlist(@bool.conj, @lib.map(sideprove, scs)),
                  )
                },
                siders,
              )
            e => raise e
          }
        e => raise e
      }
    }
    fn(x27172 : @kernel.Term) -> @kernel.Thm raise {
      let tm = x27172
      @lib.tryfind(
        fn(x27173 : (@kernel.Term) -> @kernel.Thm raise) -> @kernel.Thm raise {
          let sfn_1 = x27173
          let th_1 = sfn_1(tm)
          let scs_1 = @basics.conjuncts(@basics.dest_imp(@kernel.concl(th_1)).0)
          @bool.mp(
            th_1,
            @lib.end_itlist(@bool.conj, @lib.map(sideprove, scs_1)),
          )
        },
        simpers,
      )
    }
  })
}

