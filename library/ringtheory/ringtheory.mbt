    @tactics.then_tac(
      @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t21799),
      t21800,
    ),
    @int.arith_tac,
  )
  poly_x_minus_a_nonzero_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!r (a:A).\n     ~trivial_ring r /\\ a IN ring_carrier r\n     ==> ~(poly_sub r (poly_var r (one:1))\n                       (poly_const r a) = poly_0 r)",
      ),
      t21801,
    ),
  )
}

