            ),
            t5603,
          )
        }
        let hvs = @basics.find_terms(
          fn(x5604 : @kernel.Term) -> Bool raise {
            let t = x5604
            @kernel.is_comb(t) &&
            @kernel.rator(t) == htm &&
            @kernel.is_var(@kernel.rand(t))
