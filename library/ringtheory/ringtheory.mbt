    @simp.asm_rewrite_tac(@list.List([ufd_eq_primefact()])),
    t10529,
  ])
  let t10528 = @class.asm_cases_tac(
    @parser.parse_term("!p:A. ring_irreducible r p <=> ring_prime r p"),
  )
  let t10531 = @tactics.thenl(
    @tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), t10528),
    t10530,
  )
  ufd_eq_atomic_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!r:A ring.\n        UFD r <=>\n        integral_domain r /\\\n        (!p. ring_irreducible r p ==> ring_prime r p) /\\\n        (!x. x IN ring_carrier r /\\ ~(x = ring_0 r)\n             ==> ?n p. (!i. 1 <= i /\\ i <= n ==> ring_irreducible r (p i)) /\\\n                       ring_associates r (ring_product r (1..n) p) x)",
      ),
      t10531,
    ),
  )
}

