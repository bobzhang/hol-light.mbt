///|
let field_tac_c : @lib.Cell[@tactics.Tactic] = @lib.Cell::new("FIELD_TAC")

///|
/// `FIELD_TAC`
pub fn field_tac(x : @tactics.Goal) -> @tactics.Goalstate raise {
  field_tac_c.get()(x)
}

///|
/// FIELD_INV_EQ_0
fn step_2155() -> Unit raise {
  field_inv_eq_0_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!f x:A. field f /\\ x IN ring_carrier f\n           ==> (ring_inv f x = ring_0 f <=> x = ring_0 f)",
      ),
      field_tac,
    ),
  )
}

///|
let field_inv_eq_0_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("FIELD_INV_EQ_0")

///|
/// `FIELD_INV_EQ_0`
pub fn field_inv_eq_0() -> @kernel.Thm {
  field_inv_eq_0_c.get()
}

///|
/// FIELD_DIV_EQ_0
fn step_2156() -> Unit raise {
  field_div_eq_0_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!f x y:A. field f /\\ x IN ring_carrier f /\\ y IN ring_carrier f\n           ==> (ring_div f x y = ring_0 f <=> x = ring_0 f \\/ y = ring_0 f)",
      ),
      field_tac,
    ),
  )
}

///|
let field_div_eq_0_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("FIELD_DIV_EQ_0")

///|
/// `FIELD_DIV_EQ_0`
pub fn field_div_eq_0() -> @kernel.Thm {
  field_div_eq_0_c.get()
}

///|
/// RING_PULL_DIV
fn step_2157() -> Unit raise {
  let t27161 = @list.List([
    @simp.simp_tac(
      @list.List([ring_div(), ring_mul_pow(), ring_pow_inv(), ring_inv_v1()]),
    ),
    field_tac,
  ])
  let t27162 = @tactics.thenl(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @simp.simp_tac(@list.List([field_pow_eq_0()])),
          @tactics.gen_tac,
        ),
        @tactics.disch_tac,
      ),
      @tactics.conj_tac,
    ),
    t27161,
  )
  ring_pull_div_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!f:A ring.\n    field f\n    ==> (!x y n. x IN ring_carrier f /\\ y IN ring_carrier f\n                 ==> ring_pow f (ring_div f x y) n =\n                     ring_div f (ring_pow f x n) (ring_pow f y n)) /\\\n        (!x1 y1 x2 y2.\n                x1 IN ring_carrier f /\\ x2 IN ring_carrier f /\\\n                y1 IN ring_carrier f /\\ y2 IN ring_carrier f\n                ==> ring_div f (ring_div f x1 y1) (ring_div f x2 y2) =\n                    ring_div f (ring_mul f x1 y2) (ring_mul f x2 y1)) /\\\n        (!x1 x2 y. x1 IN ring_carrier f /\\ x2 IN ring_carrier f /\\\n                   y IN ring_carrier f /\\ ~(y = ring_0 f)\n                   ==> ring_add f (ring_div f x1 y) (ring_div f x2 y) =\n                       ring_div f (ring_add f x1 x2) y /\\\n                       ring_sub f (ring_div f x1 y) (ring_div f x2 y) =\n                       ring_div f (ring_sub f x1 x2) y /\\\n                       (ring_div f x1 y = ring_div f x2 y <=> x1 = x2) /\\\n                       ring_add f (ring_div f x1 y) x2 =\n                       ring_div f (ring_add f x1 (ring_mul f x2 y)) y /\\\n                       ring_add f x1 (ring_div f x2 y) =\n                       ring_div f (ring_add f (ring_mul f x1 y) x2) y /\\\n                       ring_sub f (ring_div f x1 y) x2 =\n                       ring_div f (ring_sub f x1 (ring_mul f x2 y)) y /\\\n                       ring_sub f x1 (ring_div f x2 y) =\n                       ring_div f (ring_sub f (ring_mul f x1 y) x2) y /\\\n                       ring_mul f (ring_div f x1 y) x2 =\n                       ring_div f (ring_mul f x1 x2) y /\\\n                       ring_mul f x1 (ring_div f x2 y) =\n                       ring_div f (ring_mul f x1 x2) y /\\\n                       (ring_div f x1 y = x2 <=> x1 = ring_mul f x2 y) /\\\n                       (x1 = ring_div f x2 y <=> ring_mul f x1 y = x2)) /\\\n        (!x y. x IN ring_carrier f /\\ y IN ring_carrier f /\\\n               ~(x = ring_0 f) /\\ ~(y = ring_0 f)\n               ==> ~(ring_mul f x y = ring_0 f)) /\\\n        (!x n. x IN ring_carrier f /\\ ~(x = ring_0 f)\n               ==> ~(ring_pow f x n = ring_0 f))",
      ),
      t27162,
    ),
  )
}

///|
let ring_pull_div_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("RING_PULL_DIV")

