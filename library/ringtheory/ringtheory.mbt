      @parser.parse_term(
        "!r j x y:A.\n        (ring_ideal r j \\/ j subring_of r) /\\\n        x IN ring_carrier r /\\\n        y IN ring_carrier r\n        ==> (x IN ring_coset r j y <=>\n             ring_coset r j x = ring_coset r j y)",
