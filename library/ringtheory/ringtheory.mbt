///|
/// euclidean_ring
fn step_1237() -> Unit raise {
  euclidean_ring_c.set(
    @pair.new_definition(
      @parser.parse_term(
        "euclidean_ring r <=>\n        ?n:A->num.\n            !a b. a IN ring_carrier r /\\ b IN ring_carrier r /\\ ~(b = ring_0 r)\n                  ==> ?q t. q IN ring_carrier r /\\ t IN ring_carrier r /\\\n                            ring_add r (ring_mul r b q) t = a /\\\n                            (t = ring_0 r \\/ n(t) < n(b))",
      ),
    ),
  )
}

