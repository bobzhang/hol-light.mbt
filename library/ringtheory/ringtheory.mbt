        @tactics.thenl(
          @tactics.then_tac(
            @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t625),
            @tactics.ants_tac,
          ),
          t627,
        ),
        t628,
      ),
      @tactics.binop_tac,
    ),
    t632,
  )
  ring_sum_cases_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!r s P (f:K->A) g.\n        FINITE s\n        ==> ring_sum r s (\\x. if P x then f x else g x) =\n            ring_add r (ring_sum r {x | x IN s /\\ P x} f)\n                       (ring_sum r {x | x IN s /\\ ~P x} g)",
      ),
      t633,
    ),
  )
}

