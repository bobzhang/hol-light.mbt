fn step_154() -> Unit raise {
  let t630 = @sets.set_tac(@list.empty())
  let t631 = @tactics.then_tac(
    @tactics.then_tac(@tactics.binop_tac, @tactics.match_mp_tac(ring_sum_eq())),
