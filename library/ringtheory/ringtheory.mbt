///|
/// ring_homomorphism
fn step_596() -> Unit raise {
  ring_homomorphism_c.set(
    @pair.new_definition(
      @parser.parse_term(
        "ring_homomorphism (r,r') (f:A->B) <=>\n        IMAGE f (ring_carrier r) SUBSET ring_carrier r' /\\\n        f (ring_0 r) = ring_0 r' /\\\n        f (ring_1 r) = ring_1 r' /\\\n        (!x. x IN ring_carrier r\n             ==> f(ring_neg r x) = ring_neg r' (f x)) /\\\n        (!x y. x IN ring_carrier r /\\ y IN ring_carrier r\n               ==> f(ring_add r x y) = ring_add r' (f x) (f y)) /\\\n        (!x y. x IN ring_carrier r /\\ y IN ring_carrier r\n               ==> f(ring_mul r x y) = ring_mul r' (f x) (f y))",
      ),
    ),
  )
}

