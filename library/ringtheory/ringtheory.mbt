///|
/// POLY_DEG_X_MINUS_A
fn step_2002() -> Unit raise {
  let t21796 = @simp.asm_rewrite_tac(
    @list.List([
      ring_polynomial_var(),
      ring_polynomial_const(),
      poly_deg_var(),
      poly_deg_const(),
      @equal.gsym(trivial_ring_10()),
    ]),
  )
  let t21793 = @parser.parse_term("poly_const (r:A ring) (a:A):(1->num)->A")
  let t21794 = @parser.parse_term("poly_var (r:A ring) (one:1):(1->num)->A")
  let t21795 = @tactics.mp_tac(
    @bool.ispecl(
      @list.List([@parser.parse_term("r:A ring"), t21794, t21793]),
      poly_deg_sub(),
    ),
  )
  let t21797 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t21795),
      t21796,
    ),
    @int.arith_tac,
  )
  poly_deg_x_minus_a_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!r (a:A).\n     ~trivial_ring r /\\ a IN ring_carrier r\n     ==> poly_deg r (poly_sub r (poly_var r (one:1)) (poly_const r a)) = 1",
      ),
      t21797,
    ),
  )
}

