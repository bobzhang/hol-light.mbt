///|
/// RING_COSET_EQ_IDEAL
fn step_883() -> Unit raise {
  let t5670 = @simp.rewrite_tac(@list.List([@sets.not_insert_empty()]))
  let t5671 = @tactics.then_tac(
    @simp.simp_tac(
      @list.List([
        ring_coset_setadd(),
        ring_setadd_lsubset_eq(),
        @sets.sing_subset(),
      ]),
    ),
    t5670,
  )
  ring_coset_eq_ideal_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!r j x:A.\n        (ring_ideal r j \\/ j subring_of r) /\\ x IN ring_carrier r\n        ==> (ring_coset r j x = j <=> x IN j)",
      ),
      t5671,
    ),
  )
}

