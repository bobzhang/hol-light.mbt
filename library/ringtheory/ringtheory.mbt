///|
/// `RING_PULL_DIV_TAC`
pub fn ring_pull_div_tac(
  x27174 : @list.List[(String, @kernel.Thm)],
  x27175 : @kernel.Term,
) -> @tactics.Goalstate raise {
  let (asl, w) = (x27174, x27175)
  @tactics.conv_tac(
    @equal.redepth_conv(
      ring_pull_div_conv(
        @lib.map(
          fn(x27176 : (String, @kernel.Thm)) -> @kernel.Thm raise { x27176.1 },
          asl,
        ),
      ),
    ),
  )((asl, w))
}

