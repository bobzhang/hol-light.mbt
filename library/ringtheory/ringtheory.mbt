fn step_892() -> Unit raise {
  let t5721 = @simp.simp_tac(
    @list.List([@sets.pairwise(), disjoint_ring_cosets()]),
  )
  let t5722 = @tactics.then_tac(
    @simp.rewrite_tac(
      @list.List([@sets.simple_image(), @sets.pairwise_image()]),
    ),
    t5721,
  )
  pairwise_disjoint_ring_cosets_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!r j:A->bool.\n        ring_ideal r j \\/ j subring_of r\n        ==> pairwise DISJOINT {ring_coset r j x |x| x IN ring_carrier r}",
      ),
      t5722,
    ),
  )
}

