  let t474 = @simp.once_rewrite_tac(
    @list.List([
      @class.taut(
        @parser.parse_term("p /\\ q /\\ r ==> s <=> p /\\ q ==> r ==> s"),
      ),
    ]),
  )
  let t482 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(
                @tactics.then_tac(
                  @tactics.then_tac(
                    @tactics.then_tac(
                      @tactics.replicate_tac(4, @tactics.gen_tac),
                      t474,
                    ),
                    t475,
                  ),
                  @tactics.strip_tac,
                ),
                t476,
              ),
              t477,
            ),
            t478,
          ),
          t479,
        ),
        t480,
      ),
      @class.cond_cases_tac,
    ),
    t481,
  )
  ring_sum_related_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!r R (f:K->A) g s.\n        R (ring_0 r) (ring_0 r)/\\\n        (!x y x' y'. x IN ring_carrier r /\\ y IN ring_carrier r /\\\n                     x' IN ring_carrier r /\\ y' IN ring_carrier r /\\\n                     R x y /\\ R x' y'\n                     ==> R (ring_add r x x') (ring_add r y y')) /\\\n        FINITE s /\\\n        (!a. a IN s\n             ==> (f a IN ring_carrier r <=> g a IN ring_carrier r) /\\\n                 R (f a) (g a))\n        ==> R (ring_sum r s f) (ring_sum r s g)",
      ),
      t482,
    ),
  )
}

