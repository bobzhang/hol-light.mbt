/// `RING_IDEAL_RADICAL`
pub fn ring_ideal_radical() -> @kernel.Thm {
  ring_ideal_radical_c.get()
}

///|
/// RADICAL_0
fn step_1181() -> Unit raise {
  let t9724 = @tactics.then_tac(
    @tactics.gen_tac,
    @simp.rewrite_tac(
      @list.List([radical(), ring_nilpotent(), @sets.in_sing()]),
    ),
  )
  radical_0_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!r:A ring. radical r {ring_0 r} = {x | ring_nilpotent r x}",
      ),
      t9724,
    ),
  )
}

