///|
/// prod_ring
fn step_794() -> Unit raise {
  prod_ring_c.set(
    @pair.new_definition(
      @parser.parse_term(
        "prod_ring (r:A ring) (r':B ring) =\n        ring((ring_carrier r) CROSS (ring_carrier r'),\n              (ring_0 r,ring_0 r'),\n              (ring_1 r,ring_1 r'),\n              (\\(x,x'). ring_neg r x,ring_neg r' x'),\n              (\\(x,x') (y,y'). ring_add r x y,ring_add r' x' y'),\n              (\\(x,x') (y,y'). ring_mul r x y,ring_mul r' x' y'))",
      ),
    ),
  )
}

