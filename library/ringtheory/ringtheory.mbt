///|
/// RING_SUM_PRODUCT_RING
fn step_853() -> Unit raise {
  let t5002 = @simp.simp_tac(@list.List([@sets.restriction()]))
  let t5001 = @simp.simp_tac(
    @list.List([
      product_ring_v1(),
      @sets.in_cartesian_product(),
      @sets.restriction_extension(),
    ]),
  )
  let t5000 = @simp.simp_tac(
    @list.List([ring_sum_clauses(), @sets.forall_in_insert()]),
  )
  let t4999 = @tactics.match_mp_tac(@sets.finite_induct_strong())
  let t4998 = @simp.rewrite_tac(
    @list.List([@theorems.imp_conj(), @theorems.right_forall_imp_thm()]),
  )
  let t5003 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(@tactics.gen_tac, @tactics.gen_tac),
            t4998,
          ),
          t4999,
        ),
        t5000,
      ),
      t5001,
    ),
    t5002,
  )
  ring_sum_product_ring_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!k r t (f:L->K->A).\n        FINITE t /\\\n        (!a. a IN t ==> (f a) IN ring_carrier(product_ring k r))\n        ==> ring_sum (product_ring k r) t f =\n            RESTRICTION k (\\i. ring_sum (r i) t (\\a. f a i))",
      ),
      t5003,
    ),
  )
}

