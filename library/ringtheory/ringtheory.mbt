///|
/// RING_SUM_RESTRICT_SET
fn step_153() -> Unit raise {
  let t618 = @meson.meson_tac(@list.empty())
  let t617 = @simp.simp_tac(
    @list.List([@sets.in_elim_thm(), @sets.subset_restrict()]),
  )
  let t619 = @tactics.then_tac(
    @tactics.then_tac(@tactics.match_mp_tac(ring_sum_superset()), t617),
    t618,
  )
  let t616 = @sets.set_tac(@list.empty())
  let t620 = @list.List([
    @tactics.then_tac(@tactics.match_mp_tac(ring_sum_eq()), t616),
    t619,
  ])
  let t615 = @tactics.match_mp_tac(
    @sets.set_rule(
      @parser.parse_term(
        "ring_sum r s' f = ring_sum r s' f' /\\\n    ring_sum r s f' = ring_sum r s' f'\n    ==> ring_sum r s' f = ring_sum r s f'",
      ),
    ),
  )
  let t621 = @tactics.thenl(
    @tactics.then_tac(
      @tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), t615),
      @tactics.conj_tac,
    ),
    t620,
  )
  ring_sum_restrict_set_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!P r s (f:K->A).\n        ring_sum r {x | x IN s /\\ P x} f =\n        ring_sum r s (\\x. if P x then f x else ring_0 r)",
      ),
      t621,
    ),
  )
}

