///|
/// RING_MONOMORPHIC_IMAGE_RULE
fn step_873() -> Unit raise {
  let t5478 = @meson.meson_tac(
    @list.List([
      ring_0_v1(),
      ring_1_v1(),
      ring_of_num_v1(),
      ring_of_int_v1(),
      ring_neg_v1(),
      ring_pow_v1(),
      ring_add_v1(),
      ring_sub_v1(),
      ring_mul_v1(),
      ring_homomorphism_0(),
      ring_homomorphism_1(),
      ring_homomorphism_ring_of_num(),
      ring_homomorphism_ring_of_int(),
      ring_homomorphism_neg(),
      ring_homomorphism_pow(),
      ring_homomorphism_add(),
      ring_homomorphism_sub(),
      ring_homomorphism_mul(),
    ]),
  )
  let t5477 = @list.List([@meson.meson_tac(@list.empty()), @tactics.all_tac])
  let t5476 = @tactics.match_mp_tac(@theorems.mono_and())
  let t5475 = @simp.gen_rewrite_tac(
    fn(
      x5472 : (@kernel.Term) -> @kernel.Thm raise,
    ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
      let s5473 = @equal.land_conv(x5472)
      fn(x5474 : @kernel.Term) -> @kernel.Thm raise { s5473(x5474) }
    },
    @list.List([@theorems.conj_sym()]),
  )
  let t5471 = @simp.rewrite_tac(@list.List([ring_monomorphism()]))
  let t5479 = @tactics.then_tac(
    @tactics.thenl(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), t5471),
            t5475,
          ),
          t5476,
        ),
        @tactics.conj_tac,
      ),
      t5477,
    ),
    t5478,
  )
  let pth = @tactics.prove(
    @parser.parse_term(
      "!r r' (f:A->B).\n          ring_monomorphism(r,r') f\n          ==> (!x x' y y'.\n                  (x IN ring_carrier r /\\ f x = x') /\\\n                  (y IN ring_carrier r /\\ f y = y')\n                  ==> (x = y <=> x' = y')) /\\\n              (!x. x IN ring_carrier r\n                   ==> x IN ring_carrier r /\\ f x = f x) /\\\n              (ring_0 r IN ring_carrier r /\\ f(ring_0 r) = ring_0 r') /\\\n              (ring_1 r IN ring_carrier r /\\ f(ring_1 r) = ring_1 r') /\\\n              (!n. ring_of_num r n IN ring_carrier r /\\\n                   f(ring_of_num r n) = ring_of_num r' n) /\\\n              (!n. ring_of_int r n IN ring_carrier r /\\\n                   f(ring_of_int r n) = ring_of_int r' n) /\\\n              (!x x'. x IN ring_carrier r /\\ f x = x'\n                      ==> ring_neg r x IN ring_carrier r /\\\n                          f(ring_neg r x) = ring_neg r' x') /\\\n              (!n x x'.\n                  x IN ring_carrier r /\\ f x = x'\n                  ==> ring_pow r x n IN ring_carrier r /\\\n                      f(ring_pow r x n) = ring_pow r' x' n) /\\\n              (!x x' y y'.\n                  (x IN ring_carrier r /\\ f x = x') /\\\n                  (y IN ring_carrier r /\\ f y = y')\n                  ==> ring_add r x y IN ring_carrier r /\\\n                      f(ring_add r x y) = ring_add r' x' y') /\\\n              (!x x' y y'.\n                  (x IN ring_carrier r /\\ f x = x') /\\\n                  (y IN ring_carrier r /\\ f y = y')\n                  ==> ring_sub r x y IN ring_carrier r /\\\n                      f(ring_sub r x y) = ring_sub r' x' y') /\\\n              (!x x' y y'.\n                  (x IN ring_carrier r /\\ f x = x') /\\\n                  (y IN ring_carrier r /\\ f y = y')\n                  ==> ring_mul r x y IN ring_carrier r /\\\n                      f(ring_mul r x y) = ring_mul r' x' y')",
    ),
    t5479,
  )
  ring_monomorphic_image_rule_c.set(fn(
    x5480 : @kernel.Thm,
  ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    let hth = x5480
    match @lib.splitlist(@bool.conj_pair, @drule.match_mp(pth)(hth)) {
      (
        More(
          pth_eq,
          tail=More(
            pth_asm,
            tail=More(
              pth_0,
              tail=More(
                pth_1,
                tail=More(
                  pth_num,
                  tail=More(
                    pth_int,
                    tail=More(
                      pth_neg,
                      tail=More(
                        pth_pow,
                        tail=More(pth_add, tail=More(pth_sub, tail=Empty))
                      )
                    )
                  )
                )
              )
            )
          )
        ),
        pth_mul,
      ) => {
        let htm = @kernel.rand(@kernel.concl(hth))
        fn mterm(x5482 : @kernel.Term) -> @kernel.Thm raise {
          let tm = x5482
          match tm {
            @kernel.Term::Comb(@kernel.Term::Const("ring_0", _), _) => pth_0
            @kernel.Term::Comb(@kernel.Term::Const("ring_1", _), _) => pth_1
            @kernel.Term::Comb(
              @kernel.Term::Comb(@kernel.Term::Const("ring_of_num", _), _),
              n
            ) => @bool.spec(n, pth_num)
            @kernel.Term::Comb(
              @kernel.Term::Comb(@kernel.Term::Const("ring_of_int", _), _),
              n_1
            ) => @bool.spec(n_1, pth_int)
            @kernel.Term::Comb(
              @kernel.Term::Comb(@kernel.Term::Const("ring_neg", _), _),
              s
            ) => {
              let sth = mterm(s)
              @drule.match_mp(pth_neg)(sth)
            }
            @kernel.Term::Comb(
              @kernel.Term::Comb(
                @kernel.Term::Comb(@kernel.Term::Const("ring_pow", _), _),
                s_1
              ),
              n_2
            ) => {
              let sth_1 = mterm(s_1)
              @drule.match_mp(@bool.spec(n_2, pth_pow))(sth_1)
            }
            @kernel.Term::Comb(
              @kernel.Term::Comb(
                @kernel.Term::Comb(@kernel.Term::Const("ring_add", _), _),
                s_2
              ),
              t
            ) => {
              let sth_2 = mterm(s_2)
              let tth = mterm(t)
              let t5483 = @bool.conj(sth_2, tth)
              @drule.match_mp(pth_add)(t5483)
            }
            @kernel.Term::Comb(
              @kernel.Term::Comb(
                @kernel.Term::Comb(@kernel.Term::Const("ring_sub", _), _),
                s_3
              ),
              t_1
            ) => {
              let sth_3 = mterm(s_3)
              let tth_1 = mterm(t_1)
              let t5484 = @bool.conj(sth_3, tth_1)
              @drule.match_mp(pth_sub)(t5484)
            }
            @kernel.Term::Comb(
              @kernel.Term::Comb(
                @kernel.Term::Comb(@kernel.Term::Const("ring_mul", _), _),
                s_4
              ),
              t_2
            ) => {
              let sth_4 = mterm(s_4)
              let tth_2 = mterm(t_2)
              let t5485 = @bool.conj(sth_4, tth_2)
              @drule.match_mp(pth_mul)(t5485)
            }
            _ => @bool.undisch(@bool.spec(tm, pth_asm))
          }
        }
        fn mform(x5486 : @kernel.Term) -> @kernel.Thm raise {
          let tm_1 = x5486
          if @basics.is_neg(tm_1) {
            @equal.rand_conv(mform)(tm_1)
          } else if @bool.is_iff(tm_1) ||
            @basics.is_imp(tm_1) ||
            @basics.is_conj(tm_1) ||
            @basics.is_disj(tm_1) {
            @equal.binop_conv(mform)(tm_1)
          } else if @basics.is_eq(tm_1) {
            let (s_5, t_3) = @kernel.dest_eq(tm_1)
            let sth_5 = mterm(s_5)
            let tth_3 = mterm(t_3)
            let t5487 = @bool.conj(sth_5, tth_3)
            @drule.match_mp(pth_eq)(t5487)
          } else {
            raise Failure("RING_MONOMORPHIC_IMAGE_RULE: unhandled formula")
          }
        }
        mform
      }
      _ => raise @lib.MatchFailure("tscript.ml:8373")
    }
  })
}

///|
let ring_monomorphic_image_rule_c : @lib.Cell[
  (@kernel.Thm) -> @equal.Conv raise,
] = @lib.Cell::new("RING_MONOMORPHIC_IMAGE_RULE")

///|
/// `RING_MONOMORPHIC_IMAGE_RULE`
pub fn ring_monomorphic_image_rule(x : @kernel.Thm) -> @equal.Conv raise {
  ring_monomorphic_image_rule_c.get()(x)
}

///|
/// RING_RULE
fn step_874() -> Unit raise {
  let t5504 = @simp.simp_tac(
    @list.List([@card.card_exp_cantor(), @card.card_lt_imp_le()]),
  )
  let t5503 = @simp.asm_rewrite_tac(@list.empty())
  let t5501 = @parser.parse_term("(:B)")
  let t5502 = @tactics.trans_tac(@card.card_le_trans())(t5501)
  let t5500 = @simp.asm_simp_tac(
    @list.List([@card.card_le_subset(), @sets.subset_univ()]),
  )
  let t5499 = @parser.parse_term("(:A)")
  let t5505 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.trans_tac(@card.card_le_trans())(t5499),
          t5500,
        ),
        t5502,
      ),
      t5503,
    ),
    t5504,
  )
  let t5496 = @simp.rewrite_tac(
    @list.List([
      @sets.insert_subset(),
      @sets.empty_subset(),
      ring_0_v1(),
      ring_1_v1(),
    ]),
  )
  let t5497 = @tactics.then_tac(
    @tactics.match_mp_tac(@card.card_le_subset()),
    t5496,
  )
  let t5495 = @tactics.conv_tac(@calc_num.num_reduce_conv)
  let t5494 = @simp.asm_rewrite_tac(
    @list.List([@sets.in_insert(), @sets.not_in_empty()]),
