    t8915,
  ])
  let t8909 = @simp.asm_rewrite_tac(@list.empty())
  let t8908 = @class.asm_cases_tac(
    @parser.parse_term("(a:A) IN ring_carrier r"),
  )
  let t8917 = @tactics.thenl(
    @tactics.then_tac(
      @tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), t8908),
      t8909,
    ),
    t8916,
  )
  prime_ideal_sing_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!r a:A. prime_ideal r (ideal_generated r {a}) <=>\n           if ~(a IN ring_carrier r) \\/ a = ring_0 r then integral_domain r\n           else ring_prime r a",
