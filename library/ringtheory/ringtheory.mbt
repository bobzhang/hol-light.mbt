            @tactics.then_tac(
              @tactics.then_tac(
                @tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), t14875),
                t14876,
              ),
              t14877,
            ),
            t14878,
          ),
          t14879,
        ),
        t14880,
      ),
      t14881,
    ),
  )
}

