}

///|
/// DIFF_CONV
fn step_48() -> Unit raise {
  let lookup_expr : (@kernel.Term) -> @kernel.Thm raise = fn(
    x1901 : @kernel.Term,
  ) -> @kernel.Thm raise {
    let tm = x1901
    @lib.tryfind(
      fn(x1902 : (@kernel.Term) -> @kernel.Thm raise) -> @kernel.Thm raise {
        let f = x1902
        f(tm)
      },
      @nets.lookup(tm, diff_net().val),
    )
  }
  let v = @parser.parse_term("x:real")
  let k = @parser.parse_term("k:real")
  let diffl_tm = @parser.parse_term("(diffl)")
  let diff_var = @bool.spec(v, @analysis.diff_x())
  let diff_const = @bool.specl(@list.List([k, v]), @analysis.diff_const())
  let uneta_conv : (@kernel.Term) -> @kernel.Thm raise = @simp.rewr_conv(
    @equal.gsym(@class.eta_ax()),
  )
  fn diff_conv_1(x1903 : @kernel.Term) -> @kernel.Thm raise {
    let tm_1 = x1903
    if !@kernel.is_abs(tm_1) {
      let th0 = uneta_conv(tm_1)
      let th1 = diff_conv_1(@kernel.rand(@kernel.concl(th0)))
      let t1904 = @equal.sym(th0)
      @equal.conv_rule(
        @equal.rator_conv(
          @equal.land_conv(fn(x1905 : @kernel.Term) -> @kernel.Thm raise {
            t1904
          }),
        ),
        th1,
      )
    } else {
      let (x, bod) = @kernel.dest_abs(tm_1)
      if bod == x {
        @kernel.inst_rule(@list.List([(x, v)]), diff_var)
      } else if !@basics.free_in(x, bod) {
        @kernel.inst_rule(@list.List([(bod, k), (x, v)]), diff_const)
      } else {
        let th = lookup_expr(tm_1)
        let hyp = @basics.dest_imp(@kernel.concl(th)).0
        let hyps = @basics.conjuncts(hyp)
        let (dhyps, sides) = @lib.partition(
          fn(x1906 : @kernel.Term) -> Bool raise {
            let t = x1906
            try @lib.funpow(3, @kernel.rator, t) == diffl_tm catch {
              Failure(_) => false
              e => raise e
            }
          },
          hyps,
        )
        let tha = @canon.conj_aci_rule(
          @basics.mk_eq(hyp, @bool.list_mk_conj(dhyps.concat(sides))),
        )
        let thb = @equal.conv_rule(
          @equal.land_conv(fn(x1907 : @kernel.Term) -> @kernel.Thm raise { tha }),
          th,
        )
        let dths = @lib.map(
          fn(x1909 : @kernel.Term) -> @kernel.Thm raise {
            (fn(x1908 : @kernel.Term) -> @kernel.Thm raise {
              diff_conv_1(@equal.lhand(x1908))
            })(@kernel.rator(x1909))
          },
          dhyps,
        )
        let t1910 = @lib.end_itlist(
          @bool.conj,
          dths.concat(@lib.map(@kernel.assume_rule, sides)),
        )
        @drule.match_mp(thb)(t1910)
      }
    }
  }
  diff_conv_c.set(fn(x1911 : @kernel.Term) -> @kernel.Thm raise {
    let tm_2 = x1911
    let xv = @basics.bndvar(tm_2) catch {
      Failure(_) => v
      e => raise e
    }
    @bool.gen(xv, @bool.disch_all(diff_conv_1(tm_2)))
  })
}

