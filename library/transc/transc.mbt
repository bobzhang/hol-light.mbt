      fn(x8569 : @kernel.Term) -> @kernel.Thm raise { s8568(x8569) }
    },
    @list.List([@theorems.forall_simp()]),
  )
  integrable_rule_c.set(fn(x8570 : @kernel.Term) -> @kernel.Thm raise {
    let tm = x8570
    let th1 = match_pth(tm)
    let th2 = @equal.conv_rule(
