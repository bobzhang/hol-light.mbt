    @list.empty(),
    t,
    @drule.part_match(
      fn(x1596 : @kernel.Term) -> @kernel.Term raise {
        (fn(x1595 : @kernel.Term) -> @kernel.Term raise {
          @equal.lhand(@kernel.rator(x1595))
