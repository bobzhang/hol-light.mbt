        t7121,
      ),
      t7122,
    ),
    t7123,
  )
  integration_by_parts_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!f g f' g' a b.\n        a <= b /\\\n        (!x. a <= x /\\ x <= b ==> (f diffl f'(x))(x)) /\\\n        (!x. a <= x /\\ x <= b ==> (g diffl g'(x))(x))\n        ==> defint(a,b) (\\x. f'(x) * g(x) + f(x) * g'(x))\n                        (f(b) * g(b) - f(a) * g(a))",
