      t4072,
    ),
    t4073,
  )
  tan_double_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!x. ~(cos(x) = &0) /\\ ~(cos(&2 * x) = &0) ==>\n            (tan(&2 * x) = (&2 * tan(x)) / (&1 - (tan(x) pow 2)))",
      ),
      t4074,
    ),
  )
}

