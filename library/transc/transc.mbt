  let t5251 = @kernel.rand(@kernel.rator(w))
  let thi = @drule.part_match(
    fn(x5250 : @kernel.Term) -> @kernel.Term raise {
      @kernel.rand(@kernel.rator(x5250))
    },
    th,
  )(t5251)
  let tm = @kernel.rand(@kernel.concl(thi))
  let t5253 = @list.List([@tactics.match_accept_tac(th), @tactics.all_tac])
  let t5252 = @tactics.exists_tac(tm)
  @tactics.thenl(
    @tactics.then_tac(
      @tactics.then_tac(@tactics.match_mp_tac(@analysis.real_le_trans()), t5252),
      @tactics.conj_tac,
    ),
    t5253,
  )((asl, w))
}

