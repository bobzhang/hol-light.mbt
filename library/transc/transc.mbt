      @parser.parse_term(
        "!a b d n. division(a,b) d /\\ d(n) < d(SUC n) /\\ d(SUC(SUC n)) = d(SUC n)\n           ==> dsize d = SUC n",
      ),
      t7190,
    ),
  )
}

