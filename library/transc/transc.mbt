///|
let diff_tan_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("DIFF_TAN")

///|
/// `DIFF_TAN`
pub fn diff_tan() -> @kernel.Thm {
  diff_tan_c.get()
}

///|
/// Library/transc.ml:2660
fn step_176() -> Unit raise {
  let t4098 = @simp.asm_simp_tac(
    @list.List([@analysis.diff_chain(), diff_tan()]),
  )
  let diff_tan_composite = @tactics.prove(
    @parser.parse_term(
      "(g diffl m)(x) /\\ ~(cos(g x) = &0)\n   ==> ((\\x. tan(g x)) diffl (inv(cos(g x) pow 2) * m))(x)",
    ),
    t4098,
  )
  add_to_diff_net(diff_tan_composite)
}

