// Load-fidelity test for Library/bitmatch.ml: replays tools/ocaml_ref/Library_bitmatch_ref.ml
// (keep in sync; the theorem list part is generated by
// tools/ocaml_ref/gen_theorems_test.py).

///|
using @testkit {stm, sthm}

///|
test "Library/bitmatch matches Library/bitmatch.ml" {
  @bitmatch.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "Library/bdd", "Library/words", "Library/bitmatch",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Library/bitmatch")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("_BITMATCH", () => sthm(@bitmatch._bitmatch()))
  log.attempt("_ELSEPATTERN", () => sthm(@bitmatch._elsepattern()))
  log.attempt("bitpat", () => sthm(@bitmatch.bitpat()))
  log.attempt("pat_size", () => sthm(@bitmatch.pat_size()))
  log.attempt("pat_set", () => sthm(@bitmatch.pat_set()))
  log.attempt("pat_set_lt", () => sthm(@bitmatch.pat_set_lt()))
  log.attempt("pat_thm", () => sthm(@bitmatch.pat_thm()))
  log.attempt("NILPAT", () => sthm(@bitmatch.nilpat()))
  log.attempt("NILPAT_pat_size", () => sthm(@bitmatch.nilpat_pat_size()))
  log.attempt("NILPAT_pat_set", () => sthm(@bitmatch.nilpat_pat_set()))
  log.attempt("CONSPAT", () => sthm(@bitmatch.conspat()))
  log.attempt("CONSPAT_pat_size", () => sthm(@bitmatch.conspat_pat_size()))
  log.attempt("CONSPAT_pat_set", () => sthm(@bitmatch.conspat_pat_set()))
  log.attempt("word1", () => sthm(@bitmatch.word1()))
  log.attempt("BIT0_WORD1", () => sthm(@bitmatch.bit0_word1()))
  log.attempt("VAL_WORD1", () => sthm(@bitmatch.val_word1()))
  log.attempt("WORD1_ODD", () => sthm(@bitmatch.word1_odd()))
  log.attempt("MATCH_SEQPATTERN", () => sthm(@bitmatch.match_seqpattern()))
  log.attempt("BITMATCH_SEQPATTERN", () => sthm(@bitmatch.bitmatch_seqpattern()))
  log.attempt("BITMATCH_SEQPATTERN2", () => {
    sthm(@bitmatch.bitmatch_seqpattern2())
  })
  log.attempt("MATCH_ELSEPATTERN", () => sthm(@bitmatch.match_elsepattern()))
  log.attempt("BITMATCH_ELSEPATTERN", () => {
    sthm(@bitmatch.bitmatch_elsepattern())
  })
  log.attempt("pat_extract", () => sthm(@bitmatch.pat_extract()))
  log.attempt("MATCH_EQ", () => sthm(@bitmatch.match_eq()))
  log.attempt("bitpat_inverts", () => sthm(@bitmatch.bitpat_inverts()))
  log.attempt("bitpat_down", () => sthm(@bitmatch.bitpat_down()))
  log.attempt("CONSPAT_down_inverts", () => {
    sthm(@bitmatch.conspat_down_inverts())
  })
  log.attempt("CONSPAT_word_inverts", () => {
    sthm(@bitmatch.conspat_word_inverts())
  })
  log.attempt("bitpat_inverts_comp", () => sthm(@bitmatch.bitpat_inverts_comp()))
  log.attempt("CONSPAT_word1_inverts", () => {
    sthm(@bitmatch.conspat_word1_inverts())
  })
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // word numerals beyond 2^31 (OCaml ints are 63-bit)
  log.attempt("bitmatch_conv_2^31", () => {
    sthm(
      @bitmatch.bitmatch_conv(
        tm("bitmatch (word 2147483648:32 word) with [a:1; b:31] -> b"),
      ),
    )
  })
  log.attempt("bitmatch_conv_2^32-1", () => {
    sthm(
      @bitmatch.bitmatch_conv(
        tm("bitmatch (word 4294967295:32 word) with [a:16; b:16] -> a"),
      ),
    )
  })
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  @testkit.check_axioms()
  inspect(
    @testkit.normalize_times(log.contents()),
    content=(
      #|Searching with limit 0
      #|Searching with limit 1
      #|Searching with limit 2
      #|Searching with limit 3
