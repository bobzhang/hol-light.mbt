      #|  finitely_generated_extension (k,l) (h:A->B) <=>\n     field_extension (k,l) h /\\\n     ?b. FINITE b /\\ b SUBSET ring_carrier l /\\\n         subfield_generated l (IMAGE h (ring_carrier k) UNION b) = l
