  let t1805 = @parser.parse_term("s:B->bool")
  let t1806 = @tactics.mp_tac(
    @bool.ispecl(
      @list.List([
        @parser.parse_term("ring_matroid (k,l) (h:A->B)"),
        t1805,
        t1804,
      ]),
      @matroids.matroid_independent_insert(),
    ),
  )
  let t1808 = @tactics.then_tac(
    @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t1806),
    t1807,
  )
  ring_independent_insert_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!(h:A->B) k l s a.\n         field k /\\\n         ring_homomorphism (k,l) h /\\\n         s SUBSET ring_carrier l /\\\n         a IN ring_carrier l\n        ==> (ring_independent (k,l) h (a INSERT s) <=>\n             if a IN s then ring_independent (k,l) h s\n             else ring_independent (k,l) h s /\\ ~(a IN ring_span (k,l) h s))",
      ),
      t1808,
    ),
  )
}

