///|
let algebraic_closure_unique_explicit_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new(
  "ALGEBRAIC_CLOSURE_UNIQUE_EXPLICIT",
)

///|
/// `ALGEBRAIC_CLOSURE_UNIQUE_EXPLICIT`
pub fn algebraic_closure_unique_explicit() -> @kernel.Thm {
  algebraic_closure_unique_explicit_c.get()
}

///|
/// ALGEBRAIC_CLOSURE_UNIQUE
fn step_355() -> Unit raise {
  let t8282 = @meson.meson_tac(
    @list.List([algebraic_closure_unique_explicit()]),
  )
  let t8283 = @tactics.then_tac(
    @simp.rewrite_tac(@list.List([@ringtheory.isomorphic_ring()])),
    t8282,
  )
  algebraic_closure_unique_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!(k:A ring) (l:B ring) (l':C ring) (f:A->B) (g:A->C).\n        algebraic_extension(k,l) f /\\ algebraically_closed_field l /\\\n        algebraic_extension(k,l') g /\\ algebraically_closed_field l'\n        ==> l isomorphic_ring l'",
      ),
      t8283,
    ),
  )
}

