  let t1156 = @tactics.exists_tac(
    @parser.parse_term("poly_ring (l:B ring) (:1)"),
  )
  let t1155 = @tactics.match_mp_tac(@ringtheory.ring_homomorphism_compose())
  let t1154 = @simp.asm_simp_tac(
    @list.List([
      @ringtheory.ring_coprime_00(),
      @ringtheory.field_imp_nontrivial_ring(),
      @ringtheory.pid_poly_ring(),
      @ringtheory.pid_imp_bezout_ring(),
      @trivia.o_thm(),
    ]),
  )
  let t1149 = @parser.parse_term("q:(1->num)->A")
  let t1150 = @parser.parse_term("p:(1->num)->A")
  let t1151 = @parser.parse_term("(\\q. poly_eval l q y) o (\\p. (h:A->B) o p)")
  let t1152 = @parser.parse_term("l:B ring")
  let t1153 = @tactics.mp_tac(
    @bool.ispecl(
      @list.List([
        @parser.parse_term("poly_ring (k:A ring) (:1)"),
        t1152,
        t1151,
        t1150,
        t1149,
      ]),
      @ringtheory.ring_coprime_homomorphic_image(),
    ),
  )
  let t1148 = @tactics.disch_then(
    @tactics.x_choose_then(@parser.parse_term("y:B"))(@tactics.strip_assume_tac),
  )
  let t1147 = @tactics.repeat_tac(@tactics.gen_tac)
  let t1158 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(
                @tactics.then_tac(
                  @simp.rewrite_tac(@list.List([field_extension()])),
                  t1147,
                ),
                @tactics.strip_tac,
              ),
              t1148,
            ),
            t1153,
          ),
          t1154,
        ),
        t1155,
      ),
      t1156,
    ),
    t1157,
  )
  coprime_poly_no_common_root_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!(k:A ring) (l:B ring) (h:A->B) p q.\n        field_extension(k,l) h /\\ ring_coprime(poly_ring k (:1)) (p, q)\n        ==> ~(?x. x IN ring_carrier l /\\\n                  poly_eval l (h o p) x = ring_0 l /\\\n                  poly_eval l (h o q) x = ring_0 l)",
      ),
      t1158,
    ),
  )
}

