  let t1444 = @simp.asm_simp_tac(
    @list.List([
      @ringtheory.ring_0_v1(),
      @ringtheory.ring_add_v1(),
      @ringtheory.ring_mul_v1(),
      ring_span_0(),
      ring_span_add(),
      ring_span_inc(),
      @sets.fun_in_image(),
    ]),
