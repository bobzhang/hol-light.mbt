/// COPRIME_POLY_NO_COMMON_ROOT
fn step_118() -> Unit raise {
  let t1157 = @simp.asm_simp_tac(
    @list.List([
      @ringtheory.ring_homomorphism_poly_rings(),
      @ringtheory.ring_homomorphism_poly_eval(),
      @ringtheory.ring_monomorphism_imp_homomorphism(),
