  irreducible_algebraically_closed_field_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!(k:A ring) p.\n        algebraically_closed_field k\n        ==> (ring_irreducible (poly_ring k (:1)) p <=>\n             p IN ring_carrier (poly_ring k (:1)) /\\ poly_deg k p = 1)",
      ),
      t6598,
    ),
  )
}

