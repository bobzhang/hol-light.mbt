  let t1474 = @meson.meson_tac(@list.List([ring_independent_imp_subset()]))
  let t1473 = @simp.asm_simp_tac(
    @list.List([
      @matroids.matroid_basis(),
      ring_basis(),
      ring_matroid_independent(),
      ring_spanning(),
      ring_matroid_spanning(),
    ]),
  )
  let t1472 = @simp.once_rewrite_tac(@list.List([@class.fun_eq_thm()]))
  let t1475 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t1472),
      t1473,
    ),
    t1474,
  )
  ring_matroid_basis_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!(h:A->B) k l.\n        field k /\\ ring_homomorphism(k,l) h\n        ==> (matroid_basis(ring_matroid (k,l) h) =\n             ring_basis (k,l) h)",
      ),
      t1475,
    ),
  )
}

