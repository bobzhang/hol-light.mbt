///|
/// algebraic_extension
fn step_197() -> Unit raise {
  algebraic_extension_c.set(
    @pair.new_definition(
      @parser.parse_term(
        "algebraic_extension (k,l) (h:A->B) <=>\n        field_extension (k,l) h /\\\n        !x. x IN ring_carrier l ==> algebraic_over (k,l) h x",
      ),
    ),
  )
}

