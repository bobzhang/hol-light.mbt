      #|  (!a b. gcd(a - b,b) = gcd(a,b)) /\\\n   (!a b. gcd(b - a,b) = gcd(a,b)) /\\\n   (!a b. gcd(a,a - b) = gcd(a,b)) /\\\n   (!a b. gcd(a,b - a) = gcd(a,b))
