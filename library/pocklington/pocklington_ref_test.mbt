// Load-fidelity test for Library/pocklington.ml: replays tools/ocaml_ref/Library_pocklington_ref.ml
// (keep in sync; refresh with tools/ocaml_ref/refresh_ref.py).

///|
using @testkit {stm, sthm}

///|
test "Library/pocklington matches Library/pocklington.ml" {
  @pocklington.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "Library/iter", "Library/prime", "Library/pocklington",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Library/pocklington")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("nat_mod_lemma", () => sthm(@pocklington.nat_mod_lemma()))
  log.attempt("nat_mod", () => sthm(@pocklington.nat_mod()))
  log.attempt("FINITE_NUMBER_SEGMENT", () => {
    sthm(@pocklington.finite_number_segment())
  })
