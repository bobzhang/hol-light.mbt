pub fn imp_subst_tac(
  x74 : @kernel.Thm,
  x75 : (@list.List[(String, @kernel.Thm)], @kernel.Term),
) -> @tactics.Goalstate raise {
  let th = x74
  let (asl, w) = x75
  let t79 = @drule.part_match(
