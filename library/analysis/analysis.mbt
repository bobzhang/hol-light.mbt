        @bool.spec(@parser.parse_term("P:real->bool"), @realax.real_complete()),
      ),
    ),
    t1871,
  )
  real_sup_exists_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!P. (?x. P x) /\\ (?z. !x. P x ==> x < z) ==>\n     (?s. !y. (?x. P x /\\ y < x) <=> y < s)",
      ),
      t1872,
    ),
  )
}

