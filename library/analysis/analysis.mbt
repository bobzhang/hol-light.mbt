///|
/// SER_ADD
fn step_444() -> Unit raise {
  let t5949 = @tactics.match_accept_tac(seq_add())
  let t5946 = @parser.parse_term("sum(0,n) y")
  let t5947 = @list.List([x_beta_conv(@parser.parse_term("n:num"), t5946)])
  let t5948 = @tactics.conv_tac(
    (fn(
      x5943 : (@kernel.Term) -> @kernel.Thm raise,
    ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
      let s5944 = @equal.rand_conv(x5943)
      fn(x5945 : @kernel.Term) -> @kernel.Thm raise { s5944(x5945) }
    })(exact_conv(t5947)),
  )
  let t5940 = @parser.parse_term("sum(0,n) x")
  let t5941 = @list.List([x_beta_conv(@parser.parse_term("n:num"), t5940)])
  let t5942 = @tactics.conv_tac(
    (fn(
      x5937 : (@kernel.Term) -> @kernel.Thm raise,
    ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
      let s5938 = @equal.rand_conv(x5937)
      fn(x5939 : @kernel.Term) -> @kernel.Thm raise { s5938(x5939) }
    })(exact_conv(t5941)),
  )
  let t5936 = @simp.rewrite_tac(@list.List([sums(), sum_add()]))
  let t5950 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), t5936),
        t5942,
      ),
      t5948,
    ),
    t5949,
  )
  ser_add_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!x x0 y y0. x sums x0 /\\ y sums y0 ==> (\\n. x(n) + y(n)) sums (x0 + y0)",
      ),
      t5950,
    ),
  )
}

