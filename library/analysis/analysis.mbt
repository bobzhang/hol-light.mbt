        @equal.lhs(
          (fn(x76 : (@kernel.Term, @kernel.Term)) -> @kernel.Term raise {
            x76.1
          })(x77),
        )
      })(@basics.dest_imp(x78))
    },
    th,
  )
  let tms = @basics.find_terms((x80 : @kernel.Term) => @lib.can(t79, x80), w)
  let tm1 = @lib.hd(
    @lib.sort(
      fn(x81 : @kernel.Term, x82 : @kernel.Term) -> Bool raise {
        @basics.free_in(x81, x82)
      },
      tms,
    ),
  )
  let th1 = @drule.part_match(
    fn(x85 : @kernel.Term) -> @kernel.Term raise {
      (fn(x84 : (@kernel.Term, @kernel.Term)) -> @kernel.Term raise {
        @equal.lhs(
          (fn(x83 : (@kernel.Term, @kernel.Term)) -> @kernel.Term raise {
            x83.1
          })(x84),
        )
      })(@basics.dest_imp(x85))
    },
    th,
  )(tm1)
  let t87 = @basics.dest_imp(@kernel.concl(th1))
  let t88 = @kernel.dest_eq(t87.1)
  let (a, (l, r)) = (
    (fn(x86 : @kernel.Term) -> @kernel.Term raise { x86 })(t87.0),
    t88,
  )
  let gv = @basics.genvar(@kernel.type_of(l))
  let pat = @basics.subst(@list.List([(gv, l)]), w)
  (
    @tactics.null_meta,
    @list.List([(asl, a), (asl, @basics.subst(@list.List([(r, gv)]), pat))]),
    fn(
      x89 : (
        @list.List[(Int64, @kernel.Term)],
        @list.List[(@kernel.Term, @kernel.Term)],
        @list.List[(@kernel.HolType, @kernel.HolType)],
      ),
      x90 : @list.List[@kernel.Thm],
    ) -> @kernel.Thm raise {
      let i = x89
      match x90 {
        More(t1, tail=More(t2, tail=Empty)) =>
          subst(@list.List([(@equal.sym(@bool.mp(th1, t1)), gv)]), pat, t2)
        _ => raise @lib.MatchFailure("tscript.ml:223")
      }
    },
  )
}

