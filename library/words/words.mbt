///|
/// BITS_OF_NUM_SUBSET_NUMSEG_LT
fn step_219() -> Unit raise {
  let t710 = @meson.meson_tac(
    @list.List([
      @arith.div_lt(),
      @arith.even(),
      @arith.lt_pow2_refl(),
      @arith.let_trans(),
