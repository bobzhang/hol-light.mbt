            let t5312 = (@basics.mk_finty(n), n_ty)
            let th = @kernel.inst_type(
              @list.List([(@basics.mk_finty(m), m_ty), t5312]),
              pth,
            )
            let t5313 = @equal.lhand(@kernel.concl(th))
            let cth = @equal.thenc(
              @equal.binop_conv(@cart.dimindex_conv),
              @calc_num.num_le_conv,
            )(t5313)
            let t5314 = @bool.mp(th, @bool.eqt_elim(cth))
            @bool.spec(@kernel.rand(tm), t5314)
          }
        }
        _ => raise Failure("IVAL_WORD_ADJUST_CONV: wrong form of term")
      }
    }
  })
}

