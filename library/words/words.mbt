///|
/// NSUM_BITS_DIV
fn step_225() -> Unit raise {
  let t738 = @simp.asm_rewrite_tac(
    @list.List([
      @int.arith_rule(@parser.parse_term("1 < 2")),
      @arith.mult_clauses(),
    ]),
  )
  let t734 = @parser.parse_term("k:num")
  let t735 = @parser.parse_term("s:num->bool")
  let t736 = @parser.parse_term("\\i:num. 1")
  let t737 = @tactics.mp_tac(
    @bool.specl(
      @list.List([@parser.parse_term("2"), t736, t735, t734]),
      digitsum_div(),
    ),
  )
  let t739 = @tactics.then_tac(
    @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t737),
    t738,
  )
  nsum_bits_div_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!s k. FINITE s\n         ==> nsum s (\\i. 2 EXP i) DIV 2 EXP k =\n             nsum {i | i IN s /\\ k <= i} (\\i. 2 EXP (i - k))",
      ),
      t739,
    ),
  )
}

///|
let nsum_bits_div_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("NSUM_BITS_DIV")

