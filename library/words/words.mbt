///|
/// NSUM_BITS_OF_NUM
fn step_221() -> Unit raise {
  let t722 = @sets.set_tac(@list.empty())
  let t721 = @simp.rewrite_tac(@list.List([bits_of_num(), numbit()]))
  let t720 = @tactics.mp_tac(
    @bool.spec(@parser.parse_term("n:num"), bits_of_num_subset_numseg_lt()),
  )
  let t719 = @tactics.match_mp_tac(@theorems.eq_imp())
  let t718 = @simp.simp_tac(
    @list.List([@arith.mod_lt(), @arith.lt_pow2_refl()]),
  )
  let t716 = @equal.gsym(@iterate.nsum_restrict_set())
  let t717 = @simp.rewrite_tac(
    @list.List([@equal.gsym(@arith.not_odd()), @class.cond_swap(), t716]),
  )
  let t715 = @simp.rewrite_tac(
    @list.List([@arith.mod_2_cases(), @class.cond_rand(), @arith.mult_clauses()]),
  )
  let t713 = @parser.parse_term("n:num")
  let t714 = @parser.parse_term("n:num")
  let t723 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(
                @tactics.then_tac(
                  @tactics.then_tac(
                    @tactics.then_tac(
                      @tactics.then_tac(
                        @tactics.then_tac(
                          @tactics.gen_tac,
                          @tactics.mp_tac(
                            @bool.specl(
                              @list.List([@parser.parse_term("2"), t714, t713]),
                              digitsum_works_gen(),
                            ),
                          ),
                        ),
                        t715,
                      ),
                      t717,
                    ),
                    t718,
                  ),
                  t719,
                ),
                @tactics.ap_thm_tac,
              ),
              @tactics.ap_term_tac,
            ),
            @tactics.ap_thm_tac,
          ),
          @tactics.ap_term_tac,
        ),
        t720,
      ),
      t721,
    ),
    t722,
  )
  nsum_bits_of_num_c.set(
    @tactics.prove(
      @parser.parse_term("!n. nsum (bits_of_num n) (\\i. 2 EXP i) = n"),
      t723,
    ),
  )
}

///|
let nsum_bits_of_num_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new(
