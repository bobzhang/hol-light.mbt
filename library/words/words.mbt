///|
/// WORD_DUPLICATE_CONV
fn step_893() -> Unit raise {
  let m_ty = @parser.parse_type("M")
  let n_ty = @parser.parse_type("N")
  let m_tm = @parser.parse_term("m:num")
  let k_tm = @parser.parse_term("k:num")
  let t4657 = @simp.simp_tac(
    @list.List([word_duplicate_v1(), @arith.exp_exp(), @arith.mult_sym()]),
  )
  let pth = @tactics.prove(
    @parser.parse_term(
      "dimindex(:N) <= k * dimindex(:M)\n           ==> (word_duplicate:M word->N word)(word m) =\n               (\\t. word((t EXP k - 1) DIV (t - 1) * m MOD t))\n               (2 EXP dimindex(:M))",
    ),
    t4657,
  )
  word_duplicate_conv_c.set(fn(x4658 : @kernel.Term) -> @kernel.Thm raise {
    let tm = x4658
    match tm {
      @kernel.Term::Comb(
        @kernel.Term::Const(
          "word_duplicate",
          @kernel.HolType::Tyapp("fun", More(mty, tail=More(nty, tail=Empty)))
        ),
        @kernel.Term::Comb(
          @kernel.Term::Const("word", _),
          @kernel.Term::Comb(@kernel.Term::Const("NUMERAL", _), _) as mtm
        )
      ) => {
        let m = dest_word_ty(mty)
        let n = dest_word_ty(nty)
        let k = @num.quo_num(@num.sub_num(@num.add_num(n, m), @num.num_1), m)
        let t4659 = (@basics.mk_finty(n), n_ty)
        let t4660 = @kernel.inst_type(
          @list.List([(@basics.mk_finty(m), m_ty), t4659]),
          pth,
        )
        let th1 = @kernel.inst_rule(
          @list.List([(mtm, m_tm), (@nums.mk_numeral(k), k_tm)]),
          t4660,
        )
        let t4662 = @equal.lhand(@kernel.concl(th1))
        let t4661 = @equal.thenc(
          @equal.rand_conv(word_size_conv().val),
          @calc_num.num_mult_conv,
        )
        let th2 = @equal.thenc(
          @equal.binop2_conv(word_size_conv().val, t4661),
          @calc_num.num_le_conv,
        )(t4662)
        let th3 = @bool.mp(th1, @bool.eqt_elim(th2))
        let th4 = @equal.conv_rule(
          @equal.rand_conv(
            @equal.rand_conv(
              @equal.thenc(
                @equal.rand_conv(word_size_conv().val),
                @calc_num.num_exp_conv,
              ),
            ),
          ),
          th3,
        )
        let th5 = @equal.conv_rule(@equal.rand_conv(@equal.beta_conv), th4)
        let th6 = @equal.conv_rule(
          @equal.rand_conv(@equal.rand_conv(@calc_num.num_reduce_conv)),
          th5,
        )
        @equal.conv_rule(@equal.rand_conv(word_word_conv), th6)
      }
      _ => raise Failure("WORD_DUPLICATE_CONV")
    }
  })
}

