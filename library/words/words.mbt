  let t62 = @simp.rewrite_tac(
    @list.List([@equal.gsym(@theorems.conj_assoc()), @theorems.unwind_thm2()]),
  )
  let t64 = @list.List([
    @tactics.then_tac(
      @tactics.then_tac(
        @simp.rewrite_tac(
          @list.List([
            @sets.extension(),
            @sets.in_image(),
            @sets.in_elim_thm(),
            @int.arith_rule(
              @parser.parse_term("x:num = y + n <=> y = x - n /\\ n <= x"),
            ),
          ]),
        ),
        t62,
      ),
      @int.arith_tac,
    ),
    t63,
  ])
  let t61 = @tactics.subgoal_then(
    @parser.parse_term(
      "{i:num | i < m /\\ n <= i} = IMAGE (\\i. i + n) {i | i < m - n}",
    ),
    fn(
      x58 : @kernel.Thm,
    ) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> (
      (
        @list.List[@kernel.Term],
        (
          @list.List[(Int, @kernel.Term)],
          @list.List[(@kernel.Term, @kernel.Term)],
          @list.List[(@kernel.HolType, @kernel.HolType)],
        ),
      ),
      @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)],
      (
        (
          @list.List[(Int, @kernel.Term)],
          @list.List[(@kernel.Term, @kernel.Term)],
          @list.List[(@kernel.HolType, @kernel.HolType)],
        ),
        @list.List[@kernel.Thm],
      ) -> @kernel.Thm raise,
    ) raise) raise {
      let s59 = @tactics.subst1_tac(x58)
      fn(
        x60 : (@list.List[(String, @kernel.Thm)], @kernel.Term),
      ) -> (
        (
          @list.List[@kernel.Term],
          (
            @list.List[(Int, @kernel.Term)],
            @list.List[(@kernel.Term, @kernel.Term)],
            @list.List[(@kernel.HolType, @kernel.HolType)],
          ),
        ),
        @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)],
        (
          (
            @list.List[(Int, @kernel.Term)],
            @list.List[(@kernel.Term, @kernel.Term)],
            @list.List[(@kernel.HolType, @kernel.HolType)],
          ),
          @list.List[@kernel.Thm],
        ) -> @kernel.Thm raise,
      ) raise {
        s59(x60)
      }
    },
  )
  let t57 = @simp.asm_simp_tac(
    @list.List([digitsum_div(), @sets.finite_numseg_lt(), @sets.in_elim_thm()]),
  )
  let t65 = @tactics.thenl(
    @tactics.then_tac(
      @tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t57),
      t61,
    ),
    t64,
  )
  digitsum_div_numseg_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!B b m n.\n        (!i. i < m ==> b i < B)\n        ==> nsum {i | i < m} (\\i. B EXP i * b i) DIV (B EXP n) =\n            nsum {i | i < m - n} (\\i. B EXP i * b(i + n))",
      ),
      t65,
    ),
  )
}

