///|
/// USIMD2
fn step_945() -> Unit raise {
  let t5453 = @int.arith_rule(@parser.parse_term("~(n + i:num < n)"))
  let t5454 = @int.arith_rule(@parser.parse_term("n + i < 2 * n <=> i < n"))
  let t5455 = @int.arith_rule(@parser.parse_term("i < n ==> i < 2 * n"))
  let t5456 = @simp.simp_tac(
    @list.List([
      @arith.add_clauses(),
      @cart.dimindex_tybit0(),
      @int.arith_rule(@parser.parse_term("MIN x x = x")),
      @arith.add_sub2(),
      t5455,
      t5454,
      t5453,
    ]),
  )
  let t5452 = @simp.rewrite_tac(
    @list.List([word_eq_bits_alt(), bit_word_subword(), bit_word_join()]),
  )
  let t5451 = @simp.rewrite_tac(@list.List([usimd2()]))
  let t5457 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), t5451),
          @tactics.binop_tac,
        ),
        @tactics.ap_term_tac,
      ),
      t5452,
    ),
    t5456,
  )
  usimd2_v1_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!(f:N word->M word) xhi xlo.\n        usimd2 f (word_join xhi xlo) = word_join (f xhi) (f xlo)",
      ),
      t5457,
    ),
  )
}

