  )
  let t209 = @int.arith_rule(
    @parser.parse_term("k < n ==> (i < n /\\ k <= i <=> k <= i /\\ i <= n - 1)"),
  )
  let t210 = @simp.asm_simp_tac(
    @list.List([@sets.in_elim_thm(), @equal.gsym(@iterate.numseg()), t209]),
  )
  let t208 = @simp.simp_tac(
    @list.List([binary_digitsum_div(), @sets.finite_numseg_lt()]),
  )
  let t207 = @tactics.x_gen_tac(@parser.parse_term("k:num"))
  let t219 = @tactics.thenl(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(
                @tactics.then_tac(
                  @tactics.then_tac(
                    @tactics.then_tac(
                      @tactics.gen_tac,
                      @simp.simp_tac(
                        @list.List([word_eq_bits_alt(), val_def(), bit_word()]),
                      ),
                    ),
                    t207,
                  ),
                  @tactics.disch_tac,
                ),
                t208,
              ),
              t210,
            ),
            t211,
          ),
          t212,
        ),
        t213,
      ),
      @tactics.conj_tac,
    ),
    t218,
  )
  word_val_c.set(
    @tactics.prove(@parser.parse_term("!w:N word. word(val w) = w"), t219),
  )
}

