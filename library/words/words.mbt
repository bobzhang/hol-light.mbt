  let clz : (Int) -> ((@num.Num) -> Int raise) raise = fn(
    x4901 : Int,
  ) -> ((@num.Num) -> Int raise) raise {
    let k = x4901
    let m = @num.pow2(k)
    fn clza(x4903 : Int, x4904 : @num.Num) -> Int raise {
      let a = x4903
      let n = x4904
      if @num.lt_num(n, m) {
        let t4905 = @num.mult_num(@num.num_2, n)
        clza(a + 1, t4905)
      } else {
        a
      }
    }
    fn(x4906 : @num.Num) -> Int raise {
      let n_1 = x4906
      if @num.eq_num(n_1, @num.num_0) {
        k
      } else {
        let t4907 = clza(-1, n_1)
        if k <= t4907 {
          k
        } else {
          t4907
        }
      }
    }
  }
  let t4908 = @simp.simp_tac(@list.List([val_eq_0(), word_clz_0()]))
  let pth_0 = @tactics.prove(
    @parser.parse_term("!(a:N word). val a = 0 ==> word_clz a = dimindex(:N)"),
    t4908,
  )
  let t4916 = @meson.asm_meson_tac(
    @list.List([
      @int.arith_rule(@parser.parse_term("n + 1 + d = N ==> N - n - 1 = d")),
    ]),
  )
  let t4915 = @tactics.match_mp_tac(word_clz_unique_val())
  let t4914 = @tactics.repeat_tac(@tactics.strip_tac)
  let t4913 = @tactics.disch_then(fn(
    x4912 : @kernel.Thm,
  ) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> (
    (
      @list.List[@kernel.Term],
      (
        @list.List[(Int, @kernel.Term)],
        @list.List[(@kernel.Term, @kernel.Term)],
        @list.List[(@kernel.HolType, @kernel.HolType)],
      ),
    ),
    @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)],
    (
      (
        @list.List[(Int, @kernel.Term)],
        @list.List[(@kernel.Term, @kernel.Term)],
        @list.List[(@kernel.HolType, @kernel.HolType)],
      ),
      @list.List[@kernel.Thm],
    ) -> @kernel.Thm raise,
  ) raise) raise {
    (fn(
      x4909 : @kernel.Thm,
    ) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> (
      (
        @list.List[@kernel.Term],
        (
          @list.List[(Int, @kernel.Term)],
          @list.List[(@kernel.Term, @kernel.Term)],
          @list.List[(@kernel.HolType, @kernel.HolType)],
        ),
      ),
      @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)],
      (
        (
          @list.List[(Int, @kernel.Term)],
          @list.List[(@kernel.Term, @kernel.Term)],
          @list.List[(@kernel.HolType, @kernel.HolType)],
        ),
        @list.List[@kernel.Thm],
      ) -> @kernel.Thm raise,
    ) raise) raise {
      let s4910 = @tactics.subst1_tac(x4909)
      fn(
        x4911 : (@list.List[(String, @kernel.Thm)], @kernel.Term),
      ) -> (
        (
          @list.List[@kernel.Term],
          (
            @list.List[(Int, @kernel.Term)],
            @list.List[(@kernel.Term, @kernel.Term)],
            @list.List[(@kernel.HolType, @kernel.HolType)],
          ),
        ),
        @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)],
        (
          (
            @list.List[(Int, @kernel.Term)],
            @list.List[(@kernel.Term, @kernel.Term)],
            @list.List[(@kernel.HolType, @kernel.HolType)],
          ),
          @list.List[@kernel.Thm],
        ) -> @kernel.Thm raise,
      ) raise {
        s4910(x4911)
      }
    })(@equal.sym(x4912))
  })
  let t4917 = @tactics.then_tac(
    @tactics.thenl(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), t4913),
            t4914,
          ),
          t4915,
        ),
        @tactics.conj_tac,
      ),
      @list.List([@int.asm_arith_tac, @tactics.all_tac]),
    ),
    t4916,
  )
  let pth = @tactics.prove(
    @parser.parse_term(
      "!(a:N word) v.\n        val a = v\n        ==> !n d. n + 1 + d = dimindex(:N) /\\ v DIV (2 EXP d) = 1\n                  ==> word_clz a = n",
    ),
    t4917,
  )
  word_clz_conv_c.set(fn(x4918 : @kernel.Term) -> @kernel.Thm raise {
    let tm = x4918
    match tm {
      @kernel.Term::Comb(
        @kernel.Term::Const("word_clz", _),
        @kernel.Term::Comb(@kernel.Term::Const("word", _), t)
      ) if @nums.is_numeral(t) => {
        let th1 = @bool.ispec(@kernel.rand(tm), pth)
        let th2 = word_val_conv(
          @equal.lhand(@equal.lhand(@basics.dest_forall(@kernel.concl(th1)).1)),
        )
        let mtm = @kernel.rand(@kernel.concl(th2))
        let m_1 = @basics.dest_numeral(mtm)
        if @num.eq_num(m_1, @num.num_0) {
          let t4919 = @drule.match_mp(pth_0)(th2)
          @equal.conv_rule(@equal.rand_conv(word_size_conv().val), t4919)
        } else {
          let th3 = @bool.mp(@bool.spec(mtm, th1), th2)
          let th4 = @equal.conv_rule(
            @equal.binder_conv(
              @equal.binder_conv(
                @equal.land_conv(
                  @equal.land_conv(@equal.rand_conv(word_size_conv().val)),
                ),
              ),
            ),
            th3,
          )
          let btm = @equal.lhand(
            @equal.lhand(@basics.strip_forall(@kernel.concl(th4)).1),
          )
          let e = @nums.dest_small_numeral(@kernel.rand(btm))
          let n_2 = clz(e)(m_1)
          let d = e - (n_2 + 1)
          let t4920 = @nums.mk_small_numeral(d)
          let th5 = @bool.specl(
            @list.List([@nums.mk_small_numeral(n_2), t4920]),
            th4,
          )
          @bool.mp(
            th5,
            @bool.eqt_elim(
              @calc_num.num_reduce_conv(@equal.lhand(@kernel.concl(th5))),
            ),
          )
        }
      }
      _ => raise Failure("WORD_CLZ_CONV")
    }
  })
}

