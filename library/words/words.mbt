///|
/// VAL_WORD_ADJUST_CONV
fn step_925() -> Unit raise {
  let m_ty = @parser.parse_type("M")
  let n_ty = @parser.parse_type("N")
  let t5146 = @simp.simp_tac(@list.List([val_word_zx()]))
  let pth = @tactics.prove(
    @parser.parse_term(
      "dimindex(:M) <= dimindex(:N)\n     ==> !x. val(x:M word) = val(word_zx x:N word)",
    ),
    t5146,
  )
  val_word_adjust_conv_c.set(fn(
    x5147 : @num.Num,
  ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
    let n = x5147
    fn(x5148 : @kernel.Term) -> @kernel.Thm raise {
      let tm = x5148
      match tm {
        @kernel.Term::Comb(@kernel.Term::Const("val", _), _) => {
