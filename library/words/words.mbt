///|
/// DIGITSUM_DIV_MOD
fn step_30() -> Unit raise {
  let t75 = @simp.rewrite_tac(
    @list.List([
      @sets.sing_gspec(),
      @iterate.nsum_sing(),
      @arith.sub_refl(),
      @arith.mult_clauses(),
      @arith.exp(),
    ]),
  )
  let t74 = @simp.asm_rewrite_tac(
    @list.List([@sets.empty_gspec(), @iterate.nsum_clauses()]),
  )
  let t73 = @class.asm_cases_tac(@parser.parse_term("(n:num) IN s"))
  let t72 = @simp.rewrite_tac(
    @list.List([
      @meson.meson(
        @list.empty(),
        @parser.parse_term("i IN s /\\ i = n <=> n IN s /\\ i = n"),
      ),
    ]),
  )
  let t70 = @int.arith_rule(
    @parser.parse_term("i < SUC n /\\ n <= i <=> i = n"),
  )
  let t71 = @simp.rewrite_tac(
    @list.List([@equal.gsym(@theorems.conj_assoc()), t70]),
  )
  let t69 = @simp.asm_simp_tac(
    @list.List([digitsum_div(), @sets.finite_restrict(), @sets.in_elim_thm()]),
  )
  let t68 = @simp.asm_simp_tac(@list.List([digitsum_mod()]))
  let t67 = @simp.rewrite_tac(
    @list.List([
      @meson.meson(
        @list.List([@arith.exp(), @arith.mult_sym()]),
        @parser.parse_term("B EXP n * B = B EXP SUC n"),
      ),
    ]),
  )
  let t66 = @simp.rewrite_tac(@list.List([@arith.div_mod()]))
  let t76 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(
                @tactics.then_tac(
                  @tactics.then_tac(
                    @tactics.repeat_tac(@tactics.strip_tac),
                    t66,
                  ),
                  t67,
                ),
                t68,
              ),
              t69,
            ),
            t71,
          ),
          t72,
        ),
        t73,
      ),
      t74,
    ),
    t75,
  )
  digitsum_div_mod_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!B b s n.\n        FINITE s /\\ (!i. i IN s ==> b i < B)\n        ==> nsum s (\\i. B EXP i * b i) DIV (B EXP n) MOD B =\n            if n IN s then b n else 0",
      ),
      t76,
    ),
  )
}

