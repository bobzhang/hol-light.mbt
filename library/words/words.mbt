    @parser.parse_term(
      "!(x:N word) (y:N word).\n          ival x < ival y <=>\n          (bit (dimindex(:N)-1) x /\\ ~bit (dimindex(:N)-1) y) \\/\n           (bit (dimindex(:N)-1) x \\/ ~bit (dimindex(:N)-1) y) /\\\n          bit (dimindex(:N)-1) (word_sub x y)",
    ),
