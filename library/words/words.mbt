///|
/// WORD_PMUL_CONV
fn step_902() -> Unit raise {
  let t4972 = @equal.rand_conv(word_zx_conv)
  let in_conv : (@kernel.Term) -> @kernel.Thm raise = @equal.thenc(
    @simp.gen_rewrite_conv(
      fn(
        x4971 : (@kernel.Term) -> @kernel.Thm raise,
      ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
        x4971
      },
      @list.List([@equal.gsym(@bool.conjunct2(word_pmul_zx()))]),
    ),
    t4972,
  )
  let base_conv : (@kernel.Term) -> @kernel.Thm raise = @simp.gen_rewrite_conv(
    fn(
      x4973 : (@kernel.Term) -> @kernel.Thm raise,
    ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
      x4973
    },
    @list.List([@bool.conjunct2(word_pmul_0())]),
  )
  let t4977 = @equal.binop2_conv(word_ushr_conv, word_shl_conv)
  let t4976 = @simp.gen_rewrite_conv(
    fn(
      x4975 : (@kernel.Term) -> @kernel.Thm raise,
    ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
      x4975
    },
    @list.List([@class.cond_clauses()]),
  )
  let t4978 = @equal.binop2_conv(
    @equal.thenc(@equal.rator_conv(@equal.land_conv(bit_word_conv)), t4976),
    t4977,
  )
  let step_conv : (@kernel.Term) -> @kernel.Thm raise = @equal.thenc(
    @simp.gen_rewrite_conv(
      fn(
        x4974 : (@kernel.Term) -> @kernel.Thm raise,
      ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
        x4974
      },
      @list.List([word_pmul_step()]),
    ),
    t4978,
  )
  fn conv(x4979 : @kernel.Term) -> @kernel.Thm raise {
    let tm = x4979
    base_conv(tm) catch {
      Failure(_) =>
        @equal.thenc(
          @equal.thenc(step_conv, @equal.rand_conv(conv)),
          word_xor_conv,
        )(tm)
      e => raise e
    }
  }
  let fullconv : (@kernel.Term) -> @kernel.Thm raise = @equal.thenc(
    in_conv, conv,
  )
  word_pmul_conv_c.set(fn(x4980 : @kernel.Term) -> @kernel.Thm raise {
    let tm_1 = x4980
    match tm_1 {
      @kernel.Term::Comb(
        @kernel.Term::Comb(
          @kernel.Term::Const("word_pmul", _),
          @kernel.Term::Comb(@kernel.Term::Const("word", _), m)
        ),
        @kernel.Term::Comb(@kernel.Term::Const("word", _), n)
      ) if @nums.is_numeral(m) && @nums.is_numeral(n) => fullconv(tm_1)
      _ => raise Failure("WORD_PMUL_CONV")
    }
  })
}

