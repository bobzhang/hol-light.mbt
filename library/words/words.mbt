///|
/// EXPAND_NSUM_BALANCE_CONV
fn step_917() -> Unit raise {
  let op = @parser.parse_term("(+):num->num->num")
  let dest : (@kernel.Term) -> (@kernel.Term, @kernel.Term) raise = (
    x5080 : @kernel.Term,
  ) => @basics.dest_binop(op, x5080)
  let mk : (@kernel.Term) -> ((@kernel.Term) -> @kernel.Term raise) raise = fn(
    x5083 : @kernel.Term,
  ) -> ((@kernel.Term) -> @kernel.Term raise) raise {
    fn(x5084 : @kernel.Term) -> @kernel.Term raise {
      ((x5081 : @kernel.Term, x5082 : @kernel.Term) => {
        @basics.mk_binop(op, x5081, x5082)
      })(x5083, x5084)
    }
  }
  let lmk : (@list.List[@kernel.Term]) -> @kernel.Term raise = (
    x5085 : @list.List[@kernel.Term],
  ) => @basics.list_mk_binop(op, x5085)
  let prv : (@kernel.Term) -> @kernel.Thm raise = @theorems.ac(@arith.add_ac())
  fn balance(x5086 : @kernel.Term) -> @kernel.Term raise {
    let tm = x5086
    let tms = @lib.striplist(dest, tm)
    let n = @lib.length(tms)
    if n <= 3 {
      tm
    } else {
      let (tms1, tms2) = @lib.chop_list(n / 2, tms)
      let t5087 = balance(lmk(tms2))
      mk(balance(lmk(tms1)))(t5087)
    }
  }
  expand_nsum_balance_conv_c.set(fn(x5088 : @kernel.Term) -> @kernel.Thm raise {
    let tm_1 = x5088
    let th = @iterate.expand_nsum_conv(tm_1)
    let tm_p = @kernel.rand(@kernel.concl(th))
    let th_p = prv(@basics.mk_eq(tm_p, balance(tm_p)))
    @kernel.trans(th, th_p)
  })
}

