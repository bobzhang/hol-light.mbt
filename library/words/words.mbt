    @list.List([bitval_clauses(), @arith.mult_clauses(), @arith.add_clauses()]),
  )
  let t5346 = @equal.once_depth_conv(bit_word_conv)
  let t5345 = @equal.rand_conv(
    @equal.thenc(
      @equal.land_conv(
        @equal.rand_conv(
          @equal.thenc(
            @equal.land_conv(@cart.dimindex_conv),
            @calc_num.num_sub_conv,
          ),
        ),
      ),
      expand_nsum_balance_conv,
