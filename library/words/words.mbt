/// `EMPOWER_CONV`
pub fn empower_conv(x : @kernel.Term) -> @kernel.Thm raise {
  empower_conv_c.get()(x)
}

///|
/// VAL_EXPAND_CONV
fn step_498() -> Unit raise {
  let t2005 = @simp.asm_rewrite_tac(@list.List([@iterate.nsum_clauses()]))
  let t2004 = @simp.rewrite_tac(@list.List([val_mod(), @iterate.numseg_lt()]))
  let t2006 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), t2004),
      @class.cond_cases_tac,
    ),
    t2005,
  )
  let pth_mod = @tactics.prove(
    @parser.parse_term(
      "!(x:N word) k.\n           val x MOD 2 EXP k =\n           if k = 0 then 0\n           else nsum (0..k-1) (\\i. 2 EXP i * bitval(bit i x))",
    ),
    t2006,
  )
  let t2009 = @simp.simp_tac(
    @list.List([
      @cart.dimindex_nonzero(),
      @int.arith_rule(@parser.parse_term("~(d = 0) ==> (x <= d - 1 <=> x < d)")),
    ]),
  )
  let t2008 = @simp.rewrite_tac(
    @list.List([@sets.extension(), @sets.in_elim_thm(), @iterate.in_numseg()]),
  )
  let t2007 = @simp.rewrite_tac(@list.List([val_div()]))
  let t2010 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), t2007),
          @tactics.ap_thm_tac,
        ),
        @tactics.ap_term_tac,
      ),
      t2008,
    ),
    t2009,
  )
  let pth_div = @tactics.prove(
    @parser.parse_term(
      "!(x:N word) k.\n           val x DIV 2 EXP k =\n           nsum (k..dimindex(:N)-1) (\\i. 2 EXP (i - k) * bitval(bit i x))",
    ),
    t2010,
  )
  let t2011 = @equal.land_conv(
    @equal.rand_conv(
      @equal.thenc(
        @equal.land_conv(word_size_conv().val),
        @calc_num.num_sub_conv,
      ),
    ),
  )
  let base_rule : (@kernel.Term) -> @kernel.Thm raise = @equal.thenc(
    @drule.part_match(@equal.lhand, val()),
    t2011,
  )
  let t2013 = @equal.land_conv(
    @equal.rand_conv(
      @equal.thenc(
        @equal.land_conv(word_size_conv().val),
        @calc_num.num_sub_conv,
      ),
    ),
  )
  let t2012 = @drule.part_match(@equal.lhand, pth_div)
  let div_rule : (@kernel.Term) -> @kernel.Thm raise = @equal.thenc(
    @equal.thenc(@equal.rand_conv(empower_conv), t2012),
    t2013,
  )
  let t2018 = @equal.try_conv(
    @equal.land_conv(@equal.rand_conv(@calc_num.num_sub_conv)),
  )
  let t2017 = @simp.gen_rewrite_conv(
    fn(
      x2016 : (@kernel.Term) -> @kernel.Thm raise,
    ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
      x2016
    },
    @list.List([@class.cond_clauses()]),
  )
  let t2015 = @equal.rator_conv(@equal.land_conv(@calc_num.num_eq_conv))
  let t2014 = @drule.part_match(@equal.lhand, pth_mod)
  let mod_rule : (@kernel.Term) -> @kernel.Thm raise = @equal.thenc(
    @equal.thenc(
      @equal.thenc(@equal.thenc(@equal.rand_conv(empower_conv), t2014), t2015),
      t2017,
    ),
    t2018,
  )
  let coreconv : (@kernel.Term) -> @kernel.Thm raise = fn(
    x2019 : @kernel.Term,
  ) -> @kernel.Thm raise {
    let tm = x2019
    match tm {
      @kernel.Term::Comb(@kernel.Term::Const("val", _), t) => base_rule(tm)
      @kernel.Term::Comb(
        @kernel.Term::Comb(
          @kernel.Term::Const("DIV", _),
          @kernel.Term::Comb(@kernel.Term::Const("val", _), _)
        ),
        n
      ) => div_rule(tm)
      @kernel.Term::Comb(
        @kernel.Term::Comb(
          @kernel.Term::Const("MOD", _),
          @kernel.Term::Comb(@kernel.Term::Const("val", _), _)
        ),
        n_1
      ) => mod_rule(tm)
      _ => raise Failure("VAL_EXPAND_CONV: not of expected form")
    }
  }
  let t2020 = @equal.once_depth_conv(@calc_num.num_sub_conv)
  val_expand_conv_c.set(
    @equal.thenc(@equal.thenc(coreconv, @iterate.expand_nsum_conv), t2020),
  )
}

