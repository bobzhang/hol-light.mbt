              @list.List[(@kernel.Term, @kernel.Term)],
              @list.List[(@kernel.HolType, @kernel.HolType)],
            ),
            @list.List[@kernel.Thm],
          ) -> @kernel.Thm raise,
        ) raise,
      ),
    ) -> @kernel.Thm raise {
      @tactics.prove(x675.0, x675.1)
    })(t683),
  )
  let t684 = @simp.rewrite_tac(@list.List([@calc_num.arith_suc()]))
  let thb1s = @tactics.prove(@parser.parse_term("BIT1 i = SUC (BIT0 i)"), t684)
  let thb10 = @drule.match_mp(@bool.disch_all(ths0))(thb1s)
  let thb11 = @drule.match_mp(@bool.disch_all(ths1))(thb1s)
  let t689 = @simp.rewrite_tac(@list.List([@calc_num.arith_suc()]))
  let t690 = @tactics.then_tac(
    @tactics.disch_then(fn(
      x686 : @kernel.Thm,
    ) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> (
      (
        @list.List[@kernel.Term],
        (
          @list.List[(Int, @kernel.Term)],
          @list.List[(@kernel.Term, @kernel.Term)],
          @list.List[(@kernel.HolType, @kernel.HolType)],
        ),
      ),
      @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)],
      (
        (
          @list.List[(Int, @kernel.Term)],
          @list.List[(@kernel.Term, @kernel.Term)],
          @list.List[(@kernel.HolType, @kernel.HolType)],
        ),
        @list.List[@kernel.Thm],
      ) -> @kernel.Thm raise,
    ) raise) raise {
      let s687 = @tactics.subst1_tac(x686)
      fn(
        x688 : (@list.List[(String, @kernel.Thm)], @kernel.Term),
      ) -> (
        (
          @list.List[@kernel.Term],
          (
            @list.List[(Int, @kernel.Term)],
            @list.List[(@kernel.Term, @kernel.Term)],
            @list.List[(@kernel.HolType, @kernel.HolType)],
          ),
        ),
        @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)],
        (
          (
            @list.List[(Int, @kernel.Term)],
            @list.List[(@kernel.Term, @kernel.Term)],
            @list.List[(@kernel.HolType, @kernel.HolType)],
          ),
          @list.List[@kernel.Thm],
        ) -> @kernel.Thm raise,
      ) raise {
        s687(x688)
      }
    }),
    t689,
  )
  let t691 = (@parser.parse_term("i = SUC j ==> BIT0 i = SUC (BIT1 j)"), t690)
  let thsb1 = @bool.undisch(
    (fn(
      x685 : (
        @kernel.Term,
        ((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> (
          (
            @list.List[@kernel.Term],
            (
              @list.List[(Int, @kernel.Term)],
              @list.List[(@kernel.Term, @kernel.Term)],
              @list.List[(@kernel.HolType, @kernel.HolType)],
            ),
          ),
          @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)],
          (
            (
              @list.List[(Int, @kernel.Term)],
              @list.List[(@kernel.Term, @kernel.Term)],
              @list.List[(@kernel.HolType, @kernel.HolType)],
            ),
            @list.List[@kernel.Thm],
          ) -> @kernel.Thm raise,
        ) raise,
      ),
    ) -> @kernel.Thm raise {
      @tactics.prove(x685.0, x685.1)
    })(t691),
  )
  let t692 = (@parser.parse_term("BIT1 j"), j)
  let thb00 = @bool.prove_hyp(
    thsb1,
    @kernel.inst_rule(
      @list.List([(@parser.parse_term("BIT0 i"), i), t692]),
      ths0,
    ),
  )
  let t693 = (@parser.parse_term("BIT1 j"), j)
  let thb01 = @bool.prove_hyp(
    thsb1,
    @kernel.inst_rule(
      @list.List([(@parser.parse_term("BIT0 i"), i), t693]),
      ths1,
    ),
  )
  let t694 = @kernel.assume_rule(@parser.parse_term("i = _0"))
  let t695 = @kernel.trans(
    @equal.ap_term(@parser.parse_term("BIT0"), t694),
    b00,
  )
  let th = @equal.ap_term(@parser.parse_term("numbit"), t695)
  let t696 = @kernel.trans(
    @equal.ap_thm(th, @parser.parse_term("BIT1 n")),
    th01,
  )
  let (th0b00, th0b01) = (
    @kernel.trans(@equal.ap_thm(th, @parser.parse_term("BIT0 n")), th00),
    t696,
  )
  let t697 = @simp.rewrite_tac(@list.List([@nums.numeral()]))
  let thn = @tactics.prove(
    @parser.parse_term("numbit (NUMERAL i) (NUMERAL n) = numbit i n"),
    t697,
  )
  let get_suc : (@kernel.Thm) -> (@kernel.Term?, @kernel.Thm) raise = fn(
    x698 : @kernel.Thm,
  ) -> (@kernel.Term?, @kernel.Thm) raise {
    let th_1 = x698
    (Some(@kernel.rand(@equal.rhs(@kernel.concl(th_1)))), th_1)
  }
  fn mk_pred(x699 : @kernel.Term) -> (@kernel.Term?, @kernel.Thm) raise {
    match x699 {
      @kernel.Term::Comb(@kernel.Term::Const("BIT0", _), i_p) =>
        match mk_pred(i_p) {
          (Some(j_p), th_2) =>
            get_suc(
              @bool.prove_hyp(
                th_2,
                @kernel.inst_rule(@list.List([(i_p, i), (j_p, j)]), thsb1),
              ),
            )
          (None, th_3) => (None, @kernel.trans(@equal.ap_term(b0, th_3), b00))
        }
      @kernel.Term::Comb(@kernel.Term::Const("BIT1", _), i_p_1) =>
        get_suc(@kernel.inst_rule(@list.List([(i_p_1, i)]), thb1s))
      @kernel.Term::Const("_0", _) as i_p_2 => (None, @kernel.refl(i_p_2))
      _ => raise Failure("BIT_PRED")
    }
  }
  let go = (x700 : (@kernel.Term, @kernel.Term)) => {
    go_l(
      i, th_0, n, th00, th01, th0b00, thb00, th0b01, thb01, thb10, b0, thb11, mk_pred,
      j, b1, x700,
    )
  }
  let go_b0 = (
    x703 : @kernel.Thm,
    x704 : @kernel.Thm,
    x705 : @kernel.Term,
    x706 : @kernel.Term,
  ) => {
    go_b0_l(
      i, th_0, n, th00, th01, th0b00, thb00, th0b01, thb01, thb10, b0, thb11, mk_pred,
      j, b1, x703, x704, x705, x706,
    )
  }
  let (bit_pred, numbit_conv) = (
    mk_pred,
    fn(x707 : @kernel.Term) -> @kernel.Thm raise {
      match x707 {
        @kernel.Term::Comb(
          @kernel.Term::Comb(
            @kernel.Term::Const("numbit", _),
            @kernel.Term::Comb(@kernel.Term::Const("NUMERAL", _), i_p_9)
          ),
          @kernel.Term::Comb(@kernel.Term::Const("NUMERAL", _), n_p_7)
        ) => {
          let t708 = go((i_p_9, n_p_7))
          @kernel.trans(
            @kernel.inst_rule(@list.List([(i_p_9, i), (n_p_7, n)]), thn),
            t708,
          )
        }
        @kernel.Term::Comb(
          @kernel.Term::Comb(@kernel.Term::Const("numbit", _), i_p_10),
          n_p_8
        ) => go((i_p_10, n_p_8))
        _ => raise Failure("NUMBIT_CONV")
      }
    },
  )
  bit_pred_c.set(bit_pred)
  numbit_conv_c.set(numbit_conv)
}

///|
fn go_l(
  i : @kernel.Term,
  th_0 : @kernel.Thm,
  n : @kernel.Term,
  th00 : @kernel.Thm,
  th01 : @kernel.Thm,
  th0b00 : @kernel.Thm,
  thb00 : @kernel.Thm,
  th0b01 : @kernel.Thm,
  thb01 : @kernel.Thm,
  thb10 : @kernel.Thm,
  b0 : @kernel.Term,
  thb11 : @kernel.Thm,
  mk_pred : (@kernel.Term) -> (@kernel.Term?, @kernel.Thm) raise,
  j : @kernel.Term,
  b1 : @kernel.Term,
  x700 : (@kernel.Term, @kernel.Term),
) -> @kernel.Thm raise {
  let go = (x700 : (@kernel.Term, @kernel.Term)) => {
    go_l(
      i, th_0, n, th00, th01, th0b00, thb00, th0b01, thb01, thb10, b0, thb11, mk_pred,
      j, b1, x700,
    )
  }
  let go_b0 = (
    x703 : @kernel.Thm,
    x704 : @kernel.Thm,
    x705 : @kernel.Term,
    x706 : @kernel.Term,
  ) => {
    go_b0_l(
      i, th_0, n, th00, th01, th0b00, thb00, th0b01, thb01, thb10, b0, thb11, mk_pred,
      j, b1, x703, x704, x705, x706,
    )
  }
  match x700 {
    (i_p_3, @kernel.Term::Const("_0", _)) =>
      @kernel.inst_rule(@list.List([(i_p_3, i)]), th_0)
    (
      @kernel.Term::Const("_0", _),
      @kernel.Term::Comb(@kernel.Term::Const("BIT0", _), n_p),
    ) => @kernel.inst_rule(@list.List([(n_p, n)]), th00)
    (
      @kernel.Term::Const("_0", _),
      @kernel.Term::Comb(@kernel.Term::Const("BIT1", _), n_p_1),
    ) => @kernel.inst_rule(@list.List([(n_p_1, n)]), th01)
    (
      @kernel.Term::Comb(@kernel.Term::Const("BIT0", _), i_p_4),
      @kernel.Term::Comb(@kernel.Term::Const("BIT0", _), n_p_2),
    ) => go_b0(th0b00, thb00, i_p_4, n_p_2)
    (
      @kernel.Term::Comb(@kernel.Term::Const("BIT0", _), i_p_5),
      @kernel.Term::Comb(@kernel.Term::Const("BIT1", _), n_p_3),
    ) => go_b0(th0b01, thb01, i_p_5, n_p_3)
    (
      @kernel.Term::Comb(@kernel.Term::Const("BIT1", _), i_p_6),
      @kernel.Term::Comb(@kernel.Term::Const("BIT0", _), n_p_4),
    ) => {
      let t701 = go((@kernel.mk_comb(b0, i_p_6), n_p_4))
      @kernel.trans(
        @kernel.inst_rule(@list.List([(i_p_6, i), (n_p_4, n)]), thb10),
        t701,
      )
    }
    (
      @kernel.Term::Comb(@kernel.Term::Const("BIT1", _), i_p_7),
      @kernel.Term::Comb(@kernel.Term::Const("BIT1", _), n_p_5),
    ) => {
      let t702 = go((@kernel.mk_comb(b0, i_p_7), n_p_5))
      @kernel.trans(
        @kernel.inst_rule(@list.List([(i_p_7, i), (n_p_5, n)]), thb11),
        t702,
      )
    }
    _ => raise Failure("NUMBIT_CONV")
  }
}

///|
fn go_b0_l(
  i : @kernel.Term,
  th_0 : @kernel.Thm,
  n : @kernel.Term,
  th00 : @kernel.Thm,
  th01 : @kernel.Thm,
  th0b00 : @kernel.Thm,
  thb00 : @kernel.Thm,
  th0b01 : @kernel.Thm,
  thb01 : @kernel.Thm,
  thb10 : @kernel.Thm,
  b0 : @kernel.Term,
  thb11 : @kernel.Thm,
  mk_pred : (@kernel.Term) -> (@kernel.Term?, @kernel.Thm) raise,
  j : @kernel.Term,
  b1 : @kernel.Term,
  x703 : @kernel.Thm,
  x704 : @kernel.Thm,
  x705 : @kernel.Term,
  x706 : @kernel.Term,
) -> @kernel.Thm raise {
  let go = (x700 : (@kernel.Term, @kernel.Term)) => {
    go_l(
      i, th_0, n, th00, th01, th0b00, thb00, th0b01, thb01, thb10, b0, thb11, mk_pred,
      j, b1, x700,
    )
  }
  let th0 = x703
  let ths = x704
  let i_p_8 = x705
  let n_p_6 = x706
  match mk_pred(i_p_8) {
    (Some(j_p_1), th_4) => {
      let th_p = @bool.prove_hyp(
        th_4,
        @kernel.inst_rule(@list.List([(i_p_8, i), (j_p_1, j), (n_p_6, n)]), ths),
      )
      @kernel.trans(th_p, go((@kernel.mk_comb(b1, j_p_1), n_p_6)))
    }
    (None, th_5) =>
      @bool.prove_hyp(
        th_5,
        @kernel.inst_rule(@list.List([(i_p_8, i), (n_p_6, n)]), th0),
      )
  }
}

