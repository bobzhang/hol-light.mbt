///|
/// VAL_WORD
fn step_107() -> Unit raise {
  let t224 = @simp.rewrite_tac(@list.List([@arith.mod_mult_mod()]))
  let t223 = @simp.once_rewrite_tac(@list.List([@arith.mult_sym()]))
  let t222 = @simp.asm_rewrite_tac(
    @list.List([@iterate.nsum_clauses_numseg_lt(), @arith.exp(), @arith.mod_1()]),
  )
  let t220 = @parser.parse_term("k:num")
  let t221 = @tactics.spec_tac(@parser.parse_term("dimindex(:N)"), t220)
  let t225 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(
                @tactics.gen_tac,
                @simp.simp_tac(@list.List([val_def(), bitval_bit_word()])),
              ),
              t221,
            ),
            @nums.induct_tac,
          ),
          t222,
        ),
        t223,
      ),
      t224,
    ),
    @int.arith_tac,
  )
  val_word_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!n. val(word n:N word) = n MOD (2 EXP (dimindex(:N)))",
      ),
      t225,
    ),
  )
}

