  let t2825 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(
                @simp.rewrite_tac(
                  @list.List([
                    word_bitwise_rule(
                      @parser.parse_term(
                        "word_and (word 1:N word) x = word_and x (word 1)",
                      ),
                    ),
                  ]),
                ),
                @tactics.gen_tac,
              ),
              @class.cond_cases_tac,
            ),
            t2820,
          ),
