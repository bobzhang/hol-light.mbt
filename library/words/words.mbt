      @tactics.prove(x859.0, x859.1)
    })(t861),
  )
  let (num_shift_add_core, num_shift_add_conv) = (
    fn(
      x862 : @kernel.Term,
    ) -> ((@kernel.Term) -> ((@kernel.Term) -> @kernel.Thm raise) raise) raise {
      fn(x863 : @kernel.Term) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
        fn(x864 : @kernel.Term) -> @kernel.Thm raise { go(x862, x863, x864) }
      }
    },
    fn(x865 : @kernel.Term) -> @kernel.Thm raise {
      match x865 {
        @kernel.Term::Comb(
          @kernel.Term::Comb(
            @kernel.Term::Comb(
              @kernel.Term::Const("num_shift_add", _),
              @kernel.Term::Comb(@kernel.Term::Const("NUMERAL", _), a_p_3)
            ),
            @kernel.Term::Comb(@kernel.Term::Const("NUMERAL", _), b_p_1)
          ),
          @kernel.Term::Comb(@kernel.Term::Const("NUMERAL", _), i_p_1)
        ) => {
          let th_2 = go(a_p_3, b_p_1, i_p_1)
          @bool.prove_hyp(
            th_2,
            @kernel.inst_rule(
              @list.List([
                (a_p_3, a),
                (b_p_1, b),
                (i_p_1, i),
                (@equal.rhs(@kernel.concl(th_2)), e),
              ]),
              pthn,
            ),
          )
        }
        @kernel.Term::Comb(
          @kernel.Term::Comb(
            @kernel.Term::Comb(@kernel.Term::Const("num_shift_add", _), a_p_4),
            b_p_2
          ),
          i_p_2
        ) => go(a_p_4, b_p_2, i_p_2)
        _ => raise Failure("NUM_SHIFT_ADD_CONV")
      }
    },
  )
  num_shift_add_core_c.set(num_shift_add_core)
  num_shift_add_conv_c.set(num_shift_add_conv)
}

