        )(tm)
      }
      @kernel.Term::Comb(
        @kernel.Term::Comb(@kernel.Term::Const("int_lt", _), _),
        _
      ) =>
        @equal.thenc(
          @equal.thenc(
            @equal.binop_conv(iwordify_conv),
            ival_word_adjust_binop_conv,
          ),
          ival_lt_conv,
        )(tm)
      @kernel.Term::Comb(
        @kernel.Term::Comb(@kernel.Term::Const("int_gt", _), _),
        _
      ) => {
        let t5327 = @simp.gen_rewrite_conv(
