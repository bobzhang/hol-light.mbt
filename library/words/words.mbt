///|
/// WORDIFY_CONV
fn step_924() -> Unit raise {
  let m_ty = @parser.parse_type("M")
  let n_ty = @parser.parse_type("N")
  let p_ty = @parser.parse_type("P")
  let num_ty = @parser.parse_type("num")
  let and_th = @class.taut(@parser.parse_term("T /\\ T <=> T"))
  let t5103 = @simp.rewrite_tac(@list.List([val_word_bitval()]))
  let pth_bitval = @tactics.prove(
    @parser.parse_term("!b. bitval b = val(word(bitval b):1 word)"),
    t5103,
  )
  let t5115 = @simp.rewrite_tac(
    @list.List([@arith.le_exp(), @calc_num.arith_eq()]),
  )
  let t5113 = @tactics.match_mp_tac(@arith.le_add2())
  let t5114 = @list.List([
    @tactics.then_tac(
      @tactics.then_tac(
        @simp.rewrite_tac(@list.List([@arith.exp(), @arith.mult_2()])),
        t5113,
      ),
      @tactics.conj_tac,
    ),
    @tactics.all_tac,
  ])
  let t5111 = @parser.parse_term("2 EXP SUC(MAX (dimindex(:M)) (dimindex(:N)))")
  let t5112 = @tactics.trans_tac(@arith.le_trans())(t5111)
  let t5110 = @simp.simp_tac(@list.List([@arith.lt_add2(), val_bound()]))
  let t5108 = @parser.parse_term("2 EXP dimindex(:M) + 2 EXP dimindex(:N)")
  let t5109 = @tactics.trans_tac(@arith.lte_trans())(t5108)
  let t5107 = @tactics.match_mp_tac(@arith.mod_lt())
  let t5106 = @tactics.conv_tac(@equal.sym_conv)
  let t5105 = @tactics.conv_tac(@arith.mod_down_conv)
  let t5104 = @simp.rewrite_tac(@list.List([val_word_add(), val_word_zx_gen()]))
  let t5116 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.thenl(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(
                @tactics.then_tac(
                  @tactics.then_tac(
                    @tactics.then_tac(
                      @tactics.then_tac(
                        @tactics.repeat_tac(@tactics.strip_tac),
                        t5104,
                      ),
                      t5105,
                    ),
                    t5106,
                  ),
                  t5107,
                ),
                t5109,
              ),
              t5110,
            ),
            t5112,
          ),
          @tactics.conj_tac,
        ),
        t5114,
      ),
      t5115,
    ),
    @int.asm_arith_tac,
  )
  let pth_add = @tactics.prove(
    @parser.parse_term(
      "dimindex(:M) < dimindex(:P) /\\ dimindex(:N) < dimindex(:P)\n     ==> !x y. val(x:M word) + val(y:N word) =\n               val(word_add (word_zx x) (word_zx y):P word)",
    ),
    t5116,
  )
  let t5126 = @simp.rewrite_tac(@list.List([val_bound()]))
  let t5125 = @tactics.match_mp_tac(@arith.lt_mult2())
  let t5124 = @simp.rewrite_tac(@list.List([@arith.exp_add()]))
  let t5123 = @simp.asm_rewrite_tac(
    @list.List([@arith.le_exp(), @calc_num.arith_eq()]),
  )
  let t5121 = @parser.parse_term("2 EXP (dimindex (:M) + dimindex (:N))")
  let t5122 = @tactics.trans_tac(@arith.lte_trans())(t5121)
  let t5120 = @tactics.match_mp_tac(@arith.mod_lt())
  let t5119 = @tactics.conv_tac(@equal.sym_conv)
  let t5118 = @tactics.conv_tac(@arith.mod_down_conv)
  let t5117 = @simp.rewrite_tac(@list.List([val_word_mul(), val_word_zx_gen()]))
  let t5127 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(
            @tactics.then_tac(
              @tactics.then_tac(
                @tactics.then_tac(
                  @tactics.then_tac(
                    @tactics.repeat_tac(@tactics.strip_tac),
                    t5117,
                  ),
                  t5118,
                ),
                t5119,
              ),
              t5120,
            ),
            t5122,
          ),
          t5123,
        ),
        t5124,
      ),
      t5125,
    ),
    t5126,
  )
  let pth_mul = @tactics.prove(
    @parser.parse_term(
      "dimindex(:M) + dimindex(:N) <= dimindex(:P)\n     ==> !x y. val(x:M word) * val(y:N word) =\n               val(word_mul (word_zx x) (word_zx y):P word)",
    ),
    t5127,
  )
  fn log2(x5128 : @num.Num, x5129 : @num.Num, x5130 : Int) -> Int raise {
    let n = x5128
    let m = x5129
    let i = x5130
    if @num.lt_num(n, m) {
      i
    } else {
      let t5131 = i + 1
      log2(n, @num.mult_num(@num.num_2, m), t5131)
    }
  }
  let log2_1 : (@num.Num) -> @num.Num raise = fn(
    x5132 : @num.Num,
  ) -> @num.Num raise {
    let n_1 = x5132
    @num.num_of_int(log2(@num.abs_num(n_1), @num.num_1, 0))
  }
  fn conv(x5133 : @kernel.Term) -> @kernel.Thm raise {
    let tm = x5133
    match tm {
      @kernel.Term::Comb(@kernel.Term::Const("bitval", _), _) =>
        @simp.gen_rewrite_conv(
          fn(
            x5134 : (@kernel.Term) -> @kernel.Thm raise,
          ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
            x5134
          },
          @list.List([pth_bitval]),
        )(tm)
      @kernel.Term::Comb(
        @kernel.Term::Const("val", _),
        @kernel.Term::Comb(@kernel.Term::Const("word", _), _)
      ) => @equal.try_conv(@equal.rand_conv(@equal.rand_conv(conv)))(tm)
      @kernel.Term::Comb(@kernel.Term::Const("val", _), _) => @kernel.refl(tm)
      @kernel.Term::Comb(@kernel.Term::Const("NUMERAL", _), _) => {
        let n_2 = @num.max_num(@num.num_1, log2_1(@basics.dest_numeral(tm)))
        let th1 = @bool.spec(
          tm,
          @kernel.inst_type(
            @list.List([(@basics.mk_finty(n_2), n_ty)]),
            val_word_eq(),
          ),
        )
        let t5135 = @equal.lhand(@kernel.concl(th1))
        let th2 = @equal.thenc(
          @equal.rand_conv(
            @equal.thenc(
              @equal.rand_conv(@cart.dimindex_conv),
              @calc_num.num_exp_conv,
            ),
          ),
          @calc_num.num_lt_conv,
        )(t5135)
        @equal.sym(@bool.mp(th1, @bool.eqt_elim(th2)))
      }
      @kernel.Term::Comb(@kernel.Term::Comb(@kernel.Term::Const("+", _), _), _) => {
        let eth = @equal.binop_conv(conv)(tm)
        let mtm = @kernel.rand(@equal.lhand(@kernel.rand(@kernel.concl(eth))))
        let ntm = @kernel.rand(@kernel.rand(@kernel.rand(@kernel.concl(eth))))
        let mty = dest_word_ty(@kernel.type_of(mtm))
        let nty = dest_word_ty(@kernel.type_of(ntm))
        let pty = @num.add_num(@num.max_num(mty, nty), @num.num_1)
        let t5136 = (@basics.mk_finty(pty), p_ty)
        let t5137 = (@basics.mk_finty(nty), n_ty)
        let th = @kernel.inst_type(
          @list.List([(@basics.mk_finty(mty), m_ty), t5137, t5136]),
          pth_add,
        )
        let t5138 = @equal.lhand(@kernel.concl(th))
        let ath = @equal.binop_conv(
          @equal.thenc(
            @equal.binop_conv(@cart.dimindex_conv),
            @calc_num.num_lt_conv,
          ),
        )(t5138)
        @kernel.trans(
          eth,
          @bool.specl(
            @list.List([mtm, ntm]),
            @bool.mp(th, @bool.eqt_elim(@kernel.trans(ath, and_th))),
          ),
        )
      }
      @kernel.Term::Comb(@kernel.Term::Comb(@kernel.Term::Const("*", _), _), _) => {
        let eth_1 = @equal.binop_conv(conv)(tm)
        let mtm_1 = @kernel.rand(
          @equal.lhand(@kernel.rand(@kernel.concl(eth_1))),
        )
        let ntm_1 = @kernel.rand(
          @kernel.rand(@kernel.rand(@kernel.concl(eth_1))),
        )
        let mty_1 = dest_word_ty(@kernel.type_of(mtm_1))
        let nty_1 = dest_word_ty(@kernel.type_of(ntm_1))
        let pty_1 = @num.add_num(mty_1, nty_1)
        let t5139 = (@basics.mk_finty(pty_1), p_ty)
        let t5140 = (@basics.mk_finty(nty_1), n_ty)
        let th_1 = @kernel.inst_type(
          @list.List([(@basics.mk_finty(mty_1), m_ty), t5140, t5139]),
          pth_mul,
        )
        let t5141 = @equal.lhand(@kernel.concl(th_1))
        let ath_1 = @equal.thenc(
          @equal.binop2_conv(
            @equal.thenc(
              @equal.binop_conv(@cart.dimindex_conv),
              @calc_num.num_add_conv,
            ),
            @cart.dimindex_conv,
          ),
          @calc_num.num_le_conv,
        )(t5141)
        @kernel.trans(
          eth_1,
          @bool.specl(
            @list.List([mtm_1, ntm_1]),
            @bool.mp(th_1, @bool.eqt_elim(ath_1)),
          ),
        )
      }
      _ => raise Failure("WORDIFY_CONV")
    }
  }
  let fullconv : (@kernel.Term) -> @kernel.Thm raise = @equal.thenc(
    conv,
    @simp.gen_rewrite_conv(
      fn(
        x5142 : (@kernel.Term) -> @kernel.Thm raise,
      ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
        let s5143 = @equal.depth_conv(x5142)
        fn(x5144 : @kernel.Term) -> @kernel.Thm raise { s5143(x5144) }
