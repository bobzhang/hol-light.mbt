///|
fn[TA] interleave_l(x5395 : @list.List[@list.List[TA]]) -> @list.List[TA] raise {
  let lis = x5395
  match lis {
    Empty => @list.empty()
    More(Empty, tail=rst) => interleave_l(rst)
    More(More(h, tail=t), tail=rst_1) =>
      interleave_l(rst_1.concat(@list.List([t]))).prepend(h)
  }
}

