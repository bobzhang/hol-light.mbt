  word_mul_expand_conv_c.set(fn(x5360 : @kernel.Term) -> @kernel.Thm raise {
    let tm = x5360
    match tm {
      @kernel.Term::Comb(
        @kernel.Term::Comb(@kernel.Term::Const("word_mul", _), _),
