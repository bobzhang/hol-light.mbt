///|
/// BITBLAST_THEN
fn step_935() -> Unit raise {
  let carrying : (@kernel.Term) -> Bool raise = fn(
    x5380 : @kernel.Term,
  ) -> Bool raise {
    let tm = x5380
    match tm {
      @kernel.Term::Comb(
        @kernel.Term::Comb(@kernel.Term::Const("word_add", _), _),
        _
      ) => true
      @kernel.Term::Comb(
        @kernel.Term::Comb(@kernel.Term::Const("word_sub", _), _),
        _
      ) => true
      @kernel.Term::Comb(
        @kernel.Term::Const("word_neg", _),
        @kernel.Term::Comb(
          @kernel.Term::Const("word", _),
          @kernel.Term::Comb(@kernel.Term::Const("bitval", _), _)
        )
      ) => false
      @kernel.Term::Comb(@kernel.Term::Const("word_neg", _), _) => true
      _ => false
    }
  }
  let t5382 = @equal.binder_conv(
    @equal.land_conv(@equal.rand_conv(word_size_conv().val)),
  )
  let bitwise_expand_conv : (@kernel.Term) -> @kernel.Thm raise = @equal.thenc(
    @equal.thenc(
      @simp.gen_rewrite_conv(
        fn(
          x5381 : (@kernel.Term) -> @kernel.Thm raise,
        ) -> ((@kernel.Term) -> @kernel.Thm raise) raise {
          x5381
        },
        @list.List([word_eq_bits_alt()]),
      ),
      t5382,
    ),
    @calc_num.expand_cases_conv,
  )
  let bitblast_equation : (@kernel.Thm) -> @kernel.Thm raise = fn(
    x5383 : @kernel.Thm,
  ) -> @kernel.Thm raise {
    let th = x5383
    let ths = @bool.conjuncts_rule(@equal.conv_rule(bitwise_expand_conv, th))
    let t5390 = @equal.rand_conv(@simp.rewrite_conv(@list.empty()))
    let t5389 = @equal.top_depth_conv(fn(
      x5388 : @kernel.Term,
    ) -> @kernel.Thm raise {
      bit_word_conv(
        ((x5387 : @kernel.Term) => {
          @lib.check(
            fn(x5386 : @kernel.Term) -> Bool raise {
              (fn(x5385 : @kernel.Term) -> Bool raise {
                (fn(x5384 : Bool) -> Bool raise { !x5384 })(carrying(x5385))
              })(@kernel.rand(x5386))
            },
            x5387,
          )
        })(x5388),
      )
    })
    let t5391 = @equal.thenc(
      @equal.thenc(
        @equal.land_conv(
          @equal.thenc(
            @equal.thenc(bit_word_conv, @equal.subs_conv(@list.List([th]))),
            t5389,
          ),
        ),
        @equal.sym_conv,
      ),
      t5390,
    )
    @lib.end_itlist(
      @bool.conj,
      @lib.map((x5392 : @kernel.Thm) => @equal.conv_rule(t5391, x5392), ths),
    )
  }
  let bit_tm = @parser.parse_term("bit:num->(N)word->bool")
  let n_ty = @parser.parse_type("N")
  let wordbits_var : (@kernel.Term) -> @list.List[@kernel.Term] raise = fn(
    x5393 : @kernel.Term,
  ) -> @list.List[@kernel.Term] raise {
    let tm_1 = x5393
    try {
      let ty = @kernel.type_of(tm_1)
      let n = dest_word_ty(ty)
      let btm = @kernel.inst(@list.List([(@basics.mk_finty(n), n_ty)]), bit_tm)
      @lib.map(
        fn(x5394 : Int) -> @kernel.Term raise {
          let i = x5394
          @kernel.mk_comb(@kernel.mk_comb(btm, @nums.mk_small_numeral(i)), tm_1)
        },
        @lib.range(0, @num.int_of_num(n) - 1),
      )
    } catch {
      Failure(_) => @list.empty()
      e => raise e
    }
  }
  let wordbits : (@kernel.Term) -> @list.List[@kernel.Term] raise = fn(
    x5396 : @kernel.Term,
  ) -> @list.List[@kernel.Term] raise {
    let tm_2 = x5396
    interleave_l(@lib.map(wordbits_var, @kernel.frees(tm_2)))
  }
  bitblast_then_c.set(fn(
    x5397 : (@list.List[@kernel.Term]) -> ((
      (@list.List[(String, @kernel.Thm)], @kernel.Term),
    ) -> (
      (
        @list.List[@kernel.Term],
        (
          @list.List[(Int, @kernel.Term)],
          @list.List[(@kernel.Term, @kernel.Term)],
