        t5350,
      ),
      t5354,
    ),
    t5358,
  )
  let swap : (@kernel.Term) -> @kernel.Thm raise = @simp.gen_rewrite_conv(
    fn(
      x5359 : (@kernel.Term) -> @kernel.Thm raise,
