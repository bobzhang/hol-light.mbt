}

///|
/// SIMD2
fn step_946() -> Unit raise {
  let t5460 = @int.arith_rule(@parser.parse_term("~(n + i:num < n)"))
  let t5461 = @int.arith_rule(@parser.parse_term("n + i < 2 * n <=> i < n"))
  let t5462 = @int.arith_rule(@parser.parse_term("i < n ==> i < 2 * n"))
  let t5463 = @simp.simp_tac(
    @list.List([
      @arith.add_clauses(),
      @cart.dimindex_tybit0(),
      @int.arith_rule(@parser.parse_term("MIN x x = x")),
      @arith.add_sub2(),
      t5462,
      t5461,
      t5460,
    ]),
  )
  let t5459 = @simp.rewrite_tac(
    @list.List([word_eq_bits_alt(), bit_word_subword(), bit_word_join()]),
  )
  let t5458 = @simp.rewrite_tac(@list.List([simd2()]))
  let t5464 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.then_tac(
          @tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), t5458),
          @tactics.binop_tac,
        ),
        @tactics.binop_tac,
      ),
      t5459,
    ),
    t5463,
  )
  simd2_v1_c.set(
    @tactics.prove(
      @parser.parse_term(
        "!(f:N word->N word->N word) xhi xlo yhi ylo.\n        simd2 f (word_join xhi xlo) (word_join yhi ylo) =\n        word_join (f xhi yhi) (f xlo ylo)",
      ),
      t5464,
    ),
  )
}

