///|
/// DIGITSUM_DIV_NUMSEG
fn step_29() -> Unit raise {
  let t63 = @simp.simp_tac(
    @list.List([
      @iterate.nsum_image(),
      @arith.eq_add_rcancel(),
      @trivia.o_def(),
      @arith.add_sub(),
    ]),
