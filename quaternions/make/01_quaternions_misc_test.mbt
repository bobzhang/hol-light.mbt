// Quaternions/misc.hl in its directory's load order: the test block of
// quaternions/quaternions_misc/quaternions_misc_ref_test.mbt (tools/ocaml_ref/chain_test.py), with the same golden
// (tools/ocaml_ref/Quaternions_misc_ref.expected).

///|
test "Quaternions/misc matches Quaternions/misc.ml" {
  @testkit.release_output()
  @quaternions_misc.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "Library/wo", "Library/card", "Library/floor", "Multivariate/misc",
      "Library/products", "Library/iter", "Multivariate/metric", "Library/frag",
      "Library/prime", "Library/grouptheory", "Multivariate/homology", "Library/matroids",
      "Multivariate/vectors", "Library/permutations", "Multivariate/determinants",
      "Multivariate/topology", "Multivariate/convex", "Multivariate/paths", "Multivariate/polytope",
      "Multivariate/degree", "Multivariate/derivatives", "Library/binary", "Multivariate/clifford",
      "Multivariate/integration", "Multivariate/measure", "Multivariate/complexes",
      "Quaternions/misc",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Quaternions/misc")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("VECTOR_EQ_1", () => sthm(@quaternions_misc.vector_eq_1()))
  log.attempt("VECTOR_EQ_2", () => sthm(@quaternions_misc.vector_eq_2()))
  log.attempt("VECTOR_EQ_3", () => sthm(@quaternions_misc.vector_eq_3()))
  log.attempt("VECTOR_EQ_4", () => sthm(@quaternions_misc.vector_eq_4()))
  log.attempt("DOT_LBASIS", () => sthm(@quaternions_misc.dot_lbasis()))
  log.attempt("DOT_RBASIS", () => sthm(@quaternions_misc.dot_rbasis()))
  log.attempt("VECTOR_NORM_SQNORM_UNIT", () => {
    sthm(@quaternions_misc.vector_norm_sqnorm_unit())
  })
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.probe_counters()
  @testkit.check_axioms()
  inspect(
    @testkit.normalize_times(log.contents()),
    content=(
