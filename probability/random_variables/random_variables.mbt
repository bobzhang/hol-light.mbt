  let t802 = @simp.rewrite_tac(@list.List([distribution()]))
  let t811 = @tactics.thenl(@tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.repeat_tac(@tactics.strip_tac), t802), t803), t804), t810)
