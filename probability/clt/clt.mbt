  let t5083 = @meson.asm_meson_tac(@list.empty())
  let t5079 = @parser.parse_term("expectation (p:A prob_space) (\\x. max ((X:num->A->real) 0 x) (&0))")
  let t5080 = @parser.parse_term("mu:real")
  let t5081 = @parser.parse_term("X:num->A->real")
  let t5082 = @tactics.mp_tac(@bool.ispecl(@list.List([@parser.parse_term("p:A prob_space"), t5081, t5080, t5079]), kolmogorov_slln()))
  let t5084 = @tactics.then_tac(@tactics.then_tac(@tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), @tactics.strip_tac), t5082), t5083)
  kolmogorov_slln_p_c.set(@tactics.prove(@parser.parse_term("!p:A prob_space (X:num->A->real) mu.\n    (!n. integrable p (X n)) /\\\n    (!n. integrable p (\\x. X n x pow 2)) /\\\n    (!n. expectation p (X n) = mu) /\\\n    (!n. expectation p (\\x. max (X n x) (&0)) =\n         expectation p (\\x. max (X 0 x) (&0))) /\\\n    (!i j. ~(i = j) ==> indep_rv p (X i) (X j)) /\\\n    real_summable (from 0) (\\n. variance p (X n) / &(SUC n) pow 2)\n    ==> almost_surely p\n          {x | ((\\n. inv(&(SUC n)) * sum(0..n) (\\i. X i x)) ---> mu)\n               sequentially}"), t5084))
}

