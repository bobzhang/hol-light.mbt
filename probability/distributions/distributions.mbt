/// CHAR_FN_IM_BINOMIAL_RV
fn step_211() -> Unit raise {
  let t5603 = @simp.asm_simp_tac(@list.List([binomial_char_fn_im()]))
  let t5602 = @list.List([@simp.asm_simp_tac(@list.List([@characteristic_functions.char_fn_im_simple()])), @tactics.all_tac])
  let t5601 = @tactics.subgoal_then(@parser.parse_term("char_fn_im p (X:A->real) t = simple_char_fn_im p X t"), fn(x5598 : @kernel.Thm) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise) raise {
    let s5599 = @tactics.subst1_tac(x5598)
    fn(x5600 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise {
      s5599(x5600)
    }
  })
  let t5597 = @list.List([@meson.asm_meson_tac(@list.List([binomial_rv()])), @tactics.all_tac])
  let t5596 = @tactics.subgoal_then(@parser.parse_term("simple_rv p (X:A->real)"), fn(x5593 : @kernel.Thm) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise) raise {
    let s5594 = @tactics.assume_tac(x5593)
    fn(x5595 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) -> ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise) raise {
      s5594(x5595)
    }
  })
  let t5604 = @tactics.then_tac(@tactics.thenl(@tactics.then_tac(@tactics.thenl(@tactics.then_tac(@tactics.then_tac(@tactics.repeat_tac(@tactics.gen_tac), @tactics.disch_tac), t5596), t5597), t5601), t5602), t5603)
  char_fn_im_binomial_rv_c.set(@tactics.prove(@parser.parse_term("!p:A prob_space X n q t. binomial_rv p X n q ==>\n   char_fn_im p X t =\n   sum (0..n) (\\k. &(binom(n,k)) * q pow k * (&1 - q) pow (n - k) *\n                   sin(t * &k))"), t5604))
}

