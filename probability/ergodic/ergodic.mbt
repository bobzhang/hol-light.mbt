///|
let ergodic_oscillation_invariant_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("ERGODIC_OSCILLATION_INVARIANT")

///|
/// `ERGODIC_OSCILLATION_INVARIANT`
pub fn ergodic_oscillation_invariant() -> @kernel.Thm {
  ergodic_oscillation_invariant_c.get()
}

