  fixed_rd_nearest_rel_error_c.set(@tactics.prove(@parser.parse_term("!(fmt:fformat) (x:real). abs(x) <= (finf fmt) /\\ ~(x = &0) ==>\n          (rerror x (fround(fmt) To_near x)) <= &1"), t2776))
}

///|
let fixed_rd_nearest_rel_error_c : @lib.Cell[@kernel.Thm] = @lib.Cell::new("FIXED_RD_NEAREST_REL_ERROR")

///|
/// `FIXED_RD_NEAREST_REL_ERROR`
pub fn fixed_rd_nearest_rel_error() -> @kernel.Thm {
  fixed_rd_nearest_rel_error_c.get()
}

