  let (c, glist, j) = x80
  let t82 = @drule.instantiate_all(inst, j)
  let t83 = @lib.map((x81 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) => @tactics.inst_goal(inst, x81), glist)
  (@drule.instantiate(inst, c), t83, t82)
}

///|
/// `REWRITE_META_RULE`
pub fn rewrite_meta_rule(x84 : @list.List[@kernel.Thm], x85 : (@kernel.Term, @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], @kernel.Thm)) -> MetaRule raise {
  let thl = x84
  let (c, glist, j) = x85
  let t88 = @simp.rewrite_conv(thl)
  let rewr : (@kernel.Term) -> @kernel.Term raise = fn(x89 : @kernel.Term) -> @kernel.Term raise {
    (fn(x87 : @kernel.Thm) -> @kernel.Term raise {
      @equal.rhs((fn(x86 : @kernel.Thm) -> @kernel.Term raise {
        @kernel.concl(x86)
      })(x87))
    })(t88(x89))
  }
  let t92 = @simp.rewrite_tac(thl)
  let t93 = @tactics.then_tac(@new_tactics.rewrite_asm_tac(thl), t92)
  let rewrg : ((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> (@list.List[(String, @kernel.Thm)], @kernel.Term) raise = fn(x94 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) -> (@list.List[(String, @kernel.Thm)], @kernel.Term) raise {
    (fn(x91 : ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise)) -> (@list.List[(String, @kernel.Thm)], @kernel.Term) raise {
      @lib.hd((fn(x90 : ((@list.List[@kernel.Term], (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])), @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), @list.List[@kernel.Thm]) -> @kernel.Thm raise)) -> @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)] raise {
        @support.snd3(x90.0, x90.1, x90.2)
      })(x91))
    })(t93(x94))
  }
  let t95 = @simp.rewrite_rule(thl)(j)
  let t96 = @lib.map(rewrg, glist)
  (rewr(c), t96, t95)
}

///|
/// `meta_rule_frees`
pub fn meta_rule_frees(x97 : @kernel.Term, x98 : @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], x99 : @kernel.Thm) -> @list.List[@kernel.Term] raise {
  let (c, glist, l) = (x97, x98, x99)
  let t105 = @basics.thm_frees(l)
  @lib.itlist(fn(x103 : (@list.List[(String, @kernel.Thm)], @kernel.Term), x104 : @list.List[@kernel.Term]) -> @list.List[@kernel.Term] raise {
    (fn(x100 : @list.List[@kernel.Term]) -> ((@list.List[@kernel.Term]) -> @list.List[@kernel.Term] raise) raise {
      fn(x101 : @list.List[@kernel.Term]) -> @list.List[@kernel.Term] raise {
        @lib.union(x100, x101)
      }
    })((fn(x102 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) -> @list.List[@kernel.Term] raise {
      @support.gl_frees(x102.0, x102.1)
    })(x103))(x104)
  }, glist, @lib.union(@kernel.frees(c), t105))
}

///|
/// `meta_rule_mk_primed_vars_I`
pub fn meta_rule_mk_primed_vars_i(x106 : @list.List[@kernel.Term], x107 : (@kernel.Term, @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], @kernel.Thm)) -> ((MetaRule, @drule.Instantiation)) raise {
  let avoids = x106
  let r = x107
  let fvars = meta_rule_frees(r.0, r.1, r.2)
  fn mk_primed_l(x108 : @list.List[@kernel.Term], x109 : @list.List[@kernel.Term]) -> @drule.Instantiation raise {
    let avoids_1 = x108
    let vars = x109
    match vars {
      Empty => @tactics.null_inst
      More(v, tail=rest) => {
        let new_v = @equal.mk_primed_var(avoids_1, v)
        let t110 = mk_primed_l(avoids_1.prepend(new_v), rest)
        @tactics.compose_insts(@drule.term_match(@list.empty(), v, new_v), t110)
      }
    }
  }
  let inst = mk_primed_l(avoids, fvars)
  (inst_meta_rule(inst, r), inst)
}

///|
/// `meta_rule_mk_primed_vars`
pub fn meta_rule_mk_primed_vars(x111 : @list.List[@kernel.Term], x112 : (@kernel.Term, @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], @kernel.Thm)) -> MetaRule raise {
  let avoids = x111
  let r = x112
  meta_rule_mk_primed_vars_i(avoids, r).0
}

///|
/// `inst_meta_rule_vars`
pub fn inst_meta_rule_vars(x113 : @list.List[(@kernel.Term, @kernel.Term)], x114 : (@kernel.Term, @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], @kernel.Thm), x115 : @list.List[@kernel.Term]) -> MetaRule raise {
  let instlist = x113
  let r = x114
  let gfrees = x115
  let rfrees = meta_rule_frees(r.0, r.1, r.2)
  let (vars, subs) = @lib.list_split(instlist)
  let match_var : (@kernel.Term) -> ((@kernel.Term) -> @kernel.Term raise) raise = fn(x116 : @kernel.Term) -> ((@kernel.Term) -> @kernel.Term raise) raise {
    let tm1 = x116
    fn(x117 : @kernel.Term) -> @kernel.Term raise {
      let tm2 = x117
      let inst = try {
        @drule.term_match(@list.empty(), tm1, tm2)
      } catch {
        Failure(_) => (@list.empty(), @list.List([(tm2, tm1)]), @list.empty())
        e => raise e
      }
      match inst {
        (Empty, Empty, _) => tm2
        _ => raise Failure("match_var: no match")
      }
    }
  }
  let mcheck_var : (@kernel.Term) -> @kernel.Term raise = fn(x118 : @kernel.Term) -> @kernel.Term raise {
    let tm = x118
    if !@kernel.is_var(tm) {
      raise Failure(("inst_meta_rule_vars: `" + (@printer.string_of_term(tm) + "` is not a variable")))
    } else {
      try {
        @lib.tryfind(match_var(tm), rfrees)
      } catch {
        Failure(_) => raise Failure(("inst_meta_rule_vars: `" + (@printer.string_of_term(tm) + "` could not be found in the meta_rule")))
        e => raise e
      }
    }
  }
  let mcheck_gvar : (@kernel.Term) -> (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]) raise = fn(x119 : @kernel.Term) -> (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]) raise {
    let var_ = x119
    try {
      let mvar = @lib.tryfind(match_var(var_), gfrees)
      @drule.term_match(@list.empty(), var_, mvar)
    } catch {
      Failure(_) => {
        @lib.warn(true, ("inst_meta_rule_vars: `" + (@printer.string_of_term(var_) + "` could not be found in the goal")))
        @tactics.null_inst
      }
      e => raise e
    }
  }
  let (new_r, prim_inst) = meta_rule_mk_primed_vars_i(gfrees, r)
  let new_vars = @lib.map(fn(x121 : @kernel.Term) -> @kernel.Term raise {
    ((x120 : @kernel.Term) => @drule.instantiate(prim_inst, x120))(mcheck_var(x121))
  }, vars)
  let subs_vars = @lib.flat(@lib.map(fn(x122 : @kernel.Term) -> @list.List[@kernel.Term] raise {
    @kernel.frees(x122)
  }, subs))
  let new_subs_inst = @lib.itlist(@tactics.compose_insts, @lib.map(mcheck_gvar, subs_vars), @tactics.null_inst)
  let new_subs = @lib.map((x123 : @kernel.Term) => @drule.instantiate(new_subs_inst, x123), subs)
  let new_instlist = @lib.list_combine(new_vars, new_subs)
  let mk_inst : ((@kernel.Term, @kernel.Term)) -> (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]) raise = fn(x124 : (@kernel.Term, @kernel.Term)) -> (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]) raise {
    let (t1, t2) = x124
    @drule.term_match(@list.empty(), t1, t2)
  }
  let inst_1 = @lib.itlist(@tactics.compose_insts, @lib.map(mk_inst, new_instlist), @tactics.null_inst)
  let result_r = inst_meta_rule(inst_1, new_r)
  result_r
}

///|
/// `mk_meta_rule`
pub fn mk_meta_rule(x125 : @kernel.Thm) -> MetaRule raise {
  let thm = x125
  fn undisch_premises(x126 : @kernel.Thm) -> ((@list.List[@kernel.Term], @kernel.Thm)) raise {
    let th = x126
    if is_mimp(@kernel.concl(th)) {
      let (rest, res_th) = undisch_premises(mundisch(th))
      (rest.prepend(@kernel.rand(@kernel.rator(@kernel.concl(th)))), res_th)
    } else {
      (@list.empty(), th)
    }
  }
  let (prems, thm_1) = undisch_premises(thm)
  fn mk_meta_subgoal(x127 : @kernel.Term) -> ((@list.List[(String, @kernel.Thm)], @kernel.Term)) raise {
    let tm = x127
    if is_mimp(tm) {
      let (a, c) = dest_mimp(tm)
      let (prems_1, concl) = mk_meta_subgoal(c)
      (prems_1.prepend(("", @kernel.assume_rule(a))), concl)
    } else {
      (@list.empty(), tm)
    }
  }
  let t128 = mimp_to_imp_rule(thm_1)
  let t129 = @lib.map(mk_meta_subgoal, prems)
  (@kernel.concl(thm_1), t129, t128)
}

