///|
/// `rulem_tac`
pub fn rulem_tac(x177 : @list.List[(@kernel.Term, @kernel.Term)], x178 : (@kernel.Term, @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], @kernel.Thm), x179 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) -> @tactics.Goalstate raise {
  let instlist = x177
  let r = x178
  let (asl, w) as g = x179
  let (c, hyps, thm) = inst_meta_rule_vars(instlist, r, @support.gl_frees(g.0, g.1))
  let ins = try {
    @drule.term_match(@support.gl_frees(g.0, g.1), c, w)
  } catch {
    Failure(_) => raise Failure("Rule doesn't match!")
    e => raise e
  }
  let new_hyps = @lib.map((x180 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) => @tactics.inst_goal(ins, x180), hyps)
  let new_goals = @lib.map(fn(x181 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) -> (@list.List[(String, @kernel.Thm)], @kernel.Term) raise {
    let (hs, gl) = x181
    (hs.concat(asl), gl)
  }, new_hyps)
  let dischls = @lib.map(fn(x188 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) -> @list.List[@kernel.Term] raise {
    create_dischl_l(x188.0, x188.1)
  }, new_hyps)
  let disch_pair : ((@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])) -> (((@list.List[@kernel.Term], @kernel.Thm)) -> @kernel.Thm raise) raise = fn(x189 : (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)])) -> (((@list.List[@kernel.Term], @kernel.Thm)) -> @kernel.Thm raise) raise {
    let i = x189
    fn(x190 : (@list.List[@kernel.Term], @kernel.Thm)) -> @kernel.Thm raise {
      let (dischl, thm_1) = x190
      @support.dischl(@lib.map((x191 : @kernel.Term) => @drule.instantiate(i, x191), dischl), thm_1)
    }
  }
  let t195 = @support.gl_frees(g.0, g.1)
  let normalfrees = @lib.itlist(fn(x192 : @list.List[@kernel.Term], x193 : @list.List[@kernel.Term]) -> @list.List[@kernel.Term] raise {
    @lib.union(x192, x193)
  }, @lib.map(fn(x194 : (@kernel.Term, @kernel.Term)) -> @list.List[@kernel.Term] raise {
    let (_, y) = x194
    @kernel.frees(y)
  }, instlist), t195)
  let mvs = @lib.subtract(@lib.itlist(fn(x196 : @list.List[@kernel.Term], x197 : @list.List[@kernel.Term]) -> @list.List[@kernel.Term] raise {
    @lib.union(x196, x197)
  }, @lib.map(fn(x198 : (@list.List[(String, @kernel.Thm)], @kernel.Term)) -> @list.List[@kernel.Term] raise {
    @support.gl_frees(x198.0, x198.1)
  }, new_goals), @list.empty()), normalfrees)
  ((mvs, @tactics.null_inst), new_goals, fn(x199 : (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), x200 : @list.List[@kernel.Thm]) -> @kernel.Thm raise {
    let i_1 = x199
    let l = x200
    let t203 = @lib.zip(dischls, l)
    let t204 = @lib.map(disch_pair(i_1), t203)
    @lib.fold_left(fn(x201 : @kernel.Thm, x202 : @kernel.Thm) -> @kernel.Thm raise {
      let t1 = x201
      let t2 = x202
      @bool.prove_hyp(@drule.instantiate_all(i_1, t2), t1)
    }, @drule.instantiate_all(@tactics.compose_insts(ins, i_1), thm), t204)
  })
}

///|
fn[TA, TB] create_dischl_l(x182 : @list.List[(TA, @kernel.Thm)], x183 : TB) -> @list.List[@kernel.Term] raise {
  let (asms, g_1) = (x182, x183)
  if @list.List::is_empty(asms) {
    @list.empty()
