///|
/// `meta_rule`
pub type MetaRule = (@kernel.Term, @list.List[@tactics.Goal], @kernel.Thm)

///|
/// `print_meta_rule`
pub fn print_meta_rule(x76 : @kernel.Term, x77 : @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], x78 : @kernel.Thm) -> Unit raise {
  let (c, glist, j) = (x76, x77, x78)
  @printer.print_term(c)
  {
    @pp.std_formatter.print_newline()
  }
  @lib.hd(@lib.map(@tactics.print_goal, glist))
  {
    @pp.std_formatter.print_newline()
  }
  @printer.print_thm(j)
  {
    @pp.std_formatter.print_newline()
  }
}

///|
/// `inst_meta_rule`
pub fn inst_meta_rule(x79 : (@list.List[(Int64, @kernel.Term)], @list.List[(@kernel.Term, @kernel.Term)], @list.List[(@kernel.HolType, @kernel.HolType)]), x80 : (@kernel.Term, @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)], @kernel.Thm)) -> MetaRule raise {
