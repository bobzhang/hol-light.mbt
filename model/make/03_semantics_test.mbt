// Model/semantics.ml in its directory's load order: the test block of
// model/semantics/semantics_ref_test.mbt (tools/ocaml_ref/chain_test.py), with the same golden
// (tools/ocaml_ref/Model_semantics_ref.expected).

///|
test "Model/semantics matches Model/semantics.ml" {
  @testkit.release_output()
  @semantics.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "Library/wo", "Library/card", "Model/syntax", "Model/modelset", "Model/semantics",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Model/semantics")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("typeset", () => sthm(@semantics.typeset()))
  log.attempt("semantics", () => sthm(@semantics.semantics()))
  log.attempt("type_valuation", () => sthm(@semantics.type_valuation()))
  log.attempt("term_valuation", () => sthm(@semantics.term_valuation()))
  log.attempt("TERM_VALUATION_VALMOD", () => {
    sthm(@semantics.term_valuation_valmod())
  })
  log.attempt("TYPESET_INHABITED", () => sthm(@semantics.typeset_inhabited()))
  log.attempt("SEMANTICS_TYPESET_INDUCT", () => {
    sthm(@semantics.semantics_typeset_induct())
  })
  log.attempt("SEMANTICS_TYPESET", () => sthm(@semantics.semantics_typeset()))
  log.attempt("SEMANTICS_EQUATION", () => sthm(@semantics.semantics_equation()))
  log.attempt("SEMANTICS_EQUATION_ALT", () => {
    sthm(@semantics.semantics_equation_alt())
  })
  log.attempt("SEMANTICS_SELECT", () => sthm(@semantics.semantics_select()))
  log.attempt("sequent", () => sthm(@semantics.sequent()))
  log.attempt("SEMANTICS_RACONV", () => sthm(@semantics.semantics_raconv()))
  log.attempt("SEMANTICS_ACONV", () => sthm(@semantics.semantics_aconv()))
  log.attempt("BINARY_INFERENCE_RULE", () => {
    sthm(@semantics.binary_inference_rule())
  })
  log.attempt("TERM_VALUATION_VFREE_IN", () => {
    sthm(@semantics.term_valuation_vfree_in())
  })
  log.attempt("ASSUME_correct", () => sthm(@semantics.assume_correct()))
  log.attempt("REFL_correct", () => sthm(@semantics.refl_correct()))
  log.attempt("TRANS_correct", () => sthm(@semantics.trans_correct()))
  log.attempt("MK_COMB_correct", () => sthm(@semantics.mk_comb_correct()))
  log.attempt("EQ_MP_correct", () => sthm(@semantics.eq_mp_correct()))
  log.attempt("BETA_correct", () => sthm(@semantics.beta_correct()))
  log.attempt("ABS_correct", () => sthm(@semantics.abs_correct()))
  log.attempt("DEDUCT_ANTISYM_RULE_correct", () => {
    sthm(@semantics.deduct_antisym_rule_correct())
  })
  log.attempt("DEST_VAR", () => sthm(@semantics.dest_var()))
  log.attempt("TERM_VALUATION_ITLIST", () => {
    sthm(@semantics.term_valuation_itlist())
  })
  log.attempt("ITLIST_VALMOD_FILTER", () => {
    sthm(@semantics.itlist_valmod_filter())
  })
  log.attempt("ITLIST_VALMOD_EQ", () => sthm(@semantics.itlist_valmod_eq()))
  log.attempt("SEMANTICS_VSUBST", () => sthm(@semantics.semantics_vsubst()))
  log.attempt("INST_correct", () => sthm(@semantics.inst_correct()))
  log.attempt("TYPESET_LEMMA", () => sthm(@semantics.typeset_lemma()))
  log.attempt("SEMANTICS_INST_CORE", () => {
    sthm(@semantics.semantics_inst_core())
  })
  log.attempt("SEMANTICS_INST", () => sthm(@semantics.semantics_inst()))
  log.attempt("INST_TYPE_correct", () => sthm(@semantics.inst_type_correct()))
  log.attempt("HOL_IS_SOUND", () => sthm(@semantics.hol_is_sound()))
  log.attempt("HOL_IS_CONSISTENT", () => sthm(@semantics.hol_is_consistent()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.probe_counters()
  @testkit.check_axioms()
  inspect(
    @testkit.normalize_times(log.contents()),
    content=(
