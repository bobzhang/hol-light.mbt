// Model/syntax.ml in its directory's load order: the test block of
// model/syntax/syntax_ref_test.mbt (tools/ocaml_ref/chain_test.py), with the same golden
// (tools/ocaml_ref/Model_syntax_ref.expected).

///|
test "Model/syntax matches Model/syntax.ml" {
  @testkit.release_output()
  @syntax.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "Library/wo", "Library/card", "Model/syntax",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Model/syntax")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("type_INDUCT", () => sthm(@syntax.type_induct()))
  log.attempt("type_RECURSION", () => sthm(@syntax.type_recursion()))
  log.attempt("type_DISTINCT", () => sthm(@syntax.type_distinct()))
  log.attempt("type_INJ", () => sthm(@syntax.type_inj()))
  log.attempt("domain", () => sthm(@syntax.domain()))
  log.attempt("codomain", () => sthm(@syntax.codomain()))
  log.attempt("term_INDUCT", () => sthm(@syntax.term_induct()))
  log.attempt("term_RECURSION", () => sthm(@syntax.term_recursion()))
  log.attempt("term_DISTINCT", () => sthm(@syntax.term_distinct()))
  log.attempt("term_INJ", () => sthm(@syntax.term_inj()))
  log.attempt("has_type_RULES", () => sthm(@syntax.has_type_rules()))
  log.attempt("has_type_INDUCT", () => sthm(@syntax.has_type_induct()))
  log.attempt("has_type_CASES", () => sthm(@syntax.has_type_cases()))
  log.attempt("welltyped", () => sthm(@syntax.welltyped()))
  log.attempt("typeof", () => sthm(@syntax.typeof()))
  log.attempt("WELLTYPED_LEMMA", () => sthm(@syntax.welltyped_lemma()))
  log.attempt("WELLTYPED", () => sthm(@syntax.welltyped_v1()))
  log.attempt("WELLTYPED_CLAUSES", () => sthm(@syntax.welltyped_clauses()))
  log.attempt("equation", () => sthm(@syntax.equation()))
  log.attempt("EQUATION_HAS_TYPE_BOOL", () => {
    sthm(@syntax.equation_has_type_bool())
  })
  log.attempt("ALPHAVARS", () => sthm(@syntax.alphavars()))
  log.attempt("RACONV_RULES", () => sthm(@syntax.raconv_rules()))
  log.attempt("RACONV_INDUCT", () => sthm(@syntax.raconv_induct()))
  log.attempt("RACONV_CASES", () => sthm(@syntax.raconv_cases()))
  log.attempt("RACONV", () => sthm(@syntax.raconv()))
  log.attempt("ACONV", () => sthm(@syntax.aconv()))
  log.attempt("ALPHAVARS_REFL", () => sthm(@syntax.alphavars_refl()))
  log.attempt("RACONV_REFL", () => sthm(@syntax.raconv_refl()))
  log.attempt("ACONV_REFL", () => sthm(@syntax.aconv_refl()))
  log.attempt("ALPHAVARS_TYPE", () => sthm(@syntax.alphavars_type()))
  log.attempt("RACONV_TYPE", () => sthm(@syntax.raconv_type()))
  log.attempt("ACONV_TYPE", () => sthm(@syntax.aconv_type()))
  log.attempt("TERM_UNION", () => sthm(@syntax.term_union()))
  log.attempt("TERM_UNION_NONEW", () => sthm(@syntax.term_union_nonew()))
  log.attempt("TERM_UNION_THM", () => sthm(@syntax.term_union_thm()))
  log.attempt("ALL_BOOL_TERM_UNION", () => sthm(@syntax.all_bool_term_union()))
  log.attempt("VFREE_IN", () => sthm(@syntax.vfree_in()))
  log.attempt("VFREE_IN_RACONV", () => sthm(@syntax.vfree_in_raconv()))
  log.attempt("VFREE_IN_ACONV", () => sthm(@syntax.vfree_in_aconv()))
  log.attempt("REV_ASSOCD", () => sthm(@syntax.rev_assocd()))
  log.attempt("TYPE_SUBST", () => sthm(@syntax.type_subst()))
  log.attempt("VFREE_IN_FINITE", () => sthm(@syntax.vfree_in_finite()))
  log.attempt("VFREE_IN_FINITE_ALT", () => sthm(@syntax.vfree_in_finite_alt()))
  log.attempt("VARIANT_EXISTS", () => sthm(@syntax.variant_exists()))
  log.attempt("VARIANT", () => sthm(@syntax.variant()))
  log.attempt("VSUBST", () => sthm(@syntax.vsubst()))
  log.attempt("VSUBST_HAS_TYPE", () => sthm(@syntax.vsubst_has_type()))
  log.attempt("VSUBST_WELLTYPED", () => sthm(@syntax.vsubst_welltyped()))
  log.attempt("REV_ASSOCD_FILTER", () => sthm(@syntax.rev_assocd_filter()))
  log.attempt("VFREE_IN_VSUBST", () => sthm(@syntax.vfree_in_vsubst()))
  log.attempt("result_INDUCT", () => sthm(@syntax.result_induct()))
  log.attempt("result_RECURSION", () => sthm(@syntax.result_recursion()))
  log.attempt("result_INJ", () => sthm(@syntax.result_inj()))
  log.attempt("result_DISTINCT", () => sthm(@syntax.result_distinct()))
  log.attempt("IS_RESULT", () => sthm(@syntax.is_result()))
  log.attempt("IS_CLASH", () => sthm(@syntax.is_clash()))
  log.attempt("RESULT", () => sthm(@syntax.result()))
  log.attempt("CLASH", () => sthm(@syntax.clash()))
  log.attempt("sizeof", () => sthm(@syntax.sizeof_()))
  log.attempt("SIZEOF_VSUBST", () => sthm(@syntax.sizeof_vsubst()))
  log.attempt("INST_CORE_EXISTS", () => sthm(@syntax.inst_core_exists()))
  log.attempt("INST_CORE", () => sthm(@syntax.inst_core()))
  log.attempt("INST_DEF", () => sthm(@syntax.inst_def()))
  log.attempt("NOT_IS_RESULT", () => sthm(@syntax.not_is_result()))
  log.attempt("letlemma", () => sthm(@syntax.letlemma()))
  log.attempt("prove_RULES", () => sthm(@syntax.prove_rules()))
  log.attempt("proves_INDUCT", () => sthm(@syntax.proves_induct()))
  log.attempt("proves_CASES", () => sthm(@syntax.proves_cases()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.probe_counters()
  @testkit.check_axioms()
  inspect(
    @testkit.normalize_times(log.contents()),
    content=(
